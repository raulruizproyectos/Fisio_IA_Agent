---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Fisio IA Agent — CRM Clinico Inteligente">
  <div class="app-shell">
    <!-- SIDEBAR -->
    <aside class="sidebar" id="sidebar">
      <div class="sidebar-brand">
        <span class="brand-icon material-symbols-rounded">healing</span>
        <span class="brand-text">Fisio IA Agent</span>
      </div>

      <nav class="sidebar-nav">
        <a href="#" class="nav-item active" data-section="dashboard">
          <span class="material-symbols-rounded">dashboard</span>
          <span class="nav-label">Dashboard</span>
        </a>
        <a href="#" class="nav-item" data-section="pacientes">
          <span class="material-symbols-rounded">group</span>
          <span class="nav-label">Pacientes</span>
        </a>
        <a href="#" class="nav-item has-badge" data-section="intakes">
          <span class="material-symbols-rounded">assignment</span>
          <span class="nav-label">Intake Pendientes</span>
          <span class="badge" id="intakeBadge">3</span>
        </a>
        <a href="#" class="nav-item" data-section="citas">
          <span class="material-symbols-rounded">calendar_month</span>
          <span class="nav-label">Citas</span>
        </a>
        <a href="#" class="nav-item" data-section="videos">
          <span class="material-symbols-rounded">smart_display</span>
          <span class="nav-label">Videos</span>
        </a>
        <a href="#" class="nav-item" data-section="historial">
          <span class="material-symbols-rounded">history</span>
          <span class="nav-label">Historial</span>
        </a>
      </nav>

      <div class="sidebar-bottom">
        <a href="#" class="nav-item" data-section="config">
          <span class="material-symbols-rounded">settings</span>
          <span class="nav-label">Configuración</span>
        </a>
      </div>
    </aside>
    <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

    <!-- MAIN -->
    <div class="main-area">
      <!-- HEADER -->
      <header class="topbar">
        <button class="sidebar-toggle" id="sidebarToggle" aria-label="Menú">
          <span class="material-symbols-rounded">menu</span>
        </button>
        <div class="search-box">
          <span class="material-symbols-rounded search-icon">search</span>
          <input type="text" id="searchInput" placeholder="Buscar paciente, dolencia, ejercicio..." autocomplete="off" />
        </div>
        <div class="topbar-right">
          <button class="icon-btn" aria-label="Notificaciones" id="notifBtn">
            <span class="material-symbols-rounded">notifications</span>
            <span class="dot-indicator"></span>
          </button>
          <div class="user-pill">
            <div class="avatar">RR</div>
            <span class="user-name">Dr. Raúl Ruiz</span>
          </div>
        </div>
      </header>

      <!-- CONTENT -->
      <main class="content">
        <!-- === PAGE: DASHBOARD === -->
        <div class="page-section active" data-page="dashboard">
          <div class="content-grid">
            <div class="col-main">
              <section class="metrics-row">
                <div class="metric-card"><div class="metric-icon" style="background: var(--accent-soft); color: var(--accent);"><span class="material-symbols-rounded">assignment</span></div><div class="metric-data"><span class="metric-value" id="metricIntakes">—</span><span class="metric-label">Intakes pendientes</span></div></div>
                <div class="metric-card"><div class="metric-icon" style="background: rgba(59,130,246,0.12); color: var(--info);"><span class="material-symbols-rounded">group</span></div><div class="metric-data"><span class="metric-value" id="metricPacientes">—</span><span class="metric-label">Pacientes activos</span></div></div>
                <div class="metric-card"><div class="metric-icon" style="background: rgba(245,158,11,0.12); color: var(--warning);"><span class="material-symbols-rounded">smart_display</span></div><div class="metric-data"><span class="metric-value" id="metricVideos">—</span><span class="metric-label">Videos en revisión</span></div></div>
                <div class="metric-card"><div class="metric-icon" style="background: rgba(16,185,129,0.12); color: var(--success);"><span class="material-symbols-rounded">event_available</span></div><div class="metric-data"><span class="metric-value" id="metricSesiones">—</span><span class="metric-label">Sesiones hoy</span></div></div>
              </section>
              <section class="card table-card">
                <header class="card-header"><h2>Últimos Intakes</h2><button class="btn-ghost" id="refreshIntakes"><span class="material-symbols-rounded">refresh</span> Actualizar</button></header>
                <div class="table-wrap"><table id="intakeTable"><thead><tr><th>Paciente</th><th>Canal</th><th>Fecha</th><th>Estado</th><th>Acción</th></tr></thead><tbody id="intakeBody"><tr class="empty-row"><td colspan="5"><div class="empty-state"><span class="material-symbols-rounded">inbox</span><p>Cargando intakes...</p></div></td></tr></tbody></table></div>
              </section>
            </div>
            <div class="col-aside">
              <section class="card agent-panel">
                <header class="card-header agent-header"><div class="agent-title"><span class="material-symbols-rounded agent-icon">psychology</span><div><h2>Agente Clínico IA</h2><div class="agent-status"><span class="status-dot connected" id="agentDot"></span><span class="status-text" id="agentStatusText">Conectado</span></div></div></div></header>
                <div class="chat-log" id="chatLog"><article class="msg agent"><div class="msg-avatar"><span class="material-symbols-rounded">psychology</span></div><div class="msg-body"><span class="msg-sender">Agente IA</span><p>Listo para intake clínico. Describe los síntomas del paciente o indica una pauta para generar video de ejercicios.</p></div></article></div>
                <form id="agentForm" class="chat-form"><div class="input-row"><textarea id="agentInput" rows="2" placeholder="Ej: Dolor de hombro de 5 dias, empeora al elevar brazo, sin traumatismo..."></textarea><button type="button" class="exercise-btn" id="exerciseRecoBtn" aria-label="Recomendar ejercicios" title="Recomendar ejercicios"><span class="material-symbols-rounded">fitness_center</span></button><button type="submit" class="send-btn" id="sendBtn" aria-label="Enviar"><span class="material-symbols-rounded">send</span></button></div><div class="input-hints"><span class="material-symbols-rounded" style="font-size: 14px;">info</span> Ctrl+Enter = Agente IA · <span class="material-symbols-rounded" style="font-size: 14px;">fitness_center</span> = Ejercicios AI</div></form>
              </section>
            </div>
          </div>
        </div>

        <!-- === PAGE: PACIENTES === -->
        <div class="page-section" data-page="pacientes">
          <div class="page-header-row">
            <h1 class="page-title"><span class="material-symbols-rounded">group</span> Pacientes</h1>
            <button class="btn-primary" id="addPatientBtn"><span class="material-symbols-rounded">person_add</span> Nuevo paciente</button>
          </div>
          <section class="card table-card">
            <header class="card-header"><h2>Lista de pacientes</h2><button class="btn-ghost" id="refreshPacientes"><span class="material-symbols-rounded">refresh</span> Actualizar</button></header>
            <div class="table-wrap"><table><thead><tr><th>Nombre</th><th>Email</th><th>Fecha nac.</th><th>Registro</th><th>Acciones</th></tr></thead><tbody id="pacientesBody"><tr class="empty-row"><td colspan="5"><div class="empty-state"><span class="material-symbols-rounded">hourglass_empty</span><p>Cargando pacientes...</p></div></td></tr></tbody></table></div>
          </section>
        </div>

        <!-- === PAGE: INTAKES === -->
        <div class="page-section" data-page="intakes">
          <div class="page-header-row">
            <h1 class="page-title"><span class="material-symbols-rounded">assignment</span> Intakes Pendientes</h1>
          </div>
          <section class="card table-card">
            <header class="card-header"><h2>Mensajes de ingesta por revisar</h2><button class="btn-ghost" id="refreshIntakesFull"><span class="material-symbols-rounded">refresh</span> Actualizar</button></header>
            <div class="table-wrap"><table><thead><tr><th>Paciente</th><th>Fuente</th><th>Mensaje</th><th>Alertas</th><th>Fecha</th><th>Estado</th><th>Acciones</th></tr></thead><tbody id="intakesFullBody"><tr class="empty-row"><td colspan="7"><div class="empty-state"><span class="material-symbols-rounded">hourglass_empty</span><p>Cargando intakes...</p></div></td></tr></tbody></table></div>
          </section>
        </div>

        <!-- === PAGE: CITAS === -->
        <div class="page-section" data-page="citas">
          <div class="page-header-row">
            <h1 class="page-title"><span class="material-symbols-rounded">calendar_month</span> Citas</h1>
          </div>
          <section class="card table-card">
            <header class="card-header"><h2>Agenda del fisioterapeuta</h2><button class="btn-ghost" id="refreshCitas"><span class="material-symbols-rounded">refresh</span> Actualizar</button></header>
            <div class="table-wrap"><table><thead><tr><th>Paciente</th><th>Inicio</th><th>Fin</th><th>Estado</th><th>Motivo</th><th>Acciones</th></tr></thead><tbody id="citasBody"><tr class="empty-row"><td colspan="6"><div class="empty-state"><span class="material-symbols-rounded">hourglass_empty</span><p>Cargando citas...</p></div></td></tr></tbody></table></div>
          </section>
        </div>

        <!-- === PAGE: VIDEOS === -->
        <div class="page-section" data-page="videos">
          <div class="page-header-row">
            <h1 class="page-title"><span class="material-symbols-rounded">smart_display</span> Videos de Ejercicios</h1>
          </div>
          <section class="card table-card">
            <header class="card-header"><h2>Trabajos de video</h2><button class="btn-ghost" id="refreshVideos"><span class="material-symbols-rounded">refresh</span> Actualizar</button></header>
            <div class="table-wrap"><table><thead><tr><th>Paciente</th><th>Ejercicio</th><th>Estado</th><th>URL</th><th>Creado</th><th>Acciones</th></tr></thead><tbody id="videosBody"><tr class="empty-row"><td colspan="6"><div class="empty-state"><span class="material-symbols-rounded">hourglass_empty</span><p>Cargando videos...</p></div></td></tr></tbody></table></div>
          </section>
        </div>

        <!-- === PAGE: HISTORIAL === -->
        <div class="page-section" data-page="historial">
          <div class="page-header-row">
            <h1 class="page-title"><span class="material-symbols-rounded">history</span> Historial</h1>
          </div>
          <section class="card">
            <header class="card-header"><h2>Notas de seguimiento</h2><button class="btn-ghost" id="refreshHistorial"><span class="material-symbols-rounded">refresh</span> Actualizar</button></header>
            <div id="historialContent" class="section-body"><div class="empty-state"><span class="material-symbols-rounded">history</span><p>Selecciona un paciente para ver su historial</p></div></div>
          </section>
        </div>

        <!-- === PAGE: CONFIG === -->
        <div class="page-section" data-page="config">
          <div class="page-header-row">
            <h1 class="page-title"><span class="material-symbols-rounded">settings</span> Configuración</h1>
          </div>
          <div class="config-grid">
            <section class="card">
              <header class="card-header"><h2>Conexiones</h2></header>
              <div class="section-body">
                <div class="config-item"><span class="config-label">Backend API</span><span class="config-value" id="cfgBackend">—</span><span class="status-chip" id="cfgBackendStatus">—</span></div>
                <div class="config-item"><span class="config-label">Agente n8n</span><span class="config-value" id="cfgAgent">—</span><span class="status-chip" id="cfgAgentStatus">—</span></div>
              </div>
            </section>
            <section class="card">
              <header class="card-header"><h2>Proyecto</h2></header>
              <div class="section-body">
                <div class="config-item"><span class="config-label">Versión</span><span class="config-value">0.0.1</span></div>
                <div class="config-item"><span class="config-label">Stack</span><span class="config-value">Astro + Express + Supabase + n8n</span></div>
                <div class="config-item"><span class="config-label">Repositorio</span><a href="https://github.com/raulruizproyectos/Fisio_IA_Agent" target="_blank" class="config-link">GitHub ↗</a></div>
              </div>
            </section>
          </div>
        </div>
      </main>
    </div>
  </div>
</Layout>

<script lang="ts">
  // === CONFIG ===
  const BACKEND_BASE = (window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1')
    ? 'http://localhost:3001'
    : 'https://fisio-backend.b5xbaf.easypanel.host';
  const PROF_ID = '4a194ec4-3580-4246-9452-0852b589fd63';

  // === DOM REFS ===
  const form = document.getElementById('agentForm') as HTMLFormElement | null;
  const input = document.getElementById('agentInput') as HTMLTextAreaElement | null;
  const log = document.getElementById('chatLog') as HTMLElement | null;
  const sendBtn = document.getElementById('sendBtn') as HTMLButtonElement | null;
  const agentDot = document.getElementById('agentDot') as HTMLElement | null;
  const agentStatusText = document.getElementById('agentStatusText') as HTMLElement | null;
  const sidebarToggle = document.getElementById('sidebarToggle') as HTMLElement | null;
  const sidebar = document.getElementById('sidebar') as HTMLElement | null;
  const intakeBody = document.getElementById('intakeBody') as HTMLElement | null;
  const refreshBtn = document.getElementById('refreshIntakes') as HTMLElement | null;
  const pacientesBody = document.getElementById('pacientesBody') as HTMLElement | null;
  const intakesFullBody = document.getElementById('intakesFullBody') as HTMLElement | null;
  const citasBody = document.getElementById('citasBody') as HTMLElement | null;
  const videosBody = document.getElementById('videosBody') as HTMLElement | null;
  const historialContent = document.getElementById('historialContent') as HTMLElement | null;

  // === HELPERS ===
  const escapeHtml = (str: string) => str.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
  const escapeAttr = (str: string) => escapeHtml(str).replace(/"/g, '&quot;').replace(/'/g, '&#39;');
  const fmtDate = (d: string) => { try { return new Date(d).toLocaleDateString('es-ES',{day:'2-digit',month:'short',hour:'2-digit',minute:'2-digit'}); } catch { return '—'; } };
  const isTodayDate = (d: string) => {
    try {
      const target = new Date(d);
      const now = new Date();
      return target.getFullYear() === now.getFullYear() && target.getMonth() === now.getMonth() && target.getDate() === now.getDate();
    } catch {
      return false;
    }
  };
  const fetchJson = async (url: string, opts?: RequestInit) => { const r = await fetch(url, { signal: AbortSignal.timeout(8000), ...opts }); if (!r.ok) throw new Error('HTTP ' + r.status); return r.json(); };
  const resolvePatientName = (row: any) =>
    row?.nombre_paciente ||
    row?.pacientes?.nombre_completo ||
    row?.paciente?.nombre_completo ||
    (row?.paciente_id ? `Paciente #${row.paciente_id}` : 'Paciente sin identificar');
  const resolveExerciseName = (row: any) =>
    row?.nombre_ejercicio ||
    row?.ejercicios?.nombre ||
    row?.ejercicio?.nombre ||
    'Ejercicio sin definir';
  const openPatientHistory = (patientId: string | null, patientName = '') => {
    if (!patientId) return;
    selectedPatientId = patientId;
    selectedPatientName = patientName || '';
    navigateTo('historial');
    loadHistorial();
  };

  // === SPA ROUTING ===
  const navItems = document.querySelectorAll('.nav-item[data-section]');
  const pages = document.querySelectorAll('.page-section');
  const pageLoaders: Record<string, () => void> = {};
  let selectedPatientId: string | null = null;
  let selectedPatientName = '';

  const navigateTo = (section: string) => {
    navItems.forEach(n => n.classList.toggle('active', n.getAttribute('data-section') === section));
    pages.forEach(p => {
      const isActive = (p as HTMLElement).dataset.page === section;
      p.classList.toggle('active', isActive);
    });
    if (pageLoaders[section]) pageLoaders[section]();
  };
  navItems.forEach(n => n.addEventListener('click', (e: Event) => { e.preventDefault(); navigateTo(n.getAttribute('data-section') || 'dashboard'); }));

  // === SIDEBAR TOGGLE (responsive) ===
  const sidebarBackdrop = document.getElementById('sidebarBackdrop') as HTMLElement | null;
  const isMobile = () => window.innerWidth <= 768;

  const openSidebar = () => {
    sidebar?.classList.add('open');
    sidebarBackdrop?.classList.add('visible');
    document.body.style.overflow = 'hidden';
  };
  const closeSidebar = () => {
    sidebar?.classList.remove('open');
    sidebarBackdrop?.classList.remove('visible');
    document.body.style.overflow = '';
  };

  sidebarToggle?.addEventListener('click', () => {
    if (isMobile()) {
      sidebar?.classList.contains('open') ? closeSidebar() : openSidebar();
    } else {
      sidebar?.classList.toggle('collapsed');
    }
  });
  sidebarBackdrop?.addEventListener('click', closeSidebar);

  // Close sidebar on nav click (mobile)
  navItems.forEach(n => n.addEventListener('click', () => { if (isMobile()) closeSidebar(); }));

  // Clean up on resize
  window.addEventListener('resize', () => { if (!isMobile()) closeSidebar(); });

  // === CHAT ===
  const addMessage = (text: string, type: 'user' | 'agent') => {
    if (!log) return;
    const article = document.createElement('article');
    article.className = `msg ${type}`;
    if (type === 'agent') {
      article.innerHTML = `<div class="msg-avatar"><span class="material-symbols-rounded">psychology</span></div><div class="msg-body"><span class="msg-sender">Agente IA</span><p>${escapeHtml(text)}</p></div>`;
    } else {
      article.innerHTML = `<div class="msg-body user-msg"><p>${escapeHtml(text)}</p></div>`;
    }
    log.appendChild(article);
    log.scrollTop = log.scrollHeight;
  };
  const setAgentStatus = (connected: boolean) => { agentDot?.classList.toggle('connected',connected); agentDot?.classList.toggle('disconnected',!connected); if(agentStatusText) agentStatusText.textContent=connected?'Conectado':'Sin conexión'; };
  const setSending = (busy: boolean) => { if(sendBtn) sendBtn.disabled=busy; if(input) input.disabled=busy; };
  input?.addEventListener('keydown', (e: KeyboardEvent) => { if(e.ctrlKey && e.key==='Enter'){e.preventDefault();form?.requestSubmit();} });

  // W3: Exercise recommendation via CRM
  const handleExerciseRecommend = async (text: string) => {
    addMessage(`🏋️ Solicitar recomendación para: ${text}`, 'user');
    setSending(true);
    try {
      const payload = await fetchJson(`${BACKEND_BASE}/api/exercises/recommend`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          patient_id: selectedPatientId || null,
          symptoms: text,
          channel: 'crm_web',
          fisioterapeuta_id: PROF_ID,
        }),
      });

      if (!payload.ok) {
        addMessage(`Error: ${payload.error || 'No se pudo generar recomendación'}`, 'agent');
        return;
      }

      // Format exercise recommendation as rich message
      let msg = '';
      if (payload.red_flags?.present) {
        msg += '⚠️ ALERTAS DETECTADAS: Se recomienda atención médica.\n\n';
      }
      if (payload.message_to_therapist) {
        msg += `📋 Nota clínica: ${payload.message_to_therapist}\n\n`;
      }
      if (payload.exercises?.length) {
        msg += `✅ ${payload.exercises.length} ejercicios recomendados:\n`;
        payload.exercises.forEach((ex: any) => {
          msg += `\n${ex.orden}. ${ex.nombre} (${ex.zona_corporal || '—'})`;
          msg += `\n   Confianza: ${Math.round((ex.confidence || 0) * 100)}%`;
          if (ex.why) msg += `\n   → ${ex.why}`;
        });
      }
      if (payload.message_to_patient) {
        msg += `\n\n💬 Mensaje para paciente:\n${payload.message_to_patient}`;
      }
      msg += `\n\n🔗 ID recomendación: ${payload.recommendation_id || '—'}`;

      addMessage(msg, 'agent');
      setAgentStatus(true);
    } catch {
      addMessage('Error de conexión con el agente de ejercicios.', 'agent');
      setAgentStatus(false);
    } finally {
      setSending(false);
    }
  };

  // Exercise recommend button handler
  const exerciseBtn = document.getElementById('exerciseRecoBtn');
  exerciseBtn?.addEventListener('click', () => {
    if (!input) return;
    const text = input.value.trim();
    if (!text) return;
    input.value = '';
    handleExerciseRecommend(text);
  });

  form?.addEventListener('submit', async (event: Event) => {
    event.preventDefault();
    if (!input) return;
    const text = input.value.trim();
    if (!text) return;
    addMessage(text, 'user');
    input.value = '';
    setSending(true);
    try {
      const payload = await fetchJson(`${BACKEND_BASE}/api/agent/message`, { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({role:'professional',channel:'web',text}) });
      const answer = payload?.data?.reply_text || payload?.data?.message || (typeof payload.data==='string'?payload.data:JSON.stringify(payload.data));
      addMessage(answer, 'agent');
      setAgentStatus(!payload.n8n_unreachable);
    } catch { addMessage('Error de conexión con el agente.', 'agent'); setAgentStatus(false); }
    finally { setSending(false); }
  });

  // === HEALTH CHECK ===
  const checkHealth = async () => { try { const r = await fetch(`${BACKEND_BASE}/api/health`,{signal:AbortSignal.timeout(5000)}); setAgentStatus(r.ok); } catch { setAgentStatus(false); } };
  checkHealth();

  // === LOAD INTAKES (dashboard) ===
  const loadIntakes = async () => {
    if (!intakeBody) return;
    try {
      const payload = await fetchJson(`${BACKEND_BASE}/api/profesional/intakes/pending?profesional_id=${PROF_ID}`);
      const intakes = payload.data || payload || [];
      const badge = document.getElementById('intakeBadge');
      if (badge) badge.textContent = String(intakes.length);
      const metricEl = document.getElementById('metricIntakes');
      if (metricEl) metricEl.textContent = String(intakes.length);
      if (!intakes.length) { intakeBody.innerHTML = `<tr class="empty-row"><td colspan="5"><div class="empty-state"><span class="material-symbols-rounded">check_circle</span><p>Sin intakes pendientes</p></div></td></tr>`; return; }
      intakeBody.innerHTML = intakes.slice(0,10).map((i: any) => {
        const ch = (i.fuente||i.canal||'').toLowerCase().includes('telegram')?'📱 Telegram':'🌐 Web';
        const f = fmtDate(i.creado_en||i.created_at||'');
        const st = i.estado||'pendiente';
        const patientName = resolvePatientName(i);
        return `<tr><td class="td-patient">${escapeHtml(patientName)}</td><td>${ch}</td><td>${f}</td><td><span class="status-chip ${st}">${st}</span></td><td><button class="btn-sm" data-action="review-intake" data-intake-id="${i.id||''}" data-patient-id="${i.paciente_id||''}" data-patient-name="${escapeAttr(patientName)}">Revisar</button></td></tr>`;
      }).join('');
    } catch { intakeBody.innerHTML = `<tr class="empty-row"><td colspan="5"><div class="empty-state"><span class="material-symbols-rounded">cloud_off</span><p>No se pudieron cargar los intakes</p></div></td></tr>`; }
  };
  loadIntakes();
  refreshBtn?.addEventListener('click', loadIntakes);
  intakeBody?.addEventListener('click', (event: Event) => {
    const target = event.target as HTMLElement | null;
    const btn = target?.closest('button[data-action="review-intake"]') as HTMLButtonElement | null;
    if (!btn) return;
    const patientId = btn.getAttribute('data-patient-id');
    const patientName = btn.getAttribute('data-patient-name') || '';
    openPatientHistory(patientId, patientName);
  });

  // === LOAD PACIENTES ===
  const loadPacientes = async () => {
    if (!pacientesBody) return;
    try {
      const payload = await fetchJson(`${BACKEND_BASE}/api/pacientes`);
      const pts = payload.data || [];
      const metricEl = document.getElementById('metricPacientes');
      if (metricEl) metricEl.textContent = String(pts.length);
      if (!pts.length) { pacientesBody.innerHTML = `<tr class="empty-row"><td colspan="5"><div class="empty-state"><span class="material-symbols-rounded">person_off</span><p>Sin pacientes registrados</p></div></td></tr>`; return; }
      pacientesBody.innerHTML = pts.map((p: any) => {
        const patientName = p.nombre_completo || '—';
        return `<tr><td class="td-patient">${escapeHtml(patientName)}</td><td>${escapeHtml(p.email||'—')}</td><td>${p.fecha_nacimiento?fmtDate(p.fecha_nacimiento):'—'}</td><td>${fmtDate(p.creado_en||'')}</td><td><button class="btn-sm btn-outline" data-action="view-patient" data-patient-id="${p.id}" data-patient-name="${escapeAttr(patientName)}">Ver</button></td></tr>`;
      }).join('');
    } catch { pacientesBody.innerHTML = `<tr class="empty-row"><td colspan="5"><div class="empty-state"><span class="material-symbols-rounded">cloud_off</span><p>Error al cargar pacientes</p></div></td></tr>`; }
  };
  pageLoaders['pacientes'] = loadPacientes;
  document.getElementById('refreshPacientes')?.addEventListener('click', loadPacientes);
  pacientesBody?.addEventListener('click', (event: Event) => {
    const target = event.target as HTMLElement | null;
    const btn = target?.closest('button[data-action="view-patient"]') as HTMLButtonElement | null;
    if (!btn) return;
    openPatientHistory(btn.getAttribute('data-patient-id'), btn.getAttribute('data-patient-name') || '');
  });

  // === LOAD INTAKES FULL ===
  const loadIntakesFull = async () => {
    if (!intakesFullBody) return;
    try {
      const payload = await fetchJson(`${BACKEND_BASE}/api/profesional/intakes/pending?profesional_id=${PROF_ID}`);
      const intakes = payload.data || [];
      if (!intakes.length) { intakesFullBody.innerHTML = `<tr class="empty-row"><td colspan="7"><div class="empty-state"><span class="material-symbols-rounded">check_circle</span><p>Sin intakes pendientes</p></div></td></tr>`; return; }
      intakesFullBody.innerHTML = intakes.map((i: any) => {
        const alertas = i.tiene_alertas_rojas ? `<span class="status-chip rechazado">⚠ Sí</span>` : '<span class="status-chip aprobado">No</span>';
        const patientName = resolvePatientName(i);
        return `<tr><td class="td-patient">${escapeHtml(patientName)}</td><td>${escapeHtml(i.fuente||'—')}</td><td>${escapeHtml((i.texto_mensaje||'').substring(0,80))}</td><td>${alertas}</td><td>${fmtDate(i.creado_en||'')}</td><td><span class="status-chip ${i.estado||'pendiente'}">${i.estado||'pendiente'}</span></td><td><button class="btn-sm btn-outline" data-action="view-history" data-patient-id="${i.paciente_id||''}" data-patient-name="${escapeAttr(patientName)}">Historial</button></td></tr>`;
      }).join('');
    } catch { intakesFullBody.innerHTML = `<tr class="empty-row"><td colspan="7"><div class="empty-state"><span class="material-symbols-rounded">cloud_off</span><p>Error al cargar intakes</p></div></td></tr>`; }
  };
  pageLoaders['intakes'] = loadIntakesFull;
  document.getElementById('refreshIntakesFull')?.addEventListener('click', loadIntakesFull);
  intakesFullBody?.addEventListener('click', (event: Event) => {
    const target = event.target as HTMLElement | null;
    const btn = target?.closest('button[data-action="view-history"]') as HTMLButtonElement | null;
    if (!btn) return;
    openPatientHistory(btn.getAttribute('data-patient-id'), btn.getAttribute('data-patient-name') || '');
  });

  // === LOAD CITAS ===
  const loadCitas = async () => {
    if (!citasBody) return;
    try {
      const payload = await fetchJson(`${BACKEND_BASE}/api/profesional/appointments?fisioterapeuta_id=${PROF_ID}&limit=50`);
      const citas = payload.data || [];
      const todayCount = citas.filter((c: any) => isTodayDate(c.inicio_en || '')).length;
      const metricEl = document.getElementById('metricSesiones');
      if (metricEl) metricEl.textContent = String(todayCount);

      if (!citas.length) {
        citasBody.innerHTML = `<tr class="empty-row"><td colspan="6"><div class="empty-state"><span class="material-symbols-rounded">event_busy</span><p>No hay citas registradas.</p></div></td></tr>`;
        return;
      }

      citasBody.innerHTML = citas.map((cita: any) => {
        const canCancel = ['pendiente', 'confirmada', 'reprogramada'].includes(cita.estado);
        return `<tr><td class="td-patient">${escapeHtml(cita.nombre_paciente || 'Paciente sin nombre')}</td><td>${fmtDate(cita.inicio_en || '')}</td><td>${fmtDate(cita.fin_en || '')}</td><td><span class="status-chip ${cita.estado || 'pendiente'}">${escapeHtml(cita.estado || 'pendiente')}</span></td><td>${escapeHtml(cita.motivo || '—')}</td><td>${canCancel ? `<button class="btn-sm btn-outline" data-action="cancel-appointment" data-appointment-id="${cita.id}">Cancelar</button>` : '—'}</td></tr>`;
      }).join('');
    } catch {
      citasBody.innerHTML = `<tr class="empty-row"><td colspan="6"><div class="empty-state"><span class="material-symbols-rounded">cloud_off</span><p>Error al cargar citas</p></div></td></tr>`;
    }
  };
  pageLoaders['citas'] = loadCitas;
  document.getElementById('refreshCitas')?.addEventListener('click', loadCitas);
  citasBody?.addEventListener('click', async (event: Event) => {
    const target = event.target as HTMLElement | null;
    const btn = target?.closest('button[data-action="cancel-appointment"]') as HTMLButtonElement | null;
    if (!btn) return;

    const appointmentId = btn.getAttribute('data-appointment-id');
    if (!appointmentId) return;

    btn.disabled = true;
    try {
      await fetchJson(`${BACKEND_BASE}/api/profesional/appointments/${appointmentId}`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ status: 'cancelada' }),
      });
      await loadCitas();
    } catch {
      btn.disabled = false;
      addMessage('No se pudo cancelar la cita seleccionada.', 'agent');
    }
  });
  loadCitas();

  // === LOAD VIDEOS ===
  const loadVideos = async () => {
    if (!videosBody) return;
    try {
      const payload = await fetchJson(`${BACKEND_BASE}/api/profesional/video-jobs?profesional_id=${PROF_ID}&limit=30`);
      const jobs = payload.data || [];
      const metricEl = document.getElementById('metricVideos');
      if (metricEl) {
        const inReview = jobs.filter((job: any) => ['pendiente_revision', 'rechazado', 'renderizando'].includes(job.estado)).length;
        metricEl.textContent = String(inReview);
      }
      if (!jobs.length) {
        videosBody.innerHTML = `<tr class="empty-row"><td colspan="6"><div class="empty-state"><span class="material-symbols-rounded">smart_display</span><p>No hay trabajos de vídeo todavía.</p></div></td></tr>`;
        return;
      }
      videosBody.innerHTML = jobs.map((job: any) => {
        const patientName = resolvePatientName(job);
        const exerciseName = resolveExerciseName(job);
        const urlCell = job.url_salida
          ? `<a href="${escapeAttr(job.url_salida)}" target="_blank" rel="noopener noreferrer" class="config-link">Ver enlace ↗</a>`
          : '—';
        return `<tr><td class="td-patient">${escapeHtml(patientName)}</td><td>${escapeHtml(exerciseName)}</td><td><span class="status-chip ${job.estado||'pendiente_revision'}">${job.estado||'pendiente_revision'}</span></td><td>${urlCell}</td><td>${fmtDate(job.creado_en||'')}</td><td><button class="btn-sm btn-outline" data-action="video-history" data-patient-id="${job.paciente_id||''}" data-patient-name="${escapeAttr(patientName)}">Historial</button></td></tr>`;
      }).join('');
    } catch { videosBody.innerHTML = `<tr class="empty-row"><td colspan="6"><div class="empty-state"><span class="material-symbols-rounded">cloud_off</span><p>Error al cargar videos</p></div></td></tr>`; }
  };
  pageLoaders['videos'] = loadVideos;
  document.getElementById('refreshVideos')?.addEventListener('click', loadVideos);
  loadVideos();
  videosBody?.addEventListener('click', (event: Event) => {
    const target = event.target as HTMLElement | null;
    const btn = target?.closest('button[data-action="video-history"]') as HTMLButtonElement | null;
    if (!btn) return;
    openPatientHistory(btn.getAttribute('data-patient-id'), btn.getAttribute('data-patient-name') || '');
  });

  // === LOAD HISTORIAL ===
  const loadHistorial = async () => {
    if (!historialContent) return;
    if (!selectedPatientId) {
      historialContent.innerHTML = `<div class="empty-state"><span class="material-symbols-rounded">history</span><p>Selecciona un paciente para ver su historial</p></div>`;
      return;
    }
    historialContent.innerHTML = `<div class="empty-state"><span class="material-symbols-rounded">sync</span><p>Cargando historial de ${escapeHtml(selectedPatientName || 'paciente')}...</p></div>`;
    try {
      const [patientResp, historyResp] = await Promise.all([
        fetchJson(`${BACKEND_BASE}/api/pacientes/${selectedPatientId}`),
        fetchJson(`${BACKEND_BASE}/api/profesional/patients/${selectedPatientId}/history`),
      ]);

      const patient = patientResp?.data || {};
      const notes = historyResp?.data?.notas_seguimiento || [];
      const views = historyResp?.data?.videos_vistos || [];
      const displayName = patient?.nombre_completo || selectedPatientName || `Paciente #${selectedPatientId}`;

      const notesHtml = notes.length
        ? `<ul class="detail-list">${notes.map((note: any) => `<li><strong>${fmtDate(note.creado_en||'')}</strong><br>${escapeHtml(note.texto_nota || 'Sin texto')}</li>`).join('')}</ul>`
        : `<p class="detail-empty">Sin notas de seguimiento registradas.</p>`;
      const viewsHtml = views.length
        ? `<ul class="detail-list">${views.map((view: any) => `<li><strong>${escapeHtml(view.tipo_evento || 'evento')}</strong> · ${fmtDate(view.evento_en || '')} · ${view.segundos_vistos || 0}s</li>`).join('')}</ul>`
        : `<p class="detail-empty">Sin eventos de visualización registrados.</p>`;

      historialContent.innerHTML = `
        <div class="detail-block">
          <h3>${escapeHtml(displayName)}</h3>
          <p><strong>Email:</strong> ${escapeHtml(patient.email || '—')} · <strong>Nacimiento:</strong> ${patient.fecha_nacimiento ? fmtDate(patient.fecha_nacimiento) : '—'}</p>
        </div>
        <div class="detail-block">
          <h3>Notas de seguimiento (${notes.length})</h3>
          ${notesHtml}
        </div>
        <div class="detail-block">
          <h3>Eventos de video (${views.length})</h3>
          ${viewsHtml}
        </div>
      `;
    } catch {
      historialContent.innerHTML = `<div class="empty-state"><span class="material-symbols-rounded">cloud_off</span><p>No se pudo cargar el historial del paciente seleccionado.</p></div>`;
    }
  };
  pageLoaders['historial'] = loadHistorial;
  document.getElementById('refreshHistorial')?.addEventListener('click', loadHistorial);

  // === CONFIG PAGE ===
  const loadConfig = async () => {
    const cfgBackend = document.getElementById('cfgBackend');
    const cfgBackendStatus = document.getElementById('cfgBackendStatus');
    const cfgAgent = document.getElementById('cfgAgent');
    const cfgAgentStatus = document.getElementById('cfgAgentStatus');
    if (cfgBackend) cfgBackend.textContent = BACKEND_BASE;
    try {
      const r = await fetch(`${BACKEND_BASE}/api/health`, {signal: AbortSignal.timeout(5000)});
      if (cfgBackendStatus) { cfgBackendStatus.textContent = r.ok ? 'OK' : 'Error'; cfgBackendStatus.className = `status-chip ${r.ok ? 'aprobado' : 'rechazado'}`; }
    } catch { if (cfgBackendStatus) { cfgBackendStatus.textContent = 'Offline'; cfgBackendStatus.className = 'status-chip rechazado'; } }
    if (cfgAgent) cfgAgent.textContent = BACKEND_BASE + '/api/agent/message';
    try {
      const r = await fetch(`${BACKEND_BASE}/api/agent/message`, {method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({role:'test',channel:'web',text:'health check'}),signal:AbortSignal.timeout(10000)});
      const data = await r.json();
      const ok = r.ok && !data.n8n_unreachable;
      if (cfgAgentStatus) { cfgAgentStatus.textContent = ok ? (data.fallback_used ? 'Fallback' : 'OK') : 'Error'; cfgAgentStatus.className = `status-chip ${ok ? 'aprobado' : 'rechazado'}`; }
    } catch { if (cfgAgentStatus) { cfgAgentStatus.textContent = 'Offline'; cfgAgentStatus.className = 'status-chip rechazado'; } }
  };
  pageLoaders['config'] = loadConfig;
</script>

