  });
  dashboardActionButtons.forEach((button) => {
    button.addEventListener('click', (event: Event) => {
      event.preventDefault();
      const action = (button as HTMLElement).dataset.dashboardAction;
      if (action === 'open-booking-page') {
        window.open(buildPublicBookingUrl(), '_blank', 'noopener');
