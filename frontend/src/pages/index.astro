    flex-direction: column;
    gap: 0.18rem;
    padding: 0.85rem 0.95rem;
    border: 1px solid #d9e6ed;
    border-radius: 0.95rem;
    background: linear-gradient(180deg, #ffffff 0%, #f6fafb 100%);
