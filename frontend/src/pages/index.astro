  /* Subtle decorative top line */
  .sidebar::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, var(--accent), #0ea5e9, var(--accent));
    opacity: 0.6;
  }
  .sidebar.collapsed {
    width: var(--sidebar-collapsed);
    min-width: var(--sidebar-collapsed);
  }
  .sidebar.collapsed .nav-label,
  .sidebar.collapsed .brand-text,
  .sidebar.collapsed .badge { display: none; }
  .sidebar.collapsed .nav-item {
    justify-content: center;
    overflow: visible;
  }
  .sidebar.collapsed .nav-item::after {
    content: attr(data-nav-label);
    position: absolute;
    left: calc(100% + 0.65rem);
    top: 50%;
    transform: translateY(-50%) translateX(-6px);
    opacity: 0;
    pointer-events: none;
    z-index: 30;
    padding: 0.42rem 0.62rem;
    border-radius: 0.7rem;
    background: rgba(12, 26, 46, 0.96);
    color: #f8fafc;
    font-size: 0.78rem;
    font-weight: 700;
    line-height: 1;
    white-space: nowrap;
    box-shadow: 0 18px 32px -24px rgba(2, 6, 23, 0.8);
    transition: opacity 160ms ease, transform 160ms ease;
  }
  .sidebar.collapsed .nav-item:hover::after,
  .sidebar.collapsed .nav-item:focus-visible::after {
    opacity: 1;
    transform: translateY(-50%) translateX(0);
  }

  .sidebar-brand {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.5rem 0.5rem 1.1rem;
    border-bottom: 1px solid rgba(255,255,255,0.06);
    margin-bottom: 0.5rem;
  }
  .brand-icon-wrapper {
    width: 34px;
    height: 34px;
    background: linear-gradient(135deg, #0d9488, #0ea5e9);
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    box-shadow: 0 4px 12px rgba(13,148,136,0.4);
  }
  .brand-icon {
    font-size: 18px;
    color: #ffffff;
    font-variation-settings: 'FILL' 1, 'wght' 400, 'GRAD' 0, 'opsz' 24;
  }
  .brand-text {
    font-weight: 700;
    font-size: clamp(0.9rem, 1.1vw, 1.05rem);
    letter-spacing: -0.02em;
    white-space: nowrap;
    color: #ffffff;
  }

  .sidebar-nav {
    display: flex;
    flex-direction: column;
    gap: 1px;
    flex: 1;
  }
  .sidebar-bottom {
    padding-top: 0.25rem;
    margin-top: 0.25rem;
    border-top: 1px solid rgba(255,255,255,0.06);
  }
  .sidebar-section-label {
    font-size: 0.65rem;
    font-weight: 700;
    color: rgba(148, 163, 184, 0.5);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    padding: 1.1rem 0.75rem 0.45rem;
  }

  .nav-item {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.6rem 0.75rem;
    border-radius: var(--radius-sm);
    color: var(--sidebar-text);
    font-size: clamp(0.8rem, 0.85vw, 0.88rem);
    font-weight: 500;
    transition: all var(--transition);
    position: relative;
    white-space: nowrap;
    border: 1px solid transparent;
  }
  .nav-item:hover {
    background: rgba(255,255,255,0.06);
    color: var(--sidebar-text-hover);
  }
  .nav-item.active {
    background: var(--sidebar-active-bg);
    color: var(--sidebar-active-color);
    font-weight: 600;
    border-color: rgba(13, 148, 136, 0.20);
    box-shadow: 0 2px 8px rgba(13, 148, 136, 0.12);
  }
  .nav-item.active .material-symbols-rounded {
    font-variation-settings: 'FILL' 1, 'wght' 400, 'GRAD' 0, 'opsz' 24;
  }
  .nav-item-agent {
    color: var(--sidebar-text);
  }
  .nav-item .material-symbols-rounded { font-size: 19px; flex-shrink: 0; }

  .badge {
    background: var(--danger);
    color: #fff;
    font-size: 0.65rem;
    font-weight: 700;
    padding: 1px 6px;
    border-radius: 99px;
    margin-left: auto;
    line-height: 1.4;
  }

  /* === MAIN AREA === */
  .main-area {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-width: 0;
    overflow: hidden;
  }

  /* === TOPBAR === */
  .topbar {
    height: var(--topbar-height);
    background: var(--glass);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--glass-border);
    box-shadow: 0 1px 6px rgba(15, 23, 42, 0.06);
    display: flex;
    align-items: center;
    padding: 0 clamp(0.75rem, 2vw, 1.5rem);
    gap: clamp(0.5rem, 1vw, 1rem);
    flex-shrink: 0;
    position: sticky;
    top: 0;
    z-index: 20;
  }
  .sidebar-toggle {
    background: none;
    border: none;
    color: var(--text-secondary);
    cursor: pointer;
    padding: 7px;
    border-radius: var(--radius-sm);
    display: flex;
    transition: all var(--transition);
  }
  .sidebar-toggle:hover { background: var(--bg-surface); color: var(--text-primary); }

  .search-box {
    flex: 1;
    max-width: clamp(240px, 32vw, 440px);
    position: relative;
  }
  .search-icon {
    position: absolute;
    left: 12px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--text-muted);
    font-size: 19px;
  }
  .search-box input {
    width: 100%;
    background: var(--bg-surface);
    border: 1.5px solid var(--border);
    border-radius: 9999px;
    padding: 0.52rem 0.75rem 0.52rem 2.5rem;
    color: var(--text-primary);
    font: inherit;
    font-size: 0.88rem;
    transition: border-color var(--transition), box-shadow var(--transition);
  }
  .search-box input::placeholder { color: var(--text-muted); }
  .search-box input:focus {
    outline: none;
    border-color: var(--accent);
    background: #fff;
    box-shadow: 0 0 0 3px var(--accent-soft);
  }

  .search-results {
    position: absolute;
    top: calc(100% + 0.45rem);
    left: 0;
    right: 0;
    z-index: 40;
    display: grid;
    gap: 0.3rem;
    padding: 0.45rem;
    background: rgba(255, 255, 255, 0.98);
    border: 1px solid var(--border);
    border-radius: 1rem;
    box-shadow: var(--shadow-lg);
    max-height: min(420px, 60vh);
    overflow: auto;
  }
  .search-results[hidden] {
    display: none;
  }
  .search-results-head {
    padding: 0.25rem 0.45rem;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .search-result-item {
    width: 100%;
    border: 0;
    background: transparent;
    border-radius: 0.85rem;
    padding: 0.7rem 0.75rem;
    display: flex;
    align-items: center;
    gap: 0.7rem;
    text-align: left;
    cursor: pointer;
    transition: background var(--transition), transform var(--transition);
  }
  .search-result-item:hover,
  .search-result-item.is-active {
    background: var(--accent-soft);
  }
  .search-result-item.is-active {
    transform: translateY(-1px);
  }
  .search-result-icon {
    color: var(--accent);
    font-size: 1.1rem;
  }
  .search-result-main {
    min-width: 0;
    flex: 1;
    display: grid;
    gap: 0.18rem;
  }
  .search-result-title {
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--text-primary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .search-result-meta {
    font-size: 0.77rem;
    color: var(--text-secondary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .search-result-arrow {
    color: var(--text-muted);
    font-size: 1rem;
  }
  .search-results-empty {
    padding: 0.85rem 0.9rem;
    font-size: 0.84rem;
    color: var(--text-secondary);
  }

  .topbar-right {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-left: auto;
    flex-shrink: 0;
  }
  .icon-btn {
    background: none;
    border: none;
    color: var(--text-secondary);
    cursor: pointer;
    padding: 7px;
    border-radius: var(--radius-sm);
    position: relative;
    display: flex;
    transition: all var(--transition);
  }
  .icon-btn:hover { background: var(--bg-surface); color: var(--text-primary); }
  .dot-indicator {
    position: absolute;
    top: 4px;
    right: 4px;
    width: 8px;
    height: 8px;
    background: var(--danger);
    border-radius: 50%;
    border: 2px solid var(--bg-card);
  }
  .user-pill {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    padding: 3px 10px 3px 3px;
    border-radius: 99px;
    background: var(--bg-card);
    border: 1.5px solid var(--border);
    box-shadow: var(--shadow-xs);
    cursor: pointer;
    transition: border-color var(--transition), box-shadow var(--transition);
  }
  .user-pill:hover {
    border-color: var(--border-strong);
    box-shadow: var(--shadow-sm);
  }
  .avatar {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: linear-gradient(135deg, #0d9488, #0ea5e9);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.74rem;
    font-weight: 700;
    color: #fff;
    flex-shrink: 0;
  }
  .user-name {
    font-size: 0.84rem;
    font-weight: 600;
    white-space: nowrap;
    color: var(--text-primary);
  }
  .topbar-notif-btn {
    position: relative;
    color: var(--text-muted);
  }
  .topbar-notif-btn:hover {
    color: var(--text-secondary);
  }

  /* === CONTENT === */
  .workspace-shell {
    flex: 1;
    min-height: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr) clamp(300px, 26vw, 400px);
    align-items: stretch;
    overflow: hidden;
  }

  .content {
    grid-column: 1;
    min-height: 0;
    min-width: 0;
    height: calc(100vh - var(--topbar-height));
    padding: clamp(1rem, 2vw, 1.75rem) clamp(1rem, 2.5vw, 2rem);
    overflow-y: auto;
    overflow-x: hidden;
    background: var(--bg-base);
  }

  .assistant-launch-btn {
    display: none;
    align-items: center;
    gap: 0.45rem;
    border: 1px solid rgba(88, 164, 255, 0.22);
    background: linear-gradient(135deg, rgba(15, 118, 110, 0.16), rgba(30, 64, 175, 0.16));
    color: var(--text-primary);
    border-radius: 999px;
    padding: 0.5rem 0.85rem;
    font: inherit;
    font-size: 0.84rem;
    font-weight: 600;
    cursor: pointer;
    transition: transform var(--transition), border-color var(--transition), background var(--transition);
  }
  .assistant-launch-btn:hover {
    transform: translateY(-1px);
    border-color: rgba(88, 164, 255, 0.36);
    background: linear-gradient(135deg, rgba(15, 118, 110, 0.24), rgba(30, 64, 175, 0.22));
  }
  .assistant-launch-btn .material-symbols-rounded {
    font-size: 1rem;
    color: var(--accent);
  }

  .assistant-fab {
    display: none;
    align-items: center;
    gap: 0.5rem;
    position: fixed;
    right: 1rem;
    bottom: 1rem;
    z-index: 95;
    padding: 0.78rem 1rem;
    border: 0;
    border-radius: 999px;
    background: linear-gradient(135deg, #0d9488, #0ea5e9);
    color: #ffffff;
    font: inherit;
    font-size: 0.9rem;
    font-weight: 700;
    box-shadow: 0 20px 38px -24px rgba(15, 23, 42, 0.45);
    cursor: pointer;
  }

  .assistant-fab .material-symbols-rounded,
  .assistant-fab span {
    color: inherit;
  }

  .assistant-fab[aria-expanded='true'] {
    background: linear-gradient(135deg, #0f766e, #0369a1);
  }

  .mobile-dock {
    display: none;
    position: fixed;
    left: max(0.8rem, env(safe-area-inset-left, 0px));
    right: max(0.8rem, env(safe-area-inset-right, 0px));
    bottom: calc(0.82rem + env(safe-area-inset-bottom, 0px));
    z-index: 96;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 0.45rem;
    padding: 0.5rem;
    border: 1px solid rgba(181, 156, 115, 0.24);
    border-radius: 1.45rem;
    background:
      linear-gradient(180deg, rgba(255, 251, 244, 0.94), rgba(246, 239, 228, 0.92));
    box-shadow: 0 24px 54px -34px rgba(16, 24, 32, 0.42);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
  }

  .mobile-dock-item {
    border: 1px solid transparent;
    background: transparent;
    border-radius: 1.1rem;
    min-height: 4.2rem;
    padding: 0.48rem 0.35rem 0.4rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.28rem;
    color: #5f6d78;
    font: inherit;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.01em;
    cursor: pointer;
    transition:
      transform 160ms var(--ease-premium),
      background 180ms var(--ease-premium),
      border-color 180ms var(--ease-premium),
      color 180ms var(--ease-premium),
      box-shadow 180ms var(--ease-premium);
  }

  .mobile-dock-item .material-symbols-rounded {
    font-size: 1.2rem;
    color: inherit;
  }

  .mobile-dock-item.active {
    color: var(--clinic-ink);
    border-color: rgba(23, 107, 99, 0.16);
    background: linear-gradient(180deg, rgba(216, 236, 232, 0.92), rgba(255, 249, 240, 0.9));
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.55);
  }

  .mobile-dock-item-accent {
    color: #f9f5ed;
    background: linear-gradient(135deg, #14344a 0%, #175766 100%);
    box-shadow: 0 16px 28px -20px rgba(20, 52, 74, 0.68);
  }

  .mobile-dock-item-accent .material-symbols-rounded,
  .mobile-dock-item-accent span {
    color: inherit;
  }

  .mobile-dock-item:active {
    transform: translateY(1px) scale(0.97);
  }

  .assistant-rail {
    grid-column: 2;
    position: sticky;
    top: 0;
    align-self: start;
    min-height: 0;
    height: calc(100dvh - var(--topbar-height));
    max-height: calc(100dvh - var(--topbar-height));
    padding: 0;
    border-left: 1px solid #e2e8f0;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: #f8fafc;
  }

  .assistant-rail-card {
    height: 100%;
    min-height: 0;
    max-height: 100%;
    display: flex;
    flex-direction: column;
    border-radius: 0;
    border: none;
    background: #ffffff;
    box-shadow: none;
    overflow: hidden;
  }

  .assistant-module-header {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.7rem 0.9rem;
    background: linear-gradient(135deg, #0f172a 0%, #1a2744 60%, #0d3241 100%);
    border-bottom: 2px solid #0f9f98;
  }

  .assistant-rail-copy {
    display: grid;
    gap: 0.4rem;
    max-width: 22rem;
  }
  .assistant-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.6rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #5eead4;
  }
  .assistant-rail-copy h2 {
    margin: 0;
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.2;
    color: #f1f5f9;
  }
  .assistant-rail-copy p {
    margin: 0;
    font-size: 0.78rem;
    line-height: 1.45;
    color: #94a3b8;
  }
  .assistant-rail-tools {
    margin-left: auto;
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
  }
  .assistant-rail-close {
    display: none;
    align-items: center;
    justify-content: center;
    width: 2.2rem;
    height: 2.2rem;
    border-radius: 999px;
    border: 1px solid rgba(148, 163, 184, 0.16);
    background: rgba(255, 255, 255, 0.04);
    color: #e2e8f0;
    cursor: pointer;
  }

  .assistant-rail-body {
    display: flex;
    flex: 1;
    min-height: 0;
    flex-direction: column;
    overflow: hidden;
  }


  .assistant-context-strip {
    flex-shrink: 0;
    display: grid;
    gap: 0.65rem;
    padding: 0.75rem 1.25rem;
    background: linear-gradient(180deg, rgba(241, 245, 249, 0.92), rgba(241, 245, 249, 0.65));
    border-bottom: 1px solid rgba(203, 213, 225, 0.88);
    max-height: none;
    overflow: visible;
  }
  .assistant-context-card {
    border-radius: 1rem;
    border: 1px solid rgba(203, 213, 225, 0.88);
    background: rgba(255, 255, 255, 0.92);
    padding: 0.9rem 1rem;
  }
  .assistant-context-card-highlight {
    background: linear-gradient(135deg, rgba(14, 165, 233, 0.14), rgba(37, 99, 235, 0.08));
    border-color: rgba(125, 211, 252, 0.85);
  }
  .assistant-context-label {
    display: block;
    margin-bottom: 0.35rem;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #6b7f95;
  }
  .assistant-context-card strong {
    display: block;
    font-size: 1rem;
    color: #f8fafc;
  }
  .assistant-context-card p {
    margin: 0.35rem 0 0;
    font-size: 0.78rem;
    line-height: 1.45;
    color: #66788a;
  }
  
  /* === NEW DASHBOARD LAYOUT === */
  .dashboard-layout {
    display: flex;
    flex-direction: column;
    gap: clamp(1.1rem, 1.75vw, 1.75rem);
    max-width: 1500px;
    margin: 0 auto;
  }

  /* === HERO SECTION === */
  .hero-section {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.25rem 0;
    animation: fadeIn 0.4s ease-out;
  }
  .hero-content {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }
  .hero-title {
    font-size: clamp(1.35rem, 1.8vw, 1.8rem);
    font-weight: 700;
    color: var(--text-primary);
    margin: 0;
    letter-spacing: -0.025em;
  }
  .hero-subtitle {
    font-size: clamp(0.82rem, 0.9vw, 0.93rem);
    color: var(--text-muted);
    margin: 0.2rem 0 0;
    max-width: 600px;
  }
  .hero-actions .btn-primary {
    padding: 0.72rem 1.2rem;
    font-size: clamp(0.82rem, 0.88vw, 0.9rem);
  }
  .btn-primary-teal {
    background: #0d9488 !important;
    box-shadow: 0 4px 14px -4px rgba(13, 148, 136, 0.45) !important;
    border-radius: 0.75rem !important;
  }
  .btn-primary-teal:hover {
    background: #0f766e !important;
    filter: none !important;
  }

  /* === METRICS === */
  .metrics-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(clamp(180px, 20vw, 240px), 1fr));
    gap: clamp(0.75rem, 1.5vw, 1.25rem);
  }
  .metric-card {
    background: var(--bg-card);
    border: none;
    border-radius: var(--radius-lg);
    padding: clamp(1rem, 1.5vw, 1.4rem);
    display: flex;
    align-items: center;
    gap: 1.1rem;
    transition: all var(--transition);
    box-shadow: var(--shadow-sm);
    animation: card-enter 0.45s ease-out forwards;
    opacity: 0;
    transform: translateY(8px);
  }
  .metric-card:nth-child(1) { animation-delay: 0.04s; }
  .metric-card:nth-child(2) { animation-delay: 0.1s; }
  .metric-card:nth-child(3) { animation-delay: 0.16s; }

  @keyframes card-enter {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .metric-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }
  .metric-icon {
    width: clamp(44px, 4vw, 52px);
    height: clamp(44px, 4vw, 52px);
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .metric-icon .material-symbols-rounded { font-size: clamp(22px, 2vw, 26px); }
  .metric-data {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .metric-value {
    font-size: clamp(1.4rem, 2vw, 1.8rem);
    font-weight: 700;
    line-height: 1;
    color: var(--text-primary);
  }
  .metric-label {
    font-size: clamp(0.75rem, 0.85vw, 0.85rem);
    font-weight: 500;
    color: var(--text-secondary);
    margin-top: 5px;
  }

  /* === METRIC CARDS V2 === */
  .metric-card-v2 {
    background: var(--bg-card);
    border: none;
    border-radius: var(--radius-lg);
    padding: clamp(1rem, 1.5vw, 1.5rem);
    box-shadow: var(--shadow-sm);
    transition: all var(--transition);
  }
  .metric-card-v2:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }
  .metric-card-v2 .metric-icon {
    width: clamp(42px, 3.5vw, 50px);
    height: clamp(42px, 3.5vw, 50px);
    border-radius: var(--radius-md);
    flex-shrink: 0;
  }
  .metric-card-v2 .metric-icon .material-symbols-rounded {
    font-size: clamp(20px, 1.8vw, 24px);
    font-variation-settings: 'FILL' 1, 'wght' 400, 'GRAD' 0, 'opsz' 24;
  }
  .metric-card-v2 .metric-value {
    font-size: clamp(1.4rem, 1.8vw, 1.75rem);
    font-weight: 700;
    color: var(--text-primary);
  }
  .metric-card-v2 .metric-label {
    font-size: clamp(0.75rem, 0.82vw, 0.85rem);
    color: var(--text-muted);
    font-weight: 500;
  }
  .metric-icon-blue {
    background: #eff6ff;
    color: #2563eb;
  }
  .metric-icon-emerald {
    background: #ecfdf5;
    color: #059669;
  }
  .metric-icon-indigo {
    background: #eef2ff;
    color: #4f46e5;
  }
  .metric-icon-amber {
    background: #fffbeb;
    color: #d97706;
  }
  .metric-icon-green { background: #dcfce7; color: #166534; }

  /* === CARD BASE === */
  .card {
    background: var(--bg-card);
    border: none;
    border-radius: var(--radius-lg);
    overflow: hidden;
    min-width: 0;
    box-shadow: var(--shadow-sm);
    animation: fadeIn 0.34s ease-out;
    transition: box-shadow var(--transition);
  }
  .card:hover {
    box-shadow: var(--shadow-md);
  }
  .card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: clamp(0.75rem, 1.2vw, 1rem) clamp(1rem, 1.5vw, 1.25rem);
    border-bottom: 1px solid var(--border-light);
    background: var(--bg-surface);
  }
  .card-header h2 {
    font-size: clamp(0.88rem, 0.95vw, 1rem);
    font-weight: 600;
    margin: 0;
    color: var(--text-primary);
  }
  .btn-ghost {
    background: none;
    border: none;
    color: var(--text-secondary);
    font: inherit;
    font-size: 0.85rem;
    font-weight: 500;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 6px 10px;
    border-radius: var(--radius-sm);
    transition: all var(--transition);
    white-space: nowrap;
  }
  .btn-ghost:hover { color: var(--accent); background: var(--accent-soft); }
  .btn-ghost .material-symbols-rounded { font-size: 18px; }
  .btn-xs { padding: 2px 6px; font-size: 0.72rem; min-height: unset; line-height: 1.3; border-radius: 4px; }
  .btn-danger-ghost:hover { color: #be123c; background: #fff1f2; }
  .td-actions { white-space: nowrap; display: flex; gap: 2px; align-items: center; }
  .agenda-table-note { margin-top: 0.18rem; font-size: 0.69rem; color: var(--text-muted); line-height: 1.35; }

  /* === CENTRAL AI MODULE === */
  .ai-clinical-module {
    display: flex;
    flex-direction: column;
    min-height: 0;
  }
  .module-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.2rem 1.5rem;
    border-bottom: 1px solid var(--border);
    background: var(--bg-card);
  }
  .module-title {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .module-title h2 {
    font-size: 1.15rem;
    font-weight: 600;
    margin: 0;
    color: var(--text-primary);
  }
  .accent-icon {
    color: var(--accent);
    font-size: 26px;
    background: var(--accent-soft);
    padding: 8px;
    border-radius: var(--radius-md);
  }
  .agent-status-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(16, 185, 129, 0.08);
    padding: 0.45rem 0.8rem;
    border-radius: 999px;
    border: 1px solid rgba(16, 185, 129, 0.14);
  }

  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .status-dot.connected {
    background: var(--success);
    box-shadow: 0 0 6px rgba(16, 185, 129, 0.4);
    animation: pulse-dot 2s infinite;
  }
  .status-dot.disconnected { background: var(--danger); }
  .status-text { font-size: 0.8rem; font-weight: 600; color: #3f556b; }

  @keyframes pulse-dot {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.5; }
  }

  .ai-workspace {
    display: flex;
    flex-direction: column;
    flex: 0 0 auto;
    min-height: 0;
    overflow: visible;
    background: transparent;
  }

  .assistant-shortcuts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    padding: 0.95rem 1.25rem 0;
  }
  .assistant-shortcut {
    border: 1px solid rgba(13, 148, 136, 0.16);
    background: rgba(13, 148, 136, 0.08);
    color: #0f766e;
    border-radius: 999px;
    padding: 0.48rem 0.82rem;
    font: inherit;
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1.2;
    cursor: pointer;
    transition: transform var(--transition), border-color var(--transition), background var(--transition), color var(--transition);
  }
  .assistant-shortcut:hover {
    transform: translateY(-1px);
    background: rgba(13, 148, 136, 0.14);
    border-color: rgba(13, 148, 136, 0.28);
    color: #115e59;
  }
  
  /* CHAT LOG */
  .chat-log {
    flex: 1;
    overflow-y: auto;
    padding: 1rem 1.25rem 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-height: 0;
    background: transparent;
  }
  .msg {
    display: flex;
    gap: 0.75rem;
    max-width: 85%;
    animation: msg-in 0.25s ease-out;
  }
  .msg.user { flex-direction: row-reverse; align-self: flex-end; }
  .msg.agent { align-self: flex-start; }

  @keyframes msg-in {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .msg-avatar {
    width: 36px;
    height: 36px;
    border-radius: var(--radius-md);
    background: var(--bg-card);
    border: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    box-shadow: var(--shadow-sm);
  }
  .msg.agent .msg-avatar { background: var(--accent-soft); border-color: transparent; }
  .msg.agent .msg-avatar .material-symbols-rounded { font-size: 20px; color: var(--accent); }
  .msg.user .msg-avatar .material-symbols-rounded { font-size: 20px; color: var(--text-secondary); }

  .msg-body {
    border-radius: var(--radius-lg);
    padding: 0.85rem 1.15rem;
    font-size: 0.92rem;
    line-height: 1.5;
    overflow-wrap: anywhere;
    box-shadow: var(--shadow-sm);
  }
  .msg.agent .msg-body { background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(148, 163, 184, 0.14); color: #e5eef7; border-top-left-radius: 4px; }
  .msg.user .msg-body { background: linear-gradient(135deg, #0f766e, #155eef); color: white; border-top-right-radius: 4px; box-shadow: 0 12px 26px rgba(21, 94, 239, 0.22); }
  .msg-progress .msg-avatar .material-symbols-rounded {
    animation: spin 1.1s linear infinite;
  }
  .msg-progress .msg-body {
    border-style: dashed;
    background: linear-gradient(180deg, #ffffff, #f8fafc);
  }
  .msg-body p { margin: 0; white-space: pre-line; }
  .msg-sender {
    display: block;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-muted);
    margin-bottom: 4px;
  }
  .msg.agent .msg-sender { color: var(--accent); }
  .msg.user .msg-sender { color: rgba(255,255,255,0.8); }

  /* AI INPUT AREA */
  .ai-input-area {
    padding: 0.75rem 1.25rem 1rem;
    background: #ffffff;
    border-top: 1px solid #e2e8f0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    flex-shrink: 0;
    max-height: none;
    overflow: visible;
  }
  .ai-input-area.is-busy {
    opacity: 0.92;
  }
  .ai-controls {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  .assistant-composer-note {
    font-size: 0.74rem;
    line-height: 1.4;
    color: rgba(226, 232, 240, 0.72);
  }
  .assistant-field {
    display: grid;
    gap: 0.32rem;
  }
  .assistant-field-label {
    font-size: 0.9rem;
    font-weight: 700;
    color: #f8fafc;
  }
  .assistant-field-help {
    font-size: 0.76rem;
    line-height: 1.45;
    color: rgba(226, 232, 240, 0.68);
  }
  .patient-selector {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(148, 163, 184, 0.14);
    border-radius: 0.95rem;
    padding: 0.55rem 0.9rem;
    transition: border-color var(--transition), box-shadow var(--transition);
  }
  .patient-selector:focus-within {
    border-color: rgba(94, 234, 212, 0.48);
    box-shadow: 0 0 0 4px rgba(13, 148, 136, 0.18);
  }
  .patient-selector select {
    border: none;
    background: transparent;
    font: inherit;
    font-size: 0.9rem;
    font-weight: 600;
    color: #f8fafc;
    outline: none;
    width: 250px;
    cursor: pointer;
  }
  .patient-selector option {
    color: #0f172a;
  }
  .patient-selector .material-symbols-rounded {
    font-size: 20px;
    color: #5eead4;
  }
  
  .ai-textarea-wrapper {
    position: relative;
    border: 1px solid rgba(148, 163, 184, 0.14);
    border-radius: 1.15rem;
    background: rgba(248, 250, 252, 0.04);
    transition: all 0.2s;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.03);
  }
  .ai-textarea-wrapper:focus-within {
    border-color: rgba(94, 234, 212, 0.42);
    box-shadow: 0 0 0 4px rgba(13, 148, 136, 0.16);
    background: rgba(248, 250, 252, 0.06);
  }
  .ai-textarea-wrapper textarea {
    width: 100%;
    border: none;
    background: transparent;
    padding: 1rem 1.05rem;
    font: inherit;
    font-size: 0.96rem;
    color: #f8fafc;
    resize: none;
    min-height: 180px;
    max-height: 340px;
    outline: none;
    line-height: 1.6;
  }
  .ai-textarea-wrapper textarea::placeholder {
    color: rgba(203, 213, 225, 0.56);
  }
  .ai-actions {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 0.9rem;
    padding: 0;
    flex-wrap: wrap;
  }
  .assistant-submit-hint {
    margin: 0;
    max-width: 15rem;
    font-size: 0.75rem;
    line-height: 1.5;
    color: rgba(226, 232, 240, 0.68);
  }
  .action-buttons {
    display: flex;
    gap: 0.75rem;
    margin-left: auto;
  }
  .btn-action {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 0.65rem 1.15rem;
    border-radius: var(--radius-md);
    font: inherit;
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    border: none;
    transition: all 0.2s;
  }
  .btn-action.is-loading {
    cursor: wait;
  }
  .btn-generate {
    background: var(--accent);
    color: white;
    box-shadow: 0 4px 6px -1px var(--accent-soft);
  }
  .btn-generate:hover {
    background: #0d655f;
    transform: translateY(-1px);
    box-shadow: 0 6px 8px -1px var(--accent-soft);
  }
  .btn-generate:disabled { opacity: 0.5; cursor: not-allowed; transform: none; box-shadow: none; }
  
  .btn-pdf {
    background: rgba(255, 255, 255, 0.05);
    color: #e2e8f0;
    border: 1px solid rgba(148, 163, 184, 0.16);
  }
  .btn-pdf:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(148, 163, 184, 0.28);
    color: #f8fafc;
  }
  .btn-pdf:disabled { opacity: 0.5; cursor: not-allowed; }

  .btn-chat {
    background: rgba(255, 255, 255, 0.05);
    color: #e2e8f0;
    border: 1px solid rgba(148, 163, 184, 0.16);
    padding: 0.65rem 0.85rem;
  }
  .btn-chat:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(148, 163, 184, 0.28);
    color: #f8fafc;
  }
  .btn-chat:disabled { opacity: 0.5; cursor: not-allowed; }

  /* === DASHBOARD BOTTOM ROW === */
  .dashboard-chart-card {
    min-height: auto;
  }
  .dashboard-chart-wrap {
    padding: 0.5rem 1rem 0.5rem 0.5rem;
  }
  .dashboard-chart-wrap canvas {
    width: 100%;
    height: 180px;
  }
  .chart-year-label {
    font-size: 0.85rem;
    color: var(--text-muted);
    font-weight: 600;
  }
  .dashboard-bottom-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(clamp(280px, 35vw, 420px), 1fr));
    gap: clamp(0.9rem, 1.5vw, 1.5rem);
  }
  .widget-card {
    min-height: 280px;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .widget-body {
    flex: 1;
    overflow-y: auto;
    min-width: 0;
  }
  .list-clean {
    padding: 0;
  }
  
  /* Modern Clean Lists */
  .clean-list-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    justify-content: space-between;
    padding: 0.75rem 1.25rem;
    border-bottom: 1px solid var(--border);
    transition: background var(--transition);
  }
  .clean-list-item:last-child { border-bottom: none; }
  .clean-list-item:hover { background: var(--bg-card-hover); }
  .clean-list-item.cita-today { background: rgba(13,148,136,0.04); }
  .dash-cita-hora { min-width: 44px; }
  .cita-hora-badge {
    display: inline-block;
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--color-primary, #0d9488);
    background: rgba(13,148,136,0.1);
    border-radius: 6px;
    padding: 2px 6px;
    white-space: nowrap;
  }
  .dash-section-label {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--color-primary, #0d9488);
    padding: 6px 1.25rem 2px;
    background: rgba(13,148,136,0.04);
  }
  .dash-section-label-muted { color: var(--text-muted); background: transparent; }
  .clean-list-main {
    min-width: 0;
    display: grid;
    gap: 0.2rem;
  }
  .clean-list-title {
    margin: 0;
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--text-primary);
  }
  .clean-list-meta {
    margin: 0;
    font-size: 0.8rem;
    color: var(--text-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .clean-list-action {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-left: 0.75rem;
    flex-shrink: 0;
  }

  .empty-state-sm {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    padding: 2.6rem 1.3rem;
    color: var(--text-muted);
    text-align: center;
    height: 100%;
  }
  .empty-state-sm .material-symbols-rounded {
    font-size: 36px;
    margin-bottom: 0.75rem;
    color: var(--border-light);
  }
  .empty-state-sm p {
    margin: 0;
    font-size: 0.95rem;
    font-weight: 600;
  }

  /* === TABLE OVERRIDES === */
  .table-wrap { overflow-x: auto; -webkit-overflow-scrolling: touch; }
  table { width: 100%; border-collapse: collapse; }
  thead { background: var(--bg-surface); }
  th {
    text-align: left;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    padding: 0.7rem 1rem;
    border-bottom: 1.5px solid var(--border-light);
    background: var(--bg-surface);
    white-space: nowrap;
  }
  td {
    padding: 0.8rem 1rem;
    font-size: clamp(0.82rem, 0.88vw, 0.9rem);
    border-bottom: 1px solid var(--border-light);
    vertical-align: middle;
    color: var(--text-primary);
  }
  tr:last-child td { border-bottom: none; }
  tr:hover td { background: var(--bg-card-hover); transition: background 0.12s; }
  .td-patient { font-weight: 600; color: var(--text-secondary); }

  .status-chip {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 0.72rem;
    font-weight: 600;
    padding: 0.22rem 0.6rem;
    border-radius: 9999px;
    text-transform: capitalize;
    letter-spacing: 0.01em;
  }
  .status-chip.pendiente,
  .status-chip.pendiente_revision { background: #fffbeb; color: #92400e; }
  .status-chip.confirmada,
  .status-chip.reprogramada { background: #ecfdf5; color: #065f46; }
  .status-chip.aprobado,
  .status-chip.enviado,
  .status-chip.completada { background: #ecfdf5; color: #065f46; }
  .status-chip.rechazado,
  .status-chip.cancelada,
  .status-chip.no_show { background: #fff1f2; color: #be123c; }
  .status-chip.activo { background: #ecfdf5; color: #065f46; }
  .status-chip.agotado { background: #fff1f2; color: #be123c; }
  .status-chip.caducado { background: #f1f5f9; color: #475569; }
  .status-chip.anulado { background: #f1f5f9; color: #94a3b8; }
  .status-chip.emitida { background: #eff6ff; color: #1e40af; }
  .status-chip.pagada { background: #ecfdf5; color: #065f46; }

  .btn-sm {
    background: var(--bg-surface);
    color: var(--text-secondary);
    border: 1.5px solid var(--border);
    font: inherit;
    font-size: 0.84rem;
    font-weight: 600;
    padding: 6px 14px;
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: all var(--transition);
    white-space: nowrap;
  }
  .btn-sm:hover { color: var(--text-primary); border-color: var(--border-strong); background: var(--bg-card-hover); }
  .btn-sm:disabled { opacity: 0.5; cursor: not-allowed; }
  .table-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    justify-content: flex-end;
  }

  .empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 2.8rem 1.55rem;
    color: var(--text-muted);
    text-align: center;
    border-radius: 1rem;
    border: 1px dashed rgba(148, 163, 184, 0.3);
    background: linear-gradient(180deg, rgba(248, 251, 253, 0.82), rgba(241, 247, 250, 0.76));
  }
  .empty-state .material-symbols-rounded { 
    font-size: 48px; 
    margin-bottom: 1rem; 
    color: var(--border-light); 
  }
  .empty-state p {
    font-size: 1.05rem;
    font-weight: 600;
    margin: 0;
  }
  .empty-state-hint {
    margin: 0;
    max-width: 34rem;
    color: #6c7a88;
    font-size: 0.8rem;
    line-height: 1.5;
  }
  .state-loading .material-symbols-rounded {
    animation: spin 1.1s linear infinite;
  }

  @keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  /* === SPA SECTION STYLES === */
  .page-section {
    display: none;
    min-width: 0;
    animation: fadeIn 0.34s ease-out;
  }
  .page-section.active {
    display: block;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(5px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .page-header-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .agenda-header-row {
    align-items: flex-start;
    gap: 0.9rem;
  }

  .agenda-header-copy {
    display: grid;
    gap: 0.45rem;
  }

  .agenda-sync-status {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.6rem 0.78rem;
    border-radius: 0.95rem;
    border: 1px solid var(--border);
    background: rgba(255,255,255,0.82);
    min-width: min(100%, 420px);
  }

  .agenda-sync-copy {
    display: grid;
    gap: 0.08rem;
  }

  .agenda-sync-copy strong {
    color: var(--text-primary);
    font-size: 0.82rem;
    line-height: 1.25;
  }

  .agenda-sync-copy p {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.74rem;
    line-height: 1.4;
  }
  .agenda-sync-facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 0.25rem;
  }

  .agenda-sync-fact {
    display: inline-flex;
    align-items: center;
    gap: 0.28rem;
    padding: 0.2rem 0.45rem;
    border-radius: 999px;
    background: rgba(15, 23, 42, 0.06);
    color: var(--text-muted);
    font-size: 0.68rem;
    line-height: 1.2;
  }

  .agenda-sync-fact strong {
    color: var(--text-primary);
    font-size: 0.68rem;
  }

  .page-tools {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .inline-field {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .inline-field select {
    min-width: 240px;
    max-width: 320px;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 0.36rem 0.5rem;
    color: var(--text-primary);
    font: inherit;
  }
  .inline-field select:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 4px var(--accent-soft);
  }
  
  .page-title {
