            <p class="clean-list-meta">${escapeHtml(ch)} | ${escapeHtml(f)}</p>
          </div>
          <div class="clean-list-action">
            <span class="status-chip ${st}">${escapeHtml(st)}</span>
            <button class="btn-sm" data-action="review-intake" data-intake-id="${i.id||''}" data-patient-id="${i.paciente_id||''}" data-patient-name="${escapeAttr(patientName)}">Revisar</button>
          </div>
        </article>`;
      }).join('');
    } catch {
      setListState(intakeBody, 'cloud_off', 'No se pudieron cargar los intakes');
    }
  };
  loadIntakes();
  refreshBtn?.addEventListener('click', loadIntakes);
  intakeBody?.addEventListener('click', (event: Event) => {
    const target = event.target as HTMLElement | null;
    const btn = target?.closest('button[data-action="review-intake"]') as HTMLButtonElement | null;
    if (!btn) return;
    const patientId = btn.getAttribute('data-patient-id');
    const patientName = btn.getAttribute('data-patient-name') || '';
    openPatientHistory(patientId, patientName);
  });

  // === DASHBOARD KPIs + CHART ===
  let dashChartInstance: any = null;

  const loadDashboardKPIs = async () => {
    try {
      const now = new Date();
      const anio = now.getFullYear();
      const mes = now.getMonth() + 1;
      const resumen = await fetchJson(`${BACKEND_BASE}/api/pagos/resumen?anio=${anio}`);
      const mesData = (resumen.resumen || []).find((r: any) => r.mes === mes);
      const ingresosMes = mesData ? Number(mesData.total || 0) : 0;
      const sesionesMes = mesData ? Number(mesData.sesiones || 0) : 0;

      const elIngresos = document.getElementById('metricIngresosMes');
      const elSesiones = document.getElementById('metricSesionesMes');
      if (elIngresos) elIngresos.textContent = `${ingresosMes.toFixed(0)} €`;
      if (elSesiones) elSesiones.textContent = String(sesionesMes);

      // Draw chart
      const chartYear = document.getElementById('dashChartYear');
      if (chartYear) chartYear.textContent = String(anio);

      const canvas = document.getElementById('dashIncomeChart') as HTMLCanvasElement | null;
      if (!canvas) return;
      const ctx = canvas.getContext('2d');
      if (!ctx) return;

      const meses = ['Ene', 'Feb', 'Mar', 'Abr', 'May', 'Jun', 'Jul', 'Ago', 'Sep', 'Oct', 'Nov', 'Dic'];
      const efectivoData = new Array(12).fill(0);
      const tarjetaData = new Array(12).fill(0);
      for (const r of (resumen.resumen || [])) {
        const idx = (r.mes || 1) - 1;
        efectivoData[idx] = Number(r.efectivo || 0);
        tarjetaData[idx] = Number(r.tarjeta || 0);
      }

      // Simple bar chart (no external library needed)
      const dpr = window.devicePixelRatio || 1;
      const rect = canvas.getBoundingClientRect();
      canvas.width = rect.width * dpr;
      canvas.height = rect.height * dpr;
      ctx.scale(dpr, dpr);
      const W = rect.width;
      const H = rect.height;
      const pad = { top: 10, right: 10, bottom: 30, left: 50 };
      const chartW = W - pad.left - pad.right;
      const chartH = H - pad.top - pad.bottom;
      const maxVal = Math.max(1, ...efectivoData.map((e, i) => e + tarjetaData[i]));

      ctx.clearRect(0, 0, W, H);
      ctx.font = '11px system-ui, sans-serif';
      ctx.textAlign = 'center';

      const barW = chartW / 12;
      const innerBar = barW * 0.6;

      for (let i = 0; i < 12; i++) {
        const x = pad.left + i * barW + (barW - innerBar) / 2;
        const totalH = ((efectivoData[i] + tarjetaData[i]) / maxVal) * chartH;
        const efH = (efectivoData[i] / maxVal) * chartH;
        const tarH = (tarjetaData[i] / maxVal) * chartH;

        // Tarjeta (bottom)
        ctx.fillStyle = '#3b82f6';
        ctx.fillRect(x, pad.top + chartH - totalH, innerBar, tarH);
        // Efectivo (top)
        ctx.fillStyle = '#22c55e';
        ctx.fillRect(x, pad.top + chartH - totalH + tarH, innerBar, efH);

        // Month label
        ctx.fillStyle = i === mes - 1 ? '#0f766e' : '#94a3b8';
        ctx.font = i === mes - 1 ? 'bold 11px system-ui' : '11px system-ui';
        ctx.fillText(meses[i], pad.left + i * barW + barW / 2, H - 8);
      }

      // Y axis labels
      ctx.fillStyle = '#94a3b8';
      ctx.font = '10px system-ui';
      ctx.textAlign = 'right';
      for (let v = 0; v <= maxVal; v += Math.ceil(maxVal / 4)) {
        const y = pad.top + chartH - (v / maxVal) * chartH;
        ctx.fillText(`${v}€`, pad.left - 6, y + 4);
        ctx.strokeStyle = '#e2e8f0';
        ctx.lineWidth = 0.5;
        ctx.beginPath();
        ctx.moveTo(pad.left, y);
        ctx.lineTo(W - pad.right, y);
        ctx.stroke();
      }

    } catch {
      // silently fail — dashboard still usable
    }
  };

  pageLoaders['dashboard'] = loadDashboardKPIs;
  // Auto-load on first paint
  loadDashboardKPIs();

  // === LOAD PACIENTES ===
  const loadPacientes = async () => {
    if (!pacientesBody) return;
    setTableState(pacientesBody, 5, 'sync', 'Cargando pacientes...', true);
    try {
      const pts = await fetchPatientCatalog();
      const metricEl = document.getElementById('metricPacientes');
      if (metricEl) metricEl.textContent = String(pts.length);
      if (!pts.length) { setTableState(pacientesBody, 5, 'person_off', 'Sin pacientes registrados'); return; }
      pacientesBody.innerHTML = pts.map((p: any) => {
        const patientName = p.nombre_completo || '—';
        return `<tr><td class="td-patient">${escapeHtml(patientName)}</td><td>${escapeHtml(p.email||'—')}</td><td>${p.fecha_nacimiento?fmtDate(p.fecha_nacimiento):'—'}</td><td>${fmtDate(p.creado_en||'')}</td><td><div class="table-actions"><button class="btn-sm btn-outline" data-action="view-patient" data-patient-id="${p.id}" data-patient-name="${escapeAttr(patientName)}">Ver</button><button class="btn-sm btn-outline" data-action="patient-telegram" data-patient-id="${p.id}" data-patient-name="${escapeAttr(patientName)}">Telegram</button></div></td></tr>`;
      }).join('');
    } catch {
      setTableState(pacientesBody, 5, 'cloud_off', 'Error al cargar pacientes');
    }
  };
  pageLoaders['pacientes'] = loadPacientes;
  document.getElementById('refreshPacientes')?.addEventListener('click', loadPacientes);
  searchInput?.setAttribute('aria-expanded', 'false');
  searchInput?.setAttribute('aria-controls', 'searchResults');
  searchInput?.addEventListener('focus', () => {
    if (!patientCatalog.length) {
      ensurePatientCatalog().catch(() => {});
    }
    const query = searchInput.value.trim();
    if (query.length >= 2) {
      updateSearchResults(query, false);
    }
  });
  searchInput?.addEventListener('input', () => {
    updateSearchResults(searchInput.value, true);
  });
  searchInput?.addEventListener('keydown', (event: KeyboardEvent) => {
    if (event.key === 'Escape') {
      hideSearchResults();
      return;
    }

    if (!quickSearchMatches.length) {
      if (event.key === 'Enter') {
        hideSearchResults();
      }
      return;
    }

    if (event.key === 'ArrowDown') {
      event.preventDefault();
      quickSearchActiveIndex = (quickSearchActiveIndex + 1) % quickSearchMatches.length;
      renderSearchResults(searchInput?.value || '');
      return;
    }

    if (event.key === 'ArrowUp') {
      event.preventDefault();
      quickSearchActiveIndex = (quickSearchActiveIndex - 1 + quickSearchMatches.length) % quickSearchMatches.length;
      renderSearchResults(searchInput?.value || '');
      return;
    }

    if (event.key === 'Enter') {
      event.preventDefault();
      openSearchMatch(quickSearchMatches[quickSearchActiveIndex >= 0 ? quickSearchActiveIndex : 0]);
    }
  });
  searchResults?.addEventListener('click', (event: Event) => {
    const target = event.target as HTMLElement | null;
    const button = target?.closest('button[data-search-patient-id]') as HTMLButtonElement | null;
    if (!button) return;
    openSearchMatch({
      id: button.getAttribute('data-search-patient-id') || '',
      nombre_completo: button.getAttribute('data-search-patient-name') || '',
    });
  });
  document.addEventListener('click', (event: MouseEvent) => {
    const target = event.target as Node | null;
    if (target && searchBox?.contains(target)) return;
    hideSearchResults();
  });

  addPatientBtn?.addEventListener('click', openPatientModal);
  closePatientModalBtn?.addEventListener('click', closePatientModal);
  patientModalDismiss?.addEventListener('click', closePatientModal);
  patientModal?.addEventListener('click', (event: Event) => {
    if (event.target === patientModal) {
      closePatientModal();
    }
  });
  document.addEventListener('keydown', (event: KeyboardEvent) => {
    if (event.key === 'Escape' && patientModal?.classList.contains('open')) {
      closePatientModal();
    }
  });
  patientForm?.addEventListener('submit', async (event: Event) => {
    event.preventDefault();

    const fullName = patientNameInput?.value.trim() || '';
    if (!fullName) {
      setPatientFormFeedback('Introduce al menos el nombre completo del paciente.');
      patientNameInput?.focus();
      return;
    }

    const previousLabel = patientSubmitBtn?.innerHTML || '';
    if (patientSubmitBtn) {
      patientSubmitBtn.disabled = true;
      patientSubmitBtn.innerHTML = '<span class="material-symbols-rounded">&#xe627;</span> Guardando...';
    }
    setPatientFormFeedback('Creando ficha del paciente...', 'success');

    try {
      const payload = await fetchJson(`${BACKEND_BASE}/api/pacientes`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          nombre_completo: fullName,
          fecha_nacimiento: patientBirthDateInput?.value || null,
          email: patientEmailInput?.value.trim() || null,
          phone: patientPhoneInput?.value.trim() || null,
          profesional_id: PROF_ID,
        }),
      }, 15000);

      const createdPatient = payload?.data || {};
      await loadPacientes();

      const createdId = createdPatient.id || null;
      const createdName =
        createdPatient.nombre_completo ||
        patientCatalog.find((patient) => patient.id === createdId)?.nombre_completo ||
        fullName;

      closePatientModal();
      addMessage(`Paciente ${createdName} creado correctamente y listo para trabajar en CRM.`, 'agent');

      if (createdId) {
        selectedTemplatePatientId = createdId;
        renderTemplatePatientOptions();
        syncChatPatientSelection(createdId, createdName);
        openPatientHistory(createdId, createdName);
      }
    } catch (err: any) {
      setPatientFormFeedback(`No se pudo crear el paciente: ${err?.message || 'error no identificado'}`);
    } finally {
      if (patientSubmitBtn) {
        patientSubmitBtn.disabled = false;
        patientSubmitBtn.innerHTML = previousLabel;
      }
    }
  });

  pacientesBody?.addEventListener('click', (event: Event) => {
    const target = event.target as HTMLElement | null;
    const btn = target?.closest('button[data-action]') as HTMLButtonElement | null;
    if (!btn) return;

    const action = btn.getAttribute('data-action') || '';
    if (!['view-patient', 'patient-telegram'].includes(action)) return;

    const patientId = btn.getAttribute('data-patient-id');
    const patientName = btn.getAttribute('data-patient-name') || '';
    selectedTemplatePatientId = patientId;
    renderTemplatePatientOptions();
    pendingHistoryAnchor = action === 'patient-telegram' ? 'telegram' : null;
    openPatientHistory(patientId, patientName);
  });

  // === LOAD PLANTILLAS ===
  const loadTemplates = async () => {
    if (!templatesBody) return;
    setTableState(templatesBody, 6, 'sync', 'Cargando plantillas...', true);
    try {
      if (!patientCatalog.length) await fetchPatientCatalog();
      const payload = await fetchJson(`${BACKEND_BASE}/api/profesional/program-templates?profesional_id=${PROF_ID}&limit=40`);
      const templates = payload.data || [];
      if (!templates.length) {
        setTableState(templatesBody, 6, 'library_books', 'No hay plantillas disponibles todavía.');
        return;
      }
      templatesBody.innerHTML = templates.map((tpl: any) => {
        const canClone = Boolean(selectedTemplatePatientId);
        const btnAttrs = canClone ? '' : 'disabled';
        const actionLabel = canClone ? 'Clonar' : 'Selecciona paciente';
        return `<tr>
          <td class="td-patient">${escapeHtml(tpl.template_title || 'Plantilla')}</td>
          <td>${tpl.usage_count || 0}</td>
          <td>${tpl.exercises_count || 0}</td>
          <td>${tpl.last_used_at ? fmtDate(tpl.last_used_at) : '—'}</td>
          <td>${escapeHtml(tpl.source_patient_name || '—')}</td>
          <td><button class="btn-sm btn-outline" data-action="clone-template" data-source-plan-id="${tpl.source_plan_id}" ${btnAttrs}>${actionLabel}</button></td>
        </tr>`;
      }).join('');
    } catch {
      setTableState(templatesBody, 6, 'cloud_off', 'Error al cargar plantillas.');
    }
  };
  pageLoaders['plantillas'] = loadTemplates;
  document.getElementById('refreshTemplates')?.addEventListener('click', loadTemplates);
  templateTargetPatient?.addEventListener('change', () => {
    selectedTemplatePatientId = templateTargetPatient.value || null;
    loadTemplates();
  });
  templatesBody?.addEventListener('click', async (event: Event) => {
    const target = event.target as HTMLElement | null;
    const btn = target?.closest('button[data-action="clone-template"]') as HTMLButtonElement | null;
    if (!btn) return;
    if (!selectedTemplatePatientId) {
      addMessage('Selecciona un paciente destino antes de clonar la plantilla.', 'agent');
      return;
    }

    const sourcePlanId = btn.getAttribute('data-source-plan-id');
    if (!sourcePlanId) return;

    btn.disabled = true;
    const oldText = btn.textContent || 'Clonar';
    btn.textContent = 'Clonando...';
    try {
      const payload = await fetchJson(`${BACKEND_BASE}/api/profesional/program-templates/clone`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          source_plan_id: sourcePlanId,
          paciente_id: selectedTemplatePatientId,
          profesional_id: PROF_ID,
        }),
      });
      const cloned = payload.data || {};
      addMessage(`Plantilla clonada correctamente (${escapeHtml(cloned.titulo || 'nuevo plan')}).`, 'agent');
      await loadTemplates();
    } catch {
      btn.disabled = false;
      btn.textContent = oldText;
      addMessage('No se pudo clonar la plantilla seleccionada.', 'agent');
    }
  });

  // === LOAD INTAKES FULL ===
  const loadIntakesFull = async () => {
    if (!intakesFullBody) return;
    setTableState(intakesFullBody, 7, 'sync', 'Cargando intakes...', true);
    try {
      const payload = await fetchJson(`${BACKEND_BASE}/api/profesional/intakes/pending?profesional_id=${PROF_ID}`);
      const intakes = payload.data || [];
      if (!intakes.length) { setTableState(intakesFullBody, 7, 'check_circle', 'Sin intakes pendientes'); return; }
      intakesFullBody.innerHTML = intakes.map((i: any) => {
        const alertas = i.tiene_alertas_rojas ? `<span class="status-chip rechazado">âš  Sí</span>` : '<span class="status-chip aprobado">No</span>';
        const patientName = resolvePatientName(i);
        return `<tr><td class="td-patient">${escapeHtml(patientName)}</td><td>${escapeHtml(i.fuente||'—')}</td><td>${escapeHtml((i.texto_mensaje||'').substring(0,80))}</td><td>${alertas}</td><td>${fmtDate(i.creado_en||'')}</td><td><span class="status-chip ${i.estado||'pendiente'}">${i.estado||'pendiente'}</span></td><td><button class="btn-sm btn-outline" data-action="view-history" data-patient-id="${i.paciente_id||''}" data-patient-name="${escapeAttr(patientName)}">Historial</button></td></tr>`;
      }).join('');
    } catch {
      setTableState(intakesFullBody, 7, 'cloud_off', 'Error al cargar intakes');
    }
  };
  pageLoaders['intakes'] = loadIntakesFull;
  document.getElementById('refreshIntakesFull')?.addEventListener('click', loadIntakesFull);
  intakesFullBody?.addEventListener('click', (event: Event) => {
    const target = event.target as HTMLElement | null;
    const btn = target?.closest('button[data-action="view-history"]') as HTMLButtonElement | null;
    if (!btn) return;
    openPatientHistory(btn.getAttribute('data-patient-id'), btn.getAttribute('data-patient-name') || '');
  });

  const renderDashboardCitas = (citas: any[], mode: 'ready' | 'error' = 'ready') => {
    if (!dashCitasBody) return;
    if (mode === 'error') {
      setListState(dashCitasBody, 'cloud_off', 'No se pudo cargar la agenda.');
      return;
    }
    if (!citas.length) {
      setListState(dashCitasBody, 'event_available', 'Sin citas agendadas por ahora.');
      return;
    }
    dashCitasBody.innerHTML = citas.slice(0, 6).map((cita: any) => {
      const stateClass = String(cita.estado || 'pendiente')
        .toLowerCase()
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .replace(/[^a-z0-9_ -]/g, '')
        .trim()
        .replace(/\s+/g, '_') || 'pendiente';
      return `<article class="clean-list-item">
        <div class="clean-list-main">
          <p class="clean-list-title">${escapeHtml(cita.nombre_paciente || 'Paciente sin nombre')}</p>
          <p class="clean-list-meta">${escapeHtml(fmtDate(cita.inicio_en || ''))} | ${escapeHtml(cita.motivo || 'Sin motivo')}</p>
        </div>
        <span class="status-chip ${stateClass}">${escapeHtml(cita.estado || 'pendiente')}</span>
      </article>`;
    }).join('');
  };

  // === AGENDA SEMANAL ===
  const getWeekMonday = (d: Date): Date => {
    const day = d.getDay();
    const diff = day === 0 ? -6 : 1 - day;
    const monday = new Date(d);
    monday.setDate(d.getDate() + diff);
    monday.setHours(0, 0, 0, 0);
    return monday;
  };
  const fmtHourOnly = (iso: string) => {
    try { return new Date(iso).toLocaleTimeString('es-ES', { hour: '2-digit', minute: '2-digit', timeZone: 'Europe/Madrid' }); } catch { return ''; }
  };
  const fmtDayShortName = (d: Date) =>
    d.toLocaleDateString('es-ES', { weekday: 'short', day: 'numeric', timeZone: 'Europe/Madrid' });
  const fmtDayFull = (d: Date) =>
    d.toLocaleDateString('es-ES', { weekday: 'short', day: 'numeric', month: 'short', timeZone: 'Europe/Madrid' });

  let agendaWeekStart: Date = getWeekMonday(new Date());

  const renderAgendaCalendar = (citas: any[], weekStart: Date) => {
    const cal = document.getElementById('agendaCalendar');
    if (!cal) return;

    const HOUR_SLOTS = [9, 10, 11, 12, 15, 16, 17, 18];
    const weekDays: Date[] = Array.from({ length: 5 }, (_, i) => {
      const d = new Date(weekStart);
      d.setDate(weekStart.getDate() + i);
      return d;
    });

    // Map day×hour → appointments
    const apptMap = new Map<string, any[]>();
    for (const cita of citas) {
      const start = new Date(cita.inicio_en);
      const dayIdx = weekDays.findIndex(d => d.toDateString() === start.toDateString());
      if (dayIdx < 0) continue;
      const hour = start.getHours();
      const slotHour = HOUR_SLOTS.find(h => hour >= h && hour < h + 1);
      if (slotHour === undefined) continue;
      const key = `${dayIdx}-${slotHour}`;
      if (!apptMap.has(key)) apptMap.set(key, []);
      apptMap.get(key)!.push(cita);
    }

    // Status colors (inline — Astro scoped styles don't apply to dynamic innerHTML)
    const STATUS: Record<string, { bg: string; color: string; border: string }> = {
      confirmada: { bg: '#d1fae5', color: '#065f46', border: '#10b981' },
      pendiente:  { bg: '#fef3c7', color: '#92400e', border: '#f59e0b' },
      cancelada:  { bg: '#f1f5f9', color: '#94a3b8', border: '#cbd5e1' },
      completada: { bg: '#ede9fe', color: '#4c1d95', border: '#7c3aed' },
      no_show:    { bg: '#fff1f2', color: '#be123c', border: '#f43f5e' },
    };
    const DEF = STATUS.pendiente;
    const todayStr = new Date().toDateString();

    // Table layout — works regardless of Astro style scoping
    const thBase = 'padding:10px 8px;text-align:center;border-bottom:2px solid #e2e8f0;font-size:0.8rem;font-weight:700;white-space:nowrap;';
    let html = `<div style="overflow-x:auto;width:100%;">
<table style="width:100%;border-collapse:collapse;table-layout:fixed;min-width:520px;">
<thead><tr>
  <th style="${thBase}width:52px;background:#f8fafc;color:#94a3b8;"></th>`;

    for (let i = 0; i < 5; i++) {
      const isToday = weekDays[i].toDateString() === todayStr;
      const label = weekDays[i].toLocaleDateString('es-ES', { weekday: 'short', day: 'numeric' });
      const dayNum = weekDays[i].toLocaleDateString('es-ES', { day: 'numeric' });
      const dayName = weekDays[i].toLocaleDateString('es-ES', { weekday: 'short' });
      const bg = isToday ? '#eff6ff' : '#f8fafc';
      const col = isToday ? '#2563eb' : '#334155';
      html += `<th style="${thBase}background:${bg};color:${col};text-transform:capitalize;">
        <span style="display:block;font-size:0.7rem;font-weight:500;opacity:0.7;">${escapeHtml(dayName)}</span>
        <span style="display:block;font-size:1.1rem;font-weight:700;">${dayNum}</span>
      </th>`;
    }
    html += '</tr></thead><tbody>';

    // Separator row between morning and afternoon
    let prevSlotWasBreak = false;

    for (let si = 0; si < HOUR_SLOTS.length; si++) {
      const hour = HOUR_SLOTS[si];
      const prevHour = si > 0 ? HOUR_SLOTS[si - 1] : null;
      // Lunch break separator
      if (prevHour !== null && hour - prevHour > 1) {
        html += `<tr><td colspan="6" style="padding:4px 8px;background:#f8fafc;border-top:2px dashed #e2e8f0;border-bottom:2px dashed #e2e8f0;text-align:center;font-size:0.7rem;color:#94a3b8;font-style:italic;">pausa 13:00 – 15:00</td></tr>`;
      }

      const timeLabel = `${String(hour).padStart(2,'0')}:00`;
      html += `<tr>
        <td style="padding:6px 8px;text-align:right;font-size:0.72rem;color:#94a3b8;font-weight:600;vertical-align:top;white-space:nowrap;background:#f8fafc;border-right:2px solid #e2e8f0;border-bottom:1px solid #f1f5f9;">${timeLabel}</td>`;

      for (let dayIdx = 0; dayIdx < 5; dayIdx++) {
        const appts = apptMap.get(`${dayIdx}-${hour}`) || [];
        const isToday = weekDays[dayIdx].toDateString() === todayStr;
        const cellBg = isToday ? '#fafcff' : '#fff';
        html += `<td style="padding:3px;vertical-align:top;background:${cellBg};border-bottom:1px solid #f1f5f9;border-right:1px solid #f1f5f9;min-height:58px;height:58px;">`;
        for (const a of appts) {
          const st = a.estado || 'pendiente';
          const c = STATUS[st] || DEF;
          const firstName = (a.nombre_paciente || 'Paciente').split(' ')[0];
          const timeStr = fmtHourOnly(a.inicio_en);
          const motivo = a.motivo ? a.motivo.slice(0, 22) : '';
          const tip = escapeAttr(`${a.nombre_paciente || ''} ${a.motivo ? '– ' + a.motivo : ''}`);
          html += `<div style="background:${c.bg};color:${c.color};border-left:3px solid ${c.border};border-radius:4px;padding:3px 5px 4px;margin-bottom:2px;font-size:0.71rem;overflow:hidden;cursor:default;line-height:1.3;" title="${tip}">
            <div style="font-weight:700;font-size:0.63rem;opacity:0.8;margin-bottom:1px;">${timeStr}</div>
            <div style="font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">${escapeHtml(firstName)}</div>
            ${motivo ? `<div style="font-size:0.62rem;opacity:0.75;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">${escapeHtml(motivo)}</div>` : ''}
          </div>`;
        }
        html += '</td>';
      }
      html += '</tr>';
    }

    html += '</tbody></table></div>';
    cal.innerHTML = html;
  };

  // === LOAD CITAS ===
  const loadCitas = async () => {
    const cal = document.getElementById('agendaCalendar');
    if (cal) cal.innerHTML = '<div class="agenda-cal-loading"><span class="material-symbols-rounded">&#xe627;</span> Cargando...</div>';
    if (citasBody) setTableState(citasBody, 6, 'sync', 'Cargando agenda...', true);
    setListState(dashCitasBody, 'sync', 'Actualizando agenda...', true);

    const weekLabelEl = document.getElementById('weekLabel');
    if (weekLabelEl) {
      const weekEnd = new Date(agendaWeekStart);
      weekEnd.setDate(agendaWeekStart.getDate() + 4);
      weekLabelEl.textContent = `${agendaWeekStart.toLocaleDateString('es-ES', { day: 'numeric', month: 'short' })} – ${weekEnd.toLocaleDateString('es-ES', { day: 'numeric', month: 'short', year: 'numeric' })}`;
    }

    const desde = new Date(agendaWeekStart).toISOString();
    const hastaDate = new Date(agendaWeekStart);
    hastaDate.setDate(hastaDate.getDate() + 5);
    const hasta = hastaDate.toISOString();

    try {
      const payload = await fetchJson(
        `${BACKEND_BASE}/api/profesional/appointments?fisioterapeuta_id=${PROF_ID}&limit=100&desde=${encodeURIComponent(desde)}&hasta=${encodeURIComponent(hasta)}`
      );
      const citas = payload.data || [];
      renderDashboardCitas(citas);
      const todayCount = citas.filter((c: any) => isTodayDate(c.inicio_en || '')).length;
      const metricEl = document.getElementById('metricSesiones');
      if (metricEl) metricEl.textContent = String(todayCount);

      renderAgendaCalendar(citas, agendaWeekStart);

      const countEl = document.getElementById('weekPatientCount');
      if (countEl) countEl.textContent = citas.length ? String(citas.length) : '';

      if (!citasBody) return;
      if (!citas.length) {
        setTableState(citasBody, 6, 'event_busy', 'No hay citas esta semana.');
        return;
      }
      const sorted = [...citas].sort((a: any, b: any) => new Date(a.inicio_en).getTime() - new Date(b.inicio_en).getTime());
      citasBody.innerHTML = sorted.map((cita: any) => {
        const start = new Date(cita.inicio_en);
        const dayStr = fmtDayFull(start);
        const hourStr = fmtHourOnly(cita.inicio_en);
        const canal = cita.canal_origen === 'telegram' ? 'Telegram' : cita.canal_origen === 'crm_web' ? 'CRM Web' : cita.canal_origen || '—';
        return `<tr>
          <td class="td-patient">${escapeHtml(cita.nombre_paciente || 'Paciente')}</td>
          <td>${escapeHtml(dayStr)}</td>
          <td>${escapeHtml(hourStr)}</td>
          <td>${escapeHtml(cita.motivo || '—')}</td>
          <td>${escapeHtml(canal)}</td>
          <td><span class="status-chip ${cita.estado || 'pendiente'}">${escapeHtml(cita.estado || 'pendiente')}</span></td>
        </tr>`;
      }).join('');
    } catch {
      if (cal) cal.innerHTML = '<div class="agenda-cal-loading">Error al cargar la agenda</div>';
      setTableState(citasBody, 6, 'cloud_off', 'Error al cargar citas');
      renderDashboardCitas([], 'error');
    }
  };

  pageLoaders['citas'] = loadCitas;
  document.getElementById('refreshCitas')?.addEventListener('click', loadCitas);
  document.getElementById('prevWeek')?.addEventListener('click', () => {
    agendaWeekStart = new Date(agendaWeekStart);
    agendaWeekStart.setDate(agendaWeekStart.getDate() - 7);
    loadCitas();
  });
  document.getElementById('nextWeek')?.addEventListener('click', () => {
    agendaWeekStart = new Date(agendaWeekStart);
    agendaWeekStart.setDate(agendaWeekStart.getDate() + 7);
    loadCitas();
  });
  document.getElementById('thisWeek')?.addEventListener('click', () => {
    agendaWeekStart = getWeekMonday(new Date());
    loadCitas();
  });
  loadCitas();

  const historyNoteComposerHtml = `
    <form class="history-note-form" data-role="history-note-form">
      <label class="history-note-field">
        <span>Nueva nota clinica</span>
        <textarea name="texto_nota" rows="4" placeholder="Ej.: mejor tolerancia a la movilidad, mantiene dolor 3/10 y cumple ejercicios domiciliarios." required></textarea>
      </label>
      <input type="hidden" name="fuente" value="crm_web" />
      <p class="history-note-feedback" data-role="history-note-feedback" hidden></p>
      <div class="history-note-actions">
        <button type="submit" class="btn-primary btn-history-note">
          <span class="material-symbols-rounded">&#xe89c;</span>
          Guardar seguimiento
        </button>
      </div>
    </form>
  `;

  const setHistoryNoteFeedback = (formEl: HTMLFormElement | null, text = '', state: 'error' | 'success' = 'error') => {
    const feedbackEl = formEl?.querySelector('[data-role="history-note-feedback"]') as HTMLElement | null;
    if (!feedbackEl) return;
    if (!text) {
      feedbackEl.hidden = true;
      feedbackEl.textContent = '';
      feedbackEl.removeAttribute('data-state');
      return;
    }
    feedbackEl.hidden = false;
    feedbackEl.textContent = text;
    feedbackEl.setAttribute('data-state', state);
  };

  const TELEGRAM_LINK_STATUS_META: Record<string, { label: string; chipClass: string }> = {
    linked: { label: 'Vinculado', chipClass: 'aprobado' },
    pending: { label: 'Codigo pendiente', chipClass: 'pendiente' },
    not_linked: { label: 'Sin vincular', chipClass: 'rechazado' },
  };

  const copyTextToClipboard = async (rawValue: unknown) => {
    const value = String(rawValue || '').trim();
    if (!value) return false;

    if (navigator?.clipboard?.writeText) {
      await navigator.clipboard.writeText(value);
      return true;
    }

    const temp = document.createElement('textarea');
    temp.value = value;
    temp.setAttribute('readonly', 'true');
    temp.style.position = 'absolute';
    temp.style.left = '-9999px';
    document.body.appendChild(temp);
    temp.select();
    const copied = document.execCommand('copy');
    document.body.removeChild(temp);
    return copied;
  };

  const renderPatientTelegramLinkBlock = (linkState: any, errorMessage = '') => {
    if (errorMessage) {
      return `
        <div class="detail-block">
          <h3>Canal Telegram</h3>
          <p class="detail-caption telegram-link-error">${escapeHtml(errorMessage)}</p>
        </div>
      `;
    }

    const normalizedStatus = String(linkState?.link_status || 'not_linked');
    const statusMeta = TELEGRAM_LINK_STATUS_META[normalizedStatus] || TELEGRAM_LINK_STATUS_META.not_linked;
    const username = linkState?.telegram_username ? `@${linkState.telegram_username}` : null;
    const linkedAt = linkState?.vinculado_en ? fmtDate(linkState.vinculado_en) : null;
    const startCommand = linkState?.telegram_start_command || '';
    const deepLink = linkState?.telegram_deep_link || '';
    const actions: string[] = [];

    if (normalizedStatus === 'not_linked') {
      actions.push('<button type="button" class="btn-sm btn-outline" data-action="telegram-link-create">Preparar invitacion</button>');
    }

    if (normalizedStatus === 'pending') {
      actions.push(`<button type="button" class="btn-sm btn-outline" data-action="telegram-copy-command" data-copy-value="${escapeAttr(startCommand)}">Copiar /start</button>`);
      if (deepLink) {
        actions.push(`<button type="button" class="btn-sm btn-outline" data-action="telegram-copy-link" data-copy-value="${escapeAttr(deepLink)}">Copiar enlace</button>`);
      }
      actions.push('<button type="button" class="btn-sm btn-outline" data-action="telegram-link-regenerate">Regenerar codigo</button>');
    }

    const hint = normalizedStatus === 'linked'
      ? 'El paciente ya tiene un chat Telegram vinculado. No genero un codigo nuevo para no romper ese enlace.'
      : normalizedStatus === 'pending'
        ? 'Comparte el comando o el enlace con el paciente para completar la vinculacion desde Telegram.'
        : 'Genera una invitacion segura para que el paciente vincule su chat con /start.';

    return `
      <div class="detail-block" id="patientTelegramLinkBlock" tabindex="-1">
        <div class="telegram-link-head">
          <div>
            <h3>Canal Telegram</h3>
            <p class="detail-caption">${escapeHtml(hint)}</p>
          </div>
          <span class="status-chip ${statusMeta.chipClass}">${escapeHtml(statusMeta.label)}</span>
        </div>
        <div class="telegram-link-card">
          <div class="telegram-link-grid">
            <p><strong>Paciente:</strong> ${escapeHtml(linkState?.patient_name || selectedPatientName || 'Paciente seleccionado')}</p>
            <p><strong>Usuario:</strong> ${escapeHtml(username || 'Sin username')}</p>
            <p><strong>Vinculado:</strong> ${escapeHtml(linkedAt || 'Aun no')}</p>
            <p><strong>Codigo:</strong> ${escapeHtml(linkState?.codigo_vinculacion || 'No generado')}</p>
          </div>
          ${startCommand ? `<div class="telegram-link-command"><code>${escapeHtml(startCommand)}</code></div>` : ''}
          ${actions.length ? `<div class="telegram-link-actions">${actions.join('')}</div>` : ''}
        </div>
      </div>
    `;
  };

  // === LOAD HISTORIAL ===
  const loadHistorial = async () => {
    if (!historialContent) return;
    if (!selectedPatientId) {
      currentPatientTelegramLinkState = null;
      historialContent.innerHTML = `<div class="empty-state"><span class="material-symbols-rounded">&#xe889;</span><p>Selecciona un paciente para ver su historial</p></div>`;
      return;
    }
    historialContent.innerHTML = `<div class="empty-state state-loading"><span class="material-symbols-rounded">&#xe627;</span><p>Cargando historial de ${escapeHtml(selectedPatientName || 'paciente')}...</p></div>`;

    try {
      const [patientResp, historyResp, recommendationsResp, telegramLinkResp] = await Promise.all([
        fetchJson(`${BACKEND_BASE}/api/pacientes/${selectedPatientId}`),
        fetchJson(`${BACKEND_BASE}/api/profesional/patients/${selectedPatientId}/history`),
        fetchJson(`${BACKEND_BASE}/api/exercises/recommendations/${selectedPatientId}?limit=25`),
        fetchJson(`${BACKEND_BASE}/api/telegram/link-code/${selectedPatientId}`).catch((err: any) => ({ error: err?.message || 'No se pudo cargar el estado de Telegram.' })),
      ]);

      const patient = patientResp?.data || {};
      const notes = historyResp?.data?.notas_seguimiento || [];
      const recommendations = recommendationsResp?.data || [];
      const telegramLink = telegramLinkResp?.data || null;
      const telegramLinkError = telegramLinkResp?.error || '';
      currentPatientTelegramLinkState = telegramLink;
      const displayName = patient?.nombre_completo || selectedPatientName || `Paciente #${selectedPatientId}`;
      syncAssistantPatientBriefFromData(selectedPatientId, patient, notes, recommendations);

      const notesHtml = notes.length
        ? `<ul class="detail-list">${notes.map((note: any) => `<li><strong>${fmtDate(note.creado_en || '')}</strong><br>${escapeHtml(note.texto_nota || 'Sin texto')}</li>`).join('')}</ul>`
        : `<p class="detail-empty">Sin notas de seguimiento registradas.</p>`;

      const recommendationsHtml = recommendations.length
        ? `<div class="recommendation-list">${recommendations.map((rec: any) => {
          const report = rec?.report_snapshot || {};
          const followUps = Array.isArray(rec?.follow_ups) ? rec.follow_ups : [];
          const reportExercises = Array.isArray(report?.exercises) ? report.exercises : [];
          const itemExercises = Array.isArray(rec?.crm_recomendacion_items)
            ? rec.crm_recomendacion_items.map((item: any) => ({
              nombre: item?.crm_ejercicios_catalogo?.nombre || item?.ejercicio_id || 'Ejercicio',
              why: item?.why || '',
            }))
            : [];
          const exercises = reportExercises.length ? reportExercises : itemExercises;
          const stateClass = rec?.estado === 'enviada'
            ? 'aprobado'
            : rec?.estado === 'requiere_revision'
              ? 'rechazado'
              : 'pendiente';
          const redFlagsHtml = rec?.red_flags_present
            ? '<span class="status-chip rechazado">Alertas rojas</span>'
            : '<span class="status-chip aprobado">Sin alertas</span>';
          const therapistNote = report?.message_to_therapist || rec?.message_to_therapist_es || '';
          const patientMsg = report?.message_to_patient || rec?.message_to_patient_es || '';
          const exercisesHtml = exercises.length
            ? `<ul class="recommendation-exercises">${exercises.slice(0, 8).map((ex: any, idx: number) => `<li><strong>${idx + 1}. ${escapeHtml(ex?.nombre || ex?.name || 'Ejercicio')}</strong>${ex?.why ? ` - ${escapeHtml(ex.why)}` : ''}</li>`).join('')}</ul>`
            : '<p class="detail-empty">Sin ejercicios detallados en esta recomendacion.</p>';
          const followUpsHtml = followUps.length
            ? `<ul class="detail-list">${followUps.slice(0, 5).map((fu: any) => `<li><strong>${fmtDate(fu?.created_at || '')}</strong><br>${escapeHtml(fu?.note_text || 'Seguimiento sin nota')}${fu?.pain_scale !== null && fu?.pain_scale !== undefined ? ` - Dolor ${escapeHtml(fu.pain_scale)}/10` : ''}</li>`).join('')}</ul>`
            : '<p class="detail-empty">Sin seguimiento registrado todavia.</p>';

          return `
            <article class="recommendation-card">
              <div class="recommendation-head">
                <div>
                  <h4>Recomendacion ${escapeHtml(rec?.id || '-')}</h4>
                  <p>${fmtDate(rec?.created_at || '')}</p>
                </div>
                <div class="recommendation-chips">
                  <span class="status-chip ${stateClass}">${escapeHtml(rec?.estado || 'generada')}</span>
                  ${redFlagsHtml}
                </div>
              </div>
              ${therapistNote ? `<p class="recommendation-note"><strong>Nota clinica:</strong> ${escapeHtml(therapistNote)}</p>` : ''}
              ${patientMsg ? `<p class="recommendation-note"><strong>Mensaje paciente:</strong> ${escapeHtml(patientMsg)}</p>` : ''}
              <div class="recommendation-section">
                <h5>Ejercicios (${exercises.length})</h5>
                ${exercisesHtml}
              </div>
              <div class="recommendation-section">
                <h5>Seguimiento (${followUps.length})</h5>
                ${followUpsHtml}
              </div>
            </article>
          `;
        }).join('')}</div>`
        : `<p class="detail-empty">Sin recomendaciones de ejercicios registradas.</p>`;

      historialContent.innerHTML = `
        <div class="detail-block">
          <h3>${escapeHtml(displayName)}</h3>
          <p><strong>Email:</strong> ${escapeHtml(patient.email || '-')} - <strong>Nacimiento:</strong> ${patient.fecha_nacimiento ? fmtDate(patient.fecha_nacimiento) : '-'}</p>
        </div>
        ${renderPatientTelegramLinkBlock(telegramLink, telegramLinkError)}
        <div class="detail-block">
          <h3>Registrar seguimiento</h3>
          <p class="detail-caption">Guarda observaciones clinicas del paciente directamente desde el CRM. Usa Ctrl+Enter para enviar mas rapido.</p>
          ${historyNoteComposerHtml}
        </div>
        <div class="detail-block">
          <h3>Notas de seguimiento (${notes.length})</h3>
          ${notesHtml}
        </div>
        <div class="detail-block">
          <h3>Informes y recomendaciones (${recommendations.length})</h3>
          ${recommendationsHtml}
        </div>
      `;

      if (pendingHistoryAnchor) {
        focusHistoryAnchor(pendingHistoryAnchor);
        pendingHistoryAnchor = null;
      }
    } catch {
      pendingHistoryAnchor = null;
      currentPatientTelegramLinkState = null;
      historialContent.innerHTML = `<div class="empty-state"><span class="material-symbols-rounded">&#xe2be;</span><p>No se pudo cargar el historial del paciente seleccionado.</p></div>`;
    }
  };
  pageLoaders['historial'] = loadHistorial;
  document.getElementById('refreshHistorial')?.addEventListener('click', loadHistorial);
  historialContent?.addEventListener('click', async (event: Event) => {
    const target = event.target as HTMLElement | null;
    const btn = target?.closest('button[data-action^="telegram-"]') as HTMLButtonElement | null;
    if (!btn || !selectedPatientId) return;

    const action = btn.getAttribute('data-action') || '';
    const patientName = selectedPatientName || currentPatientTelegramLinkState?.patient_name || 'el paciente seleccionado';

    if (action === 'telegram-copy-command' || action === 'telegram-copy-link') {
      const copyValue = btn.getAttribute('data-copy-value') || '';
      if (!copyValue) {
        addMessage('No hay un valor de invitacion disponible para copiar.', 'agent');
        return;
      }

      try {
        const copied = await copyTextToClipboard(copyValue);
        addMessage(
          copied
            ? `Invitacion Telegram copiada para ${patientName}.`
            : 'No pude copiar el texto al portapapeles en este navegador.',
          'agent'
        );
      } catch {
        addMessage('No pude copiar el texto al portapapeles en este navegador.', 'agent');
      }
      return;
    }

    if (!['telegram-link-create', 'telegram-link-regenerate'].includes(action)) return;

    const previousLabel = btn.innerHTML;
    btn.disabled = true;
    btn.innerHTML = '<span class="material-symbols-rounded">&#xe627;</span> Preparando...';

    try {
      const payload = await fetchJson(`${BACKEND_BASE}/api/telegram/link-code/${selectedPatientId}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(action === 'telegram-link-regenerate' ? { regenerate: true } : {}),
      }, 15000);

      currentPatientTelegramLinkState = payload?.data || null;
      await loadHistorial();

      if (payload?.warning === 'patient_already_linked') {
        addMessage(
          `Telegram ya estaba vinculado para ${patientName}. No genero un codigo nuevo para no romper el chat actual.`,
          'agent'
        );
        return;
      }

      const command = payload?.data?.telegram_start_command || '';
      addMessage(
        command
          ? `Invitacion Telegram lista para ${patientName}. Puedes compartir ${command}.`
          : `Estado Telegram actualizado para ${patientName}.`,
        'agent'
      );
    } catch (err: any) {
      addMessage(`No se pudo preparar la invitacion Telegram: ${err?.message || 'error no identificado'}`, 'agent');
      btn.disabled = false;
      btn.innerHTML = previousLabel;
    }
  });
  historialContent?.addEventListener('submit', async (event: Event) => {
    const formEl = event.target as HTMLFormElement | null;
    if (!formEl?.matches('form[data-role="history-note-form"]')) return;

    event.preventDefault();
    if (!selectedPatientId) {
      addMessage('Selecciona un paciente antes de guardar una nota de seguimiento.', 'agent');
      return;
    }

    const noteInput = formEl.elements.namedItem('texto_nota') as HTMLTextAreaElement | null;
    const sourceInput = formEl.elements.namedItem('fuente') as HTMLInputElement | null;
    const submitBtn = formEl.querySelector('button[type="submit"]') as HTMLButtonElement | null;
    const noteText = noteInput?.value.trim() || '';
    if (!noteText) {
      setHistoryNoteFeedback(formEl, 'Escribe una nota antes de guardarla.');
      noteInput?.focus();
      return;
    }

    const previousLabel = submitBtn?.innerHTML || '';
    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.innerHTML = '<span class="material-symbols-rounded">&#xe627;</span> Guardando...';
    }
    setHistoryNoteFeedback(formEl, 'Guardando nota de seguimiento...', 'success');

    try {
      await fetchJson(`${BACKEND_BASE}/api/profesional/notes`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          paciente_id: selectedPatientId,
          profesional_id: PROF_ID,
          texto_nota: noteText,
          fuente: sourceInput?.value || 'crm_web',
        }),
      }, 15000);

      addMessage(`Nota de seguimiento guardada para ${selectedPatientName || 'el paciente seleccionado'}.`, 'agent');
      await loadHistorial();
    } catch (err: any) {
      setHistoryNoteFeedback(formEl, `No se pudo guardar la nota: ${err?.message || 'error no identificado'}`);
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.innerHTML = previousLabel;
      }
      return;
    }
  });
  historialContent?.addEventListener('keydown', (event: KeyboardEvent) => {
    const target = event.target as HTMLTextAreaElement | null;
    if (!target || target.name !== 'texto_nota') return;
    if (event.ctrlKey && event.key === 'Enter') {
      event.preventDefault();
      target.form?.requestSubmit();
    }
  });


  // === CONFIG PAGE ===
  // ===================== PAGOS =====================
  const pagosBody = document.getElementById('pagosBody') as HTMLElement | null;
  const pagosAnioFilter = document.getElementById('pagosAnioFilter') as HTMLSelectElement | null;
  const pagosMesFilter = document.getElementById('pagosMesFilter') as HTMLSelectElement | null;
  const pagoModal = document.getElementById('pagoModal');
  const pagoForm = document.getElementById('pagoForm') as HTMLFormElement | null;
  const pagoEditId = document.getElementById('pagoEditId') as HTMLInputElement | null;
  const pagoPacienteSelect = document.getElementById('pagoPacienteSelect') as HTMLSelectElement | null;
  const pagoFechaInput = document.getElementById('pagoFechaInput') as HTMLInputElement | null;
  const pagoImporteInput = document.getElementById('pagoImporteInput') as HTMLInputElement | null;
  const pagoNotasInput = document.getElementById('pagoNotasInput') as HTMLInputElement | null;
  const pagoFormFeedback = document.getElementById('pagoFormFeedback') as HTMLElement | null;
  const pagoSubmitBtn = document.getElementById('pagoSubmitBtn') as HTMLButtonElement | null;
  const pagoModalTitle = document.getElementById('pagoModalTitle');

  // Populate year filter
  (() => {
    if (!pagosAnioFilter) return;
    const y = new Date().getFullYear();
    for (let i = y; i >= y - 3; i--) {
      const o = document.createElement('option');
      o.value = String(i); o.textContent = String(i);
      pagosAnioFilter.appendChild(o);
    }
  })();

  // Auto-select current month
  if (pagosMesFilter) pagosMesFilter.value = String(new Date().getMonth() + 1);

  const setPagoFeedback = (text = '', state: 'error' | 'success' = 'error') => {
    if (!pagoFormFeedback) return;
    if (!text) { pagoFormFeedback.hidden = true; pagoFormFeedback.textContent = ''; pagoFormFeedback.removeAttribute('data-state'); return; }
    pagoFormFeedback.hidden = false; pagoFormFeedback.textContent = text; pagoFormFeedback.setAttribute('data-state', state);
  };

  const getSelectedMetodo = () => {
    const checked = pagoForm?.querySelector('input[name="metodo_pago"]:checked') as HTMLInputElement | null;
    return checked?.value || 'efectivo';
  };

  const setSelectedMetodo = (val: string) => {
    const radio = pagoForm?.querySelector(`input[name="metodo_pago"][value="${val}"]`) as HTMLInputElement | null;
    if (radio) radio.checked = true;
  };

  const populatePagoPacienteSelect = async () => {
    if (!pagoPacienteSelect) return;
    if (!patientCatalog.length) await fetchPatientCatalog();
    const current = pagoPacienteSelect.value;
    // Only CRM patients — legacy IDs don't exist in crm_pacientes (FK constraint)
    const crmPts = patientCatalog.filter((p: any) => p._source !== 'legacy');
    pagoPacienteSelect.innerHTML = '<option value="">-- Selecciona paciente --</option>' +
      crmPts.map((p: any) =>
        `<option value="${p.id}">${escapeHtml(p.nombre_completo || '—')}</option>`
      ).join('');
    if (current) pagoPacienteSelect.value = current;
  };

  const openPagoModal = async (editData?: any) => {
    pagoForm?.reset();
    setPagoFeedback();
    if (pagoEditId) pagoEditId.value = '';
    if (pagoFechaInput) pagoFechaInput.value = new Date().toISOString().slice(0, 10);
    await populatePagoPacienteSelect();

    if (editData) {
      if (pagoModalTitle) pagoModalTitle.textContent = 'Editar pago';
      if (pagoEditId) pagoEditId.value = editData.id;
      if (pagoPacienteSelect) pagoPacienteSelect.value = editData.paciente_id || '';
      if (pagoFechaInput) pagoFechaInput.value = editData.fecha || '';
      if (pagoImporteInput) pagoImporteInput.value = String(editData.importe);
      setSelectedMetodo(editData.metodo_pago || 'efectivo');
      if (pagoNotasInput) pagoNotasInput.value = editData.notas || '';
    } else {
      if (pagoModalTitle) pagoModalTitle.textContent = 'Registrar pago';
    }

    pagoModal?.classList.add('open');
    pagoModal?.setAttribute('aria-hidden', 'false');
    document.body.classList.add('has-modal-open');
    window.setTimeout(() => pagoPacienteSelect?.focus(), 25);
  };

  const closePagoModal = () => {
    pagoModal?.classList.remove('open');
    pagoModal?.setAttribute('aria-hidden', 'true');
    document.body.classList.remove('has-modal-open');
  };

  document.getElementById('addPagoBtn')?.addEventListener('click', () => openPagoModal());
  document.getElementById('closePagoModalBtn')?.addEventListener('click', closePagoModal);
  document.getElementById('pagoModalDismiss')?.addEventListener('click', closePagoModal);

  const fmtMoney = (n: number) => n.toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, '.').replace(/\.(\d{2})$/, ',$1') + ' \u20ac';

  const loadPagos = async () => {
    if (!pagosBody) return;
    setTableState(pagosBody, 5, 'sync', 'Cargando pagos...', true);

    const anio = pagosAnioFilter?.value || String(new Date().getFullYear());
    const mes = pagosMesFilter?.value || '';
    const params = new URLSearchParams({ anio });
    if (mes) params.set('mes', mes);

    try {
      const [listPayload, resumenPayload] = await Promise.all([
        fetchJson(`${BACKEND_BASE}/api/pagos?${params.toString()}`),
        fetchJson(`${BACKEND_BASE}/api/pagos/resumen?anio=${anio}`),
      ]);

      const pagos = listPayload?.data || [];
      const resumen = resumenPayload?.resumen || [];

      // Summary stats
      if (mes) {
        const d = resumen.find((r: any) => r.mes === Number(mes)) || { total: 0, sesiones: 0, efectivo: 0, tarjeta: 0 };
        document.getElementById('pagosTotalImporte')!.textContent = fmtMoney(d.total);
        document.getElementById('pagosTotalSesiones')!.textContent = String(d.sesiones);
        document.getElementById('pagosTotalEfectivo')!.textContent = fmtMoney(d.efectivo);
        document.getElementById('pagosTotalTarjeta')!.textContent = fmtMoney(d.tarjeta);
      } else {
        document.getElementById('pagosTotalImporte')!.textContent = fmtMoney(resumenPayload?.total_anual || 0);
        document.getElementById('pagosTotalSesiones')!.textContent = String(resumenPayload?.total_sesiones || 0);
        document.getElementById('pagosTotalEfectivo')!.textContent = fmtMoney(resumen.reduce((s: number, r: any) => s + (r.efectivo || 0), 0));
        document.getElementById('pagosTotalTarjeta')!.textContent = fmtMoney(resumen.reduce((s: number, r: any) => s + (r.tarjeta || 0), 0));
      }

      if (!pagos.length) { setTableState(pagosBody, 5, 'credit_card_off', 'Sin pagos en este periodo'); return; }

      pagosBody.innerHTML = pagos.map((p: any) => {
        const pName = p.crm_pacientes ? `${p.crm_pacientes.nombre || ''} ${p.crm_pacientes.apellidos || ''}`.trim() : '—';
        const chip = p.metodo_pago === 'efectivo'
          ? '<span class="pagos-chip pagos-chip-cash">Efectivo</span>'
          : '<span class="pagos-chip pagos-chip-card">Tarjeta</span>';
        return `<tr>
          <td>${p.fecha ? new Date(p.fecha + 'T00:00:00').toLocaleDateString('es-ES', {day:'2-digit',month:'short'}) : '—'}</td>
          <td class="td-patient">${escapeHtml(pName)}</td>
          <td>${chip}</td>
          <td class="text-right"><strong>${fmtMoney(Number(p.importe))}</strong></td>
          <td><button class="btn-sm btn-outline btn-danger-outline" data-action="delete-pago" data-pago-id="${p.id}" title="Eliminar">&times;</button></td>
        </tr>`;
      }).join('');

    } catch {
      setTableState(pagosBody, 5, 'cloud_off', 'Error al cargar pagos');
    }
  };

  pageLoaders['pagos'] = loadPagos;
  pagosAnioFilter?.addEventListener('change', loadPagos);
  pagosMesFilter?.addEventListener('change', loadPagos);

  pagosBody?.addEventListener('click', async (event: Event) => {
    const btn = (event.target as HTMLElement).closest('button[data-action="delete-pago"]') as HTMLButtonElement | null;
    if (!btn) return;
    const pagoId = btn.getAttribute('data-pago-id');
    if (!pagoId || !confirm('¿Eliminar este pago?')) return;
    try {
      await fetchJson(`${BACKEND_BASE}/api/pagos/${pagoId}`, { method: 'DELETE' });
      await loadPagos();
    } catch (err: any) {
      alert('Error: ' + (err?.message || 'desconocido'));
    }
  });

  pagoForm?.addEventListener('submit', async (event: Event) => {
    event.preventDefault();
    const pacienteId = pagoPacienteSelect?.value || '';
    if (!pacienteId) { setPagoFeedback('Selecciona un paciente.'); pagoPacienteSelect?.focus(); return; }
    const importe = Number(pagoImporteInput?.value);
    if (!importe || importe <= 0) { setPagoFeedback('Introduce un importe.'); pagoImporteInput?.focus(); return; }

    const prev = pagoSubmitBtn?.innerHTML || '';
    if (pagoSubmitBtn) { pagoSubmitBtn.disabled = true; pagoSubmitBtn.innerHTML = '<span class="material-symbols-rounded">&#xe627;</span> Guardando...'; }

    const editId = pagoEditId?.value;

    try {
      await fetchJson(
        editId ? `${BACKEND_BASE}/api/pagos/${editId}` : `${BACKEND_BASE}/api/pagos`,
        {
          method: editId ? 'PATCH' : 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            paciente_id: pacienteId,
            fecha: pagoFechaInput?.value || new Date().toISOString().slice(0, 10),
            importe,
            metodo_pago: getSelectedMetodo(),
            notas: pagoNotasInput?.value || null,
          }),
        }, 15000);
      closePagoModal();
      await loadPagos();
    } catch (err: any) {
      setPagoFeedback(`Error: ${err?.message || 'no se pudo guardar'}`);
    } finally {
      if (pagoSubmitBtn) { pagoSubmitBtn.disabled = false; pagoSubmitBtn.innerHTML = prev; }
    }
  });

  // ===================== END PAGOS =====================

  // ===================== FICHA PACIENTE =====================
  let fichaPatientId: string | null = null;
  let fichaData: any = null;
  const fichaTitulo = document.getElementById('fichaTitulo');
  const fichaDatosView = document.getElementById('fichaDatosView');
  const fichaDatosForm = document.getElementById('fichaDatosForm') as HTMLFormElement | null;
  const fichaEditToggle = document.getElementById('fichaEditToggle');
  const fichaCancelEdit = document.getElementById('fichaCancelEdit');
  const fichaCitasBody = document.getElementById('fichaCitasBody');
  const fichaPagosBody = document.getElementById('fichaPagosBody');
  const fichaPagosTotal = document.getElementById('fichaPagosTotal');
  const fichaNotasTimeline = document.getElementById('fichaNotasTimeline');
  const fichaNotaFormCard = document.getElementById('fichaNotaFormCard');
  const fichaNotaForm = document.getElementById('fichaNotaForm') as HTMLFormElement | null;
  const fichaNotaFormTitle = document.getElementById('fichaNotaFormTitle');
  const fichaAddNota = document.getElementById('fichaAddNota');
  const fichaNotaCancel = document.getElementById('fichaNotaCancel');

  // Tab switching
  document.querySelectorAll('.ficha-tab').forEach(tab => {
    tab.addEventListener('click', () => {
      document.querySelectorAll('.ficha-tab').forEach(t => t.classList.remove('active'));
      document.querySelectorAll('.ficha-panel').forEach(p => p.classList.remove('active'));
      tab.classList.add('active');
      const panel = document.querySelector(`[data-ficha-panel="${tab.getAttribute('data-ficha-tab')}"]`);
      panel?.classList.add('active');
    });
  });

  const openFichaPaciente = async (patientId: string) => {
    fichaPatientId = patientId;
    // Switch to ficha page
    document.querySelectorAll('.page-section').forEach(s => s.classList.remove('active'));
    document.querySelector('[data-page="ficha-paciente"]')?.classList.add('active');
    // Reset to first tab
    document.querySelectorAll('.ficha-tab').forEach(t => t.classList.remove('active'));
    document.querySelectorAll('.ficha-panel').forEach(p => p.classList.remove('active'));
    document.querySelector('[data-ficha-tab="datos"]')?.classList.add('active');
    document.querySelector('[data-ficha-panel="datos"]')?.classList.add('active');
    // Hide edit form, show view
    if (fichaDatosForm) fichaDatosForm.hidden = true;
    if (fichaDatosView) fichaDatosView.hidden = false;
    if (fichaNotaFormCard) fichaNotaFormCard.hidden = true;

    // Load data
    try {
      const payload = await fetchJson(`${BACKEND_BASE}/api/pacientes/${patientId}/ficha`);
      fichaData = payload;
      renderFichaDatos(payload.paciente);
      renderFichaCitas(payload.citas);
      renderFichaPagos(payload.pagos);
      renderFichaNotas(payload.notas);
      if (fichaTitulo) fichaTitulo.innerHTML = `<span class="material-symbols-rounded">&#xe7fd;</span> ${escapeHtml(payload.paciente.nombre_completo || 'Paciente')}`;
    } catch (err: any) {
      if (fichaDatosView) fichaDatosView.innerHTML = `<p class="empty-inline">Error al cargar ficha: ${escapeHtml(err?.message || '')}</p>`;
    }
  };

  const fichaField = (label: string, value: string, full = false) =>
    `<div class="ficha-dato${full ? ' ficha-dato-full' : ''}"><span class="ficha-dato-label">${escapeHtml(label)}</span><span class="ficha-dato-value">${escapeHtml(value || '')}</span></div>`;

  const renderFichaDatos = (p: any) => {
    if (!fichaDatosView) return;
    fichaDatosView.innerHTML = [
      fichaField('Nombre', p.nombre),
      fichaField('Apellidos', p.apellidos),
      fichaField('Email', p.email),
      fichaField('Teléfono', p.telefono),
      fichaField('DNI/NIF', p.dni),
      fichaField('Fecha nac.', p.fecha_nacimiento ? fmtDate(p.fecha_nacimiento) : ''),
      fichaField('Dirección', p.direccion),
      fichaField('Profesión', p.profesion),
      fichaField('Médico derivador', p.medico_derivador),
      fichaField('Aseguradora', p.aseguradora),
      fichaField('Alergias', p.alergias, true),
      fichaField('Antecedentes', p.antecedentes, true),
      fichaField('Observaciones', p.observaciones, true),
    ].join('');
  };

  // Edit toggle
  fichaEditToggle?.addEventListener('click', () => {
    if (!fichaData?.paciente || !fichaDatosForm) return;
    const p = fichaData.paciente;
    if (fichaDatosView) fichaDatosView.hidden = true;
    fichaDatosForm.hidden = false;
    const fill = (name: string, val: string) => {
      const el = fichaDatosForm.querySelector(`[name="${name}"]`) as HTMLInputElement | HTMLTextAreaElement | null;
      if (el) el.value = val || '';
    };
    fill('nombre', p.nombre); fill('apellidos', p.apellidos); fill('email', p.email);
    fill('telefono', p.telefono); fill('dni', p.dni); fill('fecha_nacimiento', p.fecha_nacimiento);
    fill('direccion', p.direccion); fill('profesion', p.profesion);
    fill('medico_derivador', p.medico_derivador); fill('aseguradora', p.aseguradora);
    fill('alergias', p.alergias); fill('antecedentes', p.antecedentes); fill('observaciones', p.observaciones);
  });

  fichaCancelEdit?.addEventListener('click', () => {
    if (fichaDatosForm) fichaDatosForm.hidden = true;
    if (fichaDatosView) fichaDatosView.hidden = false;
  });

  fichaDatosForm?.addEventListener('submit', async (e: Event) => {
    e.preventDefault();
    if (!fichaPatientId) return;
    const fd = new FormData(fichaDatosForm);
    const body: any = {};
    for (const [k, v] of fd.entries()) body[k] = (v as string) || null;
    try {
      await fetchJson(`${BACKEND_BASE}/api/pacientes/${fichaPatientId}`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
      });
      // Reload ficha
      await openFichaPaciente(fichaPatientId);
    } catch (err: any) {
      alert(`Error al guardar: ${err?.message || 'desconocido'}`);
    }
  });

  // Render citas
  const renderFichaCitas = (citas: any[]) => {
    if (!fichaCitasBody) return;
    if (!citas.length) {
      fichaCitasBody.innerHTML = '<tr class="empty-row"><td colspan="3"><div class="empty-state"><span class="material-symbols-rounded">&#xe616;</span><p>Sin citas registradas</p></div></td></tr>';
      return;
    }
    fichaCitasBody.innerHTML = citas.map((c: any) => {
      const estado = c.estado || 'pendiente';
      return `<tr><td>${c.fecha_hora ? fmtDate(c.fecha_hora) : '—'}</td><td><span class="status-chip ${estado}">${estado}</span></td><td>${escapeHtml(c.motivo || '—')}</td></tr>`;
    }).join('');
  };

  // Render pagos
  const renderFichaPagos = (pagos: any[]) => {
    if (!fichaPagosBody) return;
    if (!pagos.length) {
      fichaPagosBody.innerHTML = '<tr class="empty-row"><td colspan="4"><div class="empty-state"><span class="material-symbols-rounded">&#xef63;</span><p>Sin pagos registrados</p></div></td></tr>';
      if (fichaPagosTotal) fichaPagosTotal.textContent = '';
      return;
    }
    fichaPagosBody.innerHTML = pagos.map((p: any) => {
      const metodoClass = p.metodo_pago === 'tarjeta' ? 'pagos-stat-card' : 'pagos-stat-cash';
      return `<tr><td>${fmtDate(p.fecha)}</td><td><strong>${Number(p.importe).toFixed(2)} €</strong></td><td><span class="${metodoClass}" style="font-weight:600">${p.metodo_pago}</span></td><td>${escapeHtml(p.concepto || '—')}</td></tr>`;
    }).join('');
    const total = pagos.reduce((s: number, p: any) => s + Number(p.importe || 0), 0);
    if (fichaPagosTotal) fichaPagosTotal.textContent = `Total: ${total.toFixed(2)} €`;
  };

  // Render notas clínicas (timeline)
  const evaClass = (v: number) => v <= 3 ? 'eva-low' : v <= 6 ? 'eva-mid' : 'eva-high';
  const zonaLabels: Record<string, string> = {
    cervical: 'Cervical', espalda: 'Espalda', hombro_brazo: 'Hombro/Brazo',
    codo_mano: 'Codo/Mano', cadera: 'Cadera', rodilla: 'Rodilla',
    tobillo_pie: 'Tobillo/Pie', abdomen_core: 'Abdomen/Core',
    suelo_pelvico: 'Suelo pélvico', general: 'General',
  };

  const renderFichaNotas = (notas: any[]) => {
    if (!fichaNotasTimeline) return;
    if (!notas.length) {
      fichaNotasTimeline.innerHTML = '<p class="empty-inline">Sin notas clínicas registradas</p>';
      return;
    }
    fichaNotasTimeline.innerHTML = notas.map((n: any) => {
      const zonaLabel = zonaLabels[n.zona_corporal] || n.zona_corporal || '';
      const evaHtml = n.dolor_eva != null ? `<span class="ficha-nota-eva ${evaClass(n.dolor_eva)}">EVA ${n.dolor_eva}/10</span>` : '';
      const zonaHtml = zonaLabel ? `<span class="ficha-nota-zona">${escapeHtml(zonaLabel)}</span>` : '';
      const pruebasHtml = n.pruebas_realizadas ? `<div class="ficha-nota-pruebas">Pruebas: ${escapeHtml(n.pruebas_realizadas)}</div>` : '';
      return `<div class="ficha-nota-card">
        <div class="ficha-nota-actions">
          <button title="Editar" data-action="edit-nota" data-nota-id="${n.id}"><span class="material-symbols-rounded" style="font-size:1.1rem">edit</span></button>
          <button title="Eliminar" data-action="delete-nota" data-nota-id="${n.id}"><span class="material-symbols-rounded" style="font-size:1.1rem">delete</span></button>
        </div>
        <div class="ficha-nota-header">
          <span class="ficha-nota-date">${fmtDate(n.fecha)}</span>
          ${zonaHtml}${evaHtml}
        </div>
        <div class="ficha-nota-text">${escapeHtml(n.nota)}</div>
        ${pruebasHtml}
      </div>`;
    }).join('');
  };

  // Nota actions (add / edit / delete)
  fichaAddNota?.addEventListener('click', () => {
    if (!fichaNotaFormCard || !fichaNotaForm) return;
    fichaNotaForm.reset();
    const notaIdInput = fichaNotaForm.querySelector('[name="nota_id"]') as HTMLInputElement;
    if (notaIdInput) notaIdInput.value = '';
    const fechaInput = fichaNotaForm.querySelector('[name="fecha"]') as HTMLInputElement;
    if (fechaInput) fechaInput.value = new Date().toISOString().slice(0, 10);
    if (fichaNotaFormTitle) fichaNotaFormTitle.textContent = 'Nueva nota clínica';
    fichaNotaFormCard.hidden = false;
    fichaNotaFormCard.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  });

  fichaNotaCancel?.addEventListener('click', () => {
    if (fichaNotaFormCard) fichaNotaFormCard.hidden = true;
  });

  fichaNotaForm?.addEventListener('submit', async (e: Event) => {
    e.preventDefault();
    if (!fichaPatientId) return;
    const fd = new FormData(fichaNotaForm);
    const notaId = fd.get('nota_id') as string;
    const body: any = {
      paciente_id: fichaPatientId,
      fecha: fd.get('fecha') || new Date().toISOString().slice(0, 10),
      zona_corporal: fd.get('zona_corporal') || null,
      dolor_eva: fd.get('dolor_eva') ? Number(fd.get('dolor_eva')) : null,
      nota: fd.get('nota') as string,
      pruebas_realizadas: fd.get('pruebas_realizadas') || null,
    };
    try {
      if (notaId) {
        await fetchJson(`${BACKEND_BASE}/api/notas-clinicas/${notaId}`, {
          method: 'PATCH', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body),
        });
      } else {
        await fetchJson(`${BACKEND_BASE}/api/notas-clinicas`, {
          method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body),
        });
      }
      if (fichaNotaFormCard) fichaNotaFormCard.hidden = true;
      // Reload notas
      const notasPayload = await fetchJson(`${BACKEND_BASE}/api/notas-clinicas?paciente_id=${fichaPatientId}`);
      if (fichaData) fichaData.notas = notasPayload.data || [];
      renderFichaNotas(fichaData?.notas || []);
    } catch (err: any) {
      alert(`Error: ${err?.message || 'no se pudo guardar la nota'}`);
    }
  });

  // Delegate nota edit/delete clicks
  fichaNotasTimeline?.addEventListener('click', async (e: Event) => {
    const target = e.target as HTMLElement;
    const btn = target.closest('button[data-action]') as HTMLButtonElement | null;
    if (!btn) return;
    const action = btn.getAttribute('data-action');
    const notaId = btn.getAttribute('data-nota-id');
    if (!notaId || !fichaPatientId) return;

    if (action === 'delete-nota') {
      if (!confirm('¿Eliminar esta nota clínica?')) return;
      try {
        await fetchJson(`${BACKEND_BASE}/api/notas-clinicas/${notaId}`, { method: 'DELETE' });
        const notasPayload = await fetchJson(`${BACKEND_BASE}/api/notas-clinicas?paciente_id=${fichaPatientId}`);
        if (fichaData) fichaData.notas = notasPayload.data || [];
        renderFichaNotas(fichaData?.notas || []);
      } catch (err: any) {
        alert(`Error: ${err?.message}`);
      }
    }

    if (action === 'edit-nota') {
      const nota = fichaData?.notas?.find((n: any) => n.id === notaId);
      if (!nota || !fichaNotaForm || !fichaNotaFormCard) return;
      fichaNotaForm.reset();
      const fill = (name: string, val: string) => {
        const el = fichaNotaForm.querySelector(`[name="${name}"]`) as HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement | null;
        if (el) el.value = val || '';
      };
      fill('nota_id', nota.id);
      fill('fecha', nota.fecha);
      fill('zona_corporal', nota.zona_corporal);
      fill('dolor_eva', nota.dolor_eva != null ? String(nota.dolor_eva) : '');
      fill('nota', nota.nota);
      fill('pruebas_realizadas', nota.pruebas_realizadas);
      if (fichaNotaFormTitle) fichaNotaFormTitle.textContent = 'Editar nota clínica';
      fichaNotaFormCard.hidden = false;
      fichaNotaFormCard.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }
  });

  // Back button
  document.getElementById('fichaBackBtn')?.addEventListener('click', () => {
    navigateTo('pacientes');
  });

  // Intercept view-patient action to open ficha
  pacientesBody?.addEventListener('click', (event: Event) => {
    const target = event.target as HTMLElement | null;
    const btn = target?.closest('button[data-action="view-patient"]') as HTMLButtonElement | null;
    if (!btn) return;
    const patientId = btn.getAttribute('data-patient-id');
    if (patientId) {
      event.stopPropagation();
      openFichaPaciente(patientId);
    }
  }, true); // capture phase to intercept before existing handler

  // ===================== FACTURACION =====================
  const facturasBody = document.getElementById('facturasBody') as HTMLElement | null;
  const facturasAnioFilter = document.getElementById('facturasAnioFilter') as HTMLSelectElement | null;
  const facturaModal = document.getElementById('facturaModal');
  const facturaForm = document.getElementById('facturaForm') as HTMLFormElement | null;
  const facturaPacienteSelect = document.getElementById('facturaPacienteSelect') as HTMLSelectElement | null;
  const facturaIvaPct = document.getElementById('facturaIvaPct') as HTMLSelectElement | null;
  const facturaNotas = document.getElementById('facturaNotas') as HTMLTextAreaElement | null;
  const facturaPreview = document.getElementById('facturaPreview');
  const facturaFeedback = document.getElementById('facturaFeedback') as HTMLElement | null;
  const facturaSubmitBtn = document.getElementById('facturaSubmitBtn') as HTMLButtonElement | null;

  // Populate year filter
  (() => {
    if (!facturasAnioFilter) return;
    const y = new Date().getFullYear();
    for (let i = y; i >= y - 3; i--) {
      const opt = document.createElement('option');
      opt.value = String(i); opt.textContent = String(i);
      facturasAnioFilter.appendChild(opt);
    }
  })();

  const setFacturaFeedback = (text?: string) => {
    if (!facturaFeedback) return;
    if (!text) { facturaFeedback.hidden = true; return; }
    facturaFeedback.hidden = false;
    facturaFeedback.textContent = text;
  };

  const loadFacturas = async () => {
    if (!facturasBody) return;
    setTableState(facturasBody, 8, 'sync', 'Cargando facturas...', true);
    try {
      const anio = facturasAnioFilter?.value || new Date().getFullYear();
      const payload = await fetchJson(`${BACKEND_BASE}/api/facturas?anio=${anio}`);
      const facturas = payload.data || [];
      if (!facturas.length) {
        setTableState(facturasBody, 8, 'receipt_long', 'Sin facturas emitidas');
        return;
      }
      facturasBody.innerHTML = facturas.map((f: any) => {
        const pName = f.crm_pacientes ? `${f.crm_pacientes.nombre || ''} ${f.crm_pacientes.apellidos || ''}`.trim() : '—';
        const estadoClass = f.estado === 'anulada' ? 'cancelada' : f.estado === 'pagada' ? 'confirmada' : 'pendiente';
        return `<tr>
          <td><strong>${escapeHtml(f.numero)}</strong></td>
          <td>${fmtDate(f.fecha)}</td>
          <td class="td-patient">${escapeHtml(pName)}</td>
          <td>${Number(f.importe_bruto).toFixed(2)} €</td>
          <td>${Number(f.importe_iva).toFixed(2)} €</td>
          <td><strong>${Number(f.importe_total).toFixed(2)} €</strong></td>
          <td><span class="status-chip ${estadoClass}">${f.estado}</span></td>
          <td><a href="${BACKEND_BASE}/api/facturas/${f.id}/pdf" target="_blank" class="btn-sm btn-outline">PDF</a></td>
        </tr>`;
      }).join('');
    } catch {
      setTableState(facturasBody, 8, 'cloud_off', 'Error al cargar facturas');
    }
  };
  pageLoaders['facturas'] = loadFacturas;
  facturasAnioFilter?.addEventListener('change', loadFacturas);
  document.getElementById('refreshFacturas')?.addEventListener('click', loadFacturas);

  // Modal
  const openFacturaModal = async () => {
    facturaForm?.reset();
    setFacturaFeedback();
    if (facturaPreview) facturaPreview.hidden = true;
    // Populate patient select (CRM only)
    if (facturaPacienteSelect) {
      if (!patientCatalog.length) await fetchPatientCatalog();
      const crmPts = patientCatalog.filter((p: any) => p._source !== 'legacy');
      facturaPacienteSelect.innerHTML = '<option value="">-- Selecciona paciente --</option>' +
        crmPts.map((p: any) => `<option value="${p.id}">${escapeHtml(p.nombre_completo || '—')}</option>`).join('');
    }
    facturaModal?.classList.add('open');
    facturaModal?.setAttribute('aria-hidden', 'false');
  };
  const closeFacturaModal = () => {
    facturaModal?.classList.remove('open');
    facturaModal?.setAttribute('aria-hidden', 'true');
  };

  document.getElementById('nuevaFacturaBtn')?.addEventListener('click', openFacturaModal);
  document.getElementById('facturaModalClose')?.addEventListener('click', closeFacturaModal);
  document.getElementById('facturaModalDismiss')?.addEventListener('click', closeFacturaModal);

  // Preview payments when patient selected
  facturaPacienteSelect?.addEventListener('change', async () => {
    if (!facturaPreview) return;
    const pacienteId = facturaPacienteSelect.value;
    if (!pacienteId) { facturaPreview.hidden = true; return; }
    try {
      const payload = await fetchJson(`${BACKEND_BASE}/api/pagos?paciente_id=${pacienteId}`);
      const pagos = payload.data || [];
      if (!pagos.length) {
        facturaPreview.innerHTML = '<p class="empty-inline">Este paciente no tiene pagos para facturar</p>';
        facturaPreview.hidden = false;
        return;
      }
      const total = pagos.reduce((s: number, p: any) => s + Number(p.importe || 0), 0);
      facturaPreview.innerHTML = `
        <p style="font-weight:600;margin-bottom:0.5rem">${pagos.length} pago(s) — Base: ${total.toFixed(2)} €</p>
        <div class="table-wrap"><table><thead><tr><th>Fecha</th><th>Concepto</th><th>Método</th><th>Importe</th></tr></thead><tbody>
        ${pagos.map((p: any) => `<tr><td>${fmtDate(p.fecha)}</td><td>${escapeHtml(p.concepto || 'Sesión')}</td><td>${p.metodo_pago}</td><td>${Number(p.importe).toFixed(2)} €</td></tr>`).join('')}
        </tbody></table></div>`;
      facturaPreview.hidden = false;
    } catch {
      facturaPreview.innerHTML = '<p class="empty-inline">Error al cargar pagos</p>';
      facturaPreview.hidden = false;
    }
  });

  // Submit
  facturaForm?.addEventListener('submit', async (e: Event) => {
    e.preventDefault();
    const pacienteId = facturaPacienteSelect?.value;
    if (!pacienteId) { setFacturaFeedback('Selecciona un paciente'); return; }
    const prev = facturaSubmitBtn?.innerHTML || '';
    if (facturaSubmitBtn) { facturaSubmitBtn.disabled = true; facturaSubmitBtn.innerHTML = '<span class="material-symbols-rounded">&#xe627;</span> Generando...'; }
    try {
      const payload = await fetchJson(`${BACKEND_BASE}/api/facturas`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          paciente_id: pacienteId,
          iva_pct: Number(facturaIvaPct?.value || 21),
          notas: facturaNotas?.value || null,
        }),
      });
      closeFacturaModal();
      await loadFacturas();
      // Open PDF in new tab
      if (payload.data?.id) {
        window.open(`${BACKEND_BASE}/api/facturas/${payload.data.id}/pdf`, '_blank');
      }
    } catch (err: any) {
      setFacturaFeedback(`Error: ${err?.message || 'no se pudo generar'}`);
    } finally {
      if (facturaSubmitBtn) { facturaSubmitBtn.disabled = false; facturaSubmitBtn.innerHTML = prev; }
    }
  });

  // ===================== BONOS =====================
  const bonosBody = document.getElementById('bonosBody') as HTMLElement | null;
  const bonosEstadoFilter = document.getElementById('bonosEstadoFilter') as HTMLSelectElement | null;
  const bonoModal = document.getElementById('bonoModal');
  const bonoForm = document.getElementById('bonoForm') as HTMLFormElement | null;
  const bonoPacienteSelect = document.getElementById('bonoPacienteSelect') as HTMLSelectElement | null;
  const bonoFeedback = document.getElementById('bonoFeedback') as HTMLElement | null;
  const bonoSubmitBtn = document.getElementById('bonoSubmitBtn') as HTMLButtonElement | null;
  const bonoEditId = document.getElementById('bonoEditId') as HTMLInputElement | null;
  const bonoModalTitle = document.getElementById('bonoModalTitle');

  const setBonoFeedback = (t?: string) => {
    if (!bonoFeedback) return;
    if (!t) { bonoFeedback.hidden = true; return; }
    bonoFeedback.hidden = false; bonoFeedback.textContent = t;
  };

  const loadBonos = async () => {
    if (!bonosBody) return;
    setTableState(bonosBody, 8, 'sync', 'Cargando bonos...', true);
    try {
      const estado = bonosEstadoFilter?.value || '';
      const url = `${BACKEND_BASE}/api/bonos${estado ? `?estado=${estado}` : ''}`;
      const payload = await fetchJson(url);
      const bonos = payload.data || [];
      if (!bonos.length) { setTableState(bonosBody, 8, 'confirmation_number', 'Sin bonos'); return; }
      bonosBody.innerHTML = bonos.map((b: any) => {
        const pName = b.crm_pacientes ? `${b.crm_pacientes.nombre || ''} ${b.crm_pacientes.apellidos || ''}`.trim() : '—';
        const restantes = b.sesiones_total - b.sesiones_usadas;
        const pct = Math.round((b.sesiones_usadas / b.sesiones_total) * 100);
        const estadoClass = b.estado; // activo/agotado/caducado/anulado — CSS defines .status-chip.activo etc.
        return `<tr data-bono="${escapeAttr(JSON.stringify(b))}">
          <td class="td-patient">${escapeHtml(pName)}</td>
          <td>${escapeHtml(b.nombre)}</td>
          <td>
            <div class="bono-progress">
              <span>${b.sesiones_usadas}/${b.sesiones_total} <small>(${restantes} restantes)</small></span>
              <div class="bono-bar"><div class="bono-bar-fill" style="width:${pct}%"></div></div>
            </div>
          </td>
          <td>${Number(b.precio).toFixed(2)} €</td>
          <td>${b.fecha_inicio ? fmtDate(b.fecha_inicio) : '—'}</td>
          <td>${b.fecha_caducidad ? fmtDate(b.fecha_caducidad) : '—'}</td>
          <td><span class="status-chip ${estadoClass}">${b.estado}</span></td>
          <td>
            <div class="table-actions">
              ${b.estado === 'activo' ? `<button class="btn-sm btn-outline" data-action="usar-bono" data-bono-id="${b.id}">Usar sesión</button>` : ''}
              <button class="btn-sm btn-outline" data-action="edit-bono" data-bono-id="${b.id}">Editar</button>
              <button class="btn-sm btn-outline" style="color:#ef4444" data-action="delete-bono" data-bono-id="${b.id}">✕</button>
            </div>
          </td>
        </tr>`;
      }).join('');
    } catch { setTableState(bonosBody, 8, 'cloud_off', 'Error al cargar bonos'); }
  };
  pageLoaders['bonos'] = loadBonos;
  bonosEstadoFilter?.addEventListener('change', loadBonos);
  document.getElementById('refreshBonos')?.addEventListener('click', loadBonos);

  const openBonoModal = async (editData?: any) => {
    bonoForm?.reset();
    setBonoFeedback();
    if (bonoEditId) bonoEditId.value = '';
    if (!patientCatalog.length) await fetchPatientCatalog();
    const crmPts = patientCatalog.filter((p: any) => p._source !== 'legacy');
    if (bonoPacienteSelect) {
      bonoPacienteSelect.innerHTML = '<option value="">-- Selecciona paciente --</option>' +
        crmPts.map((p: any) => `<option value="${p.id}">${escapeHtml(p.nombre_completo || '—')}</option>`).join('');
    }
    const fechaInicio = document.getElementById('bonoFechaInicio') as HTMLInputElement;
    if (fechaInicio && !editData) fechaInicio.value = new Date().toISOString().slice(0, 10);
    if (editData) {
      if (bonoModalTitle) bonoModalTitle.textContent = 'Editar bono';
      if (bonoEditId) bonoEditId.value = editData.id;
      if (bonoPacienteSelect) bonoPacienteSelect.value = editData.paciente_id || '';
      const set = (id: string, v: string) => { const el = document.getElementById(id) as HTMLInputElement; if (el) el.value = v || ''; };
      set('bonoNombre', editData.nombre); set('bonoSesiones', editData.sesiones_total);
      set('bonoPrecio', editData.precio); set('bonoFechaInicio', editData.fecha_inicio);
      set('bonoFechaCaducidad', editData.fecha_caducidad); set('bonoNotas', editData.notas);
    } else {
      if (bonoModalTitle) bonoModalTitle.textContent = 'Nuevo bono';
    }
    bonoModal?.classList.add('open'); bonoModal?.setAttribute('aria-hidden', 'false');
  };
  const closeBonoModal = () => { bonoModal?.classList.remove('open'); bonoModal?.setAttribute('aria-hidden', 'true'); };

  document.getElementById('nuevoBonoBtn')?.addEventListener('click', () => openBonoModal());
  document.getElementById('bonoModalClose')?.addEventListener('click', closeBonoModal);
  document.getElementById('bonoModalDismiss')?.addEventListener('click', closeBonoModal);

  bonoForm?.addEventListener('submit', async (e: Event) => {
    e.preventDefault();
    const id = bonoEditId?.value;
    const body: any = {
      paciente_id: bonoPacienteSelect?.value,
      nombre: (document.getElementById('bonoNombre') as HTMLInputElement)?.value,
      sesiones_total: Number((document.getElementById('bonoSesiones') as HTMLInputElement)?.value),
      precio: Number((document.getElementById('bonoPrecio') as HTMLInputElement)?.value),
      fecha_inicio: (document.getElementById('bonoFechaInicio') as HTMLInputElement)?.value || null,
      fecha_caducidad: (document.getElementById('bonoFechaCaducidad') as HTMLInputElement)?.value || null,
      notas: (document.getElementById('bonoNotas') as HTMLTextAreaElement)?.value || null,
    };
    if (!body.paciente_id) { setBonoFeedback('Selecciona un paciente'); return; }
    const prev = bonoSubmitBtn?.innerHTML || '';
    if (bonoSubmitBtn) { bonoSubmitBtn.disabled = true; bonoSubmitBtn.innerHTML = '<span class="material-symbols-rounded">&#xe627;</span> Guardando...'; }
    try {
      if (id) {
        await fetchJson(`${BACKEND_BASE}/api/bonos/${id}`, { method: 'PATCH', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
      } else {
        await fetchJson(`${BACKEND_BASE}/api/bonos`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
      }
      closeBonoModal(); await loadBonos();
    } catch (err: any) { setBonoFeedback(`Error: ${err?.message || 'no se pudo guardar'}`); }
    finally { if (bonoSubmitBtn) { bonoSubmitBtn.disabled = false; bonoSubmitBtn.innerHTML = prev; } }
  });

  // Table actions
  bonosBody?.addEventListener('click', async (e: Event) => {
    const btn = (e.target as HTMLElement).closest('button[data-action]') as HTMLButtonElement | null;
    if (!btn) return;
    const action = btn.getAttribute('data-action');
    const bonoId = btn.getAttribute('data-bono-id');
    if (!bonoId) return;

    if (action === 'usar-bono') {
      try {
        await fetchJson(`${BACKEND_BASE}/api/bonos/${bonoId}/usar`, { method: 'POST' });
        await loadBonos();
      } catch (err: any) { alert(`Error: ${err?.message}`); }
    }
    if (action === 'edit-bono') {
      const row = btn.closest('tr') as HTMLTableRowElement | null;
      try {
        const bono = row?.dataset.bono ? JSON.parse(row.dataset.bono) : null;
        if (bono) openBonoModal(bono);
      } catch {}
    }
    if (action === 'delete-bono') {
      if (!confirm('¿Eliminar este bono?')) return;
      try { await fetchJson(`${BACKEND_BASE}/api/bonos/${bonoId}`, { method: 'DELETE' }); await loadBonos(); }
      catch (err: any) { alert(`Error: ${err?.message}`); }
    }
  });

  // ===================== FIRMA DIGITAL =====================
  let firmaDocId: string | null = null;
  let firmaDrawing = false;
  let firmaHasSig = false;
  const firmaModal = document.getElementById('firmaModal');
  const firmaCanvas = document.getElementById('firmaCanvas') as HTMLCanvasElement | null;
  const firmaStatus = document.getElementById('firmaStatus');
  const firmaFeedback = document.getElementById('firmaFeedback') as HTMLElement | null;
  const firmaModalTitle = document.getElementById('firmaModalTitle');
  const firmaDocContenido = document.getElementById('firmaDocContenido');

  const setFirmaFeedback = (t?: string) => {
    if (!firmaFeedback) return;
    if (!t) { firmaFeedback.hidden = true; return; }
    firmaFeedback.hidden = false;
    firmaFeedback.textContent = t;
  };

  // Signature pad
  const initFirmaPad = () => {
    if (!firmaCanvas) return;
    const ctx = firmaCanvas.getContext('2d');
    if (!ctx) return;
    ctx.clearRect(0, 0, firmaCanvas.width, firmaCanvas.height);
    firmaHasSig = false;
    if (firmaStatus) firmaStatus.textContent = 'Sin firma';
    ctx.strokeStyle = '#1e293b';
    ctx.lineWidth = 2;
    ctx.lineCap = 'round';
    ctx.lineJoin = 'round';

    const getPos = (e: MouseEvent | TouchEvent) => {
      const rect = firmaCanvas.getBoundingClientRect();
      const scaleX = firmaCanvas.width / rect.width;
      const scaleY = firmaCanvas.height / rect.height;
      const src = e instanceof TouchEvent ? e.touches[0] : e;
      return { x: (src.clientX - rect.left) * scaleX, y: (src.clientY - rect.top) * scaleY };
    };

    firmaCanvas.onmousedown = (e) => { firmaDrawing = true; const p = getPos(e); ctx.beginPath(); ctx.moveTo(p.x, p.y); };
    firmaCanvas.onmousemove = (e) => { if (!firmaDrawing) return; const p = getPos(e); ctx.lineTo(p.x, p.y); ctx.stroke(); firmaHasSig = true; if (firmaStatus) firmaStatus.textContent = '✓ Firma capturada'; };
    firmaCanvas.onmouseup = () => { firmaDrawing = false; };
    firmaCanvas.onmouseleave = () => { firmaDrawing = false; };
    firmaCanvas.ontouchstart = (e) => { e.preventDefault(); firmaDrawing = true; const p = getPos(e); ctx.beginPath(); ctx.moveTo(p.x, p.y); };
    firmaCanvas.ontouchmove = (e) => { e.preventDefault(); if (!firmaDrawing) return; const p = getPos(e); ctx.lineTo(p.x, p.y); ctx.stroke(); firmaHasSig = true; if (firmaStatus) firmaStatus.textContent = '✓ Firma capturada'; };
    firmaCanvas.ontouchend = () => { firmaDrawing = false; };
  };

  document.getElementById('firmaClearBtn')?.addEventListener('click', () => {
    if (!firmaCanvas) return;
    const ctx = firmaCanvas.getContext('2d');
    ctx?.clearRect(0, 0, firmaCanvas.width, firmaCanvas.height);
    firmaHasSig = false;
    if (firmaStatus) firmaStatus.textContent = 'Sin firma';
  });

  const openFirmaModal = async (tipo: string) => {
    if (!fichaPatientId) return;
    setFirmaFeedback();
    firmaDocId = null;
    try {
      // Create document
      const payload = await fetchJson(`${BACKEND_BASE}/api/documentos`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ paciente_id: fichaPatientId, tipo }),
      });
      firmaDocId = payload.data?.id || null;
      if (firmaModalTitle) firmaModalTitle.textContent = payload.data?.titulo || 'Documento';
      if (firmaDocContenido) firmaDocContenido.textContent = payload.contenido || '';
      firmaModal?.classList.add('open');
      firmaModal?.setAttribute('aria-hidden', 'false');
      initFirmaPad();
    } catch (err: any) {
      alert(`Error: ${err?.message || 'no se pudo crear el documento'}`);
    }
  };

  const closeFirmaModal = () => {
    firmaModal?.classList.remove('open');
    firmaModal?.setAttribute('aria-hidden', 'true');
  };

  document.getElementById('firmaModalClose')?.addEventListener('click', closeFirmaModal);
  document.getElementById('firmaModalDismiss')?.addEventListener('click', closeFirmaModal);

  // Buttons to open firma modal from ficha
  ['btnDocConsentimiento', 'btnDocLopd', 'btnDocRevocacion'].forEach(id => {
    const btn = document.getElementById(id);
    if (!btn) return;
    btn.addEventListener('click', () => {
      const tipo = btn.getAttribute('data-doc-tipo') || 'consentimiento_informado';
      openFirmaModal(tipo);
    });
  });

  // Save signature
  document.getElementById('firmaGuardarBtn')?.addEventListener('click', async () => {
    if (!firmaDocId) return;
    if (!firmaHasSig) { setFirmaFeedback('Por favor, dibuja tu firma antes de continuar.'); return; }
    if (!firmaCanvas) return;
    const firmaB64 = firmaCanvas.toDataURL('image/png');
    const btn = document.getElementById('firmaGuardarBtn') as HTMLButtonElement;
    const prev = btn?.innerHTML || '';
    if (btn) { btn.disabled = true; btn.innerHTML = '<span class="material-symbols-rounded">&#xe627;</span> Guardando...'; }
    try {
      await fetchJson(`${BACKEND_BASE}/api/documentos/${firmaDocId}/firmar`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ firma_base64: firmaB64 }),
      });
      closeFirmaModal();
      // Open PDF
      window.open(`${BACKEND_BASE}/api/documentos/${firmaDocId}/pdf`, '_blank');
      // Reload docs list
      if (fichaPatientId) {
        const docsPayload = await fetchJson(`${BACKEND_BASE}/api/documentos?paciente_id=${fichaPatientId}`);
        renderFichaDocumentos(docsPayload.data || []);
      }
    } catch (err: any) {
      setFirmaFeedback(`Error: ${err?.message || 'no se pudo guardar'}`);
    } finally {
      if (btn) { btn.disabled = false; btn.innerHTML = prev; }
    }
  });

  // Render documents list
  const renderFichaDocumentos = (docs: any[]) => {
    const el = document.getElementById('fichaDocsList');
    if (!el) return;
    if (!docs.length) { el.innerHTML = '<p class="empty-inline">Sin documentos registrados</p>'; return; }
    const tipoLabel: Record<string, string> = {
      consentimiento_informado: 'Consentimiento Informado',
      lopd: 'LOPD / RGPD',
      revocacion: 'Revocación',
      otro: 'Documento',
    };
    el.innerHTML = docs.map((d: any) => {
      const estadoClass = d.estado === 'firmado' ? 'confirmada' : 'pendiente';
      const fechaFirma = d.fecha_firma ? ` · Firmado ${fmtDate(d.fecha_firma)}` : '';
      return `<div class="ficha-doc-card">
        <span class="material-symbols-rounded ficha-doc-icon">description</span>
        <div class="ficha-doc-info">
          <div class="ficha-doc-title">${escapeHtml(tipoLabel[d.tipo] || d.tipo)}</div>
          <div class="ficha-doc-meta"><span class="status-chip ${estadoClass}">${d.estado}</span>${escapeHtml(fechaFirma)}</div>
        </div>
        <div class="ficha-doc-actions">
          <a href="${BACKEND_BASE}/api/documentos/${d.id}/pdf" target="_blank" class="btn-sm btn-outline">PDF</a>
          <button class="btn-sm btn-outline" data-action="delete-doc" data-doc-id="${d.id}" style="color:#ef4444">Eliminar</button>
        </div>
      </div>`;
    }).join('');

    // Delete docs
    el.querySelectorAll('button[data-action="delete-doc"]').forEach(btn => {
      btn.addEventListener('click', async () => {
        if (!confirm('¿Eliminar este documento?')) return;
        const docId = (btn as HTMLElement).getAttribute('data-doc-id');
        if (!docId) return;
        try {
          await fetchJson(`${BACKEND_BASE}/api/documentos/${docId}`, { method: 'DELETE' });
          if (fichaPatientId) {
            const pl = await fetchJson(`${BACKEND_BASE}/api/documentos?paciente_id=${fichaPatientId}`);
            renderFichaDocumentos(pl.data || []);
          }
        } catch (err: any) { alert(`Error: ${err?.message}`); }
      });
    });
  };

  // Load docs when ficha opens — patch openFichaPaciente to also load docs
  const _origOpenFicha = openFichaPaciente;
  // Override: we extend after docs tab loads
  document.querySelector('[data-ficha-tab="documentos"]')?.addEventListener('click', async () => {
    if (!fichaPatientId) return;
    const pl = await fetchJson(`${BACKEND_BASE}/api/documentos?paciente_id=${fichaPatientId}`);
    renderFichaDocumentos(pl.data || []);
  });

  // ===================== GESTORIA =====================
  const gestoriaBody = document.getElementById('gestoriaBody') as HTMLElement | null;
  const gestoriaHead = document.getElementById('gestoriaHead') as HTMLElement | null;
  const gestoriaAnioFilter = document.getElementById('gestoriaAnioFilter') as HTMLSelectElement | null;

  (() => {
    if (!gestoriaAnioFilter) return;
    const y = new Date().getFullYear();
    for (let i = y; i >= y - 3; i--) {
      const o = document.createElement('option');
      o.value = String(i); o.textContent = String(i);
      gestoriaAnioFilter.appendChild(o);
    }
  })();

  const MESES_CORTOS = ['Ene','Feb','Mar','Abr','May','Jun','Jul','Ago','Sep','Oct','Nov','Dic'];

  const loadGestoria = async () => {
    if (!gestoriaBody || !gestoriaHead) return;
    setTableState(gestoriaBody, 16, 'sync', 'Cargando datos de gestor\u00eda...', true);

    const anio = gestoriaAnioFilter?.value || String(new Date().getFullYear());

    try {
      const payload = await fetchJson(`${BACKEND_BASE}/api/pagos/gestoria?anio=${anio}`, undefined, 15000);
      const { pacientes, totales_mes, gran_total } = payload;

      // Grand totals
      document.getElementById('gestoriaGranTotal')!.textContent = fmtMoney(gran_total.total);
      document.getElementById('gestoriaGranSesiones')!.textContent = String(gran_total.sesiones);
      document.getElementById('gestoriaGranEfectivo')!.textContent = fmtMoney(gran_total.efectivo);
      document.getElementById('gestoriaGranTarjeta')!.textContent = fmtMoney(gran_total.tarjeta);

      // Header
      gestoriaHead.innerHTML = `<tr>
        <th class="gestoria-col-patient">Paciente</th>
        ${MESES_CORTOS.map(m => `<th class="text-right gestoria-col-mes">${m}</th>`).join('')}
        <th class="text-right gestoria-col-total">Total</th>
        <th class="text-right gestoria-col-efe">Efectivo</th>
        <th class="text-right gestoria-col-tar">Tarjeta</th>
      </tr>`;

      if (!pacientes.length) {
        setTableState(gestoriaBody, 16, 'credit_card_off', 'Sin pagos registrados en ' + anio);
        return;
      }

      // Patient rows
      let html = pacientes.map((p: any) => {
        const cells = MESES_CORTOS.map((_: string, i: number) => {
          const md = p.meses[String(i + 1)];
          if (!md || md.total === 0) return '<td class="text-right gestoria-cell-empty">\u2014</td>';
          const tip = `Efectivo: ${fmtMoney(md.efectivo)} | Tarjeta: ${fmtMoney(md.tarjeta)} | Sesiones: ${md.sesiones}`;
          return `<td class="text-right gestoria-cell-filled" title="${escapeAttr(tip)}">${fmtMoney(md.total)}</td>`;
        }).join('');
        return `<tr>
          <td class="gestoria-patient-name">${escapeHtml(p.nombre)}</td>
          ${cells}
          <td class="text-right"><strong>${fmtMoney(p.total_anual)}</strong></td>
          <td class="text-right gestoria-efe">${fmtMoney(p.efectivo_anual)}</td>
          <td class="text-right gestoria-tar">${fmtMoney(p.tarjeta_anual)}</td>
        </tr>`;
      }).join('');

      // Totals row (facturación total del mes)
      const totalCells = MESES_CORTOS.map((_: string, i: number) => {
        const md = totales_mes[String(i + 1)];
        const val = md ? md.total : 0;
        return `<td class="text-right"><strong>${val ? fmtMoney(val) : '\u2014'}</strong></td>`;
      }).join('');
      html += `<tr class="gestoria-totals-row">
        <td class="gestoria-patient-name"><strong>TOTAL</strong></td>
        ${totalCells}
        <td class="text-right"><strong>${fmtMoney(gran_total.total)}</strong></td>
        <td class="text-right gestoria-efe"><strong>${fmtMoney(gran_total.efectivo)}</strong></td>
        <td class="text-right gestoria-tar"><strong>${fmtMoney(gran_total.tarjeta)}</strong></td>
      </tr>`;

      gestoriaBody.innerHTML = html;
    } catch {
      setTableState(gestoriaBody, 16, 'cloud_off', 'Error al cargar datos de gestor\u00eda');
    }
  };

  pageLoaders['gestoria'] = loadGestoria;
  gestoriaAnioFilter?.addEventListener('change', () => { loadGestoria(); loadGestoriaMes(); });

  // Monthly detail report
  const gestoriaMesFilter = document.getElementById('gestoriaMesFilter') as HTMLSelectElement | null;
  const gestoriaMesBody = document.getElementById('gestoriaMesBody') as HTMLElement | null;

  // Auto-select current month
  if (gestoriaMesFilter) gestoriaMesFilter.value = String(new Date().getMonth() + 1);

  const loadGestoriaMes = async () => {
    if (!gestoriaMesBody) return;
    setTableState(gestoriaMesBody, 4, 'sync', 'Cargando...', true);

    const anio = gestoriaAnioFilter?.value || String(new Date().getFullYear());
    const mes = gestoriaMesFilter?.value || String(new Date().getMonth() + 1);

    try {
      const payload = await fetchJson(`${BACKEND_BASE}/api/pagos?anio=${anio}&mes=${mes}`);
      const pagos = payload?.data || [];

      // Calculate totals for the month
      let totalMes = 0, efecMes = 0, tarjMes = 0;
      for (const p of pagos) {
        const imp = Number(p.importe);
        totalMes += imp;
        if (p.metodo_pago === 'efectivo') efecMes += imp; else tarjMes += imp;
      }
      document.getElementById('gestoriaMesTotal')!.textContent = fmtMoney(totalMes);
      document.getElementById('gestoriaMesEfectivo')!.textContent = fmtMoney(efecMes);
      document.getElementById('gestoriaMesTarjeta')!.textContent = fmtMoney(tarjMes);
      document.getElementById('gestoriaMesSesiones')!.textContent = String(pagos.length);

      if (!pagos.length) {
        setTableState(gestoriaMesBody, 4, 'credit_card_off', 'Sin pagos en este mes');
        return;
      }

      gestoriaMesBody.innerHTML = pagos.map((p: any) => {
        const pName = p.crm_pacientes ? `${p.crm_pacientes.nombre || ''} ${p.crm_pacientes.apellidos || ''}`.trim() : '\u2014';
        const chip = p.metodo_pago === 'efectivo'
          ? '<span class="pagos-chip pagos-chip-cash">Efectivo</span>'
          : '<span class="pagos-chip pagos-chip-card">Tarjeta</span>';
        return `<tr>
          <td>${p.fecha ? new Date(p.fecha + 'T00:00:00').toLocaleDateString('es-ES', {day:'2-digit',month:'short'}) : '\u2014'}</td>
          <td class="td-patient">${escapeHtml(pName)}</td>
          <td>${chip}</td>
          <td class="text-right"><strong>${fmtMoney(Number(p.importe))}</strong></td>
        </tr>`;
      }).join('');
    } catch {
      setTableState(gestoriaMesBody, 4, 'cloud_off', 'Error al cargar datos');
    }
  };

  gestoriaMesFilter?.addEventListener('change', loadGestoriaMes);

  // Load both on page enter
  const origLoadGestoria = loadGestoria;
  pageLoaders['gestoria'] = async () => { await origLoadGestoria(); await loadGestoriaMes(); };
  // ===================== END GESTORIA =====================

  const loadConfig = async () => {
    const cfgBackend = document.getElementById('cfgBackend');
    const cfgBackendStatus = document.getElementById('cfgBackendStatus');
    const cfgAgent = document.getElementById('cfgAgent');
    const cfgAgentStatus = document.getElementById('cfgAgentStatus');
    if (cfgBackend) cfgBackend.textContent = BACKEND_BASE;
    try {
      const r = await fetch(`${BACKEND_BASE}/api/health`, {signal: AbortSignal.timeout(5000)});
      if (cfgBackendStatus) { cfgBackendStatus.textContent = r.ok ? 'OK' : 'Error'; cfgBackendStatus.className = `status-chip ${r.ok ? 'aprobado' : 'rechazado'}`; }
    } catch { if (cfgBackendStatus) { cfgBackendStatus.textContent = 'Offline'; cfgBackendStatus.className = 'status-chip rechazado'; } }
    if (cfgAgent) cfgAgent.textContent = BACKEND_BASE + '/api/agent/message';
    try {
      const r = await fetch(`${BACKEND_BASE}/api/agent/message`, {method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({role:'test',channel:'web',text:'health check'}),signal:AbortSignal.timeout(10000)});
      const data = await r.json();
      const ok = r.ok && !data.n8n_unreachable;
      if (cfgAgentStatus) { cfgAgentStatus.textContent = ok ? (data.fallback_used ? 'Fallback' : 'OK') : 'Error'; cfgAgentStatus.className = `status-chip ${ok ? 'aprobado' : 'rechazado'}`; }
    } catch { if (cfgAgentStatus) { cfgAgentStatus.textContent = 'Offline'; cfgAgentStatus.className = 'status-chip rechazado'; } }
  };
  pageLoaders['config'] = loadConfig;

  renderAssistantPatientContext();
  fetchPatientCatalog()
    .then((pts) => {
      const metricEl = document.getElementById('metricPacientes');
      if (metricEl) metricEl.textContent = String(pts.length);
    })
    .catch(() => {
      if (chatPatientSelect) {
        chatPatientSelect.innerHTML = '<option value="">No se pudieron cargar pacientes</option>';
      }
    });
</script>

<style>
  /* === EXERCISE REPORT CARDS === */
  .exercise-report {
    margin-top: 0.5rem;
  }
  .exercise-alert {
    background: rgba(239, 68, 68, 0.15);
    border: 1px solid rgba(239, 68, 68, 0.35);
    color: #fca5a5;
    padding: 0.5rem 0.75rem;
    border-radius: 8px;
    margin-bottom: 0.5rem;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .exercise-note {
    color: var(--text-secondary, #94a3b8);
    font-size: 0.85rem;
    margin-bottom: 0.5rem;
    padding: 0.4rem 0.6rem;
    background: rgba(59, 130, 246, 0.08);
    border-radius: 6px;
  }
  .exercise-summary {
    font-size: 0.9rem;
    color: var(--text-secondary, #94a3b8);
    margin-bottom: 0.75rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border, rgba(119, 153, 204, 0.12));
  }
  .exercise-card {
    display: flex;
    gap: 0.75rem;
    background: var(--bg-surface, rgba(255, 255, 255, 0.04));
    border: 1px solid var(--border, rgba(119, 153, 204, 0.12));
    border-radius: 10px;
    padding: 0.6rem;
    margin-bottom: 0.5rem;
    transition: border-color 0.2s;
  }
  .exercise-card:hover {
    border-color: var(--accent, #0d9488);
  }
  .exercise-card-img {
    flex-shrink: 0;
    width: 90px;
    height: 90px;
    border-radius: 8px;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.06);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .exercise-card-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .exercise-card-body {
    flex: 1;
    min-width: 0;
  }
  .exercise-card-title {
    font-weight: 600;
    font-size: 0.92rem;
    color: var(--text-primary, #e2e8f0);
    margin-bottom: 0.2rem;
  }
  .exercise-zona {
    font-weight: 400;
    font-size: 0.78rem;
    color: var(--accent, #0d9488);
    background: rgba(13, 148, 136, 0.12);
    padding: 1px 6px;
    border-radius: 4px;
    margin-left: 0.3rem;
  }
  .exercise-card-pauta {
    font-size: 0.8rem;
    color: var(--text-secondary, #94a3b8);
    margin-bottom: 0.15rem;
  }
  .exercise-card-proc {
    font-size: 0.8rem;
    color: var(--text-secondary, #94a3b8);
    line-height: 1.35;
    margin-bottom: 0.15rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .exercise-card-why {
    font-size: 0.78rem;
    color: var(--text-muted, #64748b);
  }
  .exercise-card-caution {
    font-size: 0.78rem;
    color: #fbbf24;
    display: flex;
    align-items: center;
    gap: 0.25rem;
    margin-top: 0.15rem;
  }
  .exercise-patient-msg {
    margin-top: 0.75rem;
    padding: 0.5rem 0.65rem;
    background: rgba(16, 185, 129, 0.08);
    border-radius: 6px;
    font-size: 0.85rem;
    color: var(--text-secondary, #94a3b8);
  }
  .exercise-id {
    font-size: 0.72rem;
    color: var(--text-muted, #64748b);
    margin-top: 0.4rem;
    text-align: right;
  }
  @media (max-width: 480px) {
    .exercise-card {
      flex-direction: column;
    }
    .exercise-card-img {
      width: 100%;
      height: 120px;
    }
  }

  /* === APP SHELL === */
  .app-shell {
    display: flex;
    min-height: 100vh;
  }

  /* === SIDEBAR === */
  .sidebar {
    width: var(--sidebar-width);
    min-width: var(--sidebar-width);
    background: linear-gradient(180deg, var(--sidebar-bg) 0%, var(--sidebar-bg2) 100%);
    border-right: 1px solid var(--sidebar-border);
    color: var(--sidebar-text);
    display: flex;
    flex-direction: column;
    padding: 0.85rem 0.65rem;
    transition: width var(--transition-slow), min-width var(--transition-slow);
    overflow: hidden;
    z-index: 10;
    flex-shrink: 0;
    position: relative;
  }
  /* Subtle decorative top line */
  .sidebar::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, var(--accent), #0ea5e9, var(--accent));
    opacity: 0.6;
  }
  .sidebar.collapsed {
    width: var(--sidebar-collapsed);
    min-width: var(--sidebar-collapsed);
  }
  .sidebar.collapsed .nav-label,
  .sidebar.collapsed .brand-text,
  .sidebar.collapsed .badge { display: none; }

  .sidebar-brand {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.5rem 0.5rem 1.1rem;
    border-bottom: 1px solid rgba(255,255,255,0.06);
    margin-bottom: 0.5rem;
  }
  .brand-icon-wrapper {
    width: 34px;
    height: 34px;
    background: linear-gradient(135deg, #0d9488, #0ea5e9);
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    box-shadow: 0 4px 12px rgba(13,148,136,0.4);
  }
  .brand-icon {
    font-size: 18px;
    color: #ffffff;
    font-variation-settings: 'FILL' 1, 'wght' 400, 'GRAD' 0, 'opsz' 24;
  }
  .brand-text {
    font-weight: 700;
    font-size: clamp(0.9rem, 1.1vw, 1.05rem);
    letter-spacing: -0.02em;
    white-space: nowrap;
    color: #ffffff;
  }

  .sidebar-nav {
    display: flex;
    flex-direction: column;
    gap: 1px;
    flex: 1;
  }
  .sidebar-bottom {
    padding-top: 0.25rem;
    margin-top: 0.25rem;
    border-top: 1px solid rgba(255,255,255,0.06);
  }
  .sidebar-section-label {
    font-size: 0.65rem;
    font-weight: 700;
    color: rgba(148, 163, 184, 0.5);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    padding: 1.1rem 0.75rem 0.45rem;
  }

  .nav-item {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.6rem 0.75rem;
    border-radius: var(--radius-sm);
    color: var(--sidebar-text);
    font-size: clamp(0.8rem, 0.85vw, 0.88rem);
    font-weight: 500;
    transition: all var(--transition);
    position: relative;
    white-space: nowrap;
    border: 1px solid transparent;
  }
  .nav-item:hover {
    background: rgba(255,255,255,0.06);
    color: var(--sidebar-text-hover);
  }
  .nav-item.active {
    background: var(--sidebar-active-bg);
    color: var(--sidebar-active-color);
    font-weight: 600;
    border-color: rgba(13, 148, 136, 0.20);
    box-shadow: 0 2px 8px rgba(13, 148, 136, 0.12);
  }
  .nav-item.active .material-symbols-rounded {
    font-variation-settings: 'FILL' 1, 'wght' 400, 'GRAD' 0, 'opsz' 24;
  }
  .nav-item-agent {
    color: var(--sidebar-text);
  }
  .nav-item .material-symbols-rounded { font-size: 19px; flex-shrink: 0; }

  .badge {
    background: var(--danger);
    color: #fff;
    font-size: 0.65rem;
    font-weight: 700;
    padding: 1px 6px;
    border-radius: 99px;
    margin-left: auto;
    line-height: 1.4;
  }

  /* === MAIN AREA === */
  .main-area {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-width: 0;
    overflow: hidden;
  }

  /* === TOPBAR === */
  .topbar {
    height: var(--topbar-height);
    background: var(--glass);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--glass-border);
    box-shadow: 0 1px 6px rgba(15, 23, 42, 0.06);
    display: flex;
    align-items: center;
    padding: 0 clamp(0.75rem, 2vw, 1.5rem);
    gap: clamp(0.5rem, 1vw, 1rem);
    flex-shrink: 0;
    position: sticky;
    top: 0;
    z-index: 20;
  }
  .sidebar-toggle {
    background: none;
    border: none;
    color: var(--text-secondary);
    cursor: pointer;
    padding: 7px;
    border-radius: var(--radius-sm);
    display: flex;
    transition: all var(--transition);
  }
  .sidebar-toggle:hover { background: var(--bg-surface); color: var(--text-primary); }

  .search-box {
    flex: 1;
    max-width: clamp(240px, 32vw, 440px);
    position: relative;
  }
  .search-icon {
    position: absolute;
    left: 12px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--text-muted);
    font-size: 19px;
  }
  .search-box input {
    width: 100%;
    background: var(--bg-surface);
    border: 1.5px solid var(--border);
    border-radius: 9999px;
    padding: 0.52rem 0.75rem 0.52rem 2.5rem;
    color: var(--text-primary);
    font: inherit;
    font-size: 0.88rem;
    transition: border-color var(--transition), box-shadow var(--transition);
  }
  .search-box input::placeholder { color: var(--text-muted); }
  .search-box input:focus {
    outline: none;
    border-color: var(--accent);
    background: #fff;
    box-shadow: 0 0 0 3px var(--accent-soft);
  }

  .search-results {
    position: absolute;
    top: calc(100% + 0.45rem);
    left: 0;
    right: 0;
    z-index: 40;
    display: grid;
    gap: 0.3rem;
    padding: 0.45rem;
    background: rgba(255, 255, 255, 0.98);
    border: 1px solid var(--border);
    border-radius: 1rem;
    box-shadow: var(--shadow-lg);
    max-height: min(420px, 60vh);
    overflow: auto;
  }
  .search-results[hidden] {
    display: none;
  }
  .search-results-head {
    padding: 0.25rem 0.45rem;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .search-result-item {
    width: 100%;
    border: 0;
    background: transparent;
    border-radius: 0.85rem;
    padding: 0.7rem 0.75rem;
    display: flex;
    align-items: center;
    gap: 0.7rem;
    text-align: left;
    cursor: pointer;
    transition: background var(--transition), transform var(--transition);
  }
  .search-result-item:hover,
  .search-result-item.is-active {
    background: var(--accent-soft);
  }
  .search-result-item.is-active {
    transform: translateY(-1px);
  }
  .search-result-icon {
    color: var(--accent);
    font-size: 1.1rem;
  }
  .search-result-main {
    min-width: 0;
    flex: 1;
    display: grid;
    gap: 0.18rem;
  }
  .search-result-title {
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--text-primary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .search-result-meta {
    font-size: 0.77rem;
    color: var(--text-secondary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .search-result-arrow {
    color: var(--text-muted);
    font-size: 1rem;
  }
  .search-results-empty {
    padding: 0.85rem 0.9rem;
    font-size: 0.84rem;
    color: var(--text-secondary);
  }

  .topbar-right {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-left: auto;
    flex-shrink: 0;
  }
  .icon-btn {
    background: none;
    border: none;
    color: var(--text-secondary);
    cursor: pointer;
    padding: 7px;
    border-radius: var(--radius-sm);
    position: relative;
    display: flex;
    transition: all var(--transition);
  }
  .icon-btn:hover { background: var(--bg-surface); color: var(--text-primary); }
  .dot-indicator {
    position: absolute;
    top: 4px;
    right: 4px;
    width: 8px;
    height: 8px;
    background: var(--danger);
    border-radius: 50%;
    border: 2px solid var(--bg-card);
  }
  .user-pill {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    padding: 3px 10px 3px 3px;
    border-radius: 99px;
    background: var(--bg-card);
    border: 1.5px solid var(--border);
    box-shadow: var(--shadow-xs);
    cursor: pointer;
    transition: border-color var(--transition), box-shadow var(--transition);
  }
  .user-pill:hover {
    border-color: var(--border-strong);
    box-shadow: var(--shadow-sm);
  }
  .avatar {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: linear-gradient(135deg, #0d9488, #0ea5e9);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.74rem;
    font-weight: 700;
    color: #fff;
    flex-shrink: 0;
  }
  .user-name {
    font-size: 0.84rem;
    font-weight: 600;
    white-space: nowrap;
    color: var(--text-primary);
  }
  .topbar-notif-btn {
    position: relative;
    color: var(--text-muted);
  }
  .topbar-notif-btn:hover {
    color: var(--text-secondary);
  }

  /* === CONTENT === */
  .workspace-shell {
    flex: 1;
    min-height: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr) clamp(300px, 26vw, 400px);
    align-items: stretch;
    overflow: hidden;
  }

  .content {
    grid-column: 1;
    min-height: 0;
    min-width: 0;
    height: calc(100vh - var(--topbar-height));
    padding: clamp(1rem, 2vw, 1.75rem) clamp(1rem, 2.5vw, 2rem);
    overflow-y: auto;
    overflow-x: hidden;
    background: var(--bg-base);
  }

  .assistant-launch-btn {
    display: none;
    align-items: center;
    gap: 0.45rem;
    border: 1px solid rgba(88, 164, 255, 0.22);
    background: linear-gradient(135deg, rgba(15, 118, 110, 0.16), rgba(30, 64, 175, 0.16));
    color: var(--text-primary);
    border-radius: 999px;
    padding: 0.5rem 0.85rem;
    font: inherit;
    font-size: 0.84rem;
    font-weight: 600;
    cursor: pointer;
    transition: transform var(--transition), border-color var(--transition), background var(--transition);
  }
  .assistant-launch-btn:hover {
    transform: translateY(-1px);
    border-color: rgba(88, 164, 255, 0.36);
    background: linear-gradient(135deg, rgba(15, 118, 110, 0.24), rgba(30, 64, 175, 0.22));
  }
  .assistant-launch-btn .material-symbols-rounded {
    font-size: 1rem;
    color: var(--accent);
  }

  .assistant-fab {
    display: none;
    align-items: center;
    gap: 0.5rem;
    position: fixed;
    right: 1rem;
    bottom: 1rem;
    z-index: 95;
    padding: 0.78rem 1rem;
    border: 0;
    border-radius: 999px;
    background: linear-gradient(135deg, #0d9488, #0ea5e9);
    color: #ffffff;
    font: inherit;
    font-size: 0.9rem;
    font-weight: 700;
    box-shadow: 0 20px 38px -24px rgba(15, 23, 42, 0.45);
    cursor: pointer;
  }

  .assistant-fab .material-symbols-rounded,
  .assistant-fab span {
    color: inherit;
  }

  .assistant-fab[aria-expanded='true'] {
    background: linear-gradient(135deg, #0f766e, #0369a1);
  }

  .assistant-rail {
    grid-column: 2;
    position: sticky;
    top: 0;
    align-self: start;
    min-height: 0;
    height: calc(100dvh - var(--topbar-height));
    max-height: calc(100dvh - var(--topbar-height));
    padding: 0;
    border-left: 1px solid #e2e8f0;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: #f8fafc;
  }

  .assistant-rail-card {
    height: 100%;
    min-height: 0;
    max-height: 100%;
    display: flex;
    flex-direction: column;
    border-radius: 0;
    border: none;
    background: #ffffff;
    box-shadow: none;
    overflow: hidden;
  }

  .assistant-module-header {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.7rem 0.9rem;
    background: linear-gradient(135deg, #0f172a 0%, #1a2744 60%, #0d3241 100%);
    border-bottom: 2px solid #0f9f98;
  }

  .assistant-rail-copy {
    display: grid;
    gap: 0.4rem;
    max-width: 22rem;
  }
  .assistant-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.6rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #5eead4;
  }
  .assistant-rail-copy h2 {
    margin: 0;
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.2;
    color: #f1f5f9;
  }
  .assistant-rail-copy p {
    margin: 0;
    font-size: 0.78rem;
    line-height: 1.45;
    color: #94a3b8;
  }
  .assistant-rail-tools {
    margin-left: auto;
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
  }
  .assistant-rail-close {
    display: none;
    align-items: center;
    justify-content: center;
    width: 2.2rem;
    height: 2.2rem;
    border-radius: 999px;
    border: 1px solid rgba(148, 163, 184, 0.16);
    background: rgba(255, 255, 255, 0.04);
    color: #e2e8f0;
    cursor: pointer;
  }

  .assistant-rail-body {
    display: flex;
    flex: 1;
    min-height: 0;
    flex-direction: column;
    overflow: hidden;
  }


  .assistant-context-strip {
    flex-shrink: 0;
    display: grid;
    gap: 0.65rem;
    padding: 0.75rem 1.25rem;
    background: linear-gradient(180deg, rgba(241, 245, 249, 0.92), rgba(241, 245, 249, 0.65));
    border-bottom: 1px solid rgba(203, 213, 225, 0.88);
    max-height: none;
    overflow: visible;
  }
  .assistant-context-card {
    border-radius: 1rem;
    border: 1px solid rgba(203, 213, 225, 0.88);
    background: rgba(255, 255, 255, 0.92);
    padding: 0.9rem 1rem;
  }
  .assistant-context-card-highlight {
    background: linear-gradient(135deg, rgba(14, 165, 233, 0.14), rgba(37, 99, 235, 0.08));
    border-color: rgba(125, 211, 252, 0.85);
  }
  .assistant-context-label {
    display: block;
    margin-bottom: 0.35rem;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #6b7f95;
  }
  .assistant-context-card strong {
    display: block;
    font-size: 1rem;
    color: #f8fafc;
  }
  .assistant-context-card p {
    margin: 0.35rem 0 0;
    font-size: 0.78rem;
    line-height: 1.45;
    color: #66788a;
  }
  
  /* === NEW DASHBOARD LAYOUT === */
  .dashboard-layout {
    display: flex;
    flex-direction: column;
    gap: clamp(1.1rem, 1.75vw, 1.75rem);
    max-width: 1500px;
    margin: 0 auto;
  }

  /* === HERO SECTION === */
  .hero-section {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.25rem 0;
    animation: fadeIn 0.4s ease-out;
  }
  .hero-content {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }
  .hero-title {
    font-size: clamp(1.35rem, 1.8vw, 1.8rem);
    font-weight: 700;
    color: var(--text-primary);
    margin: 0;
    letter-spacing: -0.025em;
  }
  .hero-subtitle {
    font-size: clamp(0.82rem, 0.9vw, 0.93rem);
    color: var(--text-muted);
    margin: 0.2rem 0 0;
    max-width: 600px;
  }
  .hero-actions .btn-primary {
    padding: 0.72rem 1.2rem;
    font-size: clamp(0.82rem, 0.88vw, 0.9rem);
  }
  .btn-primary-teal {
    background: #0d9488 !important;
    box-shadow: 0 4px 14px -4px rgba(13, 148, 136, 0.45) !important;
    border-radius: 0.75rem !important;
  }
  .btn-primary-teal:hover {
    background: #0f766e !important;
    filter: none !important;
  }

  /* === METRICS === */
  .metrics-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(clamp(180px, 20vw, 240px), 1fr));
    gap: clamp(0.75rem, 1.5vw, 1.25rem);
  }
  .metric-card {
    background: var(--bg-card);
    border: none;
    border-radius: var(--radius-lg);
    padding: clamp(1rem, 1.5vw, 1.4rem);
    display: flex;
    align-items: center;
    gap: 1.1rem;
    transition: all var(--transition);
    box-shadow: var(--shadow-sm);
    animation: card-enter 0.45s ease-out forwards;
    opacity: 0;
    transform: translateY(8px);
  }
  .metric-card:nth-child(1) { animation-delay: 0.04s; }
  .metric-card:nth-child(2) { animation-delay: 0.1s; }
  .metric-card:nth-child(3) { animation-delay: 0.16s; }

  @keyframes card-enter {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .metric-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }
  .metric-icon {
    width: clamp(44px, 4vw, 52px);
    height: clamp(44px, 4vw, 52px);
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .metric-icon .material-symbols-rounded { font-size: clamp(22px, 2vw, 26px); }
  .metric-data {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .metric-value {
    font-size: clamp(1.4rem, 2vw, 1.8rem);
    font-weight: 700;
    line-height: 1;
    color: var(--text-primary);
  }
  .metric-label {
    font-size: clamp(0.75rem, 0.85vw, 0.85rem);
    font-weight: 500;
    color: var(--text-secondary);
    margin-top: 5px;
  }

  /* === METRIC CARDS V2 === */
  .metric-card-v2 {
    background: var(--bg-card);
    border: none;
    border-radius: var(--radius-lg);
    padding: clamp(1rem, 1.5vw, 1.5rem);
    box-shadow: var(--shadow-sm);
    transition: all var(--transition);
  }
  .metric-card-v2:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }
  .metric-card-v2 .metric-icon {
    width: clamp(42px, 3.5vw, 50px);
    height: clamp(42px, 3.5vw, 50px);
    border-radius: var(--radius-md);
    flex-shrink: 0;
  }
  .metric-card-v2 .metric-icon .material-symbols-rounded {
    font-size: clamp(20px, 1.8vw, 24px);
    font-variation-settings: 'FILL' 1, 'wght' 400, 'GRAD' 0, 'opsz' 24;
  }
  .metric-card-v2 .metric-value {
    font-size: clamp(1.4rem, 1.8vw, 1.75rem);
    font-weight: 700;
    color: var(--text-primary);
  }
  .metric-card-v2 .metric-label {
    font-size: clamp(0.75rem, 0.82vw, 0.85rem);
    color: var(--text-muted);
    font-weight: 500;
  }
  .metric-icon-blue {
    background: #eff6ff;
    color: #2563eb;
  }
  .metric-icon-emerald {
    background: #ecfdf5;
    color: #059669;
  }
  .metric-icon-indigo {
    background: #eef2ff;
    color: #4f46e5;
  }
  .metric-icon-amber {
    background: #fffbeb;
    color: #d97706;
  }
  .metric-icon-green { background: #dcfce7; color: #166534; }

  /* === CARD BASE === */
  .card {
    background: var(--bg-card);
    border: none;
    border-radius: var(--radius-lg);
    overflow: hidden;
    min-width: 0;
    box-shadow: var(--shadow-sm);
    animation: fadeIn 0.34s ease-out;
    transition: box-shadow var(--transition);
  }
  .card:hover {
    box-shadow: var(--shadow-md);
  }
  .card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: clamp(0.75rem, 1.2vw, 1rem) clamp(1rem, 1.5vw, 1.25rem);
    border-bottom: 1px solid var(--border-light);
    background: var(--bg-surface);
  }
  .card-header h2 {
    font-size: clamp(0.88rem, 0.95vw, 1rem);
    font-weight: 600;
    margin: 0;
    color: var(--text-primary);
  }
  .btn-ghost {
    background: none;
    border: none;
    color: var(--text-secondary);
    font: inherit;
    font-size: 0.85rem;
    font-weight: 500;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 6px 10px;
    border-radius: var(--radius-sm);
    transition: all var(--transition);
    white-space: nowrap;
  }
  .btn-ghost:hover { color: var(--accent); background: var(--accent-soft); }
  .btn-ghost .material-symbols-rounded { font-size: 18px; }

  /* === CENTRAL AI MODULE === */
  .ai-clinical-module {
    display: flex;
    flex-direction: column;
    min-height: 0;
  }
  .module-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.2rem 1.5rem;
    border-bottom: 1px solid var(--border);
    background: var(--bg-card);
  }
  .module-title {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .module-title h2 {
    font-size: 1.15rem;
    font-weight: 600;
    margin: 0;
    color: var(--text-primary);
  }
  .accent-icon {
    color: var(--accent);
    font-size: 26px;
    background: var(--accent-soft);
    padding: 8px;
    border-radius: var(--radius-md);
  }
  .agent-status-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(16, 185, 129, 0.08);
    padding: 0.45rem 0.8rem;
    border-radius: 999px;
    border: 1px solid rgba(16, 185, 129, 0.14);
  }

  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .status-dot.connected {
    background: var(--success);
    box-shadow: 0 0 6px rgba(16, 185, 129, 0.4);
    animation: pulse-dot 2s infinite;
  }
  .status-dot.disconnected { background: var(--danger); }
  .status-text { font-size: 0.8rem; font-weight: 600; color: #3f556b; }

  @keyframes pulse-dot {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.5; }
  }

  .ai-workspace {
    display: flex;
    flex-direction: column;
    flex: 0 0 auto;
    min-height: 0;
    overflow: visible;
    background: transparent;
  }

  .assistant-shortcuts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    padding: 0.95rem 1.25rem 0;
  }
  .assistant-shortcut {
    border: 1px solid rgba(13, 148, 136, 0.16);
    background: rgba(13, 148, 136, 0.08);
    color: #0f766e;
    border-radius: 999px;
    padding: 0.48rem 0.82rem;
    font: inherit;
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1.2;
    cursor: pointer;
    transition: transform var(--transition), border-color var(--transition), background var(--transition), color var(--transition);
  }
  .assistant-shortcut:hover {
    transform: translateY(-1px);
    background: rgba(13, 148, 136, 0.14);
    border-color: rgba(13, 148, 136, 0.28);
    color: #115e59;
  }
  
  /* CHAT LOG */
  .chat-log {
    flex: 1;
    overflow-y: auto;
    padding: 1rem 1.25rem 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-height: 0;
    background: transparent;
  }
  .msg {
    display: flex;
    gap: 0.75rem;
    max-width: 85%;
    animation: msg-in 0.25s ease-out;
  }
  .msg.user { flex-direction: row-reverse; align-self: flex-end; }
  .msg.agent { align-self: flex-start; }

  @keyframes msg-in {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .msg-avatar {
    width: 36px;
    height: 36px;
    border-radius: var(--radius-md);
    background: var(--bg-card);
    border: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    box-shadow: var(--shadow-sm);
  }
  .msg.agent .msg-avatar { background: var(--accent-soft); border-color: transparent; }
  .msg.agent .msg-avatar .material-symbols-rounded { font-size: 20px; color: var(--accent); }
  .msg.user .msg-avatar .material-symbols-rounded { font-size: 20px; color: var(--text-secondary); }

  .msg-body {
    border-radius: var(--radius-lg);
    padding: 0.85rem 1.15rem;
    font-size: 0.92rem;
    line-height: 1.5;
    overflow-wrap: anywhere;
    box-shadow: var(--shadow-sm);
  }
  .msg.agent .msg-body { background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(148, 163, 184, 0.14); color: #e5eef7; border-top-left-radius: 4px; }
  .msg.user .msg-body { background: linear-gradient(135deg, #0f766e, #155eef); color: white; border-top-right-radius: 4px; box-shadow: 0 12px 26px rgba(21, 94, 239, 0.22); }
  .msg-progress .msg-avatar .material-symbols-rounded {
    animation: spin 1.1s linear infinite;
  }
  .msg-progress .msg-body {
    border-style: dashed;
    background: linear-gradient(180deg, #ffffff, #f8fafc);
  }
  .msg-body p { margin: 0; white-space: pre-line; }
  .msg-sender {
    display: block;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-muted);
    margin-bottom: 4px;
  }
  .msg.agent .msg-sender { color: var(--accent); }
  .msg.user .msg-sender { color: rgba(255,255,255,0.8); }

  /* AI INPUT AREA */
  .ai-input-area {
    padding: 0.75rem 1.25rem 1rem;
    background: #ffffff;
    border-top: 1px solid #e2e8f0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    flex-shrink: 0;
    max-height: none;
    overflow: visible;
  }
  .ai-input-area.is-busy {
    opacity: 0.92;
  }
  .ai-controls {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  .assistant-composer-note {
    font-size: 0.74rem;
    line-height: 1.4;
    color: rgba(226, 232, 240, 0.72);
  }
  .assistant-field {
    display: grid;
    gap: 0.32rem;
  }
  .assistant-field-label {
    font-size: 0.9rem;
    font-weight: 700;
    color: #f8fafc;
  }
  .assistant-field-help {
    font-size: 0.76rem;
    line-height: 1.45;
    color: rgba(226, 232, 240, 0.68);
  }
  .patient-selector {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(148, 163, 184, 0.14);
    border-radius: 0.95rem;
    padding: 0.55rem 0.9rem;
    transition: border-color var(--transition), box-shadow var(--transition);
  }
  .patient-selector:focus-within {
    border-color: rgba(94, 234, 212, 0.48);
    box-shadow: 0 0 0 4px rgba(13, 148, 136, 0.18);
  }
  .patient-selector select {
    border: none;
    background: transparent;
    font: inherit;
    font-size: 0.9rem;
    font-weight: 600;
    color: #f8fafc;
    outline: none;
    width: 250px;
    cursor: pointer;
  }
  .patient-selector option {
    color: #0f172a;
  }
  .patient-selector .material-symbols-rounded {
    font-size: 20px;
    color: #5eead4;
  }
  
  .ai-textarea-wrapper {
    position: relative;
    border: 1px solid rgba(148, 163, 184, 0.14);
    border-radius: 1.15rem;
    background: rgba(248, 250, 252, 0.04);
    transition: all 0.2s;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.03);
  }
  .ai-textarea-wrapper:focus-within {
    border-color: rgba(94, 234, 212, 0.42);
    box-shadow: 0 0 0 4px rgba(13, 148, 136, 0.16);
    background: rgba(248, 250, 252, 0.06);
  }
  .ai-textarea-wrapper textarea {
    width: 100%;
    border: none;
    background: transparent;
    padding: 1rem 1.05rem;
    font: inherit;
    font-size: 0.96rem;
    color: #f8fafc;
    resize: none;
    min-height: 180px;
    max-height: 340px;
    outline: none;
    line-height: 1.6;
  }
  .ai-textarea-wrapper textarea::placeholder {
    color: rgba(203, 213, 225, 0.56);
  }
  .ai-actions {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 0.9rem;
    padding: 0;
    flex-wrap: wrap;
  }
  .assistant-submit-hint {
    margin: 0;
    max-width: 15rem;
    font-size: 0.75rem;
    line-height: 1.5;
    color: rgba(226, 232, 240, 0.68);
  }
  .action-buttons {
    display: flex;
    gap: 0.75rem;
    margin-left: auto;
  }
  .btn-action {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 0.65rem 1.15rem;
    border-radius: var(--radius-md);
    font: inherit;
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    border: none;
    transition: all 0.2s;
  }
  .btn-action.is-loading {
    cursor: wait;
  }
  .btn-generate {
    background: var(--accent);
    color: white;
    box-shadow: 0 4px 6px -1px var(--accent-soft);
  }
  .btn-generate:hover {
    background: #0d655f;
    transform: translateY(-1px);
    box-shadow: 0 6px 8px -1px var(--accent-soft);
  }
  .btn-generate:disabled { opacity: 0.5; cursor: not-allowed; transform: none; box-shadow: none; }
  
  .btn-pdf {
    background: rgba(255, 255, 255, 0.05);
    color: #e2e8f0;
    border: 1px solid rgba(148, 163, 184, 0.16);
  }
  .btn-pdf:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(148, 163, 184, 0.28);
    color: #f8fafc;
  }
  .btn-pdf:disabled { opacity: 0.5; cursor: not-allowed; }

  .btn-chat {
    background: rgba(255, 255, 255, 0.05);
    color: #e2e8f0;
    border: 1px solid rgba(148, 163, 184, 0.16);
    padding: 0.65rem 0.85rem;
  }
  .btn-chat:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(148, 163, 184, 0.28);
    color: #f8fafc;
  }
  .btn-chat:disabled { opacity: 0.5; cursor: not-allowed; }

  /* === DASHBOARD BOTTOM ROW === */
  .dashboard-chart-card {
    min-height: auto;
  }
  .dashboard-chart-wrap {
    padding: 0.5rem 1rem 0.5rem 0.5rem;
  }
  .dashboard-chart-wrap canvas {
    width: 100%;
    height: 180px;
  }
  .chart-year-label {
    font-size: 0.85rem;
    color: var(--text-muted);
    font-weight: 600;
  }
  .dashboard-bottom-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(clamp(280px, 35vw, 420px), 1fr));
    gap: clamp(0.9rem, 1.5vw, 1.5rem);
  }
  .widget-card {
    min-height: 280px;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .widget-body {
    flex: 1;
    overflow-y: auto;
    min-width: 0;
  }
  .list-clean {
    padding: 0;
  }
  
  /* Modern Clean Lists */
  .clean-list-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid var(--border);
    transition: background var(--transition);
  }
  .clean-list-item:last-child {
    border-bottom: none;
  }
  .clean-list-item:hover {
    background: var(--bg-card-hover);
  }
  .clean-list-main {
    min-width: 0;
    display: grid;
    gap: 0.2rem;
  }
  .clean-list-title {
    margin: 0;
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--text-primary);
  }
  .clean-list-meta {
    margin: 0;
    font-size: 0.8rem;
    color: var(--text-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .clean-list-action {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-left: 0.75rem;
    flex-shrink: 0;
  }

  .empty-state-sm {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 3rem 1.5rem;
    color: var(--text-muted);
    text-align: center;
    height: 100%;
  }
  .empty-state-sm .material-symbols-rounded {
    font-size: 36px;
    margin-bottom: 0.75rem;
    color: var(--border-light);
  }
  .empty-state-sm p {
    margin: 0;
    font-size: 0.95rem;
    font-weight: 500;
  }

  /* === TABLE OVERRIDES === */
  .table-wrap { overflow-x: auto; -webkit-overflow-scrolling: touch; }
  table { width: 100%; border-collapse: collapse; }
  thead { background: var(--bg-surface); }
  th {
    text-align: left;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    padding: 0.7rem 1rem;
    border-bottom: 1.5px solid var(--border-light);
    background: var(--bg-surface);
    white-space: nowrap;
  }
  td {
    padding: 0.8rem 1rem;
    font-size: clamp(0.82rem, 0.88vw, 0.9rem);
    border-bottom: 1px solid var(--border-light);
    vertical-align: middle;
    color: var(--text-primary);
  }
  tr:last-child td { border-bottom: none; }
  tr:hover td { background: var(--bg-card-hover); transition: background 0.12s; }
  .td-patient { font-weight: 600; color: var(--text-secondary); }

  .status-chip {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 0.72rem;
    font-weight: 600;
    padding: 0.22rem 0.6rem;
    border-radius: 9999px;
    text-transform: capitalize;
    letter-spacing: 0.01em;
  }
  .status-chip.pendiente,
  .status-chip.pendiente_revision { background: #fffbeb; color: #92400e; }
  .status-chip.confirmada,
  .status-chip.reprogramada { background: #ecfdf5; color: #065f46; }
  .status-chip.aprobado,
  .status-chip.enviado,
  .status-chip.completada { background: #ecfdf5; color: #065f46; }
  .status-chip.rechazado,
  .status-chip.cancelada,
  .status-chip.no_show { background: #fff1f2; color: #be123c; }
  .status-chip.activo { background: #ecfdf5; color: #065f46; }
  .status-chip.agotado { background: #fff1f2; color: #be123c; }
  .status-chip.caducado { background: #f1f5f9; color: #475569; }
  .status-chip.anulado { background: #f1f5f9; color: #94a3b8; }
  .status-chip.emitida { background: #eff6ff; color: #1e40af; }
  .status-chip.pagada { background: #ecfdf5; color: #065f46; }

  .btn-sm {
    background: var(--bg-surface);
    color: var(--text-secondary);
    border: 1.5px solid var(--border);
    font: inherit;
    font-size: 0.84rem;
    font-weight: 600;
    padding: 6px 14px;
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: all var(--transition);
    white-space: nowrap;
  }
  .btn-sm:hover { color: var(--text-primary); border-color: var(--border-strong); background: var(--bg-card-hover); }
  .btn-sm:disabled { opacity: 0.5; cursor: not-allowed; }
  .table-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    justify-content: flex-end;
  }

  .empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 4rem 2rem;
    color: var(--text-muted);
    text-align: center;
  }
  .empty-state .material-symbols-rounded { 
    font-size: 48px; 
    margin-bottom: 1rem; 
    color: var(--border-light); 
  }
  .empty-state p {
    font-size: 1.05rem;
    font-weight: 500;
    margin: 0;
  }
  .state-loading .material-symbols-rounded {
    animation: spin 1.1s linear infinite;
  }

  @keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  /* === SPA SECTION STYLES === */
  .page-section {
    display: none;
    min-width: 0;
    animation: fadeIn 0.34s ease-out;
  }
  .page-section.active {
    display: block;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(5px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .page-header-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .page-tools {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .inline-field {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .inline-field select {
    min-width: 240px;
    max-width: 320px;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 0.36rem 0.5rem;
    color: var(--text-primary);
    font: inherit;
  }
  .inline-field select:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 4px var(--accent-soft);
  }
  
  .page-title {
    font-size: clamp(1.2rem, 1.5vw, 1.5rem);
    font-weight: 700;
    color: var(--text-primary);
    display: flex;
    align-items: center;
    gap: 0.5rem;
    letter-spacing: -0.02em;
  }

  /* === PAGOS === */
  .pagos-toolbar {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 1rem;
  }
  .pagos-summary-row {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  .pagos-stat {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }
  .pagos-stat-label {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
    font-weight: 600;
  }
  .pagos-stat-value {
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--text-primary);
  }
  .pagos-stat-cash .pagos-stat-value { color: #166534; }
  .pagos-stat-card .pagos-stat-value { color: #1e40af; }
  .pagos-filters-row {
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }
  .pagos-filters-row select {
    padding: 0.4rem 0.5rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    font-size: 0.85rem;
    background: var(--bg-surface);
  }
  .pagos-chip {
    display: inline-block;
    padding: 0.18rem 0.55rem;
    border-radius: 999px;
    font-size: 0.76rem;
    font-weight: 600;
  }
  .pagos-chip-cash { background: #dcfce7; color: #166534; }
  .pagos-chip-card { background: #dbeafe; color: #1e40af; }
  .text-right { text-align: right; }
  .btn-danger-outline {
    color: #dc2626;
    border-color: #fca5a5;
    font-size: 1.1rem;
    line-height: 1;
    padding: 0.2rem 0.5rem;
  }
  .btn-danger-outline:hover { background: #fee2e2; }

  /* Pago patient select */
  #pagoPacienteSelect {
    width: 100%;
    padding: 0.5rem 0.6rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    font-size: 0.9rem;
    background: var(--bg-surface);
  }

  /* Method toggle in modal */
  .pagos-metodo-toggle {
    display: flex;
    gap: 0.5rem;
  }
  .pagos-toggle-opt {
    cursor: pointer;
  }
  .pagos-toggle-opt input { display: none; }
  .pagos-toggle-opt .pagos-chip {
    padding: 0.4rem 0.9rem;
    font-size: 0.85rem;
    opacity: 0.45;
    transition: opacity 0.15s;
    border: 2px solid transparent;
  }
  .pagos-toggle-opt input:checked + .pagos-chip {
    opacity: 1;
    border-color: currentColor;
  }

  /* === BONOS === */
  .bono-progress { display: flex; flex-direction: column; gap: 0.3rem; }
  .bono-bar { height: 6px; background: var(--border); border-radius: 99px; width: 120px; }
  .bono-bar-fill { height: 100%; background: var(--accent); border-radius: 99px; transition: width 0.3s; }

  /* === FIRMA DIGITAL === */
  .modal-panel-wide { max-width: 720px; }
  .firma-doc-contenido {
    max-height: 220px;
    overflow-y: auto;
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 1rem;
    font-size: 0.85rem;
    line-height: 1.6;
    white-space: pre-wrap;
    color: var(--text-secondary);
    margin: 0 0 1rem;
  }
  .firma-pad-section { margin-bottom: 1rem; }
  .firma-pad-label { font-weight: 600; font-size: 0.9rem; margin-bottom: 0.4rem; }
  .firma-pad-hint { font-weight: 400; font-size: 0.8rem; color: var(--text-muted); }
  .firma-pad-wrap {
    border: 2px dashed var(--border);
    border-radius: var(--radius-sm);
    background: #fff;
    cursor: crosshair;
    display: inline-block;
    width: 100%;
  }
  .firma-pad-wrap canvas { display: block; width: 100%; height: 160px; }
  .firma-status-hint { font-size: 0.8rem; color: var(--text-muted); align-self: center; }
  .ficha-docs-list { padding: 0.5rem 1rem 1rem; }
  .ficha-doc-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--border);
  }
  .ficha-doc-card:last-child { border-bottom: none; }
  .ficha-doc-icon { font-size: 1.6rem; color: var(--accent); }
  .ficha-doc-info { flex: 1; }
  .ficha-doc-title { font-weight: 600; font-size: 0.92rem; }
  .ficha-doc-meta { font-size: 0.78rem; color: var(--text-muted); margin-top: 0.1rem; }
  .ficha-doc-actions { display: flex; gap: 0.4rem; }

  /* === FACTURACION === */
  .factura-preview {
    margin: 1rem 0;
    padding: 1rem;
    background: var(--bg-surface);
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
  }
  .factura-preview .table-wrap { margin-top: 0.5rem; }
  .factura-preview table { font-size: 0.85rem; }

  /* === FICHA PACIENTE === */
  .ficha-tabs {
    display: flex;
    gap: 0;
    border-bottom: 2px solid var(--border);
    margin-bottom: 1.2rem;
  }
  .ficha-tab {
    padding: 0.65rem 1.2rem;
    border: none;
    background: none;
    font: inherit;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--text-muted);
    cursor: pointer;
    border-bottom: 2px solid transparent;
    margin-bottom: -2px;
    transition: color 0.15s, border-color 0.15s;
  }
  .ficha-tab:hover { color: var(--text-primary); }
  .ficha-tab.active {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }
  .ficha-panel { display: none; }
  .ficha-panel.active { display: block; }

  .ficha-datos-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 1rem;
    padding: 1rem;
  }
  .ficha-dato {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .ficha-dato-label {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--text-muted);
    font-weight: 600;
  }
  .ficha-dato-value {
    font-size: 0.95rem;
    color: var(--text-primary);
    min-height: 1.4em;
  }
  .ficha-dato-value:empty::after { content: '—'; color: var(--text-muted); }
  .ficha-dato-full { grid-column: 1 / -1; }

  .ficha-form-actions {
    grid-column: 1 / -1;
    display: flex;
    justify-content: flex-end;
    gap: 0.5rem;
    padding-top: 0.5rem;
  }

  /* Timeline notas */
  .ficha-timeline {
    padding: 0.5rem 1rem 1rem;
  }
  .ficha-nota-card {
    border-left: 3px solid var(--accent);
    padding: 0.8rem 1rem;
    margin-bottom: 1rem;
    background: var(--bg-surface);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    position: relative;
  }
  .ficha-nota-header {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    margin-bottom: 0.4rem;
    flex-wrap: wrap;
  }
  .ficha-nota-date {
    font-weight: 700;
    font-size: 0.88rem;
    color: var(--text-primary);
  }
  .ficha-nota-zona {
    font-size: 0.75rem;
    background: var(--accent-soft);
    color: var(--accent);
    padding: 0.15rem 0.5rem;
    border-radius: 99px;
    font-weight: 600;
  }
  .ficha-nota-eva {
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.15rem 0.5rem;
    border-radius: 99px;
  }
  .eva-low { background: #dcfce7; color: #166534; }
  .eva-mid { background: #fef9c3; color: #854d0e; }
  .eva-high { background: #fee2e2; color: #991b1b; }
  .ficha-nota-text {
    font-size: 0.88rem;
    color: var(--text-secondary);
    white-space: pre-wrap;
    line-height: 1.5;
  }
  .ficha-nota-pruebas {
    margin-top: 0.4rem;
    font-size: 0.82rem;
    color: var(--text-muted);
    font-style: italic;
  }
  .ficha-nota-actions {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    display: flex;
    gap: 0.3rem;
  }
  .ficha-nota-actions button {
    background: none;
    border: none;
    cursor: pointer;
    color: var(--text-muted);
    font-size: 1.1rem;
    padding: 0.2rem;
    border-radius: 4px;
  }
  .ficha-nota-actions button:hover { color: var(--accent); background: var(--accent-soft); }

  .ficha-pagos-total {
    padding: 0.8rem 1rem;
    font-weight: 700;
    font-size: 1rem;
    text-align: right;
    color: var(--text-primary);
  }

  .empty-inline {
    text-align: center;
    color: var(--text-muted);
    padding: 2rem;
    font-size: 0.9rem;
  }

  /* === GESTORIA === */
  .gestoria-table-wrap {
    overflow-x: auto;
  }
  .gestoria-table {
    min-width: 1000px;
  }
  .gestoria-col-patient {
    min-width: 150px;
    position: sticky;
    left: 0;
    background: var(--bg-card);
    z-index: 1;
  }
  .gestoria-patient-name {
    position: sticky;
    left: 0;
    background: var(--bg-card);
    z-index: 1;
    white-space: nowrap;
  }
  .gestoria-col-mes { min-width: 65px; font-size: 0.82rem; }
  .gestoria-col-total, .gestoria-col-efe, .gestoria-col-tar { min-width: 80px; }
  .gestoria-cell-empty { color: #cbd5e1; }
  .gestoria-cell-filled { cursor: default; }
  .gestoria-efe { color: #166534; }
  .gestoria-tar { color: #1e40af; }
  .gestoria-totals-row {
    background: #f8fafc;
    border-top: 2px solid var(--border);
  }
  .gestoria-totals-row td { padding-top: 0.75rem; }
  .gestoria-mes-select {
    padding: 0.4rem 0.5rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    font-size: 0.85rem;
    background: var(--bg-surface);
  }
  .gestoria-mes-totals {
    display: flex;
    gap: 1rem;
    padding: 0.7rem 1.25rem;
    flex-wrap: wrap;
    border-bottom: 1px solid var(--border);
    background: #f8fafc;
  }
  .gestoria-mes-chip {
    font-size: 0.85rem;
    color: var(--text-muted);
  }
  .gestoria-mes-chip strong { color: var(--text-primary); }
  .gestoria-mes-cash strong { color: #166534; }
  .gestoria-mes-card strong { color: #1e40af; }

  /* === CONFIG GRID === */
  .config-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
    gap: 1.5rem;
  }
  
  .config-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 0;
    border-bottom: 1px solid var(--border);
  }
  .config-item:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }
  
  .config-label {
    font-size: 0.9rem;
    color: var(--text-muted);
    font-weight: 500;
  }
  
  .config-value {
    font-size: 0.9rem;
    color: var(--text-primary);
    font-family: monospace;
    background: var(--bg-elevated);
    padding: 0.2rem 0.5rem;
    border-radius: var(--radius-sm);
  }
  
  .config-link {
    color: var(--accent);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
  }
  .config-link:hover {
    text-decoration: underline;
  }

  .btn-primary {
    background: linear-gradient(135deg, #0d9488 0%, #0ea5e9 100%);
    color: #fff;
    border: none;
    border-radius: var(--radius-md);
    padding: 0.62rem 1rem;
    font: inherit;
    font-size: clamp(0.8rem, 0.85vw, 0.88rem);
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    box-shadow: 0 4px 12px -2px rgba(13, 148, 136, 0.35);
    cursor: pointer;
    transition: transform var(--transition), box-shadow var(--transition);
    white-space: nowrap;
    letter-spacing: 0.01em;
  }
  .btn-primary:hover {
    transform: translateY(-1px);
    box-shadow: 0 6px 18px -2px rgba(13, 148, 136, 0.45);
  }
  .btn-primary:active {
    transform: translateY(0);
    box-shadow: 0 2px 8px -2px rgba(13, 148, 136, 0.30);
  }

  .detail-block {
    padding: 1rem 1.1rem;
    border-bottom: 1px solid var(--border);
  }
  .detail-block:last-child {
    border-bottom: none;
  }
  .detail-block-spotlight {
    background: linear-gradient(180deg, rgba(240, 253, 250, 0.96), rgba(248, 250, 252, 0.98));
    box-shadow: inset 0 0 0 1px rgba(20, 184, 166, 0.18), 0 0 0 4px rgba(20, 184, 166, 0.08);
    transition: box-shadow 0.2s ease, background 0.2s ease;
  }
  .detail-block h3 {
    font-size: 0.95rem;
    margin-bottom: 0.4rem;
  }
  .detail-block p {
    margin: 0;
    color: var(--text-secondary);
    font-size: 0.88rem;
  }
  .detail-caption {
    margin-top: 0.35rem;
    color: var(--text-muted);
    font-size: 0.84rem;
    line-height: 1.45;
  }
  .telegram-link-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.85rem;
  }
  .telegram-link-card {
    display: grid;
    gap: 0.75rem;
    padding: 0.9rem 1rem;
    border-radius: var(--radius-md);
    border: 1px solid rgba(14, 165, 233, 0.16);
    background: linear-gradient(180deg, rgba(240, 249, 255, 0.92), rgba(248, 250, 252, 0.98));
  }
  .telegram-link-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 0.55rem 1rem;
  }
  .telegram-link-grid p {
    margin: 0;
    font-size: 0.84rem;
    color: var(--text-secondary);
  }
  .telegram-link-command {
    padding: 0.75rem 0.85rem;
    border-radius: 0.85rem;
    background: rgba(15, 23, 42, 0.92);
    overflow-x: auto;
  }
  .telegram-link-command code {
    color: #e2e8f0;
    font-size: 0.84rem;
    white-space: nowrap;
  }
  .telegram-link-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
  }
  .telegram-link-error {
    color: #991b1b;
  }
  .history-note-form {
    margin-top: 0.85rem;
    display: grid;
    gap: 0.8rem;
  }
  .history-note-field {
    display: grid;
    gap: 0.42rem;
  }
  .history-note-field span {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--text-secondary);
  }
  .history-note-field textarea {
    width: 100%;
    min-height: 120px;
    resize: vertical;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: #fff;
    color: var(--text-primary);
    font: inherit;
    padding: 0.85rem 0.95rem;
    transition: border-color var(--transition), box-shadow var(--transition);
  }
  .history-note-field textarea:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 4px var(--accent-soft);
  }
  .history-note-feedback {
    margin: 0;
    padding: 0.8rem 0.9rem;
    border-radius: 0.95rem;
    border: 1px solid rgba(59, 130, 246, 0.18);
    background: rgba(59, 130, 246, 0.08);
    color: var(--text-secondary);
    font-size: 0.84rem;
  }
  .history-note-feedback[data-state="error"] {
    border-color: rgba(239, 68, 68, 0.22);
    background: rgba(239, 68, 68, 0.08);
    color: #991b1b;
  }
  .history-note-feedback[data-state="success"] {
    border-color: rgba(16, 185, 129, 0.24);
    background: rgba(16, 185, 129, 0.1);
    color: #065f46;
  }
  .history-note-actions {
    display: flex;
    justify-content: flex-end;
  }
  .btn-history-note {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .detail-list {
    margin: 0;
    padding-left: 1rem;
    display: grid;
    gap: 0.45rem;
    color: var(--text-secondary);
    font-size: 0.85rem;
  }
  .detail-empty {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.85rem;
  }
  .recommendation-list {
    display: grid;
    gap: 0.7rem;
  }
  .recommendation-card {
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 0.75rem;
    background: linear-gradient(180deg, #ffffff, #f8fafc);
    display: grid;
    gap: 0.55rem;
  }
  .recommendation-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .recommendation-head h4 {
    margin: 0;
    font-size: 0.9rem;
    color: var(--text-primary);
  }
  .recommendation-head p {
    margin-top: 0.2rem;
    margin-bottom: 0;
    font-size: 0.78rem;
    color: var(--text-muted);
  }
  .recommendation-chips {
    display: flex;
    gap: 0.35rem;
    flex-wrap: wrap;
    justify-content: flex-end;
  }
  .recommendation-note {
    margin: 0;
    font-size: 0.82rem;
    color: var(--text-secondary);
  }
  .recommendation-section h5 {
    margin: 0 0 0.25rem;
    font-size: 0.8rem;
    color: var(--accent);
  }
  .recommendation-exercises {
    margin: 0;
    padding-left: 1rem;
    display: grid;
    gap: 0.22rem;
    color: var(--text-secondary);
    font-size: 0.8rem;
  }

  :global(body.has-modal-open) {
    overflow: hidden;
  }
  .modal-shell {
    position: fixed;
    inset: 0;
    z-index: 140;
    display: none;
    align-items: center;
    justify-content: center;
    padding: clamp(0.75rem, 3vw, 1.5rem);
    background: rgba(8, 15, 35, 0.48);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }
  .modal-shell.open {
    display: flex;
  }
  .modal-panel {
    width: min(100%, 580px);
    background: var(--bg-card);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-xl);
    overflow: hidden;
    max-height: calc(100vh - 3rem);
    overflow-y: auto;
  }
  .modal-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.25rem 1.5rem 1rem;
    border-bottom: 1px solid var(--border-light);
    background: linear-gradient(135deg, rgba(13, 148, 136, 0.06), rgba(14, 165, 233, 0.04));
    position: sticky;
    top: 0;
    z-index: 1;
  }
  .modal-title-group {
    display: grid;
    gap: 0.3rem;
  }
  .modal-title-group h2 {
    margin: 0;
    font-size: 1.2rem;
    color: var(--text-primary);
  }
  .modal-title-group p {
    margin: 0;
    color: var(--text-secondary);
    font-size: 0.9rem;
    line-height: 1.45;
  }
  .modal-eyebrow {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .modal-close {
    border: 1px solid var(--border);
    background: rgba(255, 255, 255, 0.8);
    color: var(--text-secondary);
    width: 40px;
    height: 40px;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: transform var(--transition), border-color var(--transition), color var(--transition);
  }
  .modal-close:hover {
    transform: translateY(-1px);
    color: var(--accent);
    border-color: var(--accent);
  }
  .patient-form {
    display: grid;
    gap: 1rem;
    padding: 1.25rem 1.5rem 1.4rem;
  }
  .form-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.9rem;
  }
  .field {
    display: grid;
    gap: 0.4rem;
  }
  .field-full {
    grid-column: 1 / -1;
  }
  .field span {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-secondary);
    letter-spacing: 0.01em;
  }
  .field input {
    width: 100%;
    border: 1.5px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--bg-surface);
    color: var(--text-primary);
    min-height: 44px;
    padding: 0.7rem 0.9rem;
    font: inherit;
    font-size: 0.9rem;
    transition: border-color var(--transition), box-shadow var(--transition), background var(--transition);
  }
  .field input:focus {
    outline: none;
    border-color: var(--accent);
    background: #fff;
    box-shadow: 0 0 0 3px var(--accent-soft);
  }
  .field input:hover:not(:focus) {
    border-color: var(--border-strong);
  }
  /* === AGENDA SEMANAL === */
  .week-nav-bar {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    flex-shrink: 0;
    flex-wrap: nowrap;
  }
  .week-label {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-primary);
    min-width: 160px;
    text-align: center;
  }
  .agenda-cal-card { padding: 0; overflow: hidden; }
  .agenda-calendar { width: 100%; overflow-x: auto; }
  .agenda-cal-loading {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 2rem;
    color: var(--text-secondary);
    font-size: 0.9rem;
  }
  .agenda-cal-grid {
    display: grid;
    grid-template-columns: 52px repeat(5, 1fr);
    border-top: 1px solid var(--border);
    border-left: 1px solid var(--border);
    min-width: 560px;
  }
  .agenda-cal-grid > * {
    border-right: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }
  .agenda-cal-time-header { background: var(--bg-surface); }
  .agenda-cal-day-header {
    background: var(--bg-surface);
    padding: 0.6rem 0.4rem;
    text-align: center;
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--text-secondary);
    text-transform: capitalize;
  }
  .agenda-cal-day-header.today {
    background: var(--accent-soft);
    color: var(--accent);
  }
