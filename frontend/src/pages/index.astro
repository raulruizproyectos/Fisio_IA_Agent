  const renderDashboardCitas = (citas: any[], mode: 'ready' | 'error' = 'ready') => {
    if (!dashCitasBody) return;
    if (mode === 'error') {
      dashboardRuntime.agendaState = 'error';
      dashboardRuntime.weekAppointments = [];
      dashboardRuntime.todayAppointments = [];
      dashboardRuntime.nextAppointment = null;
      syncDashboardCommandCenter();
      setListState(dashCitasBody, 'cloud_off', 'No se pudo cargar la agenda.');
      return;
    }

    const activeAppointments = getDashboardActiveAppointments(citas);
    const now = Date.now();
    dashboardRuntime.agendaState = 'ready';
    dashboardRuntime.weekAppointments = activeAppointments;
    dashboardRuntime.todayAppointments = activeAppointments.filter((c: any) => isTodayDate(c.inicio_en || ''));
    dashboardRuntime.nextAppointment = activeAppointments.find((c: any) => new Date(c.inicio_en).getTime() >= now) || activeAppointments[0] || null;
    syncDashboardCommandCenter();

    if (!citas.length) {
      setListState(dashCitasBody, 'event_available', 'Sin citas agendadas por ahora.');
      return;
    }

    const todayStr = new Date().toDateString();
    const todayCitas = citas.filter((c: any) => c.inicio_en && new Date(c.inicio_en).toDateString() === todayStr);
    const upcomingCitas = citas.filter((c: any) => !c.inicio_en || new Date(c.inicio_en).toDateString() !== todayStr).slice(0, 4);

    const renderItem = (cita: any, isToday: boolean) => {
      const stateClass = String(cita.estado || 'pendiente')
        .toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-z0-9_ -]/g, '').trim().replace(/\s+/g, '_') || 'pendiente';
      const hora = cita.inicio_en ? new Date(cita.inicio_en).toLocaleTimeString('es-ES', { hour: '2-digit', minute: '2-digit', timeZone: 'Europe/Madrid' }) : '';
      return `<article class="clean-list-item${isToday ? ' cita-today' : ''}">
