---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Fisio IA Agent — CRM Clínico Inteligente">
  <div class="app-shell">
    <!-- SIDEBAR -->
    <aside class="sidebar" id="sidebar">
      <div class="sidebar-brand">
        <div class="brand-icon-wrapper">
          <span class="brand-icon material-symbols-rounded">medical_services</span>
        </div>
        <span class="brand-text">FisioPlatform</span>
      </div>

      <nav class="sidebar-nav">
        <a href="#" class="nav-item active" data-section="dashboard">
          <span class="material-symbols-rounded">home</span>
          <span class="nav-label">Inicio</span>
        </a>
        <a href="#" class="nav-item" data-section="pacientes">
          <span class="material-symbols-rounded">group</span>
          <span class="nav-label">Pacientes</span>
        </a>
        <a href="#" class="nav-item" data-section="citas">
          <span class="material-symbols-rounded">calendar_today</span>
          <span class="nav-label">Agenda</span>
        </a>
        <a href="#" class="nav-item" data-section="dashboard" onclick="document.getElementById('agentForm').scrollIntoView({behavior: 'smooth'})" style="color: var(--accent);">
          <span class="material-symbols-rounded">psychology</span>
          <span class="nav-label">IA Clínica</span>
        </a>
        <a href="#" class="nav-item" data-section="plantillas">
          <span class="material-symbols-rounded">prescriptions</span>
          <span class="nav-label">Plantillas</span>
        </a>
      </nav>

      <div class="sidebar-bottom">
        <div class="divider"></div>
        <a href="#" class="nav-item has-badge" data-section="intakes">
          <span class="material-symbols-rounded">forward_to_inbox</span>
          <span class="nav-label">Mensajes Intake</span>
          <span class="badge" id="intakeBadge">0</span>
        </a>
        <a href="#" class="nav-item" data-section="historial">
          <span class="material-symbols-rounded">folder_open</span>
          <span class="nav-label">Historial</span>
        </a>
        <a href="#" class="nav-item" data-section="config">
          <span class="material-symbols-rounded">settings</span>
          <span class="nav-label">Ajustes</span>
        </a>
      </div>
    </aside>
    <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

    <!-- MAIN -->
    <div class="main-area">
      <!-- HEADER -->
      <header class="topbar">
        <button class="sidebar-toggle" id="sidebarToggle" aria-label="Menú">
          <span class="material-symbols-rounded">menu</span>
        </button>
        <div class="search-box">
          <span class="material-symbols-rounded search-icon">search</span>
          <input type="text" id="searchInput" placeholder="Buscar paciente, dolencia, ejercicio..." autocomplete="off" />
        </div>
        <div class="topbar-right">
          <button class="icon-btn" aria-label="Notificaciones" id="notifBtn">
            <span class="material-symbols-rounded">notifications</span>
            <span class="dot-indicator"></span>
          </button>
          <div class="user-pill">
            <div class="avatar">RR</div>
            <span class="user-name">Dr. Raúl Ruiz</span>
          </div>
        </div>
      </header>

      <!-- CONTENT -->
      <main class="content">
        <!-- === PAGE: DASHBOARD === -->
        <div class="page-section active" data-page="dashboard">
          <div class="dashboard-layout">
            
            <!-- Hero Section -->
            <section class="hero-section">
              <div class="hero-content">
                <h1 class="hero-title">Panel clínico de hoy</h1>
                <p class="hero-subtitle">Supervisa pacientes, agenda y recomendaciones IA con trazabilidad clínica en tiempo real.</p>
              </div>
              <div class="hero-actions">
                <button class="btn-primary" onclick="document.getElementById('agentInput').focus()"><span class="material-symbols-rounded">psychology</span> Nueva recomendación</button>
              </div>
            </section>

            <!-- Metrics -->
            <section class="metrics-row clinical-metrics">
              <div class="metric-card"><div class="metric-icon" style="background: rgba(15, 118, 110, 0.1); color: var(--accent);"><span class="material-symbols-rounded">group</span></div><div class="metric-data"><span class="metric-value" id="metricPacientes">—</span><span class="metric-label">Pacientes Activos</span></div></div>
              <div class="metric-card"><div class="metric-icon" style="background: rgba(16, 185, 129, 0.1); color: var(--success);"><span class="material-symbols-rounded">event_available</span></div><div class="metric-data"><span class="metric-value" id="metricSesiones">—</span><span class="metric-label">Citas Hoy</span></div></div>
              <div class="metric-card"><div class="metric-icon" style="background: rgba(59, 130, 246, 0.1); color: var(--info);"><span class="material-symbols-rounded">description</span></div><div class="metric-data"><span class="metric-value" id="metricInformes">0</span><span class="metric-label">Informes IA archivados</span></div></div>
              <div class="metric-card"><div class="metric-icon" style="background: rgba(245, 158, 11, 0.12); color: var(--warning);"><span class="material-symbols-rounded">monitoring</span></div><div class="metric-data"><span class="metric-value" id="metricEngineOps">0/0</span><span class="metric-label">Timeouts / Reintentos IA</span></div></div>
            </section>

            <!-- IA Module (Central) -->
            <section class="ai-clinical-module card">
              <header class="module-header">
                <div class="module-title">
                  <span class="material-symbols-rounded accent-icon">psychology</span>
                  <h2>Asistente clínico IA</h2>
                </div>
                <div class="agent-status-pill">
                  <span class="status-dot connected" id="agentDot"></span>
                  <span class="status-text" id="agentStatusText">Conectado</span>
                </div>
              </header>
              
              <div class="ai-workspace">
                <div class="chat-log" id="chatLog">
                  <article class="msg agent">
                    <div class="msg-avatar"><span class="material-symbols-rounded">medical_information</span></div>
                    <div class="msg-body">
                      <span class="msg-sender">Asistente Clínico</span>
                      <p>Listo para ayudarte. Selecciona un paciente, describe síntomas y obtendrás un plan terapéutico estructurado.</p>
                    </div>
                  </article>
                </div>
                
                <form id="agentForm" class="ai-input-area">
                  <div class="ai-controls">
                    <div class="patient-selector">
                      <span class="material-symbols-rounded">person</span>
                      <select id="chatPatientSelect" aria-label="Paciente del informe">
                        <option value="">Selecciona paciente para informe...</option>
                      </select>
                    </div>
                  </div>
                  <div class="ai-textarea-wrapper">
                    <textarea id="agentInput" rows="3" placeholder="Ejemplo: Dolor lumbar crónico de 2 meses, sin red flags, empeora al final del día."></textarea>
                    <div class="ai-actions">
                      <div class="action-buttons">
                        <button type="button" class="btn-action btn-pdf" id="exercisePdfBtn" aria-label="Descargar PDF" title="Exportar a PDF"><span class="material-symbols-rounded">picture_as_pdf</span> Guardar PDF</button>
                        <button type="button" class="btn-action btn-generate" id="exerciseRecoBtn" aria-label="Generar Plan de Ejercicios"><span class="material-symbols-rounded">electric_bolt</span> Generar Plan</button>
                        <button type="submit" class="btn-action btn-chat" id="sendBtn" aria-label="Preguntar a IA" title="Pregunta general (Chat)"><span class="material-symbols-rounded">chat</span></button>
                      </div>
                    </div>
                  </div>
                </form>
              </div>
            </section>

            <!-- Bottom Row: Citas y Actividad -->
            <div class="dashboard-bottom-row">
              <section class="card widget-card">
                <header class="card-header">
                  <h2>Agenda inmediata</h2>
                  <button class="btn-ghost" onclick="document.querySelector('[data-section=\'citas\']').click()"><span class="material-symbols-rounded">arrow_forward</span> Ver todas</button>
                </header>
                <div class="widget-body list-clean" id="dashCitasBody">
                  <div class="empty-state-sm state-loading">
                    <span class="material-symbols-rounded">sync</span>
                    <p>Actualizando agenda...</p>
                  </div>
                </div>
              </section>
              
              <section class="card widget-card">
                <header class="card-header">
                  <h2>Mensajes de pacientes</h2>
                  <button class="btn-ghost" id="refreshIntakes"><span class="material-symbols-rounded">refresh</span></button>
                </header>
                <div class="widget-body list-clean" id="intakeBody">
                  <div class="empty-state-sm state-loading">
                    <span class="material-symbols-rounded">sync</span>
                    <p>Actualizando bandeja...</p>
                  </div>
                </div>
              </section>
            </div>

          </div>
        </div>

        <!-- === PAGE: PACIENTES === -->
        <div class="page-section" data-page="pacientes">
          <div class="page-header-row">
            <h1 class="page-title"><span class="material-symbols-rounded">group</span> Pacientes</h1>
            <button class="btn-primary" id="addPatientBtn"><span class="material-symbols-rounded">person_add</span> Nuevo paciente</button>
          </div>
          <section class="card table-card">
            <header class="card-header"><h2>Lista de pacientes</h2><button class="btn-ghost" id="refreshPacientes"><span class="material-symbols-rounded">refresh</span> Actualizar</button></header>
            <div class="table-wrap"><table><thead><tr><th>Nombre</th><th>Email</th><th>Fecha nac.</th><th>Registro</th><th>Acciones</th></tr></thead><tbody id="pacientesBody"><tr class="empty-row"><td colspan="5"><div class="empty-state"><span class="material-symbols-rounded">hourglass_empty</span><p>Cargando pacientes...</p></div></td></tr></tbody></table></div>
          </section>
        </div>

        <!-- === PAGE: PLANTILLAS === -->
        <div class="page-section" data-page="plantillas">
          <div class="page-header-row">
            <h1 class="page-title"><span class="material-symbols-rounded">library_books</span> Plantillas Terapéuticas</h1>
            <div class="page-tools">
              <label class="inline-field">
                <span>Paciente destino</span>
                <select id="templateTargetPatient">
                  <option value="">Selecciona paciente</option>
                </select>
              </label>
              <button class="btn-ghost" id="refreshTemplates"><span class="material-symbols-rounded">refresh</span> Actualizar</button>
            </div>
          </div>
          <section class="card table-card">
            <header class="card-header"><h2>Plantillas más reutilizadas</h2></header>
            <div class="table-wrap">
              <table>
                <thead>
                  <tr>
                    <th>Título</th>
                    <th>Usos</th>
                    <th>Ejercicios</th>
                    <th>Último uso</th>
                    <th>Origen</th>
                    <th>Acción</th>
                  </tr>
                </thead>
                <tbody id="templatesBody">
                  <tr class="empty-row">
                    <td colspan="6">
                      <div class="empty-state">
                        <span class="material-symbols-rounded">hourglass_empty</span>
                        <p>Cargando plantillas...</p>
                      </div>
                    </td>
                  </tr>
                </tbody>
              </table>
            </div>
          </section>
        </div>

        <!-- === PAGE: INTAKES === -->
        <div class="page-section" data-page="intakes">
          <div class="page-header-row">
            <h1 class="page-title"><span class="material-symbols-rounded">assignment</span> Intakes Pendientes</h1>
          </div>
          <section class="card table-card">
            <header class="card-header"><h2>Mensajes de ingesta por revisar</h2><button class="btn-ghost" id="refreshIntakesFull"><span class="material-symbols-rounded">refresh</span> Actualizar</button></header>
            <div class="table-wrap"><table><thead><tr><th>Paciente</th><th>Fuente</th><th>Mensaje</th><th>Alertas</th><th>Fecha</th><th>Estado</th><th>Acciones</th></tr></thead><tbody id="intakesFullBody"><tr class="empty-row"><td colspan="7"><div class="empty-state"><span class="material-symbols-rounded">hourglass_empty</span><p>Cargando intakes...</p></div></td></tr></tbody></table></div>
          </section>
        </div>

        <!-- === PAGE: CITAS === -->
        <div class="page-section" data-page="citas">
          <div class="page-header-row">
            <h1 class="page-title"><span class="material-symbols-rounded">calendar_month</span> Citas</h1>
          </div>
          <section class="card table-card">
            <header class="card-header"><h2>Agenda del fisioterapeuta</h2><button class="btn-ghost" id="refreshCitas"><span class="material-symbols-rounded">refresh</span> Actualizar</button></header>
            <div class="table-wrap"><table><thead><tr><th>Paciente</th><th>Inicio</th><th>Fin</th><th>Estado</th><th>Motivo</th><th>Acciones</th></tr></thead><tbody id="citasBody"><tr class="empty-row"><td colspan="6"><div class="empty-state"><span class="material-symbols-rounded">hourglass_empty</span><p>Cargando citas...</p></div></td></tr></tbody></table></div>
          </section>
        </div>

        <!-- === PAGE: HISTORIAL === -->
        <div class="page-section" data-page="historial">
          <div class="page-header-row">
            <h1 class="page-title"><span class="material-symbols-rounded">history</span> Historial</h1>
          </div>
          <section class="card">
            <header class="card-header"><h2>Notas de seguimiento</h2><button class="btn-ghost" id="refreshHistorial"><span class="material-symbols-rounded">refresh</span> Actualizar</button></header>
            <div id="historialContent" class="section-body"><div class="empty-state"><span class="material-symbols-rounded">history</span><p>Selecciona un paciente para ver su historial</p></div></div>
          </section>
        </div>

        <!-- === PAGE: CONFIG === -->
        <div class="page-section" data-page="config">
          <div class="page-header-row">
            <h1 class="page-title"><span class="material-symbols-rounded">settings</span> Configuración</h1>
          </div>
          <div class="config-grid">
            <section class="card">
              <header class="card-header"><h2>Conexiones</h2></header>
              <div class="section-body">
                <div class="config-item"><span class="config-label">Backend API</span><span class="config-value" id="cfgBackend">—</span><span class="status-chip" id="cfgBackendStatus">—</span></div>
                <div class="config-item"><span class="config-label">Agente n8n</span><span class="config-value" id="cfgAgent">—</span><span class="status-chip" id="cfgAgentStatus">—</span></div>
              </div>
            </section>
            <section class="card">
              <header class="card-header"><h2>Proyecto</h2></header>
              <div class="section-body">
                <div class="config-item"><span class="config-label">Versión</span><span class="config-value">0.0.1</span></div>
                <div class="config-item"><span class="config-label">Stack</span><span class="config-value">Astro + Express + Supabase + n8n</span></div>
                <div class="config-item"><span class="config-label">Repositorio</span><a href="https://github.com/raulruizproyectos/Fisio_IA_Agent" target="_blank" class="config-link">GitHub ↗</a></div>
              </div>
            </section>
          </div>
        </div>
      </main>
    </div>
  </div>
</Layout>

<script>
  // === CONFIG ===
  const BACKEND_BASE = (window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1')
    ? 'http://localhost:3001'
    : 'https://fisio-backend.b5xbaf.easypanel.host';
  const PROF_ID = '4a194ec4-3580-4246-9452-0852b589fd63';

  // === DOM REFS ===
  const form = document.getElementById('agentForm') as HTMLFormElement | null;
  const input = document.getElementById('agentInput') as HTMLTextAreaElement | null;
  const log = document.getElementById('chatLog') as HTMLElement | null;
  const sendBtn = document.getElementById('sendBtn') as HTMLButtonElement | null;
  const exerciseBtn = document.getElementById('exerciseRecoBtn') as HTMLButtonElement | null;
  const exercisePdfBtn = document.getElementById('exercisePdfBtn') as HTMLButtonElement | null;
  const agentDot = document.getElementById('agentDot') as HTMLElement | null;
  const agentStatusText = document.getElementById('agentStatusText') as HTMLElement | null;
  const metricEngineOps = document.getElementById('metricEngineOps') as HTMLElement | null;
  const sidebarToggle = document.getElementById('sidebarToggle') as HTMLElement | null;
  const sidebar = document.getElementById('sidebar') as HTMLElement | null;
  const inputArea = document.querySelector('.ai-input-area') as HTMLElement | null;
  const dashCitasBody = document.getElementById('dashCitasBody') as HTMLElement | null;
  const intakeBody = document.getElementById('intakeBody') as HTMLElement | null;
  const refreshBtn = document.getElementById('refreshIntakes') as HTMLElement | null;
  const pacientesBody = document.getElementById('pacientesBody') as HTMLElement | null;
  const templatesBody = document.getElementById('templatesBody') as HTMLElement | null;
  const templateTargetPatient = document.getElementById('templateTargetPatient') as HTMLSelectElement | null;
  const chatPatientSelect = document.getElementById('chatPatientSelect') as HTMLSelectElement | null;
  const intakesFullBody = document.getElementById('intakesFullBody') as HTMLElement | null;
  const citasBody = document.getElementById('citasBody') as HTMLElement | null;
  const historialContent = document.getElementById('historialContent') as HTMLElement | null;

  // === HELPERS ===
  const MOJIBAKE_RE = /(?:\u00C3|\u00C2|\u00E2|\u00F0|\u00D0|\u00D1|\uFFFD|\u0153|\u0152|\u0161|\u0178|\u00EF\u00BF\u00BD)/;
  const CP1252_UNICODE_TO_BYTE: Record<number, number> = {
    0x20ac: 0x80,
    0x201a: 0x82,
    0x0192: 0x83,
    0x201e: 0x84,
    0x2026: 0x85,
    0x2020: 0x86,
    0x2021: 0x87,
    0x02c6: 0x88,
    0x2030: 0x89,
    0x0160: 0x8a,
    0x2039: 0x8b,
    0x0152: 0x8c,
    0x017d: 0x8e,
    0x2018: 0x91,
    0x2019: 0x92,
    0x201c: 0x93,
    0x201d: 0x94,
    0x2022: 0x95,
    0x2013: 0x96,
    0x2014: 0x97,
    0x02dc: 0x98,
    0x2122: 0x99,
    0x0161: 0x9a,
    0x203a: 0x9b,
    0x0153: 0x9c,
    0x017e: 0x9e,
    0x0178: 0x9f,
  };
  const toLegacyBytes = (text: string) => {
    const bytes: number[] = [];
    for (const ch of text) {
      const code = ch.codePointAt(0) ?? 0;
      if (code <= 0xff) {
        bytes.push(code);
        continue;
      }
      const mapped = CP1252_UNICODE_TO_BYTE[code];
      if (typeof mapped === 'number') {
        bytes.push(mapped);
        continue;
      }
      return null;
    }
    return new Uint8Array(bytes);
  };
  const decodeUtf8Bytes = (bytes: Uint8Array) => {
    try {
      return new TextDecoder('utf-8', { fatal: true }).decode(bytes);
    } catch {
      try {
        return new TextDecoder('utf-8').decode(bytes);
      } catch {
        return '';
      }
    }
  };
  const maybeDecodeMojibake = (value: unknown) => {
    let current = String(value ?? '');
    if (!MOJIBAKE_RE.test(current)) return current;

    for (let pass = 0; pass < 3; pass += 1) {
      const bytes = toLegacyBytes(current);
      if (!bytes) break;
      const decoded = decodeUtf8Bytes(bytes);
      if (!decoded || decoded === current) break;
      current = decoded;
      if (!MOJIBAKE_RE.test(current)) break;
    }

    return current.normalize('NFC');
  };
  const sanitizeText = (value: unknown) => maybeDecodeMojibake(value).replace(/\u0000/g, '');
  const sanitizePayload = (value: any): any => {
    if (typeof value === 'string') return sanitizeText(value);
    if (Array.isArray(value)) return value.map((item) => sanitizePayload(item));
    if (value && typeof value === 'object') {
      const output: Record<string, any> = {};
      Object.entries(value).forEach(([key, item]) => {
        output[key] = sanitizePayload(item);
      });
      return output;
    }
    return value;
  };
  const escapeHtml = (str: unknown) => sanitizeText(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
  const escapeAttr = (str: unknown) => escapeHtml(str).replace(/"/g, '&quot;').replace(/'/g, '&#39;');
  const fmtDate = (d: string) => { try { return new Date(d).toLocaleDateString('es-ES',{day:'2-digit',month:'short',hour:'2-digit',minute:'2-digit'}); } catch { return '—'; } };
  const isTodayDate = (d: string) => {
    try {
      const target = new Date(d);
      const now = new Date();
      return target.getFullYear() === now.getFullYear() && target.getMonth() === now.getMonth() && target.getDate() === now.getDate();
    } catch {
      return false;
    }
  };
  const fetchJson = async (url: string, opts?: RequestInit, timeoutMs = 8000) => {
    const r = await fetch(url, { signal: AbortSignal.timeout(timeoutMs), ...opts });
    if (!r.ok) {
      let detail = '';
      try {
        detail = await r.text();
      } catch {
        detail = '';
      }
      throw new Error(detail ? `HTTP ${r.status}: ${detail.slice(0, 220)}` : `HTTP ${r.status}`);
    }
    const payload = await r.json();
    return sanitizePayload(payload);
  };
  const sanitizePageTextNodes = () => {
    const walker = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT);
    const updates: Array<{ node: Text; value: string }> = [];
    let current = walker.nextNode();
    while (current) {
      const node = current as Text;
      const original = node.nodeValue || '';
      if (MOJIBAKE_RE.test(original)) {
        const fixed = maybeDecodeMojibake(original);
        if (fixed && fixed !== original) {
          updates.push({ node, value: fixed });
        }
      }
      current = walker.nextNode();
    }
    updates.forEach(({ node, value }) => {
      node.nodeValue = value;
    });
  };
  const sanitizeCommonAttributes = () => {
    const attrs = ['title', 'aria-label', 'placeholder'];
    const selector = '[title],[aria-label],[placeholder]';
    const nodes = document.querySelectorAll(selector);
    nodes.forEach((element) => {
      attrs.forEach((attr) => {
        const original = element.getAttribute(attr);
        if (!original || !MOJIBAKE_RE.test(original)) return;
        const fixed = maybeDecodeMojibake(original);
        if (fixed && fixed !== original) {
          element.setAttribute(attr, fixed);
        }
      });
    });
  };
  sanitizePageTextNodes();
  sanitizeCommonAttributes();
  const isTimeoutError = (err: any) => {
    const msg = String(err?.message || '').toLowerCase();
    return err?.name === 'TimeoutError' || msg.includes('timed out') || msg.includes('abort');
  };
  const resolvePatientName = (row: any) =>
    row?.nombre_paciente ||
    row?.pacientes?.nombre_completo ||
    row?.paciente?.nombre_completo ||
    (row?.paciente_id ? `Paciente #${row.paciente_id}` : 'Paciente sin identificar');
  const openPatientHistory = (patientId: string | null, patientName = '') => {
    if (!patientId) return;
    selectedPatientId = patientId;
    selectedPatientName = patientName || '';
    selectedTemplatePatientId = patientId;
    renderTemplatePatientOptions();
    syncChatPatientSelection(patientId, patientName);
    navigateTo('historial');
    loadHistorial();
  };

  // === SPA ROUTING ===
  const navItems = document.querySelectorAll('.nav-item[data-section]');
  const pages = document.querySelectorAll('.page-section');
  const pageLoaders: Record<string, () => void> = {};
  let selectedPatientId: string | null = null;
  let selectedPatientName = '';
  let patientCatalog: Array<{ id: string; nombre_completo: string; email?: string | null }> = [];
  let selectedTemplatePatientId: string | null = null;
  let lastExerciseReportPayload: any = null;
  const exerciseOpsStats = {
    timeouts: 0,
    retries: 0,
  };
  const processedEngineObservability = new Set<string>();
  const archivedReportIds = new Set<string>();

  function syncChatPatientSelection(patientId: string | null, fallbackName = '') {
    if (!chatPatientSelect) return;
    const nextId = patientId || '';
    chatPatientSelect.value = nextId;
    selectedPatientId = nextId || null;

    if (!nextId) {
      selectedPatientName = '';
      return;
    }

    const selected = patientCatalog.find((p) => p.id === nextId);
    selectedPatientName = selected?.nombre_completo || fallbackName || selectedPatientName || '';
  }

  const renderExerciseOpsMetric = () => {
    if (!metricEngineOps) return;
    metricEngineOps.textContent = `${exerciseOpsStats.timeouts}/${exerciseOpsStats.retries}`;
  };
