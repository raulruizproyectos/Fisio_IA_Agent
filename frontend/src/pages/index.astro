    const c = getClinicConfig();
    const p = new URLSearchParams();
    if (c.nombre) p.set('cn', c.nombre);
    if (c.nif) p.set('cnif', c.nif);
    if (c.direccion) p.set('cdir', c.direccion);
    if (c.telefono) p.set('ctel', c.telefono);
    if (c.email) p.set('cemail', c.email);
