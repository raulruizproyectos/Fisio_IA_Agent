  let quickSearchActiveIndex = -1;

  const renderAssistantPatientContext = () => {
    if (!assistantPatientLabel || !assistantPatientMeta) return;
    assistantRail?.classList.toggle('assistant-has-patient', Boolean(selectedPatientId));

    if (!selectedPatientId) {
      assistantPatientLabel.textContent = 'Sin paciente seleccionado';
      assistantPatientMeta.textContent = 'Selecciona uno para vincular la conversacion, el plan y el PDF a su historial.';
      return;
    }

    const selected = patientCatalog.find((patient) => patient.id === selectedPatientId);
    const displayName = selected?.nombre_completo || selectedPatientName || `Paciente ${selectedPatientId}`;
    assistantPatientLabel.textContent = displayName;
    assistantPatientMeta.textContent = selected?.email
      ? `Informe y conversación vinculados a ${selected.email}.`
      : 'Informe, PDF y seguimiento vinculados al historial del paciente.';
  };

  const trimAgentBriefText = (value: any, maxLength = 118) => {
    const normalized = String(value || '').replace(/\s+/g, ' ').trim();
    if (!normalized) return '';
    return normalized.length <= maxLength ? normalized : normalized.slice(0, maxLength - 1).trim() + '...';
  };

  const buildAssistantPatientBrief = (patient: any, notes: any[] = [], recommendations: any[] = []) => {
    const latestNote = Array.isArray(notes) && notes.length ? notes[0] : null;
    const latestRecommendation = Array.isArray(recommendations) && recommendations.length ? recommendations[0] : null;
    const latestFollowUp = Array.isArray(latestRecommendation?.follow_ups) && latestRecommendation.follow_ups.length
      ? latestRecommendation.follow_ups[0]
      : null;
    const reportSnapshot = latestRecommendation?.report_snapshot || {};
    const reportExercises = Array.isArray(reportSnapshot?.exercises) ? reportSnapshot.exercises : [];
    const itemExercises = Array.isArray(latestRecommendation?.crm_recomendacion_items)
      ? latestRecommendation.crm_recomendacion_items
      : [];

    return {
      patientId: selectedPatientId,
      patientName: patient?.nombre_completo || selectedPatientName || 'Paciente seleccionado',
      patientEmail: patient?.email || null,
      notesCount: Array.isArray(notes) ? notes.length : 0,
      latestNoteText: trimAgentBriefText(latestNote?.texto_nota || ''),
      latestNoteDate: latestNote?.creado_en || latestNote?.created_at || null,
      recommendationsCount: Array.isArray(recommendations) ? recommendations.length : 0,
      latestRecommendationId: latestRecommendation?.id || null,
      latestRecommendationDate: latestRecommendation?.created_at || null,
      latestRecommendationState: String(latestRecommendation?.estado || 'sin_plan'),
      latestPainScale: latestFollowUp?.pain_scale ?? null,
      exerciseCount: reportExercises.length || itemExercises.length || 0,
      therapistNote: trimAgentBriefText(reportSnapshot?.message_to_therapist || latestRecommendation?.message_to_therapist_es || ''),
      patientMessage: trimAgentBriefText(reportSnapshot?.message_to_patient || latestRecommendation?.message_to_patient_es || '', 110),
      redFlagsPresent: Boolean(latestRecommendation?.red_flags_present || reportSnapshot?.red_flags?.present),
    };
  };

  const buildAssistantBriefPrompt = (action: 'update-plan' | 'next-session' | 'patient-message') => {
    if (!currentAssistantPatientBrief) return '';
    const brief = currentAssistantPatientBrief;
    const contextLines = [
      `Paciente: ${brief.patientName}`,
      brief.patientEmail ? `Email: ${brief.patientEmail}` : '',
      brief.latestPainScale !== null && brief.latestPainScale !== undefined
        ? `Ultimo dolor registrado: ${brief.latestPainScale}/10`
        : 'Ultimo dolor registrado: no disponible',
      brief.latestNoteText ? `Ultima nota de seguimiento: ${brief.latestNoteText}` : 'Ultima nota de seguimiento: no disponible',
      brief.therapistNote ? `Nota clinica del ultimo plan: ${brief.therapistNote}` : '',
      brief.patientMessage ? `Mensaje previo al paciente: ${brief.patientMessage}` : '',
      brief.exerciseCount ? `Ejercicios del ultimo plan: ${brief.exerciseCount}` : '',
      brief.latestRecommendationState ? `Estado del ultimo plan: ${brief.latestRecommendationState}` : '',
      brief.redFlagsPresent ? 'Hay alertas rojas previas a tener en cuenta.' : '',
    ].filter(Boolean);

    const task = action === 'next-session'
      ? 'Con este contexto, resume el objetivo de la siguiente sesion, que revisar en consulta y que progresion o regresion valorar.'
      : action === 'patient-message'
        ? 'Con este contexto, redacta un mensaje claro, cercano y profesional para explicar el plan al paciente, con foco en adherencia y senales de alarma.'
        : 'Con este contexto, actualiza el plan de ejercicios domiciliarios con progresion segura, objetivo clinico, red flags y criterio de seguimiento.';

    return contextLines.join('\n') + '\n\n' + task;
  };

  const getAssistantDraftSummary = () => {
    const draft = String(input?.value || '').replace(/\s+/g, ' ').trim();
    if (!draft) return '';
    return draft.length <= 96 ? draft : draft.slice(0, 95).trim() + '...';
