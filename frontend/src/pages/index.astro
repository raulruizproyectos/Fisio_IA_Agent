---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Fisio IA Agent - CRM Clinico Inteligente">
  <div class="app-shell">
    <!-- SIDEBAR -->
    <aside class="sidebar" id="sidebar">
      <div class="sidebar-brand">
        <div class="brand-icon-wrapper">
          <span class="brand-icon material-symbols-rounded">&#xf109;</span>
        </div>
        <span class="brand-text">Fisio IA Agent</span>
      </div>

      <nav class="sidebar-nav">
        <a href="#" class="nav-item active" data-section="dashboard">
          <span class="material-symbols-rounded">&#xe88a;</span>
          <span class="nav-label">Inicio</span>
        </a>
        <a href="#" class="nav-item" data-section="pacientes">
          <span class="material-symbols-rounded">&#xe7ef;</span>
          <span class="nav-label">Pacientes</span>
        </a>
        <a href="#" class="nav-item" data-section="citas">
          <span class="material-symbols-rounded">&#xe935;</span>
          <span class="nav-label">Agenda</span>
        </a>
        <a href="#" class="nav-item" data-section="plantillas">
          <span class="material-symbols-rounded">&#xf0e3;</span>
          <span class="nav-label">Plantillas</span>
        </a>
        <a href="#" class="nav-item" data-section="pagos">
          <span class="material-symbols-rounded">&#xef63;</span>
          <span class="nav-label">Pagos</span>
        </a>
        <a href="#" class="nav-item" data-section="gestoria">
          <span class="material-symbols-rounded">&#xe84f;</span>
          <span class="nav-label">Gestor&iacute;a</span>
        </a>
        <a href="#" class="nav-item" data-section="facturas">
          <span class="material-symbols-rounded">&#xef6b;</span>
          <span class="nav-label">Facturaci&oacute;n</span>
        </a>
        <a href="#" class="nav-item" data-section="bonos">
          <span class="material-symbols-rounded">&#xe638;</span>
          <span class="nav-label">Bonos</span>
        </a>
      </nav>

      <div class="sidebar-bottom">
        <div class="sidebar-section-label">Comunicaci&oacute;n</div>
        <a href="#" class="nav-item has-badge" data-section="intakes">
          <span class="material-symbols-rounded">&#xf187;</span>
          <span class="nav-label">Mensajes Intake</span>
          <span class="badge" id="intakeBadge">0</span>
        </a>
        <a href="#" class="nav-item" data-section="historial">
          <span class="material-symbols-rounded">&#xe2c8;</span>
          <span class="nav-label">Historial</span>
        </a>
        <a href="#" class="nav-item" data-section="config">
          <span class="material-symbols-rounded">&#xe8b8;</span>
          <span class="nav-label">Ajustes</span>
        </a>
      </div>
    </aside>
    <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

    <!-- MAIN -->
    <div class="main-area">
      <!-- HEADER -->
      <header class="topbar">
        <button class="sidebar-toggle" id="sidebarToggle" aria-label="Men&uacute;">
          <span class="material-symbols-rounded">&#xe5d2;</span>
        </button>
        <div class="search-box">
          <span class="material-symbols-rounded search-icon">search</span>
          <input type="text" id="searchInput" placeholder="Buscar paciente o email..." autocomplete="off" />
          <div class="search-results" id="searchResults" hidden></div>
        </div>
        <div class="topbar-right">
          <button class="assistant-launch-btn" id="assistantRailToggle" type="button" aria-label="Abrir copilot cl&iacute;nico" aria-controls="assistantRail" aria-expanded="false">
            <span class="material-symbols-rounded">&#xf7cf;</span>
            <span>Copilot</span>
          </button>
          <button class="icon-btn topbar-notif-btn" aria-label="Notificaciones" id="notifBtn">
            <span class="material-symbols-rounded">&#xe7f4;</span>
            <span class="dot-indicator"></span>
          </button>
          <div class="user-pill">
            <div class="avatar">RR</div>
            <span class="user-name">Dr. Ra&uacute;l Ruiz</span>
          </div>
        </div>
      </header>

      <!-- CONTENT -->
      <div class="workspace-shell">
        <main class="content">
        <!-- === PAGE: DASHBOARD === -->
                <div class="page-section active" data-page="dashboard">
          <div class="dashboard-layout">
            <section class="hero-section cockpit-hero">
              <div class="hero-panel-main">
                <div class="hero-heading-stack">
                  <span class="hero-eyebrow">Cockpit clinico inteligente</span>
                  <h1 class="hero-title">Opera la clinica desde una sola vista</h1>
                  <p class="hero-subtitle">Agenda, intake, seguimiento y agente de ejercicios en un cockpit pensado para fisioterapeutas que necesitan decidir y actuar rapido.</p>
                </div>
                <div class="hero-actions hero-action-row">
                  <button class="btn-primary" id="heroAgentShortcutBtn" type="button"><span class="material-symbols-rounded">psychology</span> Generar plan guiado</button>
                  <button class="btn-secondary" id="heroAgendaShortcutBtn" type="button"><span class="material-symbols-rounded">calendar_today</span> Abrir agenda</button>
                  <button class="btn-ghost" id="heroNewPatientShortcutBtn" type="button"><span class="material-symbols-rounded">add</span> Alta express</button>
                </div>
                <div class="hero-signal-grid">
                  <article class="signal-card">
                    <span class="signal-kicker">Agenda online</span>
                    <strong class="signal-value">Prepara la sesion desde la home.</strong>
                    <p>Mueve citas, detecta huecos y salta al paciente sin perder el contexto clinico.</p>
                  </article>
                  <article class="signal-card">
                    <span class="signal-kicker">Intake a decision</span>
                    <strong class="signal-value">Convierte mensajes en siguiente accion.</strong>
                    <p>La bandeja deja de ser solo lectura y pasa a ser triage operativo.</p>
                  </article>
                  <article class="signal-card">
                    <span class="signal-kicker">Agente de ejercicios</span>
                    <strong class="signal-value">Nuestro diferencial no es el chat, es el flujo.</strong>
                    <p>Genera, archiva, exporta y da continuidad al plan dentro del historial real del paciente.</p>
                  </article>
                  <article class="signal-card">
                    <span class="signal-kicker">Automatizacion</span>
                    <strong class="signal-value">n8n + backend + Supabase trabajando juntos.</strong>
                    <p>W1, W2, W3, Telegram y PDF ya forman parte del producto y deben verse asi.</p>
                  </article>
                </div>
              </div>
              <div class="hero-panel-side">
                <article class="cockpit-side-card cockpit-side-card-agent">
                  <span class="cockpit-side-kicker">Motor IA de ejercicios</span>
                  <h2 class="cockpit-side-title">El copilot tiene que cerrar trabajo real</h2>
                  <p>Selecciona paciente, pide el objetivo clinico, genera el plan y dejalo listo para PDF e historial. Ese es el salto de producto que tenemos que ganar.</p>
                  <div class="cockpit-side-actions">
                    <button class="btn-ghost" type="button" data-dashboard-action="open-copilot"><span class="material-symbols-rounded">right_panel_open</span> Abrir copilot</button>
                    <button class="btn-ghost" type="button" data-dashboard-nav="historial"><span class="material-symbols-rounded">history</span> Ver historial</button>
                  </div>
                </article>
                <article class="cockpit-side-card">
                  <span class="cockpit-side-kicker">Flujos prioritarios</span>
                  <div class="ops-list">
                    <div class="ops-item">
                      <span>W1 Agenda</span>
                      <strong>Cita, disponibilidad y preparacion de sesion desde CRM.</strong>
                    </div>
                    <div class="ops-item">
                      <span>W2 Ejercicios</span>
                      <strong>Recomendacion guiada conectada a Supabase y exportacion PDF.</strong>
                    </div>
                    <div class="ops-item">
                      <span>W3 CRM trigger</span>
                      <strong>Camino asincrono preparado para escalar la carga clinica.</strong>
                    </div>
                    <div class="ops-item">
                      <span>Telegram</span>
                      <strong>Seguimiento y continuidad fuera de consulta.</strong>
                    </div>
                  </div>
                </article>
              </div>
            </section>

            <section class="metrics-row clinical-metrics">
              <div class="metric-card"><div class="metric-icon" style="background: rgba(15, 118, 110, 0.1); color: var(--accent);"><span class="material-symbols-rounded">group</span></div><div class="metric-data"><span class="metric-value" id="metricPacientes">&mdash;</span><span class="metric-label">Pacientes activos</span></div></div>
              <div class="metric-card"><div class="metric-icon" style="background: rgba(16, 185, 129, 0.1); color: var(--success);"><span class="material-symbols-rounded">event_available</span></div><div class="metric-data"><span class="metric-value" id="metricSesiones">&mdash;</span><span class="metric-label">Citas hoy</span></div></div>
              <div class="metric-card"><div class="metric-icon" style="background: rgba(59, 130, 246, 0.1); color: var(--info);"><span class="material-symbols-rounded">description</span></div><div class="metric-data"><span class="metric-value" id="metricInformes">0</span><span class="metric-label">Planes archivados</span></div></div>
              <div class="metric-card"><div class="metric-icon" style="background: rgba(245, 158, 11, 0.12); color: var(--warning);"><span class="material-symbols-rounded">monitoring</span></div><div class="metric-data"><span class="metric-value" id="metricEngineOps">0/0</span><span class="metric-label">Timeouts / reintentos IA</span></div></div>
            </section>

            <section class="dashboard-ops-grid">
              <article class="cockpit-block">
                <header class="cockpit-block-head">
                  <div class="cockpit-block-copy">
                    <span class="hero-eyebrow">Arquitectura operativa</span>
                    <h2>Malla real del producto</h2>
                  </div>
                </header>
                <div class="workflow-stack">
                  <div class="workflow-row"><span class="workflow-tag">n8n</span><p>Orquesta agenda, Telegram, intake y activacion del agente.</p></div>
                  <div class="workflow-row"><span class="workflow-tag">Backend</span><p>Expone CRM, historial, PDF, citas, pagos y puntos de integracion.</p></div>
                  <div class="workflow-row"><span class="workflow-tag">Supabase</span><p>Persistencia, jobs y funciones que convierten el agente de ejercicios en una capacidad de producto.</p></div>
                </div>
              </article>
              <article class="cockpit-block">
                <header class="cockpit-block-head">
                  <div class="cockpit-block-copy">
                    <span class="hero-eyebrow">Accesos clinicos reales</span>
                    <h2>Trabaja por flujo, no por menu</h2>
                  </div>
                </header>
                <div class="command-grid">
                  <button type="button" class="command-tile" data-dashboard-action="new-patient"><span class="command-tile-kicker">Admision</span><strong>Alta guiada de paciente</strong><p>Registra y deja todo listo para historial, chat y seguimiento.</p></button>
                  <button type="button" class="command-tile" data-dashboard-nav="citas"><span class="command-tile-kicker">Agenda</span><strong>Crear o mover cita</strong><p>Salta a la agenda sin pasar por menus intermedios.</p></button>
                  <button type="button" class="command-tile" data-dashboard-nav="intakes"><span class="command-tile-kicker">Triage</span><strong>Vaciar bandeja entrante</strong><p>Convierte mensajes pendientes en respuesta o siguiente accion clinica.</p></button>
                  <button type="button" class="command-tile" data-dashboard-action="open-copilot"><span class="command-tile-kicker">Ejercicios</span><strong>Abrir motor IA</strong><p>Pide el programa, revisa el plan y dejalo listo para exportacion.</p></button>
                </div>
              </article>
            </section>

            <div class="dashboard-bottom-row">
              <section class="card widget-card">
                <header class="card-header">
                  <h2>Agenda inmediata</h2>
                  <button class="btn-ghost" type="button" data-dashboard-nav="citas"><span class="material-symbols-rounded">arrow_forward</span> Ver todas</button>
                </header>
                <div class="widget-body list-clean" id="dashCitasBody">
                  <div class="empty-state-sm state-loading">
                    <span class="material-symbols-rounded">update</span>
                    <p>Actualizando agenda...</p>
                  </div>
                </div>
              </section>

              <section class="card widget-card">
                <header class="card-header">
                  <h2>Mensajes de pacientes</h2>
                  <button class="btn-ghost" id="refreshIntakes"><span class="material-symbols-rounded">refresh</span></button>
                </header>
                <div class="widget-body list-clean" id="intakeBody">
                  <div class="empty-state-sm state-loading">
                    <span class="material-symbols-rounded">update</span>
                    <p>Actualizando bandeja...</p>
                  </div>
                </div>
              </section>
            </div>
          </div>
        </div>

        <!-- === PAGE: PACIENTES === -->
        <div class="page-section" data-page="pacientes">
          <div class="page-header-row">
            <h1 class="page-title"><span class="material-symbols-rounded">&#xe7ef;</span> Pacientes</h1>
            <button class="btn-primary" id="addPatientBtn"><span class="material-symbols-rounded">&#xea4d;</span> Nuevo paciente</button>
          </div>
          <section class="card table-card">
            <header class="card-header"><h2>Lista de pacientes</h2><button class="btn-ghost" id="refreshPacientes"><span class="material-symbols-rounded">&#xe5d5;</span> Actualizar</button></header>
            <div class="table-wrap"><table><thead><tr><th>Nombre</th><th>Email</th><th>Fecha nac.</th><th>Registro</th><th>Acciones</th></tr></thead><tbody id="pacientesBody"><tr class="empty-row"><td colspan="5"><div class="empty-state"><span class="material-symbols-rounded">&#xe88b;</span><p>Cargando pacientes...</p></div></td></tr></tbody></table></div>
          </section>
        </div>

        <div class="modal-shell" id="patientModal" aria-hidden="true">
          <div class="modal-panel" role="dialog" aria-modal="true" aria-labelledby="patientModalTitle">
            <div class="modal-header">
              <div class="modal-title-group">
                <p class="modal-eyebrow">CRM</p>
                <h2 id="patientModalTitle">Alta de paciente</h2>
                <p>Registra un paciente nuevo y dejalo listo para historial, chat clínico y plantillas.</p>
              </div>
              <button type="button" class="modal-close" id="closePatientModalBtn" aria-label="Cerrar formulario de paciente">
                <span class="material-symbols-rounded">&#xe5cd;</span>
              </button>
            </div>

            <form id="patientForm" class="patient-form">
              <div class="form-grid">
                <label class="field field-full">
                  <span>Nombre completo</span>
                  <input id="patientNameInput" name="nombre_completo" type="text" placeholder="Ej.: Maria Lopez Garcia" autocomplete="name" required />
                </label>
                <label class="field">
                  <span>Email</span>
                  <input id="patientEmailInput" name="email" type="email" placeholder="paciente@correo.com" autocomplete="email" />
                </label>
                <label class="field">
                  <span>Telefono</span>
                  <input id="patientPhoneInput" name="phone" type="tel" placeholder="+34 600 123 456" autocomplete="tel" />
                </label>
                <label class="field">
                  <span>Fecha de nacimiento</span>
                  <input id="patientBirthDateInput" name="fecha_nacimiento" type="date" autocomplete="bday" />
                </label>
              </div>

              <p class="form-feedback" id="patientFormFeedback" hidden></p>

              <div class="modal-actions">
                <button type="button" class="btn-ghost" id="patientModalDismiss">Cancelar</button>
                <button type="submit" class="btn-primary" id="patientSubmitBtn">
                  <span class="material-symbols-rounded">&#xe161;</span>
                  Guardar paciente
                </button>
              </div>
            </form>
          </div>
        </div>

        <!-- === PAGE: PLANTILLAS === -->
        <div class="page-section" data-page="plantillas">
          <div class="page-header-row">
            <h1 class="page-title"><span class="material-symbols-rounded">&#xe02f;</span> Plantillas Terapéuticas</h1>
            <div class="page-tools">
              <label class="inline-field">
                <span>Paciente destino</span>
                <select id="templateTargetPatient">
                  <option value="">Selecciona paciente</option>
                </select>
              </label>
              <button class="btn-ghost" id="refreshTemplates"><span class="material-symbols-rounded">&#xe5d5;</span> Actualizar</button>
            </div>
          </div>
          <section class="card table-card">
            <header class="card-header"><h2>Plantillas más reútilizadas</h2></header>
            <div class="table-wrap">
              <table>
                <thead>
                  <tr>
                    <th>Título</th>
                    <th>Usos</th>
                    <th>Ejercicios</th>
                    <th>Último uso</th>
                    <th>Origen</th>
                    <th>Acción</th>
                  </tr>
                </thead>
                <tbody id="templatesBody">
                  <tr class="empty-row">
                    <td colspan="6">
                      <div class="empty-state">
                        <span class="material-symbols-rounded">&#xe88b;</span>
                        <p>Cargando plantillas...</p>
                      </div>
                    </td>
                  </tr>
                </tbody>
              </table>
            </div>
          </section>
        </div>

        <!-- === PAGE: INTAKES === -->
        <div class="page-section" data-page="intakes">
          <div class="page-header-row">
            <h1 class="page-title"><span class="material-symbols-rounded">&#xe85d;</span> Intakes Pendientes</h1>
          </div>
          <section class="card table-card">
            <header class="card-header"><h2>Mensajes de ingesta por revisar</h2><button class="btn-ghost" id="refreshIntakesFull"><span class="material-symbols-rounded">&#xe5d5;</span> Actualizar</button></header>
            <div class="table-wrap"><table><thead><tr><th>Paciente</th><th>Fuente</th><th>Mensaje</th><th>Alertas</th><th>Fecha</th><th>Estado</th><th>Acciones</th></tr></thead><tbody id="intakesFullBody"><tr class="empty-row"><td colspan="7"><div class="empty-state"><span class="material-symbols-rounded">&#xe88b;</span><p>Cargando intakes...</p></div></td></tr></tbody></table></div>
          </section>
        </div>

        <!-- === PAGE: CITAS === -->
        <div class="page-section" data-page="citas">
          <div class="page-header-row">
            <h1 class="page-title"><span class="material-symbols-rounded">&#xebcc;</span> Agenda</h1>
            <div class="week-nav-bar">
              <button class="btn-ghost btn-icon" id="prevWeek" title="Semana anterior"><span class="material-symbols-rounded">&#xe5cb;</span></button>
              <span id="weekLabel" class="week-label">Cargando...</span>
              <button class="btn-ghost btn-icon" id="nextWeek" title="Semana siguiente"><span class="material-symbols-rounded">&#xe5cc;</span></button>
              <button class="btn-ghost" id="thisWeek">Hoy</button>
              <button class="btn-ghost btn-icon" id="refreshCitas" title="Actualizar"><span class="material-symbols-rounded">&#xe5d5;</span></button>
            </div>
          </div>
          <section class="card agenda-cal-card">
            <div id="agendaCalendar" class="agenda-calendar">
              <div class="agenda-cal-loading"><span class="material-symbols-rounded">&#xe627;</span> Cargando...</div>
            </div>
          </section>
          <section class="card table-card">
            <header class="card-header">
              <h2>Pacientes esta semana <span class="badge-week-count" id="weekPatientCount"></span></h2>
            </header>
            <div class="table-wrap">
              <table>
                <thead><tr><th>Paciente</th><th>Día</th><th>Hora</th><th>Motivo</th><th>Canal</th><th>Estado</th></tr></thead>
                <tbody id="citasBody"><tr class="empty-row"><td colspan="6"><div class="empty-state"><span class="material-symbols-rounded">&#xe88b;</span><p>Cargando agenda...</p></div></td></tr></tbody>
              </table>
            </div>
          </section>
        </div>

        <!-- === PAGE: HISTORIAL === -->
        <div class="page-section" data-page="historial">
          <div class="page-header-row">
            <h1 class="page-title"><span class="material-symbols-rounded">&#xe889;</span> Historial</h1>
          </div>
          <section class="card">
            <header class="card-header"><h2>Notas de seguimiento</h2><button class="btn-ghost" id="refreshHistorial"><span class="material-symbols-rounded">&#xe5d5;</span> Actualizar</button></header>
            <div id="historialContent" class="section-body"><div class="empty-state"><span class="material-symbols-rounded">&#xe889;</span><p>Selecciona un paciente para ver su historial</p></div></div>
          </section>
        </div>

        <!-- === PAGE: PAGOS === -->
        <div class="page-section" data-page="pagos">
          <div class="page-header-row">
            <h1 class="page-title"><span class="material-symbols-rounded">&#xef63;</span> Pagos</h1>
            <button class="btn-primary" id="addPagoBtn">
              <span class="material-symbols-rounded">&#xeb86;</span> Registrar pago
            </button>
          </div>

          <!-- Resumen + filtros compactos -->
          <div class="pagos-toolbar">
            <div class="pagos-summary-row">
              <div class="pagos-stat"><span class="pagos-stat-label">Total</span><span class="pagos-stat-value" id="pagosTotalImporte">0,00 &euro;</span></div>
              <div class="pagos-stat"><span class="pagos-stat-label">Sesiones</span><span class="pagos-stat-value" id="pagosTotalSesiones">0</span></div>
              <div class="pagos-stat pagos-stat-cash"><span class="pagos-stat-label">Efectivo</span><span class="pagos-stat-value" id="pagosTotalEfectivo">0,00 &euro;</span></div>
              <div class="pagos-stat pagos-stat-card"><span class="pagos-stat-label">Tarjeta</span><span class="pagos-stat-value" id="pagosTotalTarjeta">0,00 &euro;</span></div>
            </div>
            <div class="pagos-filters-row">
              <select id="pagosMesFilter" title="Mes">
                <option value="">Todo el a&ntilde;o</option>
                <option value="1">Enero</option><option value="2">Febrero</option><option value="3">Marzo</option>
                <option value="4">Abril</option><option value="5">Mayo</option><option value="6">Junio</option>
                <option value="7">Julio</option><option value="8">Agosto</option><option value="9">Septiembre</option>
                <option value="10">Octubre</option><option value="11">Noviembre</option><option value="12">Diciembre</option>
              </select>
              <select id="pagosAnioFilter" title="A&ntilde;o"></select>
            </div>
          </div>

          <!-- Tabla de pagos -->
          <section class="card table-card">
            <div class="table-wrap">
              <table>
                <thead>
                  <tr>
                    <th>Fecha</th>
                    <th>Paciente</th>
                    <th>M&eacute;todo</th>
                    <th class="text-right">Importe</th>
                    <th></th>
                  </tr>
                </thead>
                <tbody id="pagosBody">
                  <tr class="empty-row"><td colspan="5"><div class="empty-state"><span class="material-symbols-rounded">&#xe88b;</span><p>Cargando pagos...</p></div></td></tr>
                </tbody>
              </table>
            </div>
          </section>
        </div>

        <!-- Modal: Nuevo/Editar Pago -->
        <div class="modal-shell" id="pagoModal" aria-hidden="true">
          <div class="modal-panel" role="dialog" aria-modal="true" aria-labelledby="pagoModalTitle">
            <div class="modal-header">
              <div class="modal-title-group">
                <h2 id="pagoModalTitle">Registrar pago</h2>
              </div>
              <button type="button" class="modal-close" id="closePagoModalBtn" aria-label="Cerrar"><span class="material-symbols-rounded">&#xe5cd;</span></button>
            </div>
            <form id="pagoForm" class="patient-form">
              <input type="hidden" id="pagoEditId" value="" />
              <div class="form-grid">
                <label class="field field-full">
                  <span>Paciente</span>
                  <select id="pagoPacienteSelect" required>
                    <option value="">-- Selecciona paciente --</option>
                  </select>
                </label>
                <label class="field">
                  <span>Importe (&euro;)</span>
                  <input id="pagoImporteInput" name="importe" type="number" step="0.01" min="0.01" placeholder="35.00" required />
                </label>
                <label class="field">
                  <span>M&eacute;todo</span>
                  <div class="pagos-metodo-toggle">
