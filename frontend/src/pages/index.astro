---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Fisio IA Agent - CRM Clinico Inteligente">
  <div class="app-shell">
    <!-- SIDEBAR -->
    <aside class="sidebar" id="sidebar">
      <div class="sidebar-brand">
        <div class="brand-icon-wrapper">
          <span class="brand-icon material-symbols-rounded">medical_services</span>
        </div>
        <span class="brand-text">Fisio IA Agent</span>
      </div>

      <nav class="sidebar-nav">
        <a href="#" class="nav-item active" data-section="dashboard">
          <span class="material-symbols-rounded">home</span>
          <span class="nav-label">Inicio</span>
        </a>
        <a href="#" class="nav-item" data-section="pacientes">
          <span class="material-symbols-rounded">group</span>
          <span class="nav-label">Pacientes</span>
        </a>
        <a href="#" class="nav-item" data-section="citas">
          <span class="material-symbols-rounded">calendar_today</span>
          <span class="nav-label">Agenda</span>
        </a>
        <a href="#" class="nav-item" data-section="plantillas">
          <span class="material-symbols-rounded">prescriptions</span>
          <span class="nav-label">Biblioteca</span>
        </a>
        <a href="#" class="nav-item" data-section="finanzas">
          <span class="material-symbols-rounded">payments</span>
          <span class="nav-label">Finanzas</span>
        </a>
        <a href="#" class="nav-item" data-section="documentos">
          <span class="material-symbols-rounded">description</span>
          <span class="nav-label">Documentos</span>
        </a>
      </nav>

      <div class="sidebar-bottom">
        <div class="sidebar-section-label">Comunicaci&oacute;n</div>
        <a href="#" class="nav-item has-badge" data-section="intakes">
          <span class="material-symbols-rounded">forward_to_inbox</span>
          <span class="nav-label">Mensajes</span>
          <span class="badge" id="intakeBadge">0</span>
        </a>
        <a href="#" class="nav-item" data-section="historial">
          <span class="material-symbols-rounded">folder_open</span>
          <span class="nav-label">Historial</span>
        </a>
        <a href="#" class="nav-item" data-section="config">
          <span class="material-symbols-rounded">settings</span>
          <span class="nav-label">Ajustes</span>
        </a>
      </div>
    </aside>
    <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

    <!-- MAIN -->
    <div class="main-area">
      <!-- HEADER -->
      <header class="topbar">
        <button class="sidebar-toggle" id="sidebarToggle" aria-label="Men&uacute;">
          <span class="material-symbols-rounded">menu</span>
        </button>
        <div class="search-box">
          <span class="material-symbols-rounded search-icon">search</span>
          <input type="text" id="searchInput" placeholder="Buscar paciente o email..." autocomplete="off" />
          <div class="search-results" id="searchResults" hidden></div>
        </div>
        <div class="topbar-right">
          <button class="assistant-launch-btn" id="assistantRailToggle" type="button" aria-label="Abrir copilot cl&iacute;nico" aria-controls="assistantRail" aria-expanded="false">
            <span class="material-symbols-rounded">right_panel_open</span>
            <span>Copiloto</span>
          </button>
          <button class="icon-btn topbar-notif-btn" aria-label="Notificaciones" id="notifBtn">
            <span class="material-symbols-rounded">notifications</span>
            <span class="dot-indicator"></span>
          </button>
          <div class="user-pill">
            <div class="avatar">RR</div>
            <span class="user-name">Dr. Ra&uacute;l Ruiz</span>
          </div>
        </div>
      </header>

      <!-- CONTENT -->
      <div class="workspace-shell">
        <main class="content">
        <!-- === PAGE: DASHBOARD === -->
                <div class="page-section active" data-page="dashboard">
          <div class="dashboard-layout">
            <section class="hero-section cockpit-hero">
              <div class="hero-panel-main">
                <div class="hero-heading-stack">
                  <span class="hero-eyebrow">Centro operativo del dia</span>
                  <h1 class="hero-title">Hoy en la clinica</h1>
                  <p class="hero-subtitle" id="dashboardLiveSummary">Resumen diario en tiempo real.</p>
                  <div class="hero-runtime-strip" aria-label="Principios del trabajo diario">
                    <span class="hero-runtime-chip">Agenda viva</span>
                    <span class="hero-runtime-chip">Seguimiento trazable</span>
                    <span class="hero-runtime-chip">Cobro y documentacion al dia</span>
                  </div>
                </div>
                <div class="hero-actions hero-action-row">
                  <button class="btn-primary" id="heroAgentShortcutBtn" type="button"><span class="material-symbols-rounded">psychology</span> Generar plan guiado</button>
                </div>
                <div class="hero-signal-grid">
                  <article class="signal-card signal-card-live" id="dashboardNextSessionCard">
                    <div class="signal-live-head">
                      <span class="signal-kicker">Proxima sesion</span>
                      <span class="status-chip pendiente" id="dashboardNextSessionStatus">Agenda</span>
                    </div>
                    <strong class="signal-value" id="dashboardNextSessionTitle">Cargando agenda...</strong>
                    <p id="dashboardNextSessionMeta">Cargando...</p>
                    <button class="btn-link-inline" id="dashboardNextSessionBtn" type="button"><span class="material-symbols-rounded">event_available</span> Abrir agenda</button>
                  </article>
                  <article class="signal-card signal-card-live">
                    <div class="signal-live-head">
                      <span class="signal-kicker">Triage operativo</span>
                    <span class="status-chip pendiente" id="dashboardIntakeStatus">Entrada</span>
                    </div>
                    <strong class="signal-value" id="dashboardIntakeTitle">Bandeja en revisión</strong>
                    <p id="dashboardIntakeMeta">Actualizando mensajes de pacientes desde Telegram y formulario web.</p>
                    <button class="btn-link-inline" type="button" data-dashboard-nav="intakes"><span class="material-symbols-rounded">forward_to_inbox</span> Abrir bandeja</button>
                  </article>
                  <article class="signal-card signal-card-live">
                    <div class="signal-live-head">
                      <span class="signal-kicker">Google Calendar</span>
                      <span class="status-chip pendiente" id="dashboardSyncChip">Comprobando</span>
                    </div>
                    <strong class="signal-value" id="dashboardSyncTitle">Sincronizacion de agenda</strong>
                    <p id="dashboardSyncMeta">Esperando estado del lector y escritor de calendar.</p>
                    <div class="agenda-sync-facts dashboard-sync-facts" id="dashboardSyncFacts" hidden></div>
                  </article>
                  <article class="signal-card signal-card-live signal-card-booking">
                    <div class="signal-live-head">
                      <span class="signal-kicker">Reserva online</span>
                      <span class="status-chip aprobado">Activa</span>
                    </div>
                    <strong class="signal-value">Reserva online activa</strong>
                    <p id="dashboardBookingMeta">Enlace publico disponible.</p>
                    <div class="signal-card-actions">
                      <button class="btn-link-inline" id="dashboardBookingOpenBtn" type="button"><span class="material-symbols-rounded">open_in_new</span> Abrir reserva</button>
                      <button class="btn-link-inline" id="dashboardBookingCopyBtn" type="button"><span class="material-symbols-rounded">content_copy</span> Copiar enlace</button>
                    </div>
                    <span id="dashboardBookingFeedback" class="form-feedback" hidden></span>
                  </article>
                </div>
              </div>
              <div class="hero-panel-side">
                <article class="cockpit-side-card priorities-side-card">
                  <span class="cockpit-side-kicker">Foco operativo</span>
                  <div class="priority-list" id="dashboardPriorityList">
                    <article class="priority-item priority-item-loading">
                      <div class="priority-copy">
                        <span>Cargando</span>
                        <strong>Calculando...</strong>
                      </div>
                    </article>
                  </div>
                </article>
              </div>
            </section>

            <section class="metrics-row clinical-metrics">
              <div class="metric-card"><div class="metric-icon" style="background: rgba(15, 118, 110, 0.1); color: var(--accent);"><span class="material-symbols-rounded">group</span></div><div class="metric-data"><span class="metric-value" id="metricPacientes">&mdash;</span><span class="metric-label">Pacientes activos</span></div></div>
              <div class="metric-card"><div class="metric-icon" style="background: rgba(16, 185, 129, 0.1); color: var(--success);"><span class="material-symbols-rounded">event_available</span></div><div class="metric-data"><span class="metric-value" id="metricSesiones">&mdash;</span><span class="metric-label">Citas hoy</span></div></div>
              <div class="metric-card"><div class="metric-icon" style="background: rgba(22, 163, 74, 0.1); color: #16a34a;"><span class="material-symbols-rounded">euro</span></div><div class="metric-data"><span class="metric-value" id="metricIngresosMes">0 &euro;</span><span class="metric-label">Ingresos este mes</span></div></div>
              <div class="metric-card"><div class="metric-icon" style="background: rgba(245, 158, 11, 0.12); color: var(--warning);"><span class="material-symbols-rounded">receipt_long</span></div><div class="metric-data"><span class="metric-value" id="metricSesionesMes">0</span><span class="metric-label">Sesiones este mes</span></div></div>
            </section>

            <!-- Grafico ingresos mensuales -->
            <section class="card widget-card" style="margin-bottom:0">
              <header class="card-header">
                <h2>Ingresos mensuales</h2>
                <span style="font-size:0.8rem;color:var(--text-muted)" id="dashChartYear"></span>
              </header>
              <div style="padding:0 1rem 1rem">
                <canvas id="dashIncomeChart" height="150"></canvas>
              </div>
            </section>

            <section class="dashboard-ops-grid">
              <article class="cockpit-block">
                <header class="cockpit-block-head">
                  <div class="cockpit-block-copy">
                    <h2>Flujos clave</h2>
                    <p>Accesos directos para resolver la operativa diaria sin pasos de sobra.</p>
                  </div>
                </header>
                <div class="command-grid">
                  <button type="button" class="command-tile" data-dashboard-action="new-patient"><span class="command-tile-icon" aria-hidden="true"><span class="material-symbols-rounded">person_add</span></span><span class="command-tile-kicker">Admision</span><strong>Alta de paciente</strong><p>Ficha lista en segundos.</p></button>
                  <button type="button" class="command-tile" data-dashboard-nav="citas"><span class="command-tile-icon" aria-hidden="true"><span class="material-symbols-rounded">calendar_month</span></span><span class="command-tile-kicker">Agenda</span><strong>Semana clínica</strong><p>Gestiona huecos y cambios rápido.</p></button>
                  <button type="button" class="command-tile" data-dashboard-nav="intakes"><span class="command-tile-icon" aria-hidden="true"><span class="material-symbols-rounded">forward_to_inbox</span></span><span class="command-tile-kicker">Telegram</span><strong>Mensajes y triage</strong><p>Prioriza y responde sin friccion.</p></button>
                  <button type="button" class="command-tile" data-dashboard-action="open-copilot"><span class="command-tile-icon" aria-hidden="true"><span class="material-symbols-rounded">psychology</span></span><span class="command-tile-kicker">Ejercicios</span><strong>Plan de ejercicios</strong><p>Genera, entrega y guarda trazabilidad.</p></button>
                  <button type="button" class="command-tile command-tile-accent" data-dashboard-nav="pagos"><span class="command-tile-icon" aria-hidden="true"><span class="material-symbols-rounded">payments</span></span><span class="command-tile-kicker">Cobros</span><strong>Pagos y bonos</strong><p>Revisa cobros, bonos y sesiones pendientes.</p></button>
                </div>
              </article>
            </section>

            <div class="dashboard-bottom-row">
              <section class="card widget-card">
                <header class="card-header">
                  <h2>Agenda inmediata</h2>
                  <button class="btn-ghost" type="button" data-dashboard-nav="citas"><span class="material-symbols-rounded">arrow_forward</span> Ver todas</button>
                </header>
                <div class="widget-body list-clean" id="dashCitasBody">
                  <div class="empty-state-sm state-loading">
                    <span class="material-symbols-rounded">update</span>
                    <p>Actualizando agenda...</p>
                  </div>
                </div>
              </section>

              <section class="card widget-card">
                <header class="card-header">
                  <h2>Mensajes de pacientes</h2>
                  <button class="btn-ghost" id="refreshIntakes"><span class="material-symbols-rounded">refresh</span></button>
                </header>
                <div class="widget-body list-clean" id="intakeBody">
                  <div class="empty-state-sm state-loading">
                    <span class="material-symbols-rounded">update</span>
                    <p>Actualizando bandeja...</p>
                  </div>
                </div>
              </section>
            </div>
          </div>
        </div>

        <!-- === PAGE: PACIENTES === -->
        <div class="page-section" data-page="pacientes">
          <div class="page-header-row patients-header-row">
            <div>
              <h1 class="page-title"><span class="material-symbols-rounded">group</span> Pacientes</h1>
              <p class="page-subtitle patients-page-subtitle">Busca y actua sobre cada paciente en un clic.</p>
            </div>
            <button class="btn-primary" id="addPatientBtn"><span class="material-symbols-rounded">person_add</span> Nuevo paciente</button>
          </div>

          <section class="patients-hero-shell">
            <article class="patients-hero-main">
              <span class="patients-kicker">CRM CLINICO ACTIVO</span>
              <h2>Pacientes claros y ordenados.</h2>
              <p>Todo el equipo sabe que hacer en cada ficha.</p>
              <div class="patients-hero-actions">
                <button type="button" class="btn-primary" id="patientsHeroAddBtn"><span class="material-symbols-rounded">person_add</span> Alta rapida</button>
                <button type="button" class="btn-ghost" id="refreshPacientes"><span class="material-symbols-rounded">refresh</span> Sincronizar listado</button>
              </div>
            </article>

            <div class="patients-hero-stats">
              <article class="patients-stat-card">
                <span>Total activo</span>
                <strong id="patientsTotalValue">0</strong>
                <p id="patientsTotalMeta">Cargando base clínica...</p>
              </article>
              <article class="patients-stat-card patients-stat-card-accent">
                <span>Contacto util</span>
                <strong id="patientsReachValue">0%</strong>
                <p id="patientsReachMeta">Midiendo email y telefono disponibles.</p>
              </article>
              <article class="patients-stat-card">
                <span>Altas recientes</span>
                <strong id="patientsRecentValue">0</strong>
                <p id="patientsRecentMeta">Sin lectura todavia.</p>
              </article>
            </div>
          </section>

          <section class="card patients-command-bar">
            <div class="patients-filter-field">
              <span class="material-symbols-rounded">search</span>
              <input type="text" id="patientsFilterInput" placeholder="Buscar por nombre, email, telefono o ID..." autocomplete="off" />
            </div>
            <div class="patients-toolbar-right">
              <div class="patients-segmented" id="patientsSegmented">
                <button type="button" class="patients-segment is-active" data-patient-filter="all">Todos</button>
                <button type="button" class="patients-segment" data-patient-filter="contactable">Contactables</button>
                <button type="button" class="patients-segment" data-patient-filter="incomplete">Incompletos</button>
                <button type="button" class="patients-segment" data-patient-filter="recent">Recientes</button>
              </div>
              <label class="patients-sort-field" for="patientsSortSelect">
                <span class="material-symbols-rounded" aria-hidden="true">sort</span>
                <select id="patientsSortSelect" aria-label="Orden de pacientes">
                  <option value="recent_desc">Más recientes</option>
                  <option value="readiness">Priorizar incompletos</option>
                  <option value="name_asc">Nombre A-Z</option>
                  <option value="name_desc">Nombre Z-A</option>
                </select>
              </label>
            </div>
          </section>

          <section class="card patients-directory-card">
            <header class="patients-directory-head">
              <div>
                <span class="patients-kicker">DIRECTORIO OPERATIVO</span>
                <h2>Listado listo para trabajar</h2>
                <p id="patientsListMeta">Cargando pacientes del CRM...</p>
              </div>
              <span class="patients-directory-chip" id="patientsFilterChip">Todos los pacientes</span>
            </header>

            <div class="patients-directory-list" id="pacientesBody">
              <div class="empty-state"><span class="material-symbols-rounded">hourglass_empty</span><p>Cargando pacientes...</p></div>
            </div>
          </section>
        </div>

        <div class="modal-shell" id="patientModal" aria-hidden="true">
          <div class="modal-panel" role="dialog" aria-modal="true" aria-labelledby="patientModalTitle">
            <div class="modal-header">
              <div class="modal-title-group">
                <p class="modal-eyebrow">CRM</p>
                <h2 id="patientModalTitle">Alta de paciente</h2>
                <p>Registra un paciente y déjalo listo para historial, chat clínico y plantillas.</p>
              </div>
              <button type="button" class="modal-close" id="closePatientModalBtn" aria-label="Cerrar formulario de paciente">
                <span class="material-symbols-rounded">close</span>
              </button>
            </div>

            <form id="patientForm" class="patient-form">
              <div class="form-grid">
                <label class="field field-full">
                  <span>Nombre completo</span>
                  <input id="patientNameInput" name="nombre_completo" type="text" placeholder="Ej.: Maria Lopez Garcia" autocomplete="name" required />
                </label>
                <label class="field">
                  <span>Email</span>
                  <input id="patientEmailInput" name="email" type="email" placeholder="paciente@correo.com" autocomplete="email" />
                </label>
                <label class="field">
                  <span>Telefono</span>
                  <input id="patientPhoneInput" name="phone" type="tel" placeholder="+34 600 123 456" autocomplete="tel" />
                </label>
                <label class="field">
                  <span>Fecha de nacimiento</span>
                  <input id="patientBirthDateInput" name="fecha_nacimiento" type="date" autocomplete="bday" />
                </label>
              </div>

              <p class="form-feedback" id="patientFormFeedback" hidden></p>

              <div class="modal-actions">
                <button type="button" class="btn-ghost" id="patientModalDismiss">Cancelar</button>
                <button type="submit" class="btn-primary" id="patientSubmitBtn">
                  <span class="material-symbols-rounded">save</span>
                  Guardar paciente
                </button>
              </div>
            </form>
          </div>
        </div>

        <!-- === PAGE: PLANTILLAS === -->
        <div class="page-section" data-page="plantillas">
          <div class="page-header-row template-library-header">
            <div>
              <h1 class="page-title"><span class="material-symbols-rounded">library_books</span> Biblioteca clínica</h1>
              <p class="page-subtitle">Gestiona planes IA, entregas archivadas y plantillas reutilizables en una sola vista.</p>
            </div>
            <button class="btn-ghost" id="refreshTemplates" type="button"><span class="material-symbols-rounded">refresh</span> Actualizar</button>
          </div>

          <div class="template-library-shell">
            <section class="template-kpi-grid" id="templateLibrarySummary">
              <article class="template-kpi-card">
                <span>Planes visibles</span>
                <strong>--</strong>
                <p>Cargando biblioteca clínica...</p>
              </article>
              <article class="template-kpi-card">
                <span>Entregas visibles</span>
                <strong>--</strong>
                <p>Esperando historial archivado...</p>
              </article>
              <article class="template-kpi-card">
                <span>Pacientes con seguimiento</span>
                <strong>--</strong>
                <p>Preparando resumen operativo...</p>
              </article>
            </section>

            <div class="template-library-grid">
              <section class="card table-card template-history-card">
                <header class="card-header card-header-stack">
                  <div>
                    <h2>Planes generados</h2>
                    <p class="card-subtitle">Historial real de ejercicios enviados o archivados para seguimiento domiciliario.</p>
                  </div>
                </header>
                <div class="table-wrap">
                  <table>
                    <thead>
                      <tr>
                        <th>Paciente</th>
                        <th>Plan</th>
                        <th>Ejercicios</th>
                        <th>Entregas</th>
                        <th>Ultimo movimiento</th>
                        <th>Accion</th>
                      </tr>
                    </thead>
                    <tbody id="templateHistoryBody">
                      <tr class="empty-row">
                        <td colspan="6">
                          <div class="empty-state">
                            <span class="material-symbols-rounded">hourglass_empty</span>
                            <p>Cargando biblioteca clínica...</p>
                          </div>
                        </td>
                      </tr>
                    </tbody>
                  </table>
                </div>
              </section>

            </div>
          </div>
        </div>
        <!-- === PAGE: INTAKES === -->
        <div class="page-section" data-page="intakes">
          <div class="page-header-row">
            <h1 class="page-title"><span class="material-symbols-rounded">assignment</span> Mensajes pendientes</h1>
          </div>
          <section class="card table-card">
            <header class="card-header intakes-head">
              <h2>Bandeja de entrada por revisar</h2>
              <div class="intakes-head-actions">
                <label class="intakes-source-filter" for="intakesSourceFilter">
                  <span class="material-symbols-rounded">filter_alt</span>
                  <select id="intakesSourceFilter" aria-label="Filtrar mensajes por canal">
                    <option value="all">Todos los canales</option>
                    <option value="telegram">Telegram</option>
                    <option value="web">Web/Formulario</option>
                    <option value="other">Otros</option>
                  </select>
                </label>
                <label class="intakes-source-filter" for="intakesPriorityFilter">
                  <span class="material-symbols-rounded">priority_high</span>
                  <select id="intakesPriorityFilter" aria-label="Filtrar mensajes por prioridad">
                    <option value="all">Todas las prioridades</option>
                    <option value="high">Prioridad alta</option>
                    <option value="normal">Prioridad normal</option>
                  </select>
                </label>
                <label class="intakes-source-filter" for="intakesAgeSort">
                  <span class="material-symbols-rounded">schedule</span>
                  <select id="intakesAgeSort" aria-label="Ordenar mensajes por antiguedad">
                    <option value="oldest">Mas antiguos primero</option>
                    <option value="newest">Mas recientes primero</option>
                  </select>
                </label>
                <button class="btn-ghost" id="refreshIntakesFull"><span class="material-symbols-rounded">refresh</span> Actualizar</button>
              </div>
            </header>
            <div class="intakes-source-summary" id="intakesSourceSummary" aria-live="polite"></div>
            <div class="table-wrap"><table><thead><tr><th>Paciente</th><th>Canal</th><th>Prioridad</th><th>Mensaje</th><th>Fecha</th><th>Estado</th><th>Acciones</th></tr></thead><tbody id="intakesFullBody"><tr class="empty-row"><td colspan="7"><div class="empty-state"><span class="material-symbols-rounded">hourglass_empty</span><p>Cargando bandeja...</p></div></td></tr></tbody></table></div>
          </section>
        </div>

        <!-- === PAGE: CITAS === -->
        <div class="page-section" data-page="citas">
          <div class="page-header-row agenda-header-row">
            <div class="agenda-header-copy">
              <h1 class="page-title"><span class="material-symbols-rounded">&#xebcc;</span> Agenda</h1>
              <div class="agenda-sync-status" id="agendaSyncStatus" aria-live="polite">
                <span class="status-chip pendiente" id="agendaSyncChip">Comprobando</span>
                <div class="agenda-sync-copy">
                  <strong id="agendaSyncTitle">Sync Google Calendar</strong>
                  <p id="agendaSyncMeta">Esperando estado del sincronizador...</p>
                  <div class="agenda-sync-facts" id="agendaSyncFacts" hidden></div>
                </div>
              </div>
            </div>
            <div class="week-nav-bar">
              <button class="btn-ghost btn-icon" id="prevWeek" title="Semana anterior"><span class="material-symbols-rounded">chevron_left</span></button>
              <span id="weekLabel" class="week-label">Cargando...</span>
              <button class="btn-ghost btn-icon" id="nextWeek" title="Semana siguiente"><span class="material-symbols-rounded">chevron_right</span></button>
              <button class="btn-ghost" id="thisWeek">Hoy</button>
              <button class="btn-ghost btn-icon" id="refreshCitas" title="Actualizar"><span class="material-symbols-rounded">refresh</span></button>
              <button class="btn-primary" id="openNewAppointmentBtn"><span class="material-symbols-rounded">add</span> Nueva cita</button>
            </div>
          </div>
