    toast.className = `toast-card toast-${tone}`;
    toast.setAttribute('role', tone === 'error' || tone === 'warning' ? 'alert' : 'status');
    const icon = tone === 'success' ? 'check_circle' : tone === 'warning' ? 'warning' : tone === 'error' ? 'error' : 'info';
    toast.innerHTML = `
      <span class="toast-icon material-symbols-rounded">${icon}</span>
      <div class="toast-copy">
        ${title ? `<strong>${escapeHtml(title)}</strong>` : ''}
        <p>${escapeHtml(message)}</p>
      </div>
      <button type="button" class="toast-close" aria-label="Cerrar aviso"><span class="material-symbols-rounded">close</span></button>
