  .sidebar.collapsed .nav-label,
  .sidebar.collapsed .brand-text,
  .sidebar.collapsed .badge { display: none; }

  .sidebar-brand {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.5rem 0.65rem 1.25rem;
  }
  .brand-icon {
    font-size: 28px;
    color: var(--accent);
    filter: drop-shadow(0 4px 10px var(--accent-glow));
  }
  .brand-text {
    font-weight: 700;
    font-size: 1.15rem;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }

  .sidebar-nav {
    display: flex;
    flex-direction: column;
    gap: 2px;
    flex: 1;
  }
  .sidebar-bottom {
    border-top: 1px solid var(--border);
    padding-top: 0.5rem;
    margin-top: 0.5rem;
  }

  .nav-item {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.6rem 0.75rem;
    border-radius: var(--radius-sm);
    color: var(--text-secondary);
    font-size: 0.9rem;
    font-weight: 500;
    transition: all var(--transition);
    position: relative;
    white-space: nowrap;
  }
  .nav-item:hover {
    background: var(--bg-elevated);
    color: var(--text-primary);
  }
  .nav-item.active {
    background: linear-gradient(90deg, rgba(44, 196, 184, 0.22) 0%, rgba(102, 163, 255, 0.2) 100%);
    color: var(--accent);
    box-shadow: 0 0 0 1px rgba(102, 163, 255, 0.26) inset;
  }
  .nav-item .material-symbols-rounded { font-size: 22px; flex-shrink: 0; }

  .badge {
    background: var(--danger);
    color: #fff;
    font-size: 0.7rem;
    font-weight: 700;
    padding: 1px 6px;
    border-radius: 99px;
    margin-left: auto;
    line-height: 1.4;
  }

  /* === MAIN AREA === */
  .main-area {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  /* === TOPBAR === */
  .topbar {
    height: 60px;
    background: rgba(13, 21, 35, 0.82);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
    display: flex;
    align-items: center;
    padding: 0 1.25rem;
    gap: 1rem;
  }
  .sidebar-toggle {
    background: none;
    border: none;
    color: var(--text-secondary);
    cursor: pointer;
    padding: 6px;
    border-radius: var(--radius-sm);
    display: flex;
    transition: all var(--transition);
  }
  .sidebar-toggle:hover { background: var(--bg-elevated); color: var(--text-primary); }

  .search-box {
    flex: 1;
    max-width: 420px;
    position: relative;
  }
  .search-icon {
    position: absolute;
    left: 12px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--text-muted);
    font-size: 20px;
  }
  .search-box input {
    width: 100%;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 0.52rem 0.75rem 0.52rem 2.5rem;
    color: var(--text-primary);
    font: inherit;
    font-size: 0.88rem;
    transition: border-color var(--transition);
  }
  .search-box input::placeholder { color: var(--text-muted); }
  .search-box input:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 4px var(--accent-soft);
  }

  .topbar-right {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-left: auto;
  }
  .icon-btn {
    background: none;
    border: none;
    color: var(--text-secondary);
    cursor: pointer;
    padding: 6px;
    border-radius: var(--radius-sm);
    position: relative;
    display: flex;
    transition: all var(--transition);
  }
  .icon-btn:hover { background: var(--bg-elevated); color: var(--text-primary); }
  .dot-indicator {
    position: absolute;
    top: 4px;
    right: 4px;
    width: 8px;
    height: 8px;
    background: var(--danger);
    border-radius: 50%;
    border: 2px solid var(--bg-card);
  }
  .user-pill {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    padding: 4px 10px 4px 4px;
    border-radius: 99px;
    background: var(--bg-card);
    border: 1px solid var(--border);
  }
  .avatar {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: linear-gradient(135deg, #0a7f78, #1f6fd6);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.72rem;
    font-weight: 700;
    color: #fff;
  }
  .user-name {
    font-size: 0.85rem;
    font-weight: 500;
    white-space: nowrap;
  }

  /* === CONTENT === */
  .content {
    flex: 1;
    padding: 1.4rem 2rem;
    overflow-y: auto;
    overflow-x: hidden;
    background: var(--bg-base);
  }
  
  /* === NEW DASHBOARD LAYOUT === */
  .dashboard-layout {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    max-width: 1400px;
    margin: 0 auto;
  }

  /* === HERO SECTION === */
  .hero-section {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.5rem 0;
    animation: fadeIn 0.4s ease-out;
  }
  .hero-content {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .hero-title {
    font-size: 1.85rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0;
    letter-spacing: -0.01em;
  }
  .hero-subtitle {
    font-size: 0.95rem;
    color: var(--text-muted);
    margin: 0;
    max-width: 600px;
  }
  .hero-actions .btn-primary {
    padding: 0.75rem 1.25rem;
    font-size: 0.95rem;
    border-radius: var(--radius-md);
  }

  /* === METRICS === */
  .metrics-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.25rem;
  }
  .metric-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1.4rem;
    display: flex;
    align-items: center;
    gap: 1.2rem;
    transition: all var(--transition);
    box-shadow: var(--shadow-sm);
    animation: card-enter 0.45s ease-out forwards;
    opacity: 0;
    transform: translateY(8px);
  }
  .metric-card:nth-child(1) { animation-delay: 0.04s; }
  .metric-card:nth-child(2) { animation-delay: 0.1s; }
  .metric-card:nth-child(3) { animation-delay: 0.16s; }

  @keyframes card-enter {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .metric-card:hover {
    border-color: var(--border-light);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }
  .metric-icon {
    width: 52px;
    height: 52px;
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .metric-icon .material-symbols-rounded { font-size: 26px; }
  .metric-data {
    display: flex;
    flex-direction: column;
  }
  .metric-value {
    font-size: 1.8rem;
    font-weight: 700;
    line-height: 1;
    color: var(--text-primary);
  }
  .metric-label {
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text-secondary);
    margin-top: 6px;
  }

  /* === CARD BASE === */
  .card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    animation: fadeIn 0.34s ease-out;
  }
  .card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid var(--border);
    background: var(--bg-surface);
  }
  .card-header h2 {
    font-size: 1rem;
    font-weight: 600;
    margin: 0;
    color: var(--text-primary);
  }
  .btn-ghost {
    background: none;
    border: none;
    color: var(--text-secondary);
    font: inherit;
    font-size: 0.85rem;
    font-weight: 500;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 6px 10px;
    border-radius: var(--radius-sm);
    transition: all var(--transition);
  }
  .btn-ghost:hover { color: var(--accent); background: var(--accent-soft); }
  .btn-ghost .material-symbols-rounded { font-size: 18px; }

  /* === CENTRAL AI MODULE === */
  .ai-clinical-module {
    display: flex;
    flex-direction: column;
    min-height: 480px;
  }
  .module-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.2rem 1.5rem;
    border-bottom: 1px solid var(--border);
    background: var(--bg-card);
  }
  .module-title {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .module-title h2 {
    font-size: 1.15rem;
    font-weight: 600;
    margin: 0;
    color: var(--text-primary);
  }
  .accent-icon {
    color: var(--accent);
    font-size: 26px;
    background: var(--accent-soft);
    padding: 8px;
    border-radius: var(--radius-md);
  }
  .agent-status-pill {
    display: flex;
    align-items: center;
    gap: 6px;
    background: var(--bg-surface);
    padding: 4px 12px;
    border-radius: 99px;
    border: 1px solid var(--border);
  }

  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .status-dot.connected {
    background: var(--success);
    box-shadow: 0 0 6px rgba(16, 185, 129, 0.4);
    animation: pulse-dot 2s infinite;
  }
  .status-dot.disconnected { background: var(--danger); }
  .status-text { font-size: 0.8rem; font-weight: 500; color: var(--text-secondary); }

  @keyframes pulse-dot {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.5; }
  }

  .ai-workspace {
    display: flex;
    flex-direction: column;
    flex: 1;
    background: var(--bg-surface);
  }
  
  /* CHAT LOG */
  .chat-log {
    flex: 1;
    overflow-y: auto;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
    min-height: 250px;
    background: var(--bg-base);
  }
  .msg {
    display: flex;
    gap: 0.75rem;
    max-width: 85%;
    animation: msg-in 0.25s ease-out;
  }
  .msg.user { flex-direction: row-reverse; align-self: flex-end; }
  .msg.agent { align-self: flex-start; }

  @keyframes msg-in {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .msg-avatar {
    width: 36px;
    height: 36px;
    border-radius: var(--radius-md);
    background: var(--bg-card);
    border: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    box-shadow: var(--shadow-sm);
  }
  .msg.agent .msg-avatar { background: var(--accent-soft); border-color: transparent; }
  .msg.agent .msg-avatar .material-symbols-rounded { font-size: 20px; color: var(--accent); }
  .msg.user .msg-avatar .material-symbols-rounded { font-size: 20px; color: var(--text-secondary); }

  .msg-body {
    border-radius: var(--radius-lg);
    padding: 0.85rem 1.15rem;
    font-size: 0.92rem;
    line-height: 1.5;
    overflow-wrap: anywhere;
    box-shadow: var(--shadow-sm);
  }
  .msg.agent .msg-body { background: var(--bg-card); border: 1px solid var(--border); color: var(--text-primary); border-top-left-radius: 4px; }
  .msg.user .msg-body { background: var(--info); color: white; border-top-right-radius: 4px; box-shadow: 0 4px 6px -1px rgba(59, 130, 246, 0.2); }
  .msg-progress .msg-avatar .material-symbols-rounded {
    animation: spin 1.1s linear infinite;
  }
  .msg-progress .msg-body {
    border-style: dashed;
    background: linear-gradient(180deg, #ffffff, #f8fafc);
  }
  .msg-body p { margin: 0; white-space: pre-line; }
  .msg-sender {
    display: block;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-muted);
    margin-bottom: 4px;
  }
  .msg.agent .msg-sender { color: var(--accent); }
  .msg.user .msg-sender { color: rgba(255,255,255,0.8); }

  /* AI INPUT AREA */
  .ai-input-area {
    padding: 1.25rem 1.5rem;
    background: var(--bg-card);
    border-top: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .ai-input-area.is-busy {
    opacity: 0.92;
  }
  .ai-controls {
    display: flex;
    justify-content: flex-start;
    align-items: center;
  }
  .patient-selector {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 0.45rem 0.85rem;
    transition: border-color var(--transition);
  }
  .patient-selector:focus-within {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-soft);
  }
  .patient-selector select {
    border: none;
    background: transparent;
    font: inherit;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--text-primary);
    outline: none;
    width: 240px;
    cursor: pointer;
  }
  .patient-selector .material-symbols-rounded {
    font-size: 20px;
    color: var(--accent);
  }
  
  .ai-textarea-wrapper {
    position: relative;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--bg-surface);
    transition: all 0.2s;
    box-shadow: inset 0 2px 4px rgba(0,0,0,0.02);
  }
  .ai-textarea-wrapper:focus-within {
    border-color: var(--accent);
    box-shadow: 0 0 0 4px var(--accent-soft);
    background: var(--bg-card);
  }
  .ai-textarea-wrapper textarea {
    width: 100%;
    border: none;
    background: transparent;
    padding: 1rem 1.15rem;
    font: inherit;
    font-size: 0.95rem;
    color: var(--text-primary);
    resize: vertical;
    min-height: 80px;
    outline: none;
    line-height: 1.5;
  }
  .ai-textarea-wrapper textarea::placeholder {
    color: var(--text-muted);
  }
  .ai-actions {
    display: flex;
    justify-content: flex-end;
    padding: 0.5rem 1.15rem 1rem;
  }
  .action-buttons {
    display: flex;
    gap: 0.75rem;
  }
  .btn-action {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 0.65rem 1.15rem;
    border-radius: var(--radius-md);
    font: inherit;
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    border: none;
    transition: all 0.2s;
  }
  .btn-action.is-loading {
    cursor: wait;
  }
  .btn-generate {
    background: var(--accent);
    color: white;
    box-shadow: 0 4px 6px -1px var(--accent-soft);
  }
  .btn-generate:hover {
    background: #0d655f;
    transform: translateY(-1px);
    box-shadow: 0 6px 8px -1px var(--accent-soft);
  }
  .btn-generate:disabled { opacity: 0.5; cursor: not-allowed; transform: none; box-shadow: none; }
  
  .btn-pdf {
    background: var(--bg-surface);
    color: var(--text-secondary);
    border: 1px solid var(--border);
  }
  .btn-pdf:hover {
    border-color: var(--danger);
    color: var(--danger);
    background: rgba(239, 68, 68, 0.05);
  }
  .btn-pdf:disabled { opacity: 0.5; cursor: not-allowed; }

  .btn-chat {
    background: var(--bg-surface);
    color: var(--text-secondary);
    border: 1px solid var(--border);
    padding: 0.65rem 0.85rem;
  }
  .btn-chat:hover {
    background: var(--info);
    color: white;
    border-color: var(--info);
  }
  .btn-chat:disabled { opacity: 0.5; cursor: not-allowed; }

  /* === DASHBOARD BOTTOM ROW === */
  .dashboard-bottom-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
    gap: 1.5rem;
  }
  .widget-card {
    min-height: 280px;
    display: flex;
    flex-direction: column;
  }
  .widget-body {
    flex: 1;
    overflow-y: auto;
  }
  .list-clean {
    padding: 0;
  }
  
  /* Modern Clean Lists */
  .clean-list-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid var(--border);
    transition: background var(--transition);
  }
  .clean-list-item:last-child {
    border-bottom: none;
  }
  .clean-list-item:hover {
    background: var(--bg-card-hover);
  }
  .clean-list-main {
    min-width: 0;
    display: grid;
    gap: 0.2rem;
  }
  .clean-list-title {
    margin: 0;
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--text-primary);
  }
  .clean-list-meta {
    margin: 0;
    font-size: 0.8rem;
    color: var(--text-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .clean-list-action {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-left: 0.75rem;
    flex-shrink: 0;
  }

  .empty-state-sm {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 3rem 1.5rem;
    color: var(--text-muted);
    text-align: center;
    height: 100%;
  }
  .empty-state-sm .material-symbols-rounded {
    font-size: 36px;
    margin-bottom: 0.75rem;
    color: var(--border-light);
  }
  .empty-state-sm p {
    margin: 0;
    font-size: 0.95rem;
    font-weight: 500;
  }

  /* === TABLE OVERRIDES === */
  .table-wrap { overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; }
  th {
    text-align: left;
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
    padding: 0.85rem 1.25rem;
    border-bottom: 1px solid var(--border);
    background: var(--bg-surface);
  }
  td {
    padding: 1rem 1.25rem;
    font-size: 0.9rem;
    border-bottom: 1px solid var(--border);
    vertical-align: middle;
    color: var(--text-primary);
  }
  tr:last-child td { border-bottom: none; }
  tr:hover td { background: var(--bg-card-hover); }
  .td-patient { font-weight: 600; color: var(--text-primary); }

  .status-chip {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 0.8rem;
    font-weight: 600;
    padding: 4px 12px;
    border-radius: 99px;
    text-transform: capitalize;
  }
  .status-chip.pendiente,
  .status-chip.pendiente_revision { background: rgba(245,158,11,0.15); color: #d97706; }
  .status-chip.confirmada,
  .status-chip.reprogramada { background: rgba(59,130,246,0.15); color: var(--info); }
  .status-chip.aprobado,
  .status-chip.enviado,
  .status-chip.completada { background: rgba(16,185,129,0.15); color: var(--success); }
  .status-chip.rechazado,
  .status-chip.cancelada,
  .status-chip.no_show { background: rgba(239,68,68,0.15); color: var(--danger); }

  .btn-sm {
    background: var(--bg-surface);
    color: var(--text-secondary);
    border: 1px solid var(--border);
    font: inherit;
    font-size: 0.85rem;
    font-weight: 600;
    padding: 6px 14px;
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: all var(--transition);
  }
  .btn-sm:hover { color: var(--text-primary); background: var(--border); }
  .btn-sm:disabled { opacity: 0.5; cursor: not-allowed; }

  .empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 4rem 2rem;
    color: var(--text-muted);
    text-align: center;
  }
  .empty-state .material-symbols-rounded { 
    font-size: 48px; 
    margin-bottom: 1rem; 
    color: var(--border-light); 
  }
  .empty-state p {
    font-size: 1.05rem;
    font-weight: 500;
    margin: 0;
  }
  .state-loading .material-symbols-rounded {
    animation: spin 1.1s linear infinite;
  }

  @keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  /* === SPA SECTION STYLES === */
  .page-section {
    display: none;
    animation: fadeIn 0.34s ease-out;
  }
  .page-section.active {
    display: block;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(5px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .page-header-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2rem;
  }

  .page-tools {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .inline-field {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .inline-field select {
    min-width: 240px;
    max-width: 320px;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 0.36rem 0.5rem;
    color: var(--text-primary);
    font: inherit;
  }
  .inline-field select:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 4px var(--accent-soft);
  }
  
  .page-title {
    font-size: 1.56rem;
    font-weight: 700;
    color: var(--text-primary);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  /* === CONFIG GRID === */
  .config-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
    gap: 1.5rem;
  }
  
  .config-item {
