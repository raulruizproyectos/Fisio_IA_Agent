  const inputArea = document.querySelector('.ai-input-area') as HTMLElement | null;
  const dashCitasBody = document.getElementById('dashCitasBody') as HTMLElement | null;
  const intakeBody = document.getElementById('intakeBody') as HTMLElement | null;
  const refreshBtn = document.getElementById('refreshIntakes') as HTMLElement | null;
  const pacientesBody = document.getElementById('pacientesBody') as HTMLElement | null;
  const templatesBody = document.getElementById('templatesBody') as HTMLElement | null;
  const templateTargetPatient = document.getElementById('templateTargetPatient') as HTMLSelectElement | null;
  const chatPatientSelect = document.getElementById('chatPatientSelect') as HTMLSelectElement | null;
  const intakesFullBody = document.getElementById('intakesFullBody') as HTMLElement | null;
  const citasBody = document.getElementById('citasBody') as HTMLElement | null;
  const historialContent = document.getElementById('historialContent') as HTMLElement | null;
  const addPatientBtn = document.getElementById('addPatientBtn') as HTMLButtonElement | null;
  const patientModal = document.getElementById('patientModal') as HTMLElement | null;
  const patientForm = document.getElementById('patientForm') as HTMLFormElement | null;
  const patientNameInput = document.getElementById('patientNameInput') as HTMLInputElement | null;
  const patientEmailInput = document.getElementById('patientEmailInput') as HTMLInputElement | null;
  const patientPhoneInput = document.getElementById('patientPhoneInput') as HTMLInputElement | null;
  const patientBirthDateInput = document.getElementById('patientBirthDateInput') as HTMLInputElement | null;
  const patientFormFeedback = document.getElementById('patientFormFeedback') as HTMLElement | null;
  const patientSubmitBtn = document.getElementById('patientSubmitBtn') as HTMLButtonElement | null;
  const closePatientModalBtn = document.getElementById('closePatientModalBtn') as HTMLButtonElement | null;
  const patientModalDismiss = document.getElementById('patientModalDismiss') as HTMLButtonElement | null;
  const searchBox = document.querySelector('.search-box') as HTMLElement | null;
  const searchInput = document.getElementById('searchInput') as HTMLInputElement | null;
  const searchResults = document.getElementById('searchResults') as HTMLElement | null;
  const appointmentForm = document.getElementById('appointmentForm') as HTMLFormElement | null;
  const appointmentPatientSelect = document.getElementById('appointmentPatientSelect') as HTMLSelectElement | null;
  const appointmentStartInput = document.getElementById('appointmentStartInput') as HTMLInputElement | null;
  const appointmentEndInput = document.getElementById('appointmentEndInput') as HTMLInputElement | null;
  const appointmentReasonInput = document.getElementById('appointmentReasonInput') as HTMLTextAreaElement | null;
  const appointmentFormFeedback = document.getElementById('appointmentFormFeedback') as HTMLElement | null;
  const appointmentSubmitBtn = document.getElementById('appointmentSubmitBtn') as HTMLButtonElement | null;

  // === HELPERS ===
  const MOJIBAKE_RE = /(?:\u00C3|\u00C2|\u00E2|\u00F0|\u00D0|\u00D1|\uFFFD|\u0153|\u0152|\u0161|\u0178|\u00EF\u00BF\u00BD)/;
  const CP1252_UNICODE_TO_BYTE: Record<number, number> = {
    0x20ac: 0x80,
    0x201a: 0x82,
    0x0192: 0x83,
    0x201e: 0x84,
    0x2026: 0x85,
    0x2020: 0x86,
    0x2021: 0x87,
    0x02c6: 0x88,
    0x2030: 0x89,
    0x0160: 0x8a,
    0x2039: 0x8b,
    0x0152: 0x8c,
    0x017d: 0x8e,
    0x2018: 0x91,
    0x2019: 0x92,
    0x201c: 0x93,
    0x201d: 0x94,
    0x2022: 0x95,
    0x2013: 0x96,
    0x2014: 0x97,
    0x02dc: 0x98,
    0x2122: 0x99,
    0x0161: 0x9a,
    0x203a: 0x9b,
    0x0153: 0x9c,
    0x017e: 0x9e,
    0x0178: 0x9f,
  };
  const toLegacyBytes = (text: string) => {
    const bytes: number[] = [];
    for (const ch of text) {
      const code = ch.codePointAt(0) ?? 0;
      if (code <= 0xff) {
        bytes.push(code);
        continue;
      }
      const mapped = CP1252_UNICODE_TO_BYTE[code];
      if (typeof mapped === 'number') {
        bytes.push(mapped);
        continue;
      }
      return null;
    }
    return new Uint8Array(bytes);
  };
  const decodeUtf8Bytes = (bytes: Uint8Array) => {
    try {
      return new TextDecoder('utf-8', { fatal: true }).decode(bytes);
    } catch {
      try {
        return new TextDecoder('utf-8').decode(bytes);
      } catch {
        return '';
      }
    }
  };
  const maybeDecodeMojibake = (value: unknown) => {
    let current = String(value ?? '');
    if (!MOJIBAKE_RE.test(current)) return current;

    for (let pass = 0; pass < 3; pass += 1) {
      const bytes = toLegacyBytes(current);
      if (!bytes) break;
      const decoded = decodeUtf8Bytes(bytes);
      if (!decoded || decoded === current) break;
      current = decoded;
      if (!MOJIBAKE_RE.test(current)) break;
    }

    return current.normalize('NFC');
  };
  const sanitizeText = (value: unknown) => maybeDecodeMojibake(value).replace(/\u0000/g, '');
  const sanitizePayload = (value: any): any => {
    if (typeof value === 'string') return sanitizeText(value);
    if (Array.isArray(value)) return value.map((item) => sanitizePayload(item));
    if (value && typeof value === 'object') {
      const output: Record<string, any> = {};
      Object.entries(value).forEach(([key, item]) => {
        output[key] = sanitizePayload(item);
      });
      return output;
    }
    return value;
  };
  const escapeHtml = (str: unknown) => sanitizeText(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
  const escapeAttr = (str: unknown) => escapeHtml(str).replace(/"/g, '&quot;').replace(/'/g, '&#39;');
  const fmtDate = (d: string) => { try { return new Date(d).toLocaleDateString('es-ES',{day:'2-digit',month:'short',hour:'2-digit',minute:'2-digit'}); } catch { return '—'; } };
  const isTodayDate = (d: string) => {
    try {
      const target = new Date(d);
      const now = new Date();
      return target.getFullYear() === now.getFullYear() && target.getMonth() === now.getMonth() && target.getDate() === now.getDate();
    } catch {
      return false;
    }
  };
  const fetchJson = async (url: string, opts?: RequestInit, timeoutMs = 8000) => {
    const r = await fetch(url, { signal: AbortSignal.timeout(timeoutMs), ...opts });
    if (!r.ok) {
      let detail = '';
      try {
        detail = await r.text();
      } catch {
        detail = '';
      }
      throw new Error(detail ? `HTTP ${r.status}: ${detail.slice(0, 220)}` : `HTTP ${r.status}`);
    }
    const payload = await r.json();
    return sanitizePayload(payload);
  };
  const sanitizePageTextNodes = () => {
    const walker = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT);
    const updates: Array<{ node: Text; value: string }> = [];
    let current = walker.nextNode();
    while (current) {
      const node = current as Text;
      const original = node.nodeValue || '';
      if (MOJIBAKE_RE.test(original)) {
        const fixed = maybeDecodeMojibake(original);
        if (fixed && fixed !== original) {
          updates.push({ node, value: fixed });
        }
      }
      current = walker.nextNode();
    }
    updates.forEach(({ node, value }) => {
      node.nodeValue = value;
    });
  };
  const sanitizeCommonAttributes = () => {
    const attrs = ['title', 'aria-label', 'placeholder'];
    const selector = '[title],[aria-label],[placeholder]';
    const nodes = document.querySelectorAll(selector);
    nodes.forEach((element) => {
      attrs.forEach((attr) => {
        const original = element.getAttribute(attr);
        if (!original || !MOJIBAKE_RE.test(original)) return;
        const fixed = maybeDecodeMojibake(original);
        if (fixed && fixed !== original) {
          element.setAttribute(attr, fixed);
        }
      });
    });
  };
  sanitizePageTextNodes();
  sanitizeCommonAttributes();
  const isTimeoutError = (err: any) => {
    const msg = String(err?.message || '').toLowerCase();
    return err?.name === 'TimeoutError' || msg.includes('timed out') || msg.includes('abort');
  };
  const resolvePatientName = (row: any) =>
    row?.nombre_paciente ||
    row?.pacientes?.nombre_completo ||
    row?.paciente?.nombre_completo ||
    (row?.paciente_id ? `Paciente #${row.paciente_id}` : 'Paciente sin identificar');
  const focusHistoryAnchor = (anchor: 'telegram') => {
    const targetId = anchor === 'telegram' ? 'patientTelegramLinkBlock' : '';
    if (!targetId) return;

    window.requestAnimationFrame(() => {
      const target = document.getElementById(targetId);
      if (!target) return;
      target.classList.add('detail-block-spotlight');
      target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      window.setTimeout(() => target.classList.remove('detail-block-spotlight'), 1800);
    });
  };

  const openPatientHistory = (patientId: string | null, patientName = '') => {
    if (!patientId) return;
    selectedPatientId = patientId;
    selectedPatientName = patientName || '';
    selectedTemplatePatientId = patientId;
    renderTemplatePatientOptions();
    syncChatPatientSelection(patientId, patientName);
    if (appointmentPatientSelect) appointmentPatientSelect.value = patientId;
    navigateTo('historial');
    loadHistorial();
  };

  // === SPA ROUTING ===
  const navItems = document.querySelectorAll('.nav-item[data-section]');
  const pages = document.querySelectorAll('.page-section');
  const pageLoaders: Record<string, () => void> = {};
  let selectedPatientId: string | null = null;
  let selectedPatientName = '';
  let patientCatalog: Array<{ id: string; nombre_completo: string; email?: string | null }> = [];
  let selectedTemplatePatientId: string | null = null;
  let currentPatientTelegramLinkState: any = null;
  let pendingHistoryAnchor: 'telegram' | null = null;
  let lastExerciseReportPayload: any = null;
  let pendingExerciseRecommendationJobId: string | null = null;
  const exerciseOpsStats = {
    timeouts: 0,
    retries: 0,
  };
  const processedEngineObservability = new Set<string>();
  const archivedReportIds = new Set<string>();
  let quickSearchMatches: Array<{ id: string; nombre_completo: string; email?: string | null }> = [];
  let quickSearchActiveIndex = -1;

  const renderAssistantPatientContext = () => {
    if (!assistantPatientLabel || !assistantPatientMeta) return;

    if (!selectedPatientId) {
      assistantPatientLabel.textContent = 'Sin paciente seleccionado';
      assistantPatientMeta.textContent = 'Selecciona uno para vincular la conversacion, el plan y el PDF a su historial.';
      return;
    }

    const selected = patientCatalog.find((patient) => patient.id === selectedPatientId);
    const displayName = selected?.nombre_completo || selectedPatientName || `Paciente ${selectedPatientId}`;
    assistantPatientLabel.textContent = displayName;
    assistantPatientMeta.textContent = selected?.email
      ? `Informe y conversación vinculados a ${selected.email}.`
      : 'Informe, PDF y seguimiento vinculados al historial del paciente.';
  };

  const updateAssistantPatientSelectorState = () => {
    if (!chatPatientSelect) return;
    const hasValue = Boolean(chatPatientSelect.value);
    chatPatientSelect.classList.toggle('has-value', hasValue);
    const selectorShell = chatPatientSelect.closest('.patient-selector');
    selectorShell?.classList.toggle('has-value', hasValue);
  };

  function syncChatPatientSelection(patientId: string | null, fallbackName = '') {
    if (!chatPatientSelect) return;
    const nextId = patientId || '';
    chatPatientSelect.value = nextId;
    selectedPatientId = nextId || null;
    updateAssistantPatientSelectorState();

    if (!nextId) {
      selectedPatientName = '';
      renderAssistantPatientContext();
      return;
    }

    const selected = patientCatalog.find((p) => p.id === nextId);
    selectedPatientName = selected?.nombre_completo || fallbackName || selectedPatientName || '';
    renderAssistantPatientContext();
  }

  const renderExerciseOpsMetric = () => {
    if (!metricEngineOps) return;
    metricEngineOps.textContent = `${exerciseOpsStats.timeouts}/${exerciseOpsStats.retries}`;
  };
  renderExerciseOpsMetric();

  const incrementArchivedReportsMetric = (recommendationId: string | null) => {
    const metricEl = document.getElementById('metricInformes');
    if (!metricEl) return;
    if (recommendationId && archivedReportIds.has(recommendationId)) return;

    const current = parseInt(metricEl.textContent || '0', 10);
    metricEl.textContent = Number.isFinite(current) ? String(current + 1) : '1';

    if (recommendationId) {
      archivedReportIds.add(recommendationId);
    }
  };

  const syncEngineOpsFromPayload = (payload: any) => {
    const requestId = String(payload?.request_id || '').trim();
    if (requestId && processedEngineObservability.has(requestId)) return;

    const engineObs = payload?.engine_observability || {};
    const retriesUsed = Number(engineObs?.retries_used || 0);
    const attemptsDetail = Array.isArray(engineObs?.attempts_detail) ? engineObs.attempts_detail : [];
    const timedOutCount = attemptsDetail.filter((entry: any) => Boolean(entry?.timed_out)).length;

    if (retriesUsed > 0) {
      exerciseOpsStats.retries += retriesUsed;
    }
    if (timedOutCount > 0) {
      exerciseOpsStats.timeouts += timedOutCount;
    }

    if (requestId) {
      processedEngineObservability.add(requestId);
    }
    renderExerciseOpsMetric();
  };

  const navigateTo = (section: string) => {
    navItems.forEach(n => n.classList.toggle('active', n.getAttribute('data-section') === section));
    pages.forEach(p => {
      const isActive = (p as HTMLElement).dataset.page === section;
      p.classList.toggle('active', isActive);
    });
    if (pageLoaders[section]) pageLoaders[section]();
  };
  navItems.forEach(n => n.addEventListener('click', (e: Event) => { e.preventDefault(); navigateTo(n.getAttribute('data-section') || 'dashboard'); }));

  // === SIDEBAR TOGGLE (responsive) ===
  const sidebarBackdrop = document.getElementById('sidebarBackdrop') as HTMLElement | null;
  const isMobile = () => window.innerWidth <= 768;
  const isCompactAssistantViewport = () => window.innerWidth <= 1100;

  const syncOverlayBodyLock = () => {
    const sidebarOpen = Boolean(sidebar?.classList.contains('open'));
    const assistantOpen = Boolean(isCompactAssistantViewport() && assistantRail?.classList.contains('open'));
    document.body.style.overflow = sidebarOpen || assistantOpen ? 'hidden' : '';
  };

  const openSidebar = () => {
    sidebar?.classList.add('open');
    sidebarBackdrop?.classList.add('visible');
    syncOverlayBodyLock();
  };
  const closeSidebar = () => {
    sidebar?.classList.remove('open');
    sidebarBackdrop?.classList.remove('visible');
    syncOverlayBodyLock();
  };

  const openAssistantRail = () => {
    if (!isCompactAssistantViewport()) {
      input?.focus();
      return;
    }
    assistantRail?.classList.add('open');
    assistantRailBackdrop?.classList.add('visible');
    assistantRailToggle?.setAttribute('aria-expanded', 'true');
    syncOverlayBodyLock();
    window.setTimeout(() => input?.focus(), 120);
  };

  const closeAssistantRail = () => {
    assistantRail?.classList.remove('open');
    assistantRailBackdrop?.classList.remove('visible');
    assistantRailToggle?.setAttribute('aria-expanded', 'false');
    syncOverlayBodyLock();
  };

  sidebarToggle?.addEventListener('click', () => {
    if (isMobile()) {
      sidebar?.classList.contains('open') ? closeSidebar() : openSidebar();
    } else {
      sidebar?.classList.toggle('collapsed');
    }
  });
  sidebarBackdrop?.addEventListener('click', closeSidebar);

  assistantRailToggle?.addEventListener('click', () => {
    if (isCompactAssistantViewport()) {
      assistantRail?.classList.contains('open') ? closeAssistantRail() : openAssistantRail();
      return;
    }
    input?.focus();
  });
  assistantRailClose?.addEventListener('click', closeAssistantRail);
  assistantRailBackdrop?.addEventListener('click', closeAssistantRail);
  focusAgentNav?.addEventListener('click', (event: Event) => {
    event.preventDefault();
    openAssistantRail();
    input?.focus();
  });
  heroAgentShortcutBtn?.addEventListener('click', () => {
    openAssistantRail();
    input?.focus();
  });

  // Close sidebar on nav click (mobile)
  navItems.forEach(n => n.addEventListener('click', () => { if (isMobile()) closeSidebar(); }));

  // Clean up on resize
  window.addEventListener('resize', () => {
    if (!isMobile()) closeSidebar();
    if (!isCompactAssistantViewport()) {
      assistantRail?.classList.remove('open');
      assistantRailBackdrop?.classList.remove('visible');
      assistantRailToggle?.setAttribute('aria-expanded', 'false');
      syncOverlayBodyLock();
    }
  });

  // === CHAT ===
  const scrollAssistantRailToBottom = () => {
    if (!log) return;
    log.scrollTop = log.scrollHeight;
  };
  const addMessage = (text: string, type: 'user' | 'agent') => {
    if (!log) return;
    const article = document.createElement('article');
    article.className = `msg ${type}`;
    if (type === 'agent') {
      article.innerHTML = `<div class="msg-avatar"><span class="material-symbols-rounded">psychology</span></div><div class="msg-body"><span class="msg-sender">Agente IA</span><p>${escapeHtml(text)}</p></div>`;
    } else {
      article.innerHTML = `<div class="msg-body user-msg"><p>${escapeHtml(text)}</p></div>`;
    }
    log.appendChild(article);
    scrollAssistantRailToBottom();
  };
  const setAgentStatus = (connected: boolean) => { agentDot?.classList.toggle('connected',connected); agentDot?.classList.toggle('disconnected',!connected); if(agentStatusText) agentStatusText.textContent=connected?'Conectado':'Sin conexión'; };
  const exerciseBtnDefaultHtml = exerciseBtn?.innerHTML || '';
  const sendBtnDefaultHtml = sendBtn?.innerHTML || '';
  const setSending = (busy: boolean, context: 'generic' | 'exercise' | 'chat' = 'generic') => {
    if (sendBtn) sendBtn.disabled = busy;
    if (exerciseBtn) exerciseBtn.disabled = busy;
    if (exercisePdfBtn) exercisePdfBtn.disabled = busy;
    if (input) input.disabled = busy;
    if (chatPatientSelect) chatPatientSelect.disabled = busy;
    inputArea?.classList.toggle('is-busy', busy);

    if (exerciseBtn) {
      if (busy && context === 'exercise') {
        exerciseBtn.classList.add('is-loading');
        exerciseBtn.innerHTML = '<span class="material-symbols-rounded">hourglass_top</span> Generando...';
      } else {
        exerciseBtn.classList.remove('is-loading');
        exerciseBtn.innerHTML = exerciseBtnDefaultHtml;
      }
    }

    if (sendBtn) {
      if (busy && context === 'chat') {
        sendBtn.classList.add('is-loading');
        sendBtn.innerHTML = '<span class="material-symbols-rounded">hourglass_top</span>';
      } else {
        sendBtn.classList.remove('is-loading');
        sendBtn.innerHTML = sendBtnDefaultHtml;
      }
    }
  };
  const renderState = (icon: string, text: string, compact = false, loading = false) => {
    const cls = compact ? 'empty-state-sm' : 'empty-state';
    const loadingCls = loading ? ' state-loading' : '';
    return `<div class="${cls}${loadingCls}"><span class="material-symbols-rounded">${icon}</span><p>${escapeHtml(text)}</p></div>`;
  };
  const setTableState = (tbody: HTMLElement | null, colspan: number, icon: string, text: string, loading = false) => {
    if (!tbody) return;
    tbody.innerHTML = `<tr class="empty-row"><td colspan="${colspan}">${renderState(icon, text, false, loading)}</td></tr>`;
  };
  const setListState = (container: HTMLElement | null, icon: string, text: string, loading = false) => {
    if (!container) return;
    container.innerHTML = renderState(icon, text, true, loading);
  };
  const upsertAgentProgress = (text: string) => {
    if (!log) return;
    let progress = log.querySelector('#agentProgressMsg') as HTMLElement | null;
    if (!progress) {
      progress = document.createElement('article');
      progress.id = 'agentProgressMsg';
      progress.className = 'msg agent msg-progress';
      progress.innerHTML = '<div class="msg-avatar"><span class="material-symbols-rounded">sync</span></div><div class="msg-body"><span class="msg-sender">Asistente clínico</span><p></p></div>';
      log.appendChild(progress);
    }
    const p = progress.querySelector('p');
    if (p) p.textContent = text;
    scrollAssistantRailToBottom();
  };
  const clearAgentProgress = () => {
    const progress = log?.querySelector('#agentProgressMsg') as HTMLElement | null;
    progress?.remove();
  };
  const resizeAgentInput = () => {
    if (!input) return;
    const viewportHeight = window.innerHeight || 900;
    const minHeight = viewportHeight < 900 ? 96 : 116;
    const maxHeight = viewportHeight < 900 ? 148 : 176;
    input.style.height = 'auto';
    input.style.height = `${Math.min(Math.max(input.scrollHeight, minHeight), maxHeight)}px`;
  };

  input?.addEventListener('keydown', (e: KeyboardEvent) => { if(e.ctrlKey && e.key==='Enter'){e.preventDefault();form?.requestSubmit();} });
  input?.addEventListener('input', resizeAgentInput);
  window.requestAnimationFrame(resizeAgentInput);

  assistantShortcuts?.addEventListener('click', (event: Event) => {
    const target = event.target as HTMLElement | null;
    const shortcut = target?.closest('[data-agent-shortcut]') as HTMLButtonElement | null;
    const prompt = shortcut?.getAttribute('data-agent-shortcut')?.trim();
    if (!prompt || !input) return;
    input.value = prompt;
    resizeAgentInput();
    input.focus();
    input.setSelectionRange(input.value.length, input.value.length);
  });

  const renderTemplatePatientOptions = () => {
    if (!templateTargetPatient) return;
    const current = selectedTemplatePatientId || templateTargetPatient.value || '';
    const options = ['<option value="">Selecciona paciente</option>']
      .concat(
        patientCatalog.map((p) => {
          const label = `${p.nombre_completo || `Paciente ${p.id}`} ${p.email ? ` - ${p.email}` : ''}`.trim();
          return `<option value="${escapeAttr(p.id)}">${escapeHtml(label)}</option>`;
        })
      );
    templateTargetPatient.innerHTML = options.join('');
    templateTargetPatient.value = current;
    selectedTemplatePatientId = templateTargetPatient.value || null;
  };

  const renderChatPatientOptions = () => {
    if (!chatPatientSelect) return;
    const current = selectedPatientId || chatPatientSelect.value || '';
    const options = ['<option value="">Selecciona paciente...</option>']
      .concat(
        patientCatalog.map((p) => {
          const label = `${p.nombre_completo || `Paciente ${p.id}`} ${p.email ? ` - ${p.email}` : ''}`.trim();
          return `<option value="${escapeAttr(p.id)}">${escapeHtml(label)}</option>`;
        })
      );
    chatPatientSelect.innerHTML = options.join('');
    const hasCurrent = Boolean(current) && patientCatalog.some((p) => p.id === current);
    syncChatPatientSelection(hasCurrent ? current : '', selectedPatientName);
  };

  const renderAppointmentPatientOptions = () => {
    if (!appointmentPatientSelect) return;
    const current = selectedPatientId || appointmentPatientSelect.value || '';
    const options = ['<option value="">Selecciona paciente</option>']
      .concat(
        patientCatalog.map((p) => {
          const label = `${p.nombre_completo || `Paciente ${p.id}`} ${p.email ? ` - ${p.email}` : ''}`.trim();
          return `<option value="${escapeAttr(p.id)}">${escapeHtml(label)}</option>`;
        })
      );
    appointmentPatientSelect.innerHTML = options.join('');
    if (current && patientCatalog.some((p) => p.id === current)) {
      appointmentPatientSelect.value = current;
    }
  };

  const toDateTimeLocalValue = (date: Date) => {
    const offset = date.getTimezoneOffset();
    const local = new Date(date.getTime() - offset * 60000);
    return local.toISOString().slice(0, 16);
  };

  const setAppointmentFormDefaults = (force = false) => {
    if (appointmentPatientSelect && selectedPatientId) {
      appointmentPatientSelect.value = selectedPatientId;
    }
    if (!appointmentStartInput || !appointmentEndInput) return;
    if (!force && appointmentStartInput.value && appointmentEndInput.value) return;
    const start = new Date();
    start.setSeconds(0, 0);
    const roundedMinutes = Math.ceil(start.getMinutes() / 30) * 30;
    start.setMinutes(roundedMinutes, 0, 0);
    if (roundedMinutes === 60) {
      start.setHours(start.getHours() + 1, 0, 0, 0);
    }
    const end = new Date(start.getTime() + 30 * 60000);
    appointmentStartInput.value = toDateTimeLocalValue(start);
    appointmentEndInput.value = toDateTimeLocalValue(end);
  };

  const setAppointmentFormFeedback = (text = '', state: 'error' | 'success' = 'error') => {
    if (!appointmentFormFeedback) return;
    if (!text) {
      appointmentFormFeedback.hidden = true;
      appointmentFormFeedback.textContent = '';
      appointmentFormFeedback.removeAttribute('data-state');
      return;
    }
    appointmentFormFeedback.hidden = false;
    appointmentFormFeedback.textContent = text;
    appointmentFormFeedback.setAttribute('data-state', state);
  };

  const fetchPatientCatalog = async () => {
    const payload = await fetchJson(`${BACKEND_BASE}/api/pacientes`);
    const pts = payload.data || [];
    patientCatalog = pts.map((p: any) => ({
      id: p.id,
      nombre_completo: p.nombre_completo || `Paciente ${p.id}`,
      email: p.email || null,
    }));
    renderTemplatePatientOptions();
    renderChatPatientOptions();
    renderAppointmentPatientOptions();
    return pts;
  };

  const setPatientFormFeedback = (text = '', state: 'error' | 'success' = 'error') => {
    if (!patientFormFeedback) return;
    if (!text) {
      patientFormFeedback.hidden = true;
      patientFormFeedback.textContent = '';
      patientFormFeedback.removeAttribute('data-state');
      return;
    }

    patientFormFeedback.hidden = false;
    patientFormFeedback.textContent = text;
    patientFormFeedback.setAttribute('data-state', state);
  };

  const resetPatientForm = () => {
    patientForm?.reset();
    setPatientFormFeedback();
  };

  const openPatientModal = () => {
    resetPatientForm();
    patientModal?.classList.add('open');
    patientModal?.setAttribute('aria-hidden', 'false');
    document.body.classList.add('has-modal-open');
    window.setTimeout(() => patientNameInput?.focus(), 25);
  };

  const closePatientModal = () => {
    patientModal?.classList.remove('open');
    patientModal?.setAttribute('aria-hidden', 'true');
    document.body.classList.remove('has-modal-open');
    resetPatientForm();
  };

  const ensurePatientCatalog = async () => {
    if (patientCatalog.length) return patientCatalog;
    await fetchPatientCatalog();
    return patientCatalog;
  };

  const normalizeSearchValue = (value: string) =>
    String(value || '')
      .toLowerCase()
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .trim();

  const hideSearchResults = () => {
    if (!searchResults) return;
    quickSearchMatches = [];
    quickSearchActiveIndex = -1;
    searchResults.hidden = true;
    searchResults.innerHTML = '';
    searchInput?.setAttribute('aria-expanded', 'false');
  };

  const renderSearchResults = (query: string) => {
    if (!searchResults) return;
    const normalizedQuery = normalizeSearchValue(query);
    if (normalizedQuery.length < 2) {
      hideSearchResults();
      return;
    }

    quickSearchMatches = patientCatalog
      .filter((patient) => {
        const haystack = [patient.nombre_completo, patient.email || '', patient.id]
          .filter(Boolean)
          .map((value) => normalizeSearchValue(String(value)))
          .join(' ');
        return haystack.includes(normalizedQuery);
      })
      .slice(0, 6);

    if (quickSearchActiveIndex >= quickSearchMatches.length) {
      quickSearchActiveIndex = quickSearchMatches.length - 1;
    }
    if (quickSearchActiveIndex < 0 && quickSearchMatches.length) {
      quickSearchActiveIndex = 0;
    }

    searchResults.hidden = false;
    searchInput?.setAttribute('aria-expanded', 'true');

    if (!quickSearchMatches.length) {
      searchResults.innerHTML = `<div class="search-results-empty">Sin pacientes para &quot;${escapeHtml(query)}&quot;.</div>`;
      return;
    }

    searchResults.innerHTML = [
      '<div class="search-results-head">Pacientes del CRM</div>',
      ...quickSearchMatches.map((patient, index) => {
        const activeClass = index === quickSearchActiveIndex ? ' is-active' : '';
        const patientName = patient.nombre_completo || `Paciente ${patient.id}`;
        const patientMeta = patient.email || `ID ${patient.id.slice(0, 8)}`;
        return `<button type="button" class="search-result-item${activeClass}" data-search-patient-id="${escapeAttr(patient.id)}" data-search-patient-name="${escapeAttr(patientName)}">
          <span class="material-symbols-rounded search-result-icon">person_search</span>
          <span class="search-result-main">
            <span class="search-result-title">${escapeHtml(patientName)}</span>
            <span class="search-result-meta">${escapeHtml(patientMeta)}</span>
          </span>
          <span class="material-symbols-rounded search-result-arrow">arrow_outward</span>
        </button>`;
      }),
    ].join('');
  };

  const openSearchMatch = (match?: { id: string; nombre_completo: string; email?: string | null }) => {
    if (!match?.id) return;
    if (searchInput) {
      searchInput.value = match.nombre_completo || '';
    }
    hideSearchResults();
    openPatientHistory(match.id, match.nombre_completo || '');
  };

  const updateSearchResults = async (query: string, resetActive = true) => {
    const normalizedQuery = normalizeSearchValue(query);
    if (normalizedQuery.length < 2) {
      hideSearchResults();
      return;
    }

    if (!searchResults) return;
    if (resetActive) {
      quickSearchActiveIndex = 0;
    }

    if (!patientCatalog.length) {
      searchResults.hidden = false;
      searchResults.innerHTML = '<div class="search-results-empty">Cargando pacientes...</div>';
      searchInput?.setAttribute('aria-expanded', 'true');
      try {
        await ensurePatientCatalog();
      } catch {
        searchResults.hidden = false;
        searchResults.innerHTML = '<div class="search-results-empty">No se pudo cargar el buscador de pacientes.</div>';
        return;
      }
    }

    renderSearchResults(query);
  };

  // Render exercise recommendation as rich HTML with image cards
  const addExerciseReport = (payload: any) => {
    if (!log) return;
    lastExerciseReportPayload = payload;
    const exercises = Array.isArray(payload?.exercises) ? payload.exercises : [];
    const coverage = payload?.image_coverage || {};
    const engineObs = payload?.engine_observability || {};

    let html = '<div class="msg-avatar"><span class="material-symbols-rounded">psychology</span></div>';
    html += '<div class="msg-body"><span class="msg-sender">Agente IA</span>';
    html += '<div class="exercise-report">';

    if (payload?.red_flags?.present) {
      html += '<div class="exercise-alert"><span class="material-symbols-rounded">warning</span> ALERTAS: Se recomienda valoracion medica antes de continuar.</div>';
    }
    if (payload?.message_to_therapist) {
      html += `<div class="exercise-note"><strong>Nota clinica:</strong> ${escapeHtml(payload.message_to_therapist)}</div>`;
    }

    html += `<div class="exercise-summary">Ejercicios recomendados: <strong>${exercises.length}</strong>`;
    if (coverage.percentage !== undefined) {
      html += ` | Imagenes: ${coverage.with_image}/${coverage.total}`;
    }
    if (typeof engineObs.attempts === 'number') {
      html += ` | Motor IA: ${engineObs.attempts} intento(s)`;
      if (typeof engineObs.retries_used === 'number') {
        html += ` (${engineObs.retries_used} reintentos)`;
      }
    }
    html += '</div>';
    if (engineObs.fallback_used) {
      html += `<div class="exercise-note"><strong>Fallback activo:</strong> ${escapeHtml(engineObs.fallback_reason || 'motor_ia_no_disponible')}</div>`;
    }

    exercises.forEach((ex: any, idx: number) => {
      const order = ex.orden || idx + 1;
      const nombre = escapeHtml(ex.nombre || 'Ejercicio');
      const zona = escapeHtml(ex.zona_corporal || 'general');
      const imgUrl = ex.imagen_url || '';
      const procedimiento = ex.procedimiento
        ? escapeHtml(Array.isArray(ex.procedimiento) ? ex.procedimiento.join(' ') : String(ex.procedimiento))
        : (ex.descripcion ? escapeHtml(String(ex.descripcion)) : '');

      const pauta = [
        ex.series ? `Series: ${ex.series}` : null,
        ex.repeticiones ? `Rep: ${ex.repeticiones}` : null,
        ex.duracion_segundos ? `${ex.duracion_segundos}s` : null,
      ].filter(Boolean).join(' | ');

      html += '<div class="exercise-card">';
      if (imgUrl) {
        html += `<div class="exercise-card-img"><img src="${escapeAttr(imgUrl)}" alt="${escapeAttr(ex.nombre || 'Ejercicio')}" loading="lazy" onerror="this.parentElement.style.display='none'"/></div>`;
      }
      html += '<div class="exercise-card-body">';
      html += `<div class="exercise-card-title">${order}. ${nombre} <span class="exercise-zona">${zona}</span></div>`;
      if (pauta) html += `<div class="exercise-card-pauta">${escapeHtml(pauta)}</div>`;
      if (procedimiento) html += `<div class="exercise-card-proc">${procedimiento}</div>`;
      if (ex.why) html += `<div class="exercise-card-why"><strong>Motivo:</strong> ${escapeHtml(ex.why)}</div>`;
      if (Array.isArray(ex.cautions) && ex.cautions.length) {
        html += `<div class="exercise-card-caution"><span class="material-symbols-rounded" style="font-size:14px;">report</span> ${escapeHtml(ex.cautions.join('; '))}</div>`;
      }
      html += '</div></div>';
    });

    if (payload?.message_to_patient) {
      html += `<div class="exercise-patient-msg"><strong>Mensaje para paciente:</strong> ${escapeHtml(payload.message_to_patient)}</div>`;
    }
    html += `<div class="exercise-id">ID: ${escapeHtml(payload?.recommendation_id || '-')}</div>`;
    html += '</div></div>';

    const article = document.createElement('article');
    article.className = 'msg agent';
    article.innerHTML = html;
    log.appendChild(article);
    scrollAssistantRailToBottom();
  };

  const exportExerciseReportPdf = async (payload: any) => {
    const filenameDate = new Date().toISOString().replace(/[:T]/g, '-').slice(0, 16);
    const res = await fetch(`${BACKEND_BASE}/api/exercises/reports/pdf`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
    });
    if (!res.ok) {
      const msg = await res.text().catch(() => res.statusText);
      throw new Error(`Error generando PDF: ${res.status} ${msg}`);
    }
    const blob = await res.blob();
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `informe-ejercicios-${filenameDate}.pdf`;
    document.body.appendChild(a);
    a.click();
    a.remove();
    URL.revokeObjectURL(url);
  };

  const wait = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));

  const requestExerciseRecommendation = async (text: string, maxAttempts = 2) => {
    let lastError: any = null;
    const safeMaxAttempts = Math.max(1, maxAttempts);
    let localTimeoutCount = 0;
    let localRetries = 0;

    for (let attempt = 1; attempt <= safeMaxAttempts; attempt += 1) {
      try {
        const payload = await fetchJson(
          `${BACKEND_BASE}/api/exercises/recommend`,
          {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              patient_id: selectedPatientId || null,
              symptoms: text,
              channel: 'crm_web',
              fisioterapeuta_id: PROF_ID,
            }),
          },
          45000
        );

        return {
          payload,
          attemptsUsed: attempt,
          retriesUsed: attempt - 1,
        };
      } catch (err: any) {
        lastError = err;
        const timeout = isTimeoutError(err);
        if (timeout) {
          localTimeoutCount += 1;
        }

        const canRetry = timeout && attempt < safeMaxAttempts;
        if (canRetry) {
          localRetries += 1;
          await wait(500 * attempt);
          continue;
        }

        if (localRetries > 0) {
          exerciseOpsStats.retries += localRetries;
        }
        if (localTimeoutCount > 0) {
          exerciseOpsStats.timeouts += localTimeoutCount;
        }
        renderExerciseOpsMetric();
        throw err;
      }
    }

    throw lastError;
  };

  const shouldFallbackToSyncExerciseRequest = (err: any) => {
    const msg = String(err?.message || '').toLowerCase();
    return (
      msg.includes('http 404') ||
      msg.includes('http 405') ||
      msg.includes('cannot post') ||
      msg.includes('async_job_not_found')
    );
  };

  const startExerciseRecommendationAsync = async (text: string) => {
    return await fetchJson(
      `${BACKEND_BASE}/api/exercises/recommend/async`,
      {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          patient_id: selectedPatientId || null,
          symptoms: text,
          channel: 'crm_web',
          fisioterapeuta_id: PROF_ID,
        }),
      },
      12000
    );
  };

  const pollExerciseRecommendationJob = async (jobId: string, maxAttempts = 90, pollIntervalMs = 1500) => {
    const safeJobId = String(jobId || '').trim();
    if (!safeJobId) throw new Error('No hay job_id de polling');

    for (let attempt = 1; attempt <= maxAttempts; attempt += 1) {
      const payload = await fetchJson(
        BACKEND_BASE + '/api/exercises/recommend/jobs/' + safeJobId,
        undefined,
        8000
      );
      const status = String(payload?.status || '').toLowerCase();

      if (status === 'done' && payload?.result) {
        pendingExerciseRecommendationJobId = null;
        return payload.result;
      }

      if (status === 'error') {
        pendingExerciseRecommendationJobId = null;
        const error: any = new Error(payload?.error || 'No se pudo generar el informe.');
        error.code = payload?.code || null;
        throw error;
      }

      upsertAgentProgress(payload?.progress_message || 'Procesando solicitud asincrona...');
      await wait(pollIntervalMs);
    }

    const timeoutError: any = new Error('El informe sigue procesandose en segundo plano.');
    timeoutError.code = 'async_poll_timeout';
    throw timeoutError;
  };

  // W3: Exercise recommendation via CRM
  const handleExerciseRecommend = async (text: string) => {
    const activePatientId = selectedPatientId || chatPatientSelect?.value || null;
    if (!activePatientId) {
      addMessage('Selecciona un paciente en "Paciente del informe" antes de generar ejercicios.', 'agent');
      return;
    }
    syncChatPatientSelection(activePatientId);

    addMessage(`Solicitar recomendación para: ${text}`, 'user');
    upsertAgentProgress('Preparando solicitud clínica...');
    setSending(true, 'exercise');
    try {
      let payload: any = null;
      let retriesUsed = 0;

      if (pendingExerciseRecommendationJobId) {
        upsertAgentProgress('Retomando informe que sigue en segundo plano...');
        payload = await pollExerciseRecommendationJob(pendingExerciseRecommendationJobId, 45, 1500);
      } else {
        try {
          const job = await startExerciseRecommendationAsync(text);
          pendingExerciseRecommendationJobId = String(job?.job_id || '').trim() || null;
          upsertAgentProgress(job?.progress_message || 'Solicitud enviada. Generando informe en segundo plano...');
          payload = await pollExerciseRecommendationJob(String(job?.job_id || ''), 90, 1500);
        } catch (asyncErr: any) {
          if (!shouldFallbackToSyncExerciseRequest(asyncErr)) throw asyncErr;
          upsertAgentProgress('El backend aun no expone polling persistente. Reintentando por vía directa...');
          const directResponse = await requestExerciseRecommendation(text, 2);
          payload = directResponse.payload;
          retriesUsed = directResponse.retriesUsed;
        }
      }

      renderExerciseOpsMetric();

      if (!payload.ok) {
        addMessage(`Error: ${payload.error || 'No se pudo generar recomendación'}`, 'agent');
        return;
      }

      syncEngineOpsFromPayload(payload);
      clearAgentProgress();
      addExerciseReport(payload);
      if (retriesUsed > 0) {
        addMessage(`Motor IA respondió tras ${retriesUsed} reintento(s).`, 'agent');
      }
      setAgentStatus(true);
    } catch (err: any) {
      clearAgentProgress();
      if (err?.code === 'async_poll_timeout') {
        addMessage('El informe sigue generándose en segundo plano. Pulsa de nuevo `Generar Plan` en unos segundos para retomarlo sin perder trabajo.', 'agent');
      } else if (isTimeoutError(err)) {
        pendingExerciseRecommendationJobId = null;
        addMessage('El agente de ejercicios tarda más de lo esperado. Intenta de nuevo en unos segundos.', 'agent');
      } else {
        pendingExerciseRecommendationJobId = null;
        addMessage(`Error en el agente de ejercicios: ${err?.message || 'error no identificado'}`, 'agent');
      }
    } finally {
      clearAgentProgress();
      setSending(false);
    }
  };
  // Exercise recommend button handler
  exerciseBtn?.addEventListener('click', () => {
    if (!input) return;
    const text = input.value.trim();
    if (!text) return;
    resizeAgentInput();
    handleExerciseRecommend(text);
  });

  chatPatientSelect?.addEventListener('change', () => {
    const patientId = chatPatientSelect.value || null;
    syncChatPatientSelection(patientId);
    if (patientId) {
      selectedTemplatePatientId = patientId;
      renderTemplatePatientOptions();
    }
  });

  exercisePdfBtn?.addEventListener('click', async () => {
    if (!lastExerciseReportPayload) {
      addMessage('Primero genera un informe de ejercicios para poder exportarlo a PDF.', 'agent');
      return;
    }
    try {
      await exportExerciseReportPdf(lastExerciseReportPayload);
      const recommendationId = String(lastExerciseReportPayload?.recommendation_id || '').trim();
      let archived = false;
      if (recommendationId) {
        try {
          await fetchJson(`${BACKEND_BASE}/api/exercises/reports/archive`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              recommendation_id: recommendationId,
              patient_id: selectedPatientId || lastExerciseReportPayload?.patient_id || null,
              fisioterapeuta_id: PROF_ID,
              format: 'pdf',
              source: 'crm_web',
            }),
          });
          archived = true;
          incrementArchivedReportsMetric(recommendationId);
        } catch (archiveErr: any) {
          addMessage(`PDF generado, pero no se pudo archivar en historial: ${archiveErr?.message || 'error no identificado'}`, 'agent');
          return;
        }
      }
      addMessage(
        archived
          ? 'PDF generado y archivado en historial del paciente.'
          : 'PDF generado correctamente. No se archivo en historial porque falta recommendation_id.',
        'agent'
      );
    } catch (err: any) {
      addMessage(`No se pudo generar el PDF: ${err?.message || 'error no identificado'}`, 'agent');
    }
  });

  form?.addEventListener('submit', async (event: Event) => {
    event.preventDefault();
    if (!input) return;
    const text = input.value.trim();
    if (!text) return;
    addMessage(text, 'user');
    resizeAgentInput();
    upsertAgentProgress('Consultando al asistente clínico...');
    setSending(true, 'chat');
    try {
      const payload = await fetchJson(`${BACKEND_BASE}/api/agent/message`, { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({role:'professional',channel:'web',text}) });
      const answer = payload?.data?.reply_text || payload?.data?.message || (typeof payload.data==='string'?payload.data:JSON.stringify(payload.data));
      clearAgentProgress();
      addMessage(answer, 'agent');
      setAgentStatus(!payload.n8n_unreachable);
    } catch { clearAgentProgress(); addMessage('Error de conexión con el agente.', 'agent'); setAgentStatus(false); }
    finally { clearAgentProgress(); setSending(false); }
  });

  // === HEALTH CHECK ===
  const checkHealth = async () => { try { const r = await fetch(`${BACKEND_BASE}/api/health`,{signal:AbortSignal.timeout(5000)}); setAgentStatus(r.ok); } catch { setAgentStatus(false); } };
  checkHealth();

  // === LOAD INTAKES (dashboard) ===
  const loadIntakes = async () => {
    if (!intakeBody) return;
    setListState(intakeBody, 'sync', 'Actualizando bandeja de intakes...', true);
    try {
      const payload = await fetchJson(`${BACKEND_BASE}/api/profesional/intakes/pending?profesional_id=${PROF_ID}`);
      const intakes = payload.data || payload || [];
      const badge = document.getElementById('intakeBadge');
      if (badge) badge.textContent = String(intakes.length);
      if (!intakes.length) {
        setListState(intakeBody, 'check_circle', 'Sin intakes pendientes');
        return;
      }
      intakeBody.innerHTML = intakes.slice(0, 8).map((i: any) => {
        const ch = (i.fuente||i.canal||'').toLowerCase().includes('telegram') ? 'Telegram' : 'Web';
        const f = fmtDate(i.creado_en||i.created_at||'');
        const st = i.estado||'pendiente';
        const patientName = resolvePatientName(i);
        return `<article class="clean-list-item">
          <div class="clean-list-main">
            <p class="clean-list-title">${escapeHtml(patientName)}</p>
            <p class="clean-list-meta">${escapeHtml(ch)} | ${escapeHtml(f)}</p>
          </div>
          <div class="clean-list-action">
            <span class="status-chip ${st}">${escapeHtml(st)}</span>
            <button class="btn-sm" data-action="review-intake" data-intake-id="${i.id||''}" data-patient-id="${i.paciente_id||''}" data-patient-name="${escapeAttr(patientName)}">Revisar</button>
          </div>
        </article>`;
      }).join('');
    } catch {
      setListState(intakeBody, 'cloud_off', 'No se pudieron cargar los intakes');
    }
  };
  loadIntakes();
  refreshBtn?.addEventListener('click', loadIntakes);
  intakeBody?.addEventListener('click', (event: Event) => {
    const target = event.target as HTMLElement | null;
    const btn = target?.closest('button[data-action="review-intake"]') as HTMLButtonElement | null;
    if (!btn) return;
    const patientId = btn.getAttribute('data-patient-id');
    const patientName = btn.getAttribute('data-patient-name') || '';
    openPatientHistory(patientId, patientName);
  });

  // === LOAD PACIENTES ===
  const loadPacientes = async () => {
    if (!pacientesBody) return;
    setTableState(pacientesBody, 5, 'sync', 'Cargando pacientes...', true);
    try {
      const pts = await fetchPatientCatalog();
      const metricEl = document.getElementById('metricPacientes');
      if (metricEl) metricEl.textContent = String(pts.length);
      if (!pts.length) { setTableState(pacientesBody, 5, 'person_off', 'Sin pacientes registrados'); return; }
      pacientesBody.innerHTML = pts.map((p: any) => {
        const patientName = p.nombre_completo || '—';
        return `<tr><td class="td-patient">${escapeHtml(patientName)}</td><td>${escapeHtml(p.email||'—')}</td><td>${p.fecha_nacimiento?fmtDate(p.fecha_nacimiento):'—'}</td><td>${fmtDate(p.creado_en||'')}</td><td><div class="table-actions"><button class="btn-sm btn-outline" data-action="view-patient" data-patient-id="${p.id}" data-patient-name="${escapeAttr(patientName)}">Ver</button><button class="btn-sm btn-outline" data-action="patient-telegram" data-patient-id="${p.id}" data-patient-name="${escapeAttr(patientName)}">Telegram</button></div></td></tr>`;
      }).join('');
    } catch {
      setTableState(pacientesBody, 5, 'cloud_off', 'Error al cargar pacientes');
    }
  };
  pageLoaders['pacientes'] = loadPacientes;
  document.getElementById('refreshPacientes')?.addEventListener('click', loadPacientes);
  searchInput?.setAttribute('aria-expanded', 'false');
  searchInput?.setAttribute('aria-controls', 'searchResults');
  searchInput?.addEventListener('focus', () => {
    if (!patientCatalog.length) {
      ensurePatientCatalog().catch(() => {});
    }
    const query = searchInput.value.trim();
    if (query.length >= 2) {
      updateSearchResults(query, false);
    }
  });
  searchInput?.addEventListener('input', () => {
    updateSearchResults(searchInput.value, true);
  });
  searchInput?.addEventListener('keydown', (event: KeyboardEvent) => {
    if (event.key === 'Escape') {
      hideSearchResults();
      return;
    }

    if (!quickSearchMatches.length) {
      if (event.key === 'Enter') {
        hideSearchResults();
      }
      return;
    }

    if (event.key === 'ArrowDown') {
      event.preventDefault();
      quickSearchActiveIndex = (quickSearchActiveIndex + 1) % quickSearchMatches.length;
      renderSearchResults(searchInput?.value || '');
      return;
    }

    if (event.key === 'ArrowUp') {
      event.preventDefault();
      quickSearchActiveIndex = (quickSearchActiveIndex - 1 + quickSearchMatches.length) % quickSearchMatches.length;
      renderSearchResults(searchInput?.value || '');
      return;
    }

    if (event.key === 'Enter') {
      event.preventDefault();
      openSearchMatch(quickSearchMatches[quickSearchActiveIndex >= 0 ? quickSearchActiveIndex : 0]);
    }
  });
  searchResults?.addEventListener('click', (event: Event) => {
    const target = event.target as HTMLElement | null;
    const button = target?.closest('button[data-search-patient-id]') as HTMLButtonElement | null;
    if (!button) return;
    openSearchMatch({
      id: button.getAttribute('data-search-patient-id') || '',
      nombre_completo: button.getAttribute('data-search-patient-name') || '',
    });
  });
  document.addEventListener('click', (event: MouseEvent) => {
    const target = event.target as Node | null;
    if (target && searchBox?.contains(target)) return;
    hideSearchResults();
  });

  addPatientBtn?.addEventListener('click', openPatientModal);
  closePatientModalBtn?.addEventListener('click', closePatientModal);
  patientModalDismiss?.addEventListener('click', closePatientModal);
  patientModal?.addEventListener('click', (event: Event) => {
    if (event.target === patientModal) {
      closePatientModal();
    }
  });
  document.addEventListener('keydown', (event: KeyboardEvent) => {
    if (event.key === 'Escape' && patientModal?.classList.contains('open')) {
      closePatientModal();
    }
  });
  patientForm?.addEventListener('submit', async (event: Event) => {
    event.preventDefault();

    const fullName = patientNameInput?.value.trim() || '';
    if (!fullName) {
      setPatientFormFeedback('Introduce al menos el nombre completo del paciente.');
      patientNameInput?.focus();
      return;
    }

    const previousLabel = patientSubmitBtn?.innerHTML || '';
    if (patientSubmitBtn) {
      patientSubmitBtn.disabled = true;
      patientSubmitBtn.innerHTML = '<span class="material-symbols-rounded">sync</span> Guardando...';
    }
    setPatientFormFeedback('Creando ficha del paciente...', 'success');

    try {
      const payload = await fetchJson(`${BACKEND_BASE}/api/pacientes`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          nombre_completo: fullName,
          fecha_nacimiento: patientBirthDateInput?.value || null,
          email: patientEmailInput?.value.trim() || null,
          phone: patientPhoneInput?.value.trim() || null,
          profesional_id: PROF_ID,
        }),
      }, 15000);

      const createdPatient = payload?.data || {};
      await loadPacientes();

      const createdId = createdPatient.id || null;
      const createdName =
        createdPatient.nombre_completo ||
        patientCatalog.find((patient) => patient.id === createdId)?.nombre_completo ||
        fullName;

      closePatientModal();
      addMessage(`Paciente ${createdName} creado correctamente y listo para trabajar en CRM.`, 'agent');

      if (createdId) {
        selectedTemplatePatientId = createdId;
        renderTemplatePatientOptions();
        syncChatPatientSelection(createdId, createdName);
        openPatientHistory(createdId, createdName);
      }
    } catch (err: any) {
      setPatientFormFeedback(`No se pudo crear el paciente: ${err?.message || 'error no identificado'}`);
    } finally {
      if (patientSubmitBtn) {
        patientSubmitBtn.disabled = false;
        patientSubmitBtn.innerHTML = previousLabel;
      }
    }
  });

  pacientesBody?.addEventListener('click', (event: Event) => {
    const target = event.target as HTMLElement | null;
    const btn = target?.closest('button[data-action]') as HTMLButtonElement | null;
    if (!btn) return;

    const action = btn.getAttribute('data-action') || '';
    if (!['view-patient', 'patient-telegram'].includes(action)) return;

    const patientId = btn.getAttribute('data-patient-id');
    const patientName = btn.getAttribute('data-patient-name') || '';
    selectedTemplatePatientId = patientId;
    renderTemplatePatientOptions();
    pendingHistoryAnchor = action === 'patient-telegram' ? 'telegram' : null;
    openPatientHistory(patientId, patientName);
  });

  // === LOAD PLANTILLAS ===
  const loadTemplates = async () => {
    if (!templatesBody) return;
    setTableState(templatesBody, 6, 'sync', 'Cargando plantillas...', true);
    try {
      if (!patientCatalog.length) await fetchPatientCatalog();
      const payload = await fetchJson(`${BACKEND_BASE}/api/profesional/program-templates?profesional_id=${PROF_ID}&limit=40`);
      const templates = payload.data || [];
      if (!templates.length) {
        setTableState(templatesBody, 6, 'library_books', 'No hay plantillas disponibles todavía.');
        return;
      }
      templatesBody.innerHTML = templates.map((tpl: any) => {
        const canClone = Boolean(selectedTemplatePatientId);
        const btnAttrs = canClone ? '' : 'disabled';
        const actionLabel = canClone ? 'Clonar' : 'Selecciona paciente';
        return `<tr>
          <td class="td-patient">${escapeHtml(tpl.template_title || 'Plantilla')}</td>
          <td>${tpl.usage_count || 0}</td>
          <td>${tpl.exercises_count || 0}</td>
          <td>${tpl.last_used_at ? fmtDate(tpl.last_used_at) : '—'}</td>
          <td>${escapeHtml(tpl.source_patient_name || '—')}</td>
          <td><button class="btn-sm btn-outline" data-action="clone-template" data-source-plan-id="${tpl.source_plan_id}" ${btnAttrs}>${actionLabel}</button></td>
        </tr>`;
      }).join('');
    } catch {
      setTableState(templatesBody, 6, 'cloud_off', 'Error al cargar plantillas.');
    }
  };
  pageLoaders['plantillas'] = loadTemplates;
  document.getElementById('refreshTemplates')?.addEventListener('click', loadTemplates);
  templateTargetPatient?.addEventListener('change', () => {
    selectedTemplatePatientId = templateTargetPatient.value || null;
    loadTemplates();
  });
  templatesBody?.addEventListener('click', async (event: Event) => {
    const target = event.target as HTMLElement | null;
    const btn = target?.closest('button[data-action="clone-template"]') as HTMLButtonElement | null;
    if (!btn) return;
    if (!selectedTemplatePatientId) {
      addMessage('Selecciona un paciente destino antes de clonar la plantilla.', 'agent');
      return;
    }

    const sourcePlanId = btn.getAttribute('data-source-plan-id');
    if (!sourcePlanId) return;

    btn.disabled = true;
    const oldText = btn.textContent || 'Clonar';
    btn.textContent = 'Clonando...';
    try {
      const payload = await fetchJson(`${BACKEND_BASE}/api/profesional/program-templates/clone`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          source_plan_id: sourcePlanId,
          paciente_id: selectedTemplatePatientId,
          profesional_id: PROF_ID,
        }),
      });
      const cloned = payload.data || {};
      addMessage(`Plantilla clonada correctamente (${escapeHtml(cloned.titulo || 'nuevo plan')}).`, 'agent');
      await loadTemplates();
    } catch {
      btn.disabled = false;
      btn.textContent = oldText;
      addMessage('No se pudo clonar la plantilla seleccionada.', 'agent');
    }
  });

  // === LOAD INTAKES FULL ===
  const loadIntakesFull = async () => {
    if (!intakesFullBody) return;
    setTableState(intakesFullBody, 7, 'sync', 'Cargando intakes...', true);
    try {
      const payload = await fetchJson(`${BACKEND_BASE}/api/profesional/intakes/pending?profesional_id=${PROF_ID}`);
      const intakes = payload.data || [];
      if (!intakes.length) { setTableState(intakesFullBody, 7, 'check_circle', 'Sin intakes pendientes'); return; }
      intakesFullBody.innerHTML = intakes.map((i: any) => {
        const alertas = i.tiene_alertas_rojas ? `<span class="status-chip rechazado">âš  Sí</span>` : '<span class="status-chip aprobado">No</span>';
        const patientName = resolvePatientName(i);
        return `<tr><td class="td-patient">${escapeHtml(patientName)}</td><td>${escapeHtml(i.fuente||'—')}</td><td>${escapeHtml((i.texto_mensaje||'').substring(0,80))}</td><td>${alertas}</td><td>${fmtDate(i.creado_en||'')}</td><td><span class="status-chip ${i.estado||'pendiente'}">${i.estado||'pendiente'}</span></td><td><button class="btn-sm btn-outline" data-action="view-history" data-patient-id="${i.paciente_id||''}" data-patient-name="${escapeAttr(patientName)}">Historial</button></td></tr>`;
      }).join('');
    } catch {
      setTableState(intakesFullBody, 7, 'cloud_off', 'Error al cargar intakes');
    }
  };
  pageLoaders['intakes'] = loadIntakesFull;
  document.getElementById('refreshIntakesFull')?.addEventListener('click', loadIntakesFull);
  intakesFullBody?.addEventListener('click', (event: Event) => {
    const target = event.target as HTMLElement | null;
    const btn = target?.closest('button[data-action="view-history"]') as HTMLButtonElement | null;
    if (!btn) return;
    openPatientHistory(btn.getAttribute('data-patient-id'), btn.getAttribute('data-patient-name') || '');
  });

  const renderDashboardCitas = (citas: any[], mode: 'ready' | 'error' = 'ready') => {
    if (!dashCitasBody) return;
    if (mode === 'error') {
      setListState(dashCitasBody, 'cloud_off', 'No se pudo cargar la agenda.');
      return;
    }
    if (!citas.length) {
      setListState(dashCitasBody, 'event_available', 'Sin citas agendadas por ahora.');
      return;
    }
    dashCitasBody.innerHTML = citas.slice(0, 6).map((cita: any) => {
      const stateClass = String(cita.estado || 'pendiente')
        .toLowerCase()
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .replace(/[^a-z0-9_ -]/g, '')
        .trim()
        .replace(/\s+/g, '_') || 'pendiente';
      return `<article class="clean-list-item">
        <div class="clean-list-main">
          <p class="clean-list-title">${escapeHtml(cita.nombre_paciente || 'Paciente sin nombre')}</p>
          <p class="clean-list-meta">${escapeHtml(fmtDate(cita.inicio_en || ''))} | ${escapeHtml(cita.motivo || 'Sin motivo')}</p>
        </div>
        <span class="status-chip ${stateClass}">${escapeHtml(cita.estado || 'pendiente')}</span>
      </article>`;
    }).join('');
  };

  // === AGENDA SEMANAL ===
  const getWeekMonday = (d: Date): Date => {
    const day = d.getDay();
    const diff = day === 0 ? -6 : 1 - day;
    const monday = new Date(d);
    monday.setDate(d.getDate() + diff);
    monday.setHours(0, 0, 0, 0);
    return monday;
  };
  const fmtHourOnly = (iso: string) => {
    try { return new Date(iso).toLocaleTimeString('es-ES', { hour: '2-digit', minute: '2-digit', timeZone: 'Europe/Madrid' }); } catch { return ''; }
  };
  const fmtDayShortName = (d: Date) =>
    d.toLocaleDateString('es-ES', { weekday: 'short', day: 'numeric', timeZone: 'Europe/Madrid' });
  const fmtDayFull = (d: Date) =>
    d.toLocaleDateString('es-ES', { weekday: 'short', day: 'numeric', month: 'short', timeZone: 'Europe/Madrid' });

  let agendaWeekStart: Date = getWeekMonday(new Date());

  const renderAgendaCalendar = (citas: any[], weekStart: Date) => {
    const cal = document.getElementById('agendaCalendar');
    if (!cal) return;

    const HOUR_SLOTS = [9, 10, 11, 12, 15, 16, 17, 18];
    const weekDays: Date[] = Array.from({ length: 5 }, (_, i) => {
      const d = new Date(weekStart);
      d.setDate(weekStart.getDate() + i);
      return d;
    });

    // Map day×hour → appointments
    const apptMap = new Map<string, any[]>();
    for (const cita of citas) {
      const start = new Date(cita.inicio_en);
      const dayIdx = weekDays.findIndex(d => d.toDateString() === start.toDateString());
      if (dayIdx < 0) continue;
      const hour = start.getHours();
      const slotHour = HOUR_SLOTS.find(h => hour >= h && hour < h + 1);
      if (slotHour === undefined) continue;
      const key = `${dayIdx}-${slotHour}`;
      if (!apptMap.has(key)) apptMap.set(key, []);
      apptMap.get(key)!.push(cita);
    }

    // Status colors (inline — Astro scoped styles don't apply to dynamic innerHTML)
    const STATUS: Record<string, { bg: string; color: string; border: string }> = {
      confirmada: { bg: '#d1fae5', color: '#065f46', border: '#10b981' },
      pendiente:  { bg: '#fef3c7', color: '#92400e', border: '#f59e0b' },
      cancelada:  { bg: '#f1f5f9', color: '#94a3b8', border: '#cbd5e1' },
      completada: { bg: '#ede9fe', color: '#4c1d95', border: '#7c3aed' },
      no_show:    { bg: '#fff1f2', color: '#be123c', border: '#f43f5e' },
    };
    const DEF = STATUS.pendiente;
    const todayStr = new Date().toDateString();

    // Table layout — works regardless of Astro style scoping
    const thBase = 'padding:10px 8px;text-align:center;border-bottom:2px solid #e2e8f0;font-size:0.8rem;font-weight:700;white-space:nowrap;';
    let html = `<div style="overflow-x:auto;width:100%;">
<table style="width:100%;border-collapse:collapse;table-layout:fixed;min-width:520px;">
<thead><tr>
  <th style="${thBase}width:52px;background:#f8fafc;color:#94a3b8;"></th>`;

    for (let i = 0; i < 5; i++) {
      const isToday = weekDays[i].toDateString() === todayStr;
      const label = weekDays[i].toLocaleDateString('es-ES', { weekday: 'short', day: 'numeric' });
      const dayNum = weekDays[i].toLocaleDateString('es-ES', { day: 'numeric' });
      const dayName = weekDays[i].toLocaleDateString('es-ES', { weekday: 'short' });
      const bg = isToday ? '#eff6ff' : '#f8fafc';
      const col = isToday ? '#2563eb' : '#334155';
      html += `<th style="${thBase}background:${bg};color:${col};text-transform:capitalize;">
        <span style="display:block;font-size:0.7rem;font-weight:500;opacity:0.7;">${escapeHtml(dayName)}</span>
        <span style="display:block;font-size:1.1rem;font-weight:700;">${dayNum}</span>
      </th>`;
    }
    html += '</tr></thead><tbody>';

    // Separator row between morning and afternoon
    let prevSlotWasBreak = false;

    for (let si = 0; si < HOUR_SLOTS.length; si++) {
      const hour = HOUR_SLOTS[si];
      const prevHour = si > 0 ? HOUR_SLOTS[si - 1] : null;
      // Lunch break separator
      if (prevHour !== null && hour - prevHour > 1) {
        html += `<tr><td colspan="6" style="padding:4px 8px;background:#f8fafc;border-top:2px dashed #e2e8f0;border-bottom:2px dashed #e2e8f0;text-align:center;font-size:0.7rem;color:#94a3b8;font-style:italic;">pausa 13:00 – 15:00</td></tr>`;
      }

      const timeLabel = `${String(hour).padStart(2,'0')}:00`;
      html += `<tr>
        <td style="padding:6px 8px;text-align:right;font-size:0.72rem;color:#94a3b8;font-weight:600;vertical-align:top;white-space:nowrap;background:#f8fafc;border-right:2px solid #e2e8f0;border-bottom:1px solid #f1f5f9;">${timeLabel}</td>`;

      for (let dayIdx = 0; dayIdx < 5; dayIdx++) {
        const appts = apptMap.get(`${dayIdx}-${hour}`) || [];
        const isToday = weekDays[dayIdx].toDateString() === todayStr;
        const cellBg = isToday ? '#fafcff' : '#fff';
        html += `<td style="padding:3px;vertical-align:top;background:${cellBg};border-bottom:1px solid #f1f5f9;border-right:1px solid #f1f5f9;min-height:58px;height:58px;">`;
        for (const a of appts) {
          const st = a.estado || 'pendiente';
          const c = STATUS[st] || DEF;
          const firstName = (a.nombre_paciente || 'Paciente').split(' ')[0];
          const timeStr = fmtHourOnly(a.inicio_en);
          const motivo = a.motivo ? a.motivo.slice(0, 22) : '';
          const tip = escapeAttr(`${a.nombre_paciente || ''} ${a.motivo ? '– ' + a.motivo : ''}`);
          html += `<div style="background:${c.bg};color:${c.color};border-left:3px solid ${c.border};border-radius:4px;padding:3px 5px 4px;margin-bottom:2px;font-size:0.71rem;overflow:hidden;cursor:default;line-height:1.3;" title="${tip}">
            <div style="font-weight:700;font-size:0.63rem;opacity:0.8;margin-bottom:1px;">${timeStr}</div>
            <div style="font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">${escapeHtml(firstName)}</div>
            ${motivo ? `<div style="font-size:0.62rem;opacity:0.75;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">${escapeHtml(motivo)}</div>` : ''}
          </div>`;
        }
        html += '</td>';
      }
      html += '</tr>';
    }

    html += '</tbody></table></div>';
    cal.innerHTML = html;
  };

  // === LOAD CITAS ===
  const loadCitas = async () => {
    const cal = document.getElementById('agendaCalendar');
    if (cal) cal.innerHTML = '<div class="agenda-cal-loading"><span class="material-symbols-rounded">sync</span> Cargando...</div>';
    if (citasBody) setTableState(citasBody, 6, 'sync', 'Cargando agenda...', true);
    setListState(dashCitasBody, 'sync', 'Actualizando agenda...', true);

    const weekLabelEl = document.getElementById('weekLabel');
    if (weekLabelEl) {
      const weekEnd = new Date(agendaWeekStart);
      weekEnd.setDate(agendaWeekStart.getDate() + 4);
      weekLabelEl.textContent = `${agendaWeekStart.toLocaleDateString('es-ES', { day: 'numeric', month: 'short' })} – ${weekEnd.toLocaleDateString('es-ES', { day: 'numeric', month: 'short', year: 'numeric' })}`;
    }

    const desde = new Date(agendaWeekStart).toISOString();
    const hastaDate = new Date(agendaWeekStart);
    hastaDate.setDate(hastaDate.getDate() + 5);
    const hasta = hastaDate.toISOString();

    try {
      const payload = await fetchJson(
        `${BACKEND_BASE}/api/profesional/appointments?fisioterapeuta_id=${PROF_ID}&limit=100&desde=${encodeURIComponent(desde)}&hasta=${encodeURIComponent(hasta)}`
      );
      const citas = payload.data || [];
      renderDashboardCitas(citas);
      const todayCount = citas.filter((c: any) => isTodayDate(c.inicio_en || '')).length;
      const metricEl = document.getElementById('metricSesiones');
      if (metricEl) metricEl.textContent = String(todayCount);

      renderAgendaCalendar(citas, agendaWeekStart);

      const countEl = document.getElementById('weekPatientCount');
      if (countEl) countEl.textContent = citas.length ? String(citas.length) : '';

      if (!citasBody) return;
      if (!citas.length) {
        setTableState(citasBody, 6, 'event_busy', 'No hay citas esta semana.');
        return;
      }
      const sorted = [...citas].sort((a: any, b: any) => new Date(a.inicio_en).getTime() - new Date(b.inicio_en).getTime());
      citasBody.innerHTML = sorted.map((cita: any) => {
        const start = new Date(cita.inicio_en);
        const dayStr = fmtDayFull(start);
        const hourStr = fmtHourOnly(cita.inicio_en);
        const canal = cita.canal_origen === 'telegram' ? 'Telegram' : cita.canal_origen === 'crm_web' ? 'CRM Web' : cita.canal_origen || '—';
        return `<tr>
          <td class="td-patient">${escapeHtml(cita.nombre_paciente || 'Paciente')}</td>
          <td>${escapeHtml(dayStr)}</td>
          <td>${escapeHtml(hourStr)}</td>
          <td>${escapeHtml(cita.motivo || '—')}</td>
          <td>${escapeHtml(canal)}</td>
          <td><span class="status-chip ${cita.estado || 'pendiente'}">${escapeHtml(cita.estado || 'pendiente')}</span></td>
        </tr>`;
      }).join('');
    } catch {
      if (cal) cal.innerHTML = '<div class="agenda-cal-loading">Error al cargar la agenda</div>';
      setTableState(citasBody, 6, 'cloud_off', 'Error al cargar citas');
      renderDashboardCitas([], 'error');
    }
  };

  pageLoaders['citas'] = loadCitas;
  document.getElementById('refreshCitas')?.addEventListener('click', loadCitas);
  document.getElementById('prevWeek')?.addEventListener('click', () => {
    agendaWeekStart = new Date(agendaWeekStart);
    agendaWeekStart.setDate(agendaWeekStart.getDate() - 7);
    loadCitas();
  });
  document.getElementById('nextWeek')?.addEventListener('click', () => {
    agendaWeekStart = new Date(agendaWeekStart);
    agendaWeekStart.setDate(agendaWeekStart.getDate() + 7);
    loadCitas();
  });
  document.getElementById('thisWeek')?.addEventListener('click', () => {
    agendaWeekStart = getWeekMonday(new Date());
    loadCitas();
  });
  loadCitas();

  const historyNoteComposerHtml = `
    <form class="history-note-form" data-role="history-note-form">
      <label class="history-note-field">
        <span>Nueva nota clinica</span>
        <textarea name="texto_nota" rows="4" placeholder="Ej.: mejor tolerancia a la movilidad, mantiene dolor 3/10 y cumple ejercicios domiciliarios." required></textarea>
      </label>
      <input type="hidden" name="fuente" value="crm_web" />
      <p class="history-note-feedback" data-role="history-note-feedback" hidden></p>
      <div class="history-note-actions">
        <button type="submit" class="btn-primary btn-history-note">
          <span class="material-symbols-rounded">note_add</span>
          Guardar seguimiento
        </button>
      </div>
    </form>
  `;

  const setHistoryNoteFeedback = (formEl: HTMLFormElement | null, text = '', state: 'error' | 'success' = 'error') => {
    const feedbackEl = formEl?.querySelector('[data-role="history-note-feedback"]') as HTMLElement | null;
    if (!feedbackEl) return;
    if (!text) {
      feedbackEl.hidden = true;
      feedbackEl.textContent = '';
      feedbackEl.removeAttribute('data-state');
      return;
    }
    feedbackEl.hidden = false;
    feedbackEl.textContent = text;
    feedbackEl.setAttribute('data-state', state);
  };

  const TELEGRAM_LINK_STATUS_META: Record<string, { label: string; chipClass: string }> = {
    linked: { label: 'Vinculado', chipClass: 'aprobado' },
    pending: { label: 'Codigo pendiente', chipClass: 'pendiente' },
    not_linked: { label: 'Sin vincular', chipClass: 'rechazado' },
  };

  const copyTextToClipboard = async (rawValue: unknown) => {
    const value = String(rawValue || '').trim();
    if (!value) return false;

    if (navigator?.clipboard?.writeText) {
      await navigator.clipboard.writeText(value);
      return true;
    }

    const temp = document.createElement('textarea');
    temp.value = value;
    temp.setAttribute('readonly', 'true');
    temp.style.position = 'absolute';
    temp.style.left = '-9999px';
    document.body.appendChild(temp);
    temp.select();
    const copied = document.execCommand('copy');
    document.body.removeChild(temp);
    return copied;
  };

  const renderPatientTelegramLinkBlock = (linkState: any, errorMessage = '') => {
    if (errorMessage) {
      return `
        <div class="detail-block">
          <h3>Canal Telegram</h3>
          <p class="detail-caption telegram-link-error">${escapeHtml(errorMessage)}</p>
        </div>
      `;
    }

    const normalizedStatus = String(linkState?.link_status || 'not_linked');
    const statusMeta = TELEGRAM_LINK_STATUS_META[normalizedStatus] || TELEGRAM_LINK_STATUS_META.not_linked;
    const username = linkState?.telegram_username ? `@${linkState.telegram_username}` : null;
    const linkedAt = linkState?.vinculado_en ? fmtDate(linkState.vinculado_en) : null;
    const startCommand = linkState?.telegram_start_command || '';
    const deepLink = linkState?.telegram_deep_link || '';
    const actions: string[] = [];

    if (normalizedStatus === 'not_linked') {
      actions.push('<button type="button" class="btn-sm btn-outline" data-action="telegram-link-create">Preparar invitacion</button>');
    }

    if (normalizedStatus === 'pending') {
      actions.push(`<button type="button" class="btn-sm btn-outline" data-action="telegram-copy-command" data-copy-value="${escapeAttr(startCommand)}">Copiar /start</button>`);
      if (deepLink) {
        actions.push(`<button type="button" class="btn-sm btn-outline" data-action="telegram-copy-link" data-copy-value="${escapeAttr(deepLink)}">Copiar enlace</button>`);
      }
      actions.push('<button type="button" class="btn-sm btn-outline" data-action="telegram-link-regenerate">Regenerar codigo</button>');
    }

    const hint = normalizedStatus === 'linked'
      ? 'El paciente ya tiene un chat Telegram vinculado. No genero un codigo nuevo para no romper ese enlace.'
      : normalizedStatus === 'pending'
        ? 'Comparte el comando o el enlace con el paciente para completar la vinculacion desde Telegram.'
        : 'Genera una invitacion segura para que el paciente vincule su chat con /start.';

    return `
      <div class="detail-block" id="patientTelegramLinkBlock" tabindex="-1">
        <div class="telegram-link-head">
          <div>
            <h3>Canal Telegram</h3>
            <p class="detail-caption">${escapeHtml(hint)}</p>
          </div>
          <span class="status-chip ${statusMeta.chipClass}">${escapeHtml(statusMeta.label)}</span>
        </div>
        <div class="telegram-link-card">
          <div class="telegram-link-grid">
            <p><strong>Paciente:</strong> ${escapeHtml(linkState?.patient_name || selectedPatientName || 'Paciente seleccionado')}</p>
            <p><strong>Usuario:</strong> ${escapeHtml(username || 'Sin username')}</p>
            <p><strong>Vinculado:</strong> ${escapeHtml(linkedAt || 'Aun no')}</p>
            <p><strong>Codigo:</strong> ${escapeHtml(linkState?.codigo_vinculacion || 'No generado')}</p>
          </div>
          ${startCommand ? `<div class="telegram-link-command"><code>${escapeHtml(startCommand)}</code></div>` : ''}
          ${actions.length ? `<div class="telegram-link-actions">${actions.join('')}</div>` : ''}
        </div>
      </div>
    `;
  };

  // === LOAD HISTORIAL ===
  const loadHistorial = async () => {
    if (!historialContent) return;
    if (!selectedPatientId) {
      currentPatientTelegramLinkState = null;
      historialContent.innerHTML = `<div class="empty-state"><span class="material-symbols-rounded">history</span><p>Selecciona un paciente para ver su historial</p></div>`;
      return;
    }
    historialContent.innerHTML = `<div class="empty-state state-loading"><span class="material-symbols-rounded">sync</span><p>Cargando historial de ${escapeHtml(selectedPatientName || 'paciente')}...</p></div>`;

    try {
      const [patientResp, historyResp, recommendationsResp, telegramLinkResp] = await Promise.all([
        fetchJson(`${BACKEND_BASE}/api/pacientes/${selectedPatientId}`),
        fetchJson(`${BACKEND_BASE}/api/profesional/patients/${selectedPatientId}/history`),
        fetchJson(`${BACKEND_BASE}/api/exercises/recommendations/${selectedPatientId}?limit=25`),
        fetchJson(`${BACKEND_BASE}/api/telegram/link-code/${selectedPatientId}`).catch((err: any) => ({ error: err?.message || 'No se pudo cargar el estado de Telegram.' })),
      ]);

      const patient = patientResp?.data || {};
      const notes = historyResp?.data?.notas_seguimiento || [];
      const recommendations = recommendationsResp?.data || [];
      const telegramLink = telegramLinkResp?.data || null;
      const telegramLinkError = telegramLinkResp?.error || '';
      currentPatientTelegramLinkState = telegramLink;
      const displayName = patient?.nombre_completo || selectedPatientName || `Paciente #${selectedPatientId}`;

      const notesHtml = notes.length
        ? `<ul class="detail-list">${notes.map((note: any) => `<li><strong>${fmtDate(note.creado_en || '')}</strong><br>${escapeHtml(note.texto_nota || 'Sin texto')}</li>`).join('')}</ul>`
        : `<p class="detail-empty">Sin notas de seguimiento registradas.</p>`;

      const recommendationsHtml = recommendations.length
        ? `<div class="recommendation-list">${recommendations.map((rec: any) => {
          const report = rec?.report_snapshot || {};
          const followUps = Array.isArray(rec?.follow_ups) ? rec.follow_ups : [];
          const reportExercises = Array.isArray(report?.exercises) ? report.exercises : [];
          const itemExercises = Array.isArray(rec?.crm_recomendacion_items)
            ? rec.crm_recomendacion_items.map((item: any) => ({
              nombre: item?.crm_ejercicios_catalogo?.nombre || item?.ejercicio_id || 'Ejercicio',
              why: item?.why || '',
            }))
            : [];
          const exercises = reportExercises.length ? reportExercises : itemExercises;
          const stateClass = rec?.estado === 'enviada'
            ? 'aprobado'
            : rec?.estado === 'requiere_revision'
              ? 'rechazado'
              : 'pendiente';
          const redFlagsHtml = rec?.red_flags_present
            ? '<span class="status-chip rechazado">Alertas rojas</span>'
            : '<span class="status-chip aprobado">Sin alertas</span>';
          const therapistNote = report?.message_to_therapist || rec?.message_to_therapist_es || '';
          const patientMsg = report?.message_to_patient || rec?.message_to_patient_es || '';
          const exercisesHtml = exercises.length
            ? `<ul class="recommendation-exercises">${exercises.slice(0, 8).map((ex: any, idx: number) => `<li><strong>${idx + 1}. ${escapeHtml(ex?.nombre || ex?.name || 'Ejercicio')}</strong>${ex?.why ? ` - ${escapeHtml(ex.why)}` : ''}</li>`).join('')}</ul>`
            : '<p class="detail-empty">Sin ejercicios detallados en esta recomendacion.</p>';
          const followUpsHtml = followUps.length
            ? `<ul class="detail-list">${followUps.slice(0, 5).map((fu: any) => `<li><strong>${fmtDate(fu?.created_at || '')}</strong><br>${escapeHtml(fu?.note_text || 'Seguimiento sin nota')}${fu?.pain_scale !== null && fu?.pain_scale !== undefined ? ` - Dolor ${escapeHtml(fu.pain_scale)}/10` : ''}</li>`).join('')}</ul>`
            : '<p class="detail-empty">Sin seguimiento registrado todavia.</p>';

          return `
            <article class="recommendation-card">
              <div class="recommendation-head">
                <div>
                  <h4>Recomendacion ${escapeHtml(rec?.id || '-')}</h4>
                  <p>${fmtDate(rec?.created_at || '')}</p>
                </div>
                <div class="recommendation-chips">
                  <span class="status-chip ${stateClass}">${escapeHtml(rec?.estado || 'generada')}</span>
                  ${redFlagsHtml}
                </div>
              </div>
              ${therapistNote ? `<p class="recommendation-note"><strong>Nota clinica:</strong> ${escapeHtml(therapistNote)}</p>` : ''}
              ${patientMsg ? `<p class="recommendation-note"><strong>Mensaje paciente:</strong> ${escapeHtml(patientMsg)}</p>` : ''}
              <div class="recommendation-section">
                <h5>Ejercicios (${exercises.length})</h5>
                ${exercisesHtml}
              </div>
              <div class="recommendation-section">
                <h5>Seguimiento (${followUps.length})</h5>
                ${followUpsHtml}
              </div>
            </article>
          `;
        }).join('')}</div>`
        : `<p class="detail-empty">Sin recomendaciones de ejercicios registradas.</p>`;

      historialContent.innerHTML = `
        <div class="detail-block">
          <h3>${escapeHtml(displayName)}</h3>
          <p><strong>Email:</strong> ${escapeHtml(patient.email || '-')} - <strong>Nacimiento:</strong> ${patient.fecha_nacimiento ? fmtDate(patient.fecha_nacimiento) : '-'}</p>
        </div>
        ${renderPatientTelegramLinkBlock(telegramLink, telegramLinkError)}
        <div class="detail-block">
          <h3>Registrar seguimiento</h3>
          <p class="detail-caption">Guarda observaciones clinicas del paciente directamente desde el CRM. Usa Ctrl+Enter para enviar mas rapido.</p>
          ${historyNoteComposerHtml}
        </div>
        <div class="detail-block">
          <h3>Notas de seguimiento (${notes.length})</h3>
          ${notesHtml}
        </div>
        <div class="detail-block">
          <h3>Informes y recomendaciones (${recommendations.length})</h3>
          ${recommendationsHtml}
        </div>
      `;

      if (pendingHistoryAnchor) {
        focusHistoryAnchor(pendingHistoryAnchor);
        pendingHistoryAnchor = null;
      }
    } catch {
      pendingHistoryAnchor = null;
      currentPatientTelegramLinkState = null;
      historialContent.innerHTML = `<div class="empty-state"><span class="material-symbols-rounded">cloud_off</span><p>No se pudo cargar el historial del paciente seleccionado.</p></div>`;
    }
  };
  pageLoaders['historial'] = loadHistorial;
  document.getElementById('refreshHistorial')?.addEventListener('click', loadHistorial);
  historialContent?.addEventListener('click', async (event: Event) => {
    const target = event.target as HTMLElement | null;
    const btn = target?.closest('button[data-action^="telegram-"]') as HTMLButtonElement | null;
    if (!btn || !selectedPatientId) return;

    const action = btn.getAttribute('data-action') || '';
    const patientName = selectedPatientName || currentPatientTelegramLinkState?.patient_name || 'el paciente seleccionado';

    if (action === 'telegram-copy-command' || action === 'telegram-copy-link') {
      const copyValue = btn.getAttribute('data-copy-value') || '';
      if (!copyValue) {
        addMessage('No hay un valor de invitacion disponible para copiar.', 'agent');
        return;
      }

      try {
        const copied = await copyTextToClipboard(copyValue);
        addMessage(
          copied
            ? `Invitacion Telegram copiada para ${patientName}.`
            : 'No pude copiar el texto al portapapeles en este navegador.',
          'agent'
        );
      } catch {
        addMessage('No pude copiar el texto al portapapeles en este navegador.', 'agent');
      }
      return;
    }

    if (!['telegram-link-create', 'telegram-link-regenerate'].includes(action)) return;

    const previousLabel = btn.innerHTML;
    btn.disabled = true;
    btn.innerHTML = '<span class="material-symbols-rounded">sync</span> Preparando...';

    try {
      const payload = await fetchJson(`${BACKEND_BASE}/api/telegram/link-code/${selectedPatientId}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(action === 'telegram-link-regenerate' ? { regenerate: true } : {}),
      }, 15000);

      currentPatientTelegramLinkState = payload?.data || null;
      await loadHistorial();

      if (payload?.warning === 'patient_already_linked') {
        addMessage(
          `Telegram ya estaba vinculado para ${patientName}. No genero un codigo nuevo para no romper el chat actual.`,
          'agent'
        );
        return;
      }

      const command = payload?.data?.telegram_start_command || '';
      addMessage(
        command
          ? `Invitacion Telegram lista para ${patientName}. Puedes compartir ${command}.`
          : `Estado Telegram actualizado para ${patientName}.`,
        'agent'
      );
    } catch (err: any) {
      addMessage(`No se pudo preparar la invitacion Telegram: ${err?.message || 'error no identificado'}`, 'agent');
      btn.disabled = false;
      btn.innerHTML = previousLabel;
    }
  });
  historialContent?.addEventListener('submit', async (event: Event) => {
    const formEl = event.target as HTMLFormElement | null;
    if (!formEl?.matches('form[data-role="history-note-form"]')) return;

    event.preventDefault();
    if (!selectedPatientId) {
      addMessage('Selecciona un paciente antes de guardar una nota de seguimiento.', 'agent');
      return;
    }

    const noteInput = formEl.elements.namedItem('texto_nota') as HTMLTextAreaElement | null;
    const sourceInput = formEl.elements.namedItem('fuente') as HTMLInputElement | null;
    const submitBtn = formEl.querySelector('button[type="submit"]') as HTMLButtonElement | null;
    const noteText = noteInput?.value.trim() || '';
    if (!noteText) {
      setHistoryNoteFeedback(formEl, 'Escribe una nota antes de guardarla.');
      noteInput?.focus();
      return;
    }

    const previousLabel = submitBtn?.innerHTML || '';
    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.innerHTML = '<span class="material-symbols-rounded">sync</span> Guardando...';
    }
    setHistoryNoteFeedback(formEl, 'Guardando nota de seguimiento...', 'success');

    try {
      await fetchJson(`${BACKEND_BASE}/api/profesional/notes`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          paciente_id: selectedPatientId,
          profesional_id: PROF_ID,
          texto_nota: noteText,
          fuente: sourceInput?.value || 'crm_web',
        }),
      }, 15000);

      addMessage(`Nota de seguimiento guardada para ${selectedPatientName || 'el paciente seleccionado'}.`, 'agent');
      await loadHistorial();
    } catch (err: any) {
      setHistoryNoteFeedback(formEl, `No se pudo guardar la nota: ${err?.message || 'error no identificado'}`);
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.innerHTML = previousLabel;
      }
      return;
    }
  });
  historialContent?.addEventListener('keydown', (event: KeyboardEvent) => {
    const target = event.target as HTMLTextAreaElement | null;
    if (!target || target.name !== 'texto_nota') return;
    if (event.ctrlKey && event.key === 'Enter') {
      event.preventDefault();
      target.form?.requestSubmit();
    }
  });


  // === CONFIG PAGE ===
  // ===================== PAGOS =====================
  const pagosBody = document.getElementById('pagosBody') as HTMLElement | null;
  const pagosAnioFilter = document.getElementById('pagosAnioFilter') as HTMLSelectElement | null;
  const pagosMesFilter = document.getElementById('pagosMesFilter') as HTMLSelectElement | null;
  const pagosMetodoFilter = document.getElementById('pagosMetodoFilter') as HTMLSelectElement | null;
  const pagoModal = document.getElementById('pagoModal');
  const pagoForm = document.getElementById('pagoForm') as HTMLFormElement | null;
  const pagoEditId = document.getElementById('pagoEditId') as HTMLInputElement | null;
  const pagoPacienteSearch = document.getElementById('pagoPacienteSearch') as HTMLInputElement | null;
  const pagoPacienteId = document.getElementById('pagoPacienteId') as HTMLInputElement | null;
  const pagoPacienteDropdown = document.getElementById('pagoPacienteDropdown') as HTMLElement | null;
  const pagoFechaInput = document.getElementById('pagoFechaInput') as HTMLInputElement | null;
  const pagoImporteInput = document.getElementById('pagoImporteInput') as HTMLInputElement | null;
  const pagoMetodoInput = document.getElementById('pagoMetodoInput') as HTMLSelectElement | null;
  const pagoConceptoInput = document.getElementById('pagoConceptoInput') as HTMLInputElement | null;
  const pagoNotasInput = document.getElementById('pagoNotasInput') as HTMLTextAreaElement | null;
  const pagoFormFeedback = document.getElementById('pagoFormFeedback') as HTMLElement | null;
  const pagoSubmitBtn = document.getElementById('pagoSubmitBtn') as HTMLButtonElement | null;
  const pagoModalTitle = document.getElementById('pagoModalTitle');
  const pagosReportCard = document.getElementById('pagosReportCard') as HTMLElement | null;
  const pagosReportBody = document.getElementById('pagosReportBody') as HTMLElement | null;
  const pagosReportFoot = document.getElementById('pagosReportFoot') as HTMLElement | null;
  const pagosReportTitle = document.getElementById('pagosReportTitle');

  const MESES_NOMBRE = ['', 'Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio', 'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre'];

  // Populate year selector
  (() => {
    if (!pagosAnioFilter) return;
    const currentYear = new Date().getFullYear();
    for (let y = currentYear; y >= currentYear - 5; y--) {
      const opt = document.createElement('option');
      opt.value = String(y);
      opt.textContent = String(y);
      pagosAnioFilter.appendChild(opt);
    }
  })();

  const setPagoFeedback = (text = '', state: 'error' | 'success' = 'error') => {
    if (!pagoFormFeedback) return;
    if (!text) { pagoFormFeedback.hidden = true; pagoFormFeedback.textContent = ''; pagoFormFeedback.removeAttribute('data-state'); return; }
    pagoFormFeedback.hidden = false;
    pagoFormFeedback.textContent = text;
    pagoFormFeedback.setAttribute('data-state', state);
  };

  const openPagoModal = (editData?: any) => {
    pagoForm?.reset();
    setPagoFeedback();
    if (pagoEditId) pagoEditId.value = '';
    if (pagoPacienteId) pagoPacienteId.value = '';
    if (pagoPacienteSearch) pagoPacienteSearch.value = '';
    if (pagoFechaInput) pagoFechaInput.value = new Date().toISOString().slice(0, 10);
    if (pagoConceptoInput) pagoConceptoInput.value = 'Sesion de fisioterapia';

    if (editData) {
      if (pagoModalTitle) pagoModalTitle.textContent = 'Editar pago';
      if (pagoEditId) pagoEditId.value = editData.id;
      const pName = editData.crm_pacientes ? `${editData.crm_pacientes.nombre || ''} ${editData.crm_pacientes.apellidos || ''}`.trim() : '';
      if (pagoPacienteSearch) pagoPacienteSearch.value = pName;
      if (pagoPacienteId) pagoPacienteId.value = editData.paciente_id;
      if (pagoFechaInput) pagoFechaInput.value = editData.fecha || '';
      if (pagoImporteInput) pagoImporteInput.value = String(editData.importe);
      if (pagoMetodoInput) pagoMetodoInput.value = editData.metodo_pago;
      if (pagoConceptoInput) pagoConceptoInput.value = editData.concepto || '';
      if (pagoNotasInput) pagoNotasInput.value = editData.notas || '';
    } else {
      if (pagoModalTitle) pagoModalTitle.textContent = 'Registrar pago';
    }

    pagoModal?.classList.add('open');
    pagoModal?.setAttribute('aria-hidden', 'false');
    document.body.classList.add('has-modal-open');
    window.setTimeout(() => pagoPacienteSearch?.focus(), 25);
  };

  const closePagoModal = () => {
    pagoModal?.classList.remove('open');
    pagoModal?.setAttribute('aria-hidden', 'true');
    document.body.classList.remove('has-modal-open');
  };

  document.getElementById('addPagoBtn')?.addEventListener('click', () => openPagoModal());
  document.getElementById('closePagoModalBtn')?.addEventListener('click', closePagoModal);
  document.getElementById('pagoModalDismiss')?.addEventListener('click', closePagoModal);

  // Patient search dropdown
  let pagoSearchTimeout: any = null;
  pagoPacienteSearch?.addEventListener('input', () => {
    clearTimeout(pagoSearchTimeout);
    const q = pagoPacienteSearch.value.trim().toLowerCase();
    if (q.length < 2) { if (pagoPacienteDropdown) pagoPacienteDropdown.hidden = true; return; }
    pagoSearchTimeout = setTimeout(async () => {
      if (!patientCatalog.length) await fetchPatientCatalog();
      const matches = patientCatalog.filter((p: any) =>
        (p.nombre_completo || '').toLowerCase().includes(q)
      ).slice(0, 8);
      if (!pagoPacienteDropdown) return;
      if (!matches.length) { pagoPacienteDropdown.innerHTML = '<div class="pagos-dd-item pagos-dd-empty">Sin resultados</div>'; pagoPacienteDropdown.hidden = false; return; }
      pagoPacienteDropdown.innerHTML = matches.map((p: any) =>
        `<div class="pagos-dd-item" data-id="${p.id}" data-name="${escapeAttr(p.nombre_completo || '')}">${escapeHtml(p.nombre_completo || '—')}</div>`
      ).join('');
      pagoPacienteDropdown.hidden = false;
    }, 200);
  });

  pagoPacienteDropdown?.addEventListener('click', (e: Event) => {
    const item = (e.target as HTMLElement).closest('.pagos-dd-item[data-id]') as HTMLElement | null;
    if (!item) return;
    if (pagoPacienteSearch) pagoPacienteSearch.value = item.getAttribute('data-name') || '';
    if (pagoPacienteId) pagoPacienteId.value = item.getAttribute('data-id') || '';
    if (pagoPacienteDropdown) pagoPacienteDropdown.hidden = true;
  });

  // Close dropdown on outside click
  document.addEventListener('click', (e: Event) => {
    if (pagoPacienteDropdown && !pagoPacienteDropdown.contains(e.target as Node) && e.target !== pagoPacienteSearch) {
      pagoPacienteDropdown.hidden = true;
    }
  });

  const fmtMoney = (n: number) => n.toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, '.').replace(/\.(\d{2})$/, ',$1') + ' \u20ac';

  // Load pagos list
  const loadPagos = async () => {
    if (!pagosBody) return;
    setTableState(pagosBody, 6, 'sync', 'Cargando pagos...', true);

    const anio = pagosAnioFilter?.value || String(new Date().getFullYear());
    const mes = pagosMesFilter?.value || '';
    const metodo = pagosMetodoFilter?.value || '';

    const params = new URLSearchParams();
    params.set('anio', anio);
    if (mes) params.set('mes', mes);
    if (metodo) params.set('metodo_pago', metodo);

    try {
      const [listPayload, resumenPayload] = await Promise.all([
        fetchJson(`${BACKEND_BASE}/api/pagos?${params.toString()}`),
        fetchJson(`${BACKEND_BASE}/api/pagos/resumen?anio=${anio}`),
      ]);

      const pagos = listPayload?.data || [];
      const resumen = resumenPayload?.resumen || [];

      // Update summary stats
      if (mes) {
        const mData = resumen.find((r: any) => r.mes === Number(mes)) || { total: 0, sesiones: 0, efectivo: 0, tarjeta: 0 };
        document.getElementById('pagosTotalImporte')!.textContent = fmtMoney(mData.total);
        document.getElementById('pagosTotalSesiones')!.textContent = String(mData.sesiones);
        document.getElementById('pagosTotalEfectivo')!.textContent = fmtMoney(mData.efectivo);
        document.getElementById('pagosTotalTarjeta')!.textContent = fmtMoney(mData.tarjeta);
      } else {
        const totalAnual = resumenPayload?.total_anual || 0;
        const totalSesiones = resumenPayload?.total_sesiones || 0;
        const totalEfectivo = resumen.reduce((s: number, r: any) => s + (r.efectivo || 0), 0);
        const totalTarjeta = resumen.reduce((s: number, r: any) => s + (r.tarjeta || 0), 0);
        document.getElementById('pagosTotalImporte')!.textContent = fmtMoney(totalAnual);
        document.getElementById('pagosTotalSesiones')!.textContent = String(totalSesiones);
        document.getElementById('pagosTotalEfectivo')!.textContent = fmtMoney(totalEfectivo);
        document.getElementById('pagosTotalTarjeta')!.textContent = fmtMoney(totalTarjeta);
      }

      // Render report table
      if (pagosReportBody) {
        pagosReportBody.innerHTML = resumen.map((r: any) =>
          `<tr><td>${MESES_NOMBRE[r.mes]}</td><td>${r.sesiones}</td><td>${fmtMoney(r.efectivo)}</td><td>${fmtMoney(r.tarjeta)}</td><td class="text-right"><strong>${fmtMoney(r.total)}</strong></td></tr>`
        ).join('');
      }
      if (pagosReportFoot) {
        pagosReportFoot.innerHTML = `<tr><td><strong>TOTAL</strong></td><td><strong>${resumenPayload?.total_sesiones || 0}</strong></td><td><strong>${fmtMoney(resumen.reduce((s: number, r: any) => s + (r.efectivo || 0), 0))}</strong></td><td><strong>${fmtMoney(resumen.reduce((s: number, r: any) => s + (r.tarjeta || 0), 0))}</strong></td><td class="text-right"><strong>${fmtMoney(resumenPayload?.total_anual || 0)}</strong></td></tr>`;
      }
      if (pagosReportTitle) pagosReportTitle.textContent = `Informe ${anio}`;

      // Render payments list
      if (!pagos.length) { setTableState(pagosBody, 6, 'credit_card_off', 'Sin pagos registrados en este periodo'); return; }

      pagosBody.innerHTML = pagos.map((p: any) => {
        const pName = p.crm_pacientes ? `${p.crm_pacientes.nombre || ''} ${p.crm_pacientes.apellidos || ''}`.trim() : '—';
        const metodoChip = p.metodo_pago === 'efectivo'
          ? '<span class="pagos-chip pagos-chip-cash">Efectivo</span>'
          : '<span class="pagos-chip pagos-chip-card">Tarjeta</span>';
        return `<tr>
          <td>${p.fecha ? new Date(p.fecha + 'T00:00:00').toLocaleDateString('es-ES', {day:'2-digit',month:'short',year:'numeric'}) : '—'}</td>
          <td class="td-patient">${escapeHtml(pName)}</td>
          <td>${escapeHtml(p.concepto || '—')}</td>
          <td>${metodoChip}</td>
          <td class="text-right"><strong>${fmtMoney(Number(p.importe))}</strong></td>
          <td>
            <div class="table-actions">
              <button class="btn-sm btn-outline" data-action="edit-pago" data-pago='${escapeAttr(JSON.stringify(p))}'>Editar</button>
              <button class="btn-sm btn-outline btn-danger-outline" data-action="delete-pago" data-pago-id="${p.id}">Borrar</button>
            </div>
          </td>
        </tr>`;
      }).join('');

    } catch {
      setTableState(pagosBody, 6, 'cloud_off', 'Error al cargar pagos');
    }
  };

  pageLoaders['pagos'] = loadPagos;
  document.getElementById('refreshPagos')?.addEventListener('click', loadPagos);
  pagosAnioFilter?.addEventListener('change', loadPagos);
  pagosMesFilter?.addEventListener('change', loadPagos);
  pagosMetodoFilter?.addEventListener('change', loadPagos);

  // Toggle report
  document.getElementById('togglePagosReportBtn')?.addEventListener('click', () => {
    if (!pagosReportCard) return;
    pagosReportCard.hidden = !pagosReportCard.hidden;
  });

  // Table actions: edit / delete
  pagosBody?.addEventListener('click', async (event: Event) => {
    const btn = (event.target as HTMLElement).closest('button[data-action]') as HTMLButtonElement | null;
    if (!btn) return;
    const action = btn.getAttribute('data-action') || '';

    if (action === 'edit-pago') {
      try {
        const pagoData = JSON.parse(btn.getAttribute('data-pago') || '{}');
        openPagoModal(pagoData);
      } catch { /* ignore parse error */ }
    }

    if (action === 'delete-pago') {
      const pagoId = btn.getAttribute('data-pago-id');
      if (!pagoId || !confirm('¿Eliminar este pago? Esta acción no se puede deshacer.')) return;
      try {
        await fetchJson(`${BACKEND_BASE}/api/pagos/${pagoId}`, { method: 'DELETE' });
        await loadPagos();
      } catch (err: any) {
        alert('Error al eliminar: ' + (err?.message || 'desconocido'));
      }
    }
  });

  // Form submit: create or update
  pagoForm?.addEventListener('submit', async (event: Event) => {
    event.preventDefault();
    const pacienteId = pagoPacienteId?.value || '';
    if (!pacienteId) { setPagoFeedback('Selecciona un paciente del buscador.'); pagoPacienteSearch?.focus(); return; }
    const importe = Number(pagoImporteInput?.value);
    if (!importe || importe <= 0) { setPagoFeedback('El importe debe ser mayor que 0.'); pagoImporteInput?.focus(); return; }

    const previousLabel = pagoSubmitBtn?.innerHTML || '';
    if (pagoSubmitBtn) { pagoSubmitBtn.disabled = true; pagoSubmitBtn.innerHTML = '<span class="material-symbols-rounded">sync</span> Guardando...'; }
    setPagoFeedback('Guardando pago...', 'success');

    const payload: any = {
      paciente_id: pacienteId,
      fecha: pagoFechaInput?.value || new Date().toISOString().slice(0, 10),
      importe,
      metodo_pago: pagoMetodoInput?.value || 'efectivo',
      concepto: pagoConceptoInput?.value || 'Sesion de fisioterapia',
      notas: pagoNotasInput?.value || null,
    };

    const editId = pagoEditId?.value;
    const method = editId ? 'PATCH' : 'POST';
    const url = editId ? `${BACKEND_BASE}/api/pagos/${editId}` : `${BACKEND_BASE}/api/pagos`;

    try {
      await fetchJson(url, { method, headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) }, 15000);
      closePagoModal();
      await loadPagos();
    } catch (err: any) {
      setPagoFeedback(`Error: ${err?.message || 'no se pudo guardar'}`);
    } finally {
      if (pagoSubmitBtn) { pagoSubmitBtn.disabled = false; pagoSubmitBtn.innerHTML = previousLabel; }
    }
  });

  // ===================== END PAGOS =====================

  const loadConfig = async () => {
    const cfgBackend = document.getElementById('cfgBackend');
    const cfgBackendStatus = document.getElementById('cfgBackendStatus');
    const cfgAgent = document.getElementById('cfgAgent');
    const cfgAgentStatus = document.getElementById('cfgAgentStatus');
    if (cfgBackend) cfgBackend.textContent = BACKEND_BASE;
    try {
      const r = await fetch(`${BACKEND_BASE}/api/health`, {signal: AbortSignal.timeout(5000)});
      if (cfgBackendStatus) { cfgBackendStatus.textContent = r.ok ? 'OK' : 'Error'; cfgBackendStatus.className = `status-chip ${r.ok ? 'aprobado' : 'rechazado'}`; }
    } catch { if (cfgBackendStatus) { cfgBackendStatus.textContent = 'Offline'; cfgBackendStatus.className = 'status-chip rechazado'; } }
    if (cfgAgent) cfgAgent.textContent = BACKEND_BASE + '/api/agent/message';
    try {
      const r = await fetch(`${BACKEND_BASE}/api/agent/message`, {method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({role:'test',channel:'web',text:'health check'}),signal:AbortSignal.timeout(10000)});
      const data = await r.json();
      const ok = r.ok && !data.n8n_unreachable;
      if (cfgAgentStatus) { cfgAgentStatus.textContent = ok ? (data.fallback_used ? 'Fallback' : 'OK') : 'Error'; cfgAgentStatus.className = `status-chip ${ok ? 'aprobado' : 'rechazado'}`; }
    } catch { if (cfgAgentStatus) { cfgAgentStatus.textContent = 'Offline'; cfgAgentStatus.className = 'status-chip rechazado'; } }
  };
  pageLoaders['config'] = loadConfig;

  renderAssistantPatientContext();
  fetchPatientCatalog()
    .then((pts) => {
      const metricEl = document.getElementById('metricPacientes');
      if (metricEl) metricEl.textContent = String(pts.length);
    })
    .catch(() => {
      if (chatPatientSelect) {
        chatPatientSelect.innerHTML = '<option value="">No se pudieron cargar pacientes</option>';
      }
    });
</script>

