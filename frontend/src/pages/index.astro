  const getClinicConfig = () => {
    try {
      return JSON.parse(localStorage.getItem(CLINIC_CONFIG_KEY) || '{}');
    } catch { return {}; }
  };
  const saveClinicConfig = (cfg: Record<string, string>) => {
    localStorage.setItem(CLINIC_CONFIG_KEY, JSON.stringify(cfg));
