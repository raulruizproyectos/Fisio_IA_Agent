  document.getElementById('pagoModalDismiss')?.addEventListener('click', closePagoModal);

  const fmtMoney = (n: number) => n.toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, '.').replace(/\.(\d{2})$/, ',$1') + ' \u20ac';

  const setFinanceActionButton = (button: HTMLButtonElement | null, label: string, icon: string, action: string) => {
    if (!button) return;
    button.dataset.financeAction = action;
    button.innerHTML = `<span class="material-symbols-rounded">${icon}</span> ${escapeHtml(label)}`;
  };

  const setFinancePriority = (title: string, meta: string, primary: { label: string; icon: string; action: string }, secondary: { label: string; icon: string; action: string }) => {
    if (financePriorityTitle) financePriorityTitle.textContent = title;
    if (financePriorityMeta) financePriorityMeta.textContent = meta;
    setFinanceActionButton(financePrimaryActionBtn, primary.label, primary.icon, primary.action);
    setFinanceActionButton(financeSecondaryActionBtn, secondary.label, secondary.icon, secondary.action);
  };

  const runFinanceAction = async (action = 'pago') => {
    if (action === 'pagos') {
      navigateTo('pagos');
      return;
    }
    if (action === 'pago') {
      await openPagoModal();
      return;
    }
    if (action === 'facturas') {
      navigateTo('facturas');
      return;
    }
    if (action === 'factura') {
      navigateTo('facturas');
      window.setTimeout(() => document.getElementById('nuevaFacturaBtn')?.click(), 80);
      return;
    }
    if (action === 'bonos') {
      navigateTo('bonos');
      return;
    }
    if (action === 'bono') {
      navigateTo('bonos');
      window.setTimeout(() => document.getElementById('nuevoBonoBtn')?.click(), 80);
      return;
    }
    if (action === 'gestoria') {
      navigateTo('gestoria');
      return;
    }
  };

  const renderPagosSummary = (pagos: any[]) => {
    const rows = Array.isArray(pagos) ? pagos : [];
    const total = rows.reduce((sum: number, row: any) => sum + Number(row?.importe || 0), 0);
    const efectivo = rows
      .filter((row: any) => String(row?.metodo_pago || '').toLowerCase() === 'efectivo')
      .reduce((sum: number, row: any) => sum + Number(row?.importe || 0), 0);
    const tarjeta = rows
      .filter((row: any) => String(row?.metodo_pago || '').toLowerCase() === 'tarjeta')
      .reduce((sum: number, row: any) => sum + Number(row?.importe || 0), 0);

    if (pagosTotalImporte) pagosTotalImporte.textContent = fmtMoney(total);
    if (pagosTotalSesiones) pagosTotalSesiones.textContent = String(rows.length);
    if (pagosTotalEfectivo) pagosTotalEfectivo.textContent = fmtMoney(efectivo);
    if (pagosTotalTarjeta) pagosTotalTarjeta.textContent = fmtMoney(tarjeta);
  };

  const renderFinanceOverview = async (pagos: any[]) => {
    const rows = Array.isArray(pagos) ? pagos : [];
    const paidTotal = rows.reduce((sum: number, row: any) => sum + Number(row?.importe || 0), 0);
    if (financePaidValue) financePaidValue.textContent = fmtMoney(paidTotal);
    if (financePaidMeta) financePaidMeta.textContent = `${rows.length} pago${rows.length === 1 ? '' : 's'} en el filtro.`;

    const anio = pagosAnioFilter?.value || String(new Date().getFullYear());
    const now = new Date();
    const monthNames = ['Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio', 'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre'];
    const getMonthOffset = (offset: number) => {
      const d = new Date(now.getFullYear(), now.getMonth() + offset, 1);
      return { year: d.getFullYear(), month: d.getMonth() + 1, name: monthNames[d.getMonth()] };
    };
    try {
      const [facturasPayload, bonosPayload] = await Promise.all([
        fetchJson(`${BACKEND_BASE}/api/facturas?anio=${encodeURIComponent(anio)}`).catch(() => ({ data: [] })),
        fetchJson(`${BACKEND_BASE}/api/bonos?estado=activo`).catch(() => ({ data: [] })),
      ]);

      const facturas = Array.isArray(facturasPayload?.data) ? facturasPayload.data : [];
      const pendingInvoices = facturas.filter((row: any) => String(row?.estado || '').toLowerCase() !== 'pagada');
      const pendingAmount = pendingInvoices.reduce((sum: number, row: any) => sum + Number(row?.importe_total || 0), 0);
      if (financePendingValue) financePendingValue.textContent = fmtMoney(pendingAmount);
      if (financePendingMeta) financePendingMeta.textContent = pendingInvoices.length
        ? `${pendingInvoices.length} factura${pendingInvoices.length === 1 ? '' : 's'} por cobrar.`
        : 'Sin facturas pendientes.';

      const bonos = Array.isArray(bonosPayload?.data) ? bonosPayload.data : [];
      const remainingSessions = bonos.reduce((sum: number, b: any) => sum + Math.max(Number(b?.sesiones_total || 0) - Number(b?.sesiones_usadas || 0), 0), 0);
      const lowBonos = bonos.filter((b: any) => Math.max(Number(b?.sesiones_total || 0) - Number(b?.sesiones_usadas || 0), 0) <= 2);
      if (financeBonosValue) financeBonosValue.textContent = String(bonos.length);
      if (financeBonosMeta) financeBonosMeta.textContent = `${remainingSessions} sesion${remainingSessions === 1 ? '' : 'es'} disponibles.`;

      if (pendingInvoices.length) {
        setFinancePriority(
          `${pendingInvoices.length} factura${pendingInvoices.length === 1 ? '' : 's'} pendiente${pendingInvoices.length === 1 ? '' : 's'}`,
          `${fmtMoney(pendingAmount)} por revisar antes del cierre de caja.`,
          { label: 'Revisar facturas', icon: 'receipt_long', action: 'facturas' },
          { label: 'Registrar pago', icon: 'add_card', action: 'pago' },
        );
      } else if (lowBonos.length) {
        setFinancePriority(
          `${lowBonos.length} bono${lowBonos.length === 1 ? '' : 's'} cerca de agotarse`,
          'Conviene revisar renovaciones antes de la siguiente sesion.',
          { label: 'Revisar bonos', icon: 'confirmation_number', action: 'bonos' },
          { label: 'Registrar pago', icon: 'add_card', action: 'pago' },
        );
      } else if (!rows.length) {
        setFinancePriority(
          'Sin cobros en este filtro',
          'Registra el primer cobro o cambia el periodo para revisar caja anterior.',
          { label: 'Registrar pago', icon: 'add_card', action: 'pago' },
          { label: 'Ver gestoria', icon: 'account_balance', action: 'gestoria' },
        );
      } else {
        setFinancePriority(
          'Caja al dia',
          `${fmtMoney(paidTotal)} cobrados en ${rows.length} movimiento${rows.length === 1 ? '' : 's'}.`,
          { label: 'Registrar pago', icon: 'add_card', action: 'pago' },
          { label: 'Ver gestoria', icon: 'account_balance', action: 'gestoria' },
        );
      }

      if (financeTrendValue || financeTrendMeta) {
        const current = getMonthOffset(0);
        const previous = getMonthOffset(-1);
        const [currentMonthPayload, previousMonthPayload] = await Promise.all([
          fetchJson(`${BACKEND_BASE}/api/pagos?anio=${current.year}&mes=${current.month}`).catch(() => ({ data: [] })),
          fetchJson(`${BACKEND_BASE}/api/pagos?anio=${previous.year}&mes=${previous.month}`).catch(() => ({ data: [] })),
        ]);
        const currentRows = Array.isArray(currentMonthPayload?.data) ? currentMonthPayload.data : [];
        const previousRows = Array.isArray(previousMonthPayload?.data) ? previousMonthPayload.data : [];
        const currentTotal = currentRows.reduce((sum: number, row: any) => sum + Number(row?.importe || 0), 0);
        const previousTotal = previousRows.reduce((sum: number, row: any) => sum + Number(row?.importe || 0), 0);
        const delta = currentTotal - previousTotal;
        const trendPrefix = delta > 0 ? '+' : delta < 0 ? '-' : '=';
        if (financeTrendValue) financeTrendValue.textContent = `${trendPrefix} ${fmtMoney(Math.abs(delta))}`;
        if (financeTrendMeta) {
          financeTrendMeta.textContent = `${current.name}: ${fmtMoney(currentTotal)} vs ${previous.name}: ${fmtMoney(previousTotal)}.`;
        }
      }
    } catch {
      setFinancePriority(
        'Finanzas parcialmente disponibles',
        'La caja carga, pero no se pudo completar la lectura de facturas o bonos.',
        { label: 'Registrar pago', icon: 'add_card', action: 'pago' },
        { label: 'Reintentar', icon: 'refresh', action: 'pagos' },
      );
      if (financePendingMeta) financePendingMeta.textContent = 'No se pudo actualizar facturacion.';
      if (financeBonosMeta) financeBonosMeta.textContent = 'No se pudo actualizar bonos.';
      if (financeTrendMeta) financeTrendMeta.textContent = 'No se pudo calcular la tendencia mensual.';
    }
  };

  const renderPagosMobile = (pagos: any[]) => {
    if (!pagosMobileList) return;
    const rows = Array.isArray(pagos) ? pagos : [];
    if (!rows.length) {
      pagosMobileList.innerHTML = '<div class="empty-state-sm"><span class="material-symbols-rounded">payments</span><p>Sin pagos para este filtro.</p></div>';
      return;
    }

    pagosMobileList.innerHTML = rows.map((p: any) => {
      const patientName = p.crm_pacientes ? `${p.crm_pacientes.nombre || ''} ${p.crm_pacientes.apellidos || ''}`.trim() : 'Sin paciente';
      const metodoClass = p.metodo_pago === 'efectivo' ? 'pagos-chip-cash' : 'pagos-chip-card';
      return `
        <article class="pagos-mobile-item" data-pago='${escapeAttr(JSON.stringify(p))}'>
          <header>
            <strong>${escapeHtml(patientName)}</strong>
            <span class="pagos-chip ${metodoClass}">${escapeHtml(p.metodo_pago || 'pendiente')}</span>
          </header>
          <p>${escapeHtml(fmtDate(p.fecha))}</p>
          <div class="pagos-mobile-amount">${Number(p.importe || 0).toFixed(2)} EUR</div>
          <div class="pagos-mobile-actions">
            <button class="btn-sm btn-outline" data-action="edit-pago" data-pago-id="${p.id}">Editar</button>
            <button class="btn-sm btn-outline pagos-mobile-delete" data-action="delete-pago" data-pago-id="${p.id}">Eliminar</button>
          </div>
        </article>
      `;
    }).join('');
  };

  const loadPagos = async () => {
    if (!pagosBody) return;
    pagosUnavailableMessage = '';
    syncPagosAvailabilityUi();
    renderPagosSummary([]);
    void renderFinanceOverview([]);
    renderPagosMobile([]);
    setTableState(pagosBody, 5, 'sync', 'Cargando pagos...', true);
    const anio = pagosAnioFilter?.value || String(new Date().getFullYear());
    const mes = pagosMesFilter?.value || '';
    try {
      const query = new URLSearchParams({ anio });
      if (mes) query.set('mes', mes);
      const payload = await fetchJson(`${BACKEND_BASE}/api/pagos?${query.toString()}`);
      if (payload.unavailable) {
        pagosUnavailableMessage = payload.error || 'Modulo pagos no disponible';
        syncPagosAvailabilityUi();
        renderPagosSummary([]);
        void renderFinanceOverview([]);
        renderPagosMobile([]);
        setTableState(pagosBody, 5, 'warning', pagosUnavailableMessage);
        return;
      }
      const pagos = [...(payload.data || [])].sort((a: any, b: any) => {
        const aTs = new Date(a?.fecha || 0).getTime();
        const bTs = new Date(b?.fecha || 0).getTime();
        return bTs - aTs;
      });
      renderPagosSummary(pagos);
      void renderFinanceOverview(pagos);
      renderPagosMobile(pagos);
      if (!pagos.length) { setTableState(pagosBody, 5, 'credit_card_off', 'Sin pagos en este periodo'); return; }
      pagosBody.innerHTML = pagos.map((p: any) => {
        const patientName = p.crm_pacientes ? `${p.crm_pacientes.nombre || ''} ${p.crm_pacientes.apellidos || ''}`.trim() : 'Sin paciente';
        const metodoClass = p.metodo_pago === 'efectivo' ? 'pagos-chip-cash' : 'pagos-chip-card';
        return `<tr data-pago='${escapeAttr(JSON.stringify(p))}'>
          <td>${fmtDate(p.fecha)}</td>
          <td class="td-patient">${escapeHtml(patientName)}</td>
          <td><span class="pagos-chip ${metodoClass}">${escapeHtml(p.metodo_pago || 'pendiente')}</span></td>
          <td class="text-right">${Number(p.importe || 0).toFixed(2)} EUR</td>
          <td>
            <div class="table-actions">
              <button class="btn-sm btn-outline" data-action="edit-pago" data-pago-id="${p.id}">Editar</button>
              <button class="btn-sm btn-outline finance-danger-action" data-action="delete-pago" data-pago-id="${p.id}">Eliminar</button>
            </div>
          </td>
        </tr>`;
      }).join('');
    } catch {
      renderPagosSummary([]);
      void renderFinanceOverview([]);
      renderPagosMobile([]);
      setTableState(pagosBody, 5, 'cloud_off', 'Error al cargar pagos');
    }
  };

  pageLoaders['pagos'] = loadPagos;
  pagosAnioFilter?.addEventListener('change', loadPagos);
  pagosMesFilter?.addEventListener('change', loadPagos);
  financePrimaryActionBtn?.addEventListener('click', () => runFinanceAction(financePrimaryActionBtn.dataset.financeAction));
  financeSecondaryActionBtn?.addEventListener('click', () => runFinanceAction(financeSecondaryActionBtn.dataset.financeAction));
  financeInvoiceBtn?.addEventListener('click', () => runFinanceAction('factura'));
  financeNewPaymentBtn?.addEventListener('click', () => runFinanceAction('pago'));
  financeNewInvoiceBtn?.addEventListener('click', () => runFinanceAction('factura'));
  financeNewBonoBtn?.addEventListener('click', () => runFinanceAction('bono'));
  financeOpenGestoriaBtn?.addEventListener('click', () => runFinanceAction('gestoria'));

  pagosBody?.addEventListener('click', async (event: Event) => {
    if (pagosUnavailableMessage) { showToast(pagosUnavailableMessage, 'warning'); return; }
    const btn = (event.target as HTMLElement).closest('button[data-action]') as HTMLButtonElement | null;
    if (!btn) return;
    const action = btn.getAttribute('data-action');
    const pagoId = btn.getAttribute('data-pago-id');
    if (!pagoId) return;

    if (action === 'edit-pago') {
      const row = btn.closest('tr');
      const raw = row?.getAttribute('data-pago');
      if (!raw) return;
      try {
        const pago = JSON.parse(raw);
        await openPagoModal(pago);
      } catch {
        showToast('No pude cargar el pago seleccionado.', 'error');
      }
      return;
    }

    if (action === 'delete-pago') {
      const confirmed = await requestConfirm({
        title: 'Eliminar pago',
        message: 'Este pago desaparecera del historial financiero. La accion no se puede deshacer.',
        confirmLabel: 'Eliminar',
        tone: 'error',
      });
      if (!confirmed) return;
      try {
        await fetchJson(`${BACKEND_BASE}/api/pagos/${pagoId}`, { method: 'DELETE' });
        showToast('Pago eliminado correctamente.', 'success');
        await loadPagos();
      } catch (err: any) {
        showToast(err?.message || 'No se pudo eliminar el pago.', 'error');
      }
    }
  });

  pagoForm?.addEventListener('submit', async (event: Event) => {
    event.preventDefault();
    if (pagosUnavailableMessage) { setPagoFeedback(pagosUnavailableMessage); return; }
    const pacienteId = pagoPacienteSelect?.value || '';
    if (!pacienteId) { setPagoFeedback('Selecciona un paciente.'); pagoPacienteSelect?.focus(); return; }
    const importe = Number(pagoImporteInput?.value);
    if (!importe || importe <= 0) { setPagoFeedback('Introduce un importe.'); pagoImporteInput?.focus(); return; }

    const prev = pagoSubmitBtn?.innerHTML || '';
    if (pagoSubmitBtn) { pagoSubmitBtn.disabled = true; pagoSubmitBtn.innerHTML = '<span class="material-symbols-rounded">sync</span> Guardando...'; }

    const editId = pagoEditId?.value;

    try {
      await fetchJson(
        editId ? `${BACKEND_BASE}/api/pagos/${editId}` : `${BACKEND_BASE}/api/pagos`,
        {
          method: editId ? 'PATCH' : 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            paciente_id: pacienteId,
            fecha: pagoFechaInput?.value || new Date().toISOString().slice(0, 10),
            importe,
            metodo_pago: getSelectedMetodo(),
            notas: pagoNotasInput?.value || null,
          }),
        }, 15000);
      closePagoModal();
      await loadPagos();
    } catch (err: any) {
      setPagoFeedback(`Error: ${err?.message || 'no se pudo guardar'}`);
    } finally {
      if (pagoSubmitBtn) { pagoSubmitBtn.disabled = false; pagoSubmitBtn.innerHTML = prev; }
    }
  });

  // ===================== END PAGOS =====================

