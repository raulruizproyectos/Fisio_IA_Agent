  }

  .dashboard-ops-grid,
  .assistant-focus-grid {
    display: grid;
    gap: 1rem;
  }

  .command-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.85rem;
  }

  .command-tile {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.42rem;
    padding: 1rem;
    border: 1px solid #d6e5ed;
    border-radius: 1rem;
    background: linear-gradient(180deg, #ffffff 0%, #f5fafc 100%);
    text-align: left;
    transition: transform 160ms ease-out, border-color 160ms ease-out, box-shadow 160ms ease-out;
  }

  .command-tile:hover {
    transform: translateY(-1px);
    border-color: #b8d4df;
    box-shadow: 0 18px 30px -24px rgba(15, 23, 42, 0.24);
  }
  .command-tile-accent {
    border-color: #b9dfd4;
    background:
      radial-gradient(circle at top right, rgba(13, 148, 136, 0.12), transparent 42%),
      linear-gradient(180deg, #ffffff 0%, #f0fbf7 100%);
  }

  .ops-list,
  .workflow-stack {
    display: grid;
    gap: 0.72rem;
  }

  .ops-item,
  .workflow-row {
