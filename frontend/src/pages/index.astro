  // === DASHBOARD KPIs + CHART ===
  const loadDashboardKPIs = async () => {
    try {
      const now = new Date();
      const anio = now.getFullYear();
      const mes = now.getMonth() + 1;
      const resumen = await fetchJson(`${BACKEND_BASE}/api/pagos/resumen?anio=${anio}`);
      const mesData = (resumen.resumen || []).find((r: any) => r.mes === mes);
      const ingresosMes = mesData ? Number(mesData.total || 0) : 0;
      const sesionesMes = mesData ? Number(mesData.sesiones || 0) : 0;

      const elIngresos = document.getElementById('metricIngresosMes');
      const elSesiones = document.getElementById('metricSesionesMes');
      if (elIngresos) elIngresos.textContent = `${ingresosMes.toFixed(0)} EUR`;
      if (elSesiones) elSesiones.textContent = String(sesionesMes);

      // Draw chart
      const chartYear = document.getElementById('dashChartYear');
      if (chartYear) chartYear.textContent = String(anio);

      const canvas = document.getElementById('dashIncomeChart') as HTMLCanvasElement | null;
      if (!canvas) return;
      const ctx = canvas.getContext('2d');
      if (!ctx) return;

      const meses = ['Ene', 'Feb', 'Mar', 'Abr', 'May', 'Jun', 'Jul', 'Ago', 'Sep', 'Oct', 'Nov', 'Dic'];
      const efectivoData = new Array(12).fill(0);
      const tarjetaData = new Array(12).fill(0);
      for (const r of (resumen.resumen || [])) {
        const idx = (r.mes || 1) - 1;
        efectivoData[idx] = Number(r.efectivo || 0);
        tarjetaData[idx] = Number(r.tarjeta || 0);
      }

      // Simple bar chart (no external library needed)
      const dpr = window.devicePixelRatio || 1;
      const rect = canvas.getBoundingClientRect();
      canvas.width = rect.width * dpr;
      canvas.height = rect.height * dpr;
      ctx.scale(dpr, dpr);
      const W = rect.width;
      const H = rect.height;
      const pad = { top: 10, right: 10, bottom: 30, left: 50 };
      const chartW = W - pad.left - pad.right;
      const chartH = H - pad.top - pad.bottom;
      const maxVal = Math.max(1, ...efectivoData.map((e, i) => e + tarjetaData[i]));

      ctx.clearRect(0, 0, W, H);
      ctx.font = '11px system-ui, sans-serif';
      ctx.textAlign = 'center';

      const barW = chartW / 12;
      const innerBar = barW * 0.6;

      for (let i = 0; i < 12; i++) {
        const x = pad.left + i * barW + (barW - innerBar) / 2;
        const totalH = ((efectivoData[i] + tarjetaData[i]) / maxVal) * chartH;
        const efH = (efectivoData[i] / maxVal) * chartH;
        const tarH = (tarjetaData[i] / maxVal) * chartH;

        // Tarjeta (bottom)
        ctx.fillStyle = '#3b82f6';
        ctx.fillRect(x, pad.top + chartH - totalH, innerBar, tarH);
        // Efectivo (top)
        ctx.fillStyle = '#22c55e';
        ctx.fillRect(x, pad.top + chartH - totalH + tarH, innerBar, efH);

        // Month label
        ctx.fillStyle = i === mes - 1 ? '#0f766e' : '#94a3b8';
        ctx.font = i === mes - 1 ? 'bold 11px system-ui' : '11px system-ui';
        ctx.fillText(meses[i], pad.left + i * barW + barW / 2, H - 8);
      }

      // Y axis labels
      ctx.fillStyle = '#94a3b8';
      ctx.font = '10px system-ui';
      ctx.textAlign = 'right';
      for (let v = 0; v <= maxVal; v += Math.ceil(maxVal / 4)) {
        const y = pad.top + chartH - (v / maxVal) * chartH;
        ctx.fillText(`${v} EUR`, pad.left - 6, y + 4);
        ctx.strokeStyle = '#e2e8f0';
        ctx.lineWidth = 0.5;
        ctx.beginPath();
        ctx.moveTo(pad.left, y);
        ctx.lineTo(W - pad.right, y);
        ctx.stroke();
      }

    } catch {
      // silently fail but keep dashboard still usable
    }
  };

  pageLoaders['dashboard'] = loadDashboardKPIs;
  // Auto-load on first paint
  loadDashboardKPIs();

  // === LOAD PACIENTES ===
  let patientDirectory: any[] = [];
  let patientDirectoryFilter: 'all' | 'contactable' | 'incomplete' | 'recent' = 'all';
  let patientDirectorySort: 'recent_desc' | 'readiness' | 'name_asc' | 'name_desc' = 'recent_desc';

  const getPatientPrimaryPhone = (patient: any) => String(patient?.phone || patient?.telefono || '').trim();
  const getPatientCreatedAt = (patient: any) => String(patient?.creado_en || patient?.created_at || '').trim();
  const getPatientBirthMeta = (patient: any) => {
    const raw = String(patient?.fecha_nacimiento || '').trim();
    if (!raw) return 'Nacimiento pendiente';
    const birth = new Date(raw);
    if (Number.isNaN(birth.getTime())) return 'Nacimiento pendiente';
    const today = new Date();
    let age = today.getFullYear() - birth.getFullYear();
    const monthDelta = today.getMonth() - birth.getMonth();
    if (monthDelta < 0 || (monthDelta === 0 && today.getDate() < birth.getDate())) age -= 1;
    return `${Math.max(age, 0)} anos`;
  };
  const getPatientInitials = (name: string) =>
    String(name || '')
      .split(/\s+/)
      .filter(Boolean)
      .slice(0, 2)
      .map((part) => part.charAt(0).toUpperCase())
      .join('') || 'PI';
  const isRecentPatient = (patient: any) => {
    const createdAt = getPatientCreatedAt(patient);
    if (!createdAt) return false;
    const created = new Date(createdAt).getTime();
    if (Number.isNaN(created)) return false;
    return Date.now() - created <= 1000 * 60 * 60 * 24 * 30;
  };
  const getPatientReadinessMeta = (patient: any) => {
    const hasEmail = Boolean(String(patient?.email || '').trim());
    const hasPhone = Boolean(getPatientPrimaryPhone(patient));
    if (hasEmail && hasPhone) return { label: 'Contacto completo', tone: 'ready' };
    if (hasEmail || hasPhone) return { label: 'Contacto parcial', tone: 'warm' };
    return { label: 'Completar ficha', tone: 'soft' };
  };
  const getPatientReadinessRank = (patient: any) => {
    const tone = getPatientReadinessMeta(patient).tone;
    if (tone === 'soft') return 0;
    if (tone === 'warm') return 1;
    return 2;
  };
  const getPatientCreatedTimestamp = (patient: any) => {
    const raw = getPatientCreatedAt(patient);
    if (!raw) return 0;
    const ts = new Date(raw).getTime();
    return Number.isNaN(ts) ? 0 : ts;
  };
  const sortPatientDirectoryRows = (rows: any[]) => {
    const collator = new Intl.Collator('es', { sensitivity: 'base' });
    return [...rows].sort((a, b) => {
      if (patientDirectorySort === 'name_asc') {
        return collator.compare(String(a?.nombre_completo || ''), String(b?.nombre_completo || ''));
      }
      if (patientDirectorySort === 'name_desc') {
        return collator.compare(String(b?.nombre_completo || ''), String(a?.nombre_completo || ''));
      }
      if (patientDirectorySort === 'readiness') {
        const readinessDelta = getPatientReadinessRank(a) - getPatientReadinessRank(b);
        if (readinessDelta !== 0) return readinessDelta;
      }
      return getPatientCreatedTimestamp(b) - getPatientCreatedTimestamp(a);
    });
  };
  const renderPatientsDirectorySummary = (allPatients: any[], visiblePatients: any[]) => {
    const total = allPatients.length;
    const contactable = allPatients.filter((patient) => Boolean(String(patient?.email || '').trim()) || Boolean(getPatientPrimaryPhone(patient))).length;
    const recent = allPatients.filter((patient) => isRecentPatient(patient)).length;
    const incomplete = allPatients.filter((patient) => getPatientReadinessMeta(patient).tone === 'soft').length;
    const query = patientsFilterInput?.value.trim() || '';
    const visibleLabel = `${visiblePatients.length} ${visiblePatients.length === 1 ? 'caso visible' : 'casos visibles'}`;

    if (patientsTotalValue) patientsTotalValue.textContent = String(total);
    if (patientsTotalMeta) patientsTotalMeta.textContent = total ? `${incomplete} ficha${incomplete === 1 ? '' : 's'} necesitan completar contacto.` : 'Sin pacientes activos todavia.';
    if (patientsReachValue) patientsReachValue.textContent = total ? `${Math.round((contactable / total) * 100)}%` : '0%';
    if (patientsReachMeta) patientsReachMeta.textContent = total ? `${contactable} pacientes con email o telefono listos para seguimiento.` : 'Aun no hay vias de contacto registradas.';
    if (patientsRecentValue) patientsRecentValue.textContent = String(recent);
    if (patientsRecentMeta) patientsRecentMeta.textContent = recent ? `Altas creadas en los ultimos 30 dias.` : 'Sin altas nuevas en los ultimos 30 dias.';
    if (patientsListMeta) {
      const filterCopy = patientDirectoryFilter === 'all'
        ? 'Mostrando toda la base activa.'
        : patientDirectoryFilter === 'contactable'
          ? 'Mostrando solo pacientes con via de contacto.'
          : patientDirectoryFilter === 'incomplete'
            ? 'Mostrando fichas que necesitan completar datos.'
            : 'Mostrando altas recientes del ultimo mes.';
      patientsListMeta.textContent = `${visibleLabel}. ${filterCopy}${query ? ` Busqueda: "${query}".` : ''}`;
    }
    if (patientsFilterChip) {
      const filterLabel = patientDirectoryFilter === 'all'
        ? 'Vista completa'
        : patientDirectoryFilter === 'contactable'
          ? 'Filtro: contactables'
          : patientDirectoryFilter === 'incomplete'
            ? 'Filtro: incompletos'
            : 'Filtro: recientes';
      const sortLabel = patientDirectorySort === 'recent_desc'
        ? 'Orden: recientes'
        : patientDirectorySort === 'readiness'
          ? 'Orden: prioridad'
          : patientDirectorySort === 'name_asc'
            ? 'Orden: A-Z'
            : 'Orden: Z-A';
      patientsFilterChip.textContent = `${filterLabel} | ${sortLabel}`;
    }
    patientsSegmentButtons.forEach((button) => {
      button.classList.toggle('is-active', button.dataset.patientFilter === patientDirectoryFilter);
    });
    if (patientsSortSelect && patientsSortSelect.value !== patientDirectorySort) {
      patientsSortSelect.value = patientDirectorySort;
    }
  };
  const renderPatientsDirectory = () => {
    if (!pacientesBody) return;
    const query = normalizeSearchValue(patientsFilterInput?.value || '');
    const filtered = patientDirectory.filter((patient) => {
      const matchesSegment = patientDirectoryFilter === 'all'
        ? true
        : patientDirectoryFilter === 'contactable'
          ? Boolean(String(patient?.email || '').trim()) || Boolean(getPatientPrimaryPhone(patient))
          : patientDirectoryFilter === 'incomplete'
            ? getPatientReadinessMeta(patient).tone === 'soft'
            : isRecentPatient(patient);

      if (!matchesSegment) return false;
      if (!query) return true;

      const haystack = [
        patient?.nombre_completo || '',
        patient?.email || '',
        getPatientPrimaryPhone(patient),
        patient?.id || '',
      ]
        .map((value) => normalizeSearchValue(String(value)))
        .join(' ');

      return haystack.includes(query);
    });

    const sorted = sortPatientDirectoryRows(filtered);
    renderPatientsDirectorySummary(patientDirectory, sorted);

    if (!patientDirectory.length) {
      setListState(pacientesBody, 'person_off', 'Sin pacientes registrados');
      return;
    }

    if (!sorted.length) {
      setListState(pacientesBody, 'search_off', 'No hay pacientes que coincidan con los filtros actuales.');
      return;
    }

    pacientesBody.innerHTML = sorted.map((patient: any) => {
      const patientName = patient?.nombre_completo || 'Sin nombre';
      const patientEmail = String(patient?.email || '').trim();
      const patientPhone = getPatientPrimaryPhone(patient);
      const patientBirthMeta = getPatientBirthMeta(patient);
      const createdAt = getPatientCreatedAt(patient);
      const createdLabel = createdAt ? fmtDate(createdAt) : 'Alta sin fecha';
      const readiness = getPatientReadinessMeta(patient);
      const sourceLabel = patient?._source === 'legacy' ? 'Legacy' : 'CRM';
      const channelBits = [
        patientEmail || 'Sin email',
        patientPhone || 'Sin telefono',
        patientBirthMeta,
      ];
      const callAction = patientPhone
        ? `<button type="button" class="btn-ghost btn-sm" data-action="patient-call" data-patient-id="${escapeAttr(patient.id)}" data-patient-name="${escapeAttr(patientName)}" data-patient-phone="${escapeAttr(patientPhone)}"><span class="material-symbols-rounded">call</span> Llamar</button>`
        : '';
      const emailAction = patientEmail
        ? `<button type="button" class="btn-ghost btn-sm" data-action="patient-email" data-patient-id="${escapeAttr(patient.id)}" data-patient-name="${escapeAttr(patientName)}" data-patient-email="${escapeAttr(patientEmail)}"><span class="material-symbols-rounded">mail</span> Email</button>`
        : '';
      return `
        <article class="patient-directory-item tone-${escapeAttr(readiness.tone)}">
          <div class="patient-directory-main">
            <div class="patient-directory-avatar" aria-hidden="true">${escapeHtml(getPatientInitials(patientName))}</div>
            <div class="patient-directory-copy">
              <div class="patient-directory-head">
                <div>
                  <strong>${escapeHtml(patientName)}</strong>
                  <p>${escapeHtml(channelBits.join(' | '))}</p>
                </div>
                <span class="patient-status-chip is-${escapeAttr(readiness.tone)}">${escapeHtml(readiness.label)}</span>
              </div>
              <div class="patient-directory-meta">
                <span class="patient-directory-pill">${escapeHtml(sourceLabel)}</span>
                <span class="patient-directory-pill">${isRecentPatient(patient) ? 'Alta reciente' : 'Base activa'}</span>
                <span class="patient-directory-pill">Actualizado ${escapeHtml(createdLabel)}</span>
              </div>
            </div>
          </div>
          <div class="patient-directory-actions">
            ${callAction}
            ${emailAction}
            <button type="button" class="btn-secondary btn-sm" data-action="view-patient" data-patient-id="${escapeAttr(patient.id)}" data-patient-name="${escapeAttr(patientName)}"><span class="material-symbols-rounded">person</span> Abrir ficha</button>
            <button type="button" class="btn-ghost btn-sm" data-action="patient-telegram" data-patient-id="${escapeAttr(patient.id)}" data-patient-name="${escapeAttr(patientName)}"><span class="material-symbols-rounded">forum</span> Seguimiento</button>
          </div>
        </article>
      `;
    }).join('');
  };
  const loadPacientes = async () => {
    if (!pacientesBody) return;
    setListState(pacientesBody, 'sync', 'Cargando pacientes...', true);
    try {
      const pts = await fetchPatientCatalog();
      const metricEl = document.getElementById('metricPacientes');
      if (metricEl) metricEl.textContent = String(pts.length);
      patientDirectory = Array.isArray(pts) ? pts : [];
      renderPatientsDirectory();
    } catch {
      patientDirectory = [];
      renderPatientsDirectorySummary([], []);
      setListState(pacientesBody, 'cloud_off', 'Error al cargar pacientes');
    }
  };
  pageLoaders['pacientes'] = loadPacientes;
  document.getElementById('refreshPacientes')?.addEventListener('click', loadPacientes);
  patientsHeroAddBtn?.addEventListener('click', openPatientModal);
  patientsFilterInput?.addEventListener('input', () => {
    renderPatientsDirectory();
  });
  patientsSortSelect?.addEventListener('change', () => {
    const nextSort = String(patientsSortSelect.value || 'recent_desc') as typeof patientDirectorySort;
    patientDirectorySort = ['recent_desc', 'readiness', 'name_asc', 'name_desc'].includes(nextSort) ? nextSort : 'recent_desc';
    renderPatientsDirectory();
  });
  patientsSegmentButtons.forEach((button) => {
    button.addEventListener('click', () => {
      patientDirectoryFilter = (button.dataset.patientFilter as 'all' | 'contactable' | 'incomplete' | 'recent') || 'all';
      renderPatientsDirectory();
    });
  });
  searchInput?.setAttribute('aria-expanded', 'false');
  searchInput?.setAttribute('aria-controls', 'searchResults');
  searchInput?.addEventListener('focus', () => {
    if (!patientCatalog.length) {
      ensurePatientCatalog().catch(() => {});
    }
    const query = searchInput.value.trim();
    if (query.length >= 2) {
      updateSearchResults(query, false);
    }
  });
  searchInput?.addEventListener('input', () => {
    updateSearchResults(searchInput.value, true);
  });
  searchInput?.addEventListener('keydown', (event: KeyboardEvent) => {
    if (event.key === 'Escape') {
      hideSearchResults();
      return;
    }

    if (!quickSearchMatches.length) {
      if (event.key === 'Enter') {
        hideSearchResults();
      }
      return;
    }

    if (event.key === 'ArrowDown') {
      event.preventDefault();
      quickSearchActiveIndex = (quickSearchActiveIndex + 1) % quickSearchMatches.length;
      renderSearchResults(searchInput?.value || '');
      return;
    }

    if (event.key === 'ArrowUp') {
      event.preventDefault();
      quickSearchActiveIndex = (quickSearchActiveIndex - 1 + quickSearchMatches.length) % quickSearchMatches.length;
      renderSearchResults(searchInput?.value || '');
      return;
    }

    if (event.key === 'Enter') {
      event.preventDefault();
      openSearchMatch(quickSearchMatches[quickSearchActiveIndex >= 0 ? quickSearchActiveIndex : 0]);
    }
  });
  searchResults?.addEventListener('click', (event: Event) => {
    const target = event.target as HTMLElement | null;
    const button = target?.closest('button[data-search-patient-id]') as HTMLButtonElement | null;
    if (!button) return;
    openSearchMatch({
      id: button.getAttribute('data-search-patient-id') || '',
      nombre_completo: button.getAttribute('data-search-patient-name') || '',
    });
  });
  document.addEventListener('click', (event: MouseEvent) => {
    const target = event.target as Node | null;
    if (target && searchBox?.contains(target)) return;
    hideSearchResults();
  });

  addPatientBtn?.addEventListener('click', openPatientModal);
  closePatientModalBtn?.addEventListener('click', closePatientModal);
  patientModalDismiss?.addEventListener('click', closePatientModal);
  patientModal?.addEventListener('click', (event: Event) => {
    if (event.target === patientModal) {
      closePatientModal();
    }
  });
  document.addEventListener('keydown', (event: KeyboardEvent) => {
    if (event.key === 'Escape' && patientModal?.classList.contains('open')) {
      closePatientModal();
    }
  });
  patientForm?.addEventListener('submit', async (event: Event) => {
    event.preventDefault();

    const fullName = patientNameInput?.value.trim() || '';
    if (!fullName) {
      setPatientFormFeedback('Introduce al menos el nombre completo del paciente.');
      patientNameInput?.focus();
      return;
    }

    const previousLabel = patientSubmitBtn?.innerHTML || '';
    if (patientSubmitBtn) {
      patientSubmitBtn.disabled = true;
      patientSubmitBtn.innerHTML = '<span class="material-symbols-rounded">sync</span> Guardando...';
    }
    setPatientFormFeedback('Creando ficha del paciente...', 'success');

    try {
      const payload = await fetchJson(`${BACKEND_BASE}/api/pacientes`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          nombre_completo: fullName,
          fecha_nacimiento: patientBirthDateInput?.value || null,
          email: patientEmailInput?.value.trim() || null,
          phone: patientPhoneInput?.value.trim() || null,
          profesional_id: PROF_ID,
        }),
      }, 15000);

      const createdPatient = payload?.data || {};
      await loadPacientes();

      const createdId = createdPatient.id || null;
      const createdName =
        createdPatient.nombre_completo ||
        patientCatalog.find((patient) => patient.id === createdId)?.nombre_completo ||
        fullName;

      closePatientModal();
      addMessage(`Paciente ${createdName} creado correctamente y listo para trabajar en CRM.`, 'agent');

      if (createdId) {
        syncChatPatientSelection(createdId, createdName);
        selectedPatientId = createdId;
        selectedPatientName = createdName;
        void openFichaPaciente(createdId);
      }
    } catch (err: any) {
      setPatientFormFeedback(`No se pudo crear el paciente: ${err?.message || 'error no identificado'}`);
    } finally {
      if (patientSubmitBtn) {
        patientSubmitBtn.disabled = false;
        patientSubmitBtn.innerHTML = previousLabel;
      }
    }
  });

  pacientesBody?.addEventListener('click', (event: Event) => {
    const target = event.target as HTMLElement | null;
    const btn = target?.closest('button[data-action]') as HTMLButtonElement | null;
    if (!btn) return;

    const action = btn.getAttribute('data-action') || '';
    const patientId = btn.getAttribute('data-patient-id');
    const patientName = btn.getAttribute('data-patient-name') || '';

    if (patientId) {
      syncChatPatientSelection(patientId, patientName);
    }

    if (action === 'patient-call') {
      const rawPhone = btn.getAttribute('data-patient-phone') || '';
      const phone = String(rawPhone).replace(/[^\d+]/g, '');
      if (!phone) {
        addMessage(`No hay telefono disponible para ${patientName || 'este paciente'}.`, 'agent');
        return;
      }
      window.location.href = `tel:${phone}`;
      addMessage(`Iniciando llamada a ${patientName || 'paciente'} (${phone}).`, 'agent');
      return;
    }

    if (action === 'patient-email') {
      const email = String(btn.getAttribute('data-patient-email') || '').trim();
      if (!email) {
        addMessage(`No hay email disponible para ${patientName || 'este paciente'}.`, 'agent');
        return;
      }
      const subject = encodeURIComponent(`Seguimiento clinico - ${patientName || 'Paciente'}`);
      window.location.href = `mailto:${email}?subject=${subject}`;
      addMessage(`Abriendo email para ${patientName || 'paciente'}.`, 'agent');
      return;
    }

    if (!['view-patient', 'patient-telegram'].includes(action)) return;
    pendingHistoryAnchor = action === 'patient-telegram' ? 'telegram' : null;
    if (action === 'view-patient') {
      if (patientId) void openFichaPaciente(patientId);
      return;
    }
    openPatientHistory(patientId, patientName);
  });

  // === LOAD PLANTILLAS ===
  const renderTemplateLibrarySummary = (summary: any, recentPlans: any[]) => {
    if (!templateLibrarySummary) return;

    const cards = [
      {
        label: 'Planes visibles',
        value: summary?.visible_plans ?? recentPlans.length,
        copy: 'Historial operativo listo para revisar o abrir por paciente.',
      },
      {
        label: 'Entregas visibles',
        value: summary?.visible_archived_reports ?? recentPlans.reduce((acc: number, item: any) => acc + (item?.archived_reports_count || 0), 0),
        copy: 'PDFs o informes ya archivados dentro del seguimiento.',
      },
      {
        label: 'Pacientes con seguimiento',
        value: summary?.visible_patients ?? new Set(recentPlans.map((item: any) => item?.patient_id).filter(Boolean)).size,
        copy: 'Casos con prescripcion domiciliaria trazable desde el CRM.',
      },
    ];

    templateLibrarySummary.innerHTML = cards.map((card: any) => `
      <article class="template-kpi-card">
        <span>${escapeHtml(card.label)}</span>
        <strong>${escapeHtml(card.value)}</strong>
        <p>${escapeHtml(card.copy)}</p>
      </article>
    `).join('');
  };

  const renderRecentTemplatePlans = (recentPlans: any[]) => {
    if (!templateHistoryBody) return;

    if (!recentPlans.length) {
      setTableState(
        templateHistoryBody,
        6,
        'inventory_2',
        'Aun no hay planes IA registrados en esta biblioteca. Genera uno desde el copiloto o entra en un paciente para empezar.',
      );
      return;
    }

    templateHistoryBody.innerHTML = recentPlans.map((plan: any) => {
      const patientName = plan?.patient_name || `Paciente ${plan?.patient_id || '-'}`;
      const patientMeta = plan?.patient_email || (plan?.patient_id ? `ID ${plan.patient_id}` : 'Paciente sin identificador visible');
      const statusRaw = String(plan?.status || 'generada').replace(/_/g, ' ');
      const statusClass = plan?.status === 'requiere_revision'
        ? 'rechazado'
        : ['generada', 'enviada', 'aprobada', 'completada'].includes(plan?.status)
          ? 'aprobado'
          : 'pendiente';
      const note = plan?.selection_rationale || plan?.symptom_summary || 'Plan de ejercicios IA disponible para consulta.';
      const archivedCount = Number(plan?.archived_reports_count || 0);
      const deliveryCopy = archivedCount
        ? `${archivedCount} archivada${archivedCount === 1 ? '' : 's'}${plan?.latest_report_format ? ` - ${String(plan.latest_report_format).toUpperCase()}` : ''}${plan?.latest_report_source ? ` - ${plan.latest_report_source}` : ''}`
        : 'Sin entrega archivada';
      const activityDate = plan?.last_activity_at || plan?.created_at || '';
      return `
        <tr>
          <td class="td-patient">
            <div class="template-patient-cell">
              <strong>${escapeHtml(patientName)}</strong>
              <span class="template-subtle">${escapeHtml(patientMeta)}</span>
            </div>
          </td>
          <td>
            <div class="template-plan-cell">
              <strong>${escapeHtml(plan?.title || 'Plan de ejercicios IA')}</strong>
              <p>${escapeHtml(note)}</p>
              <span class="status-chip ${escapeHtml(statusClass)}">${escapeHtml(statusRaw)}</span>
            </div>
          </td>
          <td>
            <div class="template-metric-cell">
              <strong>${escapeHtml(plan?.exercises_count || 0)}</strong>
              <span class="template-subtle">ejercicios prescritos</span>
            </div>
          </td>
          <td>
            <div class="template-metric-cell">
              <strong>${escapeHtml(archivedCount)}</strong>
              <span class="template-subtle">${escapeHtml(deliveryCopy)}</span>
            </div>
          </td>
          <td>
            <div class="template-metric-cell">
              <strong>${escapeHtml(fmtDate(activityDate))}</strong>
              <span class="template-subtle">${plan?.created_at ? `Creado ${escapeHtml(fmtDate(plan.created_at))}` : 'Sin fecha'}</span>
            </div>
          </td>
          <td>
            <button class="btn-sm btn-outline" data-action="template-open-history" data-patient-id="${escapeAttr(plan?.patient_id || '')}" data-patient-name="${escapeAttr(patientName)}">Abrir ficha</button>
          </td>
        </tr>
      `;
    }).join('');
  };

  const loadTemplates = async (forceRefresh = false) => {
    if (!templateHistoryBody && !templateLibrarySummary) return;
    const hasCache = templateLibraryCache.recentPlans.length;
    if (hasCache && !forceRefresh) {
      renderTemplateLibrarySummary(templateLibraryCache.summary, templateLibraryCache.recentPlans);
      renderRecentTemplatePlans(templateLibraryCache.recentPlans);
      return;
    }

    if (templateHistoryBody) setTableState(templateHistoryBody, 6, 'sync', 'Cargando biblioteca clinica...', true);
    try {
      if (!patientCatalog.length) await fetchPatientCatalog();
      const libraryPayload = await fetchJson(`${BACKEND_BASE}/api/profesional/program-library?profesional_id=${PROF_ID}&limit=24`);
      const library = libraryPayload?.data || {};
      const recentPlans = Array.isArray(library?.recent_plans) ? library.recent_plans : [];
      const summary = library?.summary || {};

      templateLibraryCache = {
        summary,
        recentPlans,
      };
      renderTemplateLibrarySummary(summary, recentPlans);
      renderRecentTemplatePlans(recentPlans);
    } catch (err: any) {
      templateLibraryCache = {
        summary: {},
        recentPlans: [],
      };
      renderTemplateLibrarySummary({}, []);
      if (templateHistoryBody) setTableState(templateHistoryBody, 6, 'cloud_off', 'Error al cargar la biblioteca clinica.');
    }
  };

  pageLoaders['plantillas'] = loadTemplates;
  document.getElementById('refreshTemplates')?.addEventListener('click', () => loadTemplates(true));

  templateHistoryBody?.addEventListener('click', (event: Event) => {
    const target = event.target as HTMLElement | null;
    const btn = target?.closest('button[data-action="template-open-history"]') as HTMLButtonElement | null;
    if (!btn) return;

    const patientId = btn.getAttribute('data-patient-id');
    const patientName = btn.getAttribute('data-patient-name') || 'Paciente';
    if (!patientId) return;

    selectedPatientId = patientId;
    selectedPatientName = patientName;
    syncChatPatientSelection(patientId, patientName);
    void openFichaPaciente(patientId);
  });

  const getIntakeSourceKey = (rawSource: any) => {
    const source = String(rawSource || '').toLowerCase().trim();
    if (!source) return 'other';
    if (source.includes('telegram')) return 'telegram';
    if (source.includes('web') || source.includes('form')) return 'web';
    return 'other';
  };

  const getIntakePriorityKey = (item: any) =>
    item?.tiene_alertas_rojas || item?.alerta_roja || item?.priority === 'high' ? 'high' : 'normal';

  const renderIntakeSourceSummary = (items: any[]) => {
    if (!intakesSourceSummary) return;
    const totals = { all: items.length, telegram: 0, web: 0, other: 0, high: 0 };
    items.forEach((item: any) => {
      const key = getIntakeSourceKey(item?.fuente);
      if (key in totals) (totals as any)[key] += 1;
      if (getIntakePriorityKey(item) === 'high') totals.high += 1;
    });
    intakesSourceSummary.innerHTML = `
      <span class="intakes-source-chip">Total <strong>${totals.all}</strong></span>
      <span class="intakes-source-chip">Telegram <strong>${totals.telegram}</strong></span>
      <span class="intakes-source-chip">Web/Formulario <strong>${totals.web}</strong></span>
      <span class="intakes-source-chip">Otros <strong>${totals.other}</strong></span>
      <span class="intakes-source-chip intakes-source-chip-urgent">Alta prioridad <strong>${totals.high}</strong></span>
    `;
  };

  const intakeScheduledStorageKey = 'fisio_intakes_scheduled_v1';
  const intakeScheduledSet = new Set<string>();
  const intakeTriagedStorageKey = 'fisio_intakes_triaged_v1';
  const intakeTriagedSet = new Set<string>();
  let pendingIntakeIdForAppointment: string | null = null;
  try {
    const raw = localStorage.getItem(intakeScheduledStorageKey);
    if (raw) {
      const parsed = JSON.parse(raw);
      if (Array.isArray(parsed)) parsed.forEach((id: any) => id && intakeScheduledSet.add(String(id)));
    }
  } catch {}
  try {
    const triagedRaw = localStorage.getItem(intakeTriagedStorageKey);
    if (triagedRaw) {
      const parsedTriaged = JSON.parse(triagedRaw);
      if (Array.isArray(parsedTriaged)) parsedTriaged.forEach((id: any) => id && intakeTriagedSet.add(String(id)));
    }
  } catch {}

  const persistIntakeScheduledSet = () => {
    try {
      localStorage.setItem(intakeScheduledStorageKey, JSON.stringify(Array.from(intakeScheduledSet)));
    } catch {}
  };
  const persistIntakeTriagedSet = () => {
    try {
      localStorage.setItem(intakeTriagedStorageKey, JSON.stringify(Array.from(intakeTriagedSet)));
    } catch {}
  };

  const getIntakeId = (item: any) => String(item?.id || item?.intake_id || '').trim();
  const getIntakeSla = (item: any) => {
    const intakeId = getIntakeId(item);
    if (intakeId && intakeScheduledSet.has(intakeId)) {
      return { label: 'Agendado', tone: 'aprobado' };
    }
    if (intakeId && intakeTriagedSet.has(intakeId)) {
      return { label: 'En triage', tone: 'pendiente' };
    }
    const createdAt = item?.timestamp || item?.creado_en || item?.created_at || '';
    const ts = createdAt ? new Date(createdAt).getTime() : Number.NaN;
    if (!Number.isFinite(ts)) return { label: 'En triage', tone: 'pendiente' };
    const ageHours = (Date.now() - ts) / (1000 * 60 * 60);
    if (ageHours <= 2) return { label: 'Nuevo', tone: 'aprobado' };
    if (ageHours > 24) return { label: 'Urgente', tone: 'rechazado' };
    return { label: 'En triage', tone: 'pendiente' };
  };

  async function openAppointmentFromIntake(patientId: string | null, patientName = '', message = '') {
    if (!patientId) {
      showToast('Este mensaje no tiene paciente vinculado. Abre la ficha o crea el paciente antes de agendar.', 'warning');
      return;
    }
    selectedPatientId = patientId;
    selectedPatientName = patientName || '';
    syncChatPatientSelection(patientId, patientName);
    await openAppointmentModal();
    if (appointmentPatientSelect) appointmentPatientSelect.value = patientId;
    if (appointmentReasonInput && message) {
      appointmentReasonInput.value = message.slice(0, 180);
    }
  }

  // === LOAD INTAKES FULL ===
  const loadIntakesFull = async () => {
    if (!intakesFullBody) return;
    setTableState(intakesFullBody, 7, 'sync', 'Cargando bandeja de entrada...', true);
    try {
      const payload = await fetchJson(`${BACKEND_BASE}/api/profesional/intakes/pending?profesional_id=${PROF_ID}`);
      const allIntakes = payload.data || [];
      const filterValue = intakesSourceFilter?.value || 'all';
      const priorityValue = intakesPriorityFilter?.value || 'all';
      renderIntakeSourceSummary(allIntakes);
      const channelFiltered = filterValue === 'all'
        ? allIntakes
        : allIntakes.filter((item: any) => getIntakeSourceKey(item?.fuente) === filterValue);
      const priorityFiltered = priorityValue === 'all'
        ? channelFiltered
        : channelFiltered.filter((item: any) => getIntakePriorityKey(item) === priorityValue);
      const ageSort = intakesAgeSort?.value || 'oldest';
      const intakes = [...priorityFiltered].sort((a: any, b: any) => {
        const aTs = new Date(a?.timestamp || a?.creado_en || a?.created_at || 0).getTime();
        const bTs = new Date(b?.timestamp || b?.creado_en || b?.created_at || 0).getTime();
        if (ageSort === 'newest') return bTs - aTs;
        return aTs - bTs;
      });

      if (!intakes.length) {
        const filterCopy = filterValue === 'all' && priorityValue === 'all' ? 'Sin mensajes pendientes' : 'Sin mensajes con estos filtros';
        setTableState(intakesFullBody, 7, 'check_circle', filterCopy);
        return;
      }

      intakesFullBody.innerHTML = intakes.map((i: any) => {
        const priorityKey = getIntakePriorityKey(i);
        const priority = priorityKey === 'high'
          ? '<span class="status-chip rechazado">Alta</span>'
          : '<span class="status-chip aprobado">Normal</span>';
        const intakeId = getIntakeId(i);
        const sla = getIntakeSla(i);
        const patientName = resolvePatientName(i);
        const patientId = i.crm_paciente_id || i.paciente_id || '';
        const source = i.fuente || i.canal || 'Sin canal';
        const message = i.objetivo || i.mensaje || i.texto || 'Sin mensaje';
        return `<tr>
          <td class="td-patient">${escapeHtml(patientName)}</td>
          <td>${escapeHtml(source)}</td>
          <td>${priority}</td>
          <td>${escapeHtml(message)}</td>
          <td>${escapeHtml(i.timestamp || i.creado_en || i.created_at ? fmtDate(i.timestamp || i.creado_en || i.created_at) : '')}</td>
          <td><span class="status-chip ${sla.tone}">${escapeHtml(sla.label)}</span></td>
          <td>
            <div class="intake-row-actions">
              <button class="btn-sm" data-open-ficha="${escapeAttr(patientId)}" data-patient-name="${escapeAttr(patientName)}">Ficha</button>
              <button class="btn-sm btn-outline" data-create-appointment="${escapeAttr(patientId)}" data-patient-name="${escapeAttr(patientName)}" data-intake-message="${escapeAttr(message)}" data-intake-id="${escapeAttr(intakeId)}">Cita</button>
              <button class="btn-sm btn-outline" data-open-chat="${escapeAttr(patientId)}" data-patient-name="${escapeAttr(patientName)}">Historial</button>
              <button class="btn-sm btn-outline" data-mark-triage="${escapeAttr(intakeId)}">${intakeId && intakeTriagedSet.has(intakeId) ? 'Quitar triage' : 'Marcar triage'}</button>
            </div>
          </td>
        </tr>`;
      }).join('');
    } catch {
      setTableState(intakesFullBody, 7, 'cloud_off', 'Error al cargar la bandeja');
    }
  };
  pageLoaders['intakes'] = loadIntakesFull;
  document.getElementById('refreshIntakesFull')?.addEventListener('click', loadIntakesFull);
  intakesSourceFilter?.addEventListener('change', loadIntakesFull);
  intakesPriorityFilter?.addEventListener('change', loadIntakesFull);
  intakesAgeSort?.addEventListener('change', loadIntakesFull);
  intakesFullBody?.addEventListener('click', (event: Event) => {
    const target = event.target as HTMLElement | null;
    const fichaBtn = target?.closest('button[data-open-ficha]') as HTMLButtonElement | null;
    if (fichaBtn) {
      const patientId = fichaBtn.getAttribute('data-open-ficha');
      const patientName = fichaBtn.getAttribute('data-patient-name') || '';
      if (patientId) {
        selectedPatientId = patientId;
        selectedPatientName = patientName;
        syncChatPatientSelection(patientId, patientName);
        void openFichaPaciente(patientId);
      }
      return;
    }
    const appointmentBtn = target?.closest('button[data-create-appointment]') as HTMLButtonElement | null;
    if (appointmentBtn) {
      const patientId = appointmentBtn.getAttribute('data-create-appointment');
      const patientName = appointmentBtn.getAttribute('data-patient-name') || '';
      const message = appointmentBtn.getAttribute('data-intake-message') || '';
      pendingIntakeIdForAppointment = appointmentBtn.getAttribute('data-intake-id') || null;
      void openAppointmentFromIntake(patientId, patientName, message);
      return;
    }
    const historyBtn = target?.closest('button[data-open-chat]') as HTMLButtonElement | null;
    if (historyBtn) {
      const patientId = historyBtn.getAttribute('data-open-chat');
      const patientName = historyBtn.getAttribute('data-patient-name') || '';
      if (patientId) openPatientHistory(patientId, patientName);
      return;
    }
    const triageBtn = target?.closest('button[data-mark-triage]') as HTMLButtonElement | null;
    if (triageBtn) {
      const intakeId = String(triageBtn.getAttribute('data-mark-triage') || '').trim();
      if (!intakeId) return;
      if (intakeTriagedSet.has(intakeId)) intakeTriagedSet.delete(intakeId);
      else intakeTriagedSet.add(intakeId);
      persistIntakeTriagedSet();
      void loadIntakesFull();
    }
  });

  const renderDashboardCitas = (citas: any[], mode: 'ready' | 'error' = 'ready') => {
    if (!dashCitasBody) return;
    if (mode === 'error') {
      dashboardRuntime.agendaState = 'error';
      dashboardRuntime.weekAppointments = [];
      dashboardRuntime.todayAppointments = [];
      dashboardRuntime.nextAppointment = null;
      syncDashboardCommandCenter();
      setListState(dashCitasBody, 'cloud_off', 'No se pudo cargar la agenda.');
      return;
    }

    const activeAppointments = getDashboardActiveAppointments(citas);
    const now = Date.now();
    dashboardRuntime.agendaState = 'ready';
    dashboardRuntime.weekAppointments = activeAppointments;
    dashboardRuntime.todayAppointments = activeAppointments.filter((c: any) => isTodayDate(c.inicio_en || ''));
    dashboardRuntime.nextAppointment = activeAppointments.find((c: any) => new Date(c.inicio_en).getTime() >= now) || activeAppointments[0] || null;
    syncDashboardCommandCenter();

    if (!citas.length) {
      setListState(dashCitasBody, 'event_available', 'Sin citas agendadas por ahora.');
      return;
    }

    const todayStr = new Date().toDateString();
    const todayCitas = citas.filter((c: any) => c.inicio_en && new Date(c.inicio_en).toDateString() === todayStr);
    const upcomingCitas = citas.filter((c: any) => !c.inicio_en || new Date(c.inicio_en).toDateString() !== todayStr).slice(0, 4);

    const renderItem = (cita: any, isToday: boolean) => {
      const stateClass = String(cita.estado || 'pendiente')
        .toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-z0-9_ -]/g, '').trim().replace(/\s+/g, '_') || 'pendiente';
      const hora = cita.inicio_en ? new Date(cita.inicio_en).toLocaleTimeString('es-ES', { hour: '2-digit', minute: '2-digit', timeZone: 'Europe/Madrid' }) : '';
      return `<article class="clean-list-item${isToday ? ' cita-today' : ''}">
        <div class="dash-cita-hora">${isToday && hora ? `<span class="cita-hora-badge">${hora}</span>` : ''}</div>
        <div class="clean-list-main">
          <p class="clean-list-title">${escapeHtml(cita.nombre_paciente || 'Paciente sin nombre')}</p>
          <p class="clean-list-meta">${isToday ? escapeHtml(cita.motivo || 'Sin motivo') : escapeHtml(fmtDate(cita.inicio_en || '')) + (cita.motivo ? ' | ' + escapeHtml(cita.motivo) : '')}</p>
        </div>
        <span class="status-chip ${stateClass}">${escapeHtml(cita.estado || 'pendiente')}</span>
      </article>`;
    };

    let html = '';
    if (todayCitas.length) {
      html += `<div class="dash-section-label">HOY | ${todayCitas.length} cita${todayCitas.length > 1 ? 's' : ''}</div>`;
      html += todayCitas.map((c: any) => renderItem(c, true)).join('');
    } else {
      html += `<div class="dash-section-label dash-section-label-muted">Sin citas hoy</div>`;
    }
    if (upcomingCitas.length) {
      html += `<div class="dash-section-label" style="margin-top:8px">Pr&oacute;ximas</div>`;
      html += upcomingCitas.map((c: any) => renderItem(c, false)).join('');
    }
    dashCitasBody.innerHTML = html;
  };

  // === AGENDA SEMANAL ===
  const getWeekMonday = (d: Date): Date => {
    const day = d.getDay();
    const diff = day === 0 ? -6 : 1 - day;
    const monday = new Date(d);
    monday.setDate(d.getDate() + diff);
    monday.setHours(0, 0, 0, 0);
    return monday;
  };
  const fmtHourOnly = (iso: string) => {
    try { return new Date(iso).toLocaleTimeString('es-ES', { hour: '2-digit', minute: '2-digit', timeZone: 'Europe/Madrid' }); } catch { return ''; }
  };
  const fmtDayFull = (d: Date) =>
    d.toLocaleDateString('es-ES', { weekday: 'short', day: 'numeric', month: 'short', timeZone: 'Europe/Madrid' });

  let agendaWeekStart: Date = getWeekMonday(new Date());

  const isCalendarOnlyAppointment = (cita: any) =>
    String(cita?.calendar_sync_state || '').trim() === 'calendar_only';

  const isAllDayAppointment = (cita: any) => Boolean(cita?.all_day);

  const getVisibleAgendaPatientCount = (citas: any[] = []) => {
    const visibleAppointments = (Array.isArray(citas) ? citas : []).filter((cita: any) => !isAllDayAppointment(cita) && !isCalendarOnlyAppointment(cita));
    const patientKeys = Array.from(new Set(
      visibleAppointments
        .map((cita: any) => String(cita?.paciente_id || cita?.nombre_paciente || '').trim())
        .filter(Boolean),
    ));
    return patientKeys.length || visibleAppointments.length;
  };

  const getOperationalAgendaAppointments = (citas: any[] = []) =>
    (Array.isArray(citas) ? citas : []).filter((cita: any) => !isCalendarOnlyAppointment(cita));

  const getExternalAgendaBlocks = (citas: any[] = []) =>
    (Array.isArray(citas) ? citas : []).filter((cita: any) => isCalendarOnlyAppointment(cita));

  const getCalendarBlockKind = (cita: any) =>
    String(cita?.calendar_block_kind || '').trim() || 'external_busy';

  const isBlockingCalendarOnlyAppointment = (cita: any) => {
    if (!isCalendarOnlyAppointment(cita)) return false;
    if (typeof cita?.calendar_blocks_booking === 'boolean') return cita.calendar_blocks_booking;
    return getCalendarBlockKind(cita) !== 'holiday_reference';
  };

  const getAgendaCalendarBlockMeta = (cita: any) => {
    const kind = getCalendarBlockKind(cita);
    if (kind === 'holiday_reference') {
      return {
        label: 'Festivo de referencia',
        shortLabel: 'Festivo',
        note: 'Evento de calendario de referencia. Visible en agenda, pero no bloquea reservas.',
        colors: { bg: '#f8fafc', color: '#475569', border: '#94a3b8' },
      };
    }
    if (kind === 'managed_appointment') {
      return {
        label: 'Cita detectada en Google Calendar',
        shortLabel: 'Calendar',
        note: 'Evento detectado en Google Calendar todavia no enlazado con ficha CRM.',
        colors: { bg: '#ecfeff', color: '#155e75', border: '#06b6d4' },
      };
    }
    return {
      label: 'Bloqueo externo de Google Calendar',
      shortLabel: 'Bloqueo',
      note: 'Bloqueo real de agenda detectado en Google Calendar.',
      colors: { bg: '#fff7ed', color: '#9a3412', border: '#f97316' },
    };
  };

  const summarizeCalendarOnlyBlocks = (citas: any[] = []) => {
    const blocks = getExternalAgendaBlocks(citas);
    let blocking = 0;
    let managed = 0;
    let holidays = 0;

    for (const cita of blocks) {
      const kind = getCalendarBlockKind(cita);
      if (kind === 'holiday_reference') {
        holidays += 1;
        continue;
      }
      if (kind === 'managed_appointment') {
        managed += 1;
      } else if (isBlockingCalendarOnlyAppointment(cita)) {
        blocking += 1;
      }
    }

    return { total: blocks.length, blocking, managed, holidays };
  };

  const renderAgendaCalendarMeta = (citas: any[] = []) => {
    if (!agendaCalendarMeta) return;
    const summary = summarizeCalendarOnlyBlocks(citas);
    if (!summary.total) {
      agendaCalendarMeta.hidden = true;
      agendaCalendarMeta.textContent = '';
      return;
    }

    const chunks: string[] = [];
    if (summary.blocking) chunks.push(`${summary.blocking} bloqueo${summary.blocking === 1 ? '' : 's'} real${summary.blocking === 1 ? '' : 'es'}`);
    if (summary.managed) chunks.push(`${summary.managed} cita${summary.managed === 1 ? '' : 's'} solo Calendar`);
    if (summary.holidays) chunks.push(`${summary.holidays} festivo${summary.holidays === 1 ? '' : 's'} de referencia (no bloquean reservas)`);
    agendaCalendarMeta.textContent = `Google Calendar esta aportando ${chunks.join(' | ')} en esta semana.`;
    agendaCalendarMeta.hidden = false;
  };

  const getAgendaMirrorMeta = (cita: any) => {
    const state = String(cita?.calendar_sync_state || '').trim();
    const origin = String(cita?.calendar_origin || '').trim();
    if (state === 'calendar_only') {
      const blockMeta = getAgendaCalendarBlockMeta(cita);
      return { label: 'Solo Calendar', chipClass: 'pendiente', note: blockMeta.note };
    }
    if (state === 'backfilled') return { label: 'Backfill', chipClass: 'pendiente', note: 'La cita se recupero desde Google Calendar y ya tiene correspondencia en CRM.' };
    if (state === 'crm_only') return { label: 'Solo CRM', chipClass: 'caducado', note: 'La cita existe en CRM pero todavia no aparece enlazada en Google Calendar.' };
    if (state === 'linked' || origin === 'calendar' || origin === 'crm') return { label: 'CRM + Calendar', chipClass: 'aprobado', note: 'La cita esta enlazada entre CRM y Google Calendar.' };
    return { label: 'Sin traza', chipClass: 'caducado', note: 'No hay metadata suficiente para determinar el estado de espejo con Google Calendar.' };
  };

  const renderAgendaSyncStatus = (syncStatus: any = null, liveSummary: any = null) => {
    const uiStatus = String(syncStatus?.ui_status || '').trim();
    const summary = syncStatus?.summary || liveSummary || null;
    const lastSuccessAt = syncStatus?.last_success_at || null;
    const updated = Number(summary?.updated || 0);
    const cancelled = Number(summary?.cancelled || 0);
    const persisted = Number(summary?.persisted || 0);
    const fetched = Number(summary?.fetched || 0);
    const trigger = String(syncStatus?.trigger || '').trim();

    let chipLabel = 'Sin datos';
    let chipClass = 'caducado';
    let title = 'Sync Google Calendar';
    let meta = 'Todavia no hay estado del sincronizador.';

    if (uiStatus === 'syncing') {
      chipLabel = 'Sincronizando';
      chipClass = 'pendiente';
      title = 'W6 sincronizando agenda';
      meta = 'El sincronizador background esta reconciliando Google Calendar ahora mismo.';
    } else if (uiStatus === 'healthy') {
      chipLabel = 'Al dia';
      chipClass = 'aprobado';
      title = 'W6 al dia';
      meta = `${fmtRelativeSyncAge(lastSuccessAt)} | ${persisted} nuevas | ${updated} actualizadas | ${cancelled} canceladas`;
    } else if (uiStatus === 'stale') {
      chipLabel = 'Con retraso';
      chipClass = 'caducado';
      title = 'W6 con retraso';
      meta = `${fmtRelativeSyncAge(lastSuccessAt)} | ultima lectura ${fetched} evento(s)`;
    } else if (uiStatus === 'error') {
      chipLabel = 'Error';
      chipClass = 'rechazado';
      title = 'W6 con error';
      meta = syncStatus?.error ? String(syncStatus.error) : 'El sincronizador devolvio un error.';
    } else if (summary?.enabled) {
      chipLabel = 'Solo vista';
      chipClass = 'pendiente';
      title = 'Sin heartbeat de W6';
      meta = `La agenda se reconcilio al abrir esta vista | ${persisted} nuevas | ${updated} actualizadas | ${cancelled} canceladas`;
    }

    if (trigger && ['healthy', 'stale', 'error'].includes(uiStatus)) {
      title += trigger === 'background' ? '' : ` (${trigger})`;
    }

    const facts: Array<{ label: string; value: string }> = [];
    if (summary?.enabled !== undefined) facts.push({ label: 'Lectura', value: summary?.enabled ? 'Calendar activo' : 'Calendar desactivado' });
    if (lastSuccessAt) facts.push({ label: 'Ultimo ciclo', value: fmtRelativeSyncAge(lastSuccessAt) });
    if (syncStatus?.next_expected_at) facts.push({ label: 'Proximo', value: fmtRelativeSyncAge(syncStatus.next_expected_at) });
    if (syncStatus?.error) facts.push({ label: 'Ultimo error', value: String(syncStatus.error) });

    const viewModel = { uiStatus, chipLabel, chipClass, title, meta, facts };
    dashboardRuntime.syncUi = viewModel;
    applySyncStatusView(agendaSyncChip, agendaSyncTitle, agendaSyncMeta, agendaSyncFacts, viewModel);
    applySyncStatusView(dashboardSyncChip, dashboardSyncTitle, dashboardSyncMeta, dashboardSyncFacts, viewModel);
    syncDashboardCommandCenter();
  };

  const renderAgendaCalendar = (citas: any[], weekStart: Date) => {
    const cal = document.getElementById('agendaCalendar');
    if (!cal) return;

    const HOUR_SLOTS = [9, 10, 11, 12, 15, 16, 17, 18];
    const weekDays: Date[] = Array.from({ length: 5 }, (_, i) => {
      const d = new Date(weekStart);
      d.setDate(weekStart.getDate() + i);
      return d;
    });

    // Map day/hour -> appointments
    const apptMap = new Map<string, any[]>();
    const allDayMap = new Map<number, any[]>();
    for (const cita of citas) {
      const start = new Date(cita.inicio_en);
      const dayIdx = weekDays.findIndex(d => d.toDateString() === start.toDateString());
      if (dayIdx < 0) continue;
      if (isAllDayAppointment(cita)) {
        if (!allDayMap.has(dayIdx)) allDayMap.set(dayIdx, []);
        allDayMap.get(dayIdx)!.push(cita);
        continue;
      }
      const hour = start.getHours();
      const slotHour = HOUR_SLOTS.find(h => hour >= h && hour < h + 1);
      if (slotHour === undefined) continue;
      const key = `${dayIdx}-${slotHour}`;
      if (!apptMap.has(key)) apptMap.set(key, []);
      apptMap.get(key)!.push(cita);
    }

    // Status colors (inline styles because Astro scoped styles don't apply to dynamic innerHTML)
    const STATUS: Record<string, { bg: string; color: string; border: string }> = {
      confirmada: { bg: '#d1fae5', color: '#065f46', border: '#10b981' },
      pendiente:  { bg: '#fef3c7', color: '#92400e', border: '#f59e0b' },
      cancelada:  { bg: '#f1f5f9', color: '#94a3b8', border: '#cbd5e1' },
      completada: { bg: '#ede9fe', color: '#4c1d95', border: '#7c3aed' },
      no_show:    { bg: '#fff1f2', color: '#be123c', border: '#f43f5e' },
    };
    const DEF = STATUS.pendiente;
    const todayStr = new Date().toDateString();

    // Table layout inline so it works regardless of Astro style scoping
    const thBase = 'padding:10px 8px;text-align:center;border-bottom:2px solid #e2e8f0;font-size:0.8rem;font-weight:700;white-space:nowrap;';
    let html = `<div style="overflow-x:auto;width:100%;">
<table style="width:100%;border-collapse:collapse;table-layout:fixed;min-width:520px;">
<thead><tr>
  <th style="${thBase}width:52px;background:#f8fafc;color:#94a3b8;"></th>`;

    for (let i = 0; i < 5; i++) {
      const isToday = weekDays[i].toDateString() === todayStr;
      const dayNum = weekDays[i].toLocaleDateString('es-ES', { day: 'numeric' });
      const dayName = weekDays[i].toLocaleDateString('es-ES', { weekday: 'short' });
      const bg = isToday ? '#eff6ff' : '#f8fafc';
      const col = isToday ? '#2563eb' : '#334155';
      const allDayClosures = allDayMap.get(i) || [];
      const allDayHtml = allDayClosures.map((cita: any) => {
        const label = cita.nombre_paciente || cita.motivo || 'Cerrado';
        return `<div title="${escapeAttr(label)}" style="margin-top:4px;background:#dcfce7;color:#166534;border:1px solid #86efac;border-radius:999px;padding:2px 6px;font-size:0.62rem;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">${escapeHtml(label)}</div>`;
      }).join('');
      html += `<th style="${thBase}background:${bg};color:${col};text-transform:capitalize;vertical-align:top;">
        <span style="display:block;font-size:0.7rem;font-weight:500;opacity:0.7;">${escapeHtml(dayName)}</span>
        <span style="display:block;font-size:1.1rem;font-weight:700;">${dayNum}</span>
        ${allDayHtml}
      </th>`;
    }
    html += '</tr></thead><tbody>';

    // Separator row between morning and afternoon
    for (let si = 0; si < HOUR_SLOTS.length; si++) {
      const hour = HOUR_SLOTS[si];
      const prevHour = si > 0 ? HOUR_SLOTS[si - 1] : null;
      // Lunch break separator
      if (prevHour !== null && hour - prevHour > 1) {
        html += `<tr><td colspan="6" style="padding:4px 8px;background:#f8fafc;border-top:2px dashed #e2e8f0;border-bottom:2px dashed #e2e8f0;text-align:center;font-size:0.7rem;color:#94a3b8;font-style:italic;">pausa 13:00 - 15:00</td></tr>`;
      }

      const timeLabel = `${String(hour).padStart(2,'0')}:00`;
      html += `<tr>
        <td style="padding:6px 8px;text-align:right;font-size:0.72rem;color:#94a3b8;font-weight:600;vertical-align:top;white-space:nowrap;background:#f8fafc;border-right:2px solid #e2e8f0;border-bottom:1px solid #f1f5f9;">${timeLabel}</td>`;

      for (let dayIdx = 0; dayIdx < 5; dayIdx++) {
        const appts = apptMap.get(`${dayIdx}-${hour}`) || [];
        const isToday = weekDays[dayIdx].toDateString() === todayStr;
        const cellBg = isToday ? '#fafcff' : '#fff';
        html += `<td style="padding:3px;vertical-align:top;background:${cellBg};border-bottom:1px solid #f1f5f9;border-right:1px solid #f1f5f9;min-height:58px;height:58px;">`;
        for (const a of appts) {
          const st = a.estado || 'pendiente';
          const calendarOnly = isCalendarOnlyAppointment(a);
          const blockMeta = calendarOnly ? getAgendaCalendarBlockMeta(a) : null;
          const c = calendarOnly
            ? (blockMeta?.colors || { bg: '#fff7ed', color: '#9a3412', border: '#f97316' })
            : (STATUS[st] || DEF);
          const firstName = calendarOnly
            ? (blockMeta?.shortLabel || 'Bloqueo')
            : (a.nombre_paciente || 'Paciente').split(' ')[0];
          const timeStr = fmtHourOnly(a.inicio_en);
          const motivo = calendarOnly
            ? ((a.motivo || a.nombre_paciente || blockMeta?.label || 'Google Calendar').slice(0, 26))
            : (a.motivo ? a.motivo.slice(0, 22) : '');
          const tipLabel = calendarOnly
            ? `${blockMeta?.label || 'Bloqueo Google Calendar'}${a.motivo ? ` - ${a.motivo}` : ''}`
            : `${a.nombre_paciente || ''}${a.motivo ? ` - ${a.motivo}` : ''}`;
          const tip = escapeAttr(tipLabel);
          const calPatId = escapeAttr(a.paciente_id || '');
          const calPatName = escapeAttr(a.nombre_paciente || 'Paciente');
          html += `<div data-cal-appt-patient="${calPatId}" data-cal-appt-name="${calPatName}" style="background:${c.bg};color:${c.color};border-left:3px solid ${c.border};border-radius:4px;padding:3px 5px 4px;margin-bottom:2px;font-size:0.71rem;overflow:hidden;cursor:${calendarOnly ? 'default' : 'pointer'};line-height:1.3;" title="${tip}">
            <div style="font-weight:700;font-size:0.63rem;opacity:0.8;margin-bottom:1px;">${timeStr}</div>
            <div style="font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">${escapeHtml(firstName)}</div>
            ${motivo ? `<div style="font-size:0.62rem;opacity:0.75;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">${escapeHtml(motivo)}</div>` : ''}
          </div>`;
        }
        html += '</td>';
      }
      html += '</tr>';
    }

    html += '</tbody></table></div>';
    cal.innerHTML = html;
  };

  const renderAgendaMobileTimeline = (operationalCitas: any[] = [], allCitas: any[] = [], weekStart: Date) => {
    if (!agendaMobileList || !agendaMobileSummary) return;

    const calendarOnlySummary = summarizeCalendarOnlyBlocks(allCitas);
    const sorted = [...operationalCitas].sort((a: any, b: any) => new Date(a.inicio_en).getTime() - new Date(b.inicio_en).getTime());
    const weekDays = Array.from({ length: 5 }, (_, idx) => {
      const date = new Date(weekStart);
      date.setDate(date.getDate() + idx);
      return date;
    });

    if (!sorted.length) {
      agendaMobileSummary.textContent = calendarOnlySummary.total
        ? `Sin citas clinicas en esta semana. Google Calendar aporta ${calendarOnlySummary.total} bloqueo(s) de contexto.`
        : 'Sin citas clinicas en esta semana.';
      setListState(agendaMobileList, 'event_busy', 'No hay citas clinicas para mostrar en timeline movil.');
      return;
    }

    const itemsByDay = new Map<string, any[]>();
    for (const cita of sorted) {
      const key = new Date(cita.inicio_en).toDateString();
      if (!itemsByDay.has(key)) itemsByDay.set(key, []);
      itemsByDay.get(key)!.push(cita);
    }

    const todayItems = sorted.filter((cita: any) => isTodayDate(cita.inicio_en || ''));
    agendaMobileSummary.textContent = `${sorted.length} cita(s) esta semana | ${todayItems.length} hoy | ${calendarOnlySummary.blocking} bloqueo(s) externo(s).`;

    agendaMobileList.innerHTML = weekDays.map((date) => {
      const key = date.toDateString();
      const dayItems = itemsByDay.get(key) || [];
      const isToday = isTodayDate(date.toISOString());
      const dayTitle = date.toLocaleDateString('es-ES', { weekday: 'long', day: 'numeric', month: 'short' });

      if (!dayItems.length) {
        return `
          <article class="agenda-mobile-day ${isToday ? 'is-today' : ''}">
            <header>
              <strong>${escapeHtml(dayTitle)}</strong>
              <span>Sin citas</span>
            </header>
            <p class="agenda-mobile-empty">Dia libre para captacion, seguimiento o documentacion.</p>
          </article>
        `;
      }

      return `
        <article class="agenda-mobile-day ${isToday ? 'is-today' : ''}">
          <header>
            <strong>${escapeHtml(dayTitle)}</strong>
            <span>${dayItems.length} cita(s)</span>
          </header>
          <div class="agenda-mobile-items">
            ${dayItems.map((cita: any) => {
              const estado = String(cita?.estado || 'pendiente');
              const mirror = getAgendaMirrorMeta(cita);
              const patientName = String(cita?.nombre_paciente || 'Paciente');
              const patientId = String(cita?.paciente_id || '');
              const hour = isAllDayAppointment(cita) ? 'Todo el dia' : fmtHourOnly(cita?.inicio_en);
              const canal = cita?.canal_origen === 'crm_web' ? 'CRM Web' : cita?.canal_origen === 'telegram' ? 'Telegram' : String(cita?.canal_origen || 'Canal CRM');
              const apptId = escapeAttr(cita?.id || '');
              const canConfirm = estado === 'pendiente';
              return `
                <article class="agenda-mobile-item">
                  <div class="agenda-mobile-item-main">
                    <div class="agenda-mobile-item-top">
                      <strong>${escapeHtml(hour)} | ${escapeHtml(patientName)}</strong>
                      <span class="status-chip ${escapeAttr(estado)}">${escapeHtml(estado)}</span>
                    </div>
                    <p>${escapeHtml(cita?.motivo || 'Sesion clinica sin motivo especificado.')}</p>
                    <div class="agenda-mobile-item-meta">
                      <span class="agenda-mobile-meta-pill">${escapeHtml(canal)}</span>
                      <span class="agenda-mobile-meta-pill">${escapeHtml(mirror.label)}</span>
                    </div>
                  </div>
                  <div class="agenda-mobile-item-actions">
                    ${canConfirm ? `<button type="button" class="btn-sm" data-appt-action="confirmada" data-appt-id="${apptId}" title="Confirmar cita"><span class="material-symbols-rounded">check</span> Confirmar</button>` : ''}
                    <button type="button" class="btn-sm btn-outline" data-appt-action="ficha" data-appt-id="${apptId}" data-patient-id="${escapeAttr(patientId)}" data-patient-name="${escapeAttr(patientName)}" ${patientId ? '' : 'disabled'} title="Abrir ficha del paciente"><span class="material-symbols-rounded">person</span> Ficha</button>
                  </div>
                </article>
              `;
            }).join('')}
          </div>
        </article>
      `;
    }).join('');
  };

  // === LOAD CITAS ===
  const loadCitas = async () => {
    const cal = document.getElementById('agendaCalendar');
    if (cal) cal.innerHTML = '<div class="agenda-cal-loading"><span class="material-symbols-rounded">sync</span> Cargando...</div>';
    if (citasBody) setTableState(citasBody, 8, 'sync', 'Cargando agenda...', true);
    if (agendaMobileList) setListState(agendaMobileList, 'sync', 'Cargando timeline movil...', true);
    if (agendaMobileSummary) agendaMobileSummary.textContent = 'Sincronizando agenda semanal...';
    setListState(dashCitasBody, 'sync', 'Actualizando agenda...', true);

    const weekLabelEl = document.getElementById('weekLabel');
    if (weekLabelEl) {
      const weekEnd = new Date(agendaWeekStart);
      weekEnd.setDate(agendaWeekStart.getDate() + 4);
      weekLabelEl.textContent = `${agendaWeekStart.toLocaleDateString('es-ES', { day: 'numeric', month: 'short' })} - ${weekEnd.toLocaleDateString('es-ES', { day: 'numeric', month: 'short', year: 'numeric' })}`;
    }

    const desde = new Date(agendaWeekStart).toISOString();
    const hastaDate = new Date(agendaWeekStart);
    hastaDate.setDate(hastaDate.getDate() + 5);
    const hasta = hastaDate.toISOString();

    try {
      const [payload, syncPayload] = await Promise.all([
        fetchJson(
          `${BACKEND_BASE}/api/profesional/appointments?fisioterapeuta_id=${PROF_ID}&limit=100&desde=${encodeURIComponent(desde)}&hasta=${encodeURIComponent(hasta)}`
        ),
        fetchJson(`${BACKEND_BASE}/api/profesional/appointments/sync-calendar/status`).catch(() => ({ data: null })),
      ]);
      const citas = payload.data || [];
      const operationalCitas = getOperationalAgendaAppointments(citas);
      const calendarOnlySummary = summarizeCalendarOnlyBlocks(citas);
      renderAgendaSyncStatus(syncPayload?.data || null, payload?.calendar_sync || null);
      renderAgendaCalendarMeta(citas);
      renderDashboardCitas(operationalCitas);
      const todayCount = operationalCitas.filter((c: any) => !isAllDayAppointment(c) && isTodayDate(c.inicio_en || '')).length;
      const metricEl = document.getElementById('metricSesiones');
      if (metricEl) metricEl.textContent = String(todayCount);

      renderAgendaCalendar(citas, agendaWeekStart);
      renderAgendaMobileTimeline(operationalCitas, citas, agendaWeekStart);

      const countEl = document.getElementById('weekPatientCount');
      if (countEl) countEl.textContent = String(getVisibleAgendaPatientCount(citas));

      if (!citasBody) return;
      if (!operationalCitas.length) {
        const externalMessage = calendarOnlySummary.total
          ? `No hay citas clinicas esta semana. Google Calendar aporta ${calendarOnlySummary.blocking} bloqueo${calendarOnlySummary.blocking === 1 ? '' : 's'} real${calendarOnlySummary.blocking === 1 ? '' : 'es'}, ${calendarOnlySummary.managed} cita${calendarOnlySummary.managed === 1 ? '' : 's'} solo Calendar y ${calendarOnlySummary.holidays} festivo${calendarOnlySummary.holidays === 1 ? '' : 's'} de referencia.`
          : 'No hay citas esta semana.';
        setTableState(citasBody, 8, 'event_busy', externalMessage);
        return;
      }
      const sorted = [...operationalCitas].sort((a: any, b: any) => new Date(a.inicio_en).getTime() - new Date(b.inicio_en).getTime());
      citasBody.innerHTML = sorted.map((cita: any) => {
        const start = new Date(cita.inicio_en);
        const dayStr = fmtDayFull(start);
        const hourStr = isAllDayAppointment(cita) ? 'Todo el dia' : fmtHourOnly(cita.inicio_en);
        const canal = cita.canal_origen === 'telegram'
          ? 'Telegram'
          : cita.canal_origen === 'crm_web'
            ? 'CRM Web'
            : cita.canal_origen || '-';
        const mirror = getAgendaMirrorMeta(cita);
        const estado = cita.estado || 'pendiente';
        const apptId = escapeAttr(cita.id);
        const patId = escapeAttr(cita.paciente_id || '');
        const patientLabel = cita.nombre_paciente || 'Paciente';
        const patName = escapeAttr(patientLabel);
        const actions: string[] = [];
        if (estado === 'pendiente') actions.push(`<button class="btn-ghost btn-xs" data-appt-action="confirmada" data-appt-id="${apptId}" title="Confirmar">&#x2713;</button>`);
        if (estado === 'confirmada' || estado === 'pendiente') actions.push(`<button class="btn-ghost btn-xs" data-appt-action="completada" data-appt-id="${apptId}" title="Completar"><span class="material-symbols-rounded" style="font-size:15px">check_circle</span></button>`);
        if (estado !== 'cancelada' && estado !== 'completada') actions.push(`<button class="btn-ghost btn-xs btn-danger-ghost" data-appt-action="cancelada" data-appt-id="${apptId}" title="Cancelar"><span class="material-symbols-rounded" style="font-size:15px">close</span></button>`);
        if (estado === 'confirmada' && !isTodayDate(cita.inicio_en)) actions.push(`<button class="btn-ghost btn-xs" data-appt-action="no_show" data-appt-id="${apptId}" title="No show"><span class="material-symbols-rounded" style="font-size:15px">person_off</span></button>`);
        actions.push(`<button class="btn-ghost btn-xs" data-appt-action="ficha" data-appt-id="${apptId}" data-patient-id="${patId}" data-patient-name="${patName}" title="Ver ficha"><span class="material-symbols-rounded" style="font-size:15px">person</span></button>`);
        return `<tr>
          <td class="td-patient">${escapeHtml(patientLabel)}</td>
          <td>${escapeHtml(dayStr)}</td>
          <td>${escapeHtml(hourStr)}</td>
          <td>${escapeHtml(cita.motivo || '-')}</td>
          <td>${escapeHtml(canal)}</td>
          <td><span class="status-chip ${mirror.chipClass}" title="${escapeAttr(mirror.note)}">${escapeHtml(mirror.label)}</span></td>
          <td><span class="status-chip ${estado}">${escapeHtml(estado)}</span></td>
          <td class="td-actions">${actions.join('')}</td>
        </tr>`;
      }).join('');
    } catch {
      renderAgendaSyncStatus({ ui_status: 'error', error: 'No se pudo consultar el estado del sync de Google Calendar.' }, null);
      if (agendaCalendarMeta) {
        agendaCalendarMeta.hidden = true;
        agendaCalendarMeta.textContent = '';
      }
      if (agendaMobileSummary) agendaMobileSummary.textContent = 'No se pudo cargar la agenda movil esta vez.';
      if (agendaMobileList) setListState(agendaMobileList, 'cloud_off', 'No se pudo cargar el timeline movil.');
      if (cal) cal.innerHTML = '<div class="agenda-cal-loading">Error al cargar la agenda</div>';
      setTableState(citasBody, 8, 'cloud_off', 'Error al cargar citas');
      renderDashboardCitas([], 'error');
    }
  };

  let agendaAutoRefreshHandle: number | null = null;
  const syncAgendaAutoRefresh = () => {
    if (agendaAutoRefreshHandle) {
      window.clearInterval(agendaAutoRefreshHandle);
      agendaAutoRefreshHandle = null;
    }

    if (!['dashboard', 'citas'].includes(activeSection)) return;

    agendaAutoRefreshHandle = window.setInterval(() => {
      if (document.hidden) return;
      loadCitas();
    }, 45000);
  };

  document.addEventListener('visibilitychange', () => {
    if (document.hidden) return;
    if (['dashboard', 'citas'].includes(activeSection)) {
      loadCitas();
    }
  });

  pageLoaders['citas'] = loadCitas;
  document.getElementById('refreshCitas')?.addEventListener('click', loadCitas);
  document.getElementById('prevWeek')?.addEventListener('click', () => {
    agendaWeekStart = new Date(agendaWeekStart);
    agendaWeekStart.setDate(agendaWeekStart.getDate() - 7);
    loadCitas();
  });
  document.getElementById('nextWeek')?.addEventListener('click', () => {
    agendaWeekStart = new Date(agendaWeekStart);
    agendaWeekStart.setDate(agendaWeekStart.getDate() + 7);
    loadCitas();
  });
  document.getElementById('thisWeek')?.addEventListener('click', () => {
    agendaWeekStart = getWeekMonday(new Date());
    loadCitas();
  });
  loadCitas();
  syncAgendaAutoRefresh();

  // === APPOINTMENT MODAL ===
  const appointmentModal = document.getElementById('appointmentModal') as HTMLElement | null;
  const openAppointmentModal = async () => {
    await ensurePatientCatalog();
    renderAppointmentPatientOptions();
    setAppointmentFormDefaults(true);
    setAppointmentFormFeedback();
    appointmentModal?.classList.add('open');
    appointmentModal?.setAttribute('aria-hidden', 'false');
    document.body.classList.add('has-modal-open');
    window.setTimeout(() => appointmentPatientSelect?.focus(), 25);
  };
  const closeAppointmentModal = () => {
    appointmentModal?.classList.remove('open');
    appointmentModal?.setAttribute('aria-hidden', 'true');
    document.body.classList.remove('has-modal-open');
    appointmentForm?.reset();
    setAppointmentFormFeedback();
  };
  document.getElementById('openNewAppointmentBtn')?.addEventListener('click', openAppointmentModal);
  document.getElementById('closeAppointmentModalBtn')?.addEventListener('click', closeAppointmentModal);
  document.getElementById('appointmentModalDismiss')?.addEventListener('click', closeAppointmentModal);
  appointmentModal?.addEventListener('click', (e) => { if (e.target === appointmentModal) closeAppointmentModal(); });

  appointmentForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const pacienteId = appointmentPatientSelect?.value;
    const inicioEn = appointmentStartInput?.value;
    const finEn = appointmentEndInput?.value;
    const motivo = appointmentReasonInput?.value?.trim() || '';
    if (!pacienteId || !inicioEn || !finEn) {
      setAppointmentFormFeedback('Completa paciente, inicio y fin.', 'error');
      return;
    }
    if (new Date(finEn) <= new Date(inicioEn)) {
      setAppointmentFormFeedback('La hora de fin debe ser posterior al inicio.', 'error');
      return;
    }
    if (appointmentSubmitBtn) appointmentSubmitBtn.disabled = true;
    setAppointmentFormFeedback();
    try {
      const res = await fetchJson(`${BACKEND_BASE}/api/profesional/appointments`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          paciente_id: pacienteId,
          fisioterapeuta_id: PROF_ID,
          inicio_en: new Date(inicioEn).toISOString(),
          fin_en: new Date(finEn).toISOString(),
          motivo,
          canal_origen: 'crm_web',
        }),
      });
      if (res.error) throw new Error(res.error);
      setAppointmentFormFeedback('Cita creada correctamente', 'success');
      if (pendingIntakeIdForAppointment) {
        intakeScheduledSet.add(pendingIntakeIdForAppointment);
        persistIntakeScheduledSet();
      }
      pendingIntakeIdForAppointment = null;
      window.setTimeout(() => { closeAppointmentModal(); loadCitas(); }, 600);
    } catch (err: any) {
      setAppointmentFormFeedback(err.message || 'Error al crear la cita', 'error');
      pendingIntakeIdForAppointment = null;
    } finally {
      if (appointmentSubmitBtn) appointmentSubmitBtn.disabled = false;
    }
  });

  // === APPOINTMENT ACTIONS (table + calendar) ===
  const updateAppointmentStatus = async (appointmentId: string, newStatus: string) => {
    try {
      const res = await fetchJson(`${BACKEND_BASE}/api/profesional/appointments/${appointmentId}`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ estado: newStatus }),
      });
      if (res.error) throw new Error(res.error);
      loadCitas();
    } catch (err: any) {
      console.error('Error updating appointment:', err);
    }
  };

  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    const actionBtn = target.closest('[data-appt-action]') as HTMLElement | null;
    if (actionBtn) {
      const action = actionBtn.getAttribute('data-appt-action')!;
      const apptId = actionBtn.getAttribute('data-appt-id')!;
      if (action === 'ficha') {
        const patientId = actionBtn.getAttribute('data-patient-id') || '';
        const patientName = actionBtn.getAttribute('data-patient-name') || '';
        if (patientId) {
          selectedPatientId = patientId;
          selectedPatientName = patientName;
          syncChatPatientSelection(patientId, patientName);
          void openFichaPaciente(patientId);
        }
      } else {
        updateAppointmentStatus(apptId, action);
      }
      return;
    }
    const calAppt = target.closest('[data-cal-appt-patient]') as HTMLElement | null;
    if (calAppt) {
      const patientId = calAppt.getAttribute('data-cal-appt-patient') || '';
      const patientName = calAppt.getAttribute('data-cal-appt-name') || '';
      if (patientId) {
        selectedPatientId = patientId;
        selectedPatientName = patientName;
        syncChatPatientSelection(patientId, patientName);
        void openFichaPaciente(patientId);
      }
    }
  });

  const historyNoteComposerHtml = `
    <form class="history-note-form" data-role="history-note-form">
      <label class="history-note-field">
        <span>Nueva nota clinica</span>
        <textarea name="texto_nota" rows="4" placeholder="Ej.: mejor tolerancia a la movilidad, mantiene dolor 3/10 y cumple ejercicios domiciliarios." required></textarea>
      </label>
      <input type="hidden" name="fuente" value="crm_web" />
      <p class="history-note-feedback" data-role="history-note-feedback" hidden></p>
      <div class="history-note-actions">
        <button type="submit" class="btn-primary btn-history-note">
          <span class="material-symbols-rounded">note_add</span>
          Guardar seguimiento
        </button>
      </div>
    </form>
  `;

  const setHistoryNoteFeedback = (formEl: HTMLFormElement | null, text = '', state: 'error' | 'success' = 'error') => {
    const feedbackEl = formEl?.querySelector('[data-role="history-note-feedback"]') as HTMLElement | null;
    if (!feedbackEl) return;
    if (!text) {
      feedbackEl.hidden = true;
      feedbackEl.textContent = '';
      feedbackEl.removeAttribute('data-state');
      return;
    }
    feedbackEl.hidden = false;
    feedbackEl.textContent = text;
    feedbackEl.setAttribute('data-state', state);
  };

  const recommendationFollowUpStateOptions = [
    { value: 'generada', label: 'Generada' },
    { value: 'enviada', label: 'Enviada al paciente' },
    { value: 'requiere_revision', label: 'Requiere revision' },
    { value: 'error', label: 'Error' },
  ];

  const recommendationFollowUpAdherenceOptions = [
    { value: '', label: 'Sin clasificar' },
    { value: 'alta', label: 'Alta' },
    { value: 'media', label: 'Media' },
    { value: 'baja', label: 'Baja' },
  ];

  const renderRecommendationFollowUpForm = (recommendation: any, latestFollowUp: any = null) => {
    const recommendationId = String(recommendation?.id || '').trim();
    if (!recommendationId) return '';

    const currentState = String(recommendation?.estado || latestFollowUp?.estado_actual || 'generada').trim().toLowerCase();
    const defaultAdherence = String(latestFollowUp?.adherence_status || '').trim().toLowerCase();
    const defaultPain = latestFollowUp?.pain_scale !== null && latestFollowUp?.pain_scale !== undefined ? String(latestFollowUp.pain_scale) : '';
    const defaultNote = String(latestFollowUp?.note_text || '').trim();
    const lastTouch = latestFollowUp?.created_at || latestFollowUp?.fecha || null;
    const adherenceMeta = getRecommendationAdherenceMeta(defaultAdherence);
    const adherenceOptionsHtml = recommendationFollowUpAdherenceOptions.map((option) => `<option value="${escapeAttr(option.value)}"${option.value === defaultAdherence ? ' selected' : ''}>${escapeHtml(option.label)}</option>`).join('');
    const stateOptionsHtml = recommendationFollowUpStateOptions.map((option) => `<option value="${escapeAttr(option.value)}"${option.value === currentState ? ' selected' : ''}>${escapeHtml(option.label)}</option>`).join('');

    return `
      <div class="recommendation-followup-shell">
        <div class="recommendation-followup-summary">
          <div>
            <strong>${lastTouch ? 'Ultimo feedback registrado' : 'Seguimiento pendiente'}</strong>
            <p>${lastTouch ? `Actualizado ${escapeHtml(fmtDate(lastTouch))}.` : 'Guarda adherencia, dolor y siguiente paso para que el caso tenga continuidad domiciliaria.'}</p>
          </div>
          <div class="recommendation-followup-chips">
            <span class="status-chip ${escapeAttr(adherenceMeta.tone)}">${escapeHtml(adherenceMeta.label)}</span>
            <span class="status-chip ${escapeAttr(currentState === 'enviada' ? 'aprobado' : currentState === 'requiere_revision' ? 'rechazado' : 'pendiente')}">${escapeHtml(currentState.replace(/_/g, ' '))}</span>
          </div>
        </div>
        <form class="recommendation-followup-form" data-role="recommendation-followup-form" data-recommendation-id="${escapeAttr(recommendationId)}">
          <div class="recommendation-followup-grid">
            <label class="recommendation-followup-field">
              <span>Adherencia</span>
              <select name="adherence_status">${adherenceOptionsHtml}</select>
            </label>
            <label class="recommendation-followup-field">
              <span>Dolor (0-10)</span>
              <input name="pain_scale" type="number" min="0" max="10" step="1" value="${escapeAttr(defaultPain)}" placeholder="Ej. 3" />
            </label>
            <label class="recommendation-followup-field">
              <span>Estado del plan</span>
              <select name="recommendation_state">${stateOptionsHtml}</select>
            </label>
          </div>
          <label class="recommendation-followup-field">
            <span>Nota clinica rapida</span>
            <textarea name="note_text" rows="3" placeholder="Ej.: mejor tolerancia, mantener progresion, revisar tecnica en proxima sesion.">${escapeHtml(defaultNote)}</textarea>
          </label>
          <p class="recommendation-followup-feedback" data-role="history-note-feedback" hidden></p>
          <div class="recommendation-followup-actions">
            <button type="submit" class="btn-secondary recommendation-followup-submit">
              <span class="material-symbols-rounded">monitor_heart</span>
              Guardar follow-up
            </button>
          </div>
        </form>
      </div>
    `;
  };

  const TELEGRAM_LINK_STATUS_META: Record<string, { label: string; chipClass: string }> = {
    linked: { label: 'Vinculado', chipClass: 'aprobado' },
    pending: { label: 'Codigo pendiente', chipClass: 'pendiente' },
    not_linked: { label: 'Sin vincular', chipClass: 'rechazado' },
  };

  const copyTextToClipboard = async (rawValue: unknown) => {
    const value = String(rawValue || '').trim();
    if (!value) return false;

    if (navigator?.clipboard?.writeText) {
      await navigator.clipboard.writeText(value);
      return true;
    }

    return false;
  };

  let bookingFeedbackTimeout: number | null = null;
  const setBookingLinkFeedback = (text = '', state: 'success' | 'error' = 'success') => {
    if (!bookingFeedback) return;
    if (bookingFeedbackTimeout) {
      window.clearTimeout(bookingFeedbackTimeout);
      bookingFeedbackTimeout = null;
    }
    if (!text) {
      bookingFeedback.hidden = true;
      bookingFeedback.textContent = '';
      bookingFeedback.removeAttribute('data-state');
      return;
    }
    bookingFeedback.hidden = false;
    bookingFeedback.textContent = text;
    bookingFeedback.setAttribute('data-state', state);
    bookingFeedbackTimeout = window.setTimeout(() => {
      bookingFeedback.hidden = true;
      bookingFeedback.textContent = '';
      bookingFeedback.removeAttribute('data-state');
      bookingFeedbackTimeout = null;
    }, 3200);
  };

  const syncBookingLinkUi = () => {
    const publicBookingUrl = buildPublicBookingUrl();
    if (bookingUrlInput) bookingUrlInput.value = publicBookingUrl;
    syncDashboardBookingMeta();
  };

  const renderPatientTelegramLinkBlock = (linkState: any, errorMessage = '') => {
    if (errorMessage) {
      return `
        <div class="detail-block">
          <h3>Canal Telegram</h3>
          <p class="detail-caption telegram-link-error">${escapeHtml(errorMessage)}</p>
        </div>
      `;
    }

    const normalizedStatus = String(linkState?.link_status || 'not_linked');
    const statusMeta = TELEGRAM_LINK_STATUS_META[normalizedStatus] || TELEGRAM_LINK_STATUS_META.not_linked;
    const username = linkState?.telegram_username ? `@${linkState.telegram_username}` : null;
    const linkedAt = linkState?.vinculado_en ? fmtDate(linkState.vinculado_en) : null;
    const startCommand = linkState?.telegram_start_command || '';
    const deepLink = linkState?.telegram_deep_link || '';
    const actions: string[] = [];

    if (normalizedStatus === 'not_linked') {
      actions.push('<button type="button" class="btn-sm btn-outline" data-action="telegram-link-create">Preparar invitacion</button>');
    }

    if (normalizedStatus === 'pending') {
      if (deepLink) {
        actions.push(`<button type="button" class="btn-sm btn-outline" data-action="telegram-open-link" data-open-url="${escapeAttr(deepLink)}">Abrir bot</button>`);
      }
      actions.push(`<button type="button" class="btn-sm btn-outline" data-action="telegram-copy-command" data-copy-value="${escapeAttr(startCommand)}">Copiar /start</button>`);
      if (deepLink) {
        actions.push(`<button type="button" class="btn-sm btn-outline" data-action="telegram-copy-link" data-copy-value="${escapeAttr(deepLink)}">Copiar enlace</button>`);
      }
      actions.push('<button type="button" class="btn-sm btn-outline" data-action="telegram-link-regenerate">Regenerar codigo</button>');
    }

    if (normalizedStatus === 'linked' && deepLink) {
      actions.push(`<button type="button" class="btn-sm btn-outline" data-action="telegram-open-link" data-open-url="${escapeAttr(deepLink)}">Abrir bot</button>`);
    }

    const hint = normalizedStatus === 'linked'
      ? 'El paciente ya tiene un chat Telegram vinculado. No genero un codigo nuevo para no romper ese enlace.'
      : normalizedStatus === 'pending'
        ? 'Comparte el comando o el enlace con el paciente para completar la vinculacion desde Telegram.'
        : 'Genera una invitacion segura para que el paciente vincule su chat con /start.';

    return `
      <div class="detail-block" id="patientTelegramLinkBlock" tabindex="-1">
        <div class="telegram-link-head">
          <div>
            <h3>Canal Telegram</h3>
            <p class="detail-caption">${escapeHtml(hint)}</p>
          </div>
          <span class="status-chip ${statusMeta.chipClass}">${escapeHtml(statusMeta.label)}</span>
        </div>
        <div class="telegram-link-card">
          <div class="telegram-link-grid">
            <p><strong>Paciente:</strong> ${escapeHtml(linkState?.patient_name || selectedPatientName || 'Paciente seleccionado')}</p>
            <p><strong>Usuario:</strong> ${escapeHtml(username || 'Sin username')}</p>
            <p><strong>Vinculado:</strong> ${escapeHtml(linkedAt || 'Aun no')}</p>
            <p><strong>Codigo:</strong> ${escapeHtml(linkState?.codigo_vinculacion || 'No generado')}</p>
          </div>
          ${startCommand ? `<div class="telegram-link-command"><code>${escapeHtml(startCommand)}</code></div>` : ''}
          ${actions.length ? `<div class="telegram-link-actions">${actions.join('')}</div>` : ''}
        </div>
      </div>
    `;
  };

  // === LOAD HISTORIAL ===
  const loadHistorial = async () => {
    if (!historialContent) return;
    if (!selectedPatientId) {
      currentPatientTelegramLinkState = null;
      updateExerciseTelegramButton();
      historialContent.innerHTML = `<div class="empty-state"><span class="material-symbols-rounded">&#xe889;</span><p>Selecciona un paciente desde Pacientes, Agenda o la busqueda superior para revisar su seguimiento longitudinal.</p></div>`;
      return;
    }
    historialContent.innerHTML = `<div class="empty-state state-loading"><span class="material-symbols-rounded">sync</span><p>Cargando historial de ${escapeHtml(selectedPatientName || 'paciente')}...</p></div>`;

    const loadPiece = async (label: string, request: Promise<any>) => {
      try {
        return { ok: true, label, response: await request, error: '' };
      } catch (err: any) {
        return { ok: false, label, response: null, error: err?.message || 'No disponible' };
      }
    };

    try {
      const [patientPiece, historyPiece, recommendationsPiece, telegramPiece] = await Promise.all([
        loadPiece('datos del paciente', fetchJson(`${BACKEND_BASE}/api/pacientes/${selectedPatientId}`)),
        loadPiece('notas clinicas', fetchJson(`${BACKEND_BASE}/api/profesional/patients/${selectedPatientId}/history`)),
        loadPiece('planes de ejercicios', fetchJson(`${BACKEND_BASE}/api/exercises/recommendations/${selectedPatientId}?limit=25`)),
        loadPiece('Telegram', fetchJson(`${BACKEND_BASE}/api/telegram/link-code/${selectedPatientId}`)),
      ]);

      const patient = patientPiece.response?.data || {};
      const notes = historyPiece.response?.data?.notas_seguimiento || [];
      const recommendations = recommendationsPiece.response?.data || [];
      const telegramLink = telegramPiece.response?.data || null;
      const telegramLinkError = telegramPiece.error || '';
      currentPatientTelegramLinkState = telegramLink;
      updateExerciseTelegramButton();
      const displayName = patient?.nombre_completo || selectedPatientName || `Paciente #${selectedPatientId}`;
      syncAssistantPatientBriefFromData(selectedPatientId, patient, notes, recommendations);
      selectedPatientName = displayName;
      rememberSelectedPatient(selectedPatientId, displayName);
      const unavailablePieces = [patientPiece, historyPiece, recommendationsPiece, telegramPiece]
        .filter((piece) => !piece.ok)
        .map((piece) => `${piece.label}: ${piece.error}`);
      const historyPartialNotice = unavailablePieces.length
        ? `<div class="detail-block detail-block-warning"><h3>Historial cargado en modo parcial</h3><p>${escapeHtml(unavailablePieces.join(' · '))}</p></div>`
        : '';

      const pickLatestIsoDate = (current: string | null, candidate: string | null) => {
        if (!candidate) return current;
        if (!current) return candidate;
        return new Date(candidate).getTime() > new Date(current).getTime() ? candidate : current;
      };

      const notesHtml = notes.length
        ? `<ul class="detail-list">${notes.map((note: any) => `<li><strong>${fmtDate(note.creado_en || '')}</strong><br>${escapeHtml(note.texto_nota || 'Sin texto')}</li>`).join('')}</ul>`
        : `<p class="detail-empty">Sin notas de seguimiento registradas.</p>`;

      const recommendationsSummary = recommendations.reduce((acc: any, rec: any) => {
        const followUps = Array.isArray(rec?.follow_ups) ? rec.follow_ups : [];
        const archivedReports = Array.isArray(rec?.archived_reports) ? rec.archived_reports : [];
        const report = rec?.report_snapshot || {};
        const reportExercises = Array.isArray(report?.exercises) ? report.exercises : [];
        const itemExercises = Array.isArray(rec?.crm_recomendacion_items) ? rec.crm_recomendacion_items : [];
        const exercisesCount = reportExercises.length || itemExercises.length || 0;

        acc.totalExercises += exercisesCount;
        acc.totalFollowUps += followUps.length;
        acc.totalArchivedReports += archivedReports.length;
        acc.latestArchivedReportAt = archivedReports.reduce(
          (latest: string | null, item: any) => pickLatestIsoDate(latest, item?.archived_at || item?.created_at || null),
          acc.latestArchivedReportAt
        );
        return acc;
      }, {
        totalExercises: 0,
        totalFollowUps: 0,
        totalArchivedReports: 0,
        latestArchivedReportAt: null as string | null,
      });

      const recommendationsHtml = recommendations.length
        ? `<div class="recommendation-history-shell">
            <div class="recommendation-summary-grid">
              <article class="recommendation-summary-card">
                <span>Planes registrados</span>
                <strong>${recommendations.length}</strong>
                <p>Historial terapeutico acumulado para este paciente.</p>
              </article>
              <article class="recommendation-summary-card">
                <span>Ejercicios prescritos</span>
                <strong>${recommendationsSummary.totalExercises}</strong>
                <p>Total de ejercicios repartidos entre todos los planes.</p>
              </article>
              <article class="recommendation-summary-card">
                <span>Entregas archivadas</span>
                <strong>${recommendationsSummary.totalArchivedReports}</strong>
                <p>${recommendationsSummary.latestArchivedReportAt ? `Ultima entrega ${escapeHtml(fmtDate(recommendationsSummary.latestArchivedReportAt))}` : 'Sin entregas archivadas todavia.'}</p>
              </article>
              <article class="recommendation-summary-card">
                <span>Seguimientos</span>
                <strong>${recommendationsSummary.totalFollowUps}</strong>
                <p>Registros de evolucion y feedback del paciente.</p>
              </article>
            </div>
            <div class="recommendation-list">${recommendations.map((rec: any) => {
          const report = rec?.report_snapshot || {};
          const followUps = Array.isArray(rec?.follow_ups) ? [...rec.follow_ups] : [];
          const archivedReports = Array.isArray(rec?.archived_reports) ? [...rec.archived_reports] : [];
          const reportExercises = Array.isArray(report?.exercises) ? report.exercises : [];
          const itemExercises = Array.isArray(rec?.crm_recomendacion_items)
            ? rec.crm_recomendacion_items.map((item: any) => ({
              nombre: item?.crm_ejercicios_catalogo?.nombre || item?.ejercicio_id || 'Ejercicio',
              why: item?.why || '',
            }))
            : [];
          const exercises = reportExercises.length ? reportExercises : itemExercises;
          const sortedFollowUps = followUps.sort((a: any, b: any) => new Date(b?.created_at || b?.fecha || 0).getTime() - new Date(a?.created_at || a?.fecha || 0).getTime());
          const sortedArchivedReports = archivedReports.sort((a: any, b: any) => new Date(b?.archived_at || b?.created_at || 0).getTime() - new Date(a?.archived_at || a?.created_at || 0).getTime());
          const latestFollowUp = sortedFollowUps[0] || null;
          const latestArchivedReport = sortedArchivedReports[0] || null;
          const latestFollowUpMeta = getRecommendationAdherenceMeta(latestFollowUp?.adherence_status || null);
          const followUpFormHtml = renderRecommendationFollowUpForm(rec, latestFollowUp);
          const latestTouchAt = [
            rec?.created_at || null,
            latestFollowUp?.created_at || null,
            latestArchivedReport?.archived_at || null,
          ].reduce((latest: string | null, candidate: string | null) => pickLatestIsoDate(latest, candidate), null as string | null);
          const stateClass = rec?.estado === 'enviada'
            ? 'aprobado'
            : rec?.estado === 'requiere_revision'
              ? 'rechazado'
              : 'pendiente';
          const redFlagsHtml = rec?.red_flags_present
            ? '<span class="status-chip rechazado">Alertas rojas</span>'
            : '<span class="status-chip aprobado">Sin alertas</span>';
          const therapistNote = report?.message_to_therapist || rec?.message_to_therapist_es || '';
          const patientMsg = report?.message_to_patient || rec?.message_to_patient_es || '';
          const exercisesHtml = exercises.length
            ? `<ul class="recommendation-exercises">${exercises.slice(0, 8).map((ex: any, idx: number) => `<li><strong>${idx + 1}. ${escapeHtml(ex?.nombre || ex?.name || 'Ejercicio')}</strong>${ex?.why ? ` - ${escapeHtml(ex.why)}` : ''}</li>`).join('')}</ul>`
            : '<p class="detail-empty">Sin ejercicios detallados en esta recomendacion.</p>';
          const followUpsHtml = sortedFollowUps.length
            ? `<ul class="detail-list">${sortedFollowUps.slice(0, 5).map((fu: any) => `<li><strong>${fmtDate(fu?.created_at || '')}</strong><br>${escapeHtml(fu?.note_text || 'Seguimiento sin nota')}${fu?.pain_scale !== null && fu?.pain_scale !== undefined ? ` - Dolor ${escapeHtml(fu.pain_scale)}/10` : ''}</li>`).join('')}</ul>`
            : '<p class="detail-empty">Sin seguimiento registrado todavia.</p>';
          const archivedReportsHtml = sortedArchivedReports.length
            ? `<ul class="detail-list">${sortedArchivedReports.slice(0, 5).map((item: any) => `<li><strong>${fmtDate(item?.archived_at || '')}</strong><br>${escapeHtml((item?.format || 'pdf').toUpperCase())}${item?.source ? ` - ${escapeHtml(item.source)}` : ''}${item?.message_text ? ` - ${escapeHtml(item.message_text)}` : ''}</li>`).join('')}</ul>`
            : '<p class="detail-empty">Sin entregas o archivados registrados todavia.</p>';
          const activityTimeline = [
            {
              icon: 'assignment',
              tone: 'plan',
              at: rec?.created_at || null,
              title: 'Plan generado',
              detail: `${exercises.length} ejercicios${rec?.estado ? ` - Estado ${String(rec.estado).replace('_', ' ')}` : ''}`,
            },
            ...sortedArchivedReports.map((item: any) => ({
              icon: 'description',
              tone: 'delivery',
              at: item?.archived_at || item?.created_at || null,
              title: 'Entrega archivada',
              detail: `${String(item?.format || 'pdf').toUpperCase()}${item?.source ? ` - ${item.source}` : ''}${item?.message_text ? ` - ${item.message_text}` : ''}`,
            })),
            ...sortedFollowUps.map((fu: any) => ({
              icon: 'clinical_notes',
              tone: 'followup',
              at: fu?.created_at || fu?.fecha || null,
              title: 'Seguimiento registrado',
              detail: `${fu?.pain_scale !== null && fu?.pain_scale !== undefined ? `Dolor ${fu.pain_scale}/10 - ` : ''}${fu?.note_text || 'Sin nota adicional'}`,
            })),
          ]
            .filter((item: any) => item.at)
            .sort((a: any, b: any) => new Date(b.at || 0).getTime() - new Date(a.at || 0).getTime())
            .slice(0, 6);
          const activityTimelineHtml = activityTimeline.length
            ? `<div class="recommendation-timeline">${activityTimeline.map((item: any) => `
                <article class="recommendation-timeline-item">
                  <span class="recommendation-timeline-icon recommendation-timeline-icon-${escapeHtml(item.tone)}"><span class="material-symbols-rounded">${escapeHtml(item.icon)}</span></span>
                  <div class="recommendation-timeline-copy">
                    <strong>${escapeHtml(item.title)}</strong>
                    <p>${escapeHtml(item.detail)}</p>
                    <span>${escapeHtml(fmtDate(item.at || ''))}</span>
                  </div>
                </article>
              `).join('')}</div>`
            : '<p class="detail-empty">Sin actividad cronologica registrada todavia.</p>';

          return `
            <article class="recommendation-card">
              <div class="recommendation-head">
                <div>
                  <h4>Recomendacion ${escapeHtml(rec?.id || '-')}</h4>
                  <p>${fmtDate(rec?.created_at || '')}</p>
                </div>
                <div class="recommendation-chips">
                  <span class="status-chip ${stateClass}">${escapeHtml(rec?.estado || 'generada')}</span>
                  ${redFlagsHtml}
                </div>
              </div>
              <div class="recommendation-meta-grid">
                <div class="recommendation-meta-item">
                  <span>Ejercicios</span>
                  <strong>${exercises.length}</strong>
                </div>
                <div class="recommendation-meta-item">
                  <span>Entregas</span>
                  <strong>${sortedArchivedReports.length}</strong>
                </div>
                <div class="recommendation-meta-item">
                  <span>Seguimientos</span>
                  <strong>${sortedFollowUps.length}</strong>
                </div>
                <div class="recommendation-meta-item">
                  <span>Ultima actividad</span>
                  <strong>${latestTouchAt ? escapeHtml(fmtDate(latestTouchAt)) : 'Sin actividad'}</strong>
                </div>
              </div>
              ${therapistNote ? `<p class="recommendation-note"><strong>Nota clinica:</strong> ${escapeHtml(therapistNote)}</p>` : ''}
              ${patientMsg ? `<p class="recommendation-note"><strong>Mensaje paciente:</strong> ${escapeHtml(patientMsg)}</p>` : ''}
              <div class="recommendation-section">
                <h5>Linea temporal</h5>
                ${activityTimelineHtml}
              </div>
              <div class="recommendation-section">
                <h5>Ejercicios (${exercises.length})</h5>
                ${exercisesHtml}
              </div>
              <div class="recommendation-section">
                <div class="recommendation-section-head">
                  <h5>Seguimiento (${sortedFollowUps.length})</h5>
                  <span class="status-chip ${escapeAttr(latestFollowUpMeta.tone)}">${escapeHtml(latestFollowUpMeta.label)}</span>
                </div>
                ${followUpsHtml}
              </div>
              <div class="recommendation-section recommendation-section-followup">
                <div class="recommendation-section-head">
                  <h5>Registrar feedback rapido</h5>
                  <p>Actualiza adherencia, dolor y estado sin salir del historial.</p>
                </div>
                ${followUpFormHtml}
              </div>
              <div class="recommendation-section">
                <h5>Entregas y archivo (${sortedArchivedReports.length})</h5>
                ${archivedReportsHtml}
              </div>
            </article>
          `;
        }).join('')}</div>
          </div>`
        : `<p class="detail-empty">Sin recomendaciones de ejercicios registradas.</p>`;

      historialContent.innerHTML = `
        ${historyPartialNotice}
        <div class="detail-block history-case-hero">
          <div>
            <span class="detail-kicker">Caso seleccionado</span>
            <h3>${escapeHtml(displayName)}</h3>
            <p><strong>Email:</strong> ${escapeHtml(patient.email || '-')} - <strong>Nacimiento:</strong> ${patient.fecha_nacimiento ? fmtDate(patient.fecha_nacimiento) : '-'}</p>
          </div>
          <div class="history-case-actions">
            <button type="button" class="btn-secondary btn-sm" data-history-action="open-ficha"><span class="material-symbols-rounded">person</span> Abrir ficha</button>
            <button type="button" class="btn-ghost btn-sm" data-history-action="open-docs"><span class="material-symbols-rounded">description</span> Documentos del caso</button>
          </div>
        </div>
        ${renderPatientTelegramLinkBlock(telegramLink, telegramLinkError)}
        <div class="detail-block">
          <h3>Registrar seguimiento</h3>
          <p class="detail-caption">Guarda observaciones clinicas del paciente directamente desde el CRM. Usa Ctrl+Enter para enviar mas rapido.</p>
          ${historyNoteComposerHtml}
        </div>
        <div class="detail-block">
          <h3>Notas de seguimiento (${notes.length})</h3>
          ${notesHtml}
        </div>
        <div class="detail-block" id="patientRecommendationsBlock">
          <h3>Informes y recomendaciones (${recommendations.length})</h3>
          <p class="detail-caption">Cada plan conserva entregas, trazabilidad domiciliaria y feedback clinico del paciente.</p>
          ${recommendationsHtml}
        </div>
      `;

      if (pendingHistoryAnchor) {
        focusHistoryAnchor(pendingHistoryAnchor);
        pendingHistoryAnchor = null;
      }
    } catch {
      pendingHistoryAnchor = null;
      currentPatientTelegramLinkState = null;
      historialContent.innerHTML = `<div class="empty-state"><span class="material-symbols-rounded">cloud_off</span><p>No se pudo cargar el historial del paciente seleccionado.</p></div>`;
    }
  };
  pageLoaders['historial'] = loadHistorial;
  document.getElementById('refreshHistorial')?.addEventListener('click', loadHistorial);
  historyOpenFichaBtn?.addEventListener('click', () => {
    if (!selectedPatientId) {
      navigateTo('pacientes');
      return;
    }
    void openFichaPaciente(selectedPatientId);
  });
  historialContent?.addEventListener('click', async (event: Event) => {
    const target = event.target as HTMLElement | null;
    const historyActionBtn = target?.closest('button[data-history-action]') as HTMLButtonElement | null;
    if (historyActionBtn && selectedPatientId) {
      const action = historyActionBtn.getAttribute('data-history-action') || '';
      if (action === 'open-ficha') {
        void openFichaPaciente(selectedPatientId);
        return;
      }
      if (action === 'open-docs') {
        await openFichaPaciente(selectedPatientId);
        activateFichaTab('documentos');
        return;
      }
    }
    const btn = target?.closest('button[data-action^="telegram-"]') as HTMLButtonElement | null;
    if (!btn || !selectedPatientId) return;

    const action = btn.getAttribute('data-action') || '';
    const patientName = selectedPatientName || currentPatientTelegramLinkState?.patient_name || 'el paciente seleccionado';

    if (action === 'telegram-open-link') {
      const openUrl = btn.getAttribute('data-open-url') || '';
      if (!openUrl) {
        addMessage('No hay un enlace Telegram disponible para abrir.', 'agent');
        return;
      }
      window.open(openUrl, '_blank', 'noopener');
      addMessage(`Abriendo Telegram para ${patientName}.`, 'agent');
      return;
    }

    if (action === 'telegram-copy-command' || action === 'telegram-copy-link') {
      const copyValue = btn.getAttribute('data-copy-value') || '';
      if (!copyValue) {
        addMessage('No hay un valor de invitacion disponible para copiar.', 'agent');
        return;
      }

      try {
        const copied = await copyTextToClipboard(copyValue);
        addMessage(
          copied
            ? `Invitacion Telegram copiada para ${patientName}.`
            : 'No pude copiar el texto al portapapeles en este navegador.',
          'agent'
        );
      } catch {
        addMessage('No pude copiar el texto al portapapeles en este navegador.', 'agent');
      }
      return;
    }

    if (!['telegram-link-create', 'telegram-link-regenerate'].includes(action)) return;

    const previousLabel = btn.innerHTML;
    btn.disabled = true;
    btn.innerHTML = '<span class="material-symbols-rounded">sync</span> Preparando...';

    try {
      const payload = await fetchJson(`${BACKEND_BASE}/api/telegram/link-code/${selectedPatientId}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(action === 'telegram-link-regenerate' ? { regenerate: true } : {}),
      }, 15000);

      currentPatientTelegramLinkState = payload?.data || null;
      await loadHistorial();

      if (payload?.warning === 'patient_already_linked') {
        addMessage(
          `Telegram ya estaba vinculado para ${patientName}. No genero un codigo nuevo para no romper el chat actual.`,
          'agent'
        );
        return;
      }

      const command = payload?.data?.telegram_start_command || '';
      addMessage(
        command
          ? `Invitacion Telegram lista para ${patientName}. Puedes compartir ${command}.`
          : `Estado Telegram actualizado para ${patientName}.`,
        'agent'
      );
    } catch (err: any) {
      addMessage(`No se pudo preparar la invitacion Telegram: ${err?.message || 'error no identificado'}`, 'agent');
      btn.disabled = false;
      btn.innerHTML = previousLabel;
    }
  });
  historialContent?.addEventListener('submit', async (event: Event) => {
    const formEl = event.target as HTMLFormElement | null;
    if (!formEl) return;

    if (formEl.matches('form[data-role="recommendation-followup-form"]')) {
      event.preventDefault();
      if (!selectedPatientId) {
        addMessage('Selecciona un paciente antes de guardar seguimiento del plan.', 'agent');
        return;
      }

      const recommendationId = formEl.getAttribute('data-recommendation-id') || '';
      const noteInput = formEl.elements.namedItem('note_text') as HTMLTextAreaElement | null;
      const adherenceInput = formEl.elements.namedItem('adherence_status') as HTMLSelectElement | null;
      const painInput = formEl.elements.namedItem('pain_scale') as HTMLInputElement | null;
      const stateInput = formEl.elements.namedItem('recommendation_state') as HTMLSelectElement | null;
      const submitBtn = formEl.querySelector('button[type="submit"]') as HTMLButtonElement | null;

      const noteText = noteInput?.value.trim() || '';
      const adherenceStatus = adherenceInput?.value || '';
      const painValue = painInput?.value?.trim() || '';
      const recommendationState = stateInput?.value || '';

      if (!recommendationId || (!noteText && !adherenceStatus && !painValue && !recommendationState)) {
        setHistoryNoteFeedback(formEl, 'Anade al menos una observacion, adherencia, dolor o estado para guardar el follow-up.');
        noteInput?.focus();
        return;
      }

      const previousLabel = submitBtn?.innerHTML || '';
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<span class="material-symbols-rounded">sync</span> Guardando...';
      }
      setHistoryNoteFeedback(formEl, 'Guardando seguimiento del plan...', 'success');

      try {
        await fetchJson(`${BACKEND_BASE}/api/exercises/recommendations/${recommendationId}/follow-up`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            fisioterapeuta_id: PROF_ID,
            note_text: noteText || null,
            adherence_status: adherenceStatus || null,
            pain_scale: painValue === '' ? null : Number(painValue),
            recommendation_state: recommendationState || null,
          }),
        }, 15000);

        addMessage(`Follow-up del plan guardado para ${selectedPatientName || 'el paciente seleccionado'}.`, 'agent');
        pendingHistoryAnchor = 'recommendations';
        await loadHistorial();
      } catch (err: any) {
        setHistoryNoteFeedback(formEl, `No se pudo guardar el follow-up: ${err?.message || 'error no identificado'}`);
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.innerHTML = previousLabel;
        }
      }
      return;
    }

    if (!formEl.matches('form[data-role="history-note-form"]')) return;

    event.preventDefault();
    if (!selectedPatientId) {
      addMessage('Selecciona un paciente antes de guardar una nota de seguimiento.', 'agent');
      return;
    }

    const noteInput = formEl.elements.namedItem('texto_nota') as HTMLTextAreaElement | null;
    const sourceInput = formEl.elements.namedItem('fuente') as HTMLInputElement | null;
    const submitBtn = formEl.querySelector('button[type="submit"]') as HTMLButtonElement | null;
    const noteText = noteInput?.value.trim() || '';
    if (!noteText) {
      setHistoryNoteFeedback(formEl, 'Escribe una nota antes de guardarla.');
      noteInput?.focus();
      return;
    }

    const previousLabel = submitBtn?.innerHTML || '';
    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.innerHTML = '<span class="material-symbols-rounded">sync</span> Guardando...';
    }
    setHistoryNoteFeedback(formEl, 'Guardando nota de seguimiento...', 'success');

    try {
      await fetchJson(`${BACKEND_BASE}/api/profesional/notes`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          paciente_id: selectedPatientId,
          profesional_id: PROF_ID,
          texto_nota: noteText,
          fuente: sourceInput?.value || 'crm_web',
        }),
      }, 15000);

      addMessage(`Nota de seguimiento guardada para ${selectedPatientName || 'el paciente seleccionado'}.`, 'agent');
      await loadHistorial();
    } catch (err: any) {
      setHistoryNoteFeedback(formEl, `No se pudo guardar la nota: ${err?.message || 'error no identificado'}`);
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.innerHTML = previousLabel;
      }
      return;
    }
  });
  historialContent?.addEventListener('keydown', (event: KeyboardEvent) => {
    const target = event.target as HTMLTextAreaElement | null;
    if (!target || !['texto_nota', 'note_text'].includes(target.name)) return;
    if (event.ctrlKey && event.key === 'Enter') {
      event.preventDefault();
      target.form?.requestSubmit();
    }
  });


  // === CONFIG PAGE ===
  // ===================== PAGOS =====================
  const pagosBody = document.getElementById('pagosBody') as HTMLElement | null;
  const pagosAnioFilter = document.getElementById('pagosAnioFilter') as HTMLSelectElement | null;
  const pagosMesFilter = document.getElementById('pagosMesFilter') as HTMLSelectElement | null;
  const pagoModal = document.getElementById('pagoModal');
