    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: #8d7245;
  }
  .ficha-data-card-head strong {
    color: #17283b;
    font-size: 1rem;
    line-height: 1.3;
  }
  .ficha-data-card-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.85rem;
  }
  .ficha-dato {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .ficha-dato-label {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--text-muted);
    font-weight: 600;
  }
  .ficha-dato-value {
    font-size: 0.95rem;
    color: var(--text-primary);
    min-height: 1.4em;
  }
  .ficha-dato-value:empty::after { content: 'Sin dato'; color: var(--text-muted); }
  .ficha-dato-full { grid-column: 1 / -1; }

  .ficha-form-actions {
    grid-column: 1 / -1;
    display: flex;
    justify-content: flex-end;
    gap: 0.5rem;
    padding-top: 0.5rem;
  }

  /* Timeline notas */
  .ficha-timeline {
    padding: 0.5rem 1rem 1rem;
  }
  .ficha-nota-card {
    border-left: 3px solid var(--accent);
    padding: 0.95rem 1rem;
    margin-bottom: 1rem;
    background: linear-gradient(180deg, rgba(255, 255, 252, 0.98), rgba(248, 243, 235, 0.92));
    border-radius: 0 1rem 1rem 0;
    border: 1px solid rgba(208, 194, 170, 0.34);
    border-left-width: 3px;
    position: relative;
    box-shadow: 0 18px 28px -28px rgba(41, 33, 24, 0.14);
  }
  .ficha-nota-header {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    margin-bottom: 0.4rem;
    flex-wrap: wrap;
  }
  .ficha-nota-headline {
    display: grid;
    gap: 0.38rem;
  }
  .ficha-nota-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }
  .ficha-nota-date {
    font-weight: 700;
    font-size: 0.88rem;
    color: var(--text-primary);
  }
  .ficha-nota-zona {
    font-size: 0.75rem;
    background: var(--accent-soft);
    color: var(--accent);
    padding: 0.15rem 0.5rem;
    border-radius: 99px;
    font-weight: 600;
  }
  .ficha-nota-eva {
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.15rem 0.5rem;
    border-radius: 99px;
  }
  .eva-low { background: #dcfce7; color: #166534; }
  .eva-mid { background: #fef9c3; color: #854d0e; }
  .eva-high { background: #fee2e2; color: #991b1b; }
  .ficha-nota-text {
    font-size: 0.88rem;
    color: var(--text-secondary);
    white-space: pre-wrap;
    line-height: 1.5;
  }
  .ficha-nota-pruebas {
    margin-top: 0.7rem;
    padding-top: 0.7rem;
    border-top: 1px solid rgba(208, 194, 170, 0.3);
    font-size: 0.82rem;
    color: var(--text-muted);
  }
  .ficha-nota-pruebas strong {
    display: block;
    margin-bottom: 0.2rem;
    color: #7d6237;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .ficha-nota-pruebas p {
    margin: 0;
    line-height: 1.5;
  }
  .ficha-nota-actions {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    display: flex;
    gap: 0.3rem;
  }
  .ficha-nota-actions button {
    background: none;
    border: none;
    cursor: pointer;
    color: var(--text-muted);
    font-size: 1.1rem;
    padding: 0.2rem;
    border-radius: 4px;
  }
  .ficha-nota-actions button:hover { color: var(--accent); background: var(--accent-soft); }

  .ficha-list-summary {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    padding: 0 1rem 0.9rem;
  }
  .ficha-summary-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 2rem;
    padding: 0.32rem 0.7rem;
    border-radius: 999px;
    border: 1px solid rgba(208, 194, 170, 0.4);
    background: rgba(255, 249, 240, 0.9);
    color: #5f7284;
    font-size: 0.78rem;
    font-weight: 700;
  }
  .ficha-summary-chip strong {
    color: #17283b;
  }
  .ficha-table-primary {
    color: #17283b;
    font-weight: 700;
    line-height: 1.35;
  }
  .ficha-table-meta {
    margin-top: 0.18rem;
    color: #6a7b8c;
    font-size: 0.78rem;
    line-height: 1.45;
  }
  .ficha-pagos-total {
    padding: 0.8rem 1rem;
    font-weight: 700;
    font-size: 1rem;
    text-align: right;
    color: var(--text-primary);
  }

  .empty-inline {
    text-align: center;
    color: var(--text-muted);
    padding: 1.3rem 1.1rem;
    font-size: 0.9rem;
    border-radius: 0.95rem;
    border: 1px dashed rgba(148, 163, 184, 0.28);
    background: rgba(247, 251, 253, 0.72);
    line-height: 1.55;
  }

  /* === GESTORIA === */
  .gestoria-mobile-list {
    display: none;
    gap: 0.75rem;
    margin-bottom: 0.9rem;
  }
  .gestoria-mobile-item {
    display: grid;
    gap: 0.55rem;
    padding: 0.82rem 0.9rem;
    border-radius: 1rem;
    border: 1px solid rgba(199, 184, 155, 0.36);
    background: linear-gradient(180deg, rgba(255, 253, 248, 0.98), rgba(247, 240, 228, 0.94));
  }
  .gestoria-mobile-item header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .gestoria-mobile-item header strong {
    color: #183247;
    font-size: 0.9rem;
    line-height: 1.3;
  }
  .gestoria-mobile-item header span {
    color: #183247;
    font-size: 0.86rem;
    font-weight: 700;
  }
  .gestoria-mobile-metrics {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.55rem;
  }
  .gestoria-mobile-metrics span {
    display: grid;
    gap: 0.15rem;
  }
  .gestoria-mobile-metrics small {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #7b8a96;
    font-weight: 700;
  }
  .gestoria-mobile-metrics strong {
    color: #183247;
    font-size: 0.8rem;
  }
  .gestoria-table-wrap {
    overflow-x: auto;
  }
  .gestoria-table {
    min-width: 1000px;
  }
  .gestoria-col-patient {
    min-width: 150px;
    position: sticky;
    left: 0;
    background: var(--bg-card);
    z-index: 1;
  }
  .gestoria-patient-name {
    position: sticky;
    left: 0;
    background: var(--bg-card);
    z-index: 1;
    white-space: nowrap;
  }
  .gestoria-col-mes { min-width: 65px; font-size: 0.82rem; }
  .gestoria-col-total, .gestoria-col-efe, .gestoria-col-tar { min-width: 80px; }
  .gestoria-cell-empty { color: #cbd5e1; }
  .gestoria-cell-filled { cursor: default; }
  .gestoria-efe { color: #166534; }
  .gestoria-tar { color: #1e40af; }
  .gestoria-totals-row {
    background: #f8fafc;
    border-top: 2px solid var(--border);
  }
  .gestoria-totals-row td { padding-top: 0.75rem; }
  .gestoria-mes-select {
    padding: 0.4rem 0.5rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    font-size: 0.85rem;
    background: var(--bg-surface);
  }
  .gestoria-mes-totals {
    display: flex;
    gap: 1rem;
    padding: 0.7rem 1.25rem;
    flex-wrap: wrap;
    border-bottom: 1px solid var(--border);
    background: #f8fafc;
  }
  .gestoria-mes-chip {
    font-size: 0.85rem;
    color: var(--text-muted);
  }
  .gestoria-mes-chip strong { color: var(--text-primary); }
  .gestoria-mes-cash strong { color: #166534; }
  .gestoria-mes-card strong { color: #1e40af; }

  @media (max-width: 768px) {
    .page-section[data-page='gestoria'] .gestoria-mobile-list {
      display: grid;
    }
    .page-section[data-page='gestoria'] .gestoria-table-wrap {
      display: none;
    }
  }

  /* === CONFIG GRID === */
  .config-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
    gap: 1.5rem;
  }
  
  .config-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 0;
    border-bottom: 1px solid var(--border);
  }
  .config-item:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }
  
  .config-label {
    font-size: 0.9rem;
    color: var(--text-muted);
    font-weight: 500;
  }
  
  .config-value {
    font-size: 0.9rem;
    color: var(--text-primary);
    font-family: monospace;
    background: var(--bg-elevated);
    padding: 0.2rem 0.5rem;
    border-radius: var(--radius-sm);
  }
  
  .config-link {
    color: var(--accent);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
  }
  .config-link:hover {
    text-decoration: underline;
  }
  .config-readiness-detail {
    margin-top: 0.2rem;
  }

  .booking-link-card {
    display: grid;
    gap: 0.95rem;
  }
  .booking-link-hint {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.88rem;
    line-height: 1.55;
  }
  .booking-link-stack {
    display: grid;
    gap: 0.48rem;
  }
  .booking-link-input {
    width: 100%;
    min-height: 3rem;
    padding: 0.82rem 0.95rem;
    border: 1px solid var(--border);
    border-radius: 0.95rem;
    background: linear-gradient(180deg, #f9fcfd 0%, #f2f8fa 100%);
    color: var(--text-primary);
    font: inherit;
    font-size: 0.92rem;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.7);
  }
  .booking-link-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .btn-primary {
    background: linear-gradient(135deg, #0d9488 0%, #0ea5e9 100%);
    color: #fff;
    border: none;
    border-radius: var(--radius-md);
    padding: 0.62rem 1rem;
    font: inherit;
    font-size: clamp(0.8rem, 0.85vw, 0.88rem);
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    box-shadow: 0 4px 12px -2px rgba(13, 148, 136, 0.35);
    cursor: pointer;
    transition: transform var(--transition), box-shadow var(--transition);
    white-space: nowrap;
    letter-spacing: 0.01em;
  }
  .btn-primary:hover {
    transform: translateY(-1px);
    box-shadow: 0 6px 18px -2px rgba(13, 148, 136, 0.45);
  }
  .btn-primary:active {
    transform: translateY(0);
    box-shadow: 0 2px 8px -2px rgba(13, 148, 136, 0.30);
  }

  .toast-region {
    position: fixed;
    right: clamp(0.8rem, 2vw, 1.4rem);
    bottom: calc(1rem + env(safe-area-inset-bottom, 0px));
    z-index: 260;
    display: grid;
    gap: 0.65rem;
    width: min(24rem, calc(100vw - 1.6rem));
    pointer-events: none;
  }

  .toast-card {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: start;
    gap: 0.72rem;
    padding: 0.82rem 0.88rem;
    border: 1px solid rgba(203, 213, 225, 0.82);
    border-radius: 0.95rem;
    background: #ffffff;
    box-shadow: 0 24px 58px -36px rgba(15, 23, 42, 0.46);
    pointer-events: auto;
    animation: toastIn 0.18s ease-out;
  }

  .toast-card.is-leaving {
    animation: toastOut 0.18s ease-in forwards;
  }

  .toast-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 0.75rem;
    color: #0f4c81;
    background: #eaf4fb;
  }

  .toast-success .toast-icon {
    color: #047857;
    background: #ecfdf5;
  }

  .toast-warning .toast-icon {
    color: #a16207;
    background: #fffbeb;
  }

  .toast-error .toast-icon {
    color: #b91c1c;
    background: #fef2f2;
  }

  .toast-copy {
    min-width: 0;
    display: grid;
    gap: 0.12rem;
  }

  .toast-copy strong {
    color: var(--text-primary);
    font-size: 0.86rem;
    line-height: 1.25;
  }

  .toast-copy p {
    margin: 0;
    color: var(--text-secondary);
    font-size: 0.84rem;
    line-height: 1.42;
  }

  .toast-close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.8rem;
    height: 1.8rem;
    border: 0;
    border-radius: 999px;
    color: #64748b;
    background: transparent;
    cursor: pointer;
  }

  .confirm-shell {
    position: fixed;
    inset: 0;
    z-index: 270;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 1rem;
  }

  .confirm-shell.open {
    display: flex;
  }

  .confirm-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(15, 23, 42, 0.42);
    backdrop-filter: blur(5px);
  }

  .confirm-panel {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.95rem;
    width: min(31rem, 100%);
    padding: 1rem;
    border: 1px solid rgba(203, 213, 225, 0.9);
    border-radius: 1.15rem;
    background: #ffffff;
    box-shadow: 0 34px 90px -42px rgba(15, 23, 42, 0.58);
  }

  .confirm-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 0.9rem;
    color: #0f4c81;
    background: #eaf4fb;
  }

  .confirm-copy {
    min-width: 0;
    display: grid;
    gap: 0.5rem;
  }

  .confirm-copy h2 {
    margin: 0;
    color: var(--text-primary);
    font-size: 1rem;
    letter-spacing: 0;
  }

  .confirm-copy p {
    margin: 0;
    color: var(--text-secondary);
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .confirm-input-field {
    display: grid;
    gap: 0.35rem;
  }

  .confirm-input-field span {
    color: var(--text-muted);
    font-size: 0.78rem;
    font-weight: 800;
  }

  .confirm-input-field input {
    width: 100%;
    min-height: 2.7rem;
    padding: 0.72rem 0.82rem;
    border: 1px solid var(--border);
    border-radius: 0.82rem;
    color: var(--text-primary);
    background: #fbfdff;
    font: inherit;
  }

  .confirm-actions {
    grid-column: 1 / -1;
    display: flex;
    justify-content: flex-end;
    gap: 0.55rem;
  }

  .confirm-actions .btn-primary[data-tone='error'] {
    border-color: #b91c1c;
    background: #b91c1c;
  }

  @keyframes toastIn {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes toastOut {
    from { opacity: 1; transform: translateY(0); }
    to { opacity: 0; transform: translateY(8px); }
  }

  @media (max-width: 720px) {
    .toast-region {
      right: 0.75rem;
      bottom: calc(5.9rem + env(safe-area-inset-bottom, 0px));
      width: calc(100vw - 1.5rem);
    }

    .confirm-panel {
      grid-template-columns: minmax(0, 1fr);
    }

    .confirm-actions {
      display: grid;
      grid-template-columns: 1fr;
    }
  }

  .detail-block {
    padding: 1rem 1.1rem;
    border-bottom: 1px solid var(--border);
  }
  .detail-block:last-child {
    border-bottom: none;
  }
  .detail-block-spotlight {
    background: linear-gradient(180deg, rgba(240, 253, 250, 0.96), rgba(248, 250, 252, 0.98));
    box-shadow: inset 0 0 0 1px rgba(20, 184, 166, 0.18), 0 0 0 4px rgba(20, 184, 166, 0.08);
    transition: box-shadow 0.2s ease, background 0.2s ease;
  }
  .detail-block h3 {
    font-size: 0.95rem;
    margin-bottom: 0.4rem;
  }
  .detail-block p {
    margin: 0;
    color: var(--text-secondary);
    font-size: 0.88rem;
  }
  .history-case-hero {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    background: linear-gradient(180deg, rgba(248, 252, 253, 0.98), rgba(242, 247, 248, 0.96));
  }
  .detail-kicker {
    display: block;
    margin-bottom: 0.26rem;
    color: var(--accent);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .history-case-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.5rem;
  }
  .history-case-actions .btn-secondary,
  .history-case-actions .btn-ghost {
    min-height: 2.35rem;
  }
  .detail-caption {
    margin-top: 0.35rem;
    color: var(--text-muted);
    font-size: 0.84rem;
    line-height: 1.45;
  }
  .telegram-link-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.85rem;
  }
  .telegram-link-card {
    display: grid;
    gap: 0.75rem;
    padding: 0.9rem 1rem;
    border-radius: var(--radius-md);
    border: 1px solid rgba(14, 165, 233, 0.16);
    background: linear-gradient(180deg, rgba(240, 249, 255, 0.92), rgba(248, 250, 252, 0.98));
  }
  .telegram-link-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 0.55rem 1rem;
  }
  .telegram-link-grid p {
    margin: 0;
    font-size: 0.84rem;
    color: var(--text-secondary);
  }
  .telegram-link-command {
    padding: 0.75rem 0.85rem;
    border-radius: 0.85rem;
    background: rgba(15, 23, 42, 0.92);
    overflow-x: auto;
  }
  .telegram-link-command code {
    color: #e2e8f0;
    font-size: 0.84rem;
    white-space: nowrap;
  }
  .telegram-link-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
  }
  .telegram-link-error {
    color: #991b1b;
  }
  .history-note-form {
    margin-top: 0.85rem;
    display: grid;
    gap: 0.8rem;
  }
  .history-note-field {
    display: grid;
    gap: 0.42rem;
  }
  .history-note-field span {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--text-secondary);
  }
  .history-note-field textarea {
    width: 100%;
    min-height: 120px;
    resize: vertical;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: #fff;
    color: var(--text-primary);
    font: inherit;
    padding: 0.85rem 0.95rem;
    transition: border-color var(--transition), box-shadow var(--transition);
  }
  .history-note-field textarea:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 4px var(--accent-soft);
  }
  .history-note-feedback,
  .recommendation-followup-feedback {
    margin: 0;
    padding: 0.8rem 0.9rem;
    border-radius: 0.95rem;
    border: 1px solid rgba(59, 130, 246, 0.18);
    background: rgba(59, 130, 246, 0.08);
    color: var(--text-secondary);
    font-size: 0.84rem;
  }
  .history-note-feedback[data-state="error"],
  .recommendation-followup-feedback[data-state="error"] {
    border-color: rgba(239, 68, 68, 0.22);
    background: rgba(239, 68, 68, 0.08);
    color: #991b1b;
  }
  .history-note-feedback[data-state="success"],
  .recommendation-followup-feedback[data-state="success"] {
    border-color: rgba(16, 185, 129, 0.24);
    background: rgba(16, 185, 129, 0.1);
    color: #065f46;
  }
  .history-note-actions,
  .recommendation-followup-actions {
    display: flex;
    justify-content: flex-end;
  }
  .btn-history-note {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }
  .recommendation-section-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.7rem;
    flex-wrap: wrap;
    margin-bottom: 0.45rem;
  }
  .recommendation-section-head p {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.8rem;
    line-height: 1.45;
  }
  .recommendation-followup-shell {
    display: grid;
    gap: 0.8rem;
    padding: 0.9rem;
    border-radius: 1rem;
    border: 1px solid rgba(208, 194, 170, 0.36);
    background: linear-gradient(180deg, rgba(255, 252, 246, 0.98), rgba(248, 242, 232, 0.9));
