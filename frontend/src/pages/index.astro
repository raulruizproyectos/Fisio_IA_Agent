  }
  .recommendation-summary-card {
    display: grid;
    gap: 0.28rem;
    padding: 0.9rem 0.95rem;
    border: 1px solid rgba(208, 194, 170, 0.38);
    border-radius: 1rem;
    background: linear-gradient(180deg, rgba(255,255,255,0.96), rgba(248, 242, 232, 0.92));
    box-shadow: 0 14px 28px -26px rgba(43, 34, 25, 0.16);
  }
  .recommendation-summary-card span,
  .recommendation-meta-item span,
  .recommendation-timeline-copy span {
    color: var(--text-muted);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.02em;
  }
  .recommendation-summary-card strong {
    color: var(--text-primary);
    font-size: 1.35rem;
    line-height: 1;
  }
  .recommendation-summary-card p {
    margin: 0;
    color: var(--text-secondary);
    font-size: 0.8rem;
    line-height: 1.45;
  }
  .recommendation-card {
    gap: 0.8rem;
    padding: 0.95rem;
    border-color: rgba(208, 194, 170, 0.42);
    border-radius: 1rem;
    background: linear-gradient(180deg, rgba(255,255,255,0.98), rgba(248, 242, 232, 0.94));
  }
  .recommendation-meta-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.6rem;
  }
  .recommendation-meta-item {
    display: grid;
    gap: 0.18rem;
    padding: 0.72rem 0.78rem;
    border-radius: 0.9rem;
    border: 1px solid rgba(207, 220, 228, 0.9);
    background: rgba(255, 255, 255, 0.82);
  }
  .recommendation-meta-item strong,
  .recommendation-timeline-copy strong {
    color: var(--text-primary);
    font-size: 0.88rem;
    line-height: 1.35;
  }
  .recommendation-timeline {
    display: grid;
    gap: 0.65rem;
  }
  .recommendation-timeline-item {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.7rem;
    align-items: flex-start;
    padding: 0.72rem 0.78rem;
    border-radius: 0.95rem;
    border: 1px solid rgba(215, 226, 232, 0.92);
    background: rgba(255, 255, 255, 0.76);
  }
  .recommendation-timeline-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 0.78rem;
  }
  .recommendation-timeline-icon .material-symbols-rounded {
    font-size: 1rem;
  }
  .recommendation-timeline-icon-plan {
    background: rgba(69, 107, 153, 0.12);
    color: #456b99;
  }
  .recommendation-timeline-icon-delivery {
    background: rgba(23, 107, 99, 0.12);
    color: #176b63;
  }
  .recommendation-timeline-icon-followup {
    background: rgba(166, 124, 57, 0.14);
    color: #8a6731;
  }
  .recommendation-timeline-copy {
    display: grid;
    gap: 0.15rem;
  }
  .recommendation-timeline-copy p {
    margin: 0;
    color: var(--text-secondary);
    font-size: 0.82rem;
    line-height: 1.5;
  }
  @media (max-width: 960px) {
    .recommendation-summary-grid,
    .recommendation-meta-grid,
    .recommendation-followup-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 640px) {
    .recommendation-summary-grid,
    .recommendation-meta-grid,
    .recommendation-followup-grid {
      grid-template-columns: 1fr;
    }
  }

  :global(body.has-modal-open) {
    overflow: hidden;
  }
  .modal-shell {
    position: fixed;
    inset: 0;
    z-index: 140;
    display: none;
    align-items: center;
    justify-content: center;
    padding: clamp(0.75rem, 3vw, 1.5rem);
    background: rgba(8, 15, 35, 0.48);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }
  .modal-shell.open {
    display: flex;
  }
  .modal-panel {
    width: min(100%, 580px);
    background: var(--bg-card);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-xl);
    overflow: hidden;
    max-height: calc(100vh - 3rem);
    overflow-y: auto;
  }
  .modal-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.25rem 1.5rem 1rem;
    border-bottom: 1px solid var(--border-light);
    background: linear-gradient(135deg, rgba(13, 148, 136, 0.06), rgba(14, 165, 233, 0.04));
    position: sticky;
    top: 0;
    z-index: 1;
  }
  .modal-title-group {
    display: grid;
    gap: 0.3rem;
  }
  .modal-title-group h2 {
    margin: 0;
    font-size: 1.2rem;
    color: var(--text-primary);
  }
  .modal-title-group p {
    margin: 0;
    color: var(--text-secondary);
    font-size: 0.9rem;
    line-height: 1.45;
  }
  .modal-eyebrow {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .modal-close {
    border: 1px solid var(--border);
    background: rgba(255, 255, 255, 0.8);
    color: var(--text-secondary);
    width: 40px;
    height: 40px;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: transform var(--transition), border-color var(--transition), color var(--transition);
  }
  .modal-close:hover {
    transform: translateY(-1px);
    color: var(--accent);
    border-color: var(--accent);
  }
  .patient-form {
    display: grid;
    gap: 1rem;
    padding: 1.25rem 1.5rem 1.4rem;
  }
  .form-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.9rem;
  }
  .field {
    display: grid;
    gap: 0.4rem;
  }
  .field-full {
    grid-column: 1 / -1;
  }
  .field span {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-secondary);
    letter-spacing: 0.01em;
  }
  .field input {
    width: 100%;
    border: 1.5px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--bg-surface);
    color: var(--text-primary);
    min-height: 44px;
    padding: 0.7rem 0.9rem;
    font: inherit;
    font-size: 0.9rem;
    transition: border-color var(--transition), box-shadow var(--transition), background var(--transition);
  }
  .field input:focus {
    outline: none;
    border-color: var(--accent);
    background: #fff;
    box-shadow: 0 0 0 3px var(--accent-soft);
  }
  .field input:hover:not(:focus) {
    border-color: var(--border-strong);
  }
  /* === AGENDA SEMANAL === */
  .week-nav-bar {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    flex-shrink: 0;
    flex-wrap: nowrap;
  }
  .week-label {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-primary);
    min-width: 160px;
    text-align: center;
  }
  .agenda-calendar-meta {
    margin: 0.25rem 0 0.75rem;
    padding: 0.45rem 0.7rem;
    border-radius: 0.6rem;
    border: 1px dashed var(--border);
    background: #f8fafc;
    color: var(--text-secondary);
    font-size: 0.78rem;
    line-height: 1.45;
  }
  .agenda-cal-card { padding: 0; overflow: hidden; }
  .agenda-calendar { width: 100%; overflow-x: auto; }
  .agenda-cal-loading {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 2rem;
    color: var(--text-secondary);
    font-size: 0.9rem;
  }
  .agenda-cal-grid {
    display: grid;
    grid-template-columns: 52px repeat(5, 1fr);
    border-top: 1px solid var(--border);
    border-left: 1px solid var(--border);
    min-width: 560px;
  }
  .agenda-cal-grid > * {
    border-right: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }
  .agenda-cal-time-header { background: var(--bg-surface); }
  .agenda-cal-day-header {
    background: var(--bg-surface);
    padding: 0.6rem 0.4rem;
    text-align: center;
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--text-secondary);
    text-transform: capitalize;
  }
  .agenda-cal-day-header.today {
    background: var(--accent-soft);
    color: var(--accent);
  }
  .agenda-cal-time {
    background: var(--bg-surface);
    padding: 0.4rem 0.35rem;
    text-align: right;
    font-size: 0.72rem;
    color: var(--text-secondary);
    font-weight: 500;
    display: flex;
    align-items: flex-start;
    justify-content: flex-end;
    padding-top: 0.5rem;
  }
  .agenda-cal-cell {
    background: #fff;
    min-height: 56px;
    padding: 2px;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .agenda-cal-cell.closed {
    background: repeating-linear-gradient(135deg, transparent, transparent 5px, #f8fafc 5px, #f8fafc 10px);
  }
  .agenda-appt {
    border-radius: 4px;
    padding: 2px 5px 3px;
    font-size: 0.7rem;
    line-height: 1.3;
    overflow: hidden;
    cursor: default;
    border-left: 3px solid;
  }
  .agenda-appt .appt-time { display: block; font-weight: 700; font-size: 0.65rem; opacity: 0.8; }
  .agenda-appt .appt-name { display: block; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .agenda-appt .appt-motivo { display: block; opacity: 0.75; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-size: 0.65rem; }
  .agenda-appt.confirmada { background: #d1fae5; color: #065f46; border-color: #10b981; }
  .agenda-appt.pendiente  { background: #fef3c7; color: #92400e; border-color: #f59e0b; }
  .agenda-appt.cancelada  { background: #f1f5f9; color: #94a3b8; border-color: #cbd5e1; text-decoration: line-through; }
  .agenda-appt.completada { background: #ede9fe; color: #4c1d95; border-color: #7c3aed; }
  .agenda-appt.no_show    { background: #fff1f2; color: #be123c; border-color: #f43f5e; }
  .badge-week-count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--accent);
    color: #fff;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 700;
    min-width: 20px;
    height: 20px;
    padding: 0 6px;
    margin-left: 6px;
  }
  .badge-week-count:empty { display: none; }
  .field select,
  .field textarea {
    width: 100%;
    border: 1.5px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--bg-surface);
    color: var(--text-primary);
    min-height: 44px;
    padding: 0.7rem 0.9rem;
    font: inherit;
    font-size: 0.9rem;
    transition: border-color var(--transition), box-shadow var(--transition), background var(--transition);
  }
  .field textarea {
    min-height: 100px;
    resize: vertical;
  }
  .field select:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--accent);
    background: #fff;
    box-shadow: 0 0 0 3px var(--accent-soft);
  }
  .field select:hover:not(:focus),
  .field textarea:hover:not(:focus) {
    border-color: var(--border-strong);
  }
  .form-actions-row {
    display: flex;
    justify-content: flex-end;
    gap: 0.75rem;
  }

  .form-feedback {
    margin: 0;
    padding: 0.85rem 0.95rem;
    border-radius: 1rem;
    border: 1px solid rgba(59, 130, 246, 0.18);
    background: rgba(59, 130, 246, 0.08);
    color: var(--text-secondary);
    font-size: 0.88rem;
  }
  .form-feedback[data-state="error"] {
    border-color: rgba(239, 68, 68, 0.22);
    background: rgba(239, 68, 68, 0.08);
    color: #991b1b;
  }
  .form-feedback[data-state="success"] {
    border-color: rgba(16, 185, 129, 0.24);
    background: rgba(16, 185, 129, 0.1);
    color: #065f46;
  }
  .modal-actions {
    display: flex;
    justify-content: flex-end;
    gap: 0.75rem;
  }

  /* === SIDEBAR BACKDROP (mobile overlay) === */
  .sidebar-backdrop {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.45);
    z-index: 99;
    opacity: 0;
    transition: opacity var(--transition);
  }
  .sidebar-backdrop.visible {
    display: block;
    opacity: 1;
  }

  /* === SECTION BODY === */
  .section-body {
    padding: 1rem 1.15rem;
  }
  .btn-sm.btn-outline {
    background: transparent;
    color: var(--accent);
    border: 1px solid var(--accent);
  }
  .btn-sm.btn-outline:hover {
    background: var(--accent-soft);
  }

  /* === RESPONSIVE: 4K / ULTRAWIDE (>= 2000px) === */
  @media (min-width: 2000px) {
    :root {
      --sidebar-width: 280px;
      --topbar-height: 72px;
    }
    .content { padding: 2rem 2.5rem; }
    .dashboard-layout { max-width: 1800px; }
  }

  /* === RESPONSIVE: WIDE DESKTOP (<= 1600px) === */
  @media (max-width: 1600px) {
    .dashboard-layout { max-width: none; }
  }

  /* === RESPONSIVE: STANDARD DESKTOP (<= 1440px) === */
  @media (max-width: 1440px) {
    .workspace-shell {
      grid-template-columns: minmax(0, 1fr) clamp(280px, 25vw, 370px);
    }
    .dashboard-bottom-row {
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    }
  }

  /* === RESPONSIVE: SMALL DESKTOP (<= 1360px) === */
  @media (max-width: 1360px) {
    .workspace-shell {
      grid-template-columns: minmax(0, 1fr) clamp(260px, 24vw, 350px);
    }
    .assistant-rail {
      padding-right: 0.75rem;
    }
  }

  /* === RESPONSIVE: SMALL DESKTOP (<= 1280px) === */
  @media (max-width: 1280px) {
    .workspace-shell {
      grid-template-columns: minmax(0, 1fr) clamp(250px, 23vw, 320px);
    }
    .metrics-row {
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    }
  }

  @media (max-width: 1100px) {
    .workspace-shell {
      grid-template-columns: minmax(0, 1fr);
    }
    .assistant-launch-btn {
      display: inline-flex;
    }
    .assistant-rail {
      position: fixed;
      top: var(--topbar-height);
      right: 0;
      bottom: 0;
      z-index: 80;
      width: min(440px, 92vw);
      height: auto;
      padding: 1rem 0.85rem 1rem 1rem;
      border-left: none;
      background: transparent;
      transform: translateX(100%);
      transition: transform 0.24s ease;
      pointer-events: none;
    }
    .assistant-rail.open {
      transform: translateX(0);
      pointer-events: auto;
    }
    .assistant-rail-close {
      display: inline-flex;
    }
    .assistant-rail-backdrop {
      position: fixed;
      inset: var(--topbar-height) 0 0 0;
      background: rgba(2, 6, 23, 0.58);
      backdrop-filter: blur(6px);
      opacity: 0;
      pointer-events: none;
      transition: opacity var(--transition);
      z-index: 70;
    }
    .assistant-rail-backdrop.visible {
      opacity: 1;
      pointer-events: auto;
    }
  }

  /* === RESPONSIVE: TABLET (<= 1100px) === */
  @media (max-width: 1100px) {
    .table-wrap { overflow-x: auto; -webkit-overflow-scrolling: touch; }
    table { min-width: 560px; }
    .hero-section {
      flex-direction: column;
      align-items: flex-start;
    }
    .metrics-row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.9rem;
    }
    .dashboard-bottom-row {
      grid-template-columns: 1fr;
    }
    .module-header {
      padding: 1rem 1.1rem;
      flex-wrap: wrap;
      gap: 0.65rem;
    }
    .assistant-context-strip,
    .assistant-shortcuts,
    .chat-log,
    .ai-input-area {
      padding-left: 1rem;
      padding-right: 1rem;
    }
    .ai-input-area {
      padding-top: 0.95rem;
      padding-bottom: 1rem;
    }
    .assistant-submit-hint {
      max-width: none;
    }
    .action-buttons {
      width: 100%;
      flex-wrap: wrap;
    }
    .btn-action {
      flex: 1 1 180px;
      justify-content: center;
    }
    .config-grid {
      grid-template-columns: 1fr;
    }
  }

  /* === RESPONSIVE: TABLET/MOBILE (<= 768px) === */
  @media (max-width: 768px) {
    :root {
      --topbar-height: 56px;
      --sidebar-width: 260px;
      --sidebar-collapsed: 260px;
    }
    .sidebar {
      position: fixed;
      top: 0;
      bottom: 0;
      left: 0;
      z-index: 100;
      transform: translateX(-100%);
      transition: transform var(--transition-slow);
      box-shadow: none;
    }
    .sidebar.open {
      transform: translateX(0);
      box-shadow: var(--shadow-xl);
    }
    .sidebar.collapsed {
      transform: translateX(-100%);
    }
    .sidebar.collapsed.open {
      transform: translateX(0);
    }
    .sidebar.collapsed .nav-label,
    .sidebar.collapsed .brand-text,
    .sidebar.collapsed .badge {
