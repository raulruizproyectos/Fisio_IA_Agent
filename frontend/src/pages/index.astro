  .assistant-brief-item {
    display: grid;
    gap: 0.24rem;
    padding: 0.72rem 0.78rem;
    border: 1px solid #d9e6ed;
    border-radius: 0.95rem;
    background: rgba(255, 255, 255, 0.92);
  }

  .assistant-brief-item span {
    color: #6d8297;
    font-size: 0.72rem;
    font-weight: 700;
  }

  .assistant-brief-item strong {
    color: #10233d;
    font-size: 0.84rem;
    line-height: 1.4;
  }

  .assistant-brief-item small {
    color: #6b7f92;
    font-size: 0.74rem;
    line-height: 1.4;
  }

  .assistant-brief-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }


  .assistant-mode-switch {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .assistant-mode-chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.38rem;
    min-height: 2.2rem;
    padding: 0.52rem 0.78rem;
    border-radius: 999px;
    border: 1px solid #cde0ea;
    background: rgba(255, 255, 255, 0.88);
    color: #13405e;
    font-size: 0.78rem;
    font-weight: 800;
    transition: transform 160ms ease-out, border-color 160ms ease-out, background-color 160ms ease-out, color 160ms ease-out, box-shadow 160ms ease-out;
  }

  .assistant-mode-chip:hover {
    border-color: #a8c9d8;
    background: #ffffff;
  }

  .assistant-mode-chip.is-active {
    background: linear-gradient(135deg, #0d9488, #0f766e);
    border-color: #0f766e;
    color: #ffffff;
    box-shadow: 0 16px 32px -26px rgba(15, 118, 110, 0.55);
  }

  .assistant-mode-chip.is-active .material-symbols-rounded {
    color: inherit;
  }

  .assistant-mode-card {
    display: grid;
    gap: 0.72rem;
    padding: 0.92rem 1rem;
    border-radius: 1.1rem;
    border: 1px solid #cfe4ec;
    background: linear-gradient(180deg, rgba(244, 251, 251, 0.98), rgba(236, 247, 250, 0.94));
  }

  .assistant-mode-card.is-ready {
    border-color: #9edacb;
    box-shadow: 0 18px 34px -30px rgba(13, 148, 136, 0.42);
  }

