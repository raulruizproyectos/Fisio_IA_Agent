      { label: 'Tipo de caso', value: String(assistantInjuryTypeInput?.value || '').trim() },
      { label: 'Duracion', value: String(assistantDurationInput?.value || '').trim() },
      { label: 'Dolor actual', value: String(assistantPainLevelInput?.value || '').trim() },
      { label: 'Objetivo clinico', value: String(assistantObjectiveInput?.value || '').trim() },
    ];
    return entries.filter((entry) => entry.value);
  };

  const hasAssistantDiagnosticData = () => getAssistantDiagnosticEntries().length > 0;

  const getAssistantDiagnosticSummaryText = (maxLength = 150) => {
    const summary = getAssistantDiagnosticEntries()
      .map((entry) => `${entry.label.toLowerCase()}: ${entry.value}`)
      .join(' | ');
    return trimAgentBriefText(summary, maxLength);
  };

  const buildAssistantDiagnosticPrompt = () => {
    const entries = getAssistantDiagnosticEntries();
    if (!entries.length) return '';
    return entries.map((entry) => `${entry.label}: ${entry.value}`).join('\n');
  };

  const renderAssistantDiagnosticSummary = () => {
    if (!assistantDiagnosticSummary) return;
    const summary = getAssistantDiagnosticSummaryText(220);
    assistantDiagnosticSummary.textContent = summary
      ? `Ficha lista para IA: ${summary}`
      : 'Sin ficha estructurada todavia. Completa 2 o 3 campos y el agente trabajara con una entrada mas clinica.';
    syncAssistantDiagnosticPanel();
  };

  const syncAssistantDiagnosticPanel = () => {
    if (!assistantDiagnosticCard || !assistantDiagnosticToggle) return;
    const hasData = hasAssistantDiagnosticData();
    const isExpanded = assistantDiagnosticExpanded;

    assistantDiagnosticCard.classList.toggle('is-expanded', isExpanded);
    assistantDiagnosticCard.classList.toggle('is-collapsed', !isExpanded);
    assistantDiagnosticCard.classList.toggle('is-has-data', hasData);
    assistantDiagnosticToggle.setAttribute('aria-expanded', isExpanded ? 'true' : 'false');
    assistantDiagnosticToggle.textContent = isExpanded
      ? 'Ocultar contexto'
      : hasData
        ? 'Editar contexto'
        : 'Anadir contexto';
    queueAssistantLayoutEnforce();
  };

  const syncAssistantActionGrid = () => {
    if (!assistantActionGrid) return;
    const hasReport = Boolean(lastExerciseReportPayload);
    assistantActionGrid.classList.toggle('has-report', hasReport);
    assistantActionGrid.removeAttribute('style');
  };

  const buildAssistantPatientBrief = (patient: any, notes: any[] = [], recommendations: any[] = []) => {
    const latestNote = Array.isArray(notes) && notes.length ? notes[0] : null;
    const latestRecommendation = Array.isArray(recommendations) && recommendations.length ? recommendations[0] : null;
    const latestFollowUp = Array.isArray(latestRecommendation?.follow_ups) && latestRecommendation.follow_ups.length
      ? latestRecommendation.follow_ups[0]
      : null;
    const reportSnapshot = latestRecommendation?.report_snapshot || {};
    const reportExercises = Array.isArray(reportSnapshot?.exercises) ? reportSnapshot.exercises : [];
    const itemExercises = Array.isArray(latestRecommendation?.crm_recomendacion_items)
      ? latestRecommendation.crm_recomendacion_items
      : [];

    return {
      patientId: selectedPatientId,
      patientName: patient?.nombre_completo || selectedPatientName || 'Paciente seleccionado',
      patientEmail: patient?.email || null,
      notesCount: Array.isArray(notes) ? notes.length : 0,
      latestNoteText: trimAgentBriefText(latestNote?.texto_nota || ''),
      latestNoteDate: latestNote?.creado_en || latestNote?.created_at || null,
      recommendationsCount: Array.isArray(recommendations) ? recommendations.length : 0,
      latestRecommendationId: latestRecommendation?.id || null,
      latestRecommendationDate: latestRecommendation?.created_at || null,
      latestRecommendationState: String(latestRecommendation?.estado || 'sin_plan'),
      latestPainScale: latestFollowUp?.pain_scale ?? null,
      exerciseCount: reportExercises.length || itemExercises.length || 0,
      therapistNote: trimAgentBriefText(reportSnapshot?.message_to_therapist || latestRecommendation?.message_to_therapist_es || ''),
      patientMessage: trimAgentBriefText(reportSnapshot?.message_to_patient || latestRecommendation?.message_to_patient_es || '', 110),
      redFlagsPresent: Boolean(latestRecommendation?.red_flags_present || reportSnapshot?.red_flags?.present),
    };
  };

  const buildAssistantBriefPrompt = (action: 'update-plan' | 'next-session') => {
    if (!currentAssistantPatientBrief) return '';
    const brief = currentAssistantPatientBrief;
    const contextLines = [
      `Paciente: ${brief.patientName}`,
      brief.patientEmail ? `Email: ${brief.patientEmail}` : '',
      brief.latestPainScale !== null && brief.latestPainScale !== undefined
        ? `Ultimo dolor registrado: ${brief.latestPainScale}/10`
        : 'Ultimo dolor registrado: no disponible',
      brief.latestNoteText ? `Ultima nota de seguimiento: ${brief.latestNoteText}` : 'Ultima nota de seguimiento: no disponible',
      brief.therapistNote ? `Nota clinica del ultimo plan: ${brief.therapistNote}` : '',
      brief.patientMessage ? `Mensaje previo al paciente: ${brief.patientMessage}` : '',
      brief.exerciseCount ? `Ejercicios del ultimo plan: ${brief.exerciseCount}` : '',
      brief.latestRecommendationState ? `Estado del ultimo plan: ${brief.latestRecommendationState}` : '',
      brief.redFlagsPresent ? 'Hay alertas rojas previas a tener en cuenta.' : '',
    ].filter(Boolean);

    const task = action === 'next-session'
      ? 'Con este contexto, resume el objetivo de la siguiente sesion, que revisar en consulta y que progresion o regresion valorar.'
      : 'Con este contexto, actualiza el plan de ejercicios domiciliarios con progresion segura, objetivo clinico, red flags y criterio de seguimiento.';

    return contextLines.join('\n') + '\n\n' + task;
  };

  const getActiveAssistantModeConfig = () => assistantModeConfig[activeAssistantMode];

  const renderAssistantPrimaryButton = () => {
    if (!exerciseBtn) return;
    const modeConfig = getActiveAssistantModeConfig();
    exerciseBtn.innerHTML = `<span class="material-symbols-rounded">${modeConfig.primaryIcon}</span> ${modeConfig.primaryLabel}`;
    exerciseBtn.setAttribute('data-mode', activeAssistantMode);
    exerciseBtn.setAttribute('aria-label', modeConfig.primaryLabel);
  };

  const renderAssistantModeSwitch = () => {
    if (!assistantModeSwitch) return;
    assistantModeSwitch.querySelectorAll('[data-assistant-mode]').forEach((button) => {
      const mode = String(button.getAttribute('data-assistant-mode') || '') as AssistantWorkMode;
      const active = mode === activeAssistantMode;
      button.classList.toggle('is-active', active);
      button.setAttribute('aria-pressed', active ? 'true' : 'false');
    });
  };

  const appendAssistantInstruction = (basePrompt: string, extraText: string, label: string) => {
    const trimmedExtra = extraText.trim();
    if (!trimmedExtra) return basePrompt;
    if (!basePrompt) return `${label}: ${trimmedExtra}`;
    return `${basePrompt}\n\n${label}: ${trimmedExtra}`;
  };

  const renderAssistantModeCard = () => {
    if (!assistantModeCard || !assistantModeTitle || !assistantModeSummary || !assistantModeOutput || !assistantModeRequirement || !assistantModeTip) return;
    const modeConfig = getActiveAssistantModeConfig();
    const hasPatient = Boolean(selectedPatientId);
    const hasPlan = hasExerciseReportReady();
    const hasDraft = Boolean(String(input?.value || '').trim()) || hasAssistantDiagnosticData();
    const patientLabel = selectedPatientName || currentAssistantPatientBrief?.patientName || 'Paciente activo';

    assistantModeTitle.textContent = modeConfig.title;
    assistantModeSummary.textContent = modeConfig.summary;
    assistantModeOutput.textContent = modeConfig.outputLabel;

    if (!hasPatient && activeAssistantMode !== 'new-plan') {
      assistantModeRequirement.textContent = 'Paso previo: selecciona un paciente';
      assistantModeTip.textContent = 'Este modo usa el contexto clinico del caso. Primero vincula el copilot al paciente correcto.';
      assistantModeCard.classList.add('is-blocked');
      assistantModeCard.classList.remove('is-ready', 'is-complete');
      syncAssistantDiagnosticPanel();
      return;
    }

    assistantModeCard.classList.remove('is-blocked');

    if (hasPlan && activeAssistantMode === 'new-plan') {
      assistantModeRequirement.textContent = 'Estado: plan generado';
      assistantModeTip.textContent = `Ya tienes una propuesta para ${patientLabel}. Puedes exportar PDF o cambiar a Actualizar plan para iterar.`;
      assistantModeCard.classList.add('is-complete');
      assistantModeCard.classList.remove('is-ready');
      syncAssistantDiagnosticPanel();
      return;
    }

    assistantModeCard.classList.remove('is-complete');

    if (hasDraft) {
      assistantModeRequirement.textContent = modeConfig.requirementLabel;
      assistantModeTip.textContent = `Briefing listo para ${patientLabel || 'este caso'}. Revisa el texto y lanza ${modeConfig.primaryLabel.toLowerCase()}.`;
      assistantModeCard.classList.add('is-ready');
      syncAssistantDiagnosticPanel();
      return;
    }

    assistantModeRequirement.textContent = modeConfig.requirementLabel;
    assistantModeTip.textContent = modeConfig.tip;
    assistantModeCard.classList.remove('is-ready');
    syncAssistantDiagnosticPanel();
  };

  const getAssistantModeDraft = (mode: AssistantWorkMode) => {
    if (mode === 'update-plan') {
      return 'Ajusta el plan segun la evolucion del dolor, tolerancia y adherencia.';
    }
    if (mode === 'next-session') {
      return 'Resume que revisar en consulta y que progresion o regresion valorar.';
    }
    return '';
  };

  const setAssistantMode = (mode: AssistantWorkMode, options: { focus?: boolean } = {}) => {
    if (!(mode in assistantModeConfig)) return;
    activeAssistantMode = mode;
    const modeConfig = getActiveAssistantModeConfig();
    if (input) {
      input.placeholder = modeConfig.placeholder;
    }
    renderAssistantModeSwitch();
    renderAssistantPrimaryButton();
    renderAssistantModeCard();
    renderAssistantFlowCard();
    resizeAgentInput();
    renderAssistantDiagnosticSummary();
    if (options.focus && input) {
      input.focus();
      input.setSelectionRange(input.value.length, input.value.length);
    }
  };

  const buildAssistantModeRequest = (rawText: string) => {
    const text = String(rawText || '').trim();
    const diagnosticPrompt = buildAssistantDiagnosticPrompt();
    const diagnosticSummary = getAssistantDiagnosticSummaryText(160);
    const modeConfig = getActiveAssistantModeConfig();
    const contextualPrompt = activeAssistantMode === 'new-plan' ? '' : buildAssistantBriefPrompt(activeAssistantMode);

    if (modeConfig.action === 'exercise') {
      if (!text && !diagnosticPrompt) return null;
      let requestText = activeAssistantMode === 'update-plan'
        ? appendAssistantInstruction(contextualPrompt, text, 'Cambio solicitado')
        : text;
      requestText = appendAssistantInstruction(requestText, diagnosticPrompt, 'Ficha estructurada');
      const visibleText = trimAgentBriefText([text, diagnosticSummary].filter(Boolean).join(' | '), 150) || diagnosticSummary || text;
      return {
        action: 'exercise' as const,
        requestText: requestText || diagnosticPrompt,
        visibleText,
      };
    }

    if (activeAssistantMode !== 'new-plan' && !contextualPrompt) {
      return null;
    }

    const draftText = text || getAssistantModeDraft(activeAssistantMode);
    let requestText = appendAssistantInstruction(contextualPrompt, draftText, 'Solicitud');
    requestText = appendAssistantInstruction(requestText, diagnosticPrompt, 'Ficha estructurada');
    const visibleText = trimAgentBriefText([draftText, diagnosticSummary].filter(Boolean).join(' | '), 150) || draftText;
    return {
      action: 'chat' as const,
      requestText,
      visibleText,
    };
  };

  const getAssistantDraftSummary = () => {
    const draft = String(input?.value || '').replace(/\s+/g, ' ').trim();
    const diagnosticSummary = getAssistantDiagnosticSummaryText(110);
    if (draft && diagnosticSummary) return trimAgentBriefText(`${draft} | ${diagnosticSummary}`, 110);
    if (draft) return draft.length <= 96 ? draft : draft.slice(0, 95).trim() + '...';
    return diagnosticSummary;
  };

  const hasExerciseReportReady = () => {
    if (!lastExerciseReportPayload) return false;
    const reportPatientId = String(lastExerciseReportPayload?.patient_id || '').trim();
    if (!reportPatientId || !selectedPatientId) return Boolean(lastExerciseReportPayload);
    return reportPatientId === selectedPatientId;
  };

  const renderAssistantFlowCard = () => {
    if (!assistantFlowCard || !assistantFlowSteps || !assistantFlowHint || !assistantFlowDraft || !assistantFlowTitle) return;
    renderAssistantModeCard();

    const hasPatient = Boolean(selectedPatientId);
    const hasGoal = Boolean(getAssistantDraftSummary());
    const hasPlan = hasExerciseReportReady();
    const patientName = selectedPatientName || currentAssistantPatientBrief?.patientName || 'Paciente activo';
    const draftSummary = getAssistantDraftSummary();

    assistantFlowCard.classList.toggle('is-complete', hasPlan);
    assistantRail?.classList.toggle('assistant-has-report', hasPlan);

    if (hasPlan) {
      assistantFlowSteps.innerHTML = '';
      assistantFlowTitle.textContent = 'Plan generado y listo para revisar';
      assistantFlowHint.textContent = 'El informe ya esta debajo. Revisa el contenido y exporta el PDF cuando quieras.';
      assistantFlowDraft.textContent = draftSummary
        ? 'Objetivo usado: ' + draftSummary
        : 'El plan ya esta preparado para exportacion.';
      return;
    }

    const steps = [
      {
        label: 'Paciente',
        state: hasPatient ? 'done' : 'current',
        meta: hasPatient ? patientName : 'Selecciona uno'
      },
      {
        label: 'Objetivo',
        state: hasGoal ? 'done' : (hasPatient ? 'current' : 'pending'),
        meta: hasGoal ? 'Contexto cargado' : 'Describe dolor o meta'
      },
      {
        label: 'Plan IA',
        state: hasPatient && hasGoal ? 'current' : 'pending',
        meta: 'Pulsa Generar plan'
      },
      {
        label: 'PDF e historial',
        state: 'pending',
        meta: 'Se activa tras generar'
      }
    ];

    assistantFlowSteps.innerHTML = steps.map((step) => {
      return '<article class="assistant-flow-step is-' + escapeAttr(step.state) + '">' +
        '<span class="assistant-flow-step-dot"></span>' +
        '<div>' +
          '<strong>' + escapeHtml(step.label) + '</strong>' +
          '<small>' + escapeHtml(step.meta) + '</small>' +
        '</div>' +
      '</article>';
    }).join('');

    if (!hasPatient) {
      assistantFlowTitle.textContent = 'Empezamos vinculando el caso al historial correcto';
      assistantFlowHint.textContent = 'Selecciona un paciente para que plan, PDF y seguimiento queden unidos al caso clinico.';
    } else if (!hasGoal) {
      assistantFlowTitle.textContent = 'El caso ya esta listo para recibir un objetivo clinico';
      assistantFlowHint.textContent = 'Describe dolor, restriccion funcional o meta terapeutica para orientar el plan.';
    } else {
      assistantFlowTitle.textContent = 'Buen briefing: ahora toca pedir la propuesta del agente';
      assistantFlowHint.textContent = 'Genera el plan para revisar ejercicios, ajustar el mensaje al paciente y habilitar el PDF.';
    }

    assistantFlowDraft.textContent = draftSummary
      ? 'Objetivo actual: ' + draftSummary
      : 'Sin objetivo redactado todavia.';
  };
  const renderAssistantPatientBrief = (brief: any = null, options: { loading?: boolean; error?: boolean } = {}) => {
    if (!assistantPatientBrief) return;
    const loading = Boolean(options.loading);
    const error = Boolean(options.error);

    if (!selectedPatientId && !brief) {
      currentAssistantPatientBrief = null;
      assistantPatientBrief.innerHTML = '<div class="assistant-patient-brief-empty"><span class="assistant-brief-kicker">Briefing clinico</span><strong>Selecciona un paciente para cargar contexto clinico util.</strong><p>Veras seguimiento reciente, estado del plan y accesos rapidos para pedir mejores ejercicios.</p></div>';
      assistantPatientBrief.removeAttribute('data-state');
      return;
    }

    if (loading) {
      const loadingName = escapeHtml(brief?.patientName || selectedPatientName || 'Paciente seleccionado');
      assistantPatientBrief.setAttribute('data-state', 'loading');
      assistantPatientBrief.innerHTML = `<div class="assistant-patient-brief-empty"><span class="assistant-brief-kicker">Briefing clinico</span><strong>Cargando contexto de ${loadingName}...</strong><p>Recuperando seguimiento, recomendaciones y estado del ultimo plan.</p></div>`;
      return;
    }

    if (error) {
      const errorName = escapeHtml(brief?.patientName || selectedPatientName || 'el paciente seleccionado');
      assistantPatientBrief.setAttribute('data-state', 'error');
      assistantPatientBrief.innerHTML = `<div class="assistant-patient-brief-empty"><span class="assistant-brief-kicker">Briefing clinico</span><strong>No se pudo cargar el contexto de ${errorName}.</strong><p>Puedes seguir usando el copilot, pero sin resumen clinico guiado todavia.</p></div>`;
      return;
    }

    if (!brief) {
      assistantPatientBrief.innerHTML = '<div class="assistant-patient-brief-empty"><span class="assistant-brief-kicker">Briefing clinico</span><strong>Sin contexto clinico disponible todavia.</strong><p>Selecciona un paciente con historial para obtener mejores prompts guiados.</p></div>';
      assistantPatientBrief.removeAttribute('data-state');
      return;
    }

    const latestNoteDate = brief.latestNoteDate ? fmtDate(brief.latestNoteDate) : 'Sin fecha';
    const latestPlanDate = brief.latestRecommendationDate ? fmtDate(brief.latestRecommendationDate) : 'Sin plan';
    const latestPain = brief.latestPainScale !== null && brief.latestPainScale !== undefined ? `${escapeHtml(String(brief.latestPainScale))}/10` : 'Sin dato';
    const latestNote = escapeHtml(brief.latestNoteText || 'Sin seguimiento reciente');
    const therapistNote = escapeHtml(brief.therapistNote || 'Sin nota clinica del ultimo plan');
    const planState = escapeHtml(brief.latestRecommendationState || 'sin_plan');
    const planCount = brief.recommendationsCount || 0;
    const notesCount = brief.notesCount || 0;

    assistantPatientBrief.removeAttribute('data-state');
    assistantPatientBrief.innerHTML = `
      <div class="assistant-brief-head">
        <span class="assistant-brief-kicker">Briefing clinico</span>
        <span class="assistant-brief-pill">${planCount} plan(es) / ${notesCount} seguimiento(s)</span>
      </div>
      <strong class="assistant-brief-title">${escapeHtml(brief.patientName)} listo para trabajar con contexto real.</strong>
      <div class="assistant-brief-grid">
        <article class="assistant-brief-item">
          <span>Ultimo seguimiento</span>
          <strong>${latestNote}</strong>
          <small>${escapeHtml(latestNoteDate)}</small>
        </article>
        <article class="assistant-brief-item">
          <span>Ultimo plan</span>
          <strong>${planCount ? `${escapeHtml(latestPlanDate)} - ${planState}` : 'Sin plan previo'}</strong>
          <small>${planCount ? `${brief.exerciseCount || 0} ejercicio(s) en la ultima propuesta` : 'Genera una primera propuesta guiada'}</small>
        </article>
        <article class="assistant-brief-item assistant-brief-item-secondary">
          <span>Dolor / alertas</span>
          <strong>${latestPain}${brief.redFlagsPresent ? ' - revisar alertas' : ''}</strong>
          <small>${brief.redFlagsPresent ? 'El ultimo informe marco alertas rojas.' : 'Sin alertas rojas en el ultimo informe.'}</small>
        </article>
        <article class="assistant-brief-item assistant-brief-item-secondary">
          <span>Nota clinica del plan</span>
          <strong>${therapistNote}</strong>
          <small>${brief.patientMessage ? escapeHtml(brief.patientMessage) : 'Sin mensaje previo al paciente.'}</small>
        </article>
      </div>
      <div class="assistant-brief-actions">
        <button type="button" class="assistant-chip" data-assistant-brief-action="update-plan"><span class="material-symbols-rounded">neurology</span> Actualizar plan</button>
        <button type="button" class="assistant-chip" data-assistant-brief-action="next-session"><span class="material-symbols-rounded">event_available</span> Checklist visita</button>
      </div>
    `;
  };

  const syncAssistantPatientBriefFromData = (patientId: string, patient: any, notes: any[] = [], recommendations: any[] = []) => {
    const safePatientId = String(patientId || '').trim();
    if (!safePatientId) {
      currentAssistantPatientBrief = null;
      renderAssistantPatientBrief(null);
      return null;
    }
    const brief = buildAssistantPatientBrief(patient, notes, recommendations);
    assistantPatientBriefCache[safePatientId] = brief;
    currentAssistantPatientBrief = brief;
    renderAssistantPatientBrief(brief);
    return brief;
  };

  const loadAssistantPatientBrief = async (patientId: string | null, force = false) => {
    const safePatientId = String(patientId || '').trim();
    if (!safePatientId) {
      assistantPatientBriefRequestToken += 1;
      currentAssistantPatientBrief = null;
      renderAssistantPatientBrief(null);
      return null;
    }

    if (!force && assistantPatientBriefCache[safePatientId]) {
      currentAssistantPatientBrief = assistantPatientBriefCache[safePatientId];
      renderAssistantPatientBrief(currentAssistantPatientBrief);
      return currentAssistantPatientBrief;
    }

    const requestToken = ++assistantPatientBriefRequestToken;
    renderAssistantPatientBrief({ patientName: selectedPatientName || 'Paciente seleccionado' }, { loading: true });

    try {
      const [patientResp, historyResp, recommendationsResp] = await Promise.all([
        fetchJson(`${BACKEND_BASE}/api/pacientes/${safePatientId}`),
        fetchJson(`${BACKEND_BASE}/api/profesional/patients/${safePatientId}/history`),
        fetchJson(`${BACKEND_BASE}/api/exercises/recommendations/${safePatientId}?limit=25`),
      ]);

      if (requestToken !== assistantPatientBriefRequestToken) return null;

      return syncAssistantPatientBriefFromData(
        safePatientId,
        patientResp?.data || {},
        historyResp?.data?.notas_seguimiento || [],
        recommendationsResp?.data || []
      );
    } catch {
      if (requestToken !== assistantPatientBriefRequestToken) return null;
      currentAssistantPatientBrief = null;
      renderAssistantPatientBrief({ patientName: selectedPatientName || 'Paciente seleccionado' }, { error: true });
      return null;
    }
  };

  const loadAssistantTelegramLinkState = async (patientId: string | null) => {
    const safePatientId = String(patientId || '').trim();
    const requestToken = ++assistantTelegramLinkRequestToken;

    if (!safePatientId) {
      currentPatientTelegramLinkState = null;
      updateExerciseTelegramButton();
      return null;
    }

    try {
      const payload = await fetchJson(`${BACKEND_BASE}/api/telegram/link-code/${safePatientId}`);
      if (requestToken !== assistantTelegramLinkRequestToken) return null;
      currentPatientTelegramLinkState = payload?.data || null;
      updateExerciseTelegramButton();
      return currentPatientTelegramLinkState;
    } catch {
      if (requestToken !== assistantTelegramLinkRequestToken) return null;
      currentPatientTelegramLinkState = null;
      updateExerciseTelegramButton();
      return null;
    }
  };

  const updateAssistantPatientSelectorState = () => {
    if (!chatPatientSelect) return;
    const hasValue = Boolean(chatPatientSelect.value);
    chatPatientSelect.classList.toggle('has-value', hasValue);
    const selectorShell = chatPatientSelect.closest('.patient-selector');
    selectorShell?.classList.toggle('has-value', hasValue);
  };

  const rememberSelectedPatient = (patientId: string | null, patientName = '') => {
    try {
      if (!patientId) {
        localStorage.removeItem(SELECTED_PATIENT_STORAGE_KEY);
        return;
      }
      localStorage.setItem(SELECTED_PATIENT_STORAGE_KEY, JSON.stringify({
        id: patientId,
        name: patientName || '',
      }));
    } catch {}
  };

  const restoreSelectedPatientFromStorage = () => {
    if (selectedPatientId || !patientCatalog.length) return;
    try {
      const raw = localStorage.getItem(SELECTED_PATIENT_STORAGE_KEY);
      if (!raw) return;
      const saved = JSON.parse(raw);
      const patientId = String(saved?.id || '').trim();
      const patient = patientCatalog.find((item) => item.id === patientId);
      if (!patient) return;
      selectedPatientId = patient.id;
      selectedPatientName = patient.nombre_completo || String(saved?.name || '').trim();
    } catch {}
  };

  function syncChatPatientSelection(patientId: string | null, fallbackName = '') {
    if (!chatPatientSelect) return;
    const nextId = patientId || '';
    chatPatientSelect.value = nextId;
    selectedPatientId = nextId || null;
    updateAssistantPatientSelectorState();

    const activeReportPatientId = String(lastExerciseReportPayload?.patient_id || '').trim();
    if (!nextId || (activeReportPatientId && activeReportPatientId !== nextId)) {
      lastExerciseReportPayload = null;
      updateExercisePdfButton();
    }

    if (!nextId) {
      selectedPatientName = '';
      currentAssistantPatientBrief = null;
      currentPatientTelegramLinkState = null;
      rememberSelectedPatient(null);
      renderAssistantPatientContext();
      renderAssistantPatientBrief(null);
      renderAssistantFlowCard();
      updateExerciseTelegramButton();
      return;
    }

    const selected = patientCatalog.find((p) => p.id === nextId);
    selectedPatientName = selected?.nombre_completo || fallbackName || selectedPatientName || '';
    rememberSelectedPatient(nextId, selectedPatientName);
    currentPatientTelegramLinkState = null;
    renderAssistantPatientContext();
    updateExerciseTelegramButton();

    const cachedBrief = assistantPatientBriefCache[nextId];
    if (cachedBrief) {
      currentAssistantPatientBrief = cachedBrief;
      renderAssistantPatientBrief(cachedBrief);
    } else {
      renderAssistantPatientBrief({ patientName: selectedPatientName || 'Paciente seleccionado' }, { loading: true });
    }
    renderAssistantFlowCard();
    void loadAssistantTelegramLinkState(nextId);
  }

  const renderExerciseOpsMetric = () => {
    if (!metricEngineOps) return;
    metricEngineOps.textContent = `${exerciseOpsStats.timeouts}/${exerciseOpsStats.retries}`;
  };
  renderExerciseOpsMetric();

  const incrementArchivedReportsMetric = (recommendationId: string | null) => {
    const metricEl = document.getElementById('metricInformes');
    if (!metricEl) return;
    if (recommendationId && archivedReportIds.has(recommendationId)) return;

    const current = parseInt(metricEl.textContent || '0', 10);
    metricEl.textContent = Number.isFinite(current) ? String(current + 1) : '1';

    if (recommendationId) {
      archivedReportIds.add(recommendationId);
    }
  };

  const syncEngineOpsFromPayload = (payload: any) => {
    const requestId = String(payload?.request_id || '').trim();
    if (requestId && processedEngineObservability.has(requestId)) return;

    const engineObs = payload?.engine_observability || {};
    const retriesUsed = Number(engineObs?.retries_used || 0);
    const attemptsDetail = Array.isArray(engineObs?.attempts_detail) ? engineObs.attempts_detail : [];
    const timedOutCount = attemptsDetail.filter((entry: any) => Boolean(entry?.timed_out)).length;

    if (retriesUsed > 0) {
      exerciseOpsStats.retries += retriesUsed;
    }
    if (timedOutCount > 0) {
      exerciseOpsStats.timeouts += timedOutCount;
    }

    if (requestId) {
      processedEngineObservability.add(requestId);
    }
    renderExerciseOpsMetric();
  };

  let activeSection = 'dashboard';
  const financeSections = new Set(['pagos', 'facturas', 'bonos', 'gestoria']);

  const navigateTo = (section: string) => {
    const targetSection = section === 'finanzas' ? 'pagos' : section;
    activeSection = targetSection;
    const sidebarSection = financeSections.has(targetSection) ? 'finanzas' : targetSection;
    navItems.forEach(n => n.classList.toggle('active', n.getAttribute('data-section') === sidebarSection));
    mobileDock?.setAttribute('data-active-section', targetSection);
    mobileDockNavButtons.forEach((button) => button.classList.toggle('active', button.dataset.mobileNav === targetSection));
    pages.forEach(p => {
      const isActive = (p as HTMLElement).dataset.page === targetSection;
      p.classList.toggle('active', isActive);
    });
    if (pageLoaders[targetSection]) pageLoaders[targetSection]();
    syncAgendaAutoRefresh();
  };
  navItems.forEach(n => n.addEventListener('click', (e: Event) => { e.preventDefault(); navigateTo(n.getAttribute('data-section') || 'dashboard'); }));

  // === SIDEBAR TOGGLE (responsive) ===
  const sidebarBackdrop = document.getElementById('sidebarBackdrop') as HTMLElement | null;
  const isMobile = () => window.innerWidth <= 768;
  const isLaptopViewport = () => window.innerWidth <= 1600 || window.innerHeight <= 940;
  const isCompactAssistantViewport = () => window.innerWidth <= 1400 || window.innerHeight <= 820;
  const getAssistantViewportMode = () => (isMobile() ? 'mobile' : isCompactAssistantViewport() ? 'compact' : 'desktop');

  const syncResponsiveViewportState = () => {
    const root = document.documentElement;
    const viewportMode = isMobile() ? 'mobile' : isLaptopViewport() ? 'laptop' : 'desktop';
    const assistantMode = getAssistantViewportMode();

    root.dataset.viewportMode = viewportMode;
    root.dataset.assistantMode = assistantMode;


    if (viewportMode === 'desktop') {
      closeSidebar();
    }
  };

  const syncOverlayBodyLock = () => {
    const sidebarOpen = Boolean(sidebar?.classList.contains('open'));
    const assistantOpen = Boolean(assistantRail?.classList.contains('open'));
    document.body.style.overflow = sidebarOpen || assistantOpen ? 'hidden' : '';
  };

  const mountAssistantLayerToBody = () => {
    if (!assistantRail || !assistantRailBackdrop) return;
    if (assistantRailBackdrop.parentElement !== document.body) {
      document.body.appendChild(assistantRailBackdrop);
    }
    if (assistantRail.parentElement !== document.body) {
      document.body.appendChild(assistantRail);
    }
    assistantRail.classList.add('assistant-rail-portal');
    assistantRailBackdrop.classList.add('assistant-rail-backdrop-portal');
  };
  mountAssistantLayerToBody();

  const openSidebar = () => {
    sidebar?.classList.add('open');
    sidebarBackdrop?.classList.add('visible');
    syncOverlayBodyLock();
  };
  const closeSidebar = () => {
    sidebar?.classList.remove('open');
    sidebarBackdrop?.classList.remove('visible');
    syncOverlayBodyLock();
  };

  const openAssistantRail = () => {
    const railOpenTransform = isMobile() ? 'translateY(0)' : 'translateX(0)';
    assistantRail?.classList.add('open');
    assistantRailBackdrop?.classList.add('visible');
    assistantRail?.setAttribute('aria-hidden', 'false');
    assistantRail?.style.setProperty('position', 'fixed', 'important');
    assistantRail?.style.setProperty('z-index', '2147483000', 'important');
    assistantRail?.style.setProperty('opacity', '1', 'important');
    assistantRail?.style.setProperty('pointer-events', 'auto', 'important');
    assistantRail?.style.setProperty('transform', railOpenTransform, 'important');
    assistantRailBackdrop?.style.setProperty('position', 'fixed', 'important');
    assistantRailBackdrop?.style.setProperty('z-index', '2147482999', 'important');
    assistantRailToggle?.setAttribute('aria-expanded', 'true');
    assistantRailFab?.setAttribute('aria-expanded', 'true');
    syncOverlayBodyLock();
    window.setTimeout(() => input?.focus(), 120);
  };

  const closeAssistantRail = () => {
    assistantRail?.classList.remove('open');
    assistantRailBackdrop?.classList.remove('visible');
    assistantRail?.setAttribute('aria-hidden', 'true');
    assistantRail?.style.removeProperty('position');
    assistantRail?.style.removeProperty('z-index');
    assistantRail?.style.removeProperty('opacity');
    assistantRail?.style.removeProperty('pointer-events');
    assistantRail?.style.removeProperty('transform');
    assistantRailBackdrop?.style.removeProperty('position');
    assistantRailBackdrop?.style.removeProperty('z-index');
    assistantRailToggle?.setAttribute('aria-expanded', 'false');
    assistantRailFab?.setAttribute('aria-expanded', 'false');
    syncOverlayBodyLock();
  };

  const requestOpenAssistantRail = () => {
    openAssistantRail();
    input?.focus();
  };

  sidebarToggle?.addEventListener('click', () => {
    if (isMobile()) {
      sidebar?.classList.contains('open') ? closeSidebar() : openSidebar();
    } else {
      sidebar?.classList.toggle('collapsed');
    }
  });
  sidebarBackdrop?.addEventListener('click', closeSidebar);

  assistantRailToggle?.addEventListener('click', requestOpenAssistantRail);
  assistantRailFab?.addEventListener('click', requestOpenAssistantRail);
  assistantRailClose?.addEventListener('click', closeAssistantRail);
  assistantRailBackdrop?.addEventListener('click', closeAssistantRail);
  focusAgentNav?.addEventListener('click', (event: Event) => {
    event.preventDefault();
    requestOpenAssistantRail();
  });
  heroAgentShortcutBtn?.addEventListener('click', () => {
    requestOpenAssistantRail();
