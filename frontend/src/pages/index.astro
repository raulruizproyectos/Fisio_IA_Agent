  const activateFichaTab = (tabName: string) => {
    document.querySelectorAll('.ficha-tab').forEach((tab) => {
      tab.classList.toggle('active', tab.getAttribute('data-ficha-tab') === tabName);
    });
    document.querySelectorAll('.ficha-panel').forEach((panel) => {
      panel.classList.toggle('active', panel.getAttribute('data-ficha-panel') === tabName);
    });
  };

  const pickLatestIsoDate = (current: string | null, candidate: string | null) => {
    if (!candidate) return current;
    if (!current) return candidate;
    return new Date(candidate).getTime() > new Date(current).getTime() ? candidate : current;
  };

  const getRecommendationExerciseCount = (recommendation: any) => {
    const reportSnapshot = recommendation?.report_snapshot || {};
    const reportExercises = Array.isArray(reportSnapshot?.exercises) ? reportSnapshot.exercises : [];
    const itemExercises = Array.isArray(recommendation?.crm_recomendacion_items) ? recommendation.crm_recomendacion_items : [];
    return reportExercises.length || itemExercises.length || 0;
  };

  const getRecommendationAdherenceMeta = (rawStatus: any) => {
    const normalized = String(rawStatus || '').trim().toLowerCase();
    if (!normalized) return { label: 'Sin feedback', tone: 'pendiente' };
    if (/(alta|high|good|completa|complete|full)/.test(normalized)) return { label: 'Adherencia alta', tone: 'aprobado' };
    if (/(media|moderada|medium|partial|parcial)/.test(normalized)) return { label: 'Adherencia media', tone: 'pendiente' };
    if (/(baja|low|poor|fall|aband)/.test(normalized)) return { label: 'Adherencia baja', tone: 'rechazado' };
    return { label: normalized.replace(/_/g, ' '), tone: 'pendiente' };
  };

  const summarizePatientRecommendations = (recommendations: any[] = []) => {
    const safe = Array.isArray(recommendations) ? recommendations : [];
    let latestFollowUp: any = null;
    let latestArchivedReport: any = null;
    let latestTouchAt: string | null = safe[0]?.created_at || null;
    let totalExercises = 0;
    let totalFollowUps = 0;
    let totalArchivedReports = 0;

    for (const recommendation of safe) {
      totalExercises += getRecommendationExerciseCount(recommendation);
      const followUps = Array.isArray(recommendation?.follow_ups) ? recommendation.follow_ups : [];
      const archivedReports = Array.isArray(recommendation?.archived_reports) ? recommendation.archived_reports : [];
      totalFollowUps += followUps.length;
      totalArchivedReports += archivedReports.length;
      for (const item of followUps) {
        const at = item?.created_at || item?.fecha || null;
        latestTouchAt = pickLatestIsoDate(latestTouchAt, at);
      }
      for (const item of followUps) {
        const at = item?.created_at || item?.fecha || null;
        if (!latestFollowUp || new Date(at || 0).getTime() > new Date((latestFollowUp?.created_at || latestFollowUp?.fecha || 0)).getTime()) latestFollowUp = item;
      }
      for (const item of archivedReports) {
        const at = item?.archived_at || item?.created_at || null;
        latestTouchAt = pickLatestIsoDate(latestTouchAt, at);
        if (!latestArchivedReport || new Date(at || 0).getTime() > new Date((latestArchivedReport?.archived_at || latestArchivedReport?.created_at || 0)).getTime()) latestArchivedReport = item;
      }
    }

    return {
      totalPlans: safe.length,
      totalExercises,
      totalFollowUps,
      totalArchivedReports,
      latestRecommendation: safe[0] || null,
      latestFollowUp,
      latestArchivedReport,
      latestTouchAt,
    };
  };

  const buildFichaActivityItems = (citas: any[] = [], notas: any[] = [], recommendations: any[] = []) => {
    const citaItems = citas
      .filter((cita: any) => cita?.fecha_hora)
      .map((cita: any) => ({
        type: 'cita',
        date: cita.fecha_hora,
        label: cita.estado ? `Cita ${String(cita.estado).toLowerCase()}` : 'Cita registrada',
        title: cita.motivo || 'Sesion clinica',
        meta: cita.fecha_hora ? fmtDate(cita.fecha_hora) : 'Fecha no disponible',
      }));

    const notaItems = notas
      .filter((nota: any) => nota?.fecha)
      .map((nota: any) => ({
        type: 'nota',
        date: nota.fecha,
        label: nota?.dolor_eva != null ? `EVA ${nota.dolor_eva}/10` : 'Nota clinica',
        title: trimAgentBriefText(nota.nota || 'Seguimiento clinico', 88),
        meta: nota.fecha ? fmtDate(nota.fecha) : 'Fecha no disponible',
      }));

    const recommendationItems = recommendations.flatMap((recommendation: any) => {
      const items: any[] = [];
      const exerciseCount = getRecommendationExerciseCount(recommendation);
      const followUps = Array.isArray(recommendation?.follow_ups) ? recommendation.follow_ups : [];
      const archivedReports = Array.isArray(recommendation?.archived_reports) ? recommendation.archived_reports : [];
      const latestFollowUp = followUps.length ? [...followUps].sort((a: any, b: any) => new Date((b?.created_at || b?.fecha || 0)).getTime() - new Date((a?.created_at || a?.fecha || 0)).getTime())[0] : null;
      const latestArchivedReport = archivedReports.length ? [...archivedReports].sort((a: any, b: any) => new Date((b?.archived_at || b?.created_at || 0)).getTime() - new Date((a?.archived_at || a?.created_at || 0)).getTime())[0] : null;
      const adherenceMeta = getRecommendationAdherenceMeta(latestFollowUp?.adherence_status || null);
      if (recommendation?.created_at) items.push({ type: 'plan', date: recommendation.created_at, label: 'Plan IA', title: recommendation?.symptom_summary || recommendation?.selection_rationale || 'Plan de ejercicios generado', meta: `${exerciseCount} ejercicios prescritos` });
      if (latestArchivedReport?.archived_at || latestArchivedReport?.created_at) items.push({ type: 'delivery', date: latestArchivedReport?.archived_at || latestArchivedReport?.created_at, label: 'Entrega archivada', title: `Informe ${String(latestArchivedReport?.format || 'pdf').toUpperCase()}`, meta: latestArchivedReport?.source || 'Archivado en historial' });
      if (latestFollowUp?.created_at || latestFollowUp?.fecha) items.push({ type: 'followup', date: latestFollowUp?.created_at || latestFollowUp?.fecha, label: adherenceMeta.label, title: trimAgentBriefText(latestFollowUp?.note_text || 'Seguimiento del plan registrado', 88), meta: latestFollowUp?.pain_scale !== null && latestFollowUp?.pain_scale !== undefined ? `Dolor ${latestFollowUp.pain_scale}/10` : 'Sin escala de dolor informada' });
      return items;
    });

    return [...citaItems, ...notaItems, ...recommendationItems]
      .sort((a: any, b: any) => new Date(b.date).getTime() - new Date(a.date).getTime())
      .slice(0, 6);
  };

  const buildFichaPainSeries = (notas: any[] = [], latestFollowUp: any = null) => {
    const noteSeries = (Array.isArray(notas) ? notas : [])
      .filter((nota: any) => nota?.fecha && nota?.dolor_eva !== null && nota?.dolor_eva !== undefined && nota?.dolor_eva !== '')
      .map((nota: any) => ({ date: nota.fecha, value: Number(nota.dolor_eva), label: 'Nota clinica' }))
      .filter((item: any) => item.date && Number.isFinite(item.value));

    const followUpPain = latestFollowUp?.pain_scale;
    const followUpSeries = (latestFollowUp?.created_at || latestFollowUp?.fecha) && followUpPain !== null && followUpPain !== undefined && followUpPain !== ''
      ? [{ date: latestFollowUp?.created_at || latestFollowUp?.fecha, value: Number(followUpPain), label: 'Plan en casa' }]
      : [];

    return [...followUpSeries, ...noteSeries]
      .filter((item: any) => item.date && Number.isFinite(item.value))
      .sort((a: any, b: any) => new Date(b.date).getTime() - new Date(a.date).getTime())
      .slice(0, 4);
  };

  const getFichaPainTrend = (series: any[] = []) => {
    if (!series.length) {
      return {
        headline: 'Sin lectura EVA',
        tone: 'soft',
        summary: 'Aun no hay una escala de dolor registrada para medir evolucion.',
        deltaLabel: 'Sin historico',
      };
    }

    const latest = series[0];
    const oldest = series[series.length - 1];
    const delta = series.length > 1 ? latest.value - oldest.value : null;
    const deltaLabel = delta === null ? '1 lectura' : `${delta > 0 ? '+' : ''}${delta} puntos`;

    if (latest.value >= 7) {
      return {
        headline: 'Dolor alto',
        tone: 'alert',
        summary: `Ultima lectura EVA ${latest.value}/10. Conviene revisar carga, tecnica y siguiente sesion.`,
        deltaLabel,
      };
    }

    if (delta !== null && delta <= -2) {
      return {
        headline: 'Mejorando',
        tone: 'ready',
        summary: `El dolor baja ${Math.abs(delta)} puntos en las ultimas ${series.length} lecturas disponibles.`,
        deltaLabel,
      };
    }

    if (delta !== null && delta >= 2) {
      return {
        headline: 'Empeora',
        tone: 'alert',
        summary: `El dolor sube ${delta} puntos y conviene reajustar el plan o la carga terapeutica.`,
        deltaLabel,
      };
    }

    if (latest.value <= 3) {
      return {
        headline: 'Bajo control',
        tone: 'ready',
        summary: `Ultima lectura EVA ${latest.value}/10 con cuadro contenido y margen para progresar.`,
        deltaLabel,
      };
    }

    return {
      headline: 'Estable',
      tone: 'soft',
      summary: delta === null ? `Ultima lectura EVA ${latest.value}/10.` : `La variacion reciente es ${delta > 0 ? '+' : ''}${delta} puntos sin cambios bruscos.`,
      deltaLabel,
    };
  };

  const renderFichaWorkspace = (payload: any) => {
    const patient = payload?.paciente || {};
    const citas = Array.isArray(payload?.citas) ? payload.citas : [];
    const pagos = Array.isArray(payload?.pagos) ? payload.pagos : [];
    const notas = Array.isArray(payload?.notas) ? payload.notas : [];
    const recommendations = Array.isArray(payload?.recommendations) ? payload.recommendations : [];
    const citasUnavailable = isFichaModuleUnavailable('citas');
    const pagosUnavailable = isFichaModuleUnavailable('pagos');
    const notasUnavailable = isFichaModuleUnavailable('notas');
    const latestAppointment = citasUnavailable ? null : getFichaLatestAppointment(citas);
    const latestNote = notasUnavailable ? null : (notas[0] || null);
    const totalPayments = pagosUnavailable ? 0 : pagos.reduce((sum: number, payment: any) => sum + Number(payment?.importe || 0), 0);
    const latestEva = latestNote?.dolor_eva != null ? Number(latestNote.dolor_eva) : null;
    const recommendationSummary = summarizePatientRecommendations(recommendations);
    const latestFollowUp = recommendationSummary.latestFollowUp;
    const latestArchivedReport = recommendationSummary.latestArchivedReport;
    const latestAdherence = getRecommendationAdherenceMeta(latestFollowUp?.adherence_status || null);
    const activityItems = buildFichaActivityItems(citasUnavailable ? [] : citas, notasUnavailable ? [] : notas, recommendations);
    const unavailableModules = Array.from(fichaModuleAvailability.values());
    const painSeries = buildFichaPainSeries(notasUnavailable ? [] : notas, latestFollowUp);
    const latestPainSample = painSeries[0] || null;
    const painTrend = getFichaPainTrend(painSeries);
    const continuityLabel = recommendationSummary.totalPlans
      ? recommendationSummary.totalFollowUps
        ? 'Seguimiento domiciliario activo'
        : recommendationSummary.totalArchivedReports
          ? 'Plan entregado'
          : 'Plan pendiente de entrega'
      : latestAppointment
        ? 'Seguimiento presencial'
        : 'Sin continuidad activa';
    const continuityMeta = recommendationSummary.totalPlans
      ? recommendationSummary.totalFollowUps
        ? `Ultimo feedback ${fmtDate(latestFollowUp?.created_at || latestFollowUp?.fecha || '')}`
        : recommendationSummary.totalArchivedReports
          ? 'Falta respuesta del paciente para medir adherencia y dolor.'
          : 'Genera o archiva la entrega para activar trazabilidad del plan.'
      : latestAppointment?.fecha_hora
        ? `Ultima sesion ${fmtDate(latestAppointment.fecha_hora)}`
        : 'Programa una sesion o un plan para activar continuidad.';

    let progressNextTone = painTrend.tone;
    let progressNextTitle = recommendationSummary.totalPlans
      ? 'Mantener seguimiento del plan'
      : 'Documentar el caso con mas detalle';
    let progressNextMeta = recommendationSummary.totalPlans
      ? 'El caso ya tiene continuidad domiciliaria. Mantiene trazabilidad y prepara el siguiente ajuste terapeutico.'
      : 'Aun no hay plan domiciliario. Conviene apoyarse en notas y sesiones para decidir el siguiente paso.';

    if (unavailableModules.length) {
      progressNextTone = 'alert';
      progressNextTitle = 'Recuperar integridad del CRM';
      progressNextMeta = `La ficha esta en modo parcial. Falta recuperar: ${unavailableModules.map((item: any) => item?.label || item?.key || 'modulo').join(', ')}.`;
    } else if (recommendationSummary.totalPlans && !recommendationSummary.totalArchivedReports) {
      progressNextTone = 'warm';
      progressNextTitle = 'Archivar el documento del plan';
      progressNextMeta = 'Ya existe un plan IA, pero aun no hay PDF o entrega archivada en el historial del paciente.';
    } else if (recommendationSummary.totalArchivedReports && !recommendationSummary.totalFollowUps) {
      progressNextTone = 'warm';
      progressNextTitle = 'Pedir feedback domiciliario';
      progressNextMeta = 'El plan ya se entrego. Falta registrar adherencia, dolor y respuesta funcional del paciente.';
    } else if (painTrend.tone === 'alert') {
      progressNextTone = 'alert';
      progressNextTitle = 'Revalorar dolor y carga terapeutica';
      progressNextMeta = latestPainSample ? `Ultima lectura registrada: EVA ${latestPainSample.value}/10.` : 'Conviene revisar la evolucion clinica antes de mantener el plan actual.';
    } else if (!notasUnavailable && latestAppointment && !latestNote) {
      progressNextTone = 'warm';
      progressNextTitle = 'Registrar evolucion tras la ultima sesion';
      progressNextMeta = 'Hay actividad asistencial, pero aun falta una nota clinica que deje criterio y respuesta terapeutica.';
    } else if (recommendationSummary.totalPlans) {
      progressNextTone = 'ready';
      progressNextTitle = 'Preparar siguiente ajuste del plan';
      progressNextMeta = recommendationSummary.totalFollowUps
        ? 'Ya hay feedback del paciente. Usa dolor y adherencia para decidir si progresar, mantener o simplificar.'
        : 'Mantiene el seguimiento activo y deja claro en ficha el siguiente objetivo terapeutico.';
    }

    if (fichaOverviewStats) {
      fichaOverviewStats.innerHTML = `
        <article class="ficha-overview-stat">
          <span>Estado del caso</span>
          <strong>${unavailableModules.length ? 'Vista parcial' : latestNote ? 'Seguimiento activo' : citas.length ? 'Caso abierto' : 'Primera valoracion'}</strong>
          <p>${escapeHtml(unavailableModules.length ? 'Algunos modulos requieren migracion.' : latestNote ? 'Hay notas clinicas registradas.' : citas.length ? 'Sin notas de seguimiento.' : 'Sin sesiones registradas.')}</p>
        </article>
        <article class="ficha-overview-stat">
          <span>Sesiones</span>
          <strong>${citasUnavailable ? 'No disponible' : citas.length}</strong>
          <p>${escapeHtml(citasUnavailable ? getFichaModuleMessage('citas', 'Historial de citas no disponible en esta instancia.') : latestAppointment?.fecha_hora ? `Ultima: ${fmtDate(latestAppointment.fecha_hora)}` : 'Sin citas registradas todavia.')}</p>
        </article>
        <article class="ficha-overview-stat">
          <span>Seguimiento</span>
          <strong>${notasUnavailable ? 'No disponible' : `${notas.length} nota${notas.length === 1 ? '' : 's'}`}</strong>
          <p>${escapeHtml(notasUnavailable ? getFichaModuleMessage('notas', 'Notas clinicas no disponibles en esta instancia.') : latestEva != null ? `Dolor actual reportado: EVA ${latestEva}/10.` : 'Aun no hay una evolucion clinica documentada.')}</p>
        </article>
        <article class="ficha-overview-stat">
          <span>Actividad economica</span>
          <strong>${pagosUnavailable ? 'No disponible' : `${totalPayments.toFixed(2)} EUR`}</strong>
          <p>${escapeHtml(pagosUnavailable ? getFichaModuleMessage('pagos', 'Historial de pagos no disponible en esta instancia.') : pagos.length ? `${pagos.length} cobro${pagos.length === 1 ? '' : 's'} asociado${pagos.length === 1 ? '' : 's'} al caso.` : 'Todavia no hay pagos asociados al caso.')}</p>
        </article>`;
    }

    if (fichaProgressPanel) {
      const painHistoryHtml = painSeries.length
        ? painSeries.map((item: any) => `
          <article class="ficha-progress-point">
            <span>${escapeHtml(item.label)}</span>
            <strong>EVA ${escapeHtml(item.value)}/10</strong>
            <p>${escapeHtml(fmtDate(item.date))}</p>
          </article>`).join('')
        : '<p class="empty-inline">Aun no hay lecturas de dolor suficientes para mostrar evolucion.</p>';

      fichaProgressPanel.innerHTML = `
        <div class="ficha-progress-hero tone-${painTrend.tone}">
          <div class="ficha-progress-copy">
            <span class="ficha-progress-eyebrow">Estado global</span>
            <strong>${escapeHtml(painTrend.headline)}</strong>
            <p>${escapeHtml(painTrend.summary)}</p>
          </div>
          <span class="ficha-progress-pill tone-${painTrend.tone}">${escapeHtml(painTrend.headline)}</span>
        </div>
        <div class="ficha-progress-metrics">
          <article class="ficha-progress-metric">
            <span>Dolor actual</span>
            <strong>${latestPainSample ? `EVA ${escapeHtml(latestPainSample.value)}/10` : 'Sin dato'}</strong>
            <p>${escapeHtml(latestPainSample ? fmtDate(latestPainSample.date) : 'Sin registro clinico reciente')}</p>
          </article>
          <article class="ficha-progress-metric">
            <span>Adherencia</span>
            <strong>${escapeHtml(recommendationSummary.totalPlans ? latestAdherence.label : 'Sin plan IA')}</strong>
            <p>${escapeHtml(recommendationSummary.totalPlans ? (latestFollowUp?.created_at || latestFollowUp?.fecha ? `Ultimo feedback ${fmtDate(latestFollowUp?.created_at || latestFollowUp?.fecha)}` : 'Todavia sin respuesta del paciente') : 'Genera un plan para activar seguimiento domiciliario')}</p>
          </article>
          <article class="ficha-progress-metric">
            <span>Continuidad</span>
            <strong>${escapeHtml(continuityLabel)}</strong>
            <p>${escapeHtml(continuityMeta)}</p>
          </article>
        </div>
        <div class="ficha-progress-history">
          <div class="ficha-progress-history-head">
            <span class="ficha-progress-history-label">Evolucion reciente</span>
            <strong>${escapeHtml(painTrend.deltaLabel)}</strong>
          </div>
          <div class="ficha-progress-points">${painHistoryHtml}</div>
        </div>
        <article class="ficha-progress-next tone-${progressNextTone}">
          <span>Proximo paso clinico</span>
          <strong>${escapeHtml(progressNextTitle)}</strong>
          <p>${escapeHtml(progressNextMeta)}</p>
        </article>`;
    }

    if (fichaOverviewStream) {
      fichaOverviewStream.innerHTML = activityItems.length
        ? activityItems.map((item: any) => `
          <article class="ficha-stream-item ficha-stream-item-${item.type}">
            <div class="ficha-stream-icon"><span class="material-symbols-rounded">${item.type === 'nota' ? 'clinical_notes' : item.type === 'plan' ? 'assignment' : item.type === 'delivery' ? 'description' : item.type === 'followup' ? 'monitor_heart' : 'calendar_month'}</span></div>
            <div class="ficha-stream-copy">
              <span>${escapeHtml(item.label)}</span>
              <strong>${escapeHtml(item.title)}</strong>
              <p>${escapeHtml(item.meta)}</p>
            </div>
          </article>`).join('')
        : unavailableModules.length
          ? '<p class="empty-inline">La timeline se muestra en modo parcial hasta recuperar los modulos pendientes.</p>'
          : '<p class="empty-inline">La actividad del caso aparecera en cuanto registres una cita, una nota o un plan domiciliario.</p>';
    }

    if (fichaPlanInsights) {
      const latestPlan = recommendationSummary.latestRecommendation || null;
      const latestPlanDate = latestPlan?.created_at || latestPlan?.fecha || latestPlan?.updated_at || '';
      const adjustmentTitle = !recommendationSummary.totalPlans
        ? 'Generar plan'
        : recommendationSummary.totalArchivedReports && !recommendationSummary.totalFollowUps
          ? 'Pedir feedback'
          : painTrend.tone === 'alert'
            ? 'Ajustar carga'
            : recommendationSummary.totalFollowUps
              ? 'Progresar o mantener'
              : 'Archivar entrega';
      const adjustmentMeta = !recommendationSummary.totalPlans
        ? 'Aun no hay plan IA para este caso.'
        : recommendationSummary.totalArchivedReports && !recommendationSummary.totalFollowUps
          ? 'El paciente ya recibio el plan. Falta respuesta.'
          : painTrend.tone === 'alert'
            ? 'Dolor alto o tendencia desfavorable.'
            : recommendationSummary.totalFollowUps
              ? 'Hay feedback para decidir el siguiente ajuste.'
              : 'Deja constancia de PDF o envio al paciente.';
      const circuitSteps = [
        {
          label: 'Plan generado',
          action: 'generate-plan',
          actionLabel: recommendationSummary.totalPlans ? 'Actualizar plan' : 'Generar plan',
          done: Boolean(recommendationSummary.totalPlans),
          value: recommendationSummary.totalPlans ? `${recommendationSummary.totalPlans} plan${recommendationSummary.totalPlans === 1 ? '' : 'es'}` : 'Pendiente',
          meta: recommendationSummary.totalPlans
            ? `${recommendationSummary.totalExercises} ejercicios${latestPlanDate ? ` | ${fmtDate(latestPlanDate)}` : ''}`
            : 'Genera el primer plan desde el copiloto.',
        },
        {
          label: 'Entrega',
          action: 'delivery',
          actionLabel: 'Ver entregas',
          done: Boolean(recommendationSummary.totalArchivedReports),
          value: recommendationSummary.totalArchivedReports ? `${recommendationSummary.totalArchivedReports} archivada${recommendationSummary.totalArchivedReports === 1 ? '' : 's'}` : 'Sin entrega',
          meta: latestArchivedReport?.archived_at || latestArchivedReport?.created_at
            ? `Ultima ${fmtDate(latestArchivedReport?.archived_at || latestArchivedReport?.created_at)}`
            : 'Archiva PDF o envio para dejar trazabilidad.',
        },
        {
          label: 'Feedback',
          action: 'feedback',
          actionLabel: 'Registrar feedback',
          done: Boolean(recommendationSummary.totalFollowUps),
          value: recommendationSummary.totalFollowUps ? latestAdherence.label : 'Sin respuesta',
          meta: latestFollowUp?.pain_scale !== null && latestFollowUp?.pain_scale !== undefined
            ? `Dolor ${latestFollowUp.pain_scale}/10`
            : recommendationSummary.totalFollowUps
              ? 'Feedback registrado sin EVA.'
              : 'Falta adherencia, dolor o comentario.',
        },
        {
          label: 'Ajuste recomendado',
          action: 'adjust-plan',
          actionLabel: 'Aplicar ajuste',
          done: Boolean(recommendationSummary.totalPlans),
          value: adjustmentTitle,
          meta: adjustmentMeta,
        },
      ];
      fichaPlanInsights.innerHTML = recommendationSummary.totalPlans
        ? `
          <div class="ficha-ia-circuit">
            ${circuitSteps.map((step: any, index: number) => `
              <article class="ficha-ia-step ${step.done ? 'is-done' : 'is-pending'}">
                <span class="ficha-ia-step-index">${index + 1}</span>
                <div>
                  <span class="ficha-ia-step-label">${escapeHtml(step.label)}</span>
                  <strong>${escapeHtml(step.value)}</strong>
                  <p>${escapeHtml(step.meta)}</p>
                  <button type="button" class="btn-link-inline ficha-ia-step-action" data-ficha-ia-action="${escapeAttr(step.action)}">${escapeHtml(step.actionLabel)}</button>
                </div>
              </article>
            `).join('')}
          </div>`
        : `
          <div class="ficha-ia-circuit ficha-ia-circuit-empty">
            ${circuitSteps.map((step: any, index: number) => `
              <article class="ficha-ia-step is-pending">
                <span class="ficha-ia-step-index">${index + 1}</span>
                <div>
                  <span class="ficha-ia-step-label">${escapeHtml(step.label)}</span>
                  <strong>${escapeHtml(step.value)}</strong>
                  <p>${escapeHtml(step.meta)}</p>
                  <button type="button" class="btn-link-inline ficha-ia-step-action" data-ficha-ia-action="${escapeAttr(step.action)}">${escapeHtml(step.actionLabel)}</button>
                </div>
              </article>
            `).join('')}
          </div>`;
    }

    const decisions = [
      unavailableModules.length ? { tone: 'alert', title: 'Revisar migraciones pendientes', body: `La ficha esta operativa en modo parcial. Falta recuperar: ${unavailableModules.map((item: any) => item?.label || item?.key || 'modulo').join(', ')}.` } : null,
      recommendationSummary.totalPlans && !recommendationSummary.totalArchivedReports ? { tone: 'warm', title: 'Archivar la entrega del plan', body: 'Ya existe un plan IA, pero aun no hay constancia de entrega o PDF archivado en el historial.' } : null,
      recommendationSummary.totalPlans && !recommendationSummary.totalFollowUps ? { tone: 'ready', title: 'Registrar respuesta del paciente', body: 'El plan domiciliario ya existe. Falta dejar adherencia, dolor o ajustes para continuidad real.' } : null,
      !citasUnavailable && !citas.length ? { tone: 'urgent', title: 'Programar la primera sesion', body: 'Todavia no hay una cita registrada. La agenda debe ser el primer cierre operativo del caso.' } : null,
      !citasUnavailable && !notasUnavailable && citas.length && !notas.length ? { tone: 'warm', title: 'Documentar valoracion y evolucion', body: 'Ya existe actividad en agenda, pero falta una nota clinica que deje criterio terapeutico y siguiente paso.' } : null,
      !notasUnavailable && latestEva != null && latestEva >= 7 ? { tone: 'alert', title: 'EVA elevado', body: `Ultimo EVA: ${latestEva}/10.` } : null,
      !pagosUnavailable && !pagos.length ? { tone: 'soft', title: 'Sin pagos registrados', body: '' } : null,
      patient?.telefono ? { tone: 'ready', title: 'Telegram disponible', body: 'Telefono registrado.' } : { tone: 'soft', title: 'Sin telefono', body: 'Registra un telefono para habilitar Telegram.' },
    ].filter(Boolean).slice(0, 4) as Array<{ tone: string; title: string; body: string }>;

    if (fichaDecisionList) {
      fichaDecisionList.innerHTML = decisions.length
        ? decisions.map((item) => `
          <article class="ficha-decision-card tone-${item.tone}">
            <strong>${escapeHtml(item.title)}</strong>
            <p>${escapeHtml(item.body)}</p>
          </article>`).join('')
        : '<p class="empty-inline">Cuando exista mas contexto clinico, aqui veras la siguiente mejor accion sugerida para el caso.</p>';
    }

    let primaryAction: 'agenda' | 'notas' | 'agente' | 'historial' = 'agente';
    let primaryLabel = 'Informe IA';
    let nextTitle = unavailableModules.length ? 'Recuperar integridad del CRM' : 'Cerrar continuidad clinica';
    let nextMeta = unavailableModules.length
      ? 'Hay modulos de la ficha pendientes de migracion. Revisa readiness antes de tomar decisiones basadas en ausencia de datos.'
      : 'El caso ya tiene contexto suficiente para preparar siguiente sesion, actualizar plan o dejar PDF listo.';

    if (!citasUnavailable && !citas.length) {
      primaryAction = 'agenda';
      primaryLabel = 'Ir a agenda';
      nextTitle = 'Programar la primera sesion';
      nextMeta = 'Sin citas programadas.';
    } else if (!notasUnavailable && citas.length && !notas.length) {
      primaryAction = 'notas';
      primaryLabel = 'Abrir notas';
      nextTitle = 'Cerrar criterio terapeutico';
      nextMeta = 'Ya hay movimiento en agenda, pero falta dejar una nota clinica que convierta la sesion en seguimiento real.';
    } else if (recommendationSummary.totalPlans && !recommendationSummary.totalFollowUps) {
      primaryAction = 'historial';
      primaryLabel = 'Registrar feedback';
      nextTitle = 'Capturar adherencia del plan';
      nextMeta = 'El paciente ya tiene plan domiciliario, pero aun no hay respuesta registrada en el historial.';
    } else if (recommendationSummary.totalPlans && !recommendationSummary.totalArchivedReports) {
      primaryAction = 'historial';
      primaryLabel = 'Revisar entregas';
      nextTitle = 'Archivar la entrega domiciliaria';
      nextMeta = 'Hay un plan IA generado y conviene dejar trazabilidad del envio o PDF en el historial.';
    } else if (!notasUnavailable && latestEva != null && latestEva >= 7) {
      primaryAction = 'agente';
      primaryLabel = 'Checklist visita';
      nextTitle = 'Revisar dolor alto y ajustar plan';
      nextMeta = `EVA elevado (${latestEva}/10). Revisar plan de tratamiento.`;
    }

    if (fichaOpsRiskTitle) fichaOpsRiskTitle.textContent = unavailableModules.length ? 'Modo parcial' : painTrend.headline;
    if (fichaOpsRiskMeta) fichaOpsRiskMeta.textContent = unavailableModules.length
      ? `Faltan modulos: ${unavailableModules.map((item: any) => item?.label || item?.key || 'modulo').join(', ')}.`
      : painTrend.summary;
    if (fichaOpsNextTitle) fichaOpsNextTitle.textContent = nextTitle;
    if (fichaOpsNextMeta) fichaOpsNextMeta.textContent = nextMeta;
    if (fichaOpsPlanTitle) fichaOpsPlanTitle.textContent = recommendationSummary.totalPlans
      ? `${recommendationSummary.totalPlans} plan${recommendationSummary.totalPlans === 1 ? '' : 'es'} activo${recommendationSummary.totalPlans === 1 ? '' : 's'}`
      : 'Sin plan IA';
    if (fichaOpsPlanMeta) fichaOpsPlanMeta.textContent = recommendationSummary.totalPlans
      ? recommendationSummary.totalFollowUps
        ? `${recommendationSummary.totalFollowUps} seguimiento${recommendationSummary.totalFollowUps === 1 ? '' : 's'} con feedback registrado.`
        : 'Falta respuesta del paciente para medir adherencia.'
      : 'Genera un plan para activar continuidad domiciliaria.';
    if (fichaOpsBillingTitle) fichaOpsBillingTitle.textContent = pagosUnavailable ? 'Modulo no disponible' : `${totalPayments.toFixed(2)} EUR`;
    if (fichaOpsBillingMeta) fichaOpsBillingMeta.textContent = pagosUnavailable
      ? getFichaModuleMessage('pagos', 'Historial de pagos no disponible en esta instancia.')
      : pagos.length
        ? `${pagos.length} cobro${pagos.length === 1 ? '' : 's'} vinculado${pagos.length === 1 ? '' : 's'} al caso.`
        : 'Sin cobros asociados todavia.';
    fichaOpsRiskTitle?.closest('.ficha-command-card')?.setAttribute('data-tone', unavailableModules.length ? 'alert' : painTrend.tone);
    fichaOpsNextTitle?.closest('.ficha-command-card')?.setAttribute('data-tone', primaryAction === 'agenda' ? 'warm' : primaryAction === 'historial' ? 'ready' : painTrend.tone);
    fichaOpsPlanTitle?.closest('.ficha-command-card')?.setAttribute('data-tone', recommendationSummary.totalPlans ? (recommendationSummary.totalFollowUps ? 'ready' : 'warm') : 'soft');
    fichaOpsBillingTitle?.closest('.ficha-command-card')?.setAttribute('data-tone', pagos.length ? 'ready' : 'soft');

    if (fichaRailNextTitle) fichaRailNextTitle.textContent = nextTitle;
    if (fichaRailNextMeta) fichaRailNextMeta.textContent = nextMeta;
    if (fichaRailPrimaryBtn) {
      fichaRailPrimaryBtn.dataset.caseAction = primaryAction;
      fichaRailPrimaryBtn.innerHTML = `<span class="material-symbols-rounded">${primaryAction === 'agenda' ? 'calendar_today' : primaryAction === 'notas' ? 'clinical_notes' : primaryAction === 'historial' ? 'history' : 'exercise'}</span> ${primaryLabel}`;
    }
    if (fichaRailTelegramBtn) fichaRailTelegramBtn.disabled = !Boolean(fichaPatientId);

    if (fichaRailChannels) {
      const channelItems = [
        { icon: 'mail', label: 'Email', value: patient?.email ? 'Listo' : 'Falta', tone: patient?.email ? 'ready' : 'pending' },
        { icon: 'call', label: 'Telefono', value: patient?.telefono ? 'Listo' : 'Falta', tone: patient?.telefono ? 'ready' : 'pending' },
        { icon: 'send', label: 'Telegram', value: patient?.telefono ? 'Preparar' : 'Completar telefono', tone: patient?.telefono ? 'ready' : 'pending' },
      ];
      fichaRailChannels.innerHTML = channelItems.map((item) => `
        <article class="ficha-channel-item is-${item.tone}">
          <span class="material-symbols-rounded">${item.icon}</span>
          <div><strong>${escapeHtml(item.label)}</strong><p>${escapeHtml(item.value)}</p></div>
        </article>`).join('');
    }

    if (fichaRailChecklist) {
      const checks = [
        { done: Boolean(patient?.email || patient?.telefono), title: 'Contacto localizado', body: patient?.email || patient?.telefono ? 'El caso ya tiene una via de contacto guardada.' : 'Falta email o telefono para continuidad.' },
        { done: !citasUnavailable && Boolean(citas.length), title: 'Agenda registrada', body: citasUnavailable ? getFichaModuleMessage('citas', 'Historial de citas no disponible en esta instancia.') : citas.length ? `${citas.length} cita${citas.length === 1 ? '' : 's'} asociada${citas.length === 1 ? '' : 's'} al caso.` : 'Todavia no hay citas asociadas al paciente.' },
        { done: !notasUnavailable && Boolean(notas.length), title: 'Seguimiento documentado', body: notasUnavailable ? getFichaModuleMessage('notas', 'Notas clinicas no disponibles en esta instancia.') : notas.length ? `${notas.length} nota${notas.length === 1 ? '' : 's'} registrada${notas.length === 1 ? '' : 's'}.` : 'Sin notas de evolucion.' },
        { done: Boolean(recommendationSummary.totalPlans), title: 'Plan domiciliario generado', body: recommendationSummary.totalPlans ? `${recommendationSummary.totalPlans} plan${recommendationSummary.totalPlans === 1 ? '' : 'es'} IA activo${recommendationSummary.totalPlans === 1 ? '' : 's'} en historial.` : 'Aun no hay plan domiciliario generado para este caso.' },
        { done: Boolean(recommendationSummary.totalFollowUps), title: 'Feedback del plan', body: recommendationSummary.totalFollowUps ? `${recommendationSummary.totalFollowUps} seguimiento${recommendationSummary.totalFollowUps === 1 ? '' : 's'} con adherencia o dolor registrado.` : 'Falta registrar la respuesta del paciente al plan domiciliario.' },
        { done: !pagosUnavailable && Boolean(pagos.length), title: 'Cobro vinculado', body: pagosUnavailable ? getFichaModuleMessage('pagos', 'Historial de pagos no disponible en esta instancia.') : pagos.length ? `${pagos.length} movimiento${pagos.length === 1 ? '' : 's'} economico${pagos.length === 1 ? '' : 's'} asociado${pagos.length === 1 ? '' : 's'} al caso.` : 'No hay pagos ni bonos vinculados todavia.' },
      ];
      const doneCount = checks.filter((item) => item.done).length;
      const pendingChecks = checks.filter((item) => !item.done);
      fichaRailChecklist.innerHTML = `
        <article class="ficha-check-summary">
          <strong>${doneCount}/${checks.length}</strong>
          <span>${pendingChecks.length ? `${pendingChecks.length} pendiente${pendingChecks.length === 1 ? '' : 's'}` : 'Caso al dia'}</span>
        </article>
        ${pendingChecks.length
          ? pendingChecks.slice(0, 3).map((item) => `
            <article class="ficha-check-item is-pending">
              <span class="ficha-check-dot"></span>
              <div class="ficha-check-copy">
                <strong>${escapeHtml(item.title)}</strong>
                <p>${escapeHtml(item.body)}</p>
              </div>
            </article>`).join('')
          : '<p class="empty-inline">No hay bloqueos operativos prioritarios.</p>'}`;
    }
  };

  const renderFichaHero = (payload: any) => {
    const patient = payload?.paciente || {};
    const citas = Array.isArray(payload?.citas) ? payload.citas : [];
    const pagos = Array.isArray(payload?.pagos) ? payload.pagos : [];
    const notas = Array.isArray(payload?.notas) ? payload.notas : [];
    const citasUnavailable = isFichaModuleUnavailable('citas');
    const pagosUnavailable = isFichaModuleUnavailable('pagos');
    const notasUnavailable = isFichaModuleUnavailable('notas');
    const patientName = getPatientFullName(patient);
    const ageLabel = getPatientAgeLabel(patient?.fecha_nacimiento);
    const latestAppointment = citasUnavailable ? null : getFichaLatestAppointment(citas);
    const latestNote = notasUnavailable ? null : (notas[0] || null);
    const totalPayments = pagosUnavailable ? 0 : pagos.reduce((sum: number, payment: any) => sum + Number(payment?.importe || 0), 0);
    const continuityLabel = latestNote
      ? 'Caso con seguimiento activo'
      : citas.length
        ? 'Caso listo para reactivar'
        : 'Primera valoracion pendiente';
    const continuityMeta = latestNote
      ? 'Tienes contexto clinico para iterar con el agente, documentar y programar la siguiente sesion.'
      : citas.length
        ? 'Revisar historial y documentos del caso.'
        : 'Buen momento para capturar antecedentes, objetivo clinico y primer plan de ejercicios.';

    if (fichaHeroName) fichaHeroName.textContent = patientName;
    if (fichaHeroSummary) {
      const bits = [patient?.email || '', patient?.telefono || '', ageLabel].filter(Boolean);
      fichaHeroSummary.textContent = bits.length
        ? bits.join(' | ')
        : 'Completa datos, continuidad clinica y proximas acciones desde una sola vista.';
    }
    if (fichaHeroEmail) fichaHeroEmail.textContent = patient?.email || 'Sin email registrado';
    if (fichaHeroPhone) fichaHeroPhone.textContent = patient?.telefono || 'Sin telefono registrado';
    if (fichaHeroProfile) {
      const profileBits = [ageLabel ? `Edad ${ageLabel}` : null, patient?.profesion || null].filter(Boolean);
      fichaHeroProfile.textContent = profileBits.length
        ? profileBits.join(' - ')
        : patient?.medico_derivador
          ? `Derivador ${patient.medico_derivador}`
          : 'Sin datos clave';
    }
    if (fichaHeroLastSession) fichaHeroLastSession.textContent = citasUnavailable ? 'Historial no disponible' : latestAppointment?.fecha_hora ? fmtDate(latestAppointment.fecha_hora) : 'Sin citas registradas';
    if (fichaHeroLastSessionMeta) fichaHeroLastSessionMeta.textContent = citasUnavailable ? getFichaModuleMessage('citas', 'Historial de citas no disponible en esta instancia.') : latestAppointment?.motivo || 'Todavia no hay actividad clinica registrada.';
    if (fichaHeroNotesCount) fichaHeroNotesCount.textContent = notasUnavailable ? 'Modulo no disponible' : `${notas.length} nota${notas.length === 1 ? '' : 's'}`;
    if (fichaHeroLatestNote) fichaHeroLatestNote.textContent = notasUnavailable ? getFichaModuleMessage('notas', 'Notas clinicas no disponibles en esta instancia.') : latestNote?.nota ? trimAgentBriefText(latestNote.nota, 140) : 'La linea temporal del caso aparecera aqui cuando empieces a registrar seguimiento.';
    if (fichaHeroPaymentsTotal) fichaHeroPaymentsTotal.textContent = pagosUnavailable ? 'Modulo no disponible' : `${totalPayments.toFixed(2)} EUR`;
    if (fichaHeroPaymentsMeta) fichaHeroPaymentsMeta.textContent = pagosUnavailable ? getFichaModuleMessage('pagos', 'Historial de pagos no disponible en esta instancia.') : pagos.length ? `${pagos.length} pago${pagos.length === 1 ? '' : 's'} registrado${pagos.length === 1 ? '' : 's'} en el caso.` : 'Sin pagos registrados todavia.';
    if (fichaHeroContinuity) fichaHeroContinuity.textContent = fichaModuleAvailability.size ? 'Vista parcial del caso' : continuityLabel;
    if (fichaHeroContinuityMeta) fichaHeroContinuityMeta.textContent = fichaModuleAvailability.size ? 'Hay modulos del CRM pendientes de migracion. La ficha sigue disponible, pero con datos parciales.' : continuityMeta;
  };

  fichaHeroCopilotBtn?.addEventListener('click', () => {
    openExerciseReportAssistant({
      patientId: fichaPatientId,
      patientName: fichaData?.paciente?.nombre_completo || getPatientFullName(fichaData?.paciente || {}),
      mode: 'new-plan',
      seedText: 'Preparar informe de ejercicios domiciliarios para este caso. Revisa objetivo, tolerancia, contraindicaciones y progresion segura.',
    });
  });

  fichaHeroAgendaBtn?.addEventListener('click', () => {
    navigateTo('citas');
  });

  fichaHeroDocsBtn?.addEventListener('click', () => {
    activateFichaTab('documentos');
  });

  pagosMobileList?.addEventListener('click', async (event: Event) => {
    if (pagosUnavailableMessage) { showToast(pagosUnavailableMessage, 'warning'); return; }
    const btn = (event.target as HTMLElement).closest('button[data-action]') as HTMLButtonElement | null;
    if (!btn) return;
    const action = btn.getAttribute('data-action');
    const pagoId = btn.getAttribute('data-pago-id');
    if (!pagoId) return;

    if (action === 'edit-pago') {
      const card = btn.closest('article[data-pago]');
      const raw = card?.getAttribute('data-pago');
      if (!raw) return;
      try {
        const pago = JSON.parse(raw);
        await openPagoModal(pago);
      } catch {
        showToast('No pude cargar el pago seleccionado.', 'error');
      }
      return;
    }

    if (action === 'delete-pago') {
      const confirmed = await requestConfirm({
        title: 'Eliminar pago',
        message: 'Este pago desaparecera del historial financiero. La accion no se puede deshacer.',
        confirmLabel: 'Eliminar',
        tone: 'error',
      });
      if (!confirmed) return;
      try {
        await fetchJson(`${BACKEND_BASE}/api/pagos/${pagoId}`, { method: 'DELETE' });
        showToast('Pago eliminado correctamente.', 'success');
        await loadPagos();
      } catch (err: any) {
        showToast(err?.message || 'No se pudo eliminar el pago.', 'error');
      }
    }
  });

  fichaOpsAgendarBtn?.addEventListener('click', () => {
    navigateTo('citas');
  });

  fichaOpsNotaBtn?.addEventListener('click', () => {
    activateFichaTab('notas');
  });

  fichaOpsHistoriaBtn?.addEventListener('click', () => {
    if (!fichaPatientId) return;
    pendingHistoryAnchor = 'recommendations';
    openPatientHistory(fichaPatientId, selectedPatientName || getPatientFullName(fichaData?.paciente || {}));
  });

  fichaOpsCopilotBtn?.addEventListener('click', () => {
    openExerciseReportAssistant({
      patientId: fichaPatientId,
      patientName: fichaData?.paciente?.nombre_completo || getPatientFullName(fichaData?.paciente || {}),
      mode: 'new-plan',
      seedText: 'Generar o progresar informe IA de ejercicios desde la ficha del paciente.',
    });
  });

  fichaRailPrimaryBtn?.addEventListener('click', () => {
    const action = (fichaRailPrimaryBtn.dataset.caseAction || 'agente') as 'agenda' | 'notas' | 'agente' | 'historial';
    if (action === 'agenda') {
      navigateTo('citas');
      return;
    }
    if (action === 'notas') {
      activateFichaTab('notas');
      return;
    }
    if (action === 'historial') {
      if (!fichaPatientId) return;
      pendingHistoryAnchor = 'recommendations';
      openPatientHistory(fichaPatientId, selectedPatientName || getPatientFullName(fichaData?.paciente || {}));
      return;
    }
    openExerciseReportAssistant({
      patientId: fichaPatientId,
      patientName: fichaData?.paciente?.nombre_completo || getPatientFullName(fichaData?.paciente || {}),
      mode: 'new-plan',
      seedText: 'Preparar informe IA de ejercicios como siguiente accion del caso.',
    });
  });

  fichaRailTelegramBtn?.addEventListener('click', () => {
    if (!fichaPatientId) return;
    pendingHistoryAnchor = 'telegram';
    openPatientHistory(fichaPatientId, selectedPatientName || getPatientFullName(fichaData?.paciente || {}));
  });

  const runFichaIaAction = (action: string) => {
    if (!fichaPatientId) return;
    const patientName = selectedPatientName || getPatientFullName(fichaData?.paciente || {});
    if (action === 'generate-plan') {
      syncChatPatientSelection(fichaPatientId, patientName);
      requestOpenAssistantRail();
      setAssistantMode('new-plan', { focus: true });
      return;
    }
    if (action === 'delivery' || action === 'feedback') {
      pendingHistoryAnchor = 'recommendations';
      openPatientHistory(fichaPatientId, patientName);
      return;
    }
    if (action === 'adjust-plan') {
      syncChatPatientSelection(fichaPatientId, patientName);
      requestOpenAssistantRail();
      setAssistantMode('update-plan', { focus: true });
    }
  };

  fichaPlanInsights?.addEventListener('click', (event) => {
    const target = event.target as HTMLElement | null;
    const button = target?.closest('button[data-ficha-ia-action]') as HTMLButtonElement | null;
    if (!button) return;
    runFichaIaAction(String(button.getAttribute('data-ficha-ia-action') || '').trim());
  });

  // Tab switching
  document.querySelectorAll('.ficha-tab').forEach((tab) => {
    tab.addEventListener('click', () => {
      activateFichaTab(tab.getAttribute('data-ficha-tab') || 'resumen');
    });
  });

  const openFichaPaciente = async (patientId: string) => {
    fichaPatientId = patientId;
    syncFichaAvailabilityUi([]);
    // Switch to ficha page
    document.querySelectorAll('.page-section').forEach(s => s.classList.remove('active'));
    document.querySelector('[data-page="ficha-paciente"]')?.classList.add('active');
    // Reset to first tab
    activateFichaTab('resumen');
    // Hide edit form, show view
    if (fichaDatosForm) fichaDatosForm.hidden = true;
    if (fichaDatosView) fichaDatosView.hidden = false;
    if (fichaNotaFormCard) fichaNotaFormCard.hidden = true;

    // Load data
    try {
      const [payload, recommendationsResp] = await Promise.all([
        fetchJson(`${BACKEND_BASE}/api/pacientes/${patientId}/ficha`),
        fetchJson(`${BACKEND_BASE}/api/exercises/recommendations/${patientId}?limit=25`).catch(() => ({ data: [] })),
      ]);
      payload.recommendations = Array.isArray(recommendationsResp?.data) ? recommendationsResp.data : [];
      fichaData = payload;
      selectedPatientId = patientId;
      selectedPatientName = getPatientFullName(payload.paciente);
      syncFichaAvailabilityUi(payload?.module_availability || []);
      renderFichaHero(payload);
      renderFichaWorkspace(payload);
      renderFichaDatos(payload.paciente);
      renderFichaCitas(payload.citas);
      renderFichaPagos(payload.pagos);
      renderFichaNotas(payload.notas);
      if (fichaTitulo) fichaTitulo.innerHTML = `<span class="material-symbols-rounded">person</span> ${escapeHtml(payload.paciente.nombre_completo || 'Paciente')}`;
    } catch (err: any) {
      syncFichaAvailabilityUi([]);
      if (fichaDatosView) fichaDatosView.innerHTML = `<p class="empty-inline">Error al cargar ficha: ${escapeHtml(err?.message || '')}</p>`;
    }
  };

  const fichaField = (label: string, value: string, full = false) =>
    `<div class="ficha-dato${full ? ' ficha-dato-full' : ''}"><span class="ficha-dato-label">${escapeHtml(label)}</span><span class="ficha-dato-value">${escapeHtml(value || '')}</span></div>`;

  const fichaDataGroup = (eyebrow: string, title: string, items: string[]) => `
    <article class="ficha-data-card">
      <div class="ficha-data-card-head">
        <span>${escapeHtml(eyebrow)}</span>
        <strong>${escapeHtml(title)}</strong>
      </div>
      <div class="ficha-data-card-grid">${items.join('')}</div>
    </article>`;

  const renderFichaDatos = (p: any) => {
    if (!fichaDatosView) return;
    fichaDatosView.innerHTML = [
      fichaDataGroup('Identidad', 'Perfil del paciente', [
        fichaField('Nombre', p.nombre),
        fichaField('Apellidos', p.apellidos),
        fichaField('Email', p.email),
        fichaField('Telefono', p.telefono),
        fichaField('DNI/NIF', p.dni),
        fichaField('Fecha nac.', p.fecha_nacimiento ? fmtDate(p.fecha_nacimiento) : ''),
      ]),
      fichaDataGroup('Contexto', 'Entorno personal y laboral', [
        fichaField('Direccion', p.direccion),
        fichaField('Profesion', p.profesion),
        fichaField('Medico derivador', p.medico_derivador),
        fichaField('Aseguradora', p.aseguradora),
      ]),
      fichaDataGroup('Historia clinica', 'Alertas y antecedentes', [
        fichaField('Alergias', p.alergias, true),
        fichaField('Antecedentes', p.antecedentes, true),
        fichaField('Observaciones', p.observaciones, true),
      ]),
    ].join('');
  };

  // Edit toggle
  fichaEditToggle?.addEventListener('click', () => {
    if (!fichaData?.paciente || !fichaDatosForm) return;
    const p = fichaData.paciente;
    if (fichaDatosView) fichaDatosView.hidden = true;
    fichaDatosForm.hidden = false;
    const fill = (name: string, val: string) => {
      const el = fichaDatosForm.querySelector(`[name="${name}"]`) as HTMLInputElement | HTMLTextAreaElement | null;
      if (el) el.value = val || '';
    };
    fill('nombre', p.nombre); fill('apellidos', p.apellidos); fill('email', p.email);
    fill('telefono', p.telefono); fill('dni', p.dni); fill('fecha_nacimiento', p.fecha_nacimiento);
    fill('direccion', p.direccion); fill('profesion', p.profesion);
    fill('medico_derivador', p.medico_derivador); fill('aseguradora', p.aseguradora);
    fill('alergias', p.alergias); fill('antecedentes', p.antecedentes); fill('observaciones', p.observaciones);
  });

  fichaCancelEdit?.addEventListener('click', () => {
    if (fichaDatosForm) fichaDatosForm.hidden = true;
    if (fichaDatosView) fichaDatosView.hidden = false;
  });

  fichaDatosForm?.addEventListener('submit', async (e: Event) => {
    e.preventDefault();
    if (!fichaPatientId) return;
    const fd = new FormData(fichaDatosForm);
    const body: any = {};
    for (const [k, v] of fd.entries()) body[k] = (v as string) || null;
    try {
      await fetchJson(`${BACKEND_BASE}/api/pacientes/${fichaPatientId}`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
      });
      // Reload ficha
      await openFichaPaciente(fichaPatientId);
      showToast('Datos del paciente actualizados.', 'success');
    } catch (err: any) {
      showToast(err?.message || 'No se pudieron guardar los datos del paciente.', 'error');
    }
  });

  // Render citas
  const renderFichaCitas = (citas: any[]) => {
    if (!fichaCitasBody) return;
    const citasUnavailable = isFichaModuleUnavailable('citas');
    if (fichaCitasSummary) {
      if (citasUnavailable) {
        fichaCitasSummary.innerHTML = `<span class="ficha-summary-chip">Modulo no disponible</span>`;
      } else {
        const nextCita = [...citas]
          .filter((c: any) => c?.fecha_hora)
          .sort((a: any, b: any) => new Date(a.fecha_hora).getTime() - new Date(b.fecha_hora).getTime())[0] || null;
        fichaCitasSummary.innerHTML = `
          <span class="ficha-summary-chip"><strong>${citas.length}</strong> sesion${citas.length === 1 ? '' : 'es'}</span>
          <span class="ficha-summary-chip">${escapeHtml(nextCita?.fecha_hora ? `Ultima o proxima: ${fmtDate(nextCita.fecha_hora)}` : 'Sin agenda registrada')}</span>`;
      }
    }
    if (citasUnavailable) {
      fichaCitasBody.innerHTML = renderFichaUnavailableRow('cloud_off', 3, getFichaModuleMessage('citas', 'Historial de citas no disponible en esta instancia.'));
      return;
    }
    if (!citas.length) {
      fichaCitasBody.innerHTML = '<tr class="empty-row"><td colspan="3"><div class="empty-state"><span class="material-symbols-rounded">event_busy</span><p>Sin citas registradas</p><small class="empty-state-hint">Programa la primera sesion para iniciar continuidad clinica y trazabilidad.</small></div></td></tr>';
      return;
    }
    fichaCitasBody.innerHTML = citas.map((c: any) => {
      const estado = c.estado || 'pendiente';
      const fecha = c.fecha_hora ? fmtDate(c.fecha_hora) : '?';
      return `<tr>
        <td>
          <div class="ficha-table-primary">${fecha}</div>
        </td>
        <td><span class="status-chip ${estado}">${estado}</span></td>
        <td>
          <div class="ficha-table-primary">${escapeHtml(c.motivo || 'Sin motivo')}</div>
          <div class="ficha-table-meta">${escapeHtml(c.canal_origen || c.canal || 'Canal CRM')}</div>
        </td>
      </tr>`;
    }).join('');
  };

  // Render pagos
  const renderFichaPagos = (pagos: any[]) => {
    if (!fichaPagosBody) return;
    const pagosUnavailable = isFichaModuleUnavailable('pagos');
    const total = pagos.reduce((s: number, p: any) => s + Number(p.importe || 0), 0);
    const tarjeta = pagos.filter((p: any) => p.metodo_pago === 'tarjeta').length;
    const efectivo = pagos.filter((p: any) => p.metodo_pago === 'efectivo').length;
    if (fichaPagosSummary) {
      fichaPagosSummary.innerHTML = pagosUnavailable
        ? `<span class="ficha-summary-chip">Modulo no disponible</span>`
        : `
        <span class="ficha-summary-chip"><strong>${pagos.length}</strong> cobro${pagos.length === 1 ? '' : 's'}</span>
        <span class="ficha-summary-chip"><strong>${total.toFixed(2)} EUR</strong> total</span>
        <span class="ficha-summary-chip">${tarjeta} tarjeta</span>
        <span class="ficha-summary-chip">${efectivo} efectivo</span>`;
    }
    if (pagosUnavailable) {
      fichaPagosBody.innerHTML = renderFichaUnavailableRow('cloud_off', 4, getFichaModuleMessage('pagos', 'Historial de pagos no disponible en esta instancia.'));
      if (fichaPagosTotal) fichaPagosTotal.textContent = '';
      return;
    }
    if (!pagos.length) {
      fichaPagosBody.innerHTML = '<tr class="empty-row"><td colspan="4"><div class="empty-state"><span class="material-symbols-rounded">payments</span><p>Sin pagos registrados</p><small class="empty-state-hint">Cuando registres un cobro o bono, el resumen economico del caso se actualizara aqui.</small></div></td></tr>';
      if (fichaPagosTotal) fichaPagosTotal.textContent = '';
      return;
    }
    fichaPagosBody.innerHTML = pagos.map((p: any) => {
      const metodoClass = p.metodo_pago === 'tarjeta' ? 'pagos-stat-card' : 'pagos-stat-cash';
      return `<tr>
        <td><div class="ficha-table-primary">${fmtDate(p.fecha)}</div></td>
        <td><strong>${Number(p.importe).toFixed(2)} EUR</strong></td>
        <td><span class="${metodoClass} ficha-payment-method">${escapeHtml(p.metodo_pago || 'pendiente')}</span></td>
        <td>
          <div class="ficha-table-primary">${escapeHtml(p.concepto || 'Sesion')}</div>
          <div class="ficha-table-meta">${escapeHtml(p.notas || 'Movimiento asociado al caso')}</div>
        </td>
      </tr>`;
    }).join('');
    if (fichaPagosTotal) fichaPagosTotal.textContent = `Total: ${total.toFixed(2)} EUR`;
  };

  // Render notas clinicas (timeline)
  const evaClass = (v: number) => v <= 3 ? 'eva-low' : v <= 6 ? 'eva-mid' : 'eva-high';
  const zonaLabels: Record<string, string> = {
    cervical: 'Cervical', espalda: 'Espalda', hombro_brazo: 'Hombro/Brazo',
    codo_mano: 'Codo/Mano', cadera: 'Cadera', rodilla: 'Rodilla',
    tobillo_pie: 'Tobillo/Pie', abdomen_core: 'Abdomen/Core',
    suelo_pelvico: 'Suelo pelvico', general: 'General',
  };

  const renderFichaNotas = (notas: any[]) => {
    if (!fichaNotasTimeline) return;
    const notasUnavailable = isFichaModuleUnavailable('notas');
    const notasOrdenadas = [...notas].sort((a: any, b: any) => new Date(b.fecha || '').getTime() - new Date(a.fecha || '').getTime());
    const latestNote = notasOrdenadas[0] || null;
    const highPainCount = notasOrdenadas.filter((n: any) => Number(n?.dolor_eva || 0) >= 7).length;
    if (fichaNotasSummary) {
      fichaNotasSummary.innerHTML = notasUnavailable
        ? `<span class="ficha-summary-chip">Modulo no disponible</span>`
        : `
        <span class="ficha-summary-chip"><strong>${notasOrdenadas.length}</strong> nota${notasOrdenadas.length === 1 ? '' : 's'}</span>
        <span class="ficha-summary-chip">${escapeHtml(latestNote?.fecha ? `Ultima: ${fmtDate(latestNote.fecha)}` : 'Sin seguimiento')}</span>
        <span class="ficha-summary-chip">${highPainCount} EVA alto</span>`;
    }
    if (notasUnavailable) {
      fichaNotasTimeline.innerHTML = renderFichaUnavailableInline(getFichaModuleMessage('notas', 'Notas clinicas no disponibles en esta instancia.'));
      return;
    }
    if (!notasOrdenadas.length) {
      fichaNotasTimeline.innerHTML = '<p class="empty-inline">Sin notas clinicas registradas. Crea la primera para dejar criterio terapeutico y evolucion.</p>';
      return;
    }
    fichaNotasTimeline.innerHTML = notasOrdenadas.map((n: any) => {
      const zonaLabel = zonaLabels[n.zona_corporal] || n.zona_corporal || '';
      const evaHtml = n.dolor_eva != null ? `<span class="ficha-nota-eva ${evaClass(n.dolor_eva)}">EVA ${n.dolor_eva}/10</span>` : '';
      const zonaHtml = zonaLabel ? `<span class="ficha-nota-zona">${escapeHtml(zonaLabel)}</span>` : '';
      const pruebasHtml = n.pruebas_realizadas ? `<div class="ficha-nota-pruebas"><strong>Pruebas</strong><p>${escapeHtml(n.pruebas_realizadas)}</p></div>` : '';
      return `<div class="ficha-nota-card">
        <div class="ficha-nota-actions">
          <button title="Editar" data-action="edit-nota" data-nota-id="${n.id}"><span class="material-symbols-rounded ficha-note-action-icon">edit</span></button>
          <button title="Eliminar" data-action="delete-nota" data-nota-id="${n.id}"><span class="material-symbols-rounded ficha-note-action-icon">delete</span></button>
        </div>
        <div class="ficha-nota-header">
          <div class="ficha-nota-headline">
            <span class="ficha-nota-date">${fmtDate(n.fecha)}</span>
            <div class="ficha-nota-chips">${zonaHtml}${evaHtml}</div>
          </div>
        </div>
        <div class="ficha-nota-text">${escapeHtml(n.nota)}</div>
        ${pruebasHtml}
      </div>`;
    }).join('');
  };

  // Nota actions (add / edit / delete)
  fichaAddNota?.addEventListener('click', () => {
    if (!fichaNotaFormCard || !fichaNotaForm) return;
    fichaNotaForm.reset();
    const notaIdInput = fichaNotaForm.querySelector('[name="nota_id"]') as HTMLInputElement;
    if (notaIdInput) notaIdInput.value = '';
    const fechaInput = fichaNotaForm.querySelector('[name="fecha"]') as HTMLInputElement;
    if (fechaInput) fechaInput.value = new Date().toISOString().slice(0, 10);
    if (fichaNotaFormTitle) fichaNotaFormTitle.textContent = 'Nueva nota clinica';
    fichaNotaFormCard.hidden = false;
    fichaNotaFormCard.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  });

  fichaNotaCancel?.addEventListener('click', () => {
    if (fichaNotaFormCard) fichaNotaFormCard.hidden = true;
  });

  fichaNotaForm?.addEventListener('submit', async (e: Event) => {
    e.preventDefault();
    if (!fichaPatientId) return;
    const fd = new FormData(fichaNotaForm);
    const notaId = fd.get('nota_id') as string;
    const body: any = {
      paciente_id: fichaPatientId,
      fecha: fd.get('fecha') || new Date().toISOString().slice(0, 10),
      zona_corporal: fd.get('zona_corporal') || null,
      dolor_eva: fd.get('dolor_eva') ? Number(fd.get('dolor_eva')) : null,
      nota: fd.get('nota') as string,
      pruebas_realizadas: fd.get('pruebas_realizadas') || null,
    };
    try {
      if (notaId) {
        await fetchJson(`${BACKEND_BASE}/api/notas-clinicas/${notaId}`, {
          method: 'PATCH', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body),
        });
      } else {
        await fetchJson(`${BACKEND_BASE}/api/notas-clinicas`, {
          method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body),
        });
      }
      if (fichaNotaFormCard) fichaNotaFormCard.hidden = true;
      const notasPayload = await fetchJson(`${BACKEND_BASE}/api/notas-clinicas?paciente_id=${fichaPatientId}`);
      if (fichaData) fichaData.notas = notasPayload.data || [];
      renderFichaHero(fichaData || {});
      renderFichaWorkspace(fichaData || {});
      renderFichaNotas(fichaData?.notas || []);
      showToast('Nota clinica guardada.', 'success');
    } catch (err: any) {
      showToast(err?.message || 'No se pudo guardar la nota.', 'error');
    }
  });

  // Delegate nota edit/delete clicks
  fichaNotasTimeline?.addEventListener('click', async (e: Event) => {
    const target = e.target as HTMLElement;
    const btn = target.closest('button[data-action]') as HTMLButtonElement | null;
    if (!btn) return;
    const action = btn.getAttribute('data-action');
    const notaId = btn.getAttribute('data-nota-id');
    if (!notaId || !fichaPatientId) return;

    if (action === 'delete-nota') {
      const confirmed = await requestConfirm({
        title: 'Eliminar nota clinica',
        message: 'La nota se eliminara del seguimiento del paciente.',
        confirmLabel: 'Eliminar',
        tone: 'error',
      });
      if (!confirmed) return;
      try {
        await fetchJson(`${BACKEND_BASE}/api/notas-clinicas/${notaId}`, { method: 'DELETE' });
        const notasPayload = await fetchJson(`${BACKEND_BASE}/api/notas-clinicas?paciente_id=${fichaPatientId}`);
        if (fichaData) fichaData.notas = notasPayload.data || [];
        renderFichaHero(fichaData || {});
        renderFichaWorkspace(fichaData || {});
        renderFichaNotas(fichaData?.notas || []);
        showToast('Nota clinica eliminada.', 'success');
      } catch (err: any) {
        showToast(err?.message || 'No se pudo eliminar la nota.', 'error');
      }
    }

    if (action === 'edit-nota') {
      const nota = fichaData?.notas?.find((n: any) => n.id === notaId);
      if (!nota || !fichaNotaForm || !fichaNotaFormCard) return;
      fichaNotaForm.reset();
      const fill = (name: string, val: string) => {
        const el = fichaNotaForm.querySelector(`[name="${name}"]`) as HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement | null;
        if (el) el.value = val || '';
      };
      fill('nota_id', nota.id);
      fill('fecha', nota.fecha);
      fill('zona_corporal', nota.zona_corporal);
      fill('dolor_eva', nota.dolor_eva != null ? String(nota.dolor_eva) : '');
      fill('nota', nota.nota);
      fill('pruebas_realizadas', nota.pruebas_realizadas);
      if (fichaNotaFormTitle) fichaNotaFormTitle.textContent = 'Editar nota clinica';
      fichaNotaFormCard.hidden = false;
      fichaNotaFormCard.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }
  });

  // Back button
  document.getElementById('fichaBackBtn')?.addEventListener('click', () => {
    navigateTo('pacientes');
  });

  // Intercept view-patient action to open ficha
  pacientesBody?.addEventListener('click', (event: Event) => {
    const target = event.target as HTMLElement | null;
    const btn = target?.closest('button[data-action="view-patient"]') as HTMLButtonElement | null;
    if (!btn) return;
    const patientId = btn.getAttribute('data-patient-id');
    if (patientId) {
      event.stopPropagation();
      openFichaPaciente(patientId);
    }
  }, true); // capture phase to intercept before existing handler

  // ===================== FACTURACION =====================
  const facturasBody = document.getElementById('facturasBody') as HTMLElement | null;
  const facturasAnioFilter = document.getElementById('facturasAnioFilter') as HTMLSelectElement | null;
  const facturaModal = document.getElementById('facturaModal');
  const facturaForm = document.getElementById('facturaForm') as HTMLFormElement | null;
  const facturaPacienteSelect = document.getElementById('facturaPacienteSelect') as HTMLSelectElement | null;
  const facturaIvaPct = document.getElementById('facturaIvaPct') as HTMLSelectElement | null;
  const facturaNotas = document.getElementById('facturaNotas') as HTMLTextAreaElement | null;
  const facturaPreview = document.getElementById('facturaPreview');
  const facturaFeedback = document.getElementById('facturaFeedback') as HTMLElement | null;
  const facturaSubmitBtn = document.getElementById('facturaSubmitBtn') as HTMLButtonElement | null;
  const nuevaFacturaBtn = document.getElementById('nuevaFacturaBtn') as HTMLButtonElement | null;
  const refreshFacturasBtn = document.getElementById('refreshFacturas') as HTMLButtonElement | null;
  const facturaAvailabilityNotice = document.getElementById('facturaAvailabilityNotice') as HTMLElement | null;
  const facturasMobileList = document.getElementById('facturasMobileList') as HTMLElement | null;
  const facturasCountValue = document.getElementById('facturasCountValue') as HTMLElement | null;
  const facturasCountMeta = document.getElementById('facturasCountMeta') as HTMLElement | null;
  const facturasTotalValue = document.getElementById('facturasTotalValue') as HTMLElement | null;
  const facturasTotalMeta = document.getElementById('facturasTotalMeta') as HTMLElement | null;
  const facturasPendingValue = document.getElementById('facturasPendingValue') as HTMLElement | null;
  const facturasPendingMeta = document.getElementById('facturasPendingMeta') as HTMLElement | null;
  let facturasUnavailableMessage = '';

  // Populate year filter
  (() => {
    if (!facturasAnioFilter) return;
    const y = new Date().getFullYear();
    for (let i = y; i >= y - 3; i--) {
      const opt = document.createElement('option');
      opt.value = String(i); opt.textContent = String(i);
      facturasAnioFilter.appendChild(opt);
    }
  })();

  const setFacturaFeedback = (text?: string) => {
    if (!facturaFeedback) return;
    if (!text) { facturaFeedback.hidden = true; return; }
    facturaFeedback.hidden = false;
    facturaFeedback.textContent = text;
  };

  const renderFacturasSummary = (facturas: any[]) => {
    const rows = Array.isArray(facturas) ? facturas : [];
    const totalCount = rows.length;
    const totalAmount = rows.reduce((acc: number, row: any) => acc + Number(row?.importe_total || 0), 0);
    const pendingRows = rows.filter((row: any) => String(row?.estado || '').toLowerCase() !== 'pagada');
    const pendingAmount = pendingRows.reduce((acc: number, row: any) => acc + Number(row?.importe_total || 0), 0);
    const paidCount = rows.filter((row: any) => String(row?.estado || '').toLowerCase() === 'pagada').length;

    if (facturasCountValue) facturasCountValue.textContent = String(totalCount);
    if (facturasCountMeta) facturasCountMeta.textContent = totalCount ? `${paidCount} ${paidCount === 1 ? 'pagada' : 'pagadas'} en este filtro.` : 'Sin facturas en el periodo.';
    if (facturasTotalValue) facturasTotalValue.textContent = `${totalAmount.toFixed(2)} EUR`;
    if (facturasTotalMeta) facturasTotalMeta.textContent = totalCount ? 'Suma total de facturas visibles.' : 'No hay importes para mostrar.';
    if (facturasPendingValue) facturasPendingValue.textContent = `${pendingAmount.toFixed(2)} EUR`;
    if (facturasPendingMeta) facturasPendingMeta.textContent = pendingRows.length
      ? `${pendingRows.length} ${pendingRows.length === 1 ? 'factura pendiente' : 'facturas pendientes'} de cobro.`
      : 'Todo el listado aparece cobrado.';
  };

  const renderFacturasMobile = (facturas: any[]) => {
    if (!facturasMobileList) return;
    const rows = Array.isArray(facturas) ? facturas : [];
    if (!rows.length) {
      facturasMobileList.innerHTML = '<div class="empty-state-sm"><span class="material-symbols-rounded">receipt_long</span><p>Sin facturas en este periodo.</p></div>';
      return;
    }
    facturasMobileList.innerHTML = rows.map((f: any) => {
      const pName = f.crm_pacientes ? `${f.crm_pacientes.nombre || ''} ${f.crm_pacientes.apellidos || ''}`.trim() : 'Sin paciente';
      const estadoClass = f.estado === 'anulada' ? 'cancelada' : f.estado === 'pagada' ? 'confirmada' : 'pendiente';
      return `
        <article class="factura-mobile-item">
          <header>
            <strong>${escapeHtml(f.numero || 'Sin numero')}</strong>
            <span class="status-chip ${estadoClass}">${escapeHtml(String(f.estado || 'pendiente'))}</span>
          </header>
          <p>${escapeHtml(pName)} | ${escapeHtml(fmtDate(f.fecha))}</p>
          <div class="factura-mobile-metrics">
            <span><small>Base</small><strong>${Number(f.importe_bruto || 0).toFixed(2)} EUR</strong></span>
            <span><small>IVA</small><strong>${Number(f.importe_iva || 0).toFixed(2)} EUR</strong></span>
            <span><small>Total</small><strong>${Number(f.importe_total || 0).toFixed(2)} EUR</strong></span>
          </div>
          <div class="factura-mobile-actions">
            <a href="#" data-protected-url="${BACKEND_BASE}/api/facturas/${f.id}/pdf${buildClinicParams()}" class="btn-sm btn-outline">Abrir PDF</a>
          </div>
        </article>
      `;
    }).join('');
  };

  const syncFacturasAvailabilityUi = () => {
    const unavailable = Boolean(facturasUnavailableMessage);
    if (nuevaFacturaBtn) {
      nuevaFacturaBtn.disabled = unavailable;
      nuevaFacturaBtn.title = unavailable ? facturasUnavailableMessage : '';
    }
    if (refreshFacturasBtn) {
      refreshFacturasBtn.disabled = unavailable;
      refreshFacturasBtn.title = unavailable ? facturasUnavailableMessage : 'Actualizar facturas';
    }
    if (facturasAnioFilter) {
      facturasAnioFilter.disabled = unavailable;
      facturasAnioFilter.title = unavailable ? facturasUnavailableMessage : 'Anio';
    }
    if (facturaAvailabilityNotice) {
      facturaAvailabilityNotice.hidden = !unavailable;
      facturaAvailabilityNotice.textContent = unavailable ? facturasUnavailableMessage : '';
      if (unavailable) facturaAvailabilityNotice.setAttribute('data-state', 'error');
      else facturaAvailabilityNotice.removeAttribute('data-state');
    }
  };

  const loadFacturas = async () => {
    if (!facturasBody) return;
    facturasUnavailableMessage = '';
    syncFacturasAvailabilityUi();
    renderFacturasSummary([]);
    renderFacturasMobile([]);
    setTableState(facturasBody, 8, 'sync', 'Cargando facturas...', true);
    try {
      const anio = facturasAnioFilter?.value || new Date().getFullYear();
      const payload = await fetchJson(`${BACKEND_BASE}/api/facturas?anio=${anio}`);
      if (payload.unavailable) {
        facturasUnavailableMessage = payload.error || 'Modulo facturacion no disponible';
        syncFacturasAvailabilityUi();
        renderFacturasSummary([]);
        renderFacturasMobile([]);
        setTableState(facturasBody, 8, 'warning', facturasUnavailableMessage);
        return;
      }
      const facturas = [...(payload.data || [])].sort((a: any, b: any) => {
        const aTs = new Date(a?.fecha || 0).getTime();
        const bTs = new Date(b?.fecha || 0).getTime();
        if (!Number.isNaN(bTs - aTs) && bTs !== aTs) return bTs - aTs;
        return String(b?.numero || '').localeCompare(String(a?.numero || ''), 'es', { sensitivity: 'base' });
      });
      renderFacturasSummary(facturas);
      renderFacturasMobile(facturas);
      if (!facturas.length) {
        setTableState(facturasBody, 8, 'receipt_long', 'Sin facturas emitidas');
        return;
      }
      facturasBody.innerHTML = facturas.map((f: any) => {
        const pName = f.crm_pacientes ? `${f.crm_pacientes.nombre || ''} ${f.crm_pacientes.apellidos || ''}`.trim() : 'Sin paciente';
        const estadoClass = f.estado === 'anulada' ? 'cancelada' : f.estado === 'pagada' ? 'confirmada' : 'pendiente';
        return `<tr>
          <td><strong>${escapeHtml(f.numero)}</strong></td>
          <td>${fmtDate(f.fecha)}</td>
          <td class="td-patient">${escapeHtml(pName)}</td>
          <td>${Number(f.importe_bruto).toFixed(2)} EUR</td>
          <td>${Number(f.importe_iva).toFixed(2)} EUR</td>
          <td><strong>${Number(f.importe_total).toFixed(2)} EUR</strong></td>
          <td><span class="status-chip ${estadoClass}">${f.estado}</span></td>
          <td><a href="#" data-protected-url="${BACKEND_BASE}/api/facturas/${f.id}/pdf${buildClinicParams()}" class="btn-sm btn-outline">PDF</a></td>
        </tr>`;
      }).join('');
    } catch {
      renderFacturasSummary([]);
      renderFacturasMobile([]);
      setTableState(facturasBody, 8, 'cloud_off', 'Error al cargar facturas');
    }
  };
  pageLoaders['facturas'] = loadFacturas;
  facturasAnioFilter?.addEventListener('change', loadFacturas);
  refreshFacturasBtn?.addEventListener('click', loadFacturas);

  // Modal
  const openFacturaModal = async () => {
    if (facturasUnavailableMessage) { setFacturaFeedback(facturasUnavailableMessage); return; }
    facturaModal?.classList.add('open');
    facturaModal?.setAttribute('aria-hidden', 'false');
    document.body.classList.add('has-modal-open');
    facturaForm?.reset();
    setFacturaFeedback();
    if (facturaPreview) facturaPreview.hidden = true;
    // Populate patient select (CRM only)
    if (facturaPacienteSelect) {
      if (!patientCatalog.length) await fetchPatientCatalog();
      const crmPts = patientCatalog.filter((p: any) => p._source !== 'legacy');
      facturaPacienteSelect.innerHTML = '<option value="">-- Selecciona paciente --</option>' +
        crmPts.map((p: any) => `<option value="${p.id}">${escapeHtml(p.nombre_completo || 'Sin nombre')}</option>`).join('');
    }
  };
  const closeFacturaModal = () => {
    facturaModal?.classList.remove('open');
    facturaModal?.setAttribute('aria-hidden', 'true');
    document.body.classList.remove('has-modal-open');
  };

  nuevaFacturaBtn?.addEventListener('click', openFacturaModal);
  document.getElementById('facturaModalClose')?.addEventListener('click', closeFacturaModal);
  document.getElementById('facturaModalDismiss')?.addEventListener('click', closeFacturaModal);

  // Preview payments when patient selected
  facturaPacienteSelect?.addEventListener('change', async () => {
    if (!facturaPreview) return;
    const pacienteId = facturaPacienteSelect.value;
    if (!pacienteId) { facturaPreview.hidden = true; return; }
    try {
      const payload = await fetchJson(`${BACKEND_BASE}/api/pagos?paciente_id=${pacienteId}`);
      const pagos = payload.data || [];
      if (!pagos.length) {
        facturaPreview.innerHTML = '<p class="empty-inline">Este paciente no tiene pagos para facturar</p>';
        facturaPreview.hidden = false;
        return;
      }
      const total = pagos.reduce((s: number, p: any) => s + Number(p.importe || 0), 0);
      facturaPreview.innerHTML = `
        <p class="factura-preview-summary">${pagos.length} pago(s) registrados - ${total.toFixed(2)} EUR pendientes de facturar</p>
        <div class="table-wrap"><table><thead><tr><th>Fecha</th><th>Concepto</th><th>Metodo</th><th>Importe</th></tr></thead><tbody>
        ${pagos.map((p: any) => `<tr><td>${fmtDate(p.fecha)}</td><td>${escapeHtml(p.concepto || 'Sesion')}</td><td>${escapeHtml(p.metodo || '')}</td><td>${Number(p.importe || 0).toFixed(2)} EUR</td></tr>`).join('')}
        </tbody></table></div>`;
      facturaPreview.hidden = false;
    } catch {
      facturaPreview.innerHTML = '<p class="empty-inline">Error al cargar pagos</p>';
      facturaPreview.hidden = false;
    }
  });

  // Submit
  facturaForm?.addEventListener('submit', async (e: Event) => {
    e.preventDefault();
    if (facturasUnavailableMessage) { setFacturaFeedback(facturasUnavailableMessage); return; }
    const pacienteId = facturaPacienteSelect?.value;
    if (!pacienteId) { setFacturaFeedback('Selecciona un paciente'); return; }
    const prev = facturaSubmitBtn?.innerHTML || '';
    if (facturaSubmitBtn) { facturaSubmitBtn.disabled = true; facturaSubmitBtn.innerHTML = '<span class="material-symbols-rounded">sync</span> Generando...'; }
    try {
      const payload = await fetchJson(`${BACKEND_BASE}/api/facturas`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          paciente_id: pacienteId,
          iva_pct: Number(facturaIvaPct?.value || 21),
          notas: facturaNotas?.value || null,
        }),
      });
      closeFacturaModal();
      await loadFacturas();
      // Open PDF in new tab
      if (payload.data?.id) {
        await openProtectedUrl(`${BACKEND_BASE}/api/facturas/${payload.data.id}/pdf${buildClinicParams()}`);
      }
    } catch (err: any) {
      setFacturaFeedback(`Error: ${err?.message || 'no se pudo generar'}`);
    } finally {
      if (facturaSubmitBtn) { facturaSubmitBtn.disabled = false; facturaSubmitBtn.innerHTML = prev; }
    }
  });

  // ===================== BONOS =====================
  const bonosBody = document.getElementById('bonosBody') as HTMLElement | null;
  const bonosEstadoFilter = document.getElementById('bonosEstadoFilter') as HTMLSelectElement | null;
  const nuevoBonoBtn = document.getElementById('nuevoBonoBtn') as HTMLButtonElement | null;
  const refreshBonosBtn = document.getElementById('refreshBonos') as HTMLButtonElement | null;
  const bonoModal = document.getElementById('bonoModal');
  const bonoForm = document.getElementById('bonoForm') as HTMLFormElement | null;
  const bonoPacienteSelect = document.getElementById('bonoPacienteSelect') as HTMLSelectElement | null;
  const bonoFeedback = document.getElementById('bonoFeedback') as HTMLElement | null;
  const bonosAvailabilityNotice = document.getElementById('bonosAvailabilityNotice') as HTMLElement | null;
  const bonosMobileList = document.getElementById('bonosMobileList') as HTMLElement | null;
  const bonosCountValue = document.getElementById('bonosCountValue') as HTMLElement | null;
  const bonosCountMeta = document.getElementById('bonosCountMeta') as HTMLElement | null;
  const bonosRemainingValue = document.getElementById('bonosRemainingValue') as HTMLElement | null;
  const bonosRemainingMeta = document.getElementById('bonosRemainingMeta') as HTMLElement | null;
  const bonosPendingValue = document.getElementById('bonosPendingValue') as HTMLElement | null;
  const bonosPendingMeta = document.getElementById('bonosPendingMeta') as HTMLElement | null;
  const bonoSubmitBtn = document.getElementById('bonoSubmitBtn') as HTMLButtonElement | null;
  const bonoEditId = document.getElementById('bonoEditId') as HTMLInputElement | null;
  const bonoModalTitle = document.getElementById('bonoModalTitle');
  let bonosUnavailableMessage = '';

  const syncBonosAvailabilityUi = () => {
    const unavailable = Boolean(bonosUnavailableMessage);
    if (nuevoBonoBtn) {
      nuevoBonoBtn.disabled = unavailable;
      nuevoBonoBtn.title = unavailable ? bonosUnavailableMessage : '';
    }
    if (refreshBonosBtn) {
      refreshBonosBtn.disabled = unavailable;
      refreshBonosBtn.title = unavailable ? bonosUnavailableMessage : 'Actualizar bonos';
    }
    if (bonosEstadoFilter) {
      bonosEstadoFilter.disabled = unavailable;
      bonosEstadoFilter.title = unavailable ? bonosUnavailableMessage : 'Estado';
    }
    if (bonosAvailabilityNotice) {
      bonosAvailabilityNotice.hidden = !unavailable;
      bonosAvailabilityNotice.textContent = unavailable ? bonosUnavailableMessage : '';
      if (unavailable) bonosAvailabilityNotice.setAttribute('data-state', 'error');
      else bonosAvailabilityNotice.removeAttribute('data-state');
    }
  };


  const setBonoFeedback = (t?: string) => {
    if (!bonoFeedback) return;
    if (!t) { bonoFeedback.hidden = true; return; }
    bonoFeedback.hidden = false; bonoFeedback.textContent = t;
  };

  const renderBonosSummary = (bonos: any[]) => {
    const rows = Array.isArray(bonos) ? bonos : [];
    const totalCount = rows.length;
    const remaining = rows.reduce((acc: number, b: any) => acc + Math.max(Number(b?.sesiones_total || 0) - Number(b?.sesiones_usadas || 0), 0), 0);
    const pendingValue = rows
      .filter((b: any) => String(b?.estado || '').toLowerCase() === 'activo')
      .reduce((acc: number, b: any) => acc + Number(b?.precio || 0), 0);
    const activeCount = rows.filter((b: any) => String(b?.estado || '').toLowerCase() === 'activo').length;

    if (bonosCountValue) bonosCountValue.textContent = String(totalCount);
    if (bonosCountMeta) bonosCountMeta.textContent = totalCount ? `${activeCount} bono${activeCount === 1 ? '' : 's'} activo${activeCount === 1 ? '' : 's'}.` : 'Sin bonos en este filtro.';
    if (bonosRemainingValue) bonosRemainingValue.textContent = String(remaining);
    if (bonosRemainingMeta) bonosRemainingMeta.textContent = totalCount ? 'Sesiones disponibles por consumir.' : 'No hay sesiones disponibles.';
    if (bonosPendingValue) bonosPendingValue.textContent = fmtMoney(pendingValue);
    if (bonosPendingMeta) bonosPendingMeta.textContent = activeCount ? 'Valor asociado a bonos activos.' : 'No hay valor pendiente en bonos.';
  };

  const renderBonosMobile = (bonos: any[]) => {
    if (!bonosMobileList) return;
    const rows = Array.isArray(bonos) ? bonos : [];
    if (!rows.length) {
      bonosMobileList.innerHTML = '<div class="empty-state-sm"><span class="material-symbols-rounded">confirmation_number</span><p>Sin bonos para este filtro.</p></div>';
      return;
    }

    bonosMobileList.innerHTML = rows.map((b: any) => {
      const pName = b.crm_pacientes ? `${b.crm_pacientes.nombre || ''} ${b.crm_pacientes.apellidos || ''}`.trim() : 'Sin paciente';
      const restantes = Math.max(Number(b?.sesiones_total || 0) - Number(b?.sesiones_usadas || 0), 0);
      const estadoClass = b.estado;
      const sesionesTotal = Math.max(Number(b?.sesiones_total || 1), 1);
      const sesionesUsadas = Math.min(Math.max(Number(b?.sesiones_usadas || 0), 0), sesionesTotal);
      return `
        <article class="bonos-mobile-item" data-bono="${escapeAttr(JSON.stringify(b))}">
          <header>
            <strong>${escapeHtml(pName)}</strong>
            <span class="status-chip ${escapeAttr(estadoClass)}">${escapeHtml(String(b.estado || 'activo'))}</span>
          </header>
          <p>${escapeHtml(b.nombre || 'Bono')}</p>
          <div class="bono-progress">
            <span>${b.sesiones_usadas}/${b.sesiones_total} <small>(${restantes} restantes)</small></span>
            <progress class="bono-progress-meter" value="${sesionesUsadas}" max="${sesionesTotal}" aria-label="Consumo del bono"></progress>
          </div>
          <div class="bonos-mobile-meta">${Number(b.precio || 0).toFixed(2)} EUR | Inicio ${escapeHtml(b.fecha_inicio ? fmtDate(b.fecha_inicio) : 'sin fecha')}</div>
          <div class="bonos-mobile-actions">
            ${b.estado === 'activo' ? `<button class="btn-sm btn-outline" data-action="usar-bono" data-bono-id="${b.id}">Usar sesion</button>` : ''}
            <button class="btn-sm btn-outline" data-action="edit-bono" data-bono-id="${b.id}">Editar</button>
            <button class="btn-sm btn-outline bonos-mobile-delete" data-action="delete-bono" data-bono-id="${b.id}">Eliminar</button>
          </div>
        </article>
      `;
    }).join('');
  };

  const loadBonos = async () => {
    if (!bonosBody) return;
    bonosUnavailableMessage = '';
    syncBonosAvailabilityUi();
    renderBonosSummary([]);
    renderBonosMobile([]);
    setTableState(bonosBody, 8, 'sync', 'Cargando bonos...', true);
    try {
      const estado = bonosEstadoFilter?.value || '';
      const url = `${BACKEND_BASE}/api/bonos${estado ? `?estado=${estado}` : ''}`;
      const payload = await fetchJson(url);
      if (payload.unavailable) {
        bonosUnavailableMessage = payload.error || 'Modulo bonos no disponible';
        syncBonosAvailabilityUi();
        renderBonosSummary([]);
        renderBonosMobile([]);
        setTableState(bonosBody, 8, 'warning', bonosUnavailableMessage);
        return;
      }
      const bonos = [...(payload.data || [])].sort((a: any, b: any) => new Date((b?.fecha_inicio || b?.created_at || 0)).getTime() - new Date((a?.fecha_inicio || a?.created_at || 0)).getTime());
      renderBonosSummary(bonos);
      renderBonosMobile(bonos);
      if (!bonos.length) { setTableState(bonosBody, 8, 'confirmation_number', 'Sin bonos'); return; }
      bonosBody.innerHTML = bonos.map((b: any) => {
        const pName = b.crm_pacientes ? `${b.crm_pacientes.nombre || ''} ${b.crm_pacientes.apellidos || ''}`.trim() : 'Sin paciente';
        const restantes = b.sesiones_total - b.sesiones_usadas;
        const estadoClass = b.estado; // activo/agotado/caducado/anulado - CSS defines .status-chip.activo etc.
        const sesionesTotal = Math.max(Number(b?.sesiones_total || 1), 1);
        const sesionesUsadas = Math.min(Math.max(Number(b?.sesiones_usadas || 0), 0), sesionesTotal);
        return `<tr data-bono="${escapeAttr(JSON.stringify(b))}">
          <td class="td-patient">${escapeHtml(pName)}</td>
          <td>${escapeHtml(b.nombre)}</td>
          <td>
            <div class="bono-progress">
              <span>${b.sesiones_usadas}/${b.sesiones_total} <small>(${restantes} restantes)</small></span>
              <progress class="bono-progress-meter" value="${sesionesUsadas}" max="${sesionesTotal}" aria-label="Consumo del bono"></progress>
            </div>
          </td>
          <td>${Number(b.precio).toFixed(2)} EUR</td>
          <td>${b.fecha_inicio ? fmtDate(b.fecha_inicio) : 'Sin fecha'}</td>
          <td>${b.fecha_caducidad ? fmtDate(b.fecha_caducidad) : 'Sin fecha'}</td>
          <td><span class="status-chip ${estadoClass}">${b.estado}</span></td>
          <td>
            <div class="table-actions">
              ${b.estado === 'activo' ? `<button class="btn-sm btn-outline" data-action="usar-bono" data-bono-id="${b.id}">Usar sesion</button>` : ''}
              <button class="btn-sm btn-outline" data-action="edit-bono" data-bono-id="${b.id}">Editar</button>
              <button class="btn-sm btn-outline finance-danger-action finance-icon-action" data-action="delete-bono" data-bono-id="${b.id}" aria-label="Eliminar bono"><span class="material-symbols-rounded">delete</span></button>
            </div>
          </td>
        </tr>`;
      }).join('');
    } catch {
      renderBonosSummary([]);
      renderBonosMobile([]);
      setTableState(bonosBody, 8, 'cloud_off', 'Error al cargar bonos');
    }
  };
  pageLoaders['bonos'] = loadBonos;
  bonosEstadoFilter?.addEventListener('change', loadBonos);
  refreshBonosBtn?.addEventListener('click', loadBonos);

  const openBonoModal = async (editData?: any) => {
    if (bonosUnavailableMessage) { setBonoFeedback(bonosUnavailableMessage); return; }
    bonoModal?.classList.add('open');
    bonoModal?.setAttribute('aria-hidden', 'false');
    document.body.classList.add('has-modal-open');
    bonoForm?.reset();
    setBonoFeedback();
    if (bonoEditId) bonoEditId.value = '';
    if (!patientCatalog.length) await fetchPatientCatalog();
    const crmPts = patientCatalog.filter((p: any) => p._source !== 'legacy');
    if (bonoPacienteSelect) {
      bonoPacienteSelect.innerHTML = '<option value="">-- Selecciona paciente --</option>' +
        crmPts.map((p: any) => `<option value="${p.id}">${escapeHtml(p.nombre_completo || 'Sin nombre')}</option>`).join('');
    }
    const fechaInicio = document.getElementById('bonoFechaInicio') as HTMLInputElement;
    if (fechaInicio && !editData) fechaInicio.value = new Date().toISOString().slice(0, 10);
    if (editData) {
      if (bonoModalTitle) bonoModalTitle.textContent = 'Editar bono';
      if (bonoEditId) bonoEditId.value = editData.id;
      if (bonoPacienteSelect) bonoPacienteSelect.value = editData.paciente_id || '';
      const set = (id: string, v: string) => { const el = document.getElementById(id) as HTMLInputElement; if (el) el.value = v || ''; };
      set('bonoNombre', editData.nombre); set('bonoSesiones', editData.sesiones_total);
      set('bonoPrecio', editData.precio); set('bonoFechaInicio', editData.fecha_inicio);
      set('bonoFechaCaducidad', editData.fecha_caducidad); set('bonoNotas', editData.notas);
    } else {
      if (bonoModalTitle) bonoModalTitle.textContent = 'Nuevo bono';
    }
  };
  const closeBonoModal = () => { bonoModal?.classList.remove('open'); bonoModal?.setAttribute('aria-hidden', 'true'); document.body.classList.remove('has-modal-open'); };

  nuevoBonoBtn?.addEventListener('click', () => openBonoModal());
  document.getElementById('bonoModalClose')?.addEventListener('click', closeBonoModal);
  document.getElementById('bonoModalDismiss')?.addEventListener('click', closeBonoModal);

  bonoForm?.addEventListener('submit', async (e: Event) => {
    e.preventDefault();
    if (bonosUnavailableMessage) { setBonoFeedback(bonosUnavailableMessage); return; }
    const id = bonoEditId?.value;
    const body: any = {
      paciente_id: bonoPacienteSelect?.value,
      nombre: (document.getElementById('bonoNombre') as HTMLInputElement)?.value,
      sesiones_total: Number((document.getElementById('bonoSesiones') as HTMLInputElement)?.value),
      precio: Number((document.getElementById('bonoPrecio') as HTMLInputElement)?.value),
      fecha_inicio: (document.getElementById('bonoFechaInicio') as HTMLInputElement)?.value || null,
      fecha_caducidad: (document.getElementById('bonoFechaCaducidad') as HTMLInputElement)?.value || null,
      notas: (document.getElementById('bonoNotas') as HTMLTextAreaElement)?.value || null,
    };
    if (!body.paciente_id) { setBonoFeedback('Selecciona un paciente'); return; }
    const prev = bonoSubmitBtn?.innerHTML || '';
    if (bonoSubmitBtn) { bonoSubmitBtn.disabled = true; bonoSubmitBtn.innerHTML = '<span class="material-symbols-rounded">sync</span> Guardando...'; }
    try {
      if (id) {
        await fetchJson(`${BACKEND_BASE}/api/bonos/${id}`, { method: 'PATCH', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
      } else {
        await fetchJson(`${BACKEND_BASE}/api/bonos`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
      }
      closeBonoModal(); await loadBonos();
    } catch (err: any) { setBonoFeedback(`Error: ${err?.message || 'no se pudo guardar'}`); }
    finally { if (bonoSubmitBtn) { bonoSubmitBtn.disabled = false; bonoSubmitBtn.innerHTML = prev; } }
  });

  // Table actions
  bonosBody?.addEventListener('click', async (e: Event) => {
    const btn = (e.target as HTMLElement).closest('button[data-action]') as HTMLButtonElement | null;
    if (!btn) return;
    const action = btn.getAttribute('data-action');
    const bonoId = btn.getAttribute('data-bono-id');
    if (!bonoId) return;
    if (bonosUnavailableMessage) { showToast(bonosUnavailableMessage, 'warning'); return; }

    if (action === 'usar-bono') {
      try {
        await fetchJson(`${BACKEND_BASE}/api/bonos/${bonoId}/usar`, { method: 'POST' });
        showToast('Sesion descontada del bono.', 'success');
        await loadBonos();
      } catch (err: any) { showToast(err?.message || 'No se pudo usar el bono.', 'error'); }
    }
    if (action === 'edit-bono') {
      const row = btn.closest('tr') as HTMLTableRowElement | null;
      try {
        const bono = row?.dataset.bono ? JSON.parse(row.dataset.bono) : null;
        if (bono) openBonoModal(bono);
      } catch {}
    }
    if (action === 'delete-bono') {
      const confirmed = await requestConfirm({
        title: 'Eliminar bono',
        message: 'El bono dejara de estar disponible para este paciente.',
        confirmLabel: 'Eliminar',
        tone: 'error',
      });
      if (!confirmed) return;
      try {
        await fetchJson(`${BACKEND_BASE}/api/bonos/${bonoId}`, { method: 'DELETE' });
        showToast('Bono eliminado.', 'success');
        await loadBonos();
      } catch (err: any) { showToast(err?.message || 'No se pudo eliminar el bono.', 'error'); }
    }
  });

  // ===================== FIRMA DIGITAL =====================
  let firmaDocId: string | null = null;
  let firmaDrawing = false;
  let firmaHasSig = false;
  const firmaCanvas = document.getElementById('firmaCanvas') as HTMLCanvasElement | null;
  const firmaStatus = document.getElementById('firmaStatus');
  const firmaFeedback = document.getElementById('firmaFeedback') as HTMLElement | null;
  const firmaModalTitle = document.getElementById('firmaModalTitle');
  const firmaDocContenido = document.getElementById('firmaDocContenido');

  const setFirmaFeedback = (t?: string) => {
    if (!firmaFeedback) return;
    if (!t) { firmaFeedback.hidden = true; return; }
    firmaFeedback.hidden = false;
    firmaFeedback.textContent = t;
  };

  // Signature pad
  const initFirmaPad = () => {
    if (!firmaCanvas) return;
    const ctx = firmaCanvas.getContext('2d');
    if (!ctx) return;
    ctx.clearRect(0, 0, firmaCanvas.width, firmaCanvas.height);
    firmaHasSig = false;
    if (firmaStatus) firmaStatus.textContent = 'Sin firma';
    ctx.strokeStyle = '#1e293b';
    ctx.lineWidth = 2;
    ctx.lineCap = 'round';
    ctx.lineJoin = 'round';

    const getPos = (e: MouseEvent | TouchEvent) => {
      const rect = firmaCanvas.getBoundingClientRect();
      const scaleX = firmaCanvas.width / rect.width;
      const scaleY = firmaCanvas.height / rect.height;
      const src = e instanceof TouchEvent ? e.touches[0] : e;
      return { x: (src.clientX - rect.left) * scaleX, y: (src.clientY - rect.top) * scaleY };
    };

    firmaCanvas.onmousedown = (e) => { firmaDrawing = true; const p = getPos(e); ctx.beginPath(); ctx.moveTo(p.x, p.y); };
    firmaCanvas.onmousemove = (e) => { if (!firmaDrawing) return; const p = getPos(e); ctx.lineTo(p.x, p.y); ctx.stroke(); firmaHasSig = true; if (firmaStatus) firmaStatus.textContent = 'Firma capturada'; };
    firmaCanvas.onmouseup = () => { firmaDrawing = false; };
    firmaCanvas.onmouseleave = () => { firmaDrawing = false; };
    firmaCanvas.ontouchstart = (e) => { e.preventDefault(); firmaDrawing = true; const p = getPos(e); ctx.beginPath(); ctx.moveTo(p.x, p.y); };
    firmaCanvas.ontouchmove = (e) => { e.preventDefault(); if (!firmaDrawing) return; const p = getPos(e); ctx.lineTo(p.x, p.y); ctx.stroke(); firmaHasSig = true; if (firmaStatus) firmaStatus.textContent = 'Firma capturada'; };
    firmaCanvas.ontouchend = () => { firmaDrawing = false; };
  };

  document.getElementById('firmaClearBtn')?.addEventListener('click', () => {
    if (!firmaCanvas) return;
    const ctx = firmaCanvas.getContext('2d');
    ctx?.clearRect(0, 0, firmaCanvas.width, firmaCanvas.height);
    firmaHasSig = false;
    if (firmaStatus) firmaStatus.textContent = 'Sin firma';
  });

  const openFirmaModal = async (tipo: string) => {
    if (!fichaPatientId) return;
    setFirmaFeedback();
    firmaDocId = null;
    try {
      // Create document
      const payload = await fetchJson(`${BACKEND_BASE}/api/documentos`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ paciente_id: fichaPatientId, tipo }),
      });
      firmaDocId = payload.data?.id || null;
      if (firmaModalTitle) firmaModalTitle.textContent = payload.data?.titulo || 'Documento';
      if (firmaDocContenido) firmaDocContenido.textContent = payload.contenido || '';
      document.dispatchEvent(new CustomEvent('fisio:open-firma-modal'));
      initFirmaPad();
    } catch (err: any) {
      showToast(err?.message || 'No se pudo crear el documento.', 'error');
    }
  };

  const closeFirmaModal = () => {
    document.dispatchEvent(new CustomEvent('fisio:close-firma-modal'));
  };

  document.getElementById('firmaModalClose')?.addEventListener('click', closeFirmaModal);
  document.getElementById('firmaModalDismiss')?.addEventListener('click', closeFirmaModal);

  // Buttons to open firma modal from ficha
  ['btnDocConsentimiento', 'btnDocLopd', 'btnDocRevocacion'].forEach(id => {
    const btn = document.getElementById(id);
    if (!btn) return;
    btn.addEventListener('click', () => {
      const tipo = btn.getAttribute('data-doc-tipo') || 'consentimiento_informado';
      openFirmaModal(tipo);
    });
  });

  // Save signature
  document.getElementById('firmaGuardarBtn')?.addEventListener('click', async () => {
    if (!firmaDocId) return;
    if (!firmaHasSig) { setFirmaFeedback('Por favor, dibuja tu firma antes de continuar.'); return; }
    if (!firmaCanvas) return;
    const firmaB64 = firmaCanvas.toDataURL('image/png');
    const btn = document.getElementById('firmaGuardarBtn') as HTMLButtonElement;
    const prev = btn?.innerHTML || '';
    if (btn) { btn.disabled = true; btn.innerHTML = '<span class="material-symbols-rounded">sync</span> Guardando...'; }
    try {
      await fetchJson(`${BACKEND_BASE}/api/documentos/${firmaDocId}/firmar`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ firma_base64: firmaB64 }),
      });
      closeFirmaModal();
      // Open PDF
      await openProtectedUrl(`${BACKEND_BASE}/api/documentos/${firmaDocId}/pdf${buildClinicParams()}`);
      // Reload docs list
      if (fichaPatientId) {
        const docsPayload = await fetchJson(`${BACKEND_BASE}/api/documentos?paciente_id=${fichaPatientId}`);
        renderFichaDocumentos(docsPayload.data || [], fichaData?.recommendations || []);
      }
    } catch (err: any) {
      setFirmaFeedback(`Error: ${err?.message || 'no se pudo guardar'}`);
    } finally {
      if (btn) { btn.disabled = false; btn.innerHTML = prev; }
    }
  });

// Render documents list
const renderFichaDocumentos = (docs: any[], recommendations: any[] = []) => {
  const el = document.getElementById('fichaDocsList');
  if (!el) return;

  const safeDocs = Array.isArray(docs) ? docs : [];
  const safeRecommendations = Array.isArray(recommendations) ? recommendations : [];
  const firmados = safeDocs.filter((doc: any) => doc?.estado === 'firmado').length;
  const pendientes = safeDocs.filter((doc: any) => doc?.estado !== 'firmado').length;

  const planDocuments = safeRecommendations
    .map((recommendation: any, index: number) => {
      const archivedReports = Array.isArray(recommendation?.archived_reports) ? [...recommendation.archived_reports] : [];
      archivedReports.sort((a: any, b: any) => new Date((b?.archived_at || b?.created_at || 0)).getTime() - new Date((a?.archived_at || a?.created_at || 0)).getTime());
      const followUps = Array.isArray(recommendation?.follow_ups) ? [...recommendation.follow_ups] : [];
      followUps.sort((a: any, b: any) => new Date((b?.created_at || b?.fecha || 0)).getTime() - new Date((a?.created_at || a?.fecha || 0)).getTime());
      const latestArchivedReport = archivedReports[0] || null;
      const latestFollowUp = followUps[0] || null;
      const exerciseCount = getRecommendationExerciseCount(recommendation);
      const adherenceMeta = getRecommendationAdherenceMeta(latestFollowUp?.adherence_status || null);
      const rawState = sanitizeText(recommendation?.estado || 'activo').replace(/_/g, ' ').trim();
      const stateLabel = rawState ? `${rawState.charAt(0).toUpperCase()}${rawState.slice(1)}` : 'Activo';
      const title = trimAgentBriefText(
        recommendation?.symptom_summary ||
        recommendation?.selection_rationale ||
        recommendation?.report_snapshot?.title ||
        `Plan domiciliario ${index + 1}`,
        92,
      );
      return {
        id: recommendation?.id || `plan-${index + 1}`,
        title,
        createdAt: recommendation?.created_at || null,
        latestArchivedReport,
        latestDeliveryAt: latestArchivedReport?.archived_at || latestArchivedReport?.created_at || null,
        exerciseCount,
        adherenceMeta,
        stateLabel,
        hasArchive: Boolean(latestArchivedReport),
        sourceLabel: sanitizeText(latestArchivedReport?.source || 'historial clinico'),
        formatLabel: String(latestArchivedReport?.format || 'pdf').toUpperCase(),
        messagePreview: latestArchivedReport?.message_text ? trimAgentBriefText(latestArchivedReport.message_text, 160) : '',
      };
    })
    .sort((a: any, b: any) => new Date((b.latestDeliveryAt || b.createdAt || 0)).getTime() - new Date((a.latestDeliveryAt || a.createdAt || 0)).getTime());

  const archivedPlanCount = planDocuments.filter((item: any) => item.hasArchive).length;
  const draftPlanCount = Math.max(planDocuments.length - archivedPlanCount, 0);
  const latestPlanDocument = planDocuments[0] || null;

  if (fichaDocsSummary) {
    const latestPlanCopy = latestPlanDocument
      ? latestPlanDocument.hasArchive
        ? `Ultima entrega ${fmtDate(latestPlanDocument.latestDeliveryAt || latestPlanDocument.createdAt || '')}`
        : `Ultimo plan ${fmtDate(latestPlanDocument.createdAt || '')}`
      : 'Sin planes generados';
    fichaDocsSummary.innerHTML = `
      <span class="ficha-summary-chip"><strong>${planDocuments.length}</strong> plan${planDocuments.length === 1 ? '' : 'es'} IA</span>
      <span class="ficha-summary-chip">${archivedPlanCount} entrega${archivedPlanCount === 1 ? '' : 's'} archivada${archivedPlanCount === 1 ? '' : 's'}</span>
      <span class="ficha-summary-chip">${safeDocs.length} documento${safeDocs.length === 1 ? '' : 's'} legal${safeDocs.length === 1 ? '' : 'es'}</span>
      <span class="ficha-summary-chip">${firmados} firmado${firmados === 1 ? '' : 's'} - ${pendientes} pendiente${pendientes === 1 ? '' : 's'}</span>
      <span class="ficha-summary-chip">${latestPlanCopy}</span>`;
  }

  const planCardsHtml = planDocuments.length
    ? planDocuments
        .map((plan: any) => `
          <article class="ficha-doc-card ficha-doc-card-plan ${plan.hasArchive ? 'ficha-doc-card-signed' : ''}">
            <div class="ficha-doc-main">
              <span class="material-symbols-rounded ficha-doc-icon ficha-doc-plan-icon">exercise</span>
              <div class="ficha-doc-info">
                <div class="ficha-doc-title-row">
                  <span class="ficha-doc-plan-kicker">Plan domiciliario IA</span>
                  <span class="ficha-doc-plan-state ${plan.hasArchive ? 'ficha-doc-plan-state-ready' : 'ficha-doc-plan-state-pending'}">${plan.hasArchive ? 'Entrega registrada' : 'Pendiente de entrega'}</span>
                </div>
                <div class="ficha-doc-title">${escapeHtml(plan.title)}</div>
                <div class="ficha-doc-meta">Generado ${fmtDate(plan.createdAt || '')}</div>
                <div class="ficha-doc-plan-details">
                  <span>${plan.exerciseCount} ejercicio${plan.exerciseCount === 1 ? '' : 's'}</span>
                  <span>${escapeHtml(plan.stateLabel)}</span>
                  <span>${escapeHtml(plan.adherenceMeta.label)}</span>
                  <span>${plan.hasArchive ? `${escapeHtml(plan.formatLabel)} - ${escapeHtml(plan.sourceLabel)}` : 'Sin entrega archivada'}</span>
                </div>
                ${plan.messagePreview ? `<p class="ficha-doc-plan-copy">${escapeHtml(plan.messagePreview)}</p>` : ''}
              </div>
            </div>
            <div class="ficha-doc-actions ficha-doc-actions-plan">
              <span class="ficha-doc-mini-meta">${plan.hasArchive ? `Archivado ${fmtDate(plan.latestDeliveryAt || '')}` : 'Pendiente de registrar envio o archivo'}</span>
              <button class="btn-sm btn-outline" type="button" data-doc-nav="plan-history">Ver trazabilidad</button>
            </div>
          </article>`)
        .join('')
    : `
      <div class="ficha-doc-empty">
        <span class="material-symbols-rounded">inventory_2</span>
        <strong>Sin planes archivados todavia</strong>
        <p>Cuando generes un informe de ejercicios o archives una entrega al paciente, aparecera aqui para seguir el plan con contexto clinico.</p>
      </div>`;

  const tipoLabel: Record<string, string> = {
    consentimiento_informado: 'Consentimiento informado',
    lopd: 'LOPD / RGPD',
    revocacion: 'Revocacion',
  };

  const legalCardsHtml = safeDocs.length
    ? safeDocs
        .map((d: any) => {
          const title = tipoLabel[d.tipo] || String(d.tipo || 'Documento');
          const firmadoEn = d.firmado_en || d.updated_at || d.created_at || null;
          return `<article class="ficha-doc-card ficha-doc-card-${d.estado === 'firmado' ? 'signed' : 'pending'}">
            <div class="ficha-doc-main">
              <span class="material-symbols-rounded ficha-doc-icon">description</span>
              <div class="ficha-doc-info">
                <div class="ficha-doc-title-row">
                  <div class="ficha-doc-title">${escapeHtml(title)}</div>
                  <span class="ficha-doc-plan-state ${d.estado === 'firmado' ? 'ficha-doc-plan-state-ready' : 'ficha-doc-plan-state-pending'}">${d.estado === 'firmado' ? 'Firmado' : 'Pendiente de firma'}</span>
                </div>
                <div class="ficha-doc-meta">${d.estado === 'firmado' ? `Firmado ${fmtDate(firmadoEn || '')}` : `Creado ${fmtDate(d.created_at || '')}`}</div>
              </div>
            </div>
            <div class="ficha-doc-actions">
              ${d.estado !== 'firmado' ? `<button class="btn-sm btn-outline" data-doc-sign="${escapeAttr(d.id)}">Firmar</button>` : ''}
              <button class="btn-sm btn-ghost" data-doc-delete="${escapeAttr(d.id)}">Eliminar</button>
            </div>
          </article>`;
        })
        .join('')
    : `
      <div class="ficha-doc-empty ficha-doc-empty-legal">
        <span class="material-symbols-rounded">fact_check</span>
        <strong>Sin documentos legales registrados</strong>
        <p>Genera desde aqui consentimientos, LOPD o revocaciones cuando el caso lo necesite.</p>
      </div>`;

  el.innerHTML = `
    <section class="ficha-doc-cluster ficha-doc-cluster-plan">
      <div class="ficha-doc-cluster-head">
        <div>
          <span class="ficha-doc-cluster-kicker">Seguimiento domiciliario</span>
          <h3 class="ficha-doc-cluster-title">Documentos del plan</h3>
        </div>
        <p class="ficha-doc-cluster-copy">${planDocuments.length ? `Tienes ${archivedPlanCount} entrega${archivedPlanCount === 1 ? '' : 's'} archivada${archivedPlanCount === 1 ? '' : 's'} y ${draftPlanCount} plan${draftPlanCount === 1 ? '' : 'es'} pendiente${draftPlanCount === 1 ? '' : 's'} de registrar.` : 'Centraliza aqui lo que se genero para casa, lo que ya se entrego y lo que aun necesita trazabilidad.'}</p>
      </div>
      <div class="ficha-doc-cluster-body">${planCardsHtml}</div>
    </section>
    <section class="ficha-doc-cluster">
      <div class="ficha-doc-cluster-head">
        <div>
          <span class="ficha-doc-cluster-kicker">Marco legal</span>
          <h3 class="ficha-doc-cluster-title">Consentimientos y legales</h3>
        </div>
        <p class="ficha-doc-cluster-copy">Separa la documentacion administrativa de la terapeutica para que la ficha sea clara y operativa.</p>
      </div>
      <div class="ficha-doc-cluster-body">${legalCardsHtml}</div>
    </section>`;

  el.querySelectorAll('[data-doc-nav="plan-history"]').forEach((btn) => {
    btn.addEventListener('click', () => {
      if (!fichaPatientId) return;
      pendingHistoryAnchor = 'recommendations';
      openPatientHistory(fichaPatientId, selectedPatientName || getPatientFullName(fichaData?.paciente || {}));
    });
  });

  el.querySelectorAll('[data-doc-sign]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const docId = (btn as HTMLElement).getAttribute('data-doc-sign');
      if (!docId || !fichaPatientId) return;
      const signature = await requestTextInput({
        title: 'Firmar documento',
        message: 'Escribe el nombre que debe quedar asociado a la firma del documento.',
        inputLabel: 'Nombre de firma',
        inputPlaceholder: 'Nombre y apellidos',
        confirmLabel: 'Firmar',
        tone: 'warning',
      });
      if (!signature) return;
      try {
        await fetchJson(`${BACKEND_BASE}/api/documentos/${docId}/firmar`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ signature }),
        });
        const docsPayload = await fetchJson(`${BACKEND_BASE}/api/documentos?paciente_id=${fichaPatientId}`);
        renderFichaDocumentos(docsPayload.data || [], fichaData?.recommendations || []);
        showToast('Documento firmado correctamente.', 'success');
      } catch (err: any) {
        showToast(err?.message || 'No se pudo firmar el documento.', 'error');
      }
    });
  });

  el.querySelectorAll('[data-doc-delete]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const confirmed = await requestConfirm({
        title: 'Eliminar documento',
        message: 'El documento se eliminara de la ficha del paciente.',
        confirmLabel: 'Eliminar',
        tone: 'error',
      });
      if (!confirmed) return;
      const docId = (btn as HTMLElement).getAttribute('data-doc-id') || (btn as HTMLElement).getAttribute('data-doc-delete');
      if (!docId) return;
      try {
        await fetchJson(`${BACKEND_BASE}/api/documentos/${docId}`, { method: 'DELETE' });
        if (fichaPatientId) {
          const pl = await fetchJson(`${BACKEND_BASE}/api/documentos?paciente_id=${fichaPatientId}`);
          renderFichaDocumentos(pl.data || [], fichaData?.recommendations || []);
        }
        showToast('Documento eliminado.', 'success');
      } catch (err: any) {
        showToast(err?.message || 'No se pudo eliminar el documento.', 'error');
      }
    });
  });
};

// Load docs when ficha opens
  document.querySelector('[data-ficha-tab="documentos"]')?.addEventListener('click', async () => {
    if (!fichaPatientId) return;
    const pl = await fetchJson(`${BACKEND_BASE}/api/documentos?paciente_id=${fichaPatientId}`);
    renderFichaDocumentos(pl.data || [], fichaData?.recommendations || []);
  });

  // ===================== GESTORIA =====================
  const gestoriaBody = document.getElementById('gestoriaBody') as HTMLElement | null;
  const gestoriaHead = document.getElementById('gestoriaHead') as HTMLElement | null;
  const gestoriaAnioFilter = document.getElementById('gestoriaAnioFilter') as HTMLSelectElement | null;
  const gestoriaMobileList = document.getElementById('gestoriaMobileList') as HTMLElement | null;

  (() => {
    if (!gestoriaAnioFilter) return;
    const y = new Date().getFullYear();
    for (let i = y; i >= y - 3; i--) {
      const o = document.createElement('option');
      o.value = String(i); o.textContent = String(i);
      gestoriaAnioFilter.appendChild(o);
    }
  })();

  const MESES_CORTOS = ['Ene','Feb','Mar','Abr','May','Jun','Jul','Ago','Sep','Oct','Nov','Dic'];

  const loadGestoria = async () => {
    if (!gestoriaBody || !gestoriaHead) return;
    setTableState(gestoriaBody, 16, 'sync', 'Cargando datos de gestor\u00eda...', true);

    const anio = gestoriaAnioFilter?.value || String(new Date().getFullYear());

    try {
      const payload = await fetchJson(`${BACKEND_BASE}/api/pagos/gestoria?anio=${anio}`, undefined, 15000);
      const { pacientes, totales_mes, gran_total } = payload;

      // Grand totals
      document.getElementById('gestoriaGranTotal')!.textContent = fmtMoney(gran_total.total);
      document.getElementById('gestoriaGranSesiones')!.textContent = String(gran_total.sesiones);
      document.getElementById('gestoriaGranEfectivo')!.textContent = fmtMoney(gran_total.efectivo);
      document.getElementById('gestoriaGranTarjeta')!.textContent = fmtMoney(gran_total.tarjeta);

      // Header
      gestoriaHead.innerHTML = `<tr>
        <th class="gestoria-col-patient">Paciente</th>
        ${MESES_CORTOS.map(m => `<th class="text-right gestoria-col-mes">${m}</th>`).join('')}
        <th class="text-right gestoria-col-total">Total</th>
        <th class="text-right gestoria-col-efe">Efectivo</th>
        <th class="text-right gestoria-col-tar">Tarjeta</th>
      </tr>`;

      if (!pacientes.length) {
        if (gestoriaMobileList) {
          gestoriaMobileList.innerHTML = '<div class="empty-state-sm"><span class="material-symbols-rounded">account_balance</span><p>Sin datos de gestoría en este año.</p></div>';
        }
        setTableState(gestoriaBody, 16, 'credit_card_off', 'Sin pagos registrados en ' + anio);
        return;
      }

      if (gestoriaMobileList) {
        const mobileRows = [...pacientes].sort((a: any, b: any) => Number(b?.total_anual || 0) - Number(a?.total_anual || 0));
        gestoriaMobileList.innerHTML = mobileRows.map((p: any) => `
          <article class="gestoria-mobile-item">
            <header>
              <strong>${escapeHtml(p.nombre || 'Sin paciente')}</strong>
              <span>${fmtMoney(Number(p.total_anual || 0))}</span>
            </header>
            <div class="gestoria-mobile-metrics">
              <span><small>Efectivo</small><strong>${fmtMoney(Number(p.efectivo_anual || 0))}</strong></span>
              <span><small>Tarjeta</small><strong>${fmtMoney(Number(p.tarjeta_anual || 0))}</strong></span>
            </div>
          </article>
        `).join('');
      }

      // Patient rows
      let html = pacientes.map((p: any) => {
        const cells = MESES_CORTOS.map((_: string, i: number) => {
          const md = p.meses[String(i + 1)];
          if (!md || md.total === 0) return '<td class="text-right gestoria-cell-empty">\u2014</td>';
          const tip = `Efectivo: ${fmtMoney(md.efectivo)} | Tarjeta: ${fmtMoney(md.tarjeta)} | Sesiones: ${md.sesiones}`;
          return `<td class="text-right gestoria-cell-filled" title="${escapeAttr(tip)}">${fmtMoney(md.total)}</td>`;
        }).join('');
        return `<tr>
          <td class="gestoria-patient-name">${escapeHtml(p.nombre)}</td>
          ${cells}
          <td class="text-right"><strong>${fmtMoney(p.total_anual)}</strong></td>
          <td class="text-right gestoria-efe">${fmtMoney(p.efectivo_anual)}</td>
          <td class="text-right gestoria-tar">${fmtMoney(p.tarjeta_anual)}</td>
        </tr>`;
      }).join('');

      // Totals row (facturacion total del mes)
      const totalCells = MESES_CORTOS.map((_: string, i: number) => {
        const md = totales_mes[String(i + 1)];
        const val = md ? md.total : 0;
        return `<td class="text-right"><strong>${val ? fmtMoney(val) : '\u2014'}</strong></td>`;
      }).join('');
      html += `<tr class="gestoria-totals-row">
        <td class="gestoria-patient-name"><strong>TOTAL</strong></td>
        ${totalCells}
        <td class="text-right"><strong>${fmtMoney(gran_total.total)}</strong></td>
        <td class="text-right gestoria-efe"><strong>${fmtMoney(gran_total.efectivo)}</strong></td>
        <td class="text-right gestoria-tar"><strong>${fmtMoney(gran_total.tarjeta)}</strong></td>
      </tr>`;

      gestoriaBody.innerHTML = html;
    } catch {
      if (gestoriaMobileList) {
        gestoriaMobileList.innerHTML = '<div class="empty-state-sm"><span class="material-symbols-rounded">cloud_off</span><p>Error al cargar gestoría.</p></div>';
      }
      setTableState(gestoriaBody, 16, 'cloud_off', 'Error al cargar datos de gestor\u00eda');
    }
  };

  pageLoaders['gestoria'] = loadGestoria;
  gestoriaAnioFilter?.addEventListener('change', () => { loadGestoria(); loadGestoriaMes(); });

  // Monthly detail report
  const gestoriaMesFilter = document.getElementById('gestoriaMesFilter') as HTMLSelectElement | null;
  const gestoriaMesBody = document.getElementById('gestoriaMesBody') as HTMLElement | null;

  // Auto-select current month
  if (gestoriaMesFilter) gestoriaMesFilter.value = String(new Date().getMonth() + 1);

  const loadGestoriaMes = async () => {
    if (!gestoriaMesBody) return;
    setTableState(gestoriaMesBody, 4, 'sync', 'Cargando...', true);

    const anio = gestoriaAnioFilter?.value || String(new Date().getFullYear());
    const mes = gestoriaMesFilter?.value || String(new Date().getMonth() + 1);

    try {
      const payload = await fetchJson(`${BACKEND_BASE}/api/pagos?anio=${anio}&mes=${mes}`);
      const pagos = payload?.data || [];

      // Calculate totals for the month
      let totalMes = 0, efecMes = 0, tarjMes = 0;
      for (const p of pagos) {
        const imp = Number(p.importe);
        totalMes += imp;
        if (p.metodo_pago === 'efectivo') efecMes += imp; else tarjMes += imp;
      }
      document.getElementById('gestoriaMesTotal')!.textContent = fmtMoney(totalMes);
      document.getElementById('gestoriaMesEfectivo')!.textContent = fmtMoney(efecMes);
      document.getElementById('gestoriaMesTarjeta')!.textContent = fmtMoney(tarjMes);
      document.getElementById('gestoriaMesSesiones')!.textContent = String(pagos.length);

      if (!pagos.length) {
        setTableState(gestoriaMesBody, 4, 'credit_card_off', 'Sin pagos en este mes');
        return;
      }

      gestoriaMesBody.innerHTML = pagos.map((p: any) => {
        const pName = p.crm_pacientes ? `${p.crm_pacientes.nombre || ''} ${p.crm_pacientes.apellidos || ''}`.trim() : '\u2014';
        const chip = p.metodo_pago === 'efectivo'
          ? '<span class="pagos-chip pagos-chip-cash">Efectivo</span>'
          : '<span class="pagos-chip pagos-chip-card">Tarjeta</span>';
        return `<tr>
          <td>${p.fecha ? new Date(p.fecha + 'T00:00:00').toLocaleDateString('es-ES', {day:'2-digit',month:'short'}) : '\u2014'}</td>
          <td class="td-patient">${escapeHtml(pName)}</td>
          <td>${chip}</td>
          <td class="text-right"><strong>${fmtMoney(Number(p.importe))}</strong></td>
        </tr>`;
      }).join('');
    } catch {
      setTableState(gestoriaMesBody, 4, 'cloud_off', 'Error al cargar datos');
    }
  };

  gestoriaMesFilter?.addEventListener('change', loadGestoriaMes);

  // Load both on page enter
  const origLoadGestoria = loadGestoria;
  pageLoaders['gestoria'] = async () => { await origLoadGestoria(); await loadGestoriaMes(); };
  // ===================== END GESTORIA =====================

  // === DOCUMENTOS (consentimientos globales) ===
  const documentosBody = document.getElementById('documentosBody') as HTMLElement | null;
  const documentosEstadoFilter = document.getElementById('documentosEstadoFilter') as HTMLSelectElement | null;
  const documentosMobileList = document.getElementById('documentosMobileList') as HTMLElement | null;
  const documentosCountValue = document.getElementById('documentosCountValue') as HTMLElement | null;
  const documentosCountMeta = document.getElementById('documentosCountMeta') as HTMLElement | null;
  const documentosSignedValue = document.getElementById('documentosSignedValue') as HTMLElement | null;
  const documentosSignedMeta = document.getElementById('documentosSignedMeta') as HTMLElement | null;
  const documentosPendingValue = document.getElementById('documentosPendingValue') as HTMLElement | null;
  const documentosPendingMeta = document.getElementById('documentosPendingMeta') as HTMLElement | null;

  const TIPO_LABELS: Record<string, string> = {
    consentimiento_informado: 'Consentimiento',
    lopd: 'LOPD/RGPD',
    revocacion: 'Revocacion',
    otro: 'Otro',
  };

  const renderDocumentosSummary = (docs: any[]) => {
    const rows = Array.isArray(docs) ? docs : [];
    const signed = rows.filter((d: any) => d?.estado === 'firmado');
    const pending = rows.filter((d: any) => d?.estado !== 'firmado');
    if (documentosCountValue) documentosCountValue.textContent = String(rows.length);
    if (documentosCountMeta) documentosCountMeta.textContent = rows.length ? 'Documentos visibles en este filtro.' : 'Sin documentos en este filtro.';
    if (documentosSignedValue) documentosSignedValue.textContent = String(signed.length);
    if (documentosSignedMeta) documentosSignedMeta.textContent = signed.length ? 'Listos para PDF y archivo.' : 'No hay firmas registradas.';
    if (documentosPendingValue) documentosPendingValue.textContent = String(pending.length);
    if (documentosPendingMeta) documentosPendingMeta.textContent = pending.length ? 'Casos pendientes de firma.' : 'Todo aparece firmado.';
  };

  const renderDocumentosMobile = (docs: any[]) => {
    if (!documentosMobileList) return;
    if (!docs.length) {
      documentosMobileList.innerHTML = '<div class="empty-state-sm"><span class="material-symbols-rounded">description</span><p>Sin documentos para este filtro.</p></div>';
      return;
    }
    documentosMobileList.innerHTML = docs.map((d: any) => {
      const pac = d.crm_pacientes;
      const pacNombre = pac ? `${pac.nombre || ''} ${pac.apellidos || ''}`.trim() : 'Sin paciente';
      const tipoLabel = TIPO_LABELS[d.tipo] || d.tipo || 'Sin tipo';
      const signed = d.estado === 'firmado';
      const fechaFirma = d.fecha_firma
        ? new Date(d.fecha_firma).toLocaleDateString('es-ES', { day: '2-digit', month: 'short', year: 'numeric' })
        : 'Pendiente';
      return `
        <article class="documentos-mobile-item">
          <header>
            <strong>${escapeHtml(pacNombre)}</strong>
            <span class="status-chip ${signed ? 'confirmada' : 'pendiente'}">${signed ? 'Firmado' : 'Pendiente'}</span>
          </header>
          <p>${escapeHtml(tipoLabel)} | ${escapeHtml(d.titulo || 'Sin titulo')}</p>
          <small>${escapeHtml(fechaFirma)}</small>
          <div class="documentos-mobile-actions">
            ${signed ? `<a href="#" data-protected-url="${BACKEND_BASE}/api/documentos/${d.id}/pdf${buildClinicParams()}" class="btn-sm btn-outline">PDF</a>` : ''}
            <button class="btn-sm btn-ghost doc-delete-btn" data-doc-id="${d.id}">Eliminar</button>
          </div>
        </article>
      `;
    }).join('');
  };

  const loadDocumentos = async () => {
    if (!documentosBody) return;
    renderDocumentosSummary([]);
    renderDocumentosMobile([]);
    setTableState(documentosBody, 6, 'sync', 'Cargando documentos...', true);
    try {
      const estado = documentosEstadoFilter?.value || '';
      const url = `${BACKEND_BASE}/api/documentos${estado ? `?estado=${estado}` : ''}`;
      const payload = await fetchJson(url);
      const docs = [...(payload.data || [])].sort((a: any, b: any) => new Date((b?.fecha_firma || b?.created_at || 0)).getTime() - new Date((a?.fecha_firma || a?.created_at || 0)).getTime());
      renderDocumentosSummary(docs);
      renderDocumentosMobile(docs);
      if (!docs.length) {
        setTableState(documentosBody, 6, 'description', 'Sin documentos registrados');
        return;
      }
      documentosBody.innerHTML = docs.map((d: any) => {
        const pac = d.crm_pacientes;
        const pacNombre = pac ? `${pac.nombre || ''} ${pac.apellidos || ''}`.trim() : 'Sin paciente';
        const tipoLabel = TIPO_LABELS[d.tipo] || d.tipo || 'Sin tipo';
        const estadoClass = d.estado === 'firmado' ? 'confirmada' : 'pendiente';
        const fechaFirma = d.fecha_firma
          ? new Date(d.fecha_firma).toLocaleDateString('es-ES', { day: '2-digit', month: 'short', year: 'numeric' })
          : 'Pendiente';
        return `<tr>
          <td class="td-patient">${escapeHtml(pacNombre)}</td>
          <td>${escapeHtml(tipoLabel)}</td>
          <td>${escapeHtml(d.titulo || 'Sin titulo')}</td>
          <td><span class="status-chip ${estadoClass}">${d.estado === 'firmado' ? 'Firmado' : 'Pendiente'}</span></td>
          <td>${fechaFirma}</td>
          <td class="documentos-actions-cell">
            ${d.estado === 'firmado' ? `<a href="#" data-protected-url="${BACKEND_BASE}/api/documentos/${d.id}/pdf${buildClinicParams()}" class="btn-sm btn-outline">PDF</a>` : '<span class="documentos-actions-empty">Sin firma</span>'}
            <button class="btn-sm btn-ghost doc-delete-btn" data-doc-id="${d.id}" title="Eliminar">&#x2715;</button>
          </td>
        </tr>`;
      }).join('');
    } catch {
      renderDocumentosSummary([]);
      renderDocumentosMobile([]);
      setTableState(documentosBody, 6, 'cloud_off', 'Error al cargar documentos');
    }
  };
  pageLoaders['documentos'] = loadDocumentos;
  documentosEstadoFilter?.addEventListener('change', loadDocumentos);
  document.getElementById('refreshDocumentos')?.addEventListener('click', loadDocumentos);

  documentosBody?.addEventListener('click', async (e: Event) => {
    const btn = (e.target as HTMLElement).closest('.doc-delete-btn') as HTMLElement | null;
    if (!btn) return;
    const docId = btn.getAttribute('data-doc-id');
    if (!docId) return;
    const confirmed = await requestConfirm({
      title: 'Eliminar documento',
      message: 'El documento se eliminara del listado global.',
      confirmLabel: 'Eliminar',
      tone: 'error',
    });
    if (!confirmed) return;
    try {
      await fetchJson(`${BACKEND_BASE}/api/documentos/${docId}`, { method: 'DELETE' });
      showToast('Documento eliminado.', 'success');
      await loadDocumentos();
    } catch { showToast('Error al eliminar el documento.', 'error'); }
  });

  bonosMobileList?.addEventListener('click', async (e: Event) => {
    const btn = (e.target as HTMLElement).closest('button[data-action]') as HTMLButtonElement | null;
    if (!btn) return;
    const action = btn.getAttribute('data-action');
    const bonoId = btn.getAttribute('data-bono-id');
    if (!bonoId) return;
    if (bonosUnavailableMessage) { showToast(bonosUnavailableMessage, 'warning'); return; }

    if (action === 'usar-bono') {
      try {
        await fetchJson(`${BACKEND_BASE}/api/bonos/${bonoId}/usar`, { method: 'POST' });
        showToast('Sesion descontada del bono.', 'success');
        await loadBonos();
      } catch (err: any) { showToast(err?.message || 'No se pudo usar el bono.', 'error'); }
      return;
    }
    if (action === 'edit-bono') {
      const card = btn.closest('article[data-bono]') as HTMLElement | null;
      try {
        const bono = card?.dataset.bono ? JSON.parse(card.dataset.bono) : null;
        if (bono) openBonoModal(bono);
      } catch {}
      return;
    }
    if (action === 'delete-bono') {
      const confirmed = await requestConfirm({
        title: 'Eliminar bono',
        message: 'El bono dejara de estar disponible para este paciente.',
        confirmLabel: 'Eliminar',
        tone: 'error',
      });
      if (!confirmed) return;
      try {
        await fetchJson(`${BACKEND_BASE}/api/bonos/${bonoId}`, { method: 'DELETE' });
        showToast('Bono eliminado.', 'success');
        await loadBonos();
      } catch (err: any) { showToast(err?.message || 'No se pudo eliminar el bono.', 'error'); }
    }
  });

  documentosMobileList?.addEventListener('click', async (e: Event) => {
    const btn = (e.target as HTMLElement).closest('.doc-delete-btn') as HTMLElement | null;
    if (!btn) return;
    const docId = btn.getAttribute('data-doc-id');
    if (!docId) return;
    const confirmed = await requestConfirm({
      title: 'Eliminar documento',
      message: 'El documento se eliminara del listado global.',
      confirmLabel: 'Eliminar',
      tone: 'error',
    });
    if (!confirmed) return;
    try {
      await fetchJson(`${BACKEND_BASE}/api/documentos/${docId}`, { method: 'DELETE' });
      showToast('Documento eliminado.', 'success');
      await loadDocumentos();
    } catch { showToast('Error al eliminar el documento.', 'error'); }
  });

  const loadConfig = async () => {
    // Populate clinic form from localStorage
    const cfg = getClinicConfig();
    const fields: Record<string, string> = {
      cfgClinicNombre: cfg.nombre || '',
      cfgClinicNif: cfg.nif || '',
      cfgClinicTelefono: cfg.telefono || '',
      cfgClinicDireccion: cfg.direccion || '',
      cfgClinicEmail: cfg.email || '',
      cfgClinicWeb: cfg.web || '',
    };
    Object.entries(fields).forEach(([id, val]) => {
      const el = document.getElementById(id) as HTMLInputElement | null;
      if (el) el.value = val;
    });
    syncBookingLinkUi();
    setBookingLinkFeedback();

    // Connections check
    const cfgBackend = document.getElementById('cfgBackend');
    const cfgBackendStatus = document.getElementById('cfgBackendStatus');
    const cfgAgent = document.getElementById('cfgAgent');
    const cfgAgentStatus = document.getElementById('cfgAgentStatus');
    const cfgReadiness = document.getElementById('cfgReadiness');
    const cfgReadinessStatus = document.getElementById('cfgReadinessStatus');
    const cfgReadinessDetail = document.getElementById('cfgReadinessDetail');
    if (cfgBackend) cfgBackend.textContent = BACKEND_BASE;
    try {
      const r = await fetch(`${BACKEND_BASE}/api/health`, {signal: AbortSignal.timeout(5000)});
      if (cfgBackendStatus) { cfgBackendStatus.textContent = r.ok ? 'OK' : 'Error'; cfgBackendStatus.className = `status-chip ${r.ok ? 'aprobado' : 'rechazado'}`; }
    } catch { if (cfgBackendStatus) { cfgBackendStatus.textContent = 'Offline'; cfgBackendStatus.className = 'status-chip rechazado'; } }
    if (cfgAgent) cfgAgent.textContent = BACKEND_BASE + '/api/agent/message';
    try {
      const r = await fetch(`${BACKEND_BASE}/api/agent/message`, {method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({role:'test',channel:'web',text:'health check'}),signal:AbortSignal.timeout(10000)});
      const data = await r.json();
      const ok = r.ok && !data.n8n_unreachable;
      if (cfgAgentStatus) { cfgAgentStatus.textContent = ok ? (data.fallback_used ? 'Fallback' : 'OK') : 'Error'; cfgAgentStatus.className = `status-chip ${ok ? 'aprobado' : 'rechazado'}`; }
    } catch { if (cfgAgentStatus) { cfgAgentStatus.textContent = 'Offline'; cfgAgentStatus.className = 'status-chip rechazado'; } }
    if (cfgReadiness) cfgReadiness.textContent = 'Comprobando modulos...';
    if (cfgReadinessStatus) { cfgReadinessStatus.textContent = 'Comprobando'; cfgReadinessStatus.className = 'status-chip pendiente'; }
    if (cfgReadinessDetail) {
      cfgReadinessDetail.hidden = true;
      cfgReadinessDetail.textContent = '';
      cfgReadinessDetail.removeAttribute('data-state');
    }
    try {
      const r = await fetch(`${BACKEND_BASE}/api/health/readiness`, { signal: AbortSignal.timeout(8000) });
      const data = await r.json();
      const summary = data.summary || {};
      const missingTables = Array.isArray(data.missing_tables) ? data.missing_tables : [];
      const readinessStatus = data.status || (r.ok ? 'ok' : 'error');
      const chipClass = readinessStatus === 'ok' ? 'aprobado' : readinessStatus === 'degraded' ? 'pendiente' : 'rechazado';
      const chipLabel = readinessStatus === 'ok' ? 'OK' : readinessStatus === 'degraded' ? 'Degradado' : 'Error';
      if (cfgReadinessStatus) {
        cfgReadinessStatus.textContent = chipLabel;
        cfgReadinessStatus.className = `status-chip ${chipClass}`;
      }
      if (cfgReadiness) {
        if (readinessStatus === 'ok') {
          cfgReadiness.textContent = `${summary.ok_checks || 0}/${summary.total_checks || 0} checks listos`;
        } else if (readinessStatus === 'degraded') {
          cfgReadiness.textContent = `${summary.ok_checks || 0}/${summary.total_checks || 0} checks listos | ${summary.optional_missing || missingTables.length} pendiente(s)`;
        } else {
          cfgReadiness.textContent = data.message || 'Readiness no disponible';
        }
      }
      if (cfgReadinessDetail && missingTables.length) {
        cfgReadinessDetail.hidden = false;
        if (readinessStatus === 'error') cfgReadinessDetail.setAttribute('data-state', 'error');
        cfgReadinessDetail.textContent = `Migraciones pendientes: ${missingTables.map((item: any) => `${item.label} -> ${item.migration}`).join(' | ')}`;
      } else if (cfgReadinessDetail && readinessStatus !== 'ok' && data.message) {
        cfgReadinessDetail.hidden = false;
        if (readinessStatus === 'error') cfgReadinessDetail.setAttribute('data-state', 'error');
        cfgReadinessDetail.textContent = String(data.message);
      }
    } catch {
      if (cfgReadiness) cfgReadiness.textContent = 'No pude comprobar el readiness';
      if (cfgReadinessStatus) {
        cfgReadinessStatus.textContent = 'Offline';
        cfgReadinessStatus.className = 'status-chip rechazado';
      }
      if (cfgReadinessDetail) {
        cfgReadinessDetail.hidden = false;
        cfgReadinessDetail.setAttribute('data-state', 'error');
        cfgReadinessDetail.textContent = 'No se pudo consultar /api/health/readiness.';
      }
    }
  };
  pageLoaders['config'] = loadConfig;

  // Clinic config form save
  document.getElementById('clinicConfigForm')?.addEventListener('submit', (e: Event) => {
    e.preventDefault();
    const get = (id: string) => (document.getElementById(id) as HTMLInputElement | null)?.value.trim() || '';
    saveClinicConfig({
      nombre: get('cfgClinicNombre'),
      nif: get('cfgClinicNif'),
      telefono: get('cfgClinicTelefono'),
      direccion: get('cfgClinicDireccion'),
      email: get('cfgClinicEmail'),
      web: get('cfgClinicWeb'),
    });
    const fb = document.getElementById('clinicConfigFeedback');
    if (fb) { fb.textContent = 'Datos guardados correctamente'; fb.hidden = false; setTimeout(() => { fb.hidden = true; }, 3000); }
  });
  bookingOpenBtn?.addEventListener('click', () => {
    syncBookingLinkUi();
    window.open(buildPublicBookingUrl(), '_blank', 'noopener');
  });
  bookingCopyBtn?.addEventListener('click', async () => {
    try {
      syncBookingLinkUi();
      const copied = await copyTextToClipboard(buildPublicBookingUrl());
      setBookingLinkFeedback(copied ? 'Enlace copiado al portapapeles.' : 'No pude copiar el enlace en este navegador.', copied ? 'success' : 'error');
    } catch {
      setBookingLinkFeedback('No pude copiar el enlace en este navegador.', 'error');
    }
  });
  dashboardBookingOpenBtn?.addEventListener('click', () => {
    syncBookingLinkUi();
    window.open(buildPublicBookingUrl(), '_blank', 'noopener');
  });
  dashboardBookingCopyBtn?.addEventListener('click', async () => {
    try {
      syncBookingLinkUi();
      const copied = await copyTextToClipboard(buildPublicBookingUrl());
      setDashboardBookingFeedback(copied ? 'Enlace copiado.' : 'No pude copiar el enlace en este navegador.', copied ? 'success' : 'error');
    } catch {
      setDashboardBookingFeedback('No pude copiar el enlace en este navegador.', 'error');
    }
  });

  renderAssistantPatientContext();
  fetchPatientCatalog()
    .then((pts) => {
      const metricEl = document.getElementById('metricPacientes');
      if (metricEl) metricEl.textContent = String(pts.length);
    })
    .catch(() => {
      if (chatPatientSelect) {
        chatPatientSelect.innerHTML = '<option value="">No se pudieron cargar pacientes</option>';
      }
    });

  // =======================================================
  // INTERACTIVE ANATOMICAL PAIN MAP LOGIC
  // =======================================================
  (window as any).updatePainMapVisuals = function(notas: any[]) {
    const paths = document.querySelectorAll('.pain-zone-path');
    paths.forEach(p => {
      p.classList.remove('has-pain');
      (p as HTMLElement).style.fill = '';
      p.removeAttribute('title');
    });

    if (!Array.isArray(notas) || notas.length === 0) return;

    // Find the latest note for each body zone to see active pain
    const latestByZone: Record<string, { eva: number | null, fecha: string, note: string }> = {};
    const sorted = [...notas].sort((a, b) => new Date(a.fecha || '').getTime() - new Date(b.fecha || '').getTime());
    sorted.forEach(n => {
      if (n.zona_corporal) {
        latestByZone[n.zona_corporal] = {
          eva: n.dolor_eva != null ? Number(n.dolor_eva) : null,
          fecha: n.fecha,
          note: n.nota || ''
        };
      }
    });

    // Color code paths based on pain intensity (EVA)
    paths.forEach(p => {
      const path = p as SVGElement;
      const zone = path.getAttribute('data-zone');
      if (!zone) return;
      
      const data = latestByZone[zone];
      if (data && data.eva !== null && data.eva > 0) {
        path.classList.add('has-pain');
        const intensity = data.eva; // 1-10
        const lightness = 80 - (intensity * 4); // Higher pain -> darker/brighter crimson
        path.style.fill = `hsl(350, 70%, ${lightness}%)`;
        path.setAttribute('title', `${zonaLabels[zone] || zone}: EVA ${intensity}/10 (${fmtDate(data.fecha)})`);
      }
    });
  };

  // Pain Map Event Listeners
  const painMapSvg = document.getElementById('painMapSvg');
  const painMapEditor = document.getElementById('painMapEditor');
  const painMapSelectedZone = document.getElementById('painMapSelectedZone');
  const painEvaSlider = document.getElementById('painEvaSlider') as HTMLInputElement | null;
  const painEvaValue = document.getElementById('painEvaValue');
  const painZoneNotes = document.getElementById('painZoneNotes') as HTMLInputElement | null;
  const btnSavePainZone = document.getElementById('btnSavePainZone');

  let activeSelectedZone: string | null = null;

  if (painMapSvg) {
    painMapSvg.addEventListener('click', (e: Event) => {
      const target = e.target as SVGElement;
      const path = target.closest('.pain-zone-path') as SVGElement | null;
      if (!path) return;

      const zone = path.getAttribute('data-zone');
      if (!zone) return;

      // Reset selection highlights
      document.querySelectorAll('.pain-zone-path').forEach(p => p.classList.remove('active-selected'));
      
      // Highlight new choice
      path.classList.add('active-selected');
      activeSelectedZone = zone;

      // Show editor
      if (painMapEditor) painMapEditor.hidden = false;
      if (painMapSelectedZone) painMapSelectedZone.textContent = zonaLabels[zone] || zone;

      // Reset values in editor
      if (painEvaSlider) {
        painEvaSlider.value = '5';
        if (painEvaValue) painEvaValue.textContent = '5';
      }
      if (painZoneNotes) painZoneNotes.value = '';
    });
  }

  if (painEvaSlider) {
    painEvaSlider.addEventListener('input', () => {
      if (painEvaValue) painEvaValue.textContent = painEvaSlider.value;
    });
  }

  if (btnSavePainZone) {
    btnSavePainZone.addEventListener('click', async () => {
      if (!fichaPatientId || !activeSelectedZone) return;
      
      const eva = painEvaSlider ? Number(painEvaSlider.value) : 5;
      const notes = painZoneNotes ? painZoneNotes.value.trim() : '';
      
      const body = {
        paciente_id: fichaPatientId,
        fecha: new Date().toISOString().slice(0, 10),
        zona_corporal: activeSelectedZone,
        dolor_eva: eva,
        nota: notes || `Dolor en zona ${zonaLabels[activeSelectedZone] || activeSelectedZone} registrado desde el mapa anatómico.`,
        pruebas_realizadas: null
      };

      try {
        // Save note in Express database
        await fetchJson(`${BACKEND_BASE}/api/notas-clinicas`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body)
        });

        // Hide editor and reset selection
        if (painMapEditor) painMapEditor.hidden = true;
        document.querySelectorAll('.pain-zone-path').forEach(p => p.classList.remove('active-selected'));

        // Refresh notes timeline & Ficha workspace
        const notasPayload = await fetchJson(`${BACKEND_BASE}/api/notas-clinicas?paciente_id=${fichaPatientId}`);
        if (fichaData) fichaData.notas = notasPayload.data || [];
        
        renderFichaHero(fichaData || {});
        renderFichaWorkspace(fichaData || {});
        renderFichaNotas(fichaData?.notas || []);
      } catch (err: any) {
        alert(`Error al guardar zona de dolor: ${err?.message || 'inténtelo de nuevo'}`);
      }
    });
  }

  // =======================================================
  // GEMINI COPILOT QUICK ACTION CARDS LOGIC
  // =======================================================
  const quickActionChips = document.querySelectorAll('.quick-action-chip');
  quickActionChips.forEach(chip => {
    chip.addEventListener('click', () => {
      const prompt = chip.getAttribute('data-prompt');
      if (!prompt) return;

      if (input) {
        input.value = prompt;
        // Trigger height adjustment of textarea if auto-growing
        input.dispatchEvent(new Event('input', { bubbles: true }));
        input.focus();
      }
    });
  });
</script>















