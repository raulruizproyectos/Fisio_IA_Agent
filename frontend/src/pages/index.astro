  const getPatientAgeLabel = (birthDate: string | null | undefined) => {
    if (!birthDate) return '';
    const birth = new Date(birthDate);
    if (Number.isNaN(birth.getTime())) return '';
    const today = new Date();
    let age = today.getFullYear() - birth.getFullYear();
    const monthDiff = today.getMonth() - birth.getMonth();
    if (monthDiff < 0 || (monthDiff === 0 && today.getDate() < birth.getDate())) age -= 1;
    return age > 0 ? `${age} anos` : '';
  };

  const getFichaLatestAppointment = (citas: any[] = []) =>
    [...citas]
      .filter((cita: any) => cita?.fecha_hora)
      .sort((a: any, b: any) => new Date(b.fecha_hora).getTime() - new Date(a.fecha_hora).getTime())[0] || null;

  const getFichaModuleAvailability = (key: string) => fichaModuleAvailability.get(key) || null;
  const isFichaModuleUnavailable = (key: string) => Boolean(getFichaModuleAvailability(key));
  const getFichaModuleMessage = (key: string, fallback: string) => getFichaModuleAvailability(key)?.message || fallback;
  const renderFichaUnavailableRow = (icon: string, colspan: number, message: string) => `
    <tr class="empty-row"><td colspan="${colspan}"><div class="empty-state"><span class="material-symbols-rounded">${icon}</span><p>${escapeHtml(message)}</p></div></td></tr>`;
  const renderFichaUnavailableInline = (message: string) => `<p class="empty-inline">${escapeHtml(message)}</p>`;
  const syncFichaAvailabilityUi = (modules: any[] = []) => {
    fichaModuleAvailability = new Map(
      (Array.isArray(modules) ? modules : [])
        .filter((item: any) => item?.key)
        .map((item: any) => [String(item.key), item]),
    );

    const unavailableModules = Array.from(fichaModuleAvailability.values());
    if (fichaAvailabilityNotice) {
      const needsMigration = unavailableModules.some((item: any) => item?.migration || item?.table);
      const primaryMessage = unavailableModules.find((item: any) => item?.key === 'legacy')?.message;
      fichaAvailabilityNotice.hidden = !unavailableModules.length;
      fichaAvailabilityNotice.textContent = unavailableModules.length
        ? primaryMessage || `Algunas secciones de la ficha no estan disponibles: ${unavailableModules.map((item: any) => item?.label || item?.key || 'modulo').join(', ')}.${needsMigration ? ' Revisa Configuracion > Conexiones y ejecuta las migraciones pendientes.' : ''}`
        : '';
      if (unavailableModules.length && needsMigration) fichaAvailabilityNotice.setAttribute('data-state', 'error');
      else fichaAvailabilityNotice.removeAttribute('data-state');
    }

    const notasUnavailable = getFichaModuleAvailability('notas');
    if (fichaAddNota) {
      fichaAddNota.disabled = Boolean(notasUnavailable);
      fichaAddNota.title = notasUnavailable?.message || '';
    }
    if (notasUnavailable && fichaNotaFormCard) fichaNotaFormCard.hidden = true;
