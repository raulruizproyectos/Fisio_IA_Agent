    }

    if (sendBtn) {
      if (busy && context === 'chat') {
        sendBtn.classList.add('is-loading');
        sendBtn.innerHTML = '<span class="material-symbols-rounded">hourglass_top</span>';
      } else {
        sendBtn.classList.remove('is-loading');
        sendBtn.innerHTML = sendBtnDefaultHtml;
      }
    }
  };
  const getStateHint = (icon: string, text: string) => {
    const normalized = String(text || '').toLowerCase();
    if (icon === 'cloud_off') return 'Reintenta en unos segundos. Si persiste, revisa backend y conectividad.';
    if (icon === 'search_off') return 'Prueba menos filtros o elimina la busqueda para recuperar resultados.';
    if (icon === 'person_off') return 'Crea la primera ficha para activar agenda, historial y documentos.';
    if (icon === 'event_busy') return 'Puedes crear una cita manual o revisar bloqueos externos de Calendar.';
    if (icon === 'sync' || normalized.includes('cargando') || normalized.includes('actualizando')) return 'Estamos sincronizando datos en tiempo real.';
    return '';
  };
  const renderState = (icon: string, text: string, compact = false, loading = false) => {
    const cls = compact ? 'empty-state-sm' : 'empty-state';
    const loadingCls = loading ? ' state-loading' : '';
    const hint = getStateHint(icon, text);
    return `<div class="${cls}${loadingCls}"><span class="material-symbols-rounded">${icon}</span><p>${escapeHtml(text)}</p>${hint ? `<small class="empty-state-hint">${escapeHtml(hint)}</small>` : ''}</div>`;
