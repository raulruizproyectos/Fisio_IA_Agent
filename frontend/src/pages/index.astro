      article.innerHTML = `<div class="msg-avatar"><span class="material-symbols-rounded">psychology</span></div><div class="msg-body"><span class="msg-sender">Agente IA</span><p>${escapeHtml(text)}</p></div>`;
    } else {
      article.innerHTML = `<div class="msg-body user-msg"><p>${escapeHtml(text)}</p></div>`;
    }
    log.appendChild(article);
    queueAssistantLayoutEnforce();
    scrollAssistantRailToBottom();
  };
  const setAgentStatus = (connected: boolean) => { agentDot?.classList.toggle('connected',connected); agentDot?.classList.toggle('disconnected',!connected); if(agentStatusText) agentStatusText.textContent=connected?'Conectado':'Sin conexion'; };
  const sendBtnDefaultHtml = sendBtn?.innerHTML || '';
  const updateExercisePdfButton = () => {
    if (!exercisePdfBtn) return;
    const hasReport = Boolean(lastExerciseReportPayload);
    exercisePdfBtn.hidden = false;
    exercisePdfBtn.disabled = !hasReport;
    exercisePdfBtn.classList.toggle('is-pending', !hasReport);
    exercisePdfBtn.classList.toggle('is-available', hasReport);
    exercisePdfBtn.innerHTML = hasReport
      ? '<span class="material-symbols-rounded">picture_as_pdf</span> Descargar PDF'
      : '<span class="material-symbols-rounded">picture_as_pdf</span> PDF al generar';
    exercisePdfBtn.title = hasReport ? 'Exportar a PDF' : 'Genera un plan y luego exportalo a PDF';
    exercisePdfBtn.setAttribute('aria-label', hasReport ? 'Descargar PDF del plan actual' : 'PDF disponible tras generar un plan');
    syncAssistantActionGrid();
  };
  const hasLinkedTelegramPatient = () => {
    const linkStatus = String(currentPatientTelegramLinkState?.link_status || '').trim();
    const chatId = String(currentPatientTelegramLinkState?.telegram_chat_id || '').trim();
    return linkStatus === 'linked' && Boolean(chatId);
  };
  const getCurrentReportDeliveryState = () => {
    if (!selectedPatientId) return null;
    const entry = deliveredExerciseReports.get(selectedPatientId);
    if (!entry) return null;
    const currentRecommendationId = String(lastExerciseReportPayload?.recommendation_id || '').trim() || null;
    if (currentRecommendationId && entry.recommendationId && currentRecommendationId !== entry.recommendationId) {
      return null;
    }
    return entry;
  };
  const renderAssistantDeliveryCard = () => {
    if (!assistantDeliveryCard || !assistantDeliveryStatus || !assistantDeliverySummary || !assistantDeliveryPills) return;

    if (!selectedPatientId || !lastExerciseReportPayload) {
      assistantDeliveryCard.hidden = true;
      assistantDeliveryPills.innerHTML = '';
      assistantDeliveryCard.classList.remove('is-ready', 'is-sent', 'is-blocked');
      return;
    }

    assistantDeliveryCard.hidden = false;
    const hasReport = Boolean(lastExerciseReportPayload);
    const telegramLinked = hasLinkedTelegramPatient();
    const deliveryState = getCurrentReportDeliveryState();
    const pill = (label: string, modifier = '') => '<span class="assistant-delivery-pill' + (modifier ? ' ' + modifier : '') + '">' + escapeHtml(label) + '</span>';

    assistantDeliveryCard.classList.remove('is-ready', 'is-sent', 'is-blocked');

    if (!telegramLinked) {
      assistantDeliveryStatus.textContent = 'Telegram pendiente de vincular';
      assistantDeliverySummary.textContent = 'Antes de enviar nada al paciente, completa el enlace de Telegram en su ficha para abrir el canal seguro.';
      assistantDeliveryPills.innerHTML = [
        pill('Telegram pendiente', 'is-warning'),
        pill(hasReport ? 'PDF listo' : 'PDF pendiente', hasReport ? 'is-ready' : 'is-soft')
      ].join('');
      assistantDeliveryCard.classList.add('is-blocked');
      return;
    }

    if (deliveryState) {
      assistantDeliveryStatus.textContent = 'Informe enviado al paciente';
      assistantDeliverySummary.textContent = 'El PDF ya se envio por Telegram en esta sesion. Si haces cambios en el plan, podras reenviarlo con el boton principal.';
      assistantDeliveryPills.innerHTML = [
        pill('Telegram vinculado', 'is-ready'),
        pill('PDF enviado', 'is-ready'),
        pill('Puedes reenviar', 'is-soft')
      ].join('');
      assistantDeliveryCard.classList.add('is-sent');
      return;
    }

    assistantDeliveryStatus.textContent = 'Plan listo para entregar';
    assistantDeliverySummary.textContent = 'El resumen ya esta revisado y el PDF esta preparado. El siguiente paso natural es enviarlo al paciente por Telegram o descargarlo.';
    assistantDeliveryPills.innerHTML = [
      pill('Telegram vinculado', 'is-ready'),
      pill('PDF listo', 'is-ready'),
      pill('Entrega pendiente', 'is-soft')
    ].join('');
    assistantDeliveryCard.classList.add('is-ready');
  };
  const updateExerciseTelegramButton = () => {
    if (!exerciseTelegramBtn) return;
    const hasPatient = Boolean(selectedPatientId);
    const hasReport = Boolean(lastExerciseReportPayload);
    const isLinked = hasLinkedTelegramPatient();
    exerciseTelegramBtn.hidden = false;
    exerciseTelegramBtn.disabled = !hasPatient || (isLinked && !hasReport);
    exerciseTelegramBtn.classList.toggle('is-pending', !isLinked || !hasReport);
    exerciseTelegramBtn.classList.toggle('is-available', isLinked && hasReport);

    if (!hasPatient) {
      exerciseTelegramBtn.innerHTML = '<span class="material-symbols-rounded">send</span> Telegram paciente';
      exerciseTelegramBtn.title = 'Selecciona un paciente para preparar el envio';
      exerciseTelegramBtn.setAttribute('aria-label', 'Selecciona un paciente para preparar el envio por Telegram');
      syncAssistantActionGrid();
      return;
    }

    if (!isLinked) {
      exerciseTelegramBtn.innerHTML = '<span class="material-symbols-rounded">link</span> Vincular Telegram';
      exerciseTelegramBtn.title = 'Este paciente aun no tiene Telegram vinculado';
      exerciseTelegramBtn.setAttribute('aria-label', 'Vincular Telegram del paciente');
      syncAssistantActionGrid();
      return;
    }

    if (!hasReport) {
      exerciseTelegramBtn.innerHTML = '<span class="material-symbols-rounded">send</span> Telegram al generar';
      exerciseTelegramBtn.title = 'Genera un plan antes de enviarlo al paciente';
      exerciseTelegramBtn.setAttribute('aria-label', 'Enviar por Telegram cuando el plan este generado');
      renderAssistantDeliveryCard();
      syncAssistantActionGrid();
      return;
    }

    if (getCurrentReportDeliveryState()) {
      exerciseTelegramBtn.innerHTML = '<span class="material-symbols-rounded">send</span> Reenviar Telegram';
      exerciseTelegramBtn.title = 'Reenviar el informe del plan al paciente por Telegram';
      exerciseTelegramBtn.setAttribute('aria-label', 'Reenviar informe al paciente por Telegram');
      renderAssistantDeliveryCard();
      syncAssistantActionGrid();
      return;
    }

    exerciseTelegramBtn.innerHTML = '<span class="material-symbols-rounded">send</span> Enviar Telegram';
    exerciseTelegramBtn.title = 'Enviar el informe del plan al paciente por Telegram';
    exerciseTelegramBtn.setAttribute('aria-label', 'Enviar informe al paciente por Telegram');
    renderAssistantDeliveryCard();
    syncAssistantActionGrid();
  };
  const setSending = (busy: boolean, context: 'generic' | 'exercise' | 'chat' = 'generic') => {
    if (sendBtn) sendBtn.disabled = busy;
    if (exerciseBtn) exerciseBtn.disabled = busy;
    if (exercisePdfBtn) {
      if (busy) {
        exercisePdfBtn.disabled = true;
      } else {
        updateExercisePdfButton();
      }
    }
    if (exerciseTelegramBtn) {
      if (busy) {
        exerciseTelegramBtn.disabled = true;
      } else {
        updateExerciseTelegramButton();
      }
    }
    if (input) input.disabled = busy;
    if (chatPatientSelect) chatPatientSelect.disabled = busy;
    inputArea?.classList.toggle('is-busy', busy);

    if (exerciseBtn) {
      const modeConfig = getActiveAssistantModeConfig();
      if (busy && context === 'exercise') {
        exerciseBtn.classList.add('is-loading');
        exerciseBtn.innerHTML = `<span class="material-symbols-rounded">hourglass_top</span> ${modeConfig.primaryBusyLabel}`;
      } else {
        exerciseBtn.classList.remove('is-loading');
        renderAssistantPrimaryButton();
