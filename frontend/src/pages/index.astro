    gap: 0.55rem;
  }
  .recommendation-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .recommendation-head h4 {
    margin: 0;
    font-size: 0.9rem;
    color: var(--text-primary);
  }
  .recommendation-head p {
    margin-top: 0.2rem;
    margin-bottom: 0;
    font-size: 0.78rem;
    color: var(--text-muted);
  }
  .recommendation-chips {
    display: flex;
    gap: 0.35rem;
    flex-wrap: wrap;
    justify-content: flex-end;
  }
  .recommendation-note {
    margin: 0;
    font-size: 0.82rem;
    color: var(--text-secondary);
  }
  .recommendation-section h5 {
    margin: 0 0 0.25rem;
    font-size: 0.8rem;
    color: var(--accent);
  }
  .recommendation-exercises {
    margin: 0;
    padding-left: 1rem;
    display: grid;
    gap: 0.22rem;
    color: var(--text-secondary);
    font-size: 0.8rem;
  }
  .recommendation-history-shell {
    display: grid;
    gap: 0.95rem;
  }

  @media (max-width: 720px) {
    .history-case-hero {
      display: grid;
    }
    .history-case-actions {
      justify-content: stretch;
    }
    .history-case-actions .btn-secondary,
    .history-case-actions .btn-ghost {
      flex: 1 1 100%;
      justify-content: center;
    }
  }
  .recommendation-summary-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
