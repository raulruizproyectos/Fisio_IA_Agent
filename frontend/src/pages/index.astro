---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Fisio IA Agent — CRM Clínico Inteligente">
  <div class="app-shell">
    <!-- SIDEBAR -->
    <aside class="sidebar" id="sidebar">
      <div class="sidebar-brand">
        <div class="brand-icon-wrapper">
          <span class="brand-icon material-symbols-rounded">medical_services</span>
        </div>
        <span class="brand-text">Fisio Platform</span>
      </div>

      <nav class="sidebar-nav">
        <a href="#" class="nav-item active" data-section="dashboard">
          <span class="material-symbols-rounded">home</span>
          <span class="nav-label">Inicio</span>
        </a>
        <a href="#" class="nav-item" data-section="pacientes">
          <span class="material-symbols-rounded">group</span>
          <span class="nav-label">Pacientes</span>
        </a>
        <a href="#" class="nav-item" data-section="citas">
          <span class="material-symbols-rounded">calendar_today</span>
          <span class="nav-label">Agenda</span>
        </a>
        <a href="#" class="nav-item nav-item-agent" id="focusAgentNav">
          <span class="material-symbols-rounded">psychology</span>
          <span class="nav-label">Copilot IA</span>
        </a>
        <a href="#" class="nav-item" data-section="plantillas">
          <span class="material-symbols-rounded">prescriptions</span>
          <span class="nav-label">Plantillas</span>
        </a>
        <a href="#" class="nav-item" data-section="pagos">
          <span class="material-symbols-rounded">payments</span>
          <span class="nav-label">Pagos</span>
        </a>
      </nav>

      <div class="sidebar-bottom">
        <div class="sidebar-section-label">Comunicaci&oacute;n</div>
        <a href="#" class="nav-item has-badge" data-section="intakes">
          <span class="material-symbols-rounded">forward_to_inbox</span>
          <span class="nav-label">Mensajes Intake</span>
          <span class="badge" id="intakeBadge">0</span>
        </a>
        <a href="#" class="nav-item" data-section="historial">
          <span class="material-symbols-rounded">folder_open</span>
          <span class="nav-label">Historial</span>
        </a>
        <a href="#" class="nav-item" data-section="config">
          <span class="material-symbols-rounded">settings</span>
          <span class="nav-label">Ajustes</span>
        </a>
      </div>
    </aside>
    <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

    <!-- MAIN -->
    <div class="main-area">
      <!-- HEADER -->
      <header class="topbar">
        <button class="sidebar-toggle" id="sidebarToggle" aria-label="Men&uacute;">
          <span class="material-symbols-rounded">menu</span>
        </button>
        <div class="search-box">
          <span class="material-symbols-rounded search-icon">search</span>
          <input type="text" id="searchInput" placeholder="Buscar paciente o email..." autocomplete="off" />
          <div class="search-results" id="searchResults" hidden></div>
        </div>
        <div class="topbar-right">
          <button class="assistant-launch-btn" id="assistantRailToggle" type="button" aria-label="Abrir copilot cl&iacute;nico" aria-controls="assistantRail" aria-expanded="false">
            <span class="material-symbols-rounded">right_panel_open</span>
            <span>Copilot</span>
          </button>
          <button class="icon-btn topbar-notif-btn" aria-label="Notificaciones" id="notifBtn">
            <span class="material-symbols-rounded">notifications</span>
            <span class="dot-indicator"></span>
          </button>
          <div class="user-pill">
            <div class="avatar">RR</div>
            <span class="user-name">Dr. Ra&uacute;l Ruiz</span>
          </div>
        </div>
      </header>

      <!-- CONTENT -->
      <div class="workspace-shell">
        <main class="content">
        <!-- === PAGE: DASHBOARD === -->
        <div class="page-section active" data-page="dashboard">
          <div class="dashboard-layout">
            
            <!-- Hero Section -->
            <section class=”hero-section”>
              <div class=”hero-content”>
                <h1 class=”hero-title”>Panel cl&iacute;nico de hoy</h1>
                <p class=”hero-subtitle”>Supervisa pacientes, agenda y recomendaciones IA con trazabilidad cl&iacute;nica en tiempo real.</p>
              </div>
              <div class=”hero-actions”>
                <button class=”btn-primary btn-primary-teal” id=”heroAgentShortcutBtn”><span class=”material-symbols-rounded”>psychology</span> Nueva recomendaci&oacute;n</button>
              </div>
            </section>

            <!-- Metrics -->
            <section class=”metrics-row clinical-metrics”>
              <div class=”metric-card metric-card-v2”>
                <div class=”metric-icon metric-icon-blue”><span class=”material-symbols-rounded”>group</span></div>
                <div class=”metric-data”><span class=”metric-value” id=”metricPacientes”>&mdash;</span><span class=”metric-label”>Pacientes Activos</span></div>
              </div>
              <div class=”metric-card metric-card-v2”>
                <div class=”metric-icon metric-icon-emerald”><span class=”material-symbols-rounded”>event_available</span></div>
                <div class=”metric-data”><span class=”metric-value” id=”metricSesiones”>&mdash;</span><span class=”metric-label”>Citas Hoy</span></div>
              </div>
              <div class=”metric-card metric-card-v2”>
                <div class=”metric-icon metric-icon-indigo”><span class=”material-symbols-rounded”>description</span></div>
                <div class=”metric-data”><span class=”metric-value” id=”metricInformes”>0</span><span class=”metric-label”>Informes IA archivados</span></div>
              </div>
              <div class=”metric-card metric-card-v2”>
                <div class=”metric-icon metric-icon-amber”><span class=”material-symbols-rounded”>monitoring</span></div>
                <div class=”metric-data”><span class=”metric-value” id=”metricEngineOps”>0/0</span><span class=”metric-label”>Timeouts / Reintentos IA</span></div>
              </div>
            </section>

            <!-- Bottom Row: Citas y Actividad -->
            <div class="dashboard-bottom-row">
              <section class="card widget-card">
                <header class="card-header">
                  <h2>Agenda inmediata</h2>
                  <button class="btn-ghost" onclick="document.querySelector('[data-section=\'citas\']').click()"><span class="material-symbols-rounded">arrow_forward</span> Ver todas</button>
                </header>
                <div class="widget-body list-clean" id="dashCitasBody">
                  <div class="empty-state-sm state-loading">
                    <span class="material-symbols-rounded">sync</span>
                    <p>Actualizando agenda...</p>
                  </div>
                </div>
              </section>
              
              <section class="card widget-card">
                <header class="card-header">
                  <h2>Mensajes de pacientes</h2>
                  <button class="btn-ghost" id="refreshIntakes"><span class="material-symbols-rounded">refresh</span></button>
                </header>
                <div class="widget-body list-clean" id="intakeBody">
                  <div class="empty-state-sm state-loading">
                    <span class="material-symbols-rounded">sync</span>
                    <p>Actualizando bandeja...</p>
                  </div>
                </div>
              </section>
            </div>

          </div>
        </div>

        <!-- === PAGE: PACIENTES === -->
        <div class="page-section" data-page="pacientes">
          <div class="page-header-row">
            <h1 class="page-title"><span class="material-symbols-rounded">group</span> Pacientes</h1>
            <button class="btn-primary" id="addPatientBtn"><span class="material-symbols-rounded">person_add</span> Nuevo paciente</button>
          </div>
          <section class="card table-card">
            <header class="card-header"><h2>Lista de pacientes</h2><button class="btn-ghost" id="refreshPacientes"><span class="material-symbols-rounded">refresh</span> Actualizar</button></header>
            <div class="table-wrap"><table><thead><tr><th>Nombre</th><th>Email</th><th>Fecha nac.</th><th>Registro</th><th>Acciones</th></tr></thead><tbody id="pacientesBody"><tr class="empty-row"><td colspan="5"><div class="empty-state"><span class="material-symbols-rounded">hourglass_empty</span><p>Cargando pacientes...</p></div></td></tr></tbody></table></div>
          </section>
        </div>

        <div class="modal-shell" id="patientModal" aria-hidden="true">
          <div class="modal-panel" role="dialog" aria-modal="true" aria-labelledby="patientModalTitle">
            <div class="modal-header">
              <div class="modal-title-group">
                <p class="modal-eyebrow">CRM</p>
                <h2 id="patientModalTitle">Alta de paciente</h2>
                <p>Registra un paciente nuevo y dejalo listo para historial, chat clínico y plantillas.</p>
              </div>
              <button type="button" class="modal-close" id="closePatientModalBtn" aria-label="Cerrar formulario de paciente">
                <span class="material-symbols-rounded">close</span>
              </button>
            </div>

            <form id="patientForm" class="patient-form">
              <div class="form-grid">
                <label class="field field-full">
                  <span>Nombre completo</span>
                  <input id="patientNameInput" name="nombre_completo" type="text" placeholder="Ej.: Maria Lopez Garcia" autocomplete="name" required />
                </label>
                <label class="field">
                  <span>Email</span>
                  <input id="patientEmailInput" name="email" type="email" placeholder="paciente@correo.com" autocomplete="email" />
                </label>
                <label class="field">
                  <span>Telefono</span>
                  <input id="patientPhoneInput" name="phone" type="tel" placeholder="+34 600 123 456" autocomplete="tel" />
                </label>
                <label class="field">
                  <span>Fecha de nacimiento</span>
                  <input id="patientBirthDateInput" name="fecha_nacimiento" type="date" autocomplete="bday" />
                </label>
              </div>

              <p class="form-feedback" id="patientFormFeedback" hidden></p>

              <div class="modal-actions">
                <button type="button" class="btn-ghost" id="patientModalDismiss">Cancelar</button>
                <button type="submit" class="btn-primary" id="patientSubmitBtn">
                  <span class="material-symbols-rounded">save</span>
                  Guardar paciente
                </button>
              </div>
            </form>
          </div>
        </div>

        <!-- === PAGE: PLANTILLAS === -->
        <div class="page-section" data-page="plantillas">
          <div class="page-header-row">
            <h1 class="page-title"><span class="material-symbols-rounded">library_books</span> Plantillas Terapéuticas</h1>
            <div class="page-tools">
              <label class="inline-field">
                <span>Paciente destino</span>
                <select id="templateTargetPatient">
                  <option value="">Selecciona paciente</option>
                </select>
              </label>
              <button class="btn-ghost" id="refreshTemplates"><span class="material-symbols-rounded">refresh</span> Actualizar</button>
            </div>
          </div>
          <section class="card table-card">
            <header class="card-header"><h2>Plantillas más reútilizadas</h2></header>
            <div class="table-wrap">
              <table>
                <thead>
                  <tr>
                    <th>Título</th>
                    <th>Usos</th>
                    <th>Ejercicios</th>
                    <th>Último uso</th>
                    <th>Origen</th>
                    <th>Acción</th>
                  </tr>
                </thead>
                <tbody id="templatesBody">
                  <tr class="empty-row">
                    <td colspan="6">
                      <div class="empty-state">
                        <span class="material-symbols-rounded">hourglass_empty</span>
                        <p>Cargando plantillas...</p>
                      </div>
                    </td>
                  </tr>
                </tbody>
              </table>
            </div>
          </section>
        </div>

        <!-- === PAGE: INTAKES === -->
        <div class="page-section" data-page="intakes">
          <div class="page-header-row">
            <h1 class="page-title"><span class="material-symbols-rounded">assignment</span> Intakes Pendientes</h1>
          </div>
          <section class="card table-card">
            <header class="card-header"><h2>Mensajes de ingesta por revisar</h2><button class="btn-ghost" id="refreshIntakesFull"><span class="material-symbols-rounded">refresh</span> Actualizar</button></header>
            <div class="table-wrap"><table><thead><tr><th>Paciente</th><th>Fuente</th><th>Mensaje</th><th>Alertas</th><th>Fecha</th><th>Estado</th><th>Acciones</th></tr></thead><tbody id="intakesFullBody"><tr class="empty-row"><td colspan="7"><div class="empty-state"><span class="material-symbols-rounded">hourglass_empty</span><p>Cargando intakes...</p></div></td></tr></tbody></table></div>
          </section>
        </div>

        <!-- === PAGE: CITAS === -->
        <div class="page-section" data-page="citas">
          <div class="page-header-row">
            <h1 class="page-title"><span class="material-symbols-rounded">calendar_month</span> Agenda</h1>
            <div class="week-nav-bar">
              <button class="btn-ghost btn-icon" id="prevWeek" title="Semana anterior"><span class="material-symbols-rounded">chevron_left</span></button>
              <span id="weekLabel" class="week-label">Cargando...</span>
              <button class="btn-ghost btn-icon" id="nextWeek" title="Semana siguiente"><span class="material-symbols-rounded">chevron_right</span></button>
              <button class="btn-ghost" id="thisWeek">Hoy</button>
              <button class="btn-ghost btn-icon" id="refreshCitas" title="Actualizar"><span class="material-symbols-rounded">refresh</span></button>
            </div>
          </div>
          <section class="card agenda-cal-card">
            <div id="agendaCalendar" class="agenda-calendar">
              <div class="agenda-cal-loading"><span class="material-symbols-rounded">sync</span> Cargando...</div>
            </div>
          </section>
          <section class="card table-card">
            <header class="card-header">
              <h2>Pacientes esta semana <span class="badge-week-count" id="weekPatientCount"></span></h2>
            </header>
            <div class="table-wrap">
              <table>
                <thead><tr><th>Paciente</th><th>Día</th><th>Hora</th><th>Motivo</th><th>Canal</th><th>Estado</th></tr></thead>
                <tbody id="citasBody"><tr class="empty-row"><td colspan="6"><div class="empty-state"><span class="material-symbols-rounded">hourglass_empty</span><p>Cargando agenda...</p></div></td></tr></tbody>
              </table>
            </div>
          </section>
        </div>

        <!-- === PAGE: HISTORIAL === -->
        <div class="page-section" data-page="historial">
          <div class="page-header-row">
            <h1 class="page-title"><span class="material-symbols-rounded">history</span> Historial</h1>
          </div>
          <section class="card">
            <header class="card-header"><h2>Notas de seguimiento</h2><button class="btn-ghost" id="refreshHistorial"><span class="material-symbols-rounded">refresh</span> Actualizar</button></header>
            <div id="historialContent" class="section-body"><div class="empty-state"><span class="material-symbols-rounded">history</span><p>Selecciona un paciente para ver su historial</p></div></div>
          </section>
        </div>

        <!-- === PAGE: PAGOS === -->
        <div class="page-section" data-page="pagos">
          <div class="page-header-row">
            <h1 class="page-title"><span class="material-symbols-rounded">payments</span> Pagos</h1>
            <button class="btn-primary" id="addPagoBtn">
              <span class="material-symbols-rounded">add_card</span> Registrar pago
            </button>
          </div>

          <!-- Filtros y resumen -->
          <section class="card pagos-filters-card">
            <div class="pagos-filters-row">
              <label class="pagos-filter">
                <span>A&ntilde;o</span>
                <select id="pagosAnioFilter"></select>
              </label>
              <label class="pagos-filter">
                <span>Mes</span>
                <select id="pagosMesFilter">
                  <option value="">Todos</option>
                  <option value="1">Enero</option><option value="2">Febrero</option><option value="3">Marzo</option>
                  <option value="4">Abril</option><option value="5">Mayo</option><option value="6">Junio</option>
                  <option value="7">Julio</option><option value="8">Agosto</option><option value="9">Septiembre</option>
                  <option value="10">Octubre</option><option value="11">Noviembre</option><option value="12">Diciembre</option>
                </select>
              </label>
              <label class="pagos-filter">
                <span>M&eacute;todo</span>
                <select id="pagosMetodoFilter">
                  <option value="">Todos</option>
                  <option value="efectivo">Efectivo</option>
                  <option value="tarjeta">Tarjeta</option>
                </select>
              </label>
              <button class="btn-ghost" id="refreshPagos"><span class="material-symbols-rounded">refresh</span></button>
            </div>
            <div class="pagos-summary-row" id="pagosSummary">
              <div class="pagos-stat"><span class="pagos-stat-label">Total</span><span class="pagos-stat-value" id="pagosTotalImporte">0 &euro;</span></div>
              <div class="pagos-stat"><span class="pagos-stat-label">Sesiones</span><span class="pagos-stat-value" id="pagosTotalSesiones">0</span></div>
              <div class="pagos-stat"><span class="pagos-stat-label">Efectivo</span><span class="pagos-stat-value" id="pagosTotalEfectivo">0 &euro;</span></div>
              <div class="pagos-stat"><span class="pagos-stat-label">Tarjeta</span><span class="pagos-stat-value" id="pagosTotalTarjeta">0 &euro;</span></div>
            </div>
          </section>

          <!-- Informe mensual -->
          <section class="card pagos-report-card" id="pagosReportCard" hidden>
            <header class="card-header">
              <h2 id="pagosReportTitle">Informe anual</h2>
              <button class="btn-ghost" id="togglePagosReport"><span class="material-symbols-rounded">bar_chart</span> Ver informe</button>
            </header>
            <div class="table-wrap">
              <table>
                <thead>
                  <tr><th>Mes</th><th>Sesiones</th><th>Efectivo</th><th>Tarjeta</th><th>Total</th></tr>
                </thead>
                <tbody id="pagosReportBody"></tbody>
                <tfoot id="pagosReportFoot"></tfoot>
              </table>
            </div>
          </section>

          <!-- Tabla de pagos -->
          <section class="card table-card">
            <header class="card-header">
              <h2>Listado de pagos</h2>
              <button class="btn-ghost" id="togglePagosReportBtn"><span class="material-symbols-rounded">bar_chart</span> Informe mensual</button>
            </header>
            <div class="table-wrap">
              <table>
                <thead>
                  <tr>
                    <th>Fecha</th>
                    <th>Paciente</th>
                    <th>Concepto</th>
                    <th>M&eacute;todo</th>
                    <th class="text-right">Importe</th>
                    <th>Acciones</th>
                  </tr>
                </thead>
                <tbody id="pagosBody">
                  <tr class="empty-row"><td colspan="6"><div class="empty-state"><span class="material-symbols-rounded">hourglass_empty</span><p>Cargando pagos...</p></div></td></tr>
                </tbody>
              </table>
            </div>
          </section>
        </div>

        <!-- Modal: Nuevo/Editar Pago -->
        <div class="modal-shell" id="pagoModal" aria-hidden="true">
          <div class="modal-panel" role="dialog" aria-modal="true" aria-labelledby="pagoModalTitle">
            <div class="modal-header">
              <div class="modal-title-group">
                <p class="modal-eyebrow">PAGOS</p>
                <h2 id="pagoModalTitle">Registrar pago</h2>
                <p>Registra el cobro de una sesi&oacute;n de fisioterapia.</p>
              </div>
              <button type="button" class="modal-close" id="closePagoModalBtn" aria-label="Cerrar"><span class="material-symbols-rounded">close</span></button>
            </div>
            <form id="pagoForm" class="patient-form">
              <input type="hidden" id="pagoEditId" value="" />
              <div class="form-grid">
                <label class="field field-full">
                  <span>Paciente</span>
                  <div class="pagos-patient-search-wrap">
                    <input id="pagoPacienteSearch" type="text" placeholder="Buscar paciente por nombre..." autocomplete="off" required />
                    <input type="hidden" id="pagoPacienteId" />
                    <div class="pagos-patient-dropdown" id="pagoPacienteDropdown" hidden></div>
                  </div>
                </label>
                <label class="field">
                  <span>Fecha</span>
                  <input id="pagoFechaInput" name="fecha" type="date" required />
                </label>
                <label class="field">
                  <span>Importe (&euro;)</span>
                  <input id="pagoImporteInput" name="importe" type="number" step="0.01" min="0.01" placeholder="35.00" required />
                </label>
                <label class="field">
                  <span>M&eacute;todo de pago</span>
                  <select id="pagoMetodoInput" name="metodo_pago" required>
                    <option value="efectivo">Efectivo</option>
                    <option value="tarjeta">Tarjeta</option>
                  </select>
                </label>
                <label class="field">
                  <span>Concepto</span>
                  <input id="pagoConceptoInput" name="concepto" type="text" value="Sesion de fisioterapia" />
                </label>
                <label class="field field-full">
                  <span>Notas (opcional)</span>
                  <textarea id="pagoNotasInput" name="notas" rows="2" placeholder="Notas adicionales..."></textarea>
                </label>
              </div>
              <p class="form-feedback" id="pagoFormFeedback" hidden></p>
              <div class="modal-actions">
                <button type="button" class="btn-ghost" id="pagoModalDismiss">Cancelar</button>
                <button type="submit" class="btn-primary" id="pagoSubmitBtn">
                  <span class="material-symbols-rounded">save</span> Guardar pago
                </button>
              </div>
            </form>
          </div>
        </div>

        <!-- === PAGE: CONFIG === -->
        <div class="page-section" data-page="config">
          <div class="page-header-row">
            <h1 class="page-title"><span class="material-symbols-rounded">settings</span> Configuración</h1>
          </div>
          <div class="config-grid">
            <section class="card">
              <header class="card-header"><h2>Conexiones</h2></header>
              <div class="section-body">
                <div class="config-item"><span class="config-label">Backend API</span><span class="config-value" id="cfgBackend">—</span><span class="status-chip" id="cfgBackendStatus">—</span></div>
                <div class="config-item"><span class="config-label">Agente n8n</span><span class="config-value" id="cfgAgent">—</span><span class="status-chip" id="cfgAgentStatus">—</span></div>
              </div>
            </section>
            <section class="card">
              <header class="card-header"><h2>Proyecto</h2></header>
              <div class="section-body">
                <div class="config-item"><span class="config-label">Versión</span><span class="config-value">0.0.1</span></div>
                <div class="config-item"><span class="config-label">Stack</span><span class="config-value">Astro + Express + Supabase + n8n</span></div>
                <div class="config-item"><span class="config-label">Repositorio</span><a href="https://github.com/raulruizproyectos/Fisio_IA_Agent" target="_blank" class="config-link">GitHub &#x2197;</a></div>
              </div>
            </section>
          </div>
        </div>
      </main>

      <aside class="assistant-rail" id="assistantRail" aria-label="Copilot clinico">
        <section class="ai-clinical-module card assistant-rail-card">
          <header class="module-header assistant-module-header">
            <div class="assistant-rail-copy">
              <div class="assistant-rail-header-row">
                <span class="assistant-eyebrow">COPILOT CL&Iacute;NICO</span>
                <div class="assistant-connected-badge">
                  <span class="status-dot connected pulse-dot" id="agentDot"></span>
                  <span class="status-text" id="agentStatusText">CONECTADO</span>
                </div>
              </div>
              <h2>Asistente cl&iacute;nico IA</h2>
            </div>
            <div class="assistant-rail-tools">
              <button type="button" class="assistant-rail-close" id="assistantRailClose" aria-label="Cerrar copilot">
                <span class="material-symbols-rounded">close</span>
              </button>
            </div>
          </header>

          <div class="assistant-rail-body">
            <section class="assistant-console" aria-label="Consola clinica">
              <div class="assistant-toolbar">
                <div class="patient-selector assistant-console-selector">
                  <span class="material-symbols-rounded">person</span>
                  <select id="chatPatientSelect" aria-label="Paciente del informe">
                    <option value="">Selecciona paciente para informe...</option>
                  </select>
                </div>
                <div class="assistant-live-context" aria-live="polite">
