      requestOpenAssistantRail();
      setAssistantMode(mode);
      if (input) {
        input.value = prompt;
        input.dispatchEvent(new Event('input', { bubbles: true }));
        input.focus();
        input.setSelectionRange(input.value.length, input.value.length);
      }
    });
  });

  assistantModeButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const mode = String(button.getAttribute('data-assistant-mode') || '') as AssistantWorkMode;
      if (!mode || !(mode in assistantModeConfig)) return;
      requestOpenAssistantRail();
      setAssistantMode(mode, { focus: true });
      queueAssistantLayoutEnforce();
    });
  });

  document.addEventListener('click', (event) => {
    const trigger = (event.target as HTMLElement | null)?.closest(
      '#assistantRailToggle, #assistantRailFab, [data-mobile-action="open-copilot"], [data-dashboard-action="open-copilot"]'
