  @media (max-width: 480px) {
    .exercise-card {
      flex-direction: column;
    }
    .exercise-card-img {
      width: 100%;
      height: 120px;
    }
  }

  /* === APP SHELL === */
  .app-shell {
    display: flex;
    min-height: 100vh;
  }

  /* === SIDEBAR === */
  .sidebar {
    width: 240px;
    min-width: 240px;
    background: linear-gradient(180deg, #0e1728 0%, #0b1322 100%);
    border-right: 1px solid var(--border);
