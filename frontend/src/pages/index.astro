  .assistant-rail .assistant-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 0.75rem;
    border-bottom: 1px solid #f1f5f9;
    background: #ffffff;
  }

  .assistant-rail .assistant-console-selector {
    flex: 1 1 100%;
    min-width: 0;
  }

  .assistant-rail .assistant-live-context {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap; border: 0;
  }

  .assistant-rail .patient-selector {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 2rem;
    padding: 0.3rem 0.6rem;
    border-radius: 0.6rem;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    color-scheme: light;
    transition: border-color 0.18s ease-out, box-shadow 0.18s ease-out;
  }

  .assistant-rail .patient-selector:focus-within {
    border-color: #14b8a6;
    box-shadow: 0 0 0 3px rgba(20, 184, 166, 0.1);
    background: #ffffff;
  }

  .assistant-rail .patient-selector select {
    border: none;
    appearance: none;
    -webkit-appearance: none;
    -moz-appearance: none;
    background: transparent;
    font: inherit;
    font-size: 0.8rem;
    font-weight: 600;
    color: #64748b !important;
    -webkit-text-fill-color: #64748b !important;
    color-scheme: light;
    outline: none;
    width: 100%;
    min-width: 0;
    cursor: pointer;
  }

  .assistant-rail .patient-selector.has-value select,
  .assistant-rail .patient-selector select.has-value {
    color: #1e293b !important;
    -webkit-text-fill-color: #1e293b !important;
  }

  .assistant-rail .patient-selector select:disabled {
    color: #64748b !important;
    -webkit-text-fill-color: #64748b !important;
    opacity: 1;
    cursor: not-allowed;
  }

  .assistant-rail .patient-selector option {
    background: #ffffff;
    color: #0f172a;
  }

  .assistant-rail .patient-selector .material-symbols-rounded {
    color: #0d9488;
    font-size: 0.95rem;
  }

  /* --- Chat area --- */
  .assistant-rail .assistant-dialog-surface {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    background: #f8fafc;
    color: #475569;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-gutter: stable;
    gap: 0.75rem;
    padding: 0.8rem 0.75rem 0.9rem;
  }

  .assistant-rail .chat-log {
    flex: 0 1 auto;
    min-height: 6.25rem;
    max-height: min(30vh, 16rem);
    overflow-y: auto;
    padding: 0.8rem;
    background: rgba(255, 255, 255, 0.92);
    border: 1px solid #d8e5ed;
    border-radius: 1rem;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.6);
    gap: 0.7rem;
  }

  .assistant-rail .chat-log:empty {
    display: none;
  }

  .assistant-rail .chat-log:empty::before {
    content: none;
    display: none;
  }

  /* --- Messages --- */
  .assistant-rail .msg {
    max-width: 90%;
    gap: 0.4rem;
    animation: msg-in 0.18s cubic-bezier(0.23, 1, 0.32, 1);
  }

  .assistant-rail .msg.agent { align-self: flex-start; }
  .assistant-rail .msg.user { align-self: flex-end; }

  .assistant-rail .msg-avatar {
    width: 1.3rem;
    height: 1.3rem;
    border-radius: 0.35rem;
    background: #0d9488;
    border: none;
    color: #ffffff;
    box-shadow: none;
  }

  .assistant-rail .msg-avatar .material-symbols-rounded {
    font-size: 0.8rem;
    color: inherit;
  }

  .assistant-rail .msg.user .msg-avatar { display: none; }

  .assistant-rail .msg-body {
    box-shadow: none;
    border-radius: 1rem;
    padding: 0.65rem 0.8rem;
    font-size: 0.82rem;
    line-height: 1.55;
  }

  .assistant-rail .msg.agent .msg-body {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    color: #475569;
    border-top-left-radius: 0.25rem;
  }

  .assistant-rail .msg.agent .msg-body * { color: inherit; }

  .assistant-rail .msg.user .msg-body,
  .assistant-rail .msg-body.user-msg {
    background: #0d9488;
    border: none;
    color: #ffffff;
    border-top-right-radius: 0.25rem;
    box-shadow: 0 4px 12px -4px rgba(13, 148, 136, 0.35);
  }

  .assistant-rail .msg.user .msg-body *,
  .assistant-rail .msg-body.user-msg * { color: inherit; }

  .assistant-rail .msg-sender {
    display: block;
    margin-bottom: 0.25rem;
    font-size: 0.62rem;
    font-weight: 700;
    color: #94a3b8;
  }

  .assistant-rail .msg.agent .msg-sender { color: #64748b; }
  .assistant-rail .msg-body p { margin: 0; white-space: pre-line; }

  .assistant-rail .msg-progress .msg-avatar { background: #0f172a; }

  .assistant-rail .msg-progress .msg-body {
    background: #ffffff;
    border: 1px dashed #cbd5e1;
    color: #64748b;
  }

  /* --- Exercise report components --- */
  .assistant-rail .exercise-report {
    display: grid;
    gap: 0.6rem;
    color: #475569;
  }

  .assistant-rail .exercise-alert {
    background: #fff1f2;
    border: 1px solid #fecdd3;
    color: #be123c;
    padding: 0.55rem 0.7rem;
    border-radius: 0.75rem;
    margin-bottom: 0;
  }

  .assistant-rail .exercise-note,
  .assistant-rail .exercise-summary,
  .assistant-rail .exercise-patient-msg {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 0.75rem;
    color: #64748b;
    padding: 0.55rem 0.7rem;
    margin: 0;
  }

  .assistant-rail .exercise-summary strong,
  .assistant-rail .exercise-note strong,
  .assistant-rail .exercise-patient-msg strong,
  .assistant-rail .exercise-card-why strong,
  .assistant-rail .exercise-id strong { color: #334155; }

  .assistant-rail .exercise-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 0.75rem;
    padding: 0.6rem;
    margin-bottom: 0;
    box-shadow: 0 2px 8px -4px rgba(15, 23, 42, 0.08);
  }

  .assistant-rail .exercise-card:hover { border-color: #cbd5e1; }
  .assistant-rail .exercise-card-img { background: #eff6ff; border: 1px solid #dbeafe; }
  .assistant-rail .exercise-card-title { color: #334155; }
  .assistant-rail .exercise-zona { color: #0f766e; background: rgba(15, 118, 110, 0.1); }

  .assistant-rail .exercise-card-pauta,
  .assistant-rail .exercise-card-proc,
  .assistant-rail .exercise-card-why,
  .assistant-rail .exercise-id { color: #64748b; }

  .assistant-rail .exercise-card-caution { color: #b45309; }

  /* --- Input area (compact) --- */
  .assistant-rail .ai-input-area {
    flex-shrink: 0;
    margin-top: 0;
    background: #ffffff;
    border-top: 1px solid #f1f5f9;
    box-shadow: 0 -1px 4px -2px rgba(15, 23, 42, 0.04);
    padding: 0.65rem 0.75rem 0.55rem;
    min-width: 0;
    max-height: none;
    overflow: visible;
    gap: 0.35rem;
    position: sticky;
    bottom: 0;
    z-index: 3;
    border-radius: 1rem 1rem 0 0;
    margin-top: auto;
  }

  .assistant-rail .assistant-action-grid {
    display: flex;
    gap: 0.35rem;
  }

  .assistant-rail .assistant-composer-shell {
    display: flex;
    align-items: flex-end;
    gap: 0.5rem;
    padding: 0;
    border: none;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
  }

  .assistant-rail .ai-textarea-wrapper {
    background: #fcfeff;
    border: 1px solid #d7e4ec;
    border-radius: 0.8rem;
    box-shadow: 0 10px 24px -24px rgba(15, 23, 42, 0.22);
    flex: 1 1 auto;
    transition: border-color 0.18s ease-out, box-shadow 0.18s ease-out, background 0.18s ease-out;
  }

  .assistant-rail .ai-textarea-wrapper:focus-within {
    background: #ffffff;
    border-color: #14b8a6;
    box-shadow: 0 0 0 3px rgba(20, 184, 166, 0.1);
  }

  .assistant-rail .ai-textarea-wrapper textarea {
    width: 100%;
    min-height: 4.15rem;
    height: 4.15rem;
    max-height: 9rem;
    border: none;
    background: transparent;
    color: #10233d;
    -webkit-text-fill-color: #10233d;
    caret-color: #0d9488;
    line-height: 1.52;
    padding: 0.82rem 0.88rem;
    resize: none;
    outline: none;
    overflow-y: auto;
    font-size: 0.9rem;
    font-weight: 500;
  }

  .assistant-rail .ai-textarea-wrapper textarea::placeholder {
    color: #6f8599;
    opacity: 1;
  }

  .assistant-rail .assistant-disclaimer {
    margin: 0;
    text-align: center;
    font-size: 0.65rem;
    line-height: 1.4;
    color: #6f8599;
  }

  /* --- Action buttons --- */
  .assistant-rail .btn-action {
    border: 1px solid transparent;
    border-radius: 0.55rem;
    min-height: 1.75rem;
    padding: 0.25rem 0.6rem;
    font-size: 0.7rem;
    font-weight: 700;
    justify-content: center;
    flex: 1 1 auto;
    cursor: pointer;
    transition: transform 0.12s ease-out, background 0.15s ease-out, border-color 0.15s ease-out;
  }

  .assistant-rail .btn-action:active { transform: scale(0.97); }

  .assistant-rail .btn-action .material-symbols-rounded { font-size: 0.9rem; }

  .assistant-rail .btn-action:disabled {
    background: #eef4f7 !important;
    border-color: #bfd0dc !important;
    border-style: dashed !important;
    color: #5f7488 !important;
    box-shadow: none !important;
    cursor: not-allowed;
    opacity: 1;
    transform: none !important;
  }

  .assistant-rail .btn-action:disabled .material-symbols-rounded {
    color: #5f7488 !important;
    opacity: 1;
  }

  .assistant-rail .btn-pdf,
  .assistant-rail .btn-chat,
  .assistant-rail .btn-telegram {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    color: #475569;
  }

  .assistant-rail .btn-pdf.is-pending,
  .assistant-rail .btn-telegram.is-pending {
    background: #eef4f7;
    border: 1px dashed #9fb6c7;
    color: #456176;
  }

  .assistant-rail .btn-pdf.is-available,
  .assistant-rail .btn-telegram.is-available {
    background: #ffffff;
    border-style: solid;
    color: #334155;
  }

  .assistant-rail .btn-pdf:hover,
  .assistant-rail .btn-chat:hover,
  .assistant-rail .btn-telegram:hover {
    background: #f8fafc !important;
    border-color: #cbd5e1 !important;
    color: #334155 !important;
  }

  .assistant-rail .btn-generate {
    background: #0d9488;
    border-color: #0d9488;
    color: #ffffff;
    box-shadow: 0 2px 8px -3px rgba(13, 148, 136, 0.4);
  }

  .assistant-rail .btn-generate .material-symbols-rounded { color: #ffffff; }

  .assistant-rail .btn-generate:hover {
    background: #0f766e;
    border-color: #0f766e;
  }

  .assistant-rail .btn-send-compact {
    width: 2.1rem;
    min-width: 2.1rem;
    min-height: 2.1rem;
    padding: 0;
    background: #0d9488;
    border-color: #0d9488;
    color: #ffffff;
    border-radius: 0.55rem;
    align-self: flex-end;
    flex: 0 0 auto;
    box-shadow: 0 2px 8px -3px rgba(13, 148, 136, 0.4);
  }

  .assistant-rail .btn-send-compact:hover {
    background: #0f766e !important;
    border-color: #0f766e !important;
    color: #ffffff !important;
  }

  /* --- Responsive --- */
  @media (max-width: 1100px) {
    .assistant-rail .assistant-rail-body { padding: 0; }

    .assistant-rail .assistant-toolbar,
    .assistant-rail .chat-log,
    .assistant-rail .ai-input-area {
      padding-left: 0.75rem;
      padding-right: 0.75rem;
    }
  }

  @media (max-width: 768px) {
    .assistant-rail .assistant-module-header { padding: 0.6rem 0.75rem; }
    .assistant-rail .assistant-rail-copy h2 { font-size: 0.85rem; }
    .assistant-rail .assistant-toolbar { padding: 0.5rem 0.75rem; }

    .assistant-rail .chat-log,
    .assistant-rail .ai-input-area {
      padding-left: 0.75rem;
      padding-right: 0.75rem;
    }

    .assistant-rail .assistant-composer-shell { align-items: stretch; }

    .assistant-rail .btn-send-compact {
      width: 2.1rem;
      min-width: 2.1rem;
      min-height: 2.1rem;
    }
  }


  .btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    min-height: 3rem;
    padding: 0.82rem 1.15rem;
    border: 1px solid #bfd8e3;
    border-radius: 0.95rem;
    background: linear-gradient(180deg, #ffffff 0%, #eff7fa 100%);
    color: #13405e;
    font-weight: 700;
    box-shadow: 0 12px 22px -22px rgba(15, 23, 42, 0.34);
    transition: transform 160ms ease-out, box-shadow 160ms ease-out, border-color 160ms ease-out;
  }

  .btn-secondary:hover {
    transform: translateY(-1px);
    border-color: #a9cbd9;
    box-shadow: 0 18px 28px -24px rgba(15, 23, 42, 0.36);
  }

  .cockpit-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.65fr) minmax(18rem, 0.95fr);
    gap: 1.2rem;
  }

  .hero-panel-main,
  .hero-panel-side {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .hero-heading-stack {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .hero-eyebrow,
  .signal-kicker,
  .cockpit-side-kicker,
  .command-tile-kicker,
  .assistant-focus-kicker,
  .workflow-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: #0f766e;
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .hero-action-row,
  .cockpit-side-actions,
  .assistant-shortcuts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .hero-signal-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.85rem;
  }

  .signal-card,
  .cockpit-side-card,
  .cockpit-block,
  .assistant-focus-card {
    border: 1px solid #d9e7ee;
    border-radius: 1.15rem;
    background: rgba(255, 255, 255, 0.86);
    box-shadow: 0 16px 32px -28px rgba(15, 23, 42, 0.2);
  }

  .signal-card,
  .cockpit-side-card,
  .cockpit-block,
  .assistant-focus-card {
    padding: 1rem;
  }

  .signal-card,
  .cockpit-side-card,
  .assistant-focus-card {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .signal-value,
  .cockpit-side-title,
  .command-tile strong,
  .assistant-focus-card strong {
    color: #10233d;
    font-size: 1.02rem;
    font-weight: 800;
    line-height: 1.25;
  }

  .signal-card p,
  .cockpit-side-card p,
  .command-tile p,
  .assistant-focus-card p,
  .workflow-row p {
