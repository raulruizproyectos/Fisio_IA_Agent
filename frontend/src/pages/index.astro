  const normalizeSearchValue = (value: string) =>
    String(value || '')
      .toLowerCase()
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .trim();

  const hideSearchResults = () => {
    if (!searchResults) return;
    quickSearchMatches = [];
    quickSearchActiveIndex = -1;
    searchResults.hidden = true;
    searchResults.innerHTML = '';
    searchInput?.setAttribute('aria-expanded', 'false');
  };

  const renderSearchResults = (query: string) => {
    if (!searchResults) return;
    const normalizedQuery = normalizeSearchValue(query);
    if (normalizedQuery.length < 2) {
      hideSearchResults();
      return;
    }

    quickSearchMatches = patientCatalog
      .filter((patient) => {
        const haystack = [patient.nombre_completo, patient.email || '', patient.id]
          .filter(Boolean)
          .map((value) => normalizeSearchValue(String(value)))
          .join(' ');
        return haystack.includes(normalizedQuery);
      })
      .slice(0, 6);

    if (quickSearchActiveIndex >= quickSearchMatches.length) {
      quickSearchActiveIndex = quickSearchMatches.length - 1;
    }
    if (quickSearchActiveIndex < 0 && quickSearchMatches.length) {
      quickSearchActiveIndex = 0;
    }

    searchResults.hidden = false;
    searchInput?.setAttribute('aria-expanded', 'true');

    if (!quickSearchMatches.length) {
      searchResults.innerHTML = `<div class="search-results-empty">Sin pacientes para &quot;${escapeHtml(query)}&quot;.</div>`;
      return;
    }

    searchResults.innerHTML = [
      '<div class="search-results-head">Pacientes del CRM</div>',
      ...quickSearchMatches.map((patient, index) => {
        const activeClass = index === quickSearchActiveIndex ? ' is-active' : '';
        const patientName = patient.nombre_completo || `Paciente ${patient.id}`;
        const patientMeta = patient.email || `ID ${patient.id.slice(0, 8)}`;
        return `<button type="button" class="search-result-item${activeClass}" data-search-patient-id="${escapeAttr(patient.id)}" data-search-patient-name="${escapeAttr(patientName)}">
          <span class="material-symbols-rounded search-result-icon">person_search</span>
          <span class="search-result-main">
            <span class="search-result-title">${escapeHtml(patientName)}</span>
            <span class="search-result-meta">${escapeHtml(patientMeta)}</span>
          </span>
          <span class="material-symbols-rounded search-result-arrow">arrow_outward</span>
        </button>`;
      }),
    ].join('');
  };

  const openSearchMatch = (match?: { id: string; nombre_completo: string; email?: string | null }) => {
    if (!match?.id) return;
    if (searchInput) {
      searchInput.value = match.nombre_completo || '';
    }
    hideSearchResults();
    selectedPatientId = match.id;
    selectedPatientName = match.nombre_completo || '';
    syncChatPatientSelection(match.id, selectedPatientName);
    void openFichaPaciente(match.id);
  };

  const updateSearchResults = async (query: string, resetActive = true) => {
    const normalizedQuery = normalizeSearchValue(query);
    if (normalizedQuery.length < 2) {
      hideSearchResults();
      return;
    }

    if (!searchResults) return;
    if (resetActive) {
      quickSearchActiveIndex = 0;
    }

    if (!patientCatalog.length) {
      searchResults.hidden = false;
      searchResults.innerHTML = '<div class="search-results-empty">Cargando pacientes...</div>';
      searchInput?.setAttribute('aria-expanded', 'true');
      try {
        await ensurePatientCatalog();
      } catch {
        searchResults.hidden = false;
        searchResults.innerHTML = '<div class="search-results-empty">No se pudo cargar el buscador de pacientes.</div>';
        return;
      }
    }

    renderSearchResults(query);
  };

  const toReportTextList = (value: any, limit = 4) => {
    if (Array.isArray(value)) {
      return value
        .map((item) => String(item || '').replace(/\s+/g, ' ').trim())
        .filter(Boolean)
        .slice(0, limit);
    }
    const raw = String(value || '').replace(/\s+/g, ' ').trim();
    if (!raw) return [];
    return raw
      .split(/(?:\n|;|\.\s+)/)
      .map((item) => item.trim())
      .filter(Boolean)
      .slice(0, limit);
  };

  const getExerciseDoseLabel = (exercise: any) => {
    const dose = [
      exercise?.series ? `${exercise.series} series` : '',
      exercise?.repeticiones ? `${exercise.repeticiones} repeticiones` : '',
      exercise?.duracion_segundos ? `${exercise.duracion_segundos}s` : '',
    ].filter(Boolean);
    return dose.length ? dose.join(' | ') : 'Dosificacion a revisar en consulta';
  };

  const renderReportActionButton = (action: string, icon: string, label: string, primary = false) => {
    return `<button type="button" class="exercise-report-action${primary ? ' is-primary' : ''}" data-report-action="${escapeAttr(action)}"><span class="material-symbols-rounded">${escapeHtml(icon)}</span>${escapeHtml(label)}</button>`;
  };

  const renderExerciseImage = (exercise: any) => {
    const name = String(exercise?.nombre || exercise?.name || 'Ejercicio').trim();
    const imageUrl = String(exercise?.imagen_url || exercise?.image_url || '').trim();
    if (!imageUrl) {
      return `<div class="exercise-thumb exercise-thumb-empty" aria-label="Sin imagen disponible"><span class="material-symbols-rounded">image_not_supported</span></div>`;
    }
    return `<a class="exercise-thumb" href="${escapeAttr(imageUrl)}" target="_blank" rel="noopener" aria-label="Ampliar imagen de ${escapeAttr(name)}"><img src="${escapeAttr(imageUrl)}" alt="${escapeAttr(name)}" loading="lazy" /></a>`;
  };

  // Render exercise recommendation as a complete clinical plan inside the conversation.
  const addExerciseReport = (payload: any) => {
    if (!log) return;
    lastExerciseReportPayload = payload;
    const payloadPatientId = String(payload?.patient_id || selectedPatientId || '').trim();
    const payloadRecommendationId = String(payload?.recommendation_id || '').trim() || null;
    if (payloadPatientId) {
      const delivered = deliveredExerciseReports.get(payloadPatientId);
      if (delivered && delivered.recommendationId !== payloadRecommendationId) {
        deliveredExerciseReports.delete(payloadPatientId);
      }
    }
    updateExerciseApproveButton();
    updateExercisePdfButton();
    updateExerciseTelegramButton();
    renderAssistantFlowCard();
    renderAssistantDeliveryCard();

    const exercises = Array.isArray(payload?.exercises) ? payload.exercises : [];
    const coverage = payload?.image_coverage || {};
    const recommendationId = String(payload?.recommendation_id || '').trim();
    const patientName = selectedPatientName || currentAssistantPatientBrief?.patientName || 'Paciente';
    const symptomSummary = trimAgentBriefText(
      payload?.symptom_summary || payload?.selection_rationale || lastExerciseVisibleText || '',
      340
    );
    const therapistNote = trimAgentBriefText(payload?.message_to_therapist || payload?.selection_rationale || '', 420);
    const patientMessage = trimAgentBriefText(payload?.message_to_patient || '', 420);
    const imageLabel = coverage?.total !== undefined
      ? `${Number(coverage.with_image || 0)}/${Number(coverage.total || exercises.length)} imagenes`
      : `${exercises.filter((exercise: any) => exercise?.imagen_url).length}/${exercises.length} imagenes`;
    const redFlagItems = toReportTextList(payload?.red_flags?.items || [], 5);
    const reportDate = fmtDate(new Date().toISOString());

    const metaPills = [
      `${exercises.length} ejercicio(s)`,
      imageLabel,
      recommendationId ? 'Guardado en historial' : 'Pendiente de historial',
    ];
    if (payload?.red_flags?.present) metaPills.push('Revisar alertas');

    let html = '<div class="msg-avatar"><span class="material-symbols-rounded">psychology</span></div>';
    html += '<div class="msg-body"><span class="msg-sender">Agente IA</span>';
    html += '<article class="exercise-report exercise-report-full">';
    html += '<header class="exercise-report-hero">';
    html += '<div>';
    html += '<span class="exercise-report-kicker">Plan terapeutico generado</span>';
    html += `<strong>Propuesta revisable para ${escapeHtml(patientName)}</strong>`;
    html += `<p>${escapeHtml(symptomSummary || 'Caso procesado con el contexto clinico disponible.')}</p>`;
    html += '</div>';
    html += '<div class="exercise-report-status">';
    html += metaPills.map((pill) => `<span class="exercise-report-pill">${escapeHtml(pill)}</span>`).join('');
    html += '</div>';
    html += '</header>';

    if (payload?.red_flags?.present) {
      html += '<section class="exercise-alert"><span class="material-symbols-rounded">warning</span><div><strong>Revisa antes de entregar</strong>';
      html += redFlagItems.length
        ? `<p>${escapeHtml(redFlagItems.join(' | '))}</p>`
        : '<p>El motor ha marcado posibles alertas clinicas. Valida el caso antes de enviar el plan.</p>';
      html += '</div></section>';
    }

    html += '<section class="exercise-report-section exercise-report-summary">';
    html += '<div><span>Resumen clinico usado</span>';
    html += `<p>${escapeHtml(symptomSummary || therapistNote || 'Sin resumen clinico estructurado devuelto por el motor.')}</p></div>`;
    html += '<dl>';
    html += `<div><dt>Fecha</dt><dd>${escapeHtml(reportDate)}</dd></div>`;
    html += `<div><dt>Paciente</dt><dd>${escapeHtml(patientName)}</dd></div>`;
    html += `<div><dt>Historial</dt><dd>${recommendationId ? 'Registrado' : 'No confirmado'}</dd></div>`;
    html += '</dl>';
    html += '</section>';

    if (therapistNote || patientMessage) {
      html += '<section class="exercise-report-section exercise-report-notes">';
      if (therapistNote) {
        html += '<div><span>Nota para fisio</span>';
        html += `<p>${escapeHtml(therapistNote)}</p></div>`;
      }
      if (patientMessage) {
        html += '<div><span>Explicacion para paciente</span>';
        html += `<p>${escapeHtml(patientMessage)}</p></div>`;
      }
      html += '</section>';
    }

    html += '<section class="exercise-report-section">';
    html += '<div class="exercise-report-section-head">';
    html += '<span>Ejercicios recomendados</span>';
    html += `<small>${escapeHtml(imageLabel)} disponibles para PDF y revision visual</small>`;
    html += '</div>';

    if (!exercises.length) {
      html += '<div class="exercise-empty-result"><span class="material-symbols-rounded">info</span><p>El motor no devolvio ejercicios para este caso. Revisa el briefing o regenera el plan.</p></div>';
    } else {
      html += '<div class="exercise-plan-grid">';
      exercises.forEach((exercise: any, index: number) => {
        const name = String(exercise?.nombre || exercise?.name || `Ejercicio ${index + 1}`).trim();
        const zone = String(exercise?.zona_corporal || exercise?.body_area || '').trim();
        const procedure = trimAgentBriefText(exercise?.procedimiento || exercise?.descripcion || exercise?.description || '', 240);
        const why = trimAgentBriefText(exercise?.why || exercise?.reason || '', 180);
        const cautions = toReportTextList(exercise?.cautions || [], 3);
        html += '<article class="exercise-card-pro">';
        html += renderExerciseImage(exercise);
        html += '<div class="exercise-card-pro-body">';
        html += `<div class="exercise-card-pro-top"><span>${index + 1}</span><strong>${escapeHtml(name)}</strong></div>`;
        html += '<div class="exercise-dose-line">';
        html += `<span>${escapeHtml(getExerciseDoseLabel(exercise))}</span>`;
        if (zone) html += `<span>${escapeHtml(zone)}</span>`;
        html += '</div>';
        if (procedure) html += `<p>${escapeHtml(procedure)}</p>`;
        if (why) html += `<small><strong>Motivo:</strong> ${escapeHtml(why)}</small>`;
        if (cautions.length) html += `<small class="exercise-cautions"><strong>Precauciones:</strong> ${escapeHtml(cautions.join(' | '))}</small>`;
        html += '</div>';
        html += '</article>';
      });
      html += '</div>';
    }
    html += '</section>';

    html += '<section class="exercise-report-section exercise-report-review">';
    html += '<div><span>Revision y entrega</span>';
    html += `<p>${recommendationId ? 'El plan queda bloqueado hasta que confirmes la revisión clínica. Tras aprobarlo podrás exportar el PDF o enviarlo por Telegram.' : 'El plan se genero, pero el backend no confirmo recommendation_id. Revisa la persistencia antes de utilizarlo.'}</p></div>`;
    html += '<div class="exercise-report-actions">';
    html += renderReportActionButton('edit', 'edit_note', 'Editar briefing');
    html += renderReportActionButton('regenerate', 'refresh', 'Regenerar');
    html += renderReportActionButton('approve', 'fact_check', 'Revisar y aprobar', true);
    html += renderReportActionButton('pdf', 'picture_as_pdf', 'Exportar PDF');
    html += renderReportActionButton('telegram', 'send', 'Enviar');
    html += '</div>';
    html += '</section>';

    if (recommendationId) {
      html += '<footer class="exercise-report-foot">';
      html += `<span>Historial clinico actualizado</span><code>${escapeHtml(recommendationId)}</code>`;
      html += '</footer>';
    }
    html += '</article></div>';

    const article = document.createElement('article');
    article.className = 'msg agent msg-report';
    article.innerHTML = html;
    log.appendChild(article);
    scrollAssistantRailToBottom();
  };

  const exportExerciseReportPdf = async (payload: any) => {
    const filenameDate = new Date().toISOString().replace(/[:T]/g, '-').slice(0, 16);
    const res = await fetch(`${BACKEND_BASE}/api/exercises/reports/pdf`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
    });
    if (!res.ok) {
      const msg = await res.text().catch(() => res.statusText);
      throw new Error(`Error generando PDF: ${res.status} ${msg}`);
    }
    const blob = await res.blob();
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `informe-ejercicios-${filenameDate}.pdf`;
    document.body.appendChild(a);
    a.click();
    a.remove();
    URL.revokeObjectURL(url);
  };

  const wait = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));

  const requestExerciseRecommendation = async (text: string, maxAttempts = 2, patientId: string | null = selectedPatientId) => {
    let lastError: any = null;
    const safeMaxAttempts = Math.max(1, maxAttempts);
    let localTimeoutCount = 0;
    let localRetries = 0;

    for (let attempt = 1; attempt <= safeMaxAttempts; attempt += 1) {
      try {
        const payload = await fetchJson(
          `${BACKEND_BASE}/api/exercises/recommend`,
          {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              patient_id: patientId || null,
              symptoms: text,
              channel: 'crm_web',
              fisioterapeuta_id: PROF_ID,
            }),
          },
          45000
        );

        return {
          payload,
          attemptsUsed: attempt,
          retriesUsed: attempt - 1,
        };
      } catch (err: any) {
        lastError = err;
        const timeout = isTimeoutError(err);
        if (timeout) {
          localTimeoutCount += 1;
        }

        const canRetry = timeout && attempt < safeMaxAttempts;
        if (canRetry) {
          localRetries += 1;
          await wait(500 * attempt);
          continue;
        }

        if (localRetries > 0) {
          exerciseOpsStats.retries += localRetries;
        }
        if (localTimeoutCount > 0) {
          exerciseOpsStats.timeouts += localTimeoutCount;
        }
        renderExerciseOpsMetric();
        throw err;
      }
    }

    throw lastError;
  };

  const shouldFallbackToSyncExerciseRequest = (err: any) => {
    const msg = String(err?.message || '').toLowerCase();
    return (
      msg.includes('http 404') ||
      msg.includes('http 405') ||
      msg.includes('cannot post') ||
      msg.includes('async_job_not_found')
    );
  };

  const startExerciseRecommendationAsync = async (text: string, patientId: string | null = selectedPatientId) => {
    return await fetchJson(
      `${BACKEND_BASE}/api/exercises/recommend/async`,
      {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          patient_id: patientId || null,
          symptoms: text,
          channel: 'crm_web',
          fisioterapeuta_id: PROF_ID,
        }),
      },
      12000
    );
  };

  const pollExerciseRecommendationJob = async (jobId: string, maxAttempts = 90, pollIntervalMs = 1500) => {
    const safeJobId = String(jobId || '').trim();
    if (!safeJobId) throw new Error('No hay job_id de polling');

    for (let attempt = 1; attempt <= maxAttempts; attempt += 1) {
      const payload = await fetchJson(
        BACKEND_BASE + '/api/exercises/recommend/jobs/' + safeJobId,
        undefined,
        8000
      );
      const status = String(payload?.status || '').toLowerCase();

      if (status === 'done' && payload?.result) {
        pendingExerciseRecommendationJobId = null;
        return payload.result;
      }

      if (status === 'error') {
        pendingExerciseRecommendationJobId = null;
        const error: any = new Error(payload?.error || 'No se pudo generar el informe.');
        error.code = payload?.code || null;
        throw error;
      }

      upsertAgentProgress(payload?.progress_message || 'Procesando solicitud asincrona...');
      await wait(pollIntervalMs);
    }

    const timeoutError: any = new Error('El informe sigue procesandose en segundo plano.');
    timeoutError.code = 'async_poll_timeout';
    throw timeoutError;
  };

  const handleAssistantChat = async (requestText: string, visibleText: string, busySource: 'chat' | 'exercise' = 'chat') => {
    addMessage(visibleText, 'user');
    resizeAgentInput();
    upsertAgentProgress('Consultando al asistente clinico...');
    setSending(true, busySource);
    try {
      const payload = await fetchJson(`${BACKEND_BASE}/api/agent/message`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ role: 'professional', channel: 'web', text: requestText }),
      });
      const answer = payload?.data?.reply_text || payload?.data?.message || (typeof payload.data === 'string' ? payload.data : JSON.stringify(payload.data));
      clearAgentProgress();
      addMessage(answer, 'agent');
      setAgentStatus(!payload.n8n_unreachable);
    } catch {
      clearAgentProgress();
      addMessage('Error de conexion con el agente.', 'agent');
      setAgentStatus(false);
    } finally {
      clearAgentProgress();
      setSending(false);
    }
  };

  const handleAssistantPrimaryAction = async () => {
    if (!input) return;
    const payload = buildAssistantModeRequest(input.value || '');
    if (!payload) {
      addMessage(
        activeAssistantMode === 'new-plan'
          ? 'Describe un objetivo clinico o dolor principal antes de generar un plan.'
          : 'Selecciona un paciente con historial para usar este modo guiado del copilot.',
        'agent'
      );
      return;
    }

    if (payload.action === 'exercise') {
      const activePatientId = selectedPatientId || chatPatientSelect?.value || null;
      if (!activePatientId) {
        addMessage('Selecciona un paciente en "Paciente del informe" antes de generar ejercicios.', 'agent');
        return;
      }
      clearAssistantComposer();
      await handleExerciseRecommend(payload.requestText, payload.visibleText, { patientId: activePatientId });
      return;
    }

    clearAssistantComposer();
    await handleAssistantChat(payload.requestText, payload.visibleText, 'exercise');
  };

  // W3: Exercise recommendation via CRM
  const handleExerciseRecommend = async (
    text: string,
    visibleText = text,
    options: { patientId?: string | null; showUserMessage?: boolean } = {}
  ) => {
    const activePatientId = options.patientId || selectedPatientId || chatPatientSelect?.value || null;
    if (!activePatientId) {
      addMessage('Selecciona un paciente en "Paciente del informe" antes de generar ejercicios.', 'agent');
      return;
    }
    syncChatPatientSelection(activePatientId);
    lastExerciseRequestText = text;
    lastExerciseVisibleText = visibleText;
    if (options.showUserMessage !== false) {
      addMessage(visibleText, 'user');
    }
    upsertAgentProgress('Analizando caso clinico...');
    setSending(true, 'exercise');
    try {
      let payload: any = null;
      let retriesUsed = 0;

      if (pendingExerciseRecommendationJobId) {
        upsertAgentProgress('Retomando informe que sigue en segundo plano...');
        payload = await pollExerciseRecommendationJob(pendingExerciseRecommendationJobId, 45, 1500);
      } else {
        try {
          const job = await startExerciseRecommendationAsync(text, activePatientId);
          pendingExerciseRecommendationJobId = String(job?.job_id || '').trim() || null;
          upsertAgentProgress(job?.progress_message || 'Generando ejercicios recomendados...');
          payload = await pollExerciseRecommendationJob(String(job?.job_id || ''), 90, 1500);
        } catch (asyncErr: any) {
          if (!shouldFallbackToSyncExerciseRequest(asyncErr)) throw asyncErr;
          upsertAgentProgress('Generando ejercicios por via directa...');
          const directResponse = await requestExerciseRecommendation(text, 2, activePatientId);
          payload = directResponse.payload;
          retriesUsed = directResponse.retriesUsed;
        }
      }

      renderExerciseOpsMetric();

      if (!payload.ok) {
        addMessage(`Error: ${payload.error || 'No se pudo generar recomendacion'}`, 'agent');
        return;
      }

      syncEngineOpsFromPayload(payload);
      upsertAgentProgress('Preparando informe y guardando historial...');
      clearAgentProgress();
      addExerciseReport(payload);
      setAssistantCareStep(2);
      if (payload?.recommendation_id) {
        void loadAssistantPatientBrief(activePatientId, true);
        if (activeSection === 'historial') {
          pendingHistoryAnchor = 'recommendations';
          await loadHistorial();
        }
      } else if (payload?.persistence_skipped || payload?.persistence_warning) {
        addMessage(`Plan generado, pero no quedo guardado en historial: ${payload?.persistence_warning || 'faltan datos de paciente CRM'}.`, 'agent');
      }
      updateExercisePdfButton();
      if (retriesUsed > 0) {
        addMessage(`Motor IA respondio tras ${retriesUsed} reintento(s).`, 'agent');
      }
      setAgentStatus(true);
      updateExercisePdfButton();
    } catch (err: any) {
      clearAgentProgress();
      if (err?.code === 'async_poll_timeout') {
        addMessage('El informe sigue generandose. Pulsa `Generar Plan` en unos segundos para retomarlo sin perder trabajo.', 'agent');
      } else if (isTimeoutError(err)) {
        pendingExerciseRecommendationJobId = null;
        addMessage('El agente de ejercicios tarda mas de lo esperado. Intenta de nuevo en unos segundos.', 'agent');
      } else {
        pendingExerciseRecommendationJobId = null;
        addMessage(`Error en el agente de ejercicios: ${err?.message || 'error no identificado'}`, 'agent');
      }
    } finally {
      clearAgentProgress();
      setSending(false);
    }
  };

  log?.addEventListener('click', (event: Event) => {
    const target = event.target as HTMLElement | null;
    const actionButton = target?.closest('[data-report-action]') as HTMLButtonElement | null;
    const action = String(actionButton?.getAttribute('data-report-action') || '').trim();
    if (!action) return;
    event.preventDefault();

    if (action === 'pdf') {
      exercisePdfBtn?.click();
      return;
    }

    if (action === 'telegram') {
      exerciseTelegramBtn?.click();
      return;
    }

    if (action === 'approve') {
      exerciseApproveBtn?.click();
      return;
    }

    if (action === 'edit') {
      setAssistantMode('update-plan', { focus: false });
      if (input) {
        const base = lastExerciseRequestText || lastExerciseVisibleText || '';
        input.value = base
          ? `Ajusta este plan. Mantener lo que funcione y cambia dosis, ejercicios o precauciones segun este briefing:\n\n${base}`
          : 'Ajusta el plan actual segun dolor, adherencia, progresion y tolerancia.';
        resizeAgentInput();
        renderAssistantModeCard();
        renderAssistantFlowCard();
        input.focus();
        input.setSelectionRange(input.value.length, input.value.length);
      }
      return;
    }

    if (action === 'regenerate') {
      const requestText = lastExerciseRequestText || lastExerciseVisibleText;
      if (!requestText) {
        addMessage('No tengo un briefing anterior para regenerar. Escribe el caso clinico y vuelve a generar.', 'agent');
        return;
      }
      void handleExerciseRecommend(
        requestText,
        `Regenerar plan con el mismo briefing: ${trimAgentBriefText(lastExerciseVisibleText || requestText, 110)}`,
        { showUserMessage: true }
      );
    }
  });

  // Primary assistant action
  exerciseBtn?.addEventListener('click', () => {
    void handleAssistantPrimaryAction();
  });

  chatPatientSelect?.addEventListener('change', () => {
    const patientId = chatPatientSelect.value || null;
    syncChatPatientSelection(patientId);
    if (patientId) {
      void loadAssistantPatientBrief(patientId);
    }
  });

  const buildTelegramDeliveryFollowUpNote = (payload: any) => {
    const exercises = Array.isArray(payload?.exercises) ? payload.exercises : [];
    const exerciseNames = exercises
      .map((exercise: any) => String(exercise?.nombre || exercise?.name || '').trim())
      .filter(Boolean)
      .slice(0, 4);
    const clinicalSummary = trimAgentBriefText(
      payload?.message_to_therapist ||
      payload?.selection_rationale ||
      payload?.symptom_summary ||
      '',
      180
    );
    const parts = [
      'Tipo de informe: plan de ejercicios enviado por Telegram.',
      `${exercises.length || 'Sin'} ejercicio(s) incluidos.`,
    ];
    if (exerciseNames.length) parts.push(`Ejercicios clave: ${exerciseNames.join(', ')}.`);
    if (clinicalSummary) parts.push(`Resumen: ${clinicalSummary}`);
    return parts.join(' ');
  };

  const recordTelegramDeliveryFollowUp = async (recommendationId: string, payload: any) => {
    if (!recommendationId) return false;
    await fetchJson(`${BACKEND_BASE}/api/exercises/recommendations/${recommendationId}/follow-up`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        note_text: buildTelegramDeliveryFollowUpNote(payload),
        recommendation_state: 'enviada',
        fisioterapeuta_id: PROF_ID,
      }),
    });
    return true;
  };

  const approveCurrentExerciseReport = async () => {
    const recommendationId = String(lastExerciseReportPayload?.recommendation_id || '').trim();
    if (!recommendationId) {
      addMessage('No puedo aprobar este plan porque no quedó registrado en el historial.', 'agent');
      return;
    }
    if (isExerciseReportApproved()) return;

    let note = '';
    if (lastExerciseReportPayload?.red_flags?.present) {
      note = String(window.prompt('Este plan contiene alertas clínicas. Escribe la justificación de tu revisión antes de aprobarlo:') || '').trim();
      if (note.length < 12) {
        addMessage('La aprobación se ha cancelado: con alertas clínicas necesitas una nota justificativa de al menos 12 caracteres.', 'agent');
        return;
      }
    }

    try {
      setSending(true, 'exercise');
      const payload = await fetchJson(`${BACKEND_BASE}/api/exercises/recommendations/${recommendationId}/review`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ decision: 'approve', note }),
      });
      const approvalState = String(payload?.data?.estado || 'aprobada');
      lastExerciseReportPayload = {
        ...lastExerciseReportPayload,
        approval_required: false,
        approval_state: approvalState,
        estado: approvalState,
        reviewed_at: payload?.data?.reviewed_at || new Date().toISOString(),
      };
      updateExerciseApproveButton();
      updateExercisePdfButton();
      updateExerciseTelegramButton();
      renderAssistantDeliveryCard();
      setAssistantCareStep(3);
      addMessage('Plan aprobado y registrado. Ya puedes exportarlo o enviarlo al paciente.', 'agent');
    } catch (err: any) {
      addMessage(`No se pudo aprobar el plan: ${err?.message || 'error no identificado'}`, 'agent');
    } finally {
      setSending(false);
    }
  };

  exerciseApproveBtn?.addEventListener('click', () => void approveCurrentExerciseReport());

  exerciseTelegramBtn?.addEventListener('click', async () => {
    if (!selectedPatientId) {
      addMessage('Selecciona un paciente antes de enviar el informe por Telegram.', 'agent');
      return;
    }

    if (!hasLinkedTelegramPatient()) {
      pendingHistoryAnchor = 'telegram';
      addMessage('Este paciente aun no tiene Telegram vinculado. Te llevo a su ficha para completar el enlace.', 'agent');
      closeAssistantRail();
      openPatientHistory(selectedPatientId, selectedPatientName);
      window.setTimeout(() => focusHistoryAnchor('telegram'), 650);
      return;
    }

    if (!lastExerciseReportPayload) {
      addMessage('Primero genera y revisa un plan para poder enviarlo al paciente por Telegram.', 'agent');
      return;
    }
    if (!isExerciseReportApproved()) {
      addMessage('Revisa y aprueba el plan antes de enviarlo al paciente.', 'agent');
      return;
    }

    try {
      upsertAgentProgress('Enviando informe al paciente por Telegram...');
      setSending(true, 'exercise');
      const recommendationId = String(lastExerciseReportPayload?.recommendation_id || '').trim();
      await fetchJson(`${BACKEND_BASE}/api/telegram/patient-report/send`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          ...lastExerciseReportPayload,
          patient_id: selectedPatientId,
          patient_name: selectedPatientName || null,
          fisioterapeuta_id: PROF_ID,
          recommendation_id: recommendationId || lastExerciseReportPayload?.recommendation_id || null,
          message_text:
            lastExerciseReportPayload?.message_to_patient ||
            currentAssistantPatientBrief?.patientMessage ||
            '',
        }),
      });

      let followUpRegistered = false;
      if (recommendationId) {
        try {
          followUpRegistered = await recordTelegramDeliveryFollowUp(recommendationId, lastExerciseReportPayload);
        } catch {}
      }

      deliveredExerciseReports.set(selectedPatientId, {
        recommendationId: recommendationId || null,
        sentAt: new Date().toISOString(),
      });
      setAssistantCareStep(4);
