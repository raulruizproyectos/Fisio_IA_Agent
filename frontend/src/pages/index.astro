      assistantModeTip.textContent = `Ya tienes una propuesta para ${patientLabel}. Puedes exportar PDF o cambiar a Actualizar plan para iterar.`;
      assistantModeCard.classList.add('is-complete');
      assistantModeCard.classList.remove('is-ready');
      syncAssistantDiagnosticPanel();
      return;
    }

    assistantModeCard.classList.remove('is-complete');

    if (hasDraft) {
      assistantModeRequirement.textContent = modeConfig.requirementLabel;
      assistantModeTip.textContent = `Briefing listo para ${patientLabel || 'este caso'}. Revisa el texto y lanza ${modeConfig.primaryLabel.toLowerCase()}.`;
      assistantModeCard.classList.add('is-ready');
      syncAssistantDiagnosticPanel();
      return;
    }

    assistantModeRequirement.textContent = modeConfig.requirementLabel;
    assistantModeTip.textContent = modeConfig.tip;
    assistantModeCard.classList.remove('is-ready');
    syncAssistantDiagnosticPanel();
  };

  const getAssistantModeDraft = (mode: AssistantWorkMode) => {
    if (mode === 'update-plan') {
      return 'Ajusta el plan segun la evolucion del dolor, tolerancia y adherencia.';
    }
    if (mode === 'next-session') {
      return 'Resume que revisar en consulta y que progresion o regresion valorar.';
    }
    return '';
  };

  const setAssistantMode = (mode: AssistantWorkMode, options: { focus?: boolean } = {}) => {
    if (!(mode in assistantModeConfig)) return;
    activeAssistantMode = mode;
    const modeConfig = getActiveAssistantModeConfig();
    if (input) {
      input.placeholder = modeConfig.placeholder;
    }
    renderAssistantModeSwitch();
    renderAssistantPrimaryButton();
    renderAssistantModeCard();
    renderAssistantFlowCard();
    resizeAgentInput();
    renderAssistantDiagnosticSummary();
    if (options.focus && input) {
      input.focus();
      input.setSelectionRange(input.value.length, input.value.length);
    }
  };

  const openExerciseReportAssistant = (options: {
    patientId?: string | null;
    patientName?: string;
    mode?: AssistantWorkMode;
    seedText?: string;
    objective?: string;
    focus?: boolean;
  } = {}) => {
    const nextPatientId = String(options.patientId || selectedPatientId || '').trim();
    const nextPatientName = String(options.patientName || selectedPatientName || '').trim();
    if (nextPatientId) {
      syncChatPatientSelection(nextPatientId, nextPatientName);
      void loadAssistantPatientBrief(nextPatientId);
    }

    setAssistantMode(options.mode || 'new-plan', { focus: false });

    const objectiveText = String(options.objective || '').trim();
    if (objectiveText && assistantObjectiveInput && !assistantObjectiveInput.value.trim()) {
      assistantObjectiveInput.value = objectiveText;
    }

    const seedText = String(options.seedText || '').trim();
    if (seedText && input && !input.value.trim()) {
      input.value = seedText;
      input.dispatchEvent(new Event('input', { bubbles: true }));
    }

    assistantDiagnosticExpanded = Boolean(hasAssistantDiagnosticData());
    renderAssistantDiagnosticSummary();
    renderAssistantModeCard();
    renderAssistantFlowCard();
    requestOpenAssistantRail();

    if (options.focus !== false && input) {
      window.setTimeout(() => {
        input.focus();
        input.setSelectionRange(input.value.length, input.value.length);
      }, 60);
    }
  };

  const buildAssistantModeRequest = (rawText: string) => {
    const text = String(rawText || '').trim();
    const diagnosticPrompt = buildAssistantDiagnosticPrompt();
    const diagnosticSummary = getAssistantDiagnosticSummaryText(160);
    const modeConfig = getActiveAssistantModeConfig();
    const contextualPrompt = activeAssistantMode === 'new-plan' ? '' : buildAssistantBriefPrompt(activeAssistantMode);

    if (modeConfig.action === 'exercise') {
      if (!text && !diagnosticPrompt) return null;
      let requestText = activeAssistantMode === 'update-plan'
        ? appendAssistantInstruction(contextualPrompt, text, 'Cambio solicitado')
        : text;
      requestText = appendAssistantInstruction(requestText, diagnosticPrompt, 'Ficha estructurada');
      const visibleText = trimAgentBriefText([text, diagnosticSummary].filter(Boolean).join(' | '), 150) || diagnosticSummary || text;
      return {
        action: 'exercise' as const,
        requestText: requestText || diagnosticPrompt,
        visibleText,
      };
    }

    if (activeAssistantMode !== 'new-plan' && !contextualPrompt) {
      return null;
    }

    const draftText = text || getAssistantModeDraft(activeAssistantMode);
    let requestText = appendAssistantInstruction(contextualPrompt, draftText, 'Solicitud');
    requestText = appendAssistantInstruction(requestText, diagnosticPrompt, 'Ficha estructurada');
    const visibleText = trimAgentBriefText([draftText, diagnosticSummary].filter(Boolean).join(' | '), 150) || draftText;
    return {
      action: 'chat' as const,
      requestText,
      visibleText,
    };
  };

  const getAssistantDraftSummary = () => {
    const draft = String(input?.value || '').replace(/\s+/g, ' ').trim();
    const diagnosticSummary = getAssistantDiagnosticSummaryText(110);
    if (draft && diagnosticSummary) return trimAgentBriefText(`${draft} | ${diagnosticSummary}`, 110);
    if (draft) return draft.length <= 96 ? draft : draft.slice(0, 95).trim() + '...';
    return diagnosticSummary;
  };

  const hasExerciseReportReady = () => {
    if (!lastExerciseReportPayload) return false;
    const reportPatientId = String(lastExerciseReportPayload?.patient_id || '').trim();
    if (!reportPatientId || !selectedPatientId) return Boolean(lastExerciseReportPayload);
    return reportPatientId === selectedPatientId;
  };

  const renderAssistantFlowCard = () => {
    if (!assistantFlowCard || !assistantFlowSteps || !assistantFlowHint || !assistantFlowDraft || !assistantFlowTitle) return;
    renderAssistantModeCard();

    const hasPatient = Boolean(selectedPatientId);
    const hasGoal = Boolean(getAssistantDraftSummary());
    const hasPlan = hasExerciseReportReady();
    const patientName = selectedPatientName || currentAssistantPatientBrief?.patientName || 'Paciente activo';
    const draftSummary = getAssistantDraftSummary();

    assistantFlowCard.classList.toggle('is-complete', hasPlan);
    assistantRail?.classList.toggle('assistant-has-report', hasPlan);

    if (hasPlan) {
      assistantFlowSteps.innerHTML = '';
      assistantFlowTitle.textContent = 'Plan generado y listo para revisar';
      assistantFlowHint.textContent = 'El informe ya esta debajo. Revisa el contenido y exporta el PDF cuando quieras.';
      assistantFlowDraft.textContent = draftSummary
        ? 'Objetivo usado: ' + draftSummary
        : 'El plan ya esta preparado para exportacion.';
      return;
    }

    const steps = [
      {
        label: 'Paciente',
        state: hasPatient ? 'done' : 'current',
        meta: hasPatient ? patientName : 'Selecciona uno'
      },
      {
        label: 'Objetivo',
        state: hasGoal ? 'done' : (hasPatient ? 'current' : 'pending'),
        meta: hasGoal ? 'Contexto cargado' : 'Describe dolor o meta'
      },
      {
        label: 'Plan IA',
        state: hasPatient && hasGoal ? 'current' : 'pending',
        meta: 'Pulsa Generar plan'
      },
      {
        label: 'PDF e historial',
        state: 'pending',
        meta: 'Se activa tras generar'
      }
    ];

    assistantFlowSteps.innerHTML = steps.map((step) => {
      return '<article class="assistant-flow-step is-' + escapeAttr(step.state) + '">' +
        '<span class="assistant-flow-step-dot"></span>' +
        '<div>' +
          '<strong>' + escapeHtml(step.label) + '</strong>' +
          '<small>' + escapeHtml(step.meta) + '</small>' +
        '</div>' +
      '</article>';
    }).join('');

    if (!hasPatient) {
      assistantFlowTitle.textContent = 'Empezamos vinculando el caso al historial correcto';
      assistantFlowHint.textContent = 'Selecciona un paciente para que plan, PDF y seguimiento queden unidos al caso clinico.';
    } else if (!hasGoal) {
      assistantFlowTitle.textContent = 'El caso ya esta listo para recibir un objetivo clinico';
      assistantFlowHint.textContent = 'Describe dolor, restriccion funcional o meta terapeutica para orientar el plan.';
    } else {
      assistantFlowTitle.textContent = 'Buen briefing: ahora toca pedir la propuesta del agente';
      assistantFlowHint.textContent = 'Genera el plan para revisar ejercicios, ajustar el mensaje al paciente y habilitar el PDF.';
    }

    assistantFlowDraft.textContent = draftSummary
      ? 'Objetivo actual: ' + draftSummary
      : 'Sin objetivo redactado todavia.';
  };
  const renderAssistantPatientBrief = (brief: any = null, options: { loading?: boolean; error?: boolean } = {}) => {
    if (!assistantPatientBrief) return;
    const loading = Boolean(options.loading);
    const error = Boolean(options.error);

    if (!selectedPatientId && !brief) {
      currentAssistantPatientBrief = null;
      assistantPatientBrief.innerHTML = '<div class="assistant-patient-brief-empty"><span class="assistant-brief-kicker">Resumen clinico</span><strong>Sin paciente seleccionado</strong></div>';
      assistantPatientBrief.removeAttribute('data-state');
      return;
    }

    if (loading) {
      const loadingName = escapeHtml(brief?.patientName || selectedPatientName || 'Paciente seleccionado');
      assistantPatientBrief.setAttribute('data-state', 'loading');
      assistantPatientBrief.innerHTML = `<div class="assistant-patient-brief-empty"><span class="assistant-brief-kicker">Resumen clinico</span><strong>Cargando ${loadingName}...</strong></div>`;
      return;
    }

    if (error) {
      const errorName = escapeHtml(brief?.patientName || selectedPatientName || 'el paciente seleccionado');
      assistantPatientBrief.setAttribute('data-state', 'error');
      assistantPatientBrief.innerHTML = `<div class="assistant-patient-brief-empty"><span class="assistant-brief-kicker">Resumen clinico</span><strong>No se pudo cargar ${errorName}.</strong></div>`;
      return;
    }

    if (!brief) {
      assistantPatientBrief.innerHTML = '<div class="assistant-patient-brief-empty"><span class="assistant-brief-kicker">Resumen clinico</span><strong>Sin contexto disponible</strong></div>';
      assistantPatientBrief.removeAttribute('data-state');
      return;
    }

    const latestPlanDate = brief.latestRecommendationDate ? fmtDate(brief.latestRecommendationDate) : 'Sin plan';
    const latestNote = escapeHtml(brief.latestNoteText || 'Sin seguimiento reciente');
    const planCount = brief.recommendationsCount || 0;
    const latestAilment = escapeHtml(brief.latestAilment || brief.therapistNote || 'Sin dolencia registrada');
    const latestExerciseType = escapeHtml(brief.latestExerciseType || 'Sin ejercicios');
    const telegramActionLabel = hasLinkedTelegramPatient() ? 'Telegram' : 'Vincular Telegram';

    assistantPatientBrief.removeAttribute('data-state');
    assistantPatientBrief.innerHTML = `
      <div class="assistant-brief-head assistant-brief-head-compact">
        <span class="assistant-brief-kicker">Ultimo plan</span>
        <strong>${planCount ? escapeHtml(latestPlanDate) : 'Sin plan'}</strong>
        <small>${planCount ? `${brief.exerciseCount || 0} ejercicio(s)` : 'Aun no generado'}</small>
      </div>
      <div class="assistant-brief-actions assistant-brief-actions-primary">
        <button type="button" class="assistant-chip" data-assistant-brief-action="update-plan"><span class="material-symbols-rounded">neurology</span> Actualizar plan</button>
        <button type="button" class="assistant-chip" data-report-action="pdf"><span class="material-symbols-rounded">picture_as_pdf</span> Exportar PDF</button>
        <button type="button" class="assistant-chip" data-report-action="telegram"><span class="material-symbols-rounded">send</span> ${telegramActionLabel}</button>
      </div>
      <div class="assistant-brief-history">
        <div>
          <span>Ultimo seguimiento</span>
          <strong>${latestNote}</strong>
        </div>
        <div>
          <span>Ultima dolencia</span>
          <strong>${latestAilment}</strong>
        </div>
        <div>
          <span>Tipo ejercicios</span>
          <strong>${latestExerciseType}</strong>
        </div>
      </div>
    `;
  };

  const syncAssistantPatientBriefFromData = (patientId: string, patient: any, notes: any[] = [], recommendations: any[] = []) => {
    const safePatientId = String(patientId || '').trim();
    if (!safePatientId) {
      currentAssistantPatientBrief = null;
      renderAssistantPatientBrief(null);
      return null;
    }
    const brief = buildAssistantPatientBrief(patient, notes, recommendations);
    assistantPatientBriefCache[safePatientId] = brief;
    currentAssistantPatientBrief = brief;
    renderAssistantPatientBrief(brief);
    return brief;
  };

  const loadAssistantPatientBrief = async (patientId: string | null, force = false) => {
    const safePatientId = String(patientId || '').trim();
    if (!safePatientId) {
      assistantPatientBriefRequestToken += 1;
      currentAssistantPatientBrief = null;
      renderAssistantPatientBrief(null);
      return null;
    }

    if (!force && assistantPatientBriefCache[safePatientId]) {
      currentAssistantPatientBrief = assistantPatientBriefCache[safePatientId];
      renderAssistantPatientBrief(currentAssistantPatientBrief);
      return currentAssistantPatientBrief;
    }

    const requestToken = ++assistantPatientBriefRequestToken;
    renderAssistantPatientBrief({ patientName: selectedPatientName || 'Paciente seleccionado' }, { loading: true });

    try {
      const [patientResp, historyResp, recommendationsResp] = await Promise.all([
        fetchJson(`${BACKEND_BASE}/api/pacientes/${safePatientId}`),
        fetchJson(`${BACKEND_BASE}/api/profesional/patients/${safePatientId}/history`),
        fetchJson(`${BACKEND_BASE}/api/exercises/recommendations/${safePatientId}?limit=25`),
      ]);

      if (requestToken !== assistantPatientBriefRequestToken) return null;

      return syncAssistantPatientBriefFromData(
        safePatientId,
        patientResp?.data || {},
        historyResp?.data?.notas_seguimiento || [],
        recommendationsResp?.data || []
      );
    } catch {
      if (requestToken !== assistantPatientBriefRequestToken) return null;
      currentAssistantPatientBrief = null;
      renderAssistantPatientBrief({ patientName: selectedPatientName || 'Paciente seleccionado' }, { error: true });
      return null;
    }
  };

  const loadAssistantTelegramLinkState = async (patientId: string | null) => {
    const safePatientId = String(patientId || '').trim();
    const requestToken = ++assistantTelegramLinkRequestToken;

    if (!safePatientId) {
      currentPatientTelegramLinkState = null;
      updateExerciseTelegramButton();
      return null;
    }

    try {
      const payload = await fetchJson(`${BACKEND_BASE}/api/telegram/link-code/${safePatientId}`);
      if (requestToken !== assistantTelegramLinkRequestToken) return null;
      currentPatientTelegramLinkState = payload?.data || null;
      updateExerciseTelegramButton();
      return currentPatientTelegramLinkState;
    } catch {
      if (requestToken !== assistantTelegramLinkRequestToken) return null;
      currentPatientTelegramLinkState = null;
      updateExerciseTelegramButton();
      return null;
    }
  };

  const updateAssistantPatientSelectorState = () => {
    if (!chatPatientSelect) return;
    const hasValue = Boolean(chatPatientSelect.value);
    chatPatientSelect.classList.toggle('has-value', hasValue);
    const selectorShell = chatPatientSelect.closest('.patient-selector');
    selectorShell?.classList.toggle('has-value', hasValue);
  };

  const rememberSelectedPatient = (patientId: string | null, patientName = '') => {
    try {
      if (!patientId) {
        localStorage.removeItem(SELECTED_PATIENT_STORAGE_KEY);
        return;
      }
      localStorage.setItem(SELECTED_PATIENT_STORAGE_KEY, JSON.stringify({
        id: patientId,
        name: patientName || '',
      }));
    } catch {}
  };

  const restoreSelectedPatientFromStorage = () => {
    if (selectedPatientId || !patientCatalog.length) return;
    try {
      const raw = localStorage.getItem(SELECTED_PATIENT_STORAGE_KEY);
      if (!raw) return;
      const saved = JSON.parse(raw);
      const patientId = String(saved?.id || '').trim();
      const patient = patientCatalog.find((item) => item.id === patientId);
      if (!patient) return;
      selectedPatientId = patient.id;
      selectedPatientName = patient.nombre_completo || String(saved?.name || '').trim();
    } catch {}
  };

  function syncChatPatientSelection(patientId: string | null, fallbackName = '') {
    if (!chatPatientSelect) return;
    const nextId = patientId || '';
    chatPatientSelect.value = nextId;
    selectedPatientId = nextId || null;
    updateAssistantPatientSelectorState();

    const activeReportPatientId = String(lastExerciseReportPayload?.patient_id || '').trim();
    if (!nextId || (activeReportPatientId && activeReportPatientId !== nextId)) {
      lastExerciseReportPayload = null;
      lastExerciseRequestText = '';
      lastExerciseVisibleText = '';
      updateExercisePdfButton();
    }

    if (!nextId) {
      selectedPatientName = '';
      currentAssistantPatientBrief = null;
      currentPatientTelegramLinkState = null;
      rememberSelectedPatient(null);
      renderAssistantPatientContext();
      renderAssistantPatientBrief(null);
      renderAssistantFlowCard();
      updateExerciseTelegramButton();
      return;
    }

    const selected = patientCatalog.find((p) => p.id === nextId);
    selectedPatientName = selected?.nombre_completo || fallbackName || selectedPatientName || '';
    rememberSelectedPatient(nextId, selectedPatientName);
    currentPatientTelegramLinkState = null;
    renderAssistantPatientContext();
    updateExerciseTelegramButton();

    const cachedBrief = assistantPatientBriefCache[nextId];
    if (cachedBrief) {
      currentAssistantPatientBrief = cachedBrief;
      renderAssistantPatientBrief(cachedBrief);
    } else {
      renderAssistantPatientBrief({ patientName: selectedPatientName || 'Paciente seleccionado' }, { loading: true });
    }
    renderAssistantFlowCard();
    void loadAssistantTelegramLinkState(nextId);
  }

  const renderExerciseOpsMetric = () => {
    if (!metricEngineOps) return;
    metricEngineOps.textContent = `${exerciseOpsStats.timeouts}/${exerciseOpsStats.retries}`;
  };
  renderExerciseOpsMetric();

  const incrementArchivedReportsMetric = (recommendationId: string | null) => {
    const metricEl = document.getElementById('metricInformes');
    if (!metricEl) return;
    if (recommendationId && archivedReportIds.has(recommendationId)) return;

    const current = parseInt(metricEl.textContent || '0', 10);
    metricEl.textContent = Number.isFinite(current) ? String(current + 1) : '1';

    if (recommendationId) {
      archivedReportIds.add(recommendationId);
    }
  };

  const syncEngineOpsFromPayload = (payload: any) => {
    const requestId = String(payload?.request_id || '').trim();
    if (requestId && processedEngineObservability.has(requestId)) return;

    const engineObs = payload?.engine_observability || {};
    const retriesUsed = Number(engineObs?.retries_used || 0);
    const attemptsDetail = Array.isArray(engineObs?.attempts_detail) ? engineObs.attempts_detail : [];
    const timedOutCount = attemptsDetail.filter((entry: any) => Boolean(entry?.timed_out)).length;

    if (retriesUsed > 0) {
      exerciseOpsStats.retries += retriesUsed;
    }
    if (timedOutCount > 0) {
      exerciseOpsStats.timeouts += timedOutCount;
    }

    if (requestId) {
      processedEngineObservability.add(requestId);
    }
    renderExerciseOpsMetric();
  };

  let activeSection = 'dashboard';
  const shellConfig = (window as any).__fisioShellConfig || {};
  const configuredFinanceSections = Array.isArray(shellConfig.financeSections) && shellConfig.financeSections.length
    ? shellConfig.financeSections
    : ['pagos', 'facturas', 'bonos', 'gestoria'];
  const financeSections = new Set<string>(configuredFinanceSections.map((section: any) => String(section)));
  const sectionAliases: Record<string, string> = {
    inicio: 'dashboard',
    home: 'dashboard',
    finanzas: 'pagos',
    payments: 'pagos',
    documentos: 'documentos',
    ...(shellConfig.aliases || {}),
  };
  const financeTabsMarkup = `
    <button type="button" class="finance-tab" data-dashboard-nav="pagos"><span class="material-symbols-rounded">payments</span> Pagos</button>
    <button type="button" class="finance-tab" data-dashboard-nav="facturas"><span class="material-symbols-rounded">receipt_long</span> Facturas</button>
    <button type="button" class="finance-tab" data-dashboard-nav="bonos"><span class="material-symbols-rounded">confirmation_number</span> Bonos</button>
    <button type="button" class="finance-tab" data-dashboard-nav="gestoria"><span class="material-symbols-rounded">account_balance</span> Gestoria</button>
  `;
  document.querySelectorAll<HTMLElement>('.finance-tabs[data-finance-tabs]').forEach((nav) => {
    nav.innerHTML = financeTabsMarkup;
  });

  const normalizeSection = (section: string) => {
    const raw = String(section || 'dashboard').trim();
    return sectionAliases[raw] || raw || 'dashboard';
  };

  const runPageLoader = (section: string) => {
    const loader = pageLoaders[section];
    if (!loader) return;
    try {
      const result = (loader as unknown as () => void | Promise<void>)();
      if (result && typeof result.catch === 'function') {
        result.catch((err: any) => {
          console.warn(`[router] loader failed for ${section}:`, err?.message || err);
        });
      }
    } catch (err: any) {
      console.warn(`[router] loader failed for ${section}:`, err?.message || err);
    }
  };

  const navigateTo = (section: string) => {
    const targetSection = normalizeSection(section);
    const targetPage = Array.from(pages).find((page) => (page as HTMLElement).dataset.page === targetSection) as HTMLElement | null;
    if (!targetPage) {
      console.warn(`[router] page not found: ${targetSection}`);
      return;
    }
    const shellNavigate = (window as any).__fisioShellNavigate;
    if (typeof shellNavigate === 'function') {
      shellNavigate(targetSection);
    }
    activeSection = targetSection;
    const sidebarSection = financeSections.has(targetSection) ? 'finanzas' : targetSection;
    navItems.forEach(n => n.classList.toggle('active', n.getAttribute('data-section') === sidebarSection));
    mobileDock?.setAttribute('data-active-section', targetSection);
    mobileDockNavButtons.forEach((button) => button.classList.toggle('active', normalizeSection(button.dataset.mobileNav || '') === targetSection));
    pages.forEach(p => {
      const isActive = (p as HTMLElement).dataset.page === targetSection;
      p.classList.toggle('active', isActive);
      (p as HTMLElement).hidden = !isActive;
      (p as HTMLElement).setAttribute('aria-hidden', isActive ? 'false' : 'true');
    });
    targetPage.classList.add('active');
    targetPage.hidden = false;
    targetPage.setAttribute('aria-hidden', 'false');
    document.body.dataset.activePage = targetSection;
    document.querySelector('.content')?.scrollTo({ top: 0, behavior: 'auto' });
    window.setTimeout(() => runPageLoader(targetSection), 0);
    syncAgendaAutoRefresh();
  };
  (window as any).__fisioFullRouterReady = true;
  document.addEventListener('click', (event: MouseEvent) => {
    const target = event.target as HTMLElement | null;
    const sectionTrigger = target?.closest('.nav-item[data-section], [data-dashboard-nav]') as HTMLElement | null;
    if (!sectionTrigger) return;
    const section = sectionTrigger.getAttribute('data-section') || sectionTrigger.getAttribute('data-dashboard-nav');
    if (!section) return;
    event.preventDefault();
    navigateTo(section);
    if (isMobile()) closeSidebar();
  });

  // === SIDEBAR TOGGLE REMOVED ===

  // === ASSISTANT RAIL TOGGLE REMOVED ===
  // focusAgentNav removed
  heroAgendaShortcutBtn?.addEventListener('click', () => navigateTo('citas'));
  heroNewPatientShortcutBtn?.addEventListener('click', () => openPatientModal());
  dashboardActionButtons.forEach((button) => {
    button.addEventListener('click', (event: Event) => {
      event.preventDefault();
      const action = (button as HTMLElement).dataset.dashboardAction;
      if (action === 'open-booking-page') {
        window.open(buildPublicBookingUrl(), '_blank', 'noopener');
        return;
      }
      if (action === 'open-copilot') {
        requestOpenAssistantRail();
        return;
      }
      if (action === 'new-patient') {
        openPatientModal();
      }
    });
  });
  mainCopilotInput?.addEventListener('keydown', (event: KeyboardEvent) => {
    if (event.key !== 'Enter') return;
    const prompt = mainCopilotInput.value.trim();
    if (!prompt) return;
    requestOpenAssistantRail();
    if (input) {
      input.value = prompt;
      input.dispatchEvent(new Event('input', { bubbles: true }));
      input.focus();
      input.setSelectionRange(input.value.length, input.value.length);
    }
    mainCopilotInput.value = '';
  });
  mobileDockNavButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const section = button.dataset.mobileNav;
      if (!section) return;
      navigateTo(section);
    });
  });
  mobileDockActionButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const action = button.dataset.mobileAction;
      if (action === 'open-copilot') {
        requestOpenAssistantRail();
      }
    });
  });
  dashboardNextSessionBtn?.addEventListener('click', () => {
    const next = dashboardRuntime.nextAppointment;
    const patientId = String(next?.paciente_id || '').trim();
    const patientName = String(next?.nombre_paciente || '').trim();
    if (patientId) {
      selectedPatientId = patientId;
      selectedPatientName = patientName || 'Paciente';
      syncChatPatientSelection(patientId, selectedPatientName);
      void openFichaPaciente(patientId);
      return;
    }
    navigateTo('citas');
  });
  dashboardPriorityList?.addEventListener('click', (event: Event) => {
    const target = event.target as HTMLElement | null;
    const button = target?.closest('button[data-priority-nav], button[data-priority-action]') as HTMLButtonElement | null;
