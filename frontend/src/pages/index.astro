        if (isAllDayAppointment(cita)) return false;
        if (isCalendarOnlyAppointment(cita)) return false;
        const status = String(cita?.estado || '').trim().toLowerCase();
        return !['cancelada', 'completada', 'no_show', 'calendar_cancelled'].includes(status);
