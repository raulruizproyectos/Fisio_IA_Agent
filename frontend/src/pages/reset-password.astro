---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Nueva contraseña | Fisio IA">
  <main class="reset-page">
    <form id="resetForm" class="reset-card">
      <div class="reset-mark"><span class="material-symbols-rounded">lock</span></div>
      <span class="reset-kicker">Seguridad de la cuenta</span>
      <h1>Crea una contraseña nueva</h1>
      <p>Utiliza al menos 10 caracteres y evita reutilizar una contraseña de otro servicio.</p>
      <label>
        <span>Nueva contraseña</span>
        <input id="newPassword" name="password" type="password" autocomplete="new-password" minlength="10" required />
      </label>
      <label>
        <span>Confirmar contraseña</span>
        <input id="confirmPassword" type="password" autocomplete="new-password" minlength="10" required />
      </label>
      <div id="resetFeedback" class="reset-feedback" role="alert" aria-live="polite" hidden></div>
      <button id="resetSubmit" type="submit">Guardar contraseña</button>
      <a href="/login">Volver al acceso profesional</a>
    </form>
  </main>
</Layout>

<script>
  import { authClient } from '../lib/auth';

  const form = document.getElementById('resetForm') as HTMLFormElement;
  const feedback = document.getElementById('resetFeedback') as HTMLElement;
  const submit = document.getElementById('resetSubmit') as HTMLButtonElement;

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const password = (document.getElementById('newPassword') as HTMLInputElement).value;
    const confirmation = (document.getElementById('confirmPassword') as HTMLInputElement).value;
    feedback.classList.remove('is-success');
    if (password !== confirmation) {
      feedback.textContent = 'Las contraseñas no coinciden.';
      feedback.hidden = false;
      return;
    }
    submit.disabled = true;
    const { error } = await authClient.auth.updateUser({ password });
    if (error) {
      feedback.textContent = 'El enlace ha caducado o la contraseña no cumple los requisitos.';
      feedback.hidden = false;
      submit.disabled = false;
      return;
    }
    feedback.textContent = 'Contraseña actualizada. Te llevamos al panel clínico.';
    feedback.classList.add('is-success');
    feedback.hidden = false;
    window.setTimeout(() => window.location.replace('/'), 900);
  });
</script>

<style>
  .reset-page { min-height:100vh; min-height:100dvh; display:grid; place-items:center; padding:1.5rem; background:radial-gradient(circle at 20% 0%,rgba(197,166,103,.16),transparent 32%),#f4f0e8; color:#15231f; }
  .reset-card { width:min(100%,31rem); padding:clamp(2rem,6vw,3.4rem); border:1px solid rgba(22,54,48,.1); border-radius:2rem; background:rgba(255,253,249,.94); box-shadow:0 30px 70px rgba(25,48,43,.11); }
  .reset-mark { width:3rem; height:3rem; display:grid; place-items:center; margin-bottom:1.5rem; border-radius:.9rem; background:#155f56; color:white; }
  .reset-kicker { color:#9a753c; font-size:.7rem; font-weight:800; letter-spacing:.16em; text-transform:uppercase; }
  h1 { margin:.55rem 0 .65rem; font-size:clamp(2rem,5vw,2.8rem); line-height:1.05; letter-spacing:-.045em; }
  p { color:#65736f; line-height:1.6; }
  label { display:grid; gap:.55rem; margin-top:1.2rem; color:#344640; font-size:.78rem; font-weight:750; }
  input { width:100%; padding:.95rem 1rem; border:1px solid #d8dfdb; border-radius:.9rem; background:#fff; color:#15231f; outline:none; }
  input:focus { border-color:#217a6e; box-shadow:0 0 0 4px rgba(33,122,110,.11); }
  button { width:100%; margin-top:1.5rem; padding:1rem; border:0; border-radius:.95rem; background:#155f56; color:#fff; font-weight:800; cursor:pointer; }
  button:disabled { opacity:.6; cursor:wait; }
  a { display:block; margin-top:1.1rem; text-align:center; color:#155f56; font-size:.8rem; font-weight:700; }
  .reset-feedback { margin-top:1rem; padding:.8rem; border-radius:.7rem; background:#fff0ee; color:#9f352d; font-size:.82rem; }
  .reset-feedback.is-success { background:#eaf8f2; color:#155f56; }
</style>
