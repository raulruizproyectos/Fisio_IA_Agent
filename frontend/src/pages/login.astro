---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Acceso profesional | Fisio IA">
  <main class="login-page">
    <section class="login-brand" aria-label="Fisio IA">
      <div class="brand-mark"><span class="material-symbols-rounded">medical_services</span></div>
      <div>
        <span class="brand-kicker">Fisio IA</span>
        <h1>La consulta, bajo control.</h1>
        <p>Agenda, seguimiento clínico e informes terapéuticos en un entorno privado diseñado para profesionales.</p>
      </div>
      <div class="trust-note"><span class="material-symbols-rounded">verified</span><span>Acceso cifrado y datos protegidos por perfil profesional</span></div>
    </section>

    <section class="login-panel">
      <form id="loginForm" class="login-card">
        <header>
          <span>Área profesional</span>
          <h2>Iniciar sesión</h2>
          <p>Utiliza las credenciales asignadas a tu cuenta clínica.</p>
        </header>

        <label>
          <span>Correo profesional</span>
          <input id="email" name="email" type="email" autocomplete="username" required />
        </label>
        <label>
          <span>Contraseña</span>
          <span class="password-field">
            <input id="password" name="password" type="password" autocomplete="current-password" minlength="8" required />
            <button id="passwordToggle" class="password-toggle" type="button" aria-label="Mostrar contraseña">
              <span class="material-symbols-rounded">visibility</span>
            </button>
          </span>
        </label>

        <div id="loginError" class="login-error" role="alert" aria-live="polite" hidden></div>
        <button id="loginSubmit" type="submit">
          <span>Entrar de forma segura</span>
          <span class="material-symbols-rounded">arrow_forward</span>
        </button>
        <button id="passwordReset" class="reset-link" type="button">¿Has olvidado la contraseña?</button>
        <small>El acceso queda registrado por motivos de seguridad clínica.</small>
      </form>
    </section>
  </main>
</Layout>

<script>
  import { authClient } from '../lib/auth';

  const existing = await authClient.auth.getSession();
  if (existing.data.session) window.location.replace('/');

  const form = document.getElementById('loginForm') as HTMLFormElement;
  const errorBox = document.getElementById('loginError') as HTMLElement;
  const submit = document.getElementById('loginSubmit') as HTMLButtonElement;
  const password = document.getElementById('password') as HTMLInputElement;

  document.getElementById('passwordToggle')?.addEventListener('click', () => {
    const visible = password.type === 'text';
    password.type = visible ? 'password' : 'text';
    const toggle = document.getElementById('passwordToggle');
    toggle?.setAttribute('aria-label', visible ? 'Mostrar contraseña' : 'Ocultar contraseña');
    const icon = toggle?.querySelector('.material-symbols-rounded');
    if (icon) icon.textContent = visible ? 'visibility' : 'visibility_off';
  });

  document.getElementById('passwordReset')?.addEventListener('click', async () => {
    const email = String((document.getElementById('email') as HTMLInputElement)?.value || '').trim();
    if (!email) {
      errorBox.textContent = 'Escribe primero tu correo profesional para enviarte el enlace de recuperación.';
      errorBox.hidden = false;
      return;
    }
    const { error } = await authClient.auth.resetPasswordForEmail(email, {
      redirectTo: `${window.location.origin}/reset-password`,
    });
    errorBox.textContent = error
      ? 'No se ha podido enviar el enlace. Inténtalo de nuevo en unos minutos.'
      : 'Si la cuenta existe, recibirás un enlace seguro para crear una contraseña nueva.';
    errorBox.classList.toggle('is-success', !error);
    errorBox.hidden = false;
  });

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    errorBox.hidden = true;
    errorBox.classList.remove('is-success');
    submit.disabled = true;
    const data = new FormData(form);
    const { error } = await authClient.auth.signInWithPassword({
      email: String(data.get('email') || '').trim(),
      password: String(data.get('password') || ''),
    });
    if (error) {
      errorBox.textContent = 'No se ha podido iniciar sesión. Comprueba las credenciales.';
      errorBox.hidden = false;
      submit.disabled = false;
      return;
    }
    window.location.replace('/');
  });
</script>

<style>
  .login-page { min-height: 100vh; display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(420px, .95fr); background: #f4f0e8; color: #15231f; }
  .login-brand { position: relative; overflow: hidden; padding: clamp(3rem, 8vw, 7rem); display: flex; flex-direction: column; justify-content: space-between; background: radial-gradient(circle at 20% 10%, rgba(197,166,103,.22), transparent 34%), linear-gradient(145deg,#123d37 0%,#0d2d29 58%,#09231f 100%); color: #f8f5ee; }
  .login-brand::after { content: ''; position: absolute; width: 38rem; height: 38rem; border: 1px solid rgba(255,255,255,.12); border-radius: 50%; right: -15rem; bottom: -19rem; box-shadow: 0 0 0 5rem rgba(255,255,255,.025),0 0 0 10rem rgba(255,255,255,.018); }
  .brand-mark { width: 3.25rem; height: 3.25rem; display:grid; place-items:center; border:1px solid rgba(255,255,255,.2); border-radius:1rem; background:rgba(255,255,255,.1); backdrop-filter: blur(18px); }
  .brand-kicker { color:#d6bb7b; font-size:.72rem; font-weight:800; letter-spacing:.18em; text-transform:uppercase; }
  h1 { max-width: 12ch; margin:.9rem 0 1.25rem; font-size:clamp(3rem,6vw,5.7rem); line-height:.95; letter-spacing:-.055em; font-weight:650; }
  .login-brand p { max-width: 34rem; color:rgba(248,245,238,.72); font-size:1.08rem; line-height:1.7; }
  .trust-note { z-index:1; display:flex; gap:.75rem; align-items:center; max-width:max-content; padding:.8rem 1rem; border:1px solid rgba(255,255,255,.13); border-radius:999px; color:rgba(248,245,238,.78); background:rgba(255,255,255,.06); font-size:.78rem; }
  .trust-note .material-symbols-rounded { color:#d6bb7b; font-size:1.1rem; }
  .login-panel { display:grid; place-items:center; padding:2rem; }
  .login-card { width:min(100%,28rem); padding:clamp(2rem,5vw,3.25rem); border:1px solid rgba(22,54,48,.1); border-radius:2rem; background:rgba(255,253,249,.88); box-shadow:0 30px 70px rgba(25,48,43,.11); backdrop-filter:blur(24px); }
  .login-card header span { color:#9a753c; font-size:.7rem; font-weight:800; letter-spacing:.16em; text-transform:uppercase; }
  .login-card h2 { margin:.55rem 0 .5rem; font-size:2rem; letter-spacing:-.035em; }
  .login-card header p { margin-bottom:2rem; color:#65736f; line-height:1.55; }
  label { display:grid; gap:.55rem; margin-top:1.15rem; color:#344640; font-size:.78rem; font-weight:750; }
  input { width:100%; padding:.95rem 1rem; border:1px solid #d8dfdb; border-radius:.9rem; background:#fff; color:#15231f; outline:none; transition:.2s; }
  .password-field { position:relative; display:block; }
  .password-field input { padding-right:3.2rem; }
  .password-toggle { position:absolute; right:.45rem; top:50%; width:2.35rem; min-height:2.35rem; margin:0; padding:0; transform:translateY(-50%); justify-content:center; border-radius:.7rem; background:transparent; color:#65736f; box-shadow:none; }
  .password-toggle:hover { background:#eef5f2; color:#155f56; transform:translateY(-50%); }
  input:focus { border-color:#217a6e; box-shadow:0 0 0 4px rgba(33,122,110,.11); }
  button { width:100%; margin-top:1.5rem; padding:1rem 1.1rem; display:flex; justify-content:space-between; align-items:center; border:0; border-radius:.95rem; background:#155f56; color:#fff; font-weight:800; cursor:pointer; box-shadow:0 12px 28px rgba(21,95,86,.2); }
  button:hover { background:#104d46; transform:translateY(-1px); }
  button:disabled { opacity:.6; cursor:wait; }
  .login-error { margin-top:1rem; padding:.8rem; border-radius:.7rem; background:#fff0ee; color:#9f352d; font-size:.82rem; }
  .login-error.is-success { background:#eaf8f2; color:#155f56; }
  .reset-link { display:block; width:auto; min-height:auto; margin:1rem auto 0; padding:.35rem; background:transparent; color:#155f56; box-shadow:none; font-size:.78rem; }
  .reset-link:hover { background:transparent; color:#0d443d; transform:none; text-decoration:underline; }
  small { display:block; margin-top:1rem; text-align:center; color:#7d8985; font-size:.7rem; }
  @media (max-width: 820px) { .login-page { grid-template-columns:1fr; } .login-brand { min-height:20rem; padding:2rem; } h1 { font-size:3.2rem; } .trust-note { display:none; } .login-panel { margin-top:-2rem; z-index:2; } }
</style>
