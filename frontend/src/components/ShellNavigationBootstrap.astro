<script is:inline>
  (() => {
    const shellConfig = {
      aliases: {
        inicio: 'dashboard',
        home: 'dashboard',
        finanzas: 'pagos',
        payments: 'pagos',
        documentos: 'documentos',
      },
      financeSections: ['pagos', 'facturas', 'bonos', 'gestoria'],
    };
    window.__fisioShellConfig = shellConfig;
    const aliases = shellConfig.aliases;
    const financeSections = new Set(shellConfig.financeSections);
    const normalize = (section) => {
      const raw = String(section || 'dashboard').trim();
      return aliases[raw] || raw || 'dashboard';
    };
    const showPage = (section) => {
      const targetSection = normalize(section);
      const pages = Array.from(document.querySelectorAll('.page-section'));
      const targetPage = pages.find((page) => page.dataset.page === targetSection);
      if (!targetPage) return;
      pages.forEach((page) => {
        const active = page === targetPage;
        page.classList.toggle('active', active);
        page.hidden = !active;
        page.setAttribute('aria-hidden', active ? 'false' : 'true');
      });
      const sidebarSection = financeSections.has(targetSection) ? 'finanzas' : targetSection;
      document.querySelectorAll('.nav-item[data-section]').forEach((item) => {
        item.classList.toggle('active', item.getAttribute('data-section') === sidebarSection);
      });
      const mobileDock = document.getElementById('mobileDock');
      mobileDock?.setAttribute('data-active-section', targetSection);
      document.querySelectorAll('[data-mobile-nav]').forEach((item) => {
        item.classList.toggle('active', normalize(item.getAttribute('data-mobile-nav')) === targetSection);
      });
      document.body.dataset.activePage = targetSection;
      document.querySelector('.content')?.scrollTo({ top: 0, behavior: 'auto' });
      document.dispatchEvent(new CustomEvent('fisio:shell-navigate', { detail: { section: targetSection } }));
    };

    window.__fisioShellNavigate = showPage;
    showPage(document.querySelector('.page-section.active')?.getAttribute('data-page') || 'dashboard');
    document.addEventListener('click', (event) => {
      if (window.__fisioFullRouterReady) return;
      const trigger = event.target?.closest?.('.nav-item[data-section], [data-dashboard-nav], [data-mobile-nav]');
      if (!trigger) return;
      const section = trigger.getAttribute('data-section') || trigger.getAttribute('data-dashboard-nav') || trigger.getAttribute('data-mobile-nav');
      if (!section) return;
      event.preventDefault();
      showPage(section);
    }, true);
  })();
</script>
