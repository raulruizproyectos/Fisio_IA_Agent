<script>
  import { activePage } from '../store';
  import { activateSection, normalizeSection, shellConfig } from '../lib/navigation';

  (window as any).__fisioShellConfig = shellConfig;
  (window as any).__fisioShellNavigate = (section: string) => activePage.set(normalizeSection(section));
  activePage.subscribe(activateSection);

  // Keep basic navigation available while the authenticated controller starts.
  document.addEventListener('click', (event) => {
    if ((window as any).__fisioFullRouterReady) return;
    const target = event.target as HTMLElement | null;
    const trigger = target?.closest('.nav-item[data-section], [data-dashboard-nav], [data-mobile-nav]');
    const section = trigger?.getAttribute('data-section') || trigger?.getAttribute('data-dashboard-nav') || trigger?.getAttribute('data-mobile-nav');
    if (!section) return;
    event.preventDefault();
    activePage.set(normalizeSection(section));
  }, true);
</script>
