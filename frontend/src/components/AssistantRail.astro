<aside class="assistant-rail" id="assistantRail" aria-label="Copilot clinico" data-copilot-build="clinical-studio-20260506">
  <section class="ai-clinical-module card assistant-rail-card">
    <header class="module-header assistant-module-header">
      <div class="assistant-rail-copy">
        <div class="assistant-rail-header-row">
          <span class="assistant-eyebrow">LABORATORIO TERAP&Eacute;UTICO</span>
          <div class="assistant-connected-badge">
            <span class="status-dot connected pulse-dot" id="agentDot"></span>
            <span class="status-text" id="agentStatusText">CONECTADO</span>
          </div>
        </div>
      </div>
      <div class="assistant-rail-tools">
        <button type="button" class="assistant-rail-close" id="assistantRailClose" aria-label="Cerrar copilot">
          <span class="material-symbols-rounded">close</span>
        </button>
      </div>
    </header>

    <div class="assistant-rail-body">
      <section class="assistant-console" aria-label="Consola clinica">
        <div class="assistant-toolbar">
          <div class="patient-selector assistant-console-selector">
            <span class="material-symbols-rounded">person</span>
            <select id="chatPatientSelect" aria-label="Paciente del informe">
              <option value="">Selecciona paciente para informe...</option>
            </select>
          </div>
          <div class="assistant-live-context" aria-live="polite" hidden>
            <strong id="assistantPatientLabel">Sin paciente seleccionado</strong>
            <p id="assistantPatientMeta">Selecciona uno para vincular la conversacion, el plan, el PDF y el seguimiento a su historial.</p>
          </div>
        </div>

        <section class="assistant-report-priority-card" aria-label="Flujo diferencial de informe IA">
          <div class="assistant-report-copy">
            <span class="assistant-brief-kicker">Estudio de informe IA</span>
            <strong>Ejercicios revisables, PDF clinico y entrega por Telegram</strong>
            <p>Sintomas, objetivo y contexto del paciente se convierten en un borrador clinico listo para validar antes de enviarlo.</p>
          </div>
          <ol class="assistant-report-flow" aria-label="Proceso del informe">
            <li><span>1</span>Contexto</li>
            <li><span>2</span>Plan</li>
            <li><span>3</span>Entrega</li>
          </ol>
          <span class="assistant-report-priority-icon material-symbols-rounded">route</span>
        </section>

        <div class="assistant-dialog-surface">
          <div class="assistant-dialog-scroll">
            <div class="assistant-mode-switch" id="assistantModeSwitch" aria-label="Modo de trabajo del copilot">
              <button type="button" class="assistant-mode-chip is-active" data-assistant-mode="new-plan" aria-pressed="true"><span class="material-symbols-rounded">electric_bolt</span> Plan nuevo</button>
              <button type="button" class="assistant-mode-chip" data-assistant-mode="update-plan" aria-pressed="false"><span class="material-symbols-rounded">neurology</span> Ajuste</button>
              <button type="button" class="assistant-mode-chip" data-assistant-mode="next-session" aria-pressed="false"><span class="material-symbols-rounded">event_available</span> Visita</button>
            </div>

            <div class="assistant-patient-brief" id="assistantPatientBrief" aria-live="polite" hidden></div>
            <div class="assistant-flow-card" id="assistantFlowCard" aria-live="polite" hidden>
              <strong id="assistantFlowTitle"></strong>
              <div class="assistant-flow-steps" id="assistantFlowSteps"></div>
              <p class="assistant-flow-hint" id="assistantFlowHint"></p>
              <p class="assistant-flow-draft" id="assistantFlowDraft"></p>
            </div>
            <div class="assistant-mode-card" id="assistantModeCard" aria-live="polite" hidden>
              <strong id="assistantModeTitle">Nuevo plan guiado</strong>
              <p id="assistantModeSummary"></p>
              <span id="assistantModeOutput"></span>
              <span id="assistantModeRequirement"></span>
              <p id="assistantModeTip"></p>
            </div>

            <section class="assistant-diagnostic-card" id="assistantDiagnosticCard" aria-live="polite">
              <div class="assistant-diagnostic-head">
                <div class="assistant-diagnostic-copy">
                  <span class="assistant-brief-kicker">Ficha estructurada</span>
                  <strong>Contexto clinico opcional para afinar la IA</strong>
                </div>
                <button type="button" class="assistant-diagnostic-toggle" id="assistantDiagnosticToggle" aria-expanded="false">Anadir contexto</button>
              </div>
              <div class="assistant-diagnostic-grid">
                <label class="assistant-intake-field">
                  <span>Area afectada</span>
                  <select id="assistantAreaInput">
                    <option value="">Selecciona zona</option>
                    <option value="Cervical">Cervical</option>
                    <option value="Hombro">Hombro</option>
                    <option value="Lumbar">Lumbar</option>
                    <option value="Cadera">Cadera</option>
                    <option value="Rodilla">Rodilla</option>
                    <option value="Tobillo/Pie">Tobillo / pie</option>
                    <option value="General">General</option>
                  </select>
                </label>
                <label class="assistant-intake-field">
                  <span>Tipo de caso</span>
                  <select id="assistantInjuryTypeInput">
                    <option value="">Selecciona caso</option>
                    <option value="Dolor mecanico">Dolor mecanico</option>
                    <option value="Postoperatorio">Postoperatorio</option>
                    <option value="Sobrecarga">Sobrecarga</option>
                    <option value="Recuperacion deportiva">Recuperacion deportiva</option>
                    <option value="Limitacion funcional">Limitacion funcional</option>
                    <option value="Prevencion / mantenimiento">Prevencion / mantenimiento</option>
                  </select>
                </label>
                <label class="assistant-intake-field assistant-intake-field-wide assistant-objective-field">
                  <span>Objetivo clinico / matices</span>
                  <textarea id="assistantObjectiveInput" rows="2" placeholder="Ej. bajar dolor, recuperar movilidad, evitar flexion profunda, volver a correr"></textarea>
                </label>
                <label class="assistant-intake-field">
                  <span>Duracion sintomas</span>
                  <input id="assistantDurationInput" type="text" placeholder="Ej. 3 semanas" />
                </label>
                <label class="assistant-intake-field">
                  <span>Dolor actual</span>
                  <select id="assistantPainLevelInput">
                    <option value="">Escala 0-10</option>
                    <option value="1/10">1/10</option>
                    <option value="2/10">2/10</option>
                    <option value="3/10">3/10</option>
                    <option value="4/10">4/10</option>
                    <option value="5/10">5/10</option>
                    <option value="6/10">6/10</option>
                    <option value="7/10">7/10</option>
                    <option value="8/10">8/10</option>
                    <option value="9/10">9/10</option>
                    <option value="10/10">10/10</option>
                  </select>
                </label>
              </div>
              <p class="assistant-diagnostic-summary" id="assistantDiagnosticSummary">Sin ficha estructurada todavia. Completa 2 o 3 campos y el agente trabajara con una entrada mas clinica.</p>
            </section>

            <div class="assistant-delivery-card" id="assistantDeliveryCard" aria-live="polite" hidden>
              <div class="assistant-delivery-head">
                <span class="assistant-brief-kicker">Entrega paciente</span>
                <strong id="assistantDeliveryStatus">Sin paciente vinculado</strong>
              </div>
              <p class="assistant-delivery-summary" id="assistantDeliverySummary">Selecciona un paciente para preparar el envio por Telegram y la exportacion del PDF.</p>
              <div class="assistant-delivery-pills" id="assistantDeliveryPills"></div>
            </div>
          </div>

          <form id="agentForm" class="ai-input-area">
            <div class="assistant-agent-canvas" id="assistantAgentCanvas" aria-label="Inicios rapidos del agente clinico">
              <div class="assistant-agent-canvas-copy">
                <span>Copilot clinico</span>
                <strong>Que quieres resolver ahora?</strong>
              </div>
              <div class="assistant-agent-prompts">
                <button type="button" data-assistant-mode="new-plan" data-assistant-prompt="Paciente con dolor lumbar mecanico de 3 semanas. Objetivo: reducir dolor y recuperar flexion sin molestias. Genera un plan domiciliario progresivo, seguro y facil de explicar.">Plan lumbar</button>
                <button type="button" data-assistant-mode="update-plan" data-assistant-prompt="Revisa el plan activo del paciente. Propon ajuste segun dolor, adherencia, progresion y criterios para avanzar o bajar carga.">Ajustar plan</button>
                <button type="button" data-assistant-mode="next-session" data-assistant-prompt="Prepara una checklist breve para la proxima visita: que preguntar, que medir, que ejercicio revisar y que decision tomar.">Proxima visita</button>
              </div>
            </div>
            <div class="assistant-composer-shell">
              <div class="ai-textarea-wrapper">
                <textarea id="agentInput" rows="1" placeholder="Anade objetivo, limitaciones o preferencias para completar la ficha estructurada..."></textarea>
              </div>
              <button type="submit" class="btn-action btn-chat btn-send-compact" id="sendBtn" aria-label="Preguntar a IA" title="Pregunta general (Chat)">
                <span class="material-symbols-rounded">arrow_upward</span>
              </button>
            </div>
            <p class="assistant-context-hint">La IA combinara este texto con area, tipo de caso, duracion y dolor para generar un plan mas afinado.</p>
            <div class="assistant-action-grid">
              <button type="button" class="btn-action btn-pdf is-pending" id="exercisePdfBtn" aria-label="PDF disponible tras generar un plan" title="Genera un plan para habilitar el PDF"><span class="material-symbols-rounded">picture_as_pdf</span> PDF al generar</button>
              <button type="button" class="btn-action btn-telegram is-pending" id="exerciseTelegramBtn" aria-label="Enviar plan por Telegram" title="Vincula Telegram para enviar el plan al paciente"><span class="material-symbols-rounded">send</span> Telegram paciente</button>
              <button type="button" class="btn-action btn-generate" id="exerciseRecoBtn" aria-label="Generar Plan de Ejercicios"><span class="material-symbols-rounded">electric_bolt</span> Generar Plan</button>
            </div>
            <p class="assistant-disclaimer">El asistente puede cometer errores. Verifica siempre la informacion medica.</p>
          </form>

          <div class="chat-log" id="chatLog"></div>
        </div>
      </section>
    </div>
  </section>
</aside>

<div class="assistant-rail-backdrop" id="assistantRailBackdrop"></div>
<button class="assistant-fab" id="assistantRailFab" type="button" aria-label="Abrir copiloto clinico" aria-controls="assistantRail" aria-expanded="false">
  <span class="material-symbols-rounded">robot_2</span>
  <span>Copiloto</span>
</button>
