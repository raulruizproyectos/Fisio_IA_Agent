---
// AssistantRail.astro — clinical copilot. One column: patient and mode, collapsible case context,
// conversation, composer and the plan actions (generate → approve → PDF / Telegram).
// IDs, data-* and the classes read by index.astro are contracts: keep them.
---

<aside class="assistant-rail translate-x-full" id="assistantRail" aria-label="Copiloto clínico" aria-hidden="true" data-copilot-build="clinical-copilot-20260518">

  <header class="cp-header">
    <div class="assistant-rail-heading">
      <span class="assistant-brand-mark material-symbols-rounded" aria-hidden="true">clinical_notes</span>
      <div class="cp-heading-text">
        <div class="cp-eyebrow">
          <span>Copiloto clínico</span>
          <span class="cp-status">
            <span class="cp-status-dot" id="agentDot" aria-hidden="true"></span>
            <span id="agentStatusText">Conectado</span>
          </span>
        </div>
        <h2>Plan terapéutico asistido</h2>
      </div>
    </div>
    <button type="button" class="cp-icon-btn" id="assistantRailClose" aria-label="Cerrar copiloto">
      <span class="material-symbols-rounded" aria-hidden="true">close</span>
    </button>
  </header>

  <ol class="assistant-care-stepper" aria-label="Flujo del plan clínico">
    <li class="is-current"><span>1</span><strong>Contexto</strong></li>
    <li><span>2</span><strong>Propuesta</strong></li>
    <li><span>3</span><strong>Revisión</strong></li>
    <li><span>4</span><strong>Entrega</strong></li>
  </ol>

  <div class="cp-body">
    <main class="cp-main" aria-label="Conversación con el copiloto">

      <section class="cp-setup" aria-label="Paciente y modo de trabajo">
        <!-- Compact patient card: label/meta filled by index.astro; the select shows when there is no patient or on «Cambiar». -->
        <div class="cp-patient">
          <span class="cp-patient-avatar" aria-hidden="true"><span class="material-symbols-rounded">person</span></span>
          <div class="cp-patient-text">
            <strong id="assistantPatientLabel">Sin paciente seleccionado</strong>
            <span id="assistantPatientMeta">Selecciona uno para vincular la conversación.</span>
          </div>
          <div class="cp-select">
            <span class="material-symbols-rounded cp-select-icon" aria-hidden="true">person_search</span>
            <select id="chatPatientSelect" aria-label="Paciente del informe">
              <option value="">Selecciona paciente para informe...</option>
            </select>
            <span class="material-symbols-rounded cp-select-chevron" aria-hidden="true">expand_more</span>
          </div>
          <div class="cp-patient-actions">
            <button type="button" class="cp-link-btn cp-patient-change">Cambiar</button>
            <button type="button" class="cp-link-btn cp-patient-context" aria-expanded="false" aria-controls="assistantContextPanel">
              Ver contexto<span class="material-symbols-rounded" aria-hidden="true">expand_more</span>
            </button>
          </div>
        </div>
        <div class="cp-segmented" id="assistantModeSwitch" role="group" aria-label="Modo de trabajo del copiloto">
          <button type="button" class="is-active" data-assistant-mode="new-plan" aria-pressed="true">
            <span class="material-symbols-rounded" aria-hidden="true">electric_bolt</span> Plan nuevo
          </button>
          <button type="button" data-assistant-mode="update-plan" aria-pressed="false">
            <span class="material-symbols-rounded" aria-hidden="true">tune</span> Ajustar
          </button>
          <button type="button" data-assistant-mode="next-session" aria-pressed="false">
            <span class="material-symbols-rounded" aria-hidden="true">event_available</span> Próxima visita
          </button>
        </div>
      </section>

      <div class="cp-context" id="assistantContextPanel" hidden>
        <div class="cp-context-body" aria-label="Contexto clínico del paciente">
          <div class="cp-brief" id="assistantPatientBrief" aria-live="polite"></div>

          <div class="cp-diagnostic" id="assistantDiagnosticCard">
            <div class="cp-diagnostic-head">
              <div>
                <span class="cp-kicker">Contexto estructurado</span>
                <strong>Afinar la propuesta</strong>
              </div>
              <button type="button" class="cp-link-btn" id="assistantDiagnosticToggle" aria-expanded="false" aria-controls="assistantDiagnosticGrid">Añadir contexto</button>
            </div>
            <div class="cp-diagnostic-grid" id="assistantDiagnosticGrid">
              <label>
                <span>Área afectada</span>
                <select id="assistantAreaInput">
                  <option value="">Seleccionar...</option>
                  <option value="Cervical">Cervical</option><option value="Dorsal">Dorsal</option>
                  <option value="Lumbar">Lumbar</option><option value="Hombro">Hombro</option>
                  <option value="Codo y muñeca">Codo y muñeca</option><option value="Cadera">Cadera</option>
                  <option value="Rodilla">Rodilla</option><option value="Tobillo y pie">Tobillo y pie</option>
                </select>
              </label>
              <label>
                <span>Tipo de caso</span>
                <select id="assistantInjuryTypeInput">
                  <option value="">Seleccionar...</option>
                  <option value="Dolor mecanico">Dolor mecánico</option>
                  <option value="Lesion deportiva">Lesión deportiva</option>
                  <option value="Postoperatorio">Postoperatorio</option>
                  <option value="Dolor cronico">Dolor crónico</option>
                </select>
              </label>
              <label>
                <span>Duración</span>
                <input id="assistantDurationInput" type="text" placeholder="Ej. 3 semanas" />
              </label>
              <label>
                <span>Dolor (0–10)</span>
                <select id="assistantPainLevelInput">
                  <option value="">Escala</option>
                  <option value="0/10">0</option><option value="1/10">1</option><option value="2/10">2</option>
                  <option value="3/10">3</option><option value="4/10">4</option><option value="5/10">5</option>
                  <option value="6/10">6</option><option value="7/10">7</option><option value="8/10">8</option>
                  <option value="9/10">9</option><option value="10/10">10</option>
                </select>
              </label>
              <label class="cp-span-2">
                <span>Objetivo</span>
                <textarea id="assistantObjectiveInput" rows="2" placeholder="Ej. volver a correr 5 km sin dolor"></textarea>
              </label>
            </div>
            <p class="cp-diagnostic-summary" id="assistantDiagnosticSummary">Rellena 2 o 3 campos para una propuesta más precisa.</p>
          </div>
        </div>
      </div>

      <div class="assistant-dialog-surface">
        <div class="assistant-dialog-scroll">
          <div class="cp-log" id="chatLog"></div>
        </div>
      </div>

      <div class="assistant-quick-actions" id="assistantQuickActions">
        <span class="quick-actions-label">Atajos</span>
        <div class="quick-action-chips">
          <button type="button" class="quick-action-chip" data-prompt="Diseña un plan de ejercicios para hernia discal lumbar L5-S1 con foco en core (Bird-Dog, planchas laterales y puentes glúteos). Habilita el PDF para casa.">
            <span class="material-symbols-rounded" aria-hidden="true">fitness_center</span> Hernia L5-S1
          </button>
          <button type="button" class="quick-action-chip" data-prompt="Genera una nota SOAP evolutiva para un esguince de tobillo grado II. Incluye progresión en rango de movimiento, movilizaciones manuales y propiocepción.">
            <span class="material-symbols-rounded" aria-hidden="true">edit_note</span> Nota SOAP tobillo
          </button>
          <button type="button" class="quick-action-chip" data-prompt="Optimiza mi agenda de mañana: analiza solapamientos de citas, propón descansos operativos de 10 minutos y sugiere huecos ideales.">
            <span class="material-symbols-rounded" aria-hidden="true">schedule</span> Optimizar agenda
          </button>
        </div>
      </div>

      <form id="agentForm" class="ai-input-area">
        <div class="hidden" id="assistantAgentCanvas" aria-label="Prompts rápidos del agente clínico">
          <button type="button" data-assistant-mode="new-plan" data-assistant-prompt="Paciente con dolor lumbar mecánico de 3 semanas. Objetivo: reducir dolor y recuperar flexión sin molestias. Genera un plan domiciliario progresivo, seguro y fácil de explicar.">Plan lumbar</button>
          <button type="button" data-assistant-mode="update-plan" data-assistant-prompt="Revisa el plan activo del paciente. Propón ajuste según dolor, adherencia, progresión y criterios para avanzar o bajar carga.">Ajustar plan</button>
          <button type="button" data-assistant-mode="next-session" data-assistant-prompt="Prepara una checklist breve para la próxima visita: qué preguntar, qué medir, qué ejercicio revisar y qué decisión tomar.">Próxima visita</button>
        </div>

        <div class="cp-input">
          <label class="sr-only" for="agentInput">Mensaje para el copiloto</label>
          <textarea id="agentInput" rows="1" placeholder="Describe el caso: objetivo, síntomas, restricciones o material disponible…"></textarea>
          <button type="submit" class="cp-send" id="sendBtn" aria-label="Enviar mensaje" title="Enviar mensaje">
            <span class="material-symbols-rounded" aria-hidden="true">arrow_upward</span>
          </button>
        </div>

        <div class="cp-actions" aria-label="Acciones del plan">
          <button type="button" class="cp-btn cp-btn-primary" id="exerciseRecoBtn" aria-label="Generar plan de ejercicios">
            <span class="material-symbols-rounded" aria-hidden="true">electric_bolt</span> Generar plan
          </button>
          <div class="cp-delivery" role="group" aria-label="Revisión y entrega">
            <button type="button" class="cp-btn cp-btn-approve" id="exerciseApproveBtn" aria-label="Aprobar plan tras revisión clínica" title="Genera un plan para revisarlo" disabled>
              <span class="material-symbols-rounded" aria-hidden="true">verified</span> Aprobar
            </button>
            <button type="button" class="cp-btn cp-btn-secondary" id="exercisePdfBtn" aria-label="PDF disponible tras aprobar el plan" title="Genera y aprueba un plan para habilitar el PDF" disabled>
              <span class="material-symbols-rounded" aria-hidden="true">picture_as_pdf</span> PDF
            </button>
            <button type="button" class="cp-btn cp-btn-secondary" id="exerciseTelegramBtn" aria-label="Enviar plan por Telegram" title="Vincula Telegram para enviar el plan al paciente" disabled>
              <span class="material-symbols-rounded" aria-hidden="true">send</span> Telegram
            </button>
          </div>
          <div hidden>
            <button type="button" data-agent-shortcut="Añade una evolución clínica..."></button>
            <button type="button" data-agent-shortcut="Reescribe las instrucciones..."></button>
          </div>
        </div>
        <p class="cp-guard"><span class="material-symbols-rounded" aria-hidden="true">lock</span> El PDF y el envío al paciente solo se habilitan tras tu aprobación.</p>
      </form>
    </main>

    <!-- Hidden elements required by index.astro -->
    <div hidden aria-hidden="true">
      <div id="assistantModeCard"><strong id="assistantModeTitle"></strong><p id="assistantModeSummary"></p><span id="assistantModeOutput"></span><span id="assistantModeRequirement"></span><p id="assistantModeTip"></p></div>
      <div id="assistantFlowCard"><strong id="assistantFlowTitle"></strong><div id="assistantFlowSteps"></div><p id="assistantFlowHint"></p><p id="assistantFlowDraft"></p></div>
      <div id="assistantDeliveryCard"><strong id="assistantDeliveryStatus"></strong><p id="assistantDeliverySummary"></p><div id="assistantDeliveryPills"></div></div>
      <div id="assistantShortcuts">
        <button type="button" data-agent-shortcut="..."></button>
      </div>
    </div>
  </div>

  <section class="exercise-editor" id="exerciseReportEditor" hidden aria-hidden="true" aria-labelledby="exerciseEditorTitle">
    <header class="exercise-editor-header">
      <div>
        <span>Revisión profesional</span>
        <h2 id="exerciseEditorTitle">Editar plan terapéutico</h2>
        <p>Ajusta el contenido que recibirá el paciente antes de aprobarlo.</p>
      </div>
      <button type="button" id="exerciseEditorClose" aria-label="Cerrar editor">
        <span class="material-symbols-rounded">close</span>
      </button>
    </header>

    <form class="exercise-editor-form" id="exerciseEditorForm">
      <div class="exercise-editor-intro">
        <label>
          <span>Resumen clínico</span>
          <textarea id="exerciseEditorSummary" rows="3" maxlength="1200"></textarea>
        </label>
        <label>
          <span>Indicaciones para el paciente</span>
          <textarea id="exerciseEditorPatientMessage" rows="3" maxlength="1200"></textarea>
        </label>
      </div>

      <div class="exercise-editor-section-heading">
        <div>
          <span>Ejercicios del plan</span>
          <strong>Edita dosis e instrucciones</strong>
        </div>
        <small>Los cambios quedan vinculados al historial.</small>
      </div>
      <div class="exercise-editor-list" id="exerciseEditorList"></div>
      <p class="exercise-editor-feedback" id="exerciseEditorFeedback" role="status" hidden></p>

      <footer class="exercise-editor-footer">
        <button type="button" class="exercise-editor-cancel" id="exerciseEditorCancel">Cancelar</button>
        <button type="submit" class="exercise-editor-save" id="exerciseEditorSave">
          <span class="material-symbols-rounded">save</span>
          Guardar cambios
        </button>
      </footer>
    </form>
  </section>
</aside>

<div class="fixed inset-0 bg-black/50 z-40 opacity-0 pointer-events-none transition-opacity duration-200 md:hidden assistant-rail-backdrop" id="assistantRailBackdrop" aria-hidden="true"></div>

<button class="fixed bottom-5 right-5 z-30 bg-emerald-600 hover:bg-emerald-500 text-white shadow-xl flex items-center gap-2 px-4 py-2.5 rounded-full transition-all md:hidden assistant-fab" id="assistantRailFab" type="button" aria-label="Abrir copiloto clínico" aria-controls="assistantRail" aria-expanded="false">
  <span class="material-symbols-rounded text-lg">auto_awesome</span>
  <span class="text-xs font-semibold">Copiloto</span>
</button>

<script>
  import { assistantState } from '../store';

  const assistantRail = document.getElementById('assistantRail');
  const assistantRailBackdrop = document.getElementById('assistantRailBackdrop');
  const assistantRailFab = document.getElementById('assistantRailFab');
  const assistantRailToggle = document.getElementById('assistantRailToggle');

  const updateRailStyles = (isOpen: boolean) => {
    const isMobile = window.innerWidth <= 768;
    const mode = isOpen ? (isMobile ? 'open-mobile' : 'open-desktop') : 'closed';
    document.documentElement.setAttribute('data-assistant-state', mode);
    document.body.classList.toggle('assistant-rail-is-open', isOpen);
    document.body.classList.toggle('assistant-rail-is-mobile', isOpen && isMobile);
    document.body.classList.toggle('assistant-rail-is-desktop', isOpen && !isMobile);

    if (isOpen) {
      assistantRail?.classList.add('open');
      assistantRail?.classList.toggle('is-open-mobile', isMobile);
      assistantRail?.classList.toggle('is-open-desktop', !isMobile);
      assistantRail?.classList.remove('translate-x-full');
      assistantRail?.classList.add('translate-x-0');
      assistantRailBackdrop?.classList.toggle('visible', isMobile);
      assistantRail?.setAttribute('aria-hidden', 'false');
      assistantRailFab?.setAttribute('aria-expanded', 'true');
      assistantRailToggle?.setAttribute('aria-expanded', 'true');
      assistantRailFab?.toggleAttribute('hidden', true);
    } else {
      assistantRail?.classList.remove('open');
      assistantRail?.classList.remove('is-open-mobile', 'is-open-desktop');
      assistantRail?.classList.remove('translate-x-0');
      assistantRail?.classList.add('translate-x-full');
      assistantRailBackdrop?.classList.remove('visible');
      assistantRail?.setAttribute('aria-hidden', 'true');
      assistantRailFab?.setAttribute('aria-expanded', 'false');
      assistantRailToggle?.setAttribute('aria-expanded', 'false');
      assistantRailFab?.toggleAttribute('hidden', false);
    }
  };

  // «Button → panel»: opened from the top bar button, the panel grows out of the button's shape
  // (clip-path, 340 ms) and its content fades in. Desktop only; off with reduced motion.
  let morphFromToggle = false;
  let wasOpen = false;
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  assistantRailToggle?.addEventListener('click', () => { morphFromToggle = true; }, { capture: true });

  const morphFromButton = () => {
    if (!assistantRail || !assistantRailToggle || reduceMotion.matches || window.innerWidth < 1024) return;
    if (typeof assistantRail.animate !== 'function') return;
    // Skip the slide before any layout read, so the transition never starts.
    assistantRail.classList.add('cp-morphing');
    const b = assistantRailToggle.getBoundingClientRect();
    const p = assistantRail.getBoundingClientRect();
    if (!b.width || !p.width) { assistantRail.classList.remove('cp-morphing'); return; }
    const top = Math.max(0, b.top - p.top);
    const left = Math.max(0, b.left - p.left);
    const right = Math.max(0, p.right - b.right);
    const bottom = Math.max(0, p.bottom - b.bottom);
    const morph = assistantRail.animate(
      [
        { clipPath: `inset(${top}px ${right}px ${bottom}px ${left}px round 999px)` },
        { clipPath: 'inset(0px 0px 0px 0px round 0px)' },
      ],
      { duration: 340, easing: 'cubic-bezier(0.16, 1, 0.3, 1)' },
    );
    assistantRail.querySelectorAll<HTMLElement>(':scope > .cp-header, :scope > .assistant-care-stepper, :scope > .cp-body').forEach((part) => {
      part.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 200, delay: 140, easing: 'ease-out', fill: 'backwards' });
    });
    const done = () => assistantRail.classList.remove('cp-morphing');
    morph.finished.then(done, done);
  };

  assistantState.subscribe((state) => {
    updateRailStyles(state.isOpen);
    if (state.isOpen && !wasOpen && morphFromToggle) morphFromButton();
    morphFromToggle = false;
    wasOpen = state.isOpen;
  });

  const closeAssistant = () => {
    const current = assistantState.get();
    assistantState.set({ ...current, isOpen: false });
  };

  const openAssistant = () => {
    const current = assistantState.get();
    assistantState.set({ ...current, isOpen: true });
  };

  const toggleAssistant = () => {
    const current = assistantState.get();
    assistantState.set({ ...current, isOpen: !current.isOpen });
  };

  document.getElementById('assistantRailClose')?.addEventListener('click', closeAssistant);
  document.getElementById('assistantRailBackdrop')?.addEventListener('click', closeAssistant);
  document.getElementById('assistantRailFab')?.addEventListener('click', openAssistant);

  assistantRailToggle?.addEventListener('click', toggleAssistant);
  document.addEventListener('fisio:open-assistant', openAssistant);
  document.addEventListener('fisio:close-assistant', closeAssistant);
  document.addEventListener('fisio:toggle-assistant', toggleAssistant);

  // Compact patient card: «Cambiar» reveals the selector, «Ver contexto» unfolds the case context.
  const patientCard = assistantRail?.querySelector<HTMLElement>('.cp-patient');
  const patientSelect = document.getElementById('chatPatientSelect') as HTMLSelectElement | null;
  const contextPanel = document.getElementById('assistantContextPanel');
  const contextToggle = assistantRail?.querySelector<HTMLButtonElement>('.cp-patient-context');
  const stopChanging = () => patientCard?.classList.remove('is-changing');

  assistantRail?.querySelector('.cp-patient-change')?.addEventListener('click', () => {
    patientCard?.classList.add('is-changing');
    patientSelect?.focus();
    try { (patientSelect as any)?.showPicker?.(); } catch { /* not supported: focus is enough */ }
  });
  patientSelect?.addEventListener('change', stopChanging);
  patientSelect?.addEventListener('blur', () => window.setTimeout(stopChanging, 120));
  patientSelect?.addEventListener('keydown', (event) => { if (event.key === 'Escape') stopChanging(); });

  contextToggle?.addEventListener('click', () => {
    if (!contextPanel) return;
    const willOpen = contextPanel.hidden;
    contextPanel.hidden = !willOpen;
    contextToggle.setAttribute('aria-expanded', String(willOpen));
  });

  // Resize listener to maintain styles if opened
  window.addEventListener('resize', () => {
    if (assistantState.get().isOpen) {
      updateRailStyles(true);
    }
  });
</script>
