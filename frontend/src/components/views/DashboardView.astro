---
// DashboardView.astro
---

<!-- === PAGE: DASHBOARD === -->
<div class="page-section active" data-page="dashboard">
  <section class="clinic-dashboard" aria-labelledby="dashboardTitle">
    <header class="clinic-dashboard-hero">
      <div class="clinic-dashboard-copy">
        <span class="clinic-kicker">Clinical OS</span>
        <h1 id="dashboardTitle">Buenos dias, Dr.</h1>
        <p id="dashboardLiveSummary">Cargando agenda, mensajes y sincronizacion clinica...</p>
        <div class="clinic-hero-actions">
          <button class="btn-primary" type="button" id="heroAgendaShortcutBtn" data-dashboard-nav="citas">
            <span class="material-symbols-rounded">calendar_today</span>
            Revisar agenda
          </button>
          <button class="btn-secondary" type="button" id="heroNewPatientShortcutBtn" data-dashboard-action="new-patient">
            <span class="material-symbols-rounded">person_add</span>
            Alta de paciente
          </button>
          <button class="btn-ghost" type="button" id="heroAgentShortcutBtn" data-dashboard-action="open-copilot">
            <span class="material-symbols-rounded">psychology</span>
            Copiloto IA
          </button>
        </div>
      </div>

      <aside class="clinic-focus-card" aria-label="Siguiente paso recomendado">
        <div class="clinic-card-head">
          <span class="clinic-kicker">Ahora</span>
          <span class="status-chip pendiente" id="dashboardNextSessionStatus">Cargando</span>
        </div>
        <strong id="dashboardNextSessionTitle">Leyendo proxima sesion...</strong>
        <p id="dashboardNextSessionMeta">La agenda se actualiza en segundo plano.</p>
        <button class="btn-ghost btn-sm" type="button" id="dashboardNextSessionBtn">
          <span class="material-symbols-rounded">calendar_today</span>
          Ver agenda
        </button>
      </aside>
    </header>

    <section class="clinic-command-search" aria-label="Acceso rapido">
      <span class="material-symbols-rounded" aria-hidden="true">search</span>
      <input
        type="text"
        id="mainCopilotInput"
        placeholder="Busca paciente, crea una cita o abre el copiloto clinico..."
        autocomplete="off"
      />
      <button class="btn-primary" type="button" data-dashboard-action="open-copilot" aria-label="Abrir copiloto">
        <span class="material-symbols-rounded">arrow_upward</span>
      </button>
    </section>

    <section class="clinic-metric-grid" aria-label="Indicadores de la clinica">
      <article>
        <span class="material-symbols-rounded">group</span>
        <div>
          <strong id="metricPacientes">0</strong>
          <p>Pacientes activos</p>
        </div>
      </article>
      <article>
        <span class="material-symbols-rounded">event_available</span>
        <div>
          <strong id="metricSesiones">0</strong>
          <p>Sesiones hoy</p>
        </div>
      </article>
      <article>
        <span class="material-symbols-rounded">clinical_notes</span>
        <div>
          <strong id="metricInformes">0</strong>
          <p>Planes IA generados</p>
        </div>
      </article>
      <article>
        <span class="material-symbols-rounded">payments</span>
        <div>
          <strong id="metricIngresosMes">0,00 €</strong>
          <p>Ingresos del mes</p>
        </div>
      </article>
    </section>

    <section class="clinic-dashboard-grid">
      <article class="clinic-panel clinic-panel-primary">
        <div class="clinic-card-head">
          <div>
            <span class="clinic-kicker">Agenda</span>
            <h2>Semana clinica</h2>
          </div>
          <button class="btn-ghost btn-sm" type="button" data-dashboard-nav="citas">
            <span class="material-symbols-rounded">arrow_forward</span>
            Abrir
          </button>
        </div>
        <div class="clinic-list" id="dashCitasBody">
          <div class="empty-state-sm state-loading">
            <span class="material-symbols-rounded">sync</span>
            <p>Cargando citas...</p>
          </div>
        </div>
      </article>

      <article class="clinic-panel">
        <div class="clinic-card-head">
          <div>
            <span class="clinic-kicker">Triage</span>
            <h2>Bandeja de entrada</h2>
          </div>
          <span class="status-chip pendiente" id="dashboardIntakeStatus">Cargando</span>
        </div>
        <strong class="clinic-panel-title" id="dashboardIntakeTitle">Leyendo mensajes...</strong>
        <p id="dashboardIntakeMeta">Telegram y formulario web se revisan automaticamente.</p>
        <button class="btn-ghost btn-sm" type="button" data-dashboard-nav="intakes">
          <span class="material-symbols-rounded">forward_to_inbox</span>
          Ver mensajes
        </button>
      </article>

      <article class="clinic-panel">
        <div class="clinic-card-head">
          <div>
            <span class="clinic-kicker">Sync</span>
            <h2>Google Calendar</h2>
          </div>
          <span class="status-chip pendiente" id="dashboardSyncChip">Revision</span>
        </div>
        <strong class="clinic-panel-title" id="dashboardSyncTitle">Comprobando estado...</strong>
        <p id="dashboardSyncMeta">Esperando lectura del sincronizador.</p>
        <div class="clinic-facts" id="dashboardSyncFacts" hidden></div>
      </article>
    </section>

    <section class="clinic-dashboard-grid clinic-dashboard-grid-secondary">
      <article class="clinic-panel">
        <div class="clinic-card-head">
          <div>
            <span class="clinic-kicker">Prioridades</span>
            <h2>Lista de trabajo</h2>
          </div>
        </div>
        <div class="clinic-priority-list" id="dashboardPriorityList">
          <div class="empty-state-sm state-loading">
            <span class="material-symbols-rounded">sync</span>
            <p>Ordenando prioridades...</p>
          </div>
        </div>
      </article>

      <article class="clinic-panel clinic-booking-card">
        <div class="clinic-card-head">
          <div>
            <span class="clinic-kicker">Reservas</span>
            <h2>Pagina publica</h2>
          </div>
        </div>
        <p id="dashboardBookingMeta">Comparte la pagina publica para captar nuevas altas y completar huecos de agenda.</p>
        <p class="form-feedback" id="dashboardBookingFeedback" hidden></p>
        <div class="clinic-inline-actions">
          <button class="btn-primary btn-sm" type="button" id="dashboardBookingOpenBtn">
            <span class="material-symbols-rounded">open_in_new</span>
            Abrir pagina
          </button>
          <button class="btn-ghost btn-sm" type="button" id="dashboardBookingCopyBtn">
            <span class="material-symbols-rounded">content_copy</span>
            Copiar enlace
          </button>
        </div>
      </article>
    </section>

    <section class="clinic-finance-strip" aria-label="Resumen financiero">
      <article>
        <span>Sesiones mes</span>
        <strong id="metricSesionesMes">0</strong>
      </article>
      <article>
        <span>Motor IA</span>
        <strong id="metricEngineOps">0/0</strong>
      </article>
      <article>
        <span>Grafico anual</span>
        <strong id="dashChartYear">2026</strong>
      </article>
      <canvas id="dashIncomeChart" aria-label="Ingresos por mes" role="img"></canvas>
    </section>
  </section>
</div>
