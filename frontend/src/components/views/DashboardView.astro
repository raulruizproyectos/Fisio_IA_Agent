---
// DashboardView.astro
---

<!-- === PAGE: DASHBOARD (COPILOT ZERO-STATE) === -->
<div class="page-section active bg-[#FAFAF8] min-h-full flex flex-col items-center justify-center py-20 px-4" data-page="dashboard">
  
  <div class="w-full max-w-3xl flex flex-col items-center space-y-12">
    
    <!-- Hero / Zero State Greeting -->
    <div class="text-center space-y-4">
      <h1 class="text-4xl md:text-5xl font-medium text-[#11181C] tracking-tight">Buenos días, Dr.</h1>
      <p class="text-lg text-[#687076] max-w-xl mx-auto font-light leading-relaxed">
        ¿En qué paciente o tarea nos enfocamos hoy? Puedes escribir directamente o elegir una de las acciones rápidas.
      </p>
    </div>

    <!-- Quick Actions (Zero-State Inteligente) -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 w-full">
      <button class="flex flex-col items-start p-6 bg-white rounded-2xl hover:bg-gray-50 transition-colors duration-200 text-left group" data-dashboard-nav="citas">
        <span class="material-symbols-rounded text-[#687076] group-hover:text-emerald-600 transition-colors mb-3">calendar_today</span>
        <span class="text-[#11181C] font-medium mb-1">Revisar agenda de hoy</span>
        <span class="text-[#687076] text-sm">3 pacientes programados</span>
      </button>

      <button class="flex flex-col items-start p-6 bg-white rounded-2xl hover:bg-gray-50 transition-colors duration-200 text-left group" data-dashboard-nav="intakes">
        <span class="material-symbols-rounded text-[#687076] group-hover:text-emerald-600 transition-colors mb-3">mark_email_unread</span>
        <span class="text-[#11181C] font-medium mb-1">Mensajes pendientes</span>
        <span class="text-[#687076] text-sm">2 nuevos mensajes de Telegram</span>
      </button>

      <button class="flex flex-col items-start p-6 bg-white rounded-2xl hover:bg-gray-50 transition-colors duration-200 text-left group" data-dashboard-action="new-patient">
        <span class="material-symbols-rounded text-[#687076] group-hover:text-emerald-600 transition-colors mb-3">person_add</span>
        <span class="text-[#11181C] font-medium mb-1">Alta de paciente</span>
        <span class="text-[#687076] text-sm">Crear nueva ficha clínica</span>
      </button>
    </div>

    <!-- Conversational Input (Copilot Placeholder) -->
    <div class="w-full relative mt-8">
      <div class="absolute inset-y-0 left-0 pl-6 flex items-center pointer-events-none">
        <span class="material-symbols-rounded text-emerald-600/80">psychology</span>
      </div>
      <input type="text" 
             class="w-full bg-white text-[#11181C] placeholder-[#687076] rounded-full py-5 pl-14 pr-16 shadow-sm border-0 focus:ring-2 focus:ring-emerald-500/20 text-lg transition-all"
             placeholder="Describe síntomas, crea una cita o busca un paciente..." 
             id="mainCopilotInput"
             autocomplete="off">
      <button class="absolute inset-y-2 right-2 bg-emerald-600 hover:bg-emerald-700 text-white rounded-full p-3 flex items-center justify-center transition-colors">
        <span class="material-symbols-rounded text-xl">arrow_upward</span>
      </button>
    </div>
    
  </div>
</div>
