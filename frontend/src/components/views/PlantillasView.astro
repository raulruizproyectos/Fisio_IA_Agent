---
// PlantillasView.astro
---

<!-- === PAGE: PLANTILLAS === -->
<div class="page-section" data-page="plantillas">
  <div class="page-header-row template-library-header">
    <div>
      <span class="view-kicker">EJERCICIO TERAPÉUTICO</span>
      <h1 class="page-title"><span class="material-symbols-rounded">library_books</span> Planes terapéuticos</h1>
      <p class="page-subtitle">Revisa los planes de ejercicios y sus entregas, o crea uno nuevo con el Copiloto.</p>
    </div>
    <div class="page-tools">
      <button class="btn-primary" type="button" data-dashboard-action="open-copilot"><span class="material-symbols-rounded" aria-hidden="true">auto_awesome</span> Nuevo plan</button>
    <button class="btn-ghost" id="refreshTemplates" type="button"><span class="material-symbols-rounded">refresh</span> Actualizar</button>
    </div>
  </div>

  <div class="template-library-shell">
    <section class="template-kpi-grid" id="templateLibrarySummary">
      <article class="template-kpi-card">
        <span>Planes visibles</span>
        <strong>--</strong>
        <p>Cargando biblioteca clínica...</p>
      </article>
      <article class="template-kpi-card">
        <span>Entregas visibles</span>
        <strong>--</strong>
        <p>Esperando historial archivado...</p>
      </article>
      <article class="template-kpi-card">
        <span>Pacientes con seguimiento</span>
        <strong>--</strong>
        <p>Preparando resumen operativo...</p>
      </article>
    </section>

    <div class="template-library-grid">
      <section class="card table-card template-history-card">
        <header class="card-header card-header-stack">
          <div>
            <h2>Planes generados</h2>
            <p class="card-subtitle">Historial real de ejercicios enviados o archivados para seguimiento domiciliario.</p>
          </div>
        </header>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Paciente</th>
                <th>Plan</th>
                <th>Ejercicios</th>
                <th>Entregas</th>
                <th>Último movimiento</th>
                <th>Acción</th>
              </tr>
            </thead>
            <tbody id="templateHistoryBody">
              <tr class="empty-row">
                <td colspan="6">
                  <div class="empty-state">
                    <span class="material-symbols-rounded">hourglass_empty</span>
                    <p>Cargando biblioteca clínica...</p>
                  </div>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

    </div>
  </div>
</div>
