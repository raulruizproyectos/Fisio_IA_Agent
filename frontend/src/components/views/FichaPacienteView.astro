---
// FichaPacienteView.astro
---

<!-- === PAGE: FICHA PACIENTE (detalle) === -->
<div class="page-section min-h-full py-6 px-4 md:px-8 lg:px-12 flex flex-col space-y-6 text-charcoal" data-page="ficha-paciente">
  
  <!-- Minimalist Topbar -->
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-black/[0.08] pb-4">
    <div class="flex items-center gap-4">
      <button class="flex items-center gap-1.5 text-slate-600 hover:text-black transition-colors font-medium text-sm px-3 py-1.5 rounded-lg hover:bg-black/5" id="fichaBackBtn">
        <span class="material-symbols-rounded text-lg">arrow_back</span> Volver a Pacientes
      </button>
      <h1 class="text-2xl font-bold text-black flex items-center gap-2" id="fichaTitulo">
        <span class="material-symbols-rounded text-[#0a3922]">person</span> Ficha clínica
      </h1>
    </div>
    <div class="flex items-center gap-3">
      <button class="flex items-center gap-2 text-sm font-semibold text-black bg-white border border-black/10 hover:bg-black/5 px-4 py-2 rounded-full shadow-sm transition-all" id="fichaEditToggle">
        <span class="material-symbols-rounded text-[18px]">edit</span> Editar datos
      </button>
    </div>
  </div>

  <!-- Clinical Context (Flotante y Minimalista) -->
  <section class="bg-white rounded-3xl p-6 border border-black/[0.06] shadow-sm flex flex-col lg:flex-row gap-8 text-charcoal">
    <div class="flex-1 space-y-4">
      <div>
        <span class="text-xs font-bold text-[#0a3922] uppercase tracking-wider">Contexto Clínico</span>
        <h2 class="text-3xl font-extrabold text-black mt-1" id="fichaHeroName">Paciente no cargado</h2>
        <p class="text-slate-600 font-normal mt-2" id="fichaHeroSummary">Selecciona un paciente para ver un resumen ejecutivo del caso, continuidad clínica y próximas acciones.</p>
      </div>
      <div class="flex flex-wrap gap-4 text-sm text-slate-600">
        <span class="flex items-center gap-1.5"><span class="material-symbols-rounded text-[18px] text-slate-500">mail</span><span id="fichaHeroEmail">Sin email</span></span>
        <span class="flex items-center gap-1.5"><span class="material-symbols-rounded text-[18px] text-slate-500">call</span><span id="fichaHeroPhone">Sin teléfono</span></span>
        <span class="flex items-center gap-1.5"><span class="material-symbols-rounded text-[18px] text-slate-500">badge</span><span id="fichaHeroProfile">Sin datos clave</span></span>
      </div>
      <div class="flex flex-wrap gap-3 pt-2">
        <button class="flex items-center gap-2 bg-[#ff643b] hover:bg-[#e8532c] text-white px-5 py-2.5 rounded-full font-semibold transition-colors shadow-sm" type="button" id="fichaHeroCopilotBtn">
          <span class="material-symbols-rounded text-[20px]">exercise</span> Informe Clínico
        </button>
        <button class="flex items-center gap-2 bg-white border border-black/10 hover:bg-black/5 text-black px-5 py-2.5 rounded-full font-semibold transition-colors" type="button" id="fichaHeroAgendaBtn">
          <span class="material-symbols-rounded text-[20px]">calendar_today</span> Agenda
        </button>
        <button class="flex items-center gap-2 bg-white border border-black/10 hover:bg-black/5 text-slate-700 px-5 py-2.5 rounded-full font-semibold transition-colors" type="button" id="fichaHeroDocsBtn">
          <span class="material-symbols-rounded text-[20px]">description</span> Documentos
        </button>
      </div>
    </div>
    
    <!-- Quick Facts Grid -->
    <div class="flex-1 grid grid-cols-2 gap-4">
      <article class="bg-[#faf7e8] border border-black/[0.05] p-4 rounded-2xl flex flex-col gap-1">
        <span class="text-xs font-bold text-[#0a3922] uppercase tracking-wider">Cadencia clínica</span>
        <strong class="text-lg font-bold text-black" id="fichaHeroLastSession">Sin citas</strong>
        <p class="text-xs text-slate-600" id="fichaHeroLastSessionMeta">Todavía no hay actividad.</p>
      </article>
      <article class="bg-[#faf7e8] border border-black/[0.05] p-4 rounded-2xl flex flex-col gap-1">
        <span class="text-xs font-bold text-[#0a3922] uppercase tracking-wider">Seguimiento</span>
        <strong class="text-lg font-bold text-black" id="fichaHeroNotesCount">0 notas</strong>
        <p class="text-xs text-slate-600 truncate" id="fichaHeroLatestNote">La línea temporal aparecerá aquí.</p>
      </article>
      <article class="bg-[#faf7e8] border border-black/[0.05] p-4 rounded-2xl flex flex-col gap-1">
        <span class="text-xs font-bold text-[#0a3922] uppercase tracking-wider">Economía</span>
        <strong class="text-lg font-bold text-black" id="fichaHeroPaymentsTotal">0,00 €</strong>
        <p class="text-xs text-slate-600" id="fichaHeroPaymentsMeta">Sin pagos.</p>
      </article>
      <article class="bg-[#e4f7ee] p-4 rounded-2xl flex flex-col gap-1 border border-[#0a3922]/15">
        <span class="text-xs font-bold text-[#0a3922] uppercase tracking-wider">Continuidad</span>
        <strong class="text-lg font-bold text-[#0a3922]" id="fichaHeroContinuity">Listo para revisar</strong>
        <p class="text-xs text-[#0a3922]/80" id="fichaHeroContinuityMeta">Usa el agente, documentos y agenda.</p>
      </article>
    </div>
  </section>

  <!-- Commands & Risk -->
  <section class="bg-white rounded-3xl p-6 border border-black/[0.06] shadow-sm flex flex-col lg:flex-row gap-6 justify-between items-center hidden" aria-hidden="true">
    <!-- Preserved IDs for JS but visually hidden or integrated differently to reduce clutter -->
    <strong id="fichaOpsRiskTitle"></strong><p id="fichaOpsRiskMeta"></p>
    <strong id="fichaOpsNextTitle"></strong><p id="fichaOpsNextMeta"></p>
    <strong id="fichaOpsPlanTitle"></strong><p id="fichaOpsPlanMeta"></p>
    <strong id="fichaOpsBillingTitle"></strong><p id="fichaOpsBillingMeta"></p>
    <button id="fichaOpsAgendarBtn"></button>
    <button id="fichaOpsNotaBtn"></button>
    <button id="fichaOpsHistoriaBtn"></button>
    <button id="fichaOpsCopilotBtn"></button>
  </section>

  <!-- Main Workspace (Tabs) -->
  <section class="flex-1 flex flex-col bg-white rounded-3xl border border-black/[0.06] shadow-sm overflow-hidden">
    
    <!-- Tabs Navigation -->
    <div class="flex overflow-x-auto border-b border-black/[0.06] p-2.5 gap-2 hide-scrollbar bg-[#f8f7f4]">
      <button class="ficha-tab active px-5 py-2.5 rounded-full text-sm font-semibold bg-[#0a3922] text-white transition-all shadow-sm" data-ficha-tab="resumen">Resumen de caso</button>
      <button class="ficha-tab px-5 py-2.5 rounded-full text-sm font-medium text-slate-600 hover:text-black hover:bg-black/5 transition-all" data-ficha-tab="datos">Datos personales</button>
      <button class="ficha-tab px-5 py-2.5 rounded-full text-sm font-medium text-slate-600 hover:text-black hover:bg-black/5 transition-all" data-ficha-tab="notas">Notas clínicas</button>
      <button class="ficha-tab px-5 py-2.5 rounded-full text-sm font-medium text-slate-600 hover:text-black hover:bg-black/5 transition-all" data-ficha-tab="citas">Historial citas</button>
      <button class="ficha-tab px-5 py-2.5 rounded-full text-sm font-medium text-slate-600 hover:text-black hover:bg-black/5 transition-all" data-ficha-tab="pagos">Historial pagos</button>
      <button class="ficha-tab px-5 py-2.5 rounded-full text-sm font-medium text-slate-600 hover:text-black hover:bg-black/5 transition-all" data-ficha-tab="documentos">Documentos</button>
    </div>

    <p class="text-sm text-red-400 bg-red-500/10 border border-red-500/20 p-3 m-4 rounded-lg" id="fichaAvailabilityNotice" hidden></p>

    <div class="p-6 overflow-y-auto">
      
      <!-- Panel: Resumen -->
      <div class="ficha-panel active space-y-8" data-ficha-panel="resumen">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
          <section class="bg-[#faf7e8] border border-black/[0.05] p-6 rounded-2xl">
            <header class="mb-4">
              <span class="text-xs font-bold text-[#0a3922] uppercase tracking-wider">Lectura rápida</span>
              <h2 class="text-xl font-bold text-black">Todo el caso en un vistazo</h2>
            </header>
            <div class="text-slate-700 text-sm" id="fichaOverviewStats">El resumen ejecutivo del caso aparecerá aquí.</div>
          </section>

          <!-- MAPA ANATOMICO DE DOLOR INTERACTIVO -->
          <section class="bg-[#f4ece9] border border-black/[0.05] p-6 rounded-2xl pain-map-card">
            <header class="mb-4">
              <span class="text-xs font-bold text-[#0a3922] uppercase tracking-wider">Lectura evolutiva</span>
              <h2 class="text-xl font-bold text-black">Mapa Anat&oacute;mico de Dolor</h2>
            </header>
            <div class="pain-map-container">
              <div class="pain-map-visual">
                <svg viewBox="0 0 100 220" id="painMapSvg" class="pain-map-svg">
                  <path id="zone-cervical" class="pain-zone-path" data-zone="cervical" d="M42,20 C42,10 58,10 58,20 C58,28 54,32 54,36 L46,36 C46,32 42,28 42,20 Z" />
                  <path id="zone-hombro_izq" class="pain-zone-path" data-zone="hombro_brazo" d="M38,38 C28,40 22,48 18,58 L24,60 C26,52 32,46 38,44 Z" />
                  <path id="zone-hombro_der" class="pain-zone-path" data-zone="hombro_brazo" d="M62,38 C72,40 78,48 82,58 L76,60 C74,52 68,46 62,44 Z" />
                  <path id="zone-espalda" class="pain-zone-path" data-zone="espalda" d="M40,38 L60,38 L58,80 L42,80 Z" />
                  <path id="zone-abdomen" class="pain-zone-path" data-zone="abdomen_core" d="M42,82 L58,82 L56,105 L44,105 Z" />
                  <path id="zone-cadera" class="pain-zone-path" data-zone="cadera" d="M38,107 L62,107 L60,125 L40,125 Z" />
                  <path id="zone-rodilla_izq" class="pain-zone-path" data-zone="rodilla" d="M38,127 L48,127 L46,165 L36,165 Z" />
                  <path id="zone-rodilla_der" class="pain-zone-path" data-zone="rodilla" d="M52,127 L62,127 L64,165 L54,165 Z" />
                  <path id="zone-tobillo_izq" class="pain-zone-path" data-zone="tobillo_pie" d="M36,167 L46,167 L44,205 C40,210 32,210 30,205 Z" />
                  <path id="zone-tobillo_der" class="pain-zone-path" data-zone="tobillo_pie" d="M54,167 L64,167 L70,205 C68,210 60,210 56,205 Z" />
                </svg>
              </div>
              <div class="pain-map-editor" id="painMapEditor" hidden>
                <strong id="painMapSelectedZone" class="text-black">Cervical</strong>
                <div class="pain-intensity-slider">
                  <label for="painEvaSlider" class="text-slate-700">EVA: <span id="painEvaValue" class="text-[#0a3922] font-bold">5</span>/10</label>
                  <input type="range" id="painEvaSlider" min="0" max="10" value="5" step="1" />
                </div>
                <label for="painZoneNotes" class="block space-y-1">
                  <span class="text-sm font-medium text-slate-700">Notas de dolor</span>
                  <input type="text" id="painZoneNotes" class="w-full bg-white border border-black/10 rounded-lg px-3 py-2 text-sm text-black placeholder-slate-400" placeholder="Contractura, punzante..." />
                </label>
                <button type="button" class="btn-primary btn-sm bg-[#0a3922] text-white rounded-full py-2 hover:bg-[#0e4c2e] transition-colors flex items-center gap-1.5 justify-center text-xs font-semibold" id="btnSavePainZone" style="width:100%;"><span class="material-symbols-rounded text-sm">check</span> Guardar Nota</button>
              </div>
            </div>
          </section>

          <section class="bg-[#faf7e8] border border-black/[0.05] p-6 rounded-2xl">
            <header class="mb-4">
              <span class="text-xs font-bold text-[#0a3922] uppercase tracking-wider">Pulso terapéutico</span>
              <h2 class="text-xl font-bold text-black">Progreso del paciente</h2>
            </header>
            <div class="text-slate-700 text-sm" id="fichaProgressPanel">Cuando haya dolor, adherencia o entregas registradas, verás aquí la lectura rápida del progreso clínico.</div>
          </section>

          <section class="bg-[#faf7e8] border border-black/[0.05] p-6 rounded-2xl">
            <header class="mb-4">
              <span class="text-xs font-bold text-[#0a3922] uppercase tracking-wider">Movimiento reciente</span>
              <h2 class="text-xl font-bold text-black">Clínica, agenda y decisiones</h2>
            </header>
            <div class="text-slate-700 text-sm" id="fichaOverviewStream">La actividad reciente del caso aparecerá aquí.</div>
          </section>

          <section class="bg-[#faf7e8] border border-black/[0.05] p-6 rounded-2xl">
            <header class="mb-4">
              <span class="text-xs font-bold text-[#0a3922] uppercase tracking-wider">Siguiente mejor acción</span>
              <h2 class="text-xl font-bold text-black">Prioridades del caso</h2>
            </header>
            <div class="text-slate-700 text-sm" id="fichaDecisionList">Todavía no hay decisiones sugeridas para este caso.</div>
          </section>

          <section class="bg-[#faf7e8] border border-black/[0.05] p-6 rounded-2xl lg:col-span-2">
            <header class="mb-4">
              <span class="text-xs font-bold text-[#0a3922] uppercase tracking-wider">Protocolo clínico</span>
              <p class="text-sm font-semibold text-black">Seguimiento de planes prescritos</p>
            </header>
            <div class="text-slate-300 text-sm" id="fichaPlanInsights">Cuando exista un plan de recuperación, verás aquí el circuito: plan, entrega, feedback y ajuste recomendado.</div>
          </section>
        </div>
      </div>

      <!-- Panel: Datos -->
      <div class="ficha-panel hidden" data-ficha-panel="datos">
        <div id="fichaDatosView" class="grid grid-cols-1 md:grid-cols-2 gap-y-6 gap-x-8 text-sm text-slate-300">
          <!-- Rendered by JS -->
        </div>
        <form id="fichaDatosForm" class="hidden space-y-6 max-w-3xl">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <label class="block space-y-2"><span class="text-sm font-medium text-slate-300">Nombre</span><input name="nombre" type="text" class="w-full bg-[#111a26] border border-white/10 rounded-xl px-4 py-2 text-white" required /></label>
            <label class="block space-y-2"><span class="text-sm font-medium text-slate-300">Apellidos</span><input name="apellidos" type="text" class="w-full bg-[#111a26] border border-white/10 rounded-xl px-4 py-2 text-white" /></label>
            <label class="block space-y-2"><span class="text-sm font-medium text-slate-300">Email</span><input name="email" type="email" class="w-full bg-[#111a26] border border-white/10 rounded-xl px-4 py-2 text-white" /></label>
            <label class="block space-y-2"><span class="text-sm font-medium text-slate-300">Teléfono</span><input name="telefono" type="tel" class="w-full bg-[#111a26] border border-white/10 rounded-xl px-4 py-2 text-white" /></label>
            <label class="block space-y-2"><span class="text-sm font-medium text-slate-300">DNI/NIF</span><input name="dni" type="text" class="w-full bg-[#111a26] border border-white/10 rounded-xl px-4 py-2 text-white" /></label>
            <label class="block space-y-2"><span class="text-sm font-medium text-slate-300">Fecha nac.</span><input name="fecha_nacimiento" type="date" class="w-full bg-[#111a26] border border-white/10 rounded-xl px-4 py-2 text-white" /></label>
            <label class="block space-y-2"><span class="text-sm font-medium text-slate-300">Dirección</span><input name="direccion" type="text" class="w-full bg-[#111a26] border border-white/10 rounded-xl px-4 py-2 text-white" /></label>
            <label class="block space-y-2"><span class="text-sm font-medium text-slate-300">Profesión</span><input name="profesion" type="text" class="w-full bg-[#111a26] border border-white/10 rounded-xl px-4 py-2 text-white" /></label>
            <label class="block space-y-2"><span class="text-sm font-medium text-slate-300">Médico derivador</span><input name="medico_derivador" type="text" class="w-full bg-[#111a26] border border-white/10 rounded-xl px-4 py-2 text-white" /></label>
            <label class="block space-y-2"><span class="text-sm font-medium text-slate-300">Aseguradora</span><input name="aseguradora" type="text" class="w-full bg-[#111a26] border border-white/10 rounded-xl px-4 py-2 text-white" /></label>
            <label class="block space-y-2 md:col-span-2"><span class="text-sm font-medium text-slate-300">Alergias</span><textarea name="alergias" rows="2" class="w-full bg-[#111a26] border border-white/10 rounded-xl px-4 py-2 text-white"></textarea></label>
            <label class="block space-y-2 md:col-span-2"><span class="text-sm font-medium text-slate-300">Antecedentes</span><textarea name="antecedentes" rows="2" class="w-full bg-[#111a26] border border-white/10 rounded-xl px-4 py-2 text-white"></textarea></label>
            <label class="block space-y-2 md:col-span-2"><span class="text-sm font-medium text-slate-300">Observaciones</span><textarea name="observaciones" rows="2" class="w-full bg-[#111a26] border border-white/10 rounded-xl px-4 py-2 text-white"></textarea></label>
          </div>
          <div class="flex gap-3 justify-end">
            <button type="button" class="px-5 py-2 rounded-full text-slate-400 hover:bg-white/5" id="fichaCancelEdit">Cancelar</button>
            <button type="submit" class="bg-emerald-600 hover:bg-emerald-500 text-white px-6 py-2 rounded-full flex items-center gap-2 font-medium"><span class="material-symbols-rounded text-sm">save</span> Guardar</button>
          </div>
        </form>
      </div>

      <!-- Panel: Notas -->
      <div class="ficha-panel hidden space-y-6" data-ficha-panel="notas">
        <header class="flex flex-wrap justify-between items-center gap-3">
          <div>
            <h2 class="text-xl font-bold text-white">Notas de evolución y sesiones</h2>
            <p class="text-xs text-slate-400">Registro estructurado con síntesis clínica y memoria longitudinal.</p>
          </div>
          <div class="flex items-center gap-2">
            <button type="button" class="bg-emerald-500 hover:bg-emerald-600 text-white px-4 py-2 rounded-full flex items-center gap-2 text-sm font-medium transition-colors shadow-sm cursor-pointer" id="btnVoiceSessionNote">
              <span class="material-symbols-rounded text-[18px]">mic</span> Registrar sesión por voz
            </button>
            <button type="button" class="bg-white/10 hover:bg-white/15 text-white px-4 py-2 rounded-full flex items-center gap-2 text-sm font-medium transition-colors border border-white/10 cursor-pointer" id="fichaAddNota">
              <span class="material-symbols-rounded text-[18px]">add</span> Nota manual
            </button>
          </div>
        </header>

        <!-- Memoria Longitudinal (Capa 2) -->
        <div id="fichaLongitudinalCard" class="bg-[#111a26] border border-emerald-500/20 p-5 rounded-2xl hidden space-y-2">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
              <span class="material-symbols-rounded text-emerald-400 text-base">history_edu</span>
              <span class="text-xs font-semibold text-emerald-400 uppercase tracking-wider">Memoria Clínica Longitudinal (Capa 2)</span>
            </div>
            <span id="fichaLongitudinalUpdated" class="text-xs text-slate-500"></span>
          </div>
          <p id="fichaLongitudinalSummaryText" class="text-sm text-slate-200 leading-relaxed"></p>
        </div>

        <!-- Tendencia de Dolor (EVA) -->
        <div id="fichaPainTrendCard" class="bg-[#111a26] border border-white/[0.08] p-5 rounded-2xl hidden">
          <div class="flex items-center justify-between mb-3">
            <span class="text-xs font-semibold text-emerald-400 uppercase tracking-wider">Evolución de Dolor (EVA)</span>
            <span id="fichaPainTrendBadge" class="text-xs px-2.5 py-1 rounded-full font-medium"></span>
          </div>
          <div id="fichaPainTrendTimeline" class="flex flex-wrap gap-3"></div>
        </div>

        <div id="fichaNotasSummary" class="text-sm text-slate-400"></div>
        <div id="fichaNotasTimeline" class="space-y-4">
          <p class="text-slate-500 italic">Sin notas clínicas registradas</p>
        </div>

        <section id="fichaNotaFormCard" class="bg-[#111a26] border border-white/[0.08] p-6 rounded-2xl hidden mt-8">
          <header class="mb-4"><h2 id="fichaNotaFormTitle" class="text-lg font-bold text-white">Nueva nota clínica</h2></header>
          <form id="fichaNotaForm" class="space-y-4 max-w-2xl">
            <input type="hidden" name="nota_id" />
            <div class="grid grid-cols-2 gap-4">
              <label class="block space-y-1"><span class="text-sm font-medium text-slate-300">Fecha</span><input name="fecha" type="date" class="w-full bg-[#0d1522] border border-white/10 rounded-lg px-3 py-2 text-white" required /></label>
              <label class="block space-y-1"><span class="text-sm font-medium text-slate-300">Dolor (EVA 0-10)</span><input name="dolor_eva" type="number" min="0" max="10" class="w-full bg-[#0d1522] border border-white/10 rounded-lg px-3 py-2 text-white" /></label>
            </div>
            <label class="block space-y-1"><span class="text-sm font-medium text-slate-300">Zona corporal</span>
              <select name="zona_corporal" class="w-full bg-[#0d1522] border border-white/10 rounded-lg px-3 py-2 text-white">
                <option value="">-- Seleccionar --</option>
                <option value="cervical">Cervical</option>
                <option value="espalda">Espalda</option>
                <option value="lumbar">Lumbar</option>
                <option value="hombro_brazo">Hombro/Brazo</option>
                <option value="pierna">Pierna</option>
              </select>
            </label>
            <label class="block space-y-1"><span class="text-sm font-medium text-slate-300">Nota de sesión</span><textarea name="nota" rows="4" class="w-full bg-[#0d1522] border border-white/10 rounded-lg px-3 py-2 text-white" required></textarea></label>
            <label class="block space-y-1"><span class="text-sm font-medium text-slate-300">Pruebas realizadas</span><textarea name="pruebas_realizadas" rows="2" class="w-full bg-[#0d1522] border border-white/10 rounded-lg px-3 py-2 text-white"></textarea></label>
            <div class="flex gap-3 justify-end pt-2">
              <button type="button" class="px-4 py-2 text-slate-400 hover:bg-white/5 rounded-lg" id="fichaNotaCancel">Cancelar</button>
              <button type="submit" class="bg-emerald-500 hover:bg-emerald-600 text-white px-4 py-2 rounded-lg flex items-center gap-2 font-medium"><span class="material-symbols-rounded text-[18px]">save</span> Guardar nota</button>
            </div>
          </form>
        </section>
      </div>

      <!-- Panel: Citas -->
      <div class="ficha-panel hidden space-y-6" data-ficha-panel="citas">
        <h2 class="text-xl font-bold text-white">Historial de citas</h2>
