---
// PatientsView.astro
---

<!-- === PAGE: PACIENTES === -->
<div class="page-section patient-workspace" data-page="pacientes">
  <section class="patient-workspace-inner">
    <header class="patient-workspace-header">
      <div>
        <span class="clinic-kicker">Directorio clínico</span>
        <h1>Pacientes</h1>
        <p>Busca, filtra y abre cada caso sin perder el contexto asistencial.</p>
      </div>
      <div class="patient-workspace-actions">
        <button id="addPatientBtn" type="button" class="patient-primary-action">
          <span class="material-symbols-rounded" aria-hidden="true">person_add</span>
          <span>Nuevo paciente</span>
          <span class="material-symbols-rounded patient-action-arrow" aria-hidden="true">arrow_forward</span>
        </button>
        <button id="patientsHeroAddBtn" type="button" class="patient-secondary-action hidden">
          <span class="material-symbols-rounded" aria-hidden="true">bolt</span> Alta rápida
        </button>
        <button id="refreshPacientes" type="button" class="patient-sync-action">
          <span class="material-symbols-rounded" aria-hidden="true">refresh</span> Sincronizar
        </button>
      </div>
    </header>

    <div class="patient-vitals" aria-label="Resumen de pacientes">
      <article>
        <span>Total activo</span>
        <strong id="patientsTotalValue">0</strong>
        <p id="patientsTotalMeta">Cargando base clínica…</p>
      </article>
      <article>
        <span>Contacto útil</span>
        <strong id="patientsReachValue">0%</strong>
        <p id="patientsReachMeta">Midiendo correo y teléfono disponibles.</p>
      </article>
      <article>
        <span>Altas recientes</span>
        <strong id="patientsRecentValue">0</strong>
        <p id="patientsRecentMeta">Sin lectura todavía.</p>
      </article>
    </div>

    <section class="patient-directory-toolbar" aria-label="Filtros de pacientes">
      <label class="patient-directory-search" for="patientsFilterInput">
        <span class="material-symbols-rounded" aria-hidden="true">search</span>
        <input type="search" id="patientsFilterInput" name="busqueda_paciente" placeholder="Buscar por nombre, correo, teléfono o ID…" autocomplete="off" />
      </label>

      <div class="patient-directory-controls">
        <div class="patient-segments" id="patientsSegmented">
          <button type="button" data-patient-filter="all" aria-pressed="true">Todos</button>
          <button type="button" data-patient-filter="contactable">Contactables</button>
          <button type="button" data-patient-filter="incomplete">Incompletos</button>
          <button type="button" data-patient-filter="recent">Recientes</button>
        </div>
        <label class="patient-sort" for="patientsSortSelect">
          <span class="sr-only">Orden de pacientes</span>
          <select id="patientsSortSelect" aria-label="Orden de pacientes">
            <option value="recent_desc">Más recientes</option>
            <option value="readiness">Priorizar incompletos</option>
            <option value="name_asc">Nombre A-Z</option>
            <option value="name_desc">Nombre Z-A</option>
          </select>
          <span class="material-symbols-rounded" aria-hidden="true">expand_more</span>
        </label>
      </div>
    </section>

    <section class="patient-directory">
      <header>
        <div>
          <h2>Listado clínico</h2>
          <p id="patientsListMeta">Cargando pacientes del CRM…</p>
        </div>
        <span id="patientsFilterChip">Todos los pacientes</span>
      </header>

      <div class="patient-directory-body" id="pacientesBody">
        <div class="patient-directory-loading">
          <span class="material-symbols-rounded" aria-hidden="true">hourglass_empty</span>
          <p>Cargando pacientes…</p>
        </div>
      </div>
    </section>
  </section>
</div>

<!-- Modal -->
<div class="patient-modal-overlay opacity-0 pointer-events-none" id="patientModal" aria-hidden="true">
  <div class="patient-modal-dialog scale-95" data-patient-modal-dialog role="dialog" aria-modal="true" aria-labelledby="patientModalTitle" aria-describedby="patientModalDescription">
    <aside class="patient-modal-intro" aria-hidden="true">
      <span class="patient-modal-mark"><span class="material-symbols-rounded">person_add</span></span>
      <div>
        <span class="patient-modal-index">Nuevo expediente</span>
        <p>Una ficha completa conecta agenda, evolución y comunicación clínica desde el primer día.</p>
      </div>
      <div class="patient-modal-trace">
        <span></span><span></span><span></span>
      </div>
    </aside>

    <div class="patient-modal-main">
      <header class="patient-modal-header">
        <div>
          <p class="patient-modal-eyebrow">Directorio clínico</p>
          <h2 id="patientModalTitle">Alta de paciente</h2>
          <p id="patientModalDescription">Añade los datos esenciales. Podrás completar el historial después.</p>
        </div>
        <button type="button" class="patient-modal-close" id="closePatientModalBtn" aria-label="Cerrar formulario de paciente">
          <span class="material-symbols-rounded" aria-hidden="true">close</span>
        </button>
      </header>

      <form id="patientForm" class="patient-modal-form">
        <div class="patient-modal-fields">
          <label class="patient-field patient-field-wide">
            <span>Nombre completo</span>
            <input id="patientNameInput" name="nombre_completo" type="text" placeholder="Ej.: María López García" autocomplete="name" required />
          </label>

          <label class="patient-field">
            <span>Correo electrónico</span>
            <input id="patientEmailInput" name="email" type="email" placeholder="paciente@correo.com" autocomplete="email" spellcheck="false" />
          </label>

          <label class="patient-field">
            <span>Teléfono</span>
            <input id="patientPhoneInput" name="phone" type="tel" placeholder="+34 600 123 456" autocomplete="tel" inputmode="tel" />
          </label>

          <label class="patient-field">
            <span>Fecha de nacimiento</span>
            <input id="patientBirthDateInput" name="fecha_nacimiento" type="date" autocomplete="bday" />
          </label>
        </div>

        <p class="patient-form-feedback" id="patientFormFeedback" role="status" aria-live="polite" hidden></p>

        <footer class="patient-modal-actions">
          <span>Los datos quedarán protegidos en su expediente clínico.</span>
          <div>
            <button type="button" class="patient-modal-cancel" id="patientModalDismiss">Cancelar</button>
            <button type="submit" class="patient-modal-submit" id="patientSubmitBtn">
              <span>Guardar paciente</span>
              <span class="material-symbols-rounded" aria-hidden="true">arrow_forward</span>
            </button>
          </div>
        </footer>
      </form>
    </div>
  </div>
</div>

<script>
  import { modalState } from '../../store';

  const patientModal = document.getElementById('patientModal');
  const inner = patientModal?.querySelector('[data-patient-modal-dialog]');
  const patientNameInput = document.getElementById('patientNameInput') as HTMLInputElement;
  let patientModalReturnFocus: HTMLElement | null = null;

  modalState.subscribe((state) => {
    if (!patientModal || !inner) return;

    if (state.patientForm.isOpen) {
      patientModalReturnFocus = document.activeElement instanceof HTMLElement ? document.activeElement : null;
      patientModal.classList.remove('opacity-0', 'pointer-events-none');
      patientModal.classList.add('opacity-100', 'pointer-events-auto');
      patientModal.setAttribute('aria-hidden', 'false');
      inner.classList.remove('scale-95');
      inner.classList.add('scale-100');
      document.body.classList.add('has-modal-open');
      window.setTimeout(() => patientNameInput?.focus(), 25);
    } else {
      patientModal.classList.remove('opacity-100', 'pointer-events-auto');
      patientModal.classList.add('opacity-0', 'pointer-events-none');
      patientModal.setAttribute('aria-hidden', 'true');
      inner.classList.remove('scale-100');
      inner.classList.add('scale-95');
      document.body.classList.remove('has-modal-open');
      patientModalReturnFocus?.focus();
      patientModalReturnFocus = null;
    }
  });

  const closeHandler = () => {
    const current = modalState.get();
    modalState.set({ ...current, patientForm: { isOpen: false } });
  };

  document.getElementById('closePatientModalBtn')?.addEventListener('click', closeHandler);
  document.getElementById('patientModalDismiss')?.addEventListener('click', closeHandler);

  patientModal?.addEventListener('click', (event: Event) => {
    if (event.target === patientModal) {
      closeHandler();
    }
  });

  document.addEventListener('keydown', (event: KeyboardEvent) => {
    if (event.key === 'Escape' && modalState.get().patientForm.isOpen) {
      closeHandler();
      return;
    }

    if (event.key === 'Tab' && modalState.get().patientForm.isOpen && inner) {
      const focusable = Array.from(inner.querySelectorAll<HTMLElement>(
        'button:not(:disabled), input:not(:disabled), select:not(:disabled), textarea:not(:disabled), a[href], [tabindex]:not([tabindex="-1"])'
      ));
      const first = focusable[0];
      const last = focusable.at(-1);
      if (!first || !last) return;
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    }
  });

  document.addEventListener('fisio:open-patient-modal', () => {
    const current = modalState.get();
    modalState.set({ ...current, patientForm: { isOpen: true } });
  });

  document.addEventListener('fisio:close-patient-modal', closeHandler);
</script>
