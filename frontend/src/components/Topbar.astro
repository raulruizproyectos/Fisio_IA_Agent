---
// Topbar.astro - Reconstrucción Editorial Command Bar
---

<header class="topbar-command-bar" id="topbar">
  <!-- Left: Nav Breadcrumbs & Mobile Trigger -->
  <div class="topbar-left">
    <button
      class="topbar-mobile-toggle"
      id="sidebarToggle"
      aria-label="Abrir menú de navegación"
      aria-controls="sidebar"
      aria-expanded="false"
    >
      <span class="material-symbols-rounded">menu</span>
    </button>

    <nav class="topbar-breadcrumb" aria-label="Ruta de navegación">
      <span class="breadcrumb-root">Consulta</span>
      <span class="breadcrumb-separator">/</span>
      <span class="breadcrumb-current" id="topbarSectionLabel">
        Panel General
      </span>
    </nav>
  </div>

  <!-- Center: Command Search Bar -->
  <div class="topbar-center search-box">
    <div class="search-input-shell">
      <span class="material-symbols-rounded search-icon" aria-hidden="true">search</span>
      <label class="sr-only" for="searchInput">Buscar en la consulta</label>
      <input
        type="search"
        id="searchInput"
        name="busqueda_consulta"
        placeholder="Buscar paciente, cita, informe clínico..."
        autocomplete="off"
        class="search-command-input"
      />
      <kbd class="search-command-kbd">⌘K</kbd>
    </div>
    <div class="search-results-dropdown" id="searchResults" hidden></div>
  </div>

  <!-- Right: Date Context, Actions & Copilot Launch -->
  <div class="topbar-right">
    <!-- Date Pill -->
    <div class="topbar-date-pill" title="Fecha de hoy">
      <span class="material-symbols-rounded">calendar_today</span>
      <span id="topbarDateLabel">Hoy</span>
    </div>

    <!-- Quick Agenda Shortcut -->
    <button
      class="topbar-btn-secondary"
      type="button"
      data-dashboard-nav="citas"
      title="Abrir agenda de citas"
    >
      <span class="material-symbols-rounded">event_note</span>
      <span class="btn-text-desktop">Agenda</span>
    </button>

    <!-- Copiloto Clínico Button -->
    <button
      class="topbar-action-btn topbar-copilot-btn"
      id="assistantRailToggle"
      type="button"
      title="Abrir Copiloto Clínico"
      aria-label="Abrir Copiloto Clínico"
      aria-expanded="false"
      aria-controls="assistantRail"
    >
      <span class="material-symbols-rounded" aria-hidden="true">exercise</span>
      <span class="copilot-label">Copiloto Clínico</span>
      <span class="copilot-active-dot" id="copilotActiveDot" hidden></span>
    </button>

    <!-- Inbox / Notifications -->
    <button
      class="topbar-btn-icon"
      type="button"
      aria-label="Bandeja de mensajes y solicitudes"
      id="notifBtn"
      data-dashboard-nav="intakes"
      title="Bandeja de solicitudes"
    >
      <span class="material-symbols-rounded">notifications</span>
      <span id="notifBadge" class="topbar-notif-dot" hidden></span>
    </button>
  </div>
</header>

<script>
  const assistantRailToggle = document.getElementById('assistantRailToggle');
  assistantRailToggle?.addEventListener('click', () => {
    document.dispatchEvent(new CustomEvent('fisio:toggle-assistant'));
  });

  const dateLabel = document.getElementById('topbarDateLabel');
  if (dateLabel) {
    const formattedDate = new Intl.DateTimeFormat('es-ES', {
      weekday: 'short',
      day: 'numeric',
      month: 'short'
    }).format(new Date());
    // Capitalize first letter
    dateLabel.textContent = formattedDate.charAt(0).toUpperCase() + formattedDate.slice(1);
  }

  // Update assistant toggle aria-expanded and active state
  document.addEventListener('fisio:assistant-state', ((event: CustomEvent<{ open: boolean }>) => {
    const isOpen = Boolean(event.detail?.open);
    if (assistantRailToggle) {
      assistantRailToggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
      assistantRailToggle.classList.toggle('is-open', isOpen);
    }
  }) as EventListener);
</script>
