<header class="topbar px-6 py-3.5 flex items-center justify-between sticky top-0 z-30 bg-[#0d1420] border-b border-white/[0.08] backdrop-blur-md">
  <div class="flex items-center gap-4">
    <button class="text-slate-400 hover:text-white transition-colors lg:hidden p-1.5 rounded-lg hover:bg-white/5" id="sidebarToggle" aria-label="Menú" aria-controls="sidebar" aria-expanded="false">
      <span class="material-symbols-rounded text-2xl">menu</span>
    </button>
    <nav class="hidden lg:flex items-center gap-2 text-sm font-medium text-slate-300" aria-label="Ruta de navegación">
      <span class="text-slate-400">Consulta</span>
      <span class="text-slate-600">/</span>
      <span class="text-white font-semibold flex items-center gap-1.5" id="topbarSectionLabel">
        Panel General
      </span>
    </nav>
  </div>

  <div class="flex-1 max-w-xl mx-6 relative search-box">
    <div class="relative flex items-center">
      <span class="material-symbols-rounded absolute left-3.5 text-slate-400 text-lg search-icon" aria-hidden="true">search</span>
      <label class="sr-only" for="searchInput">Buscar en la consulta</label>
      <input type="search" id="searchInput" name="busqueda_consulta" placeholder="Buscar paciente, cita, informe clínico..." autocomplete="off" class="w-full bg-white/[0.04] border border-white/[0.08] focus:border-emerald-500/50 focus:bg-white/[0.07] focus:ring-2 focus:ring-emerald-500/20 rounded-xl py-2 pl-10 pr-12 text-sm text-white placeholder-slate-400 outline-none transition-all" />
      <kbd class="hidden sm:inline-block absolute right-3 px-1.5 py-0.5 text-[10px] font-semibold text-slate-400 bg-white/[0.06] border border-white/[0.1] rounded">⌘K</kbd>
    </div>
    <div class="absolute top-full left-0 right-0 mt-2 bg-[#111a26] rounded-xl shadow-2xl border border-white/[0.1] overflow-hidden search-results" id="searchResults" hidden></div>
  </div>

  <div class="flex items-center gap-2 md:gap-3">
    <div class="hidden md:flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-white/[0.04] border border-white/[0.08] text-xs font-medium text-slate-300">
      <span class="material-symbols-rounded text-emerald-400 text-sm">calendar_today</span>
      <span id="topbarDateLabel">Hoy</span>
    </div>
    <button class="hidden lg:flex items-center gap-1.5 text-xs font-medium text-slate-300 hover:text-white hover:bg-white/[0.06] px-3 py-1.5 rounded-lg transition-colors border border-transparent hover:border-white/[0.08]" type="button" data-dashboard-nav="citas">
      <span class="material-symbols-rounded text-base text-slate-400">event_note</span>
      <span>Agenda</span>
    </button>
    <button class="flex items-center gap-2 text-xs font-semibold text-emerald-300 bg-emerald-500/15 hover:bg-emerald-500/25 border border-emerald-500/30 px-3.5 py-1.5 rounded-lg transition-all shadow-sm" id="assistantRailToggle" type="button" aria-label="Abrir copiloto clínico" aria-controls="assistantRail" aria-expanded="false">
      <span class="material-symbols-rounded text-base text-emerald-400">auto_awesome</span>
      <span class="hidden sm:inline">Copiloto IA</span>
    </button>
    <button class="relative flex items-center gap-1.5 p-2 text-slate-300 hover:text-white hover:bg-white/[0.06] rounded-lg transition-colors border border-transparent hover:border-white/[0.08]" type="button" aria-label="Abrir bandeja de mensajes" id="notifBtn" data-dashboard-nav="intakes">
      <span class="material-symbols-rounded text-lg">notifications</span>
      <span class="hidden xl:inline text-xs font-medium">Bandeja</span>
      <span id="notifBadge" class="absolute top-1.5 right-1.5 w-2 h-2 bg-emerald-500 rounded-full" hidden></span>
    </button>
  </div>
</header>

<script>
  const assistantRailToggle = document.getElementById('assistantRailToggle');
  assistantRailToggle?.addEventListener('click', () => {
    document.dispatchEvent(new CustomEvent('fisio:open-assistant'));
  });

  const dateLabel = document.getElementById('topbarDateLabel');
  if (dateLabel) {
    dateLabel.textContent = new Intl.DateTimeFormat('es-ES', {
      weekday: 'long', day: 'numeric', month: 'short'
    }).format(new Date());
  }
</script>
