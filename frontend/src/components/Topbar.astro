<header class="bg-white border-b border-gray-100 px-6 py-4 flex items-center justify-between sticky top-0 z-30">
  <div class="flex items-center gap-4">
    <button class="text-[#687076] hover:text-[#11181C] transition-colors md:hidden" id="sidebarToggle" aria-label="Men&uacute;">
      <span class="material-symbols-rounded text-2xl">menu</span>
    </button>
    <div class="hidden md:flex flex-col">
      <span class="text-[11px] font-medium text-emerald-600 uppercase tracking-wider">Hoy</span>
      <strong class="text-sm font-medium text-[#11181C]">Operativa cl&iacute;nica</strong>
    </div>
  </div>

  <div class="flex-1 max-w-xl mx-8 relative search-box">
    <div class="relative flex items-center">
      <span class="material-symbols-rounded absolute left-4 text-gray-400 text-xl search-icon">search</span>
      <input type="text" id="searchInput" placeholder="Buscar paciente, cita, factura o documento..." autocomplete="off" class="w-full bg-gray-50 border border-transparent focus:border-emerald-200 focus:bg-white focus:ring-4 focus:ring-emerald-50 rounded-full py-2.5 pl-12 pr-4 text-sm text-[#11181C] placeholder-gray-400 outline-none transition-all" />
    </div>
    <div class="absolute top-full left-0 right-0 mt-2 bg-white rounded-2xl shadow-xl border border-gray-100 overflow-hidden search-results" id="searchResults" hidden></div>
  </div>

  <div class="flex items-center gap-2 md:gap-3">
    <button class="hidden md:flex items-center gap-2 text-sm font-medium text-[#687076] hover:text-[#11181C] hover:bg-gray-50 px-4 py-2 rounded-full transition-colors" type="button" data-dashboard-nav="citas">
      <span class="material-symbols-rounded text-lg">calendar_today</span>
      <span>Agenda</span>
    </button>
    <button class="flex items-center gap-2 text-sm font-medium text-emerald-700 bg-emerald-50 hover:bg-emerald-100 px-4 py-2 rounded-full transition-colors" id="assistantRailToggle" type="button" aria-label="Abrir copilot cl&iacute;nico" aria-controls="assistantRail" aria-expanded="false">
      <span class="material-symbols-rounded text-lg">psychology</span>
      <span class="hidden md:inline">Copiloto IA</span>
    </button>
    <button class="relative p-2 text-[#687076] hover:text-[#11181C] hover:bg-gray-50 rounded-full transition-colors" aria-label="Notificaciones" id="notifBtn">
      <span class="material-symbols-rounded">notifications</span>
      <span class="absolute top-1.5 right-1.5 w-2.5 h-2.5 bg-red-500 border-2 border-white rounded-full"></span>
    </button>
  </div>
</header>

<script>
  import { isSidebarOpen } from '../store';

  const sidebarToggle = document.getElementById('sidebarToggle');
  sidebarToggle?.addEventListener('click', () => {
    isSidebarOpen.set(!isSidebarOpen.get());
  });

  const assistantRailToggle = document.getElementById('assistantRailToggle');
  assistantRailToggle?.addEventListener('click', () => {
    document.dispatchEvent(new CustomEvent('fisio:open-assistant'));
  });
</script>
