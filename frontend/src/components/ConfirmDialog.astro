---
// src/components/ConfirmDialog.astro
---

<div class="fixed inset-0 bg-black/40 backdrop-blur-sm z-[100] flex items-center justify-center opacity-0 pointer-events-none transition-opacity duration-300" id="confirmDialog" aria-hidden="true">
  <div class="bg-white rounded-3xl shadow-2xl w-full max-w-md mx-4 overflow-hidden transform scale-95 transition-transform duration-300 flex flex-col max-h-[90vh]">
    <div class="px-6 py-5 border-b border-gray-100 flex items-start gap-4 bg-gray-50">
      <div class="bg-white p-2 rounded-full shadow-sm border border-gray-100">
        <span class="material-symbols-rounded text-emerald-600 text-[24px]" id="confirmIcon">help</span>
      </div>
      <div class="pt-1">
        <h2 id="confirmTitle" class="text-lg font-semibold text-[#11181C]">Confirmar accion</h2>
      </div>
    </div>
    <div class="p-6 overflow-y-auto text-[15px] text-[#526071] space-y-4 bg-white">
      <p id="confirmMessage" class="leading-relaxed">Revisa la accion antes de continuar.</p>
      <label class="block space-y-2 mt-4" id="confirmInputField" hidden>
        <span class="text-sm font-medium text-[#11181C]" id="confirmInputLabel">Texto de confirmacion</span>
        <input id="confirmInput" type="text" autocomplete="off" class="w-full bg-gray-50 border border-gray-200 focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 rounded-xl px-4 py-2.5 text-[#11181C] transition-all outline-none" />
      </label>
    </div>
    <div class="px-6 py-4 bg-gray-50 border-t border-gray-100 flex justify-end gap-3">
      <button type="button" class="px-5 py-2.5 rounded-full text-[#526071] hover:text-[#11181C] hover:bg-gray-200 transition-colors font-medium text-sm" id="confirmCancelBtn" data-confirm-cancel>Cancelar</button>
      <button type="button" class="px-6 py-2.5 rounded-full bg-emerald-600 hover:bg-emerald-700 text-white transition-colors font-medium text-sm shadow-sm" id="confirmOkBtn">Confirmar</button>
    </div>
  </div>
</div>

<script>
  import { modalState } from '../store';

  const confirmDialog = document.getElementById('confirmDialog');
  const inner = confirmDialog?.querySelector('div');
  const confirmIcon = document.getElementById('confirmIcon');
  const confirmTitle = document.getElementById('confirmTitle');
  const confirmMessage = document.getElementById('confirmMessage');
  const confirmOkBtn = document.getElementById('confirmOkBtn');
  const confirmCancelBtn = document.getElementById('confirmCancelBtn');
  const confirmInputField = document.getElementById('confirmInputField');
  const confirmInput = document.getElementById('confirmInput') as HTMLInputElement;
  const confirmInputLabel = document.getElementById('confirmInputLabel');

  modalState.subscribe((state) => {
    if (!confirmDialog || !inner) return;

    if (state.confirm.isOpen) {
      const options = state.confirm.options || {};
      const expectsText = options.expectsText || false;
      const tone = options.tone || 'warning';

      if (confirmTitle) confirmTitle.textContent = options.title || 'Confirmar accion';
      if (confirmMessage) confirmMessage.textContent = options.message || 'Revisa la accion antes de continuar.';
      
      if (confirmIcon) {
        confirmIcon.textContent = tone === 'error' ? 'warning' : tone === 'success' ? 'check_circle' : 'help';
        if (tone === 'error') {
          confirmIcon.className = 'material-symbols-rounded text-red-600 text-[24px]';
        } else if (tone === 'success') {
          confirmIcon.className = 'material-symbols-rounded text-emerald-600 text-[24px]';
        } else {
          confirmIcon.className = 'material-symbols-rounded text-blue-600 text-[24px]';
        }
      }
      
      if (confirmOkBtn) {
        confirmOkBtn.textContent = options.confirmLabel || 'Confirmar';
        if (tone === 'error') {
          confirmOkBtn.className = 'px-6 py-2.5 rounded-full bg-red-600 hover:bg-red-700 text-white transition-colors font-medium text-sm shadow-sm';
        } else {
          confirmOkBtn.className = 'px-6 py-2.5 rounded-full bg-emerald-600 hover:bg-emerald-700 text-white transition-colors font-medium text-sm shadow-sm';
        }
      }

      if (confirmCancelBtn) {
        confirmCancelBtn.textContent = options.cancelLabel || 'Cancelar';
      }

      if (confirmInputField && confirmInput && confirmInputLabel) {
        confirmInputField.hidden = !expectsText;
        confirmInput.value = '';
        confirmInput.placeholder = options.inputPlaceholder || '';
        confirmInputLabel.textContent = options.inputLabel || 'Texto de confirmacion';
      }

      confirmDialog.classList.remove('opacity-0', 'pointer-events-none');
      confirmDialog.classList.add('opacity-100', 'pointer-events-auto');
      confirmDialog.setAttribute('aria-hidden', 'false');
      inner.classList.remove('scale-95');
      inner.classList.add('scale-100');

      window.setTimeout(() => {
        if (expectsText) {
          confirmInput?.focus();
        } else {
          confirmOkBtn?.focus();
        }
      }, 20);
    } else {
      confirmDialog.classList.remove('opacity-100', 'pointer-events-auto');
      confirmDialog.classList.add('opacity-0', 'pointer-events-none');
      confirmDialog.setAttribute('aria-hidden', 'true');
      inner.classList.remove('scale-100');
      inner.classList.add('scale-95');
    }
  });

  // Buttons dispatch close event
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (target.closest('[data-confirm-cancel]')) {
      document.dispatchEvent(new CustomEvent('fisio:close-confirm', { detail: { value: false } }));
    }
  });

  confirmOkBtn?.addEventListener('click', () => {
    if (confirmInputField && !confirmInputField.hidden) {
      document.dispatchEvent(new CustomEvent('fisio:close-confirm', { detail: { value: confirmInput?.value || '' } }));
      return;
    }
    document.dispatchEvent(new CustomEvent('fisio:close-confirm', { detail: { value: true } }));
  });
</script>
