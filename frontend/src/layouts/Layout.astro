---
interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Plataforma integral de gestión clínica y seguimiento para fisioterapeutas' } = Astro.props;
import '../styles/global.css';
import '../styles/design-tokens.css';
import '../styles/editorial-primitives.css';
import '../styles/editorial-views.css';
import '../styles/precision-system.css';
import '../styles/precision-patients.css';
import '../styles/precision-ficha.css';
import '../styles/precision-agenda.css';
import '../styles/assistant-rail.css';
import '../styles/precision-dashboard.css';
import '../styles/precision-plantillas.css';
import '../styles/precision-voice.css';
import '../styles/precision-finance.css';
import '../styles/precision-documents.css';
import '../styles/precision-messages.css';
import '../styles/precision-history.css';
import '../styles/precision-settings.css';
import '../styles/global-shell.css';
import '../styles/precision-blue.css';
import '@fontsource-variable/dm-sans';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, shrink-to-fit=no" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="fisio-build" content="2026-10-08-precision-blue-v6" />
    <link rel="stylesheet" href="/material-symbols.css" />
    <style is:inline>
      :root {
        --font-ui: 'DM Sans Variable', 'DM Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        --font-display: 'DM Sans Variable', 'DM Sans', sans-serif;
      }
      *, *::before, *::after {
        font-family: var(--font-ui);
        font-feature-settings: "ss03" 1;
        -webkit-font-feature-settings: "ss03" 1;
      }
      h1, h2, h3, h4, .font-display, .page-title {
        font-family: var(--font-display) !important;
        font-feature-settings: "ss03" 1;
        -webkit-font-feature-settings: "ss03" 1;
      }
      .material-symbols-rounded,
      [class*="material-symbols"] {
        font-family: "Material Symbols Rounded" !important;
        font-weight: normal !important;
        font-style: normal !important;
        font-size: 24px;
        line-height: 1;
        letter-spacing: normal;
        text-transform: none;
        display: inline-block;
        white-space: nowrap;
        direction: ltr;
        font-feature-settings: "liga" !important;
        -webkit-font-feature-settings: "liga" !important;
        font-variant-ligatures: common-ligatures !important;
        -webkit-font-smoothing: antialiased;
      }
    </style>
    <title>{title}</title>
  </head>
  <body>
    <script is:inline src="/runtime-config.js"></script>
    <slot />
    <script src="../scripts/layout.js"></script>
  </body>
</html>

<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    font-family: var(--font-ui);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    /* Stable reading size across desktop and mobile. */
    font-size: 15px;
    scroll-behavior: smooth;
    width: 100%;
    max-width: 100%;
    overflow-x: clip;
    -webkit-text-size-adjust: 100%;
    text-size-adjust: 100%;
  }

  body {
    min-height: 100vh;
    min-height: 100dvh;
    width: 100%;
    max-width: 100%;
    overflow-x: clip;
    background: var(--color-canvas);
    color: var(--color-ink);
    line-height: 1.5;
  }

  h1, h2, h3, h4, .page-title {
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.25;
  }

  .brand-text {
    font-family: var(--font-ui);
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  img {
    max-width: 100%;
    height: auto;
    display: block;
  }

  .material-symbols-rounded {
    font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
    vertical-align: middle;
    user-select: none;
  }

  /* Fluid scrollbar */
  ::-webkit-scrollbar { width: 5px; height: 5px; }
  ::-webkit-scrollbar-track { background: transparent; }
  ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 99px; }
  ::-webkit-scrollbar-thumb:hover { background: #94a3b8; }

  /* Focus visible global - accessibility */
  :focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  @media (max-width: 1023px) {
    input,
    select,
    textarea {
      font-size: 16px !important;
    }
  }
</style>
