                      "typeVersion":  3.4,
                      "position":  [
                                       460,
                                       300
                                   ]
                  },
                  {
                      "parameters":  {
                                         "method":  "POST",
                                         "url":  "={{ ($env.BACKEND_URL || \u0027https://fisio-backend.b5xbaf.easypanel.host\u0027) + \u0027/api/telegram/incoming\u0027 }}",
                                         "sendBody":  true,
                                         "specifyBody":  "json",
                                         "jsonBody":  "={\n  \"request_id\": $json.request_id,\n  \"chat_id\": $json.chat_id,\n  \"username\": $json.username,\n  \"texto_mensaje\": $json.texto_mensaje\n}",
                                         "options":  {
                                                         "ignoreResponseCode":  true,
                                                         "timeout":  15000
                                                     }
                                     },
                      "id":  "BackendCommandResolver",
                      "name":  "Backend Command Resolver",
                      "type":  "n8n-nodes-base.httpRequest",
                      "typeVersion":  4.2,
                      "position":  [
                                       700,
                                       300
                                   ]
                  },
                  {
                      "parameters":  {
                                         "chatId":  "={{ $(\u0027Prepare Input\u0027).item.json.chat_id }}",
                                         "text":  "={{ $json.reply_text }}",
                                         "additionalFields":  {

                                                              }
                                     },
                      "id":  "TelegramReply",
                      "name":  "Telegram Reply",
                      "type":  "n8n-nodes-base.telegram",
                      "typeVersion":  1.2,
                      "position":  [
                                       940,
                                       300
                                   ]
                  },
                  {
                      "parameters":  {
                                         "jsCode":  "const input = $json || {};\nconst statusCode = Number(input.statusCode || input.code || 0);\n\nlet reply = \u0027\u0027;\nif (typeof input.reply_text === \u0027string\u0027 \u0026\u0026 input.reply_text.trim()) {\n  reply = input.reply_text.trim();\n} else if (typeof input.message_to_patient_es === \u0027string\u0027 \u0026\u0026 input.message_to_patient_es.trim()) {\n  reply = input.message_to_patient_es.trim();\n} else if (typeof input.message === \u0027string\u0027 \u0026\u0026 input.message.trim()) {\n  reply = input.message.trim();\n}\n\nif (!reply \u0026\u0026 statusCode \u003e= 400) {\n  reply = \u0027He recibido tu mensaje. Ahora mismo hay una incidencia tecnica y te respondere en breve.\u0027;\n}\n\nif (!reply) {\n  reply = \u0027He recibido tu mensaje. Enseguida te doy respuesta.\u0027;\n}\n\nreturn [{\n  json: {\n    reply_text: reply.slice(0, 3500),\n    response_status: statusCode || null,\n    backend_ok: statusCode ? statusCode \u003c 400 : true\n  }\n}];"
                                     },
                      "id":  "BuildSafeTelegramReply",
                      "name":  "Build Safe Telegram Reply",
                      "type":  "n8n-nodes-base.code",
                      "typeVersion":  2,
                      "position":  [
                                       840,
                                       300
                                   ]
                  }
              ],
