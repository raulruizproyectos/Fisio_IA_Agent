    {
      "parameters": {
        "jsCode": "const input = $json || {};\nconst payload = input.data || input;\nconst request = $('Build Backend Payload').first().json;\nconst appointmentId = payload.id || payload.appointment_id || null;\nconst statusCode = Number(input.statusCode || input.code || payload.statusCode || 0);\nconst backendError = payload.error || payload.message || input.message || null;\n\nif (appointmentId) {\n  return [{\n    json: {\n      request_id: request.request_id,\n      status: 'confirmed',\n      appointment_id: appointmentId,\n      google_calendar_event_id: request.google_calendar_event_id || null,\n      message_to_patient_es: 'Cita registrada correctamente. Te confirmamos la franja solicitada.'\n    }\n  }];\n}\n\nconst becameBusy = statusCode === 409;\nreturn [{\n  json: {\n    request_id: request.request_id,\n    status: becameBusy ? 'slot_not_available' : 'error',\n    appointment_id: null,\n    google_calendar_event_id: request.google_calendar_event_id || null,\n    cleanup_needed: Boolean(request.google_calendar_event_id),\n    backend_error: backendError || `backend_http_${statusCode || 'unknown'}`,\n    message_to_patient_es: becameBusy\n      ? 'Lo siento, ese horario acaba de dejar de estar disponible. Indica otra franja y lo reviso.'\n      : 'No pude registrar la cita automaticamente. Tu solicitud queda en revision manual y te confirmaremos por mensaje.'\n  }\n}];"
      },
