                  {
                      "parameters":  {
                                         "jsCode":  "const input = $json || {};\nconst payload = input.data || input;\nconst appointmentId = payload.id || payload.appointment_id || null;\nconst requestId = payload.request_id || input.request_id || null;\nconst statusCode = Number(input.statusCode || input.code || payload.statusCode || 0);\nconst backendError = payload.error || payload.message || input.message || null;\n\nif (appointmentId) {\n  return [{\n    json: {\n      request_id: requestId,\n      status: \u0027confirmed\u0027,\n      appointment_id: appointmentId,\n      message_to_patient_es: \u0027Cita registrada correctamente. Te confirmamos la franja solicitada.\u0027\n    }\n  }];\n}\n\nif (statusCode \u003e= 400 || backendError) {\n  return [{\n    json: {\n      request_id: requestId,\n      status: \u0027error\u0027,\n      appointment_id: null,\n      backend_error: backendError,\n      message_to_patient_es: \u0027No pude registrar la cita automaticamente. Tu solicitud queda en revision manual y te confirmaremos por mensaje.\u0027\n    }\n  }];\n}\n\nreturn [{\n  json: {\n    request_id: requestId,\n    status: \u0027needs_review\u0027,\n    appointment_id: null,\n    message_to_patient_es: \u0027He recibido tu solicitud de cita. Nuestro equipo la revisara y te confirmara disponibilidad.\u0027\n  }\n}];"
                                     },
