                                         "sendBody":  true,
                                         "specifyBody":  "json",
                                         "jsonBody":  "={{ ({ request_id: $json.request_id, chat_id: $json.chat_id, username: $json.username, texto_mensaje: $json.texto_mensaje, agent_mode: $json.agent_mode, bot_username: $json.bot_username }) }}",
