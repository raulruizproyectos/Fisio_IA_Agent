                                         "jsCode":  "const original = $(\u0027Build Safe Telegram Reply\u0027).first().json || {};\nconst input = $json || {};\nlet reply = \u0027\u0027;\nif (typeof input.message_to_patient_es === \u0027string\u0027 \u0026\u0026 input.message_to_patient_es.trim()) {\n  reply = input.message_to_patient_es.trim();\n} else if (typeof input.reply_text === \u0027string\u0027 \u0026\u0026 input.reply_text.trim()) {\n  reply = input.reply_text.trim();\n} else if (typeof original.reply_text === \u0027string\u0027 \u0026\u0026 original.reply_text.trim()) {\n  reply = original.reply_text.trim();\n}\nif (!reply) {\n  reply = \u0027Estoy revisando tu solicitud de cita y te confirmo en breve.\u0027;\n}\nreturn [{ json: { reply_text: reply.slice(0, 3500) } }];"
