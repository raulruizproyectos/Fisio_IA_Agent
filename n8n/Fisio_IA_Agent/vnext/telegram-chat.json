                      "parameters":  {
                                         "jsCode":  "const input = $json || {};\nconst original = $(\u0027Prepare Input\u0027).first().json || {};\nconst link = $(\u0027Lookup Telegram Link\u0027).first()?.json || {};\nconst rawText = String(original.texto_mensaje || \u0027\u0027).trim();\nconst normalizedText = rawText.toLowerCase().normalize(\u0027NFD\u0027).replace(/[\\u0300-\\u036f]/g, \u0027\u0027);\nconst statusCode = Number(input.statusCode || input.responseCode || input.code || input.status || 0);\nconst backendReply = [input.reply_text, input.message_to_patient_es, input.message].find((value) =\u003e typeof value === \u0027string\u0027 \u0026\u0026 value.trim()) || \u0027\u0027;\nconst linkedPatientId = link.paciente_id || link.patient_id || null;\nconst linkedProfessionalId = link.profesional_id || link.professional_id || null;\n\nfunction parseRequestedSlot(text) {\n  const normalized = String(text || \u0027\u0027).toLowerCase().normalize(\u0027NFD\u0027).replace(/[\\u0300-\\u036f]/g, \u0027\u0027);\n  const now = new Date();\n  let target = null;\n\n  if (/\\bmanana\\b/.test(normalized)) {\n    target = new Date(now);\n    target.setDate(target.getDate() + 1);\n  } else if (/\\bhoy\\b/.test(normalized)) {\n    target = new Date(now);\n  } else {\n    const dowMap = { domingo: 0, lunes: 1, martes: 2, miercoles: 3, jueves: 4, viernes: 5, sabado: 6 };\n    for (const [name, targetDow] of Object.entries(dowMap)) {\n      if (normalized.includes(name)) {\n        target = new Date(now);\n        let daysAhead = targetDow - target.getDay();\n        if (daysAhead \u003c= 0) daysAhead += 7;\n        target.setDate(target.getDate() + daysAhead);\n        break;\n      }\n    }\n  }\n\n  const timeMatchFull = normalized.match(/a\\s+las?\\s+(\\d{1,2})(?::(\\d{2}))?/);\n  const timeMatchStd = !timeMatchFull \u0026\u0026 normalized.match(/(?\u003c!\\d)(\\d{1,2}):(\\d{2})(?!\\d)/);\n  const timeMatchH = !timeMatchFull \u0026\u0026 !timeMatchStd \u0026\u0026 normalized.match(/(?\u003c!\\d)(\\d{1,2})\\s*h(?:horas?)?(?!\\d)/);\n  const tm = timeMatchFull || timeMatchStd || timeMatchH;\n  if (!target || !tm) return null;\n\n  const hour = Number(tm[1]);\n  const minute = Number(tm[2] || 0);\n  if (Number.isNaN(hour) || Number.isNaN(minute)) return null;\n\n  const totalMin = hour * 60 + minute;\n  const withinHours = (totalMin \u003e= 9 * 60 \u0026\u0026 totalMin \u003c 13 * 60) || (totalMin \u003e= 15 * 60 \u0026\u0026 totalMin \u003c 19 * 60);\n\n  const pad = (n) =\u003e String(n).padStart(2, \u00270\u0027);\n  const year = target.getFullYear();\n  const month = target.getMonth() + 1;\n  const day = target.getDate();\n  const refDate = new Date(Date.UTC(year, month - 1, day, 12, 0, 0));\n  const tzParts = new Intl.DateTimeFormat(\u0027en\u0027, { timeZone: \u0027Europe/Madrid\u0027, timeZoneName: \u0027shortOffset\u0027 }).formatToParts(refDate);\n  const tzName = tzParts.find((p) =\u003e p.type === \u0027timeZoneName\u0027)?.value || \u0027GMT+1\u0027;\n  const offsetMatch = tzName.match(/GMT([+-])(\\d+)(?::(\\d+))?/);\n  const offsetSign = offsetMatch?.[1] || \u0027+\u0027;\n  const offsetH = pad(parseInt(offsetMatch?.[2] || \u00271\u0027, 10));\n  const offsetM = pad(parseInt(offsetMatch?.[3] || \u00270\u0027, 10));\n  const tzOffset = `${offsetSign}${offsetH}:${offsetM}`;\n  const slotStart = `${year}-${pad(month)}-${pad(day)}T${pad(hour)}:${pad(minute)}:00${tzOffset}`;\n  let endHour = hour;\n  let endMinute = minute + 60;\n  if (endMinute \u003e= 60) { endHour += 1; endMinute -= 60; }\n  const slotEnd = `${year}-${pad(month)}-${pad(day)}T${pad(endHour)}:${pad(endMinute)}:00${tzOffset}`;\n\n  const dayLabel = /\\bmanana\\b/.test(normalized)\n    ? \u0027manana\u0027\n    : /\\bhoy\\b/.test(normalized)\n      ? \u0027hoy\u0027\n      : `${pad(day)}/${pad(month)}/${year}`;\n\n  return {\n    slotStart,\n    slotEnd,\n    hour,\n    minute,\n    withinHours,\n    humanLabel: `${dayLabel} a las ${pad(hour)}:${pad(minute)}`,\n  };\n}\n\nfunction hasClinicalReason(text = \u0027\u0027) {\n  const normalized = String(text || \u0027\u0027).toLowerCase().normalize(\u0027NFD\u0027).replace(/[\\u0300-\\u036f]/g, \u0027\u0027);\n  return /\\b(dolor|molestia|lesion|contractura|cervical|lumbar|espalda|hombro|rodilla|tobillo|cadera|cuello|seguimiento|revision|rehabilitacion|ciatica)\\b/.test(normalized);\n}\n\nfunction isGreeting(text = \u0027\u0027) {\n  const normalized = String(text || \u0027\u0027).toLowerCase().normalize(\u0027NFD\u0027).replace(/[\\u0300-\\u036f]/g, \u0027\u0027);\n  return /^(hola|holaa+|buenas|buenos dias|buenas tardes|buenas noches|hey|ey)\\b/.test(normalized);\n}\n\nfunction looksLikeAppointmentRequest(text = \u0027\u0027, requestedSlot = null) {\n  const normalized = String(text || \u0027\u0027).toLowerCase().normalize(\u0027NFD\u0027).replace(/[\\u0300-\\u036f]/g, \u0027\u0027);\n  return Boolean(requestedSlot) || /\\b(cita|agendar|agenda|reservar|reserva|hueco|hora|disponibilidad|confirmar|confirmo|vale|ok)\\b/.test(normalized);\n}\n\nconst slotFromRawText = parseRequestedSlot(rawText);\nconst slotFromBackendReply = parseRequestedSlot(backendReply);\nconst effectiveSlot = slotFromRawText || slotFromBackendReply;\nconst rawClinicalReason = hasClinicalReason(rawText);\nconst replyClinicalReason = hasClinicalReason(backendReply);\nconst effectiveReasonText = rawClinicalReason ? rawText : (replyClinicalReason ? backendReply : rawText);\nconst appointmentIntent = looksLikeAppointmentRequest(rawText, effectiveSlot);\nconst backendFailed = Boolean(input.error) || Boolean(statusCode \u0026\u0026 statusCode \u003e= 400);\nconst contradictoryOutsideHours = Boolean(effectiveSlot?.withinHours) \u0026\u0026 /(horario disponible comienza a las 9:00|elige un horario dentro de esos rangos|dentro de esos rangos|sin embargo, el horario disponible comienza)/i.test(backendReply);\nconst backendSuggestsPendingConfirmation = /(solo necesito confirmar|te parece bien|voy a registrar tu cita|un momento, por favor)/i.test(backendReply);\nconst readyToBook = Boolean(effectiveSlot?.withinHours) \u0026\u0026 (rawClinicalReason || replyClinicalReason) \u0026\u0026 linkedPatientId \u0026\u0026 linkedProfessionalId \u0026\u0026 (contradictoryOutsideHours || backendFailed || backendSuggestsPendingConfirmation);\n\nlet reply = String(backendReply || \u0027\u0027).trim();\nlet forceW1 = false;\n\nif (readyToBook) {\n  forceW1 = true;\n  reply = `Perfecto, ${effectiveSlot.humanLabel}. Estoy tramitando tu cita ahora mismo.`;\n} else if (contradictoryOutsideHours \u0026\u0026 effectiveSlot?.withinHours) {\n  reply = `Perfecto, ${effectiveSlot.humanLabel} encaja dentro del horario. Para gestionarlo bien, dime brevemente el motivo de la consulta.`;\n} else if (isGreeting(rawText)) {\n  reply = \u0027Hola. Soy Carla, la asistente de citas de la clinica. Dime que dia y hora te vendria bien y el motivo de la consulta.\u0027;\n} else if (slotFromRawText?.withinHours \u0026\u0026 !rawClinicalReason) {\n  reply = `Perfecto, ${slotFromRawText.humanLabel} me encaja. Para dejar la cita bien registrada, dime brevemente el motivo de la consulta.`;\n} else if (slotFromRawText \u0026\u0026 !slotFromRawText.withinHours) {\n  reply = \u0027Puedo ayudarte con la cita, pero esa hora queda fuera del horario habitual. Dime una franja entre 9:00 y 13:00 o entre 15:00 y 19:00.\u0027;\n} else if (!reply \u0026\u0026 appointmentIntent \u0026\u0026 !effectiveSlot) {\n  reply = \u0027Claro. Dime por favor que dia te viene bien, a que hora y el motivo de la consulta.\u0027;\n} else if (!reply \u0026\u0026 backendFailed) {\n  reply = \u0027He recibido tu mensaje. Ahora mismo hay una incidencia tecnica y te respondere en breve.\u0027;\n} else if (!reply) {\n  reply = \u0027He recibido tu mensaje. Enseguida te doy respuesta.\u0027;\n}\n\nreturn [{\n  json: {\n    reply_text: reply.slice(0, 3500),\n    response_status: statusCode || null,\n    backend_ok: !backendFailed,\n    force_w1: forceW1,\n    force_w1_payload: forceW1\n      ? {\n          request_id: `${original.request_id || \u0027req\u0027}_w1_guardrail`,\n          source: \u0027telegram_guardrail\u0027,\n          channel: \u0027telegram\u0027,\n          patient_id: linkedPatientId,\n          professional_id: linkedProfessionalId,\n          chat_id: String(original.chat_id || \u0027\u0027),\n          username: original.username || null,\n          message_text: effectiveReasonText,\n          slot_start: effectiveSlot.slotStart,\n          slot_end: effectiveSlot.slotEnd,\n          timezone: \u0027Europe/Madrid\u0027,\n        }\n      : null,\n    guardrail_slot_label: effectiveSlot?.humanLabel || null,\n  }\n}];"
                                     },
