{
  "name": "Fisio IA | Calendario sync",
  "nodes": [
    {
      "parameters": {},
      "id": "ManualTrigger",
      "name": "Manual",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        220,
        260
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 2
            }
          ]
        }
      },
      "id": "ScheduleTrigger",
      "name": "Programado",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        220,
        440
      ]
    },
    {
      "parameters": {
        "jsCode": "const now = new Date();\nconst from = new Date(now.getTime() - 7 * 24 * 60 * 60 * 1000).toISOString();\nconst to = new Date(now.getTime() + 30 * 24 * 60 * 60 * 1000).toISOString();\nreturn [{ json: { from, to, lookback_days: 7, lookahead_days: 30 } }];"
      },
      "id": "BuildSyncWindow",
      "name": "Preparar ventana",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
        340
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://fisio-backend.b5xbaf.easypanel.host/api/profesional/appointments/sync-calendar",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"desde\": $json.from,\n  \"hasta\": $json.to,\n  \"lookback_days\": $json.lookback_days,\n  \"lookahead_days\": $json.lookahead_days\n}",
        "options": {
          "timeout": 120000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Internal-Api-Key",
              "value": "={{ $env.INTERNAL_API_KEY }}"
            }
          ]
        }
      },
      "id": "TriggerCalendarSync",
      "name": "Sincronizar",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        780,
        340
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000
    },
    {
      "parameters": {
        "jsCode": "const payload = $json?.data || {};\nconst summary = $json?.calendar_sync || {};\nreturn [{ json: { ok: true, professional_id: payload.professional_id || null, desde: payload.desde || null, hasta: payload.hasta || null, appointments_considered: payload.appointments_considered || 0, fetched: summary.fetched || 0, updated: summary.updated || 0, cancelled: summary.cancelled || 0, restored: summary.restored || 0, persisted: summary.persisted || 0, synthetic: summary.synthetic || 0, source: summary.source || null } }];"
      },
      "id": "SummarizeSync",
      "name": "Resumen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1040,
        340
      ]
    }
  ],
  "connections": {
    "Manual": {
      "main": [
        [
          {
            "node": "Preparar ventana",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Programado": {
      "main": [
        [
          {
            "node": "Preparar ventana",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Preparar ventana": {
      "main": [
        [
          {
            "node": "Sincronizar",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Sincronizar": {
      "main": [
        [
          {
            "node": "Resumen",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
