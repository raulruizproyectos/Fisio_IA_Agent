                      "id":  "CallExerciseEngine",
                      "name":  "Call Exercise Engine",
                      "type":  "n8n-nodes-base.httpRequest",
                      "typeVersion":  4.2,
                      "position":  [
                                       940,
                                       180
                                   ]
                  },
                  {
                      "parameters":  {
                                         "jsCode":  "const input = $json || {};\nconst statusCode = Number(input.statusCode || input.code || 0);\nconst raw = input.recommendation || input;\n\nconst selected = Array.isArray(raw.selected_exercises) ? raw.selected_exercises : [];\nconst normalizedSelected = selected\n  .map((item, idx) => ({\n    exercise_id: item.exercise_id || item.id || null,\n    name: item.name || item.nombre || null,\n    description: item.description || item.descripcion || '',\n    zona_corporal: item.zona_corporal || item.body_area || null,\n    procedimiento: item.procedimiento || item.procedure || item.instructions || null,\n    series: item.series ?? null,\n    repeticiones: item.repeticiones ?? null,\n    duracion_segundos: item.duracion_segundos ?? null,\n    why: item.why || item.reason || '',\n    cautions: Array.isArray(item.cautions) ? item.cautions : [],\n    object_key: item.object_key || null,\n    signed_url_ttl_seconds: 1200,\n    rank: idx + 1\n  }))\n  .filter((item) => item.exercise_id);\n\nconst hasEngineError = statusCode >= 400;\nlet status = 'generated';\nif (hasEngineError) {\n  status = 'error';\n} else if (!normalizedSelected.length) {\n  status = 'needs_review';\n}\n\nconst fallbackPatientMessage = normalizedSelected.length\n  ? 'He generado una propuesta inicial de ejercicios para revision clinica.'\n  : 'Necesito mas informacion para recomendar ejercicios de forma segura.';\n\nreturn [{\n  json: {\n    request_id: raw.request_id || input.request_id || null,\n    status,\n    recommendation_id: raw.recommendation_id || null,\n    selected_exercises: normalizedSelected,\n    message_to_patient_es: raw.message_to_patient_es || fallbackPatientMessage,\n    message_to_therapist_es: raw.message_to_therapist_es || (hasEngineError ? 'Error del motor de recomendacion' : ''),\n    red_flags_present: !!raw.red_flags_present,\n    red_flags_items: Array.isArray(raw.red_flags_items) ? raw.red_flags_items : [],\n    selection_rationale: raw.selection_rationale || '',\n    escalation_recommend_medical_attention: !!raw.escalation_recommend_medical_attention,\n    escalation_reason: raw.escalation_reason || '',\n    engine_status_code: statusCode || null\n  }\n}];"
                                     },
