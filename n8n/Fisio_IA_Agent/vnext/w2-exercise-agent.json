                      "id":  "WebhookW2Exercise",
                      "name":  "Webhook W2 Exercise",
                      "type":  "n8n-nodes-base.webhook",
                      "typeVersion":  2.1,
                      "position":  [
                                       220,
                                       260
                                   ],
                      "webhookId":  "fisio-w2-exercise"
                  },
                  {
                      "parameters":  {
                                         "jsCode":  "const input = ($json.body && typeof $json.body === 'object') ? $json.body : $json;\n\nconst requestId = input.request_id || `req_${Date.now()}_${Math.floor(Math.random() * 100000)}`;\nconst patientId = input.patient_id || input.paciente_id || null;\nconst therapistId = input.therapist_id || input.fisioterapeuta_id || input.professional_id || null;\nconst symptomsText = String(input.symptoms_text || input.symptoms || input.message_text || input.text || '').trim();\n\nconst rawCandidates = Array.isArray(input.candidate_exercises)\n  ? input.candidate_exercises\n  : Array.isArray(input.catalog)\n    ? input.catalog\n    : [];\n\nconst candidateExercises = rawCandidates\n  .map((item) => ({\n    exercise_id: item.exercise_id || item.id || null,\n    name: item.name || item.nombre || '',\n    description: item.description || item.descripcion || '',\n    contraindicaciones: Array.isArray(item.contraindications)\n      ? item.contraindications\n      : Array.isArray(item.contraindicaciones)\n        ? item.contraindicaciones\n        : [],\n    zona_corporal: item.zona_corporal || item.body_area || null,\n    nivel: item.nivel || item.level || null,\n    object_key: item.object_key || null\n  }))\n  .filter((item) => item.exercise_id);\n\nconst redFlagContext = Array.isArray(input.red_flag_context) ? input.red_flag_context : [];\n\nreturn [{\n  json: {\n    request_id: requestId,\n    patient_id: patientId,\n    therapist_id: therapistId,\n    symptoms_text: symptomsText,\n    red_flag_context: redFlagContext,\n    candidate_exercises: candidateExercises,\n    candidate_count: candidateExercises.length,\n    channel: input.channel || input.source || 'n8n_webhook'\n  }\n}];"
                                     },
