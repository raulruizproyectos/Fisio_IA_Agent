                                                                                         "value":  "fisio_ia_agent_n8n_w2"
                                                                                     }
                                                                                 ]
                                                              },
                                         "sendBody":  true,
                                         "specifyBody":  "json",
                                         "jsonBody":  "{\n  \"request_id\": \"={{ $json.request_id }}\",\n  \"patient_id\": \"={{ $json.patient_id }}\",\n  \"symptoms\": \"={{ $json.symptoms_text }}\",\n  \"red_flag_context\": \"={{ $json.red_flag_context }}\",\n  \"catalog\": \"={{ $json.candidate_exercises }}\"\n}",
                                         "options":  {
