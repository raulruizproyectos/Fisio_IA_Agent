{
  "name": "Fisio IA | Bot fisio",
  "nodes": [
    {
      "parameters": {
        "updates": [
          "message"
        ],
        "additionalFields": {}
      },
      "id": "TelegramTrigger",
      "name": "Telegram",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1,
      "position": [
        240,
        304
      ],
      "webhookId": "89fda6ce-5c30-42b3-a3f5-405a6edc9cac",
      "credentials": {
        "telegramApi": {
          "id": "6PkC23M5FI8DavpT",
          "name": "FisioIAAgent"
        }
      },
      "retryOnFail": false
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "chat_id",
              "name": "chat_id",
              "value": "={{ $json.message.chat.id }}",
              "type": "string"
            },
            {
              "id": "username",
              "name": "username",
              "value": "={{ $json.message.from.username || \"\" }}",
              "type": "string"
            },
            {
              "id": "texto_mensaje",
              "name": "texto_mensaje",
              "value": "={{ $json.message.text || $json.message.caption || \"\" }}",
              "type": "string"
            },
            {
              "id": "request_id",
              "name": "request_id",
              "value": "={{ \"req_\" + Date.now() + \"_\" + Math.floor(Math.random() * 100000) }}",
              "type": "string"
            },
            {
              "id": "agent_mode",
              "name": "agent_mode",
              "value": "physio_reports",
              "type": "string"
            },
            {
              "id": "bot_username",
              "name": "bot_username",
              "value": "FisioIA_Agent_bot",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "PrepareInput",
      "name": "Preparar",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        464,
        304
      ],
      "retryOnFail": false
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://fisio-backend.b5xbaf.easypanel.host/api/telegram/incoming",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ ({ request_id: $json.request_id, chat_id: $json.chat_id, username: $json.username, texto_mensaje: $json.texto_mensaje, agent_mode: $json.agent_mode, bot_username: $json.bot_username }) }}",
        "options": {
          "timeout": 45000,
          "response": {
            "response": {
              "neverError": true,
              "fullResponse": true
            }
          }
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "contentType": "json"
      },
      "id": "BackendCommandResolver",
      "name": "Resolver backend",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        688,
        304
      ],
      "retryOnFail": false,
      "credentials": {
        "httpHeaderAuth": {
          "id": "A78UyYTCbXsqEIDg",
          "name": "N8N_TELEGRAM_HEADER_CREDENTIAL_ID"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const input=$json.body || $json; const status=Number($json.statusCode || 200); const reply= input.reply_text || input.message_to_patient_es; return [{json:{reply_text: status<400 && typeof reply==='string' && reply.trim() ? reply.slice(0,3500) : 'No he podido completar tu solicitud. Escríbenos de nuevo más tarde o contacta con la clínica.'}}];"
      },
      "id": "BuildSafeTelegramReply",
      "name": "Preparar respuesta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        912,
        304
      ],
      "retryOnFail": false
    },
    {
      "parameters": {
        "chatId": "={{ $('Preparar').item.json.chat_id }}",
        "text": "={{ $json.reply_text }}",
        "additionalFields": {}
      },
      "id": "TelegramReply",
      "name": "Enviar Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1136,
        304
      ],
      "webhookId": "c96165bf-0c87-42af-a67f-fb9bd0588593",
      "credentials": {
        "telegramApi": {
          "id": "6PkC23M5FI8DavpT",
          "name": "FisioIAAgent"
        }
      },
      "retryOnFail": false
    }
  ],
  "connections": {
    "Telegram": {
      "main": [
        [
          {
            "node": "Preparar",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Preparar": {
      "main": [
        [
          {
            "node": "Resolver backend",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Resolver backend": {
      "main": [
        [
          {
            "node": "Preparar respuesta",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Preparar respuesta": {
      "main": [
        [
          {
            "node": "Enviar Telegram",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "callerPolicy": "workflowsFromSameOwner",
    "availableInMCP": false,
    "saveDataSuccessExecution": "none",
    "saveDataErrorExecution": "none"
  }
}
