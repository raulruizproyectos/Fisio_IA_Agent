  "active": true,
  "isArchived": false,
  "nodes": [
    {
      "id": "W5Webhook",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        240,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "fisio/w5/calendar-events",
        "responseMode": "responseNode",
        "options": {}
      },
      "webhookId": "fisio-w5-calendar-events"
    },
    {
      "id": "W5Normalize",
      "name": "Normalize",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        300
      ],
      "parameters": {
        "jsCode": "const body = ($json.body && typeof $json.body === 'object') ? $json.body : $json;\nconst timeMin = body.time_min || body.timeMin || new Date().toISOString();\nconst rawMax = body.time_max || body.timeMax || null;\nconst timeMax = rawMax || new Date(new Date(timeMin).getTime() + 7*24*3600*1000).toISOString();\nreturn [{ json: { timeMin, timeMax } }];"
      }
    },
    {
      "id": "W5GetEvents",
      "name": "Get Calendar Events",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.3,
      "position": [
        700,
        300
      ],
      "parameters": {
        "resource": "event",
        "operation": "getAll",
        "calendar": {
          "__rl": true,
          "value": "raul.ruiz.diaz.bcn@gmail.com",
          "mode": "list",
          "cachedResultName": "raul.ruiz.diaz.bcn@gmail.com"
        },
        "returnAll": true,
        "additionalFields": {
          "timeMin": "={{ $json.timeMin }}",
          "timeMax": "={{ $json.timeMax }}"
        },
        "options": {}
      },
      "credentials": {
        "googleCalendarOAuth2Api": {
          "id": "UzAG7J2e9rs78F4r",
          "name": "Google Calendar account"
        }
      }
    },
    {
      "id": "W5Format",
      "name": "Format Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        940,
        300
      ],
      "parameters": {
        "jsCode": "const events = $input.all()\n  .map(item => item.json)\n  .filter(ev => ev && ev.id && ev.start?.dateTime);\nconst normalize = (ev) => ({\n  google_calendar_event_id: ev.id,\n  summary: ev.summary || '',\n  inicio_en: ev.start.dateTime,\n  fin_en: ev.end?.dateTime || null,\n  description: ev.description || null,\n  status: ev.status || 'confirmed',\n  transparency: ev.transparency || null\n});\nconst busyEvents = events\n  .filter(ev => (ev.status || '').toLowerCase() !== 'cancelled')\n  .filter(ev => (ev.transparency || '').toLowerCase() !== 'transparent')\n  .map(normalize);\nconst fisioEvents = busyEvents\n  .filter(ev => (ev.summary || '').toLowerCase().includes('cita fisioterapia'));\nreturn [{ json: { events: fisioEvents, busy_events: busyEvents, total: fisioEvents.length, busy_total: busyEvents.length } }];"
      }
    },
    {
      "id": "W5Respond",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1160,
        300
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {}
      }
    }
  ],
