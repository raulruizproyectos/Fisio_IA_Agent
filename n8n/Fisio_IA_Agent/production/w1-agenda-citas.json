    {
      "parameters": {
        "jsCode": "const events = $input.all();\nconst request = $('Normalize Request').first().json;\n// Skip all-day events (festivos, public holidays) — they have start.date but no start.dateTime\nconst conflicts = events.filter((item) => {\n  if (!item?.json?.id) return false;\n  if (item.json.start?.date && !item.json.start?.dateTime) return false;\n  return true;\n});\nreturn [{\n  json: {\n    ...request,\n    slot_available: conflicts.length === 0,\n    conflict_count: conflicts.length,\n    conflicts: conflicts.map(c => ({ id: c.json.id, summary: c.json.summary || '', start: c.json.start }))\n  }\n}];"
      },
