        "jsCode": "const request = $('Evaluate Availability').first().json;\nconst event = $json || {};\nreturn [{\n  json: {\n    request_id: request.request_id,\n    patient_id: request.patient_id,\n    professional_id: request.professional_id,\n    start_at: request.slot_start,\n    end_at: request.slot_end,\n    channel: request.channel || 'telegram',\n    reason: request.message_text,\n    timezone: request.timezone || 'Europe/Madrid',\n    google_calendar_event_id: event.id || null,\n    calendar_html_link: event.htmlLink || null,\n    patient_label: request.patient_label,\n    message_text: request.message_text,\n    chat_id: request.chat_id || null,\n    username: request.username || null\n  }\n}];"
