    {
      "parameters": {
        "jsCode": "const input = $json || {};\n// Handle both normal ($json = body) and full-response ($json = { body, status }) formats\nconst rawBody = input.body || input;\nconst payload = rawBody.data || rawBody;\nconst request = $('Build Backend Payload').first().json;\nconst appointmentId = payload.id || payload.appointment_id || null;\n// status_code is included in the 409 response body by the backend\nconst statusCode = Number(input.status || input.statusCode || rawBody.status_code || rawBody.statusCode || payload.status_code || 0);\nconst backendError = payload.error || payload.message || rawBody.error || input.error || input.message || null;\n\nif (appointmentId) {\n  return [{\n    json: {\n      request_id: request.request_id,\n      status: 'confirmed',\n      appointment_id: appointmentId,\n      google_calendar_event_id: request.google_calendar_event_id || null,\n      message_to_patient_es: 'Cita registrada correctamente. Te confirmamos la franja solicitada.'\n    }\n  }];\n}\n\nconst becameBusy = statusCode === 409;\nreturn [{\n  json: {\n    request_id: request.request_id,\n    status: becameBusy ? 'slot_not_available' : 'error',\n    appointment_id: null,\n    google_calendar_event_id: request.google_calendar_event_id || null,\n    cleanup_needed: Boolean(request.google_calendar_event_id),\n    backend_error: backendError || `backend_http_${statusCode || 'unknown'}`,\n    message_to_patient_es: becameBusy\n      ? 'Lo siento, ese horario acaba de dejar de estar disponible. Indica otra franja y lo reviso.'\n      : 'No pude registrar la cita automaticamente. Tu solicitud queda en revision manual y te confirmaremos por mensaje.'\n  }\n}];"
      },
