{
  "name": "Fisio IA | Errores",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "fisio/error/notify",
        "responseMode": "responseNode",
        "options": {},
        "authentication": "headerAuth"
      },
      "id": "WebhookErrorNotify",
      "name": "Entrada error",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        220,
        260
      ],
      "webhookId": "fisio-error-notify",
      "retryOnFail": false,
      "credentials": {
        "httpHeaderAuth": {
          "id": "9WNxfibVAwfGcekQ",
          "name": "N8N_FISIO_HEADER_CREDENTIAL_ID"
        }
      }
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "subject",
              "name": "subject",
              "value": "=[FisioIA][CRITICAL] {{$json.body.service || 'backend'}} {{$json.body.route || ''}}",
              "type": "string"
            },
            {
              "id": "message",
              "name": "message",
              "value": "=Severidad: {{$json.body.severity || 'CRITICAL'}}\\nServicio: {{$json.body.service || 'fisio-ia-agent-api'}}\\nRuta: {{$json.body.route || '-'}}\\nMetodo: {{$json.body.method || '-'}}\\nMensaje: {{$json.body.message || '-'}}\\nTimestamp: {{$json.body.timestamp || $now}}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "BuildEmailPayload",
      "name": "Preparar email",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        500,
        260
      ],
      "retryOnFail": false
    },
    {
      "parameters": {
        "sendTo": "raul.ruiz.diaz.bcn@gmail.com",
        "subject": "={{ $json.subject }}",
        "message": "={{ $json.message }}",
        "options": {}
      },
      "id": "SendEmail",
      "name": "Enviar email",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        760,
        260
      ],
      "credentials": {
        "gmailOAuth2": {
          "id": "7CfeWv5vaRffjNyl",
          "name": "Gmail account"
        }
      },
      "webhookId": "f36e63ac-bc99-413d-a192-fe7dcd44bb7e",
      "retryOnFail": false
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\"ok\": true, \"notified\": true}"
      },
      "id": "RespondErrorNotify",
      "name": "Responder",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1020,
        260
      ],
      "retryOnFail": false
    }
  ],
  "connections": {
    "Entrada error": {
      "main": [
        [
          {
            "node": "Preparar email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Preparar email": {
      "main": [
        [
          {
            "node": "Enviar email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Enviar email": {
      "main": [
        [
          {
            "node": "Responder",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "callerPolicy": "workflowsFromSameOwner",
    "availableInMCP": false,
    "saveDataSuccessExecution": "none",
    "saveDataErrorExecution": "none"
  }
}
