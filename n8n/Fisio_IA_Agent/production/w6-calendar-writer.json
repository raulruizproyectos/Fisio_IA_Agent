        "jsCode": "const request=$('Validar operación').first().json; const status=Number($json.statusCode); const data=$json.body; const deleting=request.action==='delete'; const ok=deleting ? [204,404,410].includes(status) : status>=200 && status<300 && data && typeof data==='object'; if(!ok)return [{json:{ok:false,provider_status:status,provider_reason:data?.error?.errors?.[0]?.reason || data?.error?.status || null}}]; if(['get','list'].includes(request.action))return [{json:{ok:true,data}}]; const id=deleting ? request.eventId : data.id; return [{json:{ok:typeof id==='string' && !!id && (request.action!=='update' || id===request.eventId),event_id:id || null}}];"
