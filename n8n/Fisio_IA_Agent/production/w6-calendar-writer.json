      "parameters": {
        "jsCode": "const body=$json.body || $json; const action=body.action; const calendarId=\"raul.ruiz.diaz.bcn@gmail.com\"; if(body.calendar_id !== calendarId || !['create','update','delete','get','list'].includes(action)) throw new Error('Invalid Calendar target/action'); const eventId=body.event_id; if(['update','delete','get'].includes(action) && (typeof eventId!=='string' || !/^[a-zA-Z0-9_-]{1,1024}$/.test(eventId))) throw new Error('Invalid event'); if(action==='list' && (typeof body.q!=='string' || !body.q || body.q.length>100)) throw new Error('Invalid search'); const eventBody={summary:body.summary,description:body.description,start:{dateTime:body.start,timeZone:'Europe/Madrid'},end:{dateTime:body.end,timeZone:'Europe/Madrid'}}; if(['create','update'].includes(action) && (typeof body.summary!=='string' || !body.summary || !Number.isFinite(Date.parse(body.start)) || !Number.isFinite(Date.parse(body.end)) || Date.parse(body.end)<=Date.parse(body.start))) throw new Error('Invalid event dates'); const method={create:'POST',update:'PATCH',delete:'DELETE',get:'GET',list:'GET'}[action]; let url='https://www.googleapis.com/calendar/v3/calendars/'+encodeURIComponent(calendarId)+'/events'+(['update','delete','get'].includes(action)?'/'+encodeURIComponent(eventId):''); if(action==='list') url+='?showDeleted=true&singleEvents=false&maxResults=2500&q='+encodeURIComponent(body.q)+(body.page_token?'&pageToken='+encodeURIComponent(body.page_token):''); if(['create','update','delete'].includes(action))url+='?sendUpdates=none'; return [{json:{action,eventId,method,url,eventBody,sendBody:['create','update'].includes(action)}}];"
      }
    },
