{
  "name": "Fisio IA | Recordatorios",
  "nodes": [
    {
      "id": "ScheduleReminders",
      "name": "Cada hora",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        200,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 1
            }
          ]
        }
      }
    },
    {
      "id": "SendReminders",
      "name": "Recordatorios pendientes",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "https://fisio-backend.b5xbaf.easypanel.host/api/cron/recordatorios",
        "options": {
          "timeout": 120000
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "retryOnFail": false,
      "credentials": {
        "httpHeaderAuth": {
          "id": "R7toe2gVBNi7E4pH",
          "name": "N8N_INTERNAL_HEADER_CREDENTIAL_ID"
        }
      }
    }
  ],
  "connections": {
    "Cada hora": {
      "main": [
        [
          {
            "node": "Recordatorios pendientes",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "Europe/Madrid",
    "saveDataSuccessExecution": "none",
    "saveDataErrorExecution": "none"
  }
}
