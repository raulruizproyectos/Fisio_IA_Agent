          "appendAttribution": false
        }
      },
      "id": "TelegramReply",
      "name": "Enviar Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1136,
        304
      ],
      "webhookId": "6688abb0-7b7a-4d83-94b4-ef6f5c835f65",
      "credentials": {
        "telegramApi": {
          "id": "Y2lad9wx7Ifpxm4z",
          "name": "citas_fisioterapia_bot"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const input = $json || {};\nconst statusCode = Number(input.statusCode || input.code || 0);\n\nlet reply = '';\nif (typeof input.reply_text === 'string' && input.reply_text.trim()) {\n  reply = input.reply_text.trim();\n} else if (typeof input.message_to_patient_es === 'string' && input.message_to_patient_es.trim()) {\n  reply = input.message_to_patient_es.trim();\n} else if (typeof input.message === 'string' && input.message.trim()) {\n  reply = input.message.trim();\n}\n\nif (!reply && statusCode >= 400) {\n  reply = 'He recibido tu mensaje. Ahora mismo hay una incidencia tecnica y te respondere en breve.';\n}\n\nif (!reply) {\n  reply = 'He recibido tu mensaje. Enseguida te doy respuesta.';\n}\n\nreturn [{\n  json: {\n    reply_text: reply.slice(0, 3500),\n    response_status: statusCode || null,\n    backend_ok: statusCode ? statusCode < 400 : true\n  }\n}];"
      },
      "id": "BuildSafeTelegramReply",
      "name": "Preparar respuesta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        912,
        304
      ]
    }
  ],
