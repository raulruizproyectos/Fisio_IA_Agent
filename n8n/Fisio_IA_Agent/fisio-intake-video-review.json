{
  "name": "Fisio Intake + Video Review",
  "nodes": [
    {
      "parameters": {
        "path": "fisio/intakes/pending",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "WebhookPendingIntakes",
      "name": "Webhook Ingestas Pendientes",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        220,
        200
      ],
      "webhookId": "fisio-intakes-pending"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ 'https://fisio-backend.b5xbaf.easypanel.host' + '/api/profesional/intakes/pending?profesional_id=' + $json.query.profesional_id }}",
        "options": {}
      },
      "id": "GetPendingIntakes",
      "name": "Obtener Ingestas Pendientes",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        500,
        200
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}"
      },
      "id": "RespondPendingIntakes",
      "name": "Responder Ingestas Pendientes",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        760,
        200
      ]
    },
    {
      "parameters": {
        "path": "fisio/video/review",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "WebhookVideoReview",
      "name": "Webhook Revision Video",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        220,
        480
      ],
      "webhookId": "fisio-video-review"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ 'https://fisio-backend.b5xbaf.easypanel.host' + '/api/profesional/video-jobs/' + $json.body.job_id + '/review' }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"aprobado\": $json.body.aprobado,\n  \"notas_revision\": $json.body.notas_revision,\n  \"prompt_revisado\": $json.body.prompt_revisado\n}",
        "options": {}
      },
      "id": "SubmitVideoReview",
      "name": "Enviar Revision Video",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        500,
        480
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "if-send",
              "leftValue": "={{ $json.next }}",
              "rightValue": "ready_to_send",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "IfReadyToSend",
      "name": "Si Listo Para Enviar",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        760,
        480
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ 'https://fisio-backend.b5xbaf.easypanel.host' + '/api/profesional/video-jobs/' + $json.data.id + '/send' }}",
        "options": {}
      },
      "id": "MarkVideoSent",
      "name": "Marcar Video Enviado",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1020,
        420
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}"
      },
      "id": "RespondVideoReview",
      "name": "Responder Revision Video",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1260,
        480
      ]
    }
  ],
  "connections": {
    "Webhook Ingestas Pendientes": {
      "main": [
        [
          {
            "node": "Obtener Ingestas Pendientes",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Obtener Ingestas Pendientes": {
      "main": [
        [
          {
            "node": "Responder Ingestas Pendientes",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Webhook Revision Video": {
      "main": [
        [
          {
            "node": "Enviar Revision Video",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Enviar Revision Video": {
      "main": [
        [
          {
            "node": "Si Listo Para Enviar",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Si Listo Para Enviar": {
      "main": [
        [
          {
            "node": "Marcar Video Enviado",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Responder Revision Video",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Marcar Video Enviado": {
      "main": [
        [
          {
            "node": "Responder Revision Video",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {},
  "meta": {
    "templateCredsSetupCompleted": false
  }
}



