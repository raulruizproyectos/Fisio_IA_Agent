{
  "name": "SW Fisio - Crear y Render Video",
  "nodes": [
    {
      "parameters": {},
      "id": "ExecuteWorkflowTrigger",
      "name": "Inicio Subflujo",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1,
      "position": [
        220,
        260
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "paciente-requerido",
              "leftValue": "={{ $json.body.paciente_id || $json.body.patient_id }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            },
            {
              "id": "profesional-requerido",
              "leftValue": "={{ $json.body.profesional_id || $json.body.professional_id }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            },
            {
              "id": "prescripcion-requerida",
              "leftValue": "={{ $json.body.prescripcion || $json.body.prescription }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "ValidarPayload",
      "name": "Validar Payload",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        460,
        260
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ 'https://fisio-backend.b5xbaf.easypanel.host' + '/api/profesional/video-jobs' }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"paciente_id\": $json.body.paciente_id || $json.body.patient_id,\n  \"profesional_id\": $json.body.profesional_id || $json.body.professional_id,\n  \"ejercicio_id\": $json.body.ejercicio_id || $json.body.exercise_id || null,\n  \"prescripcion\": $json.body.prescripcion || $json.body.prescription,\n  \"prompt_generacion\": $json.body.prompt_generacion || $json.body.generation_prompt || null\n}",
        "options": {}
      },
      "id": "CrearTrabajoVideo",
      "name": "Crear Trabajo Video",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        180
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ 'https://fisio-backend.b5xbaf.easypanel.host' + '/api/profesional/video-jobs/' + $json.data.id + '/render' }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"proveedor\": $json.body?.proveedor || \"simulado\"\n}",
        "options": {}
      },
      "id": "RenderizarTrabajo",
      "name": "Renderizar Trabajo",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        980,
        180
      ]
    },
    {
      "parameters": {
        "jsCode": "throw new Error('Faltan campos obligatorios: paciente_id, profesional_id y prescripcion');"
      },
      "id": "ErrorPayload",
      "name": "Error Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        360
      ]
    }
  ],
  "connections": {
    "Inicio Subflujo": {
      "main": [
        [
          {
            "node": "Validar Payload",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validar Payload": {
      "main": [
        [
          {
            "node": "Crear Trabajo Video",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Error Payload",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Crear Trabajo Video": {
      "main": [
        [
          {
            "node": "Renderizar Trabajo",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}

