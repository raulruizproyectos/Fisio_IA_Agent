# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server
PORT=3001
NODE_ENV=development
EXTRA_LISTEN_PORTS=
API_RATE_LIMIT=300
PUBLIC_BOOKING_RATE_LIMIT=20
TELEGRAM_RATE_LIMIT=180
INTERNAL_API_KEY=

# CORS
FRONTEND_URL=http://localhost:4321
FRONTEND_URLS=

# n8n Webhooks / API bridge
N8N_WEBHOOK_BASE_URL=http://localhost:5678/webhook
N8N_AGENT_WEBHOOK_URL=
N8N_ERROR_WEBHOOK_URL=
N8N_EXERCISE_WEBHOOK_URL=
N8N_APPOINTMENT_WEBHOOK_URL=http://localhost:5678/webhook/fisio/w1/appointment
N8N_WEBHOOK_SECRET=
INTERNAL_API_BASE_URL=http://127.0.0.1:3001
EXERCISE_ENGINE_TIMEOUT_MS=30000
EXERCISE_ENGINE_MAX_ATTEMPTS=2
EXERCISE_ENGINE_CANDIDATE_LIMIT=24
EXERCISE_IMAGE_MIN_RATIO=0.75
EXERCISE_REQUIRE_PATIENT_ASSOCIATION=true
EXERCISE_ASYNC_JOB_TTL_MS=900000
EXERCISE_ASYNC_JOB_CLEANUP_MS=60000

# Edge Functions (optional, fallback uses SUPABASE_URL)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
TELEGRAM_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
TELEGRAM_EDGE_ROUTER_ENABLED=false

# Telegram onboarding defaults
DEFAULT_PROFESSIONAL_ID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_PATIENT_BOT_TOKEN=
TELEGRAM_PHYSIO_BOT_TOKEN=
TELEGRAM_PATIENT_BOT_USERNAME=fisioterapia_CarlaJL
TELEGRAM_PHYSIO_BOT_USERNAME=FisioIA_Agent_bot
TELEGRAM_PHYSIO_REPORTS_CHAT_ID=

# Google Calendar sync (optional)
GOOGLE_CALENDAR_ID=
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_CALENDAR_TIMEZONE=Europe/Madrid
GOOGLE_HOLIDAY_CALENDAR_ID=es.spain#holiday@group.v.calendar.google.com
GOOGLE_CALENDAR_REQUIRED=false
W5_CALENDAR_READER_URL=
W6_CALENDAR_WRITER_URL=

# Public online booking
PUBLIC_BOOKING_SLOT_MINUTES=60
PUBLIC_BOOKING_MAX_DAYS_AHEAD=45
PUBLIC_BOOKING_CLINIC_NAME=Fisio IA Agent
PUBLIC_BOOKING_LOCATION=Terrassa, Barcelona
PUBLIC_BOOKING_CONTACT_PHONE=
PUBLIC_BOOKING_CONTACT_EMAIL=
PUBLIC_BOOKING_WINDOWS=[{"start":"09:00","end":"14:00"},{"start":"16:00","end":"20:00"}]

# Video workflows remain disabled until a provider and privacy flow are approved
ENABLE_VIDEO_WORKFLOWS=false
